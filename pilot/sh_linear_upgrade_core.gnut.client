void function LinearUpgradeCore_RuiUpdateOnLevelUp( entity player, int newLevel )
{
	
	if( file.meterRui != null )
	{
		bool hasUnspentUpgrades = EvoLevels_GetUnspentUpgradePoints( player ) > 0

		RuiSetFloat( file.meterRui, "startTime", hasUnspentUpgrades ? Time() : 0.0 )
		RuiSetInt( file.meterRui, "offset", hasUnspentUpgrades ? 0 : 160 )
	}
}

void function LinearUpgradeCore_PlayerCompletedLevelChanged( entity player, int newLevel )
{
	entity localPlayer = GetLocalViewPlayer()
	if( !IsValid( localPlayer ) || !IsValid( player ) )
		return

	if( player == localPlayer )
	{
		LinearUpgradeCore_UpdateCompletedLevel( player, newLevel )
	}
	else if( player.GetTeam() == localPlayer.GetTeam() )
	{
		LinearUpgradeCore_UpdateTeammatesLevel( player, newLevel )
	}
}

void function LinearUpgradeCore_UpdateTeammatesLevel( entity player, int newLevel )
{
	
}

void function LinearUpgradeCore_UpdateCompletedLevel( entity player, int newLevel )
{
	UpgradeCore_UpdateXp( player, EvoXp_GetXP( player ) )
	ResetInventoryMenu( player )

	var pilotRui = GetPilotRui()
	LinearUpgradeCore_UpdateSelectedUpgradeRui( pilotRui, player )
	UpgradeSelectionMenu_UpdateChoices( player )
}


void function LinearUpgradeCore_RuiThread( entity player )
{
	Assert( IsNewThread() )

	player.Signal( "EndUpgradeCoreRui" )

	if ( file.meterRui != null )
		RuiDestroyIfAlive( file.meterRui )

	thread EvoLevels_UpgradeReminderThread( player, tuning.upgradeSelectionReminderDelay, "EndUpgradeCoreRui" )

	file.meterRui = CreateCockpitPostFXRui( $"ui/level_up_action.rpak", HUD_Z_BASE )
	RuiSetBool( file.meterRui, "isMaxLevel", EvoLevels_IsLevelMaxLevel( EvoLevels_GetPlayerLevel( player ) ) )

	UpgradeCore_UpdateXp( player, EvoXp_GetXP( player ) )

	EndSignal( player, "OnDeath", "OnDestroy", "EndUpgradeCoreRui" )

	OnThreadEnd (
		function() : ()
		{
			if ( file.meterRui != null )
			{
				RuiDestroyIfAlive( file.meterRui )
				file.meterRui = null
			}
		}
	)

	while( true )
	{
		LinearUpgradeCore_UpdateMeterRuiVisibility( player )
		WaitFrame()
	}
}

void function LinearUpgradeCore_UpdateMeterRuiVisibility( entity player, bool override = true )
{
	if( file.meterRui != null )
		RuiSetBool( file.meterRui, "isVisible", EvoLevels_GetUnspentUpgradePoints( player ) > 0  && !UpgradeSelectionMenu_IsActive() )
}


void function LinearUpgradeCore_OnLocalPlayerSpawned( entity player )
{
	
	if ( LinearUpgradeCore_ShowHudUpgradeSelection() )
	{
		if ( GetLocalViewPlayer() == player )
		{
			thread LinearUpgradeCore_RuiThread( player )
		}
	}
}

void function LinearUpgradeCore_OnSpectateTargetChanged( entity spectatingPlayer, entity oldSpectatorTarget, entity newSpectatorTarget )
{
	entity player = GetLocalViewPlayer()
	LinearUpgradeCore_UpdateCompletedLevel( player, player.GetPlayerNetInt( LINEAR_UPGRADE_CORE_SELECTED_UPGRADES ) )
}

