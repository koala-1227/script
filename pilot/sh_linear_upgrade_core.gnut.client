bool function LinearUpgradeCore_UseLegendUpgrades()
{
	return GetCurrentPlaylistVarBool( "linear_upgrade_core_use_legend_upgrades", false ) && LinearUpgradeCore_IsEnabled()
}

array<int> function LinearUpgradeCore_GetLevelXpThresholds()
{
	if ( !LinearUpgradeCore_UseLegendUpgrades() )
		return [0]

	array<int> result
	int cumulativeXp = 0

	string playlistStr = GetCurrentPlaylistVarString( "linear_upgrade_core_xp_thresholds", "" )

	if ( playlistStr != "" )
	{
		array<int> xpRequirements = ParseStringIntoIntArray( playlistStr )
		for( int i=0; i < xpRequirements.len(); i++ )
		{
			cumulativeXp += xpRequirements[i]
			result.append( cumulativeXp )
		}
	}
	else
	{
		for ( int numberOfLevels = 0; numberOfLevels < tuning.maxLevel; numberOfLevels++ )
		{
			cumulativeXp += tuning.defaultXpPerLevel
			result.append( cumulativeXp )
		}
	}

	return result
}

void function LinearUpgradeCore_SetupEvoLevelSystem()
{

		RunUIScript( "LinearUpgradeCore_SetupEvoLevelSystem" )


	EvoLevelSystem system

	system.systemType = eEvoLevelSystemType.LINEAR_UPGRADE_CORE

	system.GetLevelXpThresholdsCallback = LinearUpgradeCore_GetLevelXpThresholds


	system.GetSpentLevelsForPlayerCallback = LinearUpgradeCore_GetSpentLevelsForPlayer









		EvoLevels_AddCallback_OnPlayerLevelUp( LinearUpgradeCore_RuiUpdateOnLevelUp )


	EvoLevels_RegisterEvoLevelSystem( system )
}

































































































































array< UpgradeChoice > function LinearUpgradeCore_GetUpgradesForPlayer( entity player )
{
	ItemFlavor characterItemFlavor = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	return LinearUpgradeCore_GetUpgradesForCharacter( characterItemFlavor )
}

array< UpgradeChoice > function LinearUpgradeCore_GetUpgradesForCharacter( ItemFlavor characterItemFlavor )
{
	array< UpgradeChoice > upgrades =  LinearUpgradeCore_GetDefinedUpgradesForCharacter( characterItemFlavor )

	if( upgrades.len() > 0 )
		return upgrades

	UpgradeChoice armorChoice

	armorChoice.shortDesc = "#BOT_ROYALE_ARMOR_CHOICE_SHORT_DESCRIPTION"
	armorChoice.icon = $"rui/hud/loot/loot_armor_1"
	armorChoice.desc = "#BOT_ROYALE_ARMOR_CHOICE_DESCRIPTION"
	armorChoice.title = "#BOT_ROYALE_ARMOR_CHOICE_TITLE"

	armorChoice.passiveIndex = ePassives.INVALID
	return [armorChoice, armorChoice, armorChoice, armorChoice, armorChoice, armorChoice]
}

array< UpgradeChoice > function LinearUpgradeCore_GetDefinedUpgradesForCharacter( ItemFlavor characterItemFlavor )
{
	if( characterItemFlavor in file.characterToPassiveUpgrades )
	{
		array< UpgradeChoice > result
		foreach( ItemFlavor passiveFlavor in file.characterToPassiveUpgrades[characterItemFlavor] )
		{
			result.append( file.passiveFlavorToUpgradeData[ passiveFlavor ] )
		}
		return result
	}
	array< UpgradeChoice > emptyResult
	return emptyResult
}

array< string > function LinearUpgradeCore_GetUpgradeNamesForPlayer( entity player )
{
	ItemFlavor characterItemFlavor = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	if( !( characterItemFlavor in file.characterToPassiveUpgrades ) )
	{
		return []
	}
	array<string> result
	foreach( upgrade in file.characterToPassiveUpgrades[characterItemFlavor] )
	{
		result.append( ItemFlavor_GetHumanReadableRefForPIN_Slow( upgrade ) )
	}
	return result
}

array<UpgradeChoice> function LinearUpgradeCore_GetSelectedUpgrades( entity player )
{
	int level = EvoLevels_GetPlayerLevel( player )
	int selectedUpgradesInt = player.GetPlayerNetInt( LINEAR_UPGRADE_CORE_SELECTED_UPGRADES )
	array<UpgradeChoice> upgrades = LinearUpgradeCore_GetUpgradesForPlayer( player )
	array<UpgradeChoice> selectedUpgrades = []

	int amountOfUpgrades = LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES

	bool isCaustic = false

		isCaustic = player.HasPassive( ePassives.PAS_GAS_GEAR )






		amountOfUpgrades = isCaustic ? CAUSTIC_AMOUNT_SLOTS : LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES

	for ( int i=0; i < amountOfUpgrades; i++ )
	{
		if ( selectedUpgradesInt <= level )
		{
			selectedUpgrades.append( upgrades[i] )
		}
	}
	return selectedUpgrades
}

bool function LinearUpgradeCore_IsUpgradeSelectable( entity player, int index, bool checkLevel = true )
{
	if ( !LinearUpgradeCore_IsEnabled() )
		 return false

	
	int upgradesBitFlag = player.GetPlayerNetInt( LINEAR_UPGRADE_CORE_SELECTED_UPGRADES )



			if( player.HasPassive( ePassives.PAS_GOLD_ARMOR ) )
				return true

		
		if( MysteryLegends_IsPlayerGivenAllUpgradesAlwaysEnabled() )
			return true


	if( checkLevel )
	{
		int level = EvoLevels_GetPlayerLevel( player )
		int levelForUpgrade = index + 1
		if( level < levelForUpgrade )
			return false
	}


		
		if( MysteryLegends_IsPlayerGivenUpgradesEnabled() )
			return true


	return !LinearUpgradeCore_IsUpgradeSelected( player, index ) 
}

bool function LinearUpgradeCore_IsUpgradeSelected( entity player, int index )
{
	
	int upgradesBitFlag = player.GetPlayerNetInt( LINEAR_UPGRADE_CORE_SELECTED_UPGRADES )
	return IsBitFlagSet( upgradesBitFlag, ( 1 << index )  )
}


array< int > function LinearUpgradeCore_GetPotentialClassPerkUpgradesForPlayer( entity player )
{
	array<int> result
	if( !LinearUpgradeCore_IsEnabled() )
		return result


	array< UpgradeChoice > upgrades
	int i = 0
	foreach( UpgradeChoice upgrade in LinearUpgradeCore_GetUpgradesForPlayer( player ) )
	{
		if( LinearUpgradeCore_IsUpgradeSelectable( player, i, false ) )
		{
			upgrades.append( upgrade )
		}
		i++
	}

	return UpgradeHelper_GetPotentialClassPerkUpgradesForPlayer( player, upgrades )
}

int function LinearUpgradeCore_GetSpentLevelsForPlayer( entity player )
{
	if ( !LinearUpgradeCore_IsEnabled() )
		return 0
	if ( !IsValid( player ) )
		return 0
	if ( !LinearUpgradeCore_UseLegendUpgrades() )
		return 0

	
	int selectedUpgrades    = player.GetPlayerNetInt( LINEAR_UPGRADE_CORE_SELECTED_UPGRADES )
	int numSelectedUpgrades = 0
	for( int i=0; i < LINEAR_UPGRADE_CORE_NUM_EXPECTED_UPGRADES; i++ )
	{
		int bitFlag = 1 << i
		if( IsBitFlagSet( selectedUpgrades, bitFlag ) )
		{
			numSelectedUpgrades += 1
		}
	}

	
	if ( numSelectedUpgrades >= tuning.maxLevel )
	{
		numSelectedUpgrades = EvoLevels_GetPlayerLevel( player )
	}

	return numSelectedUpgrades
}

array<int> function LinearUpgradeCore_GetPassiveIndexChoicesForLevel( entity player, int level )
{
	array<int> levelChoicePassives
	array<UpgradeChoice> upgradesList = LinearUpgradeCore_GetUpgradesForPlayer( player )
	for( int i = 0; i < upgradesList.len(); i++ )
	{
		if ( level == ( i / 2 ) )
		{
			levelChoicePassives.append( upgradesList[i].passiveIndex )
		}
	}
	return levelChoicePassives
}


UpgradeChoice function LinearUpgradeCore_GetUpgradeChoiceStructByIndex( entity player, int upgradeIndex )
{
	array<UpgradeChoice> upgradesList = LinearUpgradeCore_GetUpgradesForPlayer( player )
	if( upgradeIndex < 0 || upgradeIndex >= upgradesList.len() )
	{
		UpgradeChoice invalidUpgrade
		invalidUpgrade.passiveIndex = ePassives.INVALID
		return invalidUpgrade
	}
	return clone upgradesList[upgradeIndex]
}


