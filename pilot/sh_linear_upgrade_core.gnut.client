void function LinearUpgradeCore_SelectOption( int selection, bool fromQuickSelect = false )
{
	Remote_ServerCallFunction( FUNCNAME_ClientToServer_LinearUpgradeCore_HandleUpgradeSelection, selection, fromQuickSelect )

	entity localPlayer = GetLocalViewPlayer()
	if( !IsValid( localPlayer ) )
		return

	UpgradeChoice upgrade = LinearUpgradeCore_GetUpgradeChoiceStructByIndex( localPlayer, selection )
	if( upgrade.passiveIndex == ePassives.INVALID )
		return
	EmitSoundOnEntity( localPlayer, UPGRADE_SELECTED_SOUND )
}

void function LinearUpgradeCore_UpdateSelectedUpgradeRui( var rui, entity player )
{
	array<UpgradeChoice> selectedUpgrades = LinearUpgradeCore_GetSelectedUpgrades( player )

	RuiSetInt( rui, "numSlots", selectedUpgrades.len() )
	int numUpgradeSlots = tuning.maxLevel
	for( int upgradeIndex = 0; upgradeIndex < numUpgradeSlots; upgradeIndex++ )
	{
		asset iconAsset = upgradeIndex < selectedUpgrades.len() ?  selectedUpgrades[upgradeIndex].icon : $""

		if( player.HasPassive( ePassives.PAS_GOLD_ARMOR ) )
			iconAsset = GoldArmor_GetBoostKitIcon()

		if ( upgradeIndex < 2 )
		{
			RuiSetImage( rui, "slotImage" + ( upgradeIndex + 1 ), iconAsset )
		}
	}
}


