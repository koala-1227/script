global function ShPassiveSparrow_GetDoubleJumpCooldownScalar


global const string SPARROW_SUPPLIED_MOD_NAME = "sparrow_supplied"
const asset SPARROW_SUPPLIED_HUD_ICON = $"rui/hud/character_abilities/sparrow_passive_weapon_hud_dongle"
const asset SPARROW_SUPPLIED_PASSIVE_HUD_ICON = $"rui/hud/passive_icons/passive_sparrow_bocek"

const JET_DRIVE_LAUNCH_FX = $"P_sprw_passive_jet_burst" 

global const string HUNT_UPGRADE_BEST_TARGET_NETVAR = "hunt_upgrade_bestTarget"
global const string HUNT_UPGRADE_CHARGE_END_NETVAR = "hunt_upgrade_chargeEndTime"
const float HUNT_UPGRADE_ADRENALINE_EFFECT_DURATION = 2.0
global const string SPARROW_DOUBLE_JUMP_ENABLE_MOD = "enable_sparrow_double_jump"
const string SPARROW_WALL_LAUNCH_ENABLE_MOD = "enable_sparrow_wall_launch"

struct
{









		var hitList
		table<entity, float> buttonBuffer
		var doubleJumpRui
		var mantleLaunchRui
		bool canWallLaunch = true

} file

struct {
	float doubleJumpCooldownScaler = 1
	bool wallLaunchPassiveEnabled = true
	bool doubleJumpPassiveEnabled = true
	float huntActivationAngle = DOT_45DEGREE
	float huntActivationTime = .5
	float huntActivationDistance = 40

	bool breakCloakOnSparrowJump = true

} tuning


void function ShPassiveSparrow_Init()
{
	PrecacheParticleSystem( JET_DRIVE_LAUNCH_FX )
	PrecacheWeapon( "mp_weapon_charge_gauntlet_alt_mode" )

	RegisterNetworkedVariable( HUNT_UPGRADE_BEST_TARGET_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_ENTITY )
	RegisterNetworkedVariable( HUNT_UPGRADE_CHARGE_END_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_TIME, -1 )











		AddCallback_OnPassiveChanged( ePassives.PAS_SPARROW, PassiveSparrow_OnDoubleJumpPassiveChanged )
		AddCallback_OnPassiveChanged( ePassives.PAS_WALL_LAUNCH, PassiveSparrow_OnWallLaunchPassiveChanged )
		AddCallback_OnPlayerClimbHighJumped( PassiveSparrow_OnWallJump )


	RegisterSignal( "SparrowPassiveEnd" )
	RegisterSignal( "hunt_upgrade_adrenaline_stop_ability" )
	RegisterSignal( "TargetingStop" )
	RegisterSignal( "CleanUpDarts" )


		RegisterNetVarEntityChangeCallback( HUNT_UPGRADE_BEST_TARGET_NETVAR, StartHuntRui )

		AddModToTableOfPassiveWeaponBonuses( SPARROW_SUPPLIED_MOD_NAME, "#SPARROW_SUPPLIED", "#SPARROW_SUPPLIED_GUN", SPARROW_SUPPLIED_PASSIVE_HUD_ICON )
		AddCallback_CreatePlayerPassiveRui( CreatePassiveRuis_Internal )
		AddCallback_DestroyPlayerPassiveRui( DestroyPassiveRuis )

		AddCallback_OnPassiveChanged( ePassives.PAS_ENDORSEMENT_ASH_DASH, PassiveSparrow_OnAshDashEndorsementPassiveChanged )


	PassiveSparrow_GetTuningValues()








}

void function PassiveSparrow_GetTuningValues()
{
	tuning.doubleJumpCooldownScaler = GetCurrentPlaylistVarFloat( "double_jump_passive_cooldown_scaler", tuning.doubleJumpCooldownScaler )
	tuning.wallLaunchPassiveEnabled = GetCurrentPlaylistVarBool( "sparrow_wall_launch_enabled", tuning.wallLaunchPassiveEnabled )
	tuning.doubleJumpPassiveEnabled = GetCurrentPlaylistVarBool( "sparrow_double_jump_enabled", tuning.doubleJumpPassiveEnabled )
	tuning.huntActivationAngle = GetCurrentPlaylistVarFloat( "sparrow_hunt_activation_angle", tuning.huntActivationAngle )
	tuning.huntActivationTime = GetCurrentPlaylistVarFloat( "sparrow_hunt_activation_time", tuning.huntActivationTime )
	tuning.huntActivationDistance = GetCurrentPlaylistVarFloat( "sparrow_hunt_activation_distance", tuning.huntActivationDistance )

	tuning.breakCloakOnSparrowJump = GetCurrentPlaylistVarBool( "sparrow_break_cloak_on_extra_jumps", tuning.breakCloakOnSparrowJump )

}

