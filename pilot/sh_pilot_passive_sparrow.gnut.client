float function ShPassiveSparrow_GetDoubleJumpCooldownScalar()
{
	return tuning.doubleJumpCooldownScaler
}



vector function Get2DWishDirFromInputAndView( entity player )
{
	vector viewForward = player.GetViewForward()
	vector viewRight = player.GetViewRight()
	
	viewForward = Normalize( < viewForward.x, viewForward.y, 0 > )
	viewRight =  Normalize( < viewRight.x, viewRight.y, 0 > )
	vector wishDir = Normalize( player.GetInputAxisRight() * viewRight + player.GetInputAxisForward() * viewForward )
	return wishDir
}

void function TrackMantleLaunchHintDisplay( entity player )
{
	if( GetLocalViewPlayer() != player )
		return

	player.EndSignal( "OnDeath", "OnDestroy", "SparrowPassiveEnd" )

	while( true )
	{
		if ( !PlayerHasPassive( player, ePassives.PAS_WALL_LAUNCH ) )
			return

		bool canLaunch = false
		if( player.IsWallRunning() && HasPlayerSettingMod( player, SPARROW_WALL_LAUNCH_ENABLE_MOD ) )
		{
			if( file.canWallLaunch )
			{
				vector wallDir = player.GetWallRunWallVector()
				vector wishDir = Get2DWishDirFromInputAndView( player )
				if( DotProduct( wallDir, wishDir ) < -DOT_60DEGREE )
				{
					RuiSetBool( file.mantleLaunchRui, "isWallHang", true )
					CustomTutorialPopup ( "sparrow_passive_02" )
				}
			}
		}
		else if( player.IsOnGround() )
		{
			RuiSetBool( file.mantleLaunchRui, "isWallHang", false )
			file.canWallLaunch = true
		}
		else
			RuiSetBool( file.mantleLaunchRui, "isWallHang", false )

		WaitFrame()
	}
}

void function CreatePassiveRuis_Internal( entity player )
{
	if ( PlayerHasPassive( player, ePassives.PAS_SPARROW ) )
	{
		if ( file.doubleJumpRui == null )
		{
			file.doubleJumpRui = CreateCockpitRui( $"ui/ash_dash_meter.rpak", 32000 )

			RuiTrackFloat( file.doubleJumpRui, "bleedoutEndTime", player, RUI_TRACK_SCRIPT_NETWORK_VAR, GetNetworkedVariableIndex( "bleedoutEndTime" ) )
			RuiTrackFloat( file.doubleJumpRui, "reviveEndTime", player, RUI_TRACK_SCRIPT_NETWORK_VAR, GetNetworkedVariableIndex( "reviveEndTime" ) )
			RuiSetInt( file.doubleJumpRui, "numDashSegments", 1 )
			RuiSetFloat( file.doubleJumpRui, "barScaleFrac", 4 )
		}

		thread DisplayDoubleJumpCounter( player )
	}

	if ( PlayerHasPassive( player, ePassives.PAS_WALL_LAUNCH ) )
	{
		if ( file.mantleLaunchRui == null )
		{
			file.mantleLaunchRui = CreateCockpitRui( $"ui/mantle_launch.rpak", 32000 )
		}

		thread TrackMantleLaunchHintDisplay( player )
	}
}

void function DestroyPassiveRuis( entity player )
{
	if ( !PlayerHasPassive( player, ePassives.PAS_SPARROW ) )
	{
		if ( file.doubleJumpRui != null )
		{
			RuiDestroyIfAlive( file.doubleJumpRui )
			file.doubleJumpRui = null
		}
	}

	if( !PlayerHasPassive( player, ePassives.PAS_WALL_LAUNCH ) )
	{
		if ( file.mantleLaunchRui != null )
		{
			RuiDestroyIfAlive( file.mantleLaunchRui )
			file.mantleLaunchRui = null
		}
	}
}

void function PassiveSparrow_OnAshDashEndorsementPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	if ( PlayerHasPassive( player, ePassives.PAS_SPARROW ) && file.doubleJumpRui != null && RuiIsAlive( file.doubleJumpRui ) )
	{
		RuiSetFloat( file.doubleJumpRui, "forceOffsetLeftRight", nowHas ? -0.7 : 0.0 )
		RuiSetBool( file.doubleJumpRui, "hasAltCooldownSourceForShowHide", nowHas )
	}
}

void function DisplayDoubleJumpCounter( entity player )
{
	player.EndSignal( "OnDeath", "OnDestroy" )

	while( file.doubleJumpRui != null && RuiIsAlive( file.doubleJumpRui ) && IsValid( player ) )
	{
		float suitPower = player.GetSuitJumpPower()
		float suitPowerFrac = suitPower / 100

		
		RuiSetFloat( file.doubleJumpRui, "altCooldownForShowHide", player.GetSuitPower() / 100.0 )
		RuiSetFloat( file.doubleJumpRui, "dashFrac", suitPowerFrac )
		WaitFrame()
	}
}

void function StartHuntRui( entity player, entity target )
{
	player.Signal( "TargetingStop" )
	thread HuntUpgradeRui_Thread( player, target )
}

void function HuntUpgradeRui_Thread(  entity player, entity target )
{
	if ( !IsValid( target ) )
		return

	if ( GetGameState() >= eGameState.Resolution )
		return

	EndSignal( target, "OnDestroy", "OnDeath" )
	EndSignal( target, "OnModelChanged" )
	EndSignal( player, "TargetingStop" )
	EndSignal( player, "OnDestroy" )

	var rui = RuiCreate( $"ui/in_world_targeted_speed_boost.rpak", clGlobal.topoFullScreen, RUI_DRAW_HUD, RuiCalculateDistanceSortKey( player.EyePosition(), target.GetOrigin() ) )
	InitHUDRui( rui )

	RuiSetBool( rui, "isVisible", false )
	RuiSetBool( rui, "isEnemyTarget", true )

	RuiKeepSortKeyUpdated( rui, true, "pos" )


	target.DoModelChangeScriptCallback( true )
	OnThreadEnd(
		function() : ( rui, target, player)
		{
			RuiDestroyIfAlive( rui )

			if ( IsValid( target ) && target.IsPlayer() )
			{
				target.DoModelChangeScriptCallback( false )
				target.SetTargetInfoStatusIcon( $"" )
			}
		}
	)

	while ( true )
	{
		
		bool isValidTarget = IsValid(target)

		if ( isValidTarget )
		{
			RuiSetFloat3( rui, "pos", target.GetWorldSpaceCenter() )
			RuiSetBool( rui, "isVisible", true )

			
			RuiSetBool( rui, "showPassive", true )

			float chargeEndTime = player.GetPlayerNetTime( HUNT_UPGRADE_CHARGE_END_NETVAR )
			float chargeTimeRemaining = chargeEndTime != -1 ? max( chargeEndTime - Time(), 0.0 ) : tuning.huntActivationTime
			RuiSetFloat( rui, "passiveFill", 1.0 - chargeTimeRemaining / tuning.huntActivationTime )
			RuiSetBool( rui, "enemyObstructing", CheckIfEnemyIsObstructing(player, target) )
		}
		else
			RuiSetBool( rui, "isVisible", false )

		WaitFrame()
	}
}

