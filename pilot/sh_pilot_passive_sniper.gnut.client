void function Vantage_ManageWaypointThread( entity wp, entity player )
{
	entity pingEnt = wp.GetParent()
	if( !IsValid( pingEnt ) )
		return

	EndSignal( player, "OnDeath", "OnDestroy", "PlayerChangedClass" )
	EndSignal( pingEnt, "OnDeath", "OnDestroy", "PlayerChangedClass" )

	while( IsValid( wp ) && IsValid( player ) )
	{
		if( IsValid( wp ) && wp.wp.ruiHud != null )
		{
			float viewportFOV = GetCurrentPlayerFOV( player )
			RuiSetFloat( wp.wp.ruiHud, "currentFOV", viewportFOV )

			int team = pingEnt.GetTeam()
			if( ! ( team in file.teamCooldowns ) )
				RuiSetFloat( wp.wp.ruiHud, "fillFrac", 1 )
			else
				RuiSetFloat( wp.wp.ruiHud, "fillFrac", (Time() - file.teamCooldowns[ team ]) / tuning.ultChargeCooldown )
		}
		WaitFrame()
	}
}



bool function Vantage_CanGainUltChargeFromTeam( int team )
{
	if( ! ( team in file.teamCooldowns ) )
		return true

	if( file.teamCooldowns[ team ] + tuning.ultChargeCooldown > Time() )
		return false

	return true
}




void function OnVantagePassiveTrackerDestroyed( entity wp )
{
	if ( wp.wp.ruiHud != null )
		RuiSetBool( wp.wp.ruiHud, "isFinished", true )
}

void function InstanceVantagePassiveTrackerInternal( entity wp )
{
	if ( wp.IsPlayer() && wp.GetTeam() == TEAM_SPECTATOR && !IsLobby() )
		return

	entity player = wp.GetOwner()
	entity localPlayer = GetLocalViewPlayer()
	if( !IsValid( player ) || player.GetTeam() != localPlayer.GetTeam() )
		return

	entity pingEnt = wp.GetParent()
	if( !IsValid( pingEnt ) )
		return

	if ( ! ( PlayerHasPassive( player, ePassives.PAS_VANTAGE ) ) )
		return

	int wpType = wp.GetWaypointType()

	if( player == localPlayer )
	{
		entity ultWeapon = player.GetOffhandWeapon( eOffhandInv.ULTIMATE )

		bool canGainAmmo = true
		if ( IsValid( ultWeapon ) )
		{
			int ammoNow = ultWeapon.GetWeaponPrimaryClipCount()
			int ammoMax = ultWeapon.GetWeaponPrimaryClipCountMax()
			if ( ammoNow == ammoMax )
			{
				canGainAmmo = false
			}
		}


		int team = pingEnt.GetTeam()
		if( Vantage_CanGainUltChargeFromTeam( team ) && canGainAmmo )
		{
			Remote_ServerCallFunction( "Vantage_ClientToServer_AddUltCharge" )
			file.teamCooldowns[ team ] <- Time()
		}
	}

	var rui = CreateWaypointRui( $"ui/waypoint_vantage_passive.rpak", 200 )
	thread Vantage_ManageWaypointThread( wp, player )

	SetWaypointRui_HUD( wp, rui )
	RuiKeepSortKeyUpdated( rui, true, "targetPos" )
	RuiTrackFloat3( rui, "targetPos", wp, RUI_TRACK_OVERHEAD_FOLLOW )
	AddEntityDestroyedCallback( wp, OnVantagePassiveTrackerDestroyed )
}

void function InstanceVantagePassiveTracker( entity wp )
{
	InstanceVantagePassiveTrackerInternal( wp )
}


