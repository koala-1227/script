	UpgradeHelper_RegisterUpgradesForCharacter( character, upgrades, file.characterToPassiveUpgrades, file.passiveFlavorToUpgradeData, file.characterToPassiveUpgradeOverrides )
}

void function UpgradeCore_ParseUpgradeOverrides()
{
	int expectedLength = UPGRADE_CORE_NUM_EXPECTED_UPGRADES + 1

	UpgradeHelper_ParseUpgradeOverrides( expectedLength, "passive_upgrade_core_overrides",
	file.characterToPassiveUpgrades, file.characterToPassiveUpgradeOverrides )
}

const array<string> ALL_ARMOR_CORE_REFS = [



	"armor_core_pickup_lv1",
	"armor_core_pickup_lv2",
	"armor_core_pickup_lv3",
	"armor_core_pickup_lv5"
]

bool function UpgradeCore_IsEquipmentArmorCore( string ref )
{
	return ALL_ARMOR_CORE_REFS.contains( ref )
}


bool function UpgradeCore_IsCorrectGameState()
{
	bool isGameStateCorrect =
			(
					( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) && ( GetGameState() == eGameState.Playing ) ) ||
					( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) && ( GetGameState() == eGameState.WaitingForPlayers ))
			)

	return isGameStateCorrect
}

void function UpgradeCore_OnPlayerClassChanged( entity ent )
{

		if( ent == GetLocalViewPlayer() )
		{
			var pilotRui = GetPilotRui()
			UpgradeCore_UpdateSelectedUpgradeRui( pilotRui, ent )
		}

	Signal( ent, "EndUpgradeCoreRui" )






		if( UpgradeCore_IsCorrectGameState() && UpgradeCore_ShowHudUpgradeSelection() )
		{
			if ( GetLocalViewPlayer() == ent )
				thread UpgradeCore_RuiThread( ent )
		}





























}


