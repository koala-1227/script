array< UpgradeChoice > function UpgradeCore_GetUpgradesForPlayer( entity player )
{
	ItemFlavor characterItemFlavor = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	return UpgradeCore_GetUpgradesForCharacter( characterItemFlavor )
}

array< UpgradeChoice > function UpgradeCore_GetUpgradesForCharacter( ItemFlavor characterItemFlavor )
{
	array< UpgradeChoice > upgrades =  UpgradeCore_GetDefinedUpgradesForCharacter( characterItemFlavor )

	if( upgrades.len() > 0 )
		return upgrades

	UpgradeChoice armorChoice

	armorChoice.shortDesc = "#BOT_ROYALE_ARMOR_CHOICE_SHORT_DESCRIPTION"
	armorChoice.icon = $"rui/hud/loot/loot_armor_1"
	armorChoice.desc = "#BOT_ROYALE_ARMOR_CHOICE_DESCRIPTION"
	armorChoice.title = "#BOT_ROYALE_ARMOR_CHOICE_TITLE"

	armorChoice.passiveIndex = ePassives.INVALID
	return [armorChoice, armorChoice, armorChoice, armorChoice, armorChoice, armorChoice]
}

array< UpgradeChoice > function UpgradeCore_GetDefinedUpgradesForCharacter( ItemFlavor characterItemFlavor )
{
	if( characterItemFlavor in file.characterToPassiveUpgrades )
	{
		array< UpgradeChoice > result
		foreach( ItemFlavor passiveFlavor in file.characterToPassiveUpgrades[characterItemFlavor] )
		{
			result.append( file.passiveFlavorToUpgradeData[ passiveFlavor ] )
		}
		return result
	}
	array< UpgradeChoice > emptyResult
	return emptyResult
}

array< string > function UpgradeCore_GetUpgradeNamesForPlayer( entity player )
{
	ItemFlavor characterItemFlavor = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	if( !( characterItemFlavor in file.characterToPassiveUpgrades ) )
	{
		return []
	}
	array<string> result
	foreach( upgrade in file.characterToPassiveUpgrades[characterItemFlavor] )
	{
		result.append( ItemFlavor_GetHumanReadableRefForPIN_Slow( upgrade ) )
	}
	return result
}


bool function UpgradeCore_IsLootRef_MythicArmorUpgrade( string ref )
{



	return ref == UPGRADE_CORE_MYTHIC_UPGRADE_REF

}


array<UpgradeChoice> function UpgradeCore_GetSelectedUpgrades( entity player )
{
	int selectedUpgradesInt = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	array<UpgradeChoice> upgrades = UpgradeCore_GetUpgradesForPlayer( player )
	array<UpgradeChoice> selectedUpgrades
	for( int i=0; i < UPGRADE_CORE_NUM_EXPECTED_UPGRADES; i++ )
	{
		int bit = 1 << i
		if( IsBitFlagSet( selectedUpgradesInt, bit ) )
		{
			selectedUpgrades.append( upgrades[i] )
		}
	}
	return selectedUpgrades
}

bool function UpgradeCore_IsUpgradeSelectable( entity player, int index, bool checkLevel = true )
{
	if ( !UpgradeCore_IsEnabled() )
		 return false
	int upgradesBitFlag = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
		if( CausticResearch_CanPlayerChooseUpgrade( player, index ) )
		{
			return true
		}







			if( player.HasPassive( ePassives.PAS_GOLD_ARMOR ) )
				return true

			bool overrideSkipLevelCheck = false
			if ( GamemodeUtility_GetIsAutomaticLegendUpgrades() && GamemodeUtility_GetIsAutomaticLegendUpgradesSkipLevelCheck() )
			{
				overrideSkipLevelCheck = true
			}
			else if ( MysteryLegends_IsPlayerGivenAllUpgradesAlwaysEnabled() )
			{
				overrideSkipLevelCheck = true
			}

			
			if ( overrideSkipLevelCheck )
			{
				int maxLevelForUpgrades = EvoLevels_GetMaxUpgradeLevels()
				int levelForUpgrade = UpgradeCore_GetLevelForUpgrade( index )
				if ( levelForUpgrade > maxLevelForUpgrades )
					return false

				return true
			}


	if( checkLevel )
	{
		int level = EvoLevels_GetPlayerLevel( player )
		int levelForUpgrade = UpgradeCore_GetLevelForUpgrade( index )
		if( level < levelForUpgrade )
			return false
	}


		
		if( MysteryLegends_IsPlayerGivenUpgradesEnabled() )
			return true



		
		if( GamemodeUtility_GetIsAutomaticLegendUpgrades() )
			return true


	int levelUpgradeStart = ( index / 2 ) * 2
	return !UpgradeCore_IsUpgradeSelected( player, levelUpgradeStart ) && !UpgradeCore_IsUpgradeSelected( player, levelUpgradeStart + 1 )
}

bool function UpgradeCore_IsUpgradeSelected( entity player, int index )
{
	int upgradesBitFlag = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	return IsBitFlagSet( upgradesBitFlag, ( 1 << index )  )
}

int function UpgradeCore_GetLevelForUpgrade( int index )
{
	return index / 2 + 1
}

int function UpgradeCore_GetArmorTierForLevel( int level, bool skipGold = true  )
{

		if( level == 4 && skipGold)
		{
			level = 5
		}






	return level
}

int function UpgradeCore_GetPlayerArmorTier( entity player, bool skipGold = true, bool skipHelmet = false )
{
	int level = UpgradeCore_ShouldArmorMatchPlayerLevel() ? EvoLevels_GetPlayerLevel( player ) : EvoLevels_GetPlayerLevel( player ) + 1




		bool skipGoldForce = true


			if ( UpgradeCore_ArmorUpdates_MythicArmorUpgrade_Enabled() && !skipHelmet )
			{
				if( player.HasPassive( ePassives.PAS_RED_ARMOR_UPGRADE ) )
				{
					level = 5
				}
				if( player.HasPassive( ePassives.PAS_GOLD_ARMOR_UPGRADE ) )
				{
					level = 4
					skipGoldForce = false
				}
			}








		return UpgradeCore_GetArmorTierForLevel( level, skipGoldForce )



}

bool function UpgradeCore_IsArmorRefTierValidForPlayerLevel( int armorTier, entity player )
{
	int playerArmorTier = UpgradeCore_GetPlayerArmorTier( player )
	return UpgradeCore_ShouldArmorMatchPlayerLevel() ? playerArmorTier == armorTier : playerArmorTier > armorTier
}


const array<asset> ARMOR_CORE_ICONS = [
	$"rui/hud/loot/loot_upgrade_core_0",
	$"rui/hud/loot/loot_upgrade_core_1",
	$"rui/hud/loot/loot_upgrade_core_2",
	$"rui/hud/loot/loot_upgrade_core_3",
	$"",
	$"rui/hud/loot/loot_upgrade_core_4",
]

asset function GetShieldCoreIconFromShieldAmount( int amount )
{
	int tier = GetShieldTierFromShieldAmount( amount )
	int index = int( clamp( tier, 0, ARMOR_CORE_ICONS.len() - 1 ) )

	return ARMOR_CORE_ICONS[ index ]
}

bool function UpgradeCore_ShouldArmorMatchPlayerLevel()
{
	return tuning.shouldArmorTierMatchPlayerLevel
}


array< int > function UpgradeCore_GetPotentialClassPerkUpgradesForPlayer( entity player )
{
	array<int> result
	if( !UpgradeCore_IsEnabled() )
		return result


	array< UpgradeChoice > upgrades
	int i = 0
	foreach( UpgradeChoice upgrade in UpgradeCore_GetUpgradesForPlayer( player ) )
	{
		if( UpgradeCore_IsUpgradeSelectable( player, i, false ) )
		{
			upgrades.append( upgrade )
		}
		i++
	}

	return UpgradeHelper_GetPotentialClassPerkUpgradesForPlayer( player, upgrades )
}

int function UpgradeCore_GetSpentLevelsForPlayer( entity player )
{
	if( !UpgradeCore_IsEnabled() )
		return 0
	if( !IsValid( player ) )
		return 0

	
	int selectedUpgrades    = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	int numSelectedUpgrades = 0
	for( int i=0; i < UPGRADE_CORE_NUM_EXPECTED_UPGRADES; i++ )
	{
		int bitFlag = 1 << i
		if( IsBitFlagSet( selectedUpgrades, bitFlag ) )
		{
			numSelectedUpgrades += 1
		}
	}

	
	if ( numSelectedUpgrades >= (UPGRADE_CORE_NUM_EXPECTED_UPGRADES / UPGRADE_CORE_NUM_EXPECTED_UPGRADES_PER_LEVEL) )
	{
		numSelectedUpgrades = EvoLevels_GetPlayerLevel( player )
	}

	return numSelectedUpgrades
}

array<int> function UpgradeCore_GetCurrentLevelChoices( entity player )
{
	if( !IsValid( player ) )
		return []

	int curLevel = EvoLevels_GetPlayerLevel( player )
	if( CausticResearch_IsEnabled() && PlayerHasPassive( player, ePassives.PAS_GAS_GEAR ) )
	{
		curLevel = EvoLevels_GetMaxUpgradeLevels()
	}
	for( int i =0; i < curLevel; i++ )
	{
		if( CausticResearch_IsEnabled() && PlayerHasPassive( player, ePassives.PAS_GAS_GEAR ) )
		{
			if( !UpgradeCore_IsUpgradeSelected( player, i * 2 ) && !UpgradeCore_IsUpgradeSelected( player, ( i * 2 ) + 1 ) )
			{
				return UpgradeCore_GetChoicesForLevel( player, i )
			}
		}
		else if( UpgradeCore_IsUpgradeSelectable( player, i * 2 ) )
		{
			return UpgradeCore_GetChoicesForLevel( player, i )
		}
	}
	return []
}

array<int> function UpgradeCore_GetChoicesForLevel( entity player, int level )
{
	array<int> currentLevelChoiceIndices
	array<UpgradeChoice> upgradesList = UpgradeCore_GetUpgradesForPlayer( player )
	for( int i=0; i < upgradesList.len(); i++ )
	{
		int upgradeLevel = ( i / 2 )
		if ( upgradeLevel == ( level ) )
		{
			currentLevelChoiceIndices.append( i )
		}
	}
	return currentLevelChoiceIndices
}

array<int> function UpgradeCore_GetPassiveIndexChoicesForLevel( entity player, int level )
{
	array<int> levelChoicePassives
	array<UpgradeChoice> upgradesList = UpgradeCore_GetUpgradesForPlayer( player )
	for( int i = 0; i < upgradesList.len(); i++ )
	{
		if ( level == ( i / 2 ) )
		{
			levelChoicePassives.append( upgradesList[i].passiveIndex )
		}
	}
	return levelChoicePassives
}

void function UpgradeCore_AddCallback_OnHandleSelection( void functionref( entity, int ) callbackFunc )
{
	Assert( !file.onHandleSelectionCallbacks.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with UpgradeCore_AddCallback_OnHandleSelection" )
	file.onHandleSelectionCallbacks.append( callbackFunc )
}

void function RunCallbacks_OnHandleSelection( entity player, int upgradeIndex )
{
	foreach ( void functionref( entity, int ) callbackFunc in file.onHandleSelectionCallbacks )
	{
		callbackFunc( player, upgradeIndex )
	}
}



UpgradeChoice function UpgradeCore_GetUpgradeChoiceStructByIndex( entity player, int upgradeIndex )
{
	array<UpgradeChoice> upgradesList = UpgradeCore_GetUpgradesForPlayer( player )
	if( upgradeIndex < 0 || upgradeIndex >= upgradesList.len() )
	{
		UpgradeChoice invalidUpgrade
		invalidUpgrade.passiveIndex = ePassives.INVALID
		return invalidUpgrade
	}
	return clone upgradesList[upgradeIndex]
}


void function UpgardeCore_Init_DelayedUIUpgradeParse()
{
	WaitFrame()
	RunUIScript( "UpgradeCore_ParseUpgradeOverrides" )
}

string function UpgradeCore_GetUpgradeTitleString( entity player, int upgradeIndex )
