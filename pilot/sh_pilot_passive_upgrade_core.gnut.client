void function ShPassiveUpgradeCore_Init()
{

	PrecacheParticleSystem( SHIELD_CORE_PARTICLE_SYSTEM )


	UpgradeCore_InitTuningValues()
	if( !UpgradeCore_IsEnabled() )
		return







	UpgradeCore_SetupEvoLevelSystem()



		Remote_RegisterServerFunction( FUNCNAME_ClientToServer_UpgradeCore_HandleUpgradeSelection, "int", 0, UPGRADE_CORE_NUM_EXPECTED_UPGRADES, "bool" )
		Remote_RegisterClientFunction( FUNCNAME_ServerToClient_AcknowledgeUpgradeSelection, "int", 0, UPGRADE_CORE_NUM_EXPECTED_UPGRADES )
		Remote_RegisterClientFunction( FUNCNAME_ServerToClient_UpgradeCore_RefreshArmorHud, "entity" )

		RegisterSignal( "EndUpgradeCoreRui" )

		AddCallback_PlayerClassActuallyChanged( UpgradeCore_OnPlayerClassChanged )
		PrecacheParticleSystem( TROPHY_ELECTRICITY_FX )

		AddCallback_OnPassiveChanged( ePassives.PAS_GAS_GEAR, Passive_OnPassiveChanged )


			AddCallback_OnPassiveChanged( ePassives.PAS_GOLD_ARMOR_UPGRADE, Helmet_Gold_OnPassiveChanged )
			AddCallback_OnPassiveChanged( ePassives.PAS_RED_ARMOR_UPGRADE, Helmet_Red_OnPassiveChanged )




		AddCallback_LocalClientPlayerSpawned( UpgradeCore_OnLocalPlayerSpawned )
		AddClientCallback_OnResolutionChanged( UpgradeCore_OnResolutionChanged )
		AddCallback_UIScriptReset( UpgradeCore_OnUIScriptReset )
		RegisterNetVarIntChangeCallback( EVO_XP_NETINT, PlayerXpChanged_NetvarCallback )
		RegisterNetVarIntChangeCallback( UPGRADE_CORE_SELECTED_UPGRADES, UpgradeCore_PlayerCompletedLevelChanged )
		AddOnSpectatorTargetChangedCallback( UpgradeCore_OnSpectateTargetChanged )


	thread UpgradeCore_DelayedParseUpgradeOverrides()

	
	
	thread UpgardeCore_Init_DelayedUIUpgradeParse()

}

void function UpgradeCore_DelayedParseUpgradeOverrides()
{
	WaitFrame()
	thread UpgradeCore_ParseUpgradeOverrides()
}

void function UpgradeCore_InitTuningValues()
{

		RunUIScript( "UpgradeCore_InitTuningValues" )


	tuning.isEnabled = GetCurrentPlaylistVarBool( "passive_upgrade_core_enabled", true )


		tuning.mythicArmorUpgradeEnabled = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_mythic_armor_upgrade_enabled", false )
		tuning.mythicArmorUpgradeTuningEnabled = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_mythic_armor_upgrade_tuning_enabled", true )
		tuning.updateArmorEVOThresholds = GetCurrentPlaylistVarString( "passive_upgrade_core_updated_armor_xp_thresholds", tuning.updateArmorEVOThresholds )

	tuning.shouldArmorTierMatchPlayerLevel = GetCurrentPlaylistVarBool( "passive_upgrade_core_armor_match_player_level", tuning.shouldArmorTierMatchPlayerLevel )
	tuning.showGladCardUpgrades = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_glad_card_show_upgrades", true )
	tuning.showHudUpgradeSelection = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_show_hud_selection", true )
	tuning.showUpgradeTreeInventory = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_show_upgrade_tree_inventory", true )
	tuning.showUpgradesUnitframe = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_show_upgrade_unitframe", true )
	tuning.armorTiedToUpgrades = UpgradeCore_IsEnabled() && GetCurrentPlaylistVarBool( "passive_upgrade_armor_tied_to_upgrades", true )
	tuning.upgradeSelectionReminderDelay = GetCurrentPlaylistVarFloat( "passive_upgrade_core_reminder_hint_delay", tuning.upgradeSelectionReminderDelay )
	tuning.showUpgradeTreeLobbyMenu = GetCurrentPlaylistVarBool( "lobby_characters_upgrade_tree_enabled", true )
	tuning.showUpgradeTreeSkillsMenu = GetCurrentPlaylistVarBool( "skills_menu_upgrade_tree_enabled", true )
	tuning.showUpgradeTreeCharacterSelect = GetCurrentPlaylistVarBool( "character_select_upgrade_tree_enabled", true )
	tuning.cancelLevelUpRegenOnDamage = GetCurrentPlaylistVarBool( "cancel_level_up_regen_on_damage", true )
}

void function ShPassiveUpgradeCore_NetvarsInit()
{
	RegisterNetworkedVariable( UPGRADE_CORE_SELECTED_UPGRADES, SNDC_PLAYER_GLOBAL, SNVT_INT , 0.0 )
}

void function ShPassiveUpgradeCore_LobbyInit()
{
	ShPassiveUpgradeCore_NetvarsInit()
	UpgradeCore_InitTuningValues()

	thread ShPassiveUpgradeCore_LobbyInit_DelayedUpgradeOverridesParse()
}

void function ShPassiveUpgradeCore_LobbyInit_DelayedUpgradeOverridesParse()
{
	
	WaitFrame()
	UpgradeCore_ParseUpgradeOverrides()

	RunUIScript( "UpgradeCore_ParseUpgradeOverrides" )

}

