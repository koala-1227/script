array<int> function UpgradeCore_GetLevelXpThresholds()
{
	string defaults = UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER
	if( GetCurrentPlaylistVarString( "pin_match_type", "survival" ) == "duo" )
	{
		defaults = UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER_DUOS
	}


	if ( UpgradeCore_ArmorUpdates_S24_EVOTuning_Enabled() )
	{
		defaults = UpgradeCore_ArmorUpdates_Get_NewEVOThresholds()
	}


	string playlistStr = GetCurrentPlaylistVarString( "passive_upgrade_core_xp_thresholds", defaults )


	array<int> xpRequirements = ParseStringIntoIntArray( playlistStr )
	int cumulativeXp = 0
	array<int> result
	for( int i=0; i < xpRequirements.len(); i++ )
	{
		cumulativeXp += xpRequirements[i]
		result.append( cumulativeXp )
	}
	return result
}

void function UpgradeCore_SetupEvoLevelSystem()
{

		RunUIScript( "UpgradeCore_SetupEvoLevelSystem" )


	EvoLevelSystem system

	system.systemType = eEvoLevelSystemType.UPGRADE_CORE

	system.GetLevelXpThresholdsCallback = UpgradeCore_GetLevelXpThresholds


	system.GetSpentLevelsForPlayerCallback = UpgradeCore_GetSpentLevelsForPlayer









		EvoLevels_AddCallback_OnPlayerLevelUp( UpgradeCore_RuiUpdateOnLevelUp )


	EvoLevels_RegisterEvoLevelSystem( system )

	Assert( EvoLevels_GetMaxUpgradeLevels() <= UPGRADE_CORE_MAX_EXPECTED_LEVEL, "More levels than expected. Please upgate UPGRADE_CORE_MAX_EXPECTED_LEVEL" )
}















































































































































































































































