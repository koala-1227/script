void function Survival_HoverTanks_Init()
{
	if ( !HoverTanks_Enabled() )
		return

	
	FlagInit( "IntroHovertanksSet", false )

#if DEV
		printt( FUNC_NAME() + " run." )
		file.devOut = GetCurrentPlaylistVarBool( "hovertanks_devout", file.devOut )
		file.devDraw = GetCurrentPlaylistVarBool( "hovertanks_devdraw", file.devDraw )
		file.devDraw_Duration = GetCurrentPlaylistVarFloat( "hovertanks_devdraw_duration", file.devDraw_Duration )
#endif

	Tuning_Init()

	file.numHoverTanksIntro = tuning.hovertanks_Count_Intro 




	float chance = tuning.hovertanks_chance_intro * 100
	if ( RandomInt(100) > chance )
	{
		file.numHoverTanksIntro = 0
	}




	file.numHoverTanksMid = tuning.hovertanks_Count_Mid 




	chance = tuning.hovertanks_chance_mid * 100
	if ( RandomInt(100) > chance )
	{
		file.numHoverTanksMid = 0
	}


























		if ( file.numHoverTanksIntro > 0 || file.numHoverTanksMid > 0 )
		{
			
			SetMapFeatureItem( 500, "#HOVER_TANK", "#HOVER_TANK_DESC", ICON_HOVERTANK )
		}

		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.HOVERTANK, MINIMAP_OBJECT_RUI, MinimapPackage_HoverTank, FULLMAP_OBJECT_RUI, MinimapPackage_HoverTank )
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.HOVERTANK_DESTINATION, MINIMAP_OBJECT_RUI, MinimapPackage_HoverTankDestination, FULLMAP_OBJECT_RUI, MinimapPackage_HoverTankDestination )

		AddCreateCallback( "prop_dynamic", OnSpawned_Ent )
		AddCreateCallback( "prop_script", OnSpawned_Ent )







































































}

void function Tuning_Init()
{















































	
	tuning.hovertanks_chance_intro = GetCurrentPlaylistVarFloat( "hovertanks_chance_intro", tuning.hovertanks_chance_intro )
	tuning.hovertanks_chance_mid 	= GetCurrentPlaylistVarFloat( "hovertanks_chance_mid", 	 tuning.hovertanks_chance_mid )

	tuning.hovertanks_Count_Intro	= GetCurrentPlaylistVarInt( "hovertanks_count_intro", tuning.hovertanks_Count_Intro )
	tuning.hovertanks_Count_Mid	= GetCurrentPlaylistVarInt( "hovertanks_count_mid", tuning.hovertanks_Count_Mid )

	tuning.count_EndNodes_Intro 	= GetCurrentPlaylistVarInt( "hovertanks_count_endnodes_intro", 	 tuning.count_EndNodes_Intro )
	tuning.count_EndNodes_Mid 		= GetCurrentPlaylistVarInt( "hovertanks_count_endnodes_mid", 	 tuning.count_EndNodes_Mid )

	tuning.hovertanks_FlyInStyle = PlaylistVarInt_Resolve_VsLegacy( "hovertanks_FlyinStyle", "canyonlands_hovertank_flyin", tuning.hovertanks_FlyInStyle )

	
	tuning.exclude_LastRingEndNodes = GetCurrentPlaylistVarBool( "hovertanks_exclude_LastRingEndNodes", tuning.exclude_LastRingEndNodes )
	tuning.useDynamicLocations = PlaylistVarBool_Resolve_VsLegacy( "hovertanks_useDynamicLocations", "canyonlands_dynamic_hovertank_locations", tuning.useDynamicLocations )

	
	tuning.shipIcons_Enabled 		= GetCurrentPlaylistVarBool( "hovertanks_shipIcons_Enabled", tuning.shipIcons_Enabled )
	tuning.shipIcons_AlwaysVisible = GetCurrentPlaylistVarBool( "hovertanks_shipIcons_AlwaysVisible", tuning.shipIcons_AlwaysVisible )

	tuning.endPointIcons_Enabled = GetCurrentPlaylistVarBool( "hovertanks_endPointIcons_Enabled", tuning.endPointIcons_Enabled )
	tuning.endPointIcons_Persist = GetCurrentPlaylistVarBool( "hovertanks_endPointIcons_Persist", tuning.endPointIcons_Persist )

	
	tuning.midCircle_Index = PlaylistVarInt_Resolve_VsLegacy( "hovertanks_midCircle_Index", "canyonlands_hovertanks_circle_index", tuning.midCircle_Index )

	
	tuning.hide_UnusedPOIGeo = GetCurrentPlaylistVarBool( "hovertanks_hide_UnusedPoiGeo", tuning.hide_UnusedPOIGeo )

	
	tuning.calcSpeed_Max = GetCurrentPlaylistVarFloat( "hovertanks_calcspeed_max", tuning.calcSpeed_Max )

	
	tuning.emergencyZiplines_Enabled	= GetCurrentPlaylistVarBool( "hovertanks_emergencyziplines_enabled", tuning.emergencyZiplines_Enabled )
	tuning.alwaysUse_EmergencyZipline_Starts = GetCurrentPlaylistVarBool( "hovertanks_alwaysuse_emergencyzipline_starts", tuning.alwaysUse_EmergencyZipline_Starts )
	tuning.emergencyZiplines_MaxLength	= GetCurrentPlaylistVarFloat( "hovertanks_emergencyziplines_maxlength", tuning.emergencyZiplines_MaxLength )

	
	tuning.customLootSpawn_Enabled 		= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_enabled", tuning.customLootSpawn_Enabled )
	tuning.customLootSpawn_WeaponSets_Str 	= GetCurrentPlaylistVarString( "hovertanks_customlootspawn_weaponsets", tuning.customLootSpawn_WeaponSets_Str )
	tuning.customLootSpawn_WeaponSets 		= GetTrimmedSplitString( tuning.customLootSpawn_WeaponSets_Str, " " )
	tuning.customLootSpawn_AmmoStacks_ToSpawn = GetCurrentPlaylistVarInt( "hovertanks_customlootspawn_ammostacks_tospawn", tuning.customLootSpawn_AmmoStacks_ToSpawn )

	tuning.customLootSpawn_Regenerating_Enabled	= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_regenerating_enabled", tuning.customLootSpawn_Regenerating_Enabled )
	tuning.customLootSpawn_Regenerating_Delay		= GetCurrentPlaylistVarFloat( "hovertanks_customlootspawn_regenerating_delay", tuning.customLootSpawn_Regenerating_Delay )

	tuning.customLootSpawn_Arsenal_Enabled			= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_arsenal_enabled", tuning.customLootSpawn_Arsenal_Enabled )
	tuning.customLootSpawn_Arsenal_WeaponSets_Str 	= GetCurrentPlaylistVarString( "hovertanks_customlootspawn_weaponsets", tuning.customLootSpawn_Arsenal_WeaponSets_Str )
	tuning.customLootSpawn_Arsenal_WeaponSets 		= GetTrimmedSplitString( tuning.customLootSpawn_Arsenal_WeaponSets_Str, " " )























}

bool function PlaylistVarBool_Resolve_VsLegacy( string newString, string legacyStr, bool defaultValue )
{
	const int INT_UNDEF = -1
	int use_Legacy 	= GetCurrentPlaylistVarInt( legacyStr, INT_UNDEF )
	int use_New 	= GetCurrentPlaylistVarInt( newString, INT_UNDEF )
	if ( use_New > INT_UNDEF )
	{
		return( use_New == 1 ? true : false )
	}
	else if ( use_Legacy > INT_UNDEF )
	{
		return(  use_Legacy == 1 ? true : false )
	}

	return( defaultValue )
}

int function PlaylistVarInt_Resolve_VsLegacy( string newString, string legacyStr, int defaultValue )
{
	const int INT_INVALID = -999999
	int use_Legacy 	= GetCurrentPlaylistVarInt( legacyStr, 	INT_INVALID )
	int use_New 	= GetCurrentPlaylistVarInt( newString, 	INT_INVALID )
	if ( use_New > INT_INVALID )
	{
		return( use_New )
	}
	else if ( use_Legacy > INT_INVALID )
	{
		return(  use_Legacy )
	}

	return defaultValue
}

























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































