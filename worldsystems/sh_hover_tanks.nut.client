void function _DevOut( string printMe , bool forceOut = false )
{
	if ( !file.devOut && !forceOut )
		return

	printt( "DEV:>" + printMe )
}

void function _DevSphere( vector loc, float radius, vector color, bool showThruGeo, float duration = -1 )
{
	if ( !file.devDraw )
		return

	if ( duration == -1 )
	{
		duration = file.devDraw_Duration
	}

	DebugDrawSphere( loc, radius, color, showThruGeo, duration )
}

void function _DevCube( vector loc,float radius, vector color, bool showThruGeo, float duration = -1  )
{
	if ( !file.devDraw )
		return

	if ( duration == -1 )
	{
		duration = file.devDraw_Duration
	}

	DebugDrawCube( loc, radius, color, showThruGeo, duration )
}

void function _DevCylinder( vector loc, vector angles, float radius, float height, vector color, bool showThruGeo, float duration = -1 )
{
	if ( !file.devDraw )
		return

	if ( duration == -1 )
	{
		duration = file.devDraw_Duration
	}
	DebugDrawCylinder( loc, angles, radius, height, color, showThruGeo, duration )
}






























