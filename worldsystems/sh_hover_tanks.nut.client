bool function HoverTanks_Enabled()
{
	bool isEnabled = GetCurrentPlaylistVarBool( "hover_tanks_enabled", true )
	return isEnabled
}

























































































vector function _Calculate_AdjustedLoc( entity referenceEnt, vector referenceLoc, vector vAdjustments )
{
	vector result 

	if ( !IsValid( referenceEnt ))
		return referenceLoc

	vector vecDir_R = Normalize( referenceEnt.GetRightVector() )
	vector vecDir_F = Normalize( referenceEnt.GetForwardVector() )
	vector vecDir_U = Normalize( referenceEnt.GetUpVector() )

	vector vAdjustLR = vecDir_R * vAdjustments.x * METERS_TO_INCHES
	vector vAdjustFB = vecDir_F * vAdjustments.y * METERS_TO_INCHES
	vector vAdjustUD = vecDir_U * vAdjustments.z * METERS_TO_INCHES
	result = referenceLoc + vAdjustLR + vAdjustFB + vAdjustUD

	return result
}



