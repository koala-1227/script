array< int > function Arsenals_GetAmmoIdxsAtArsenal( ArsenalData arsenalData )
{
	array < int > idxs
	int blocksToSpawn = Arsenals_GetAmmoBlocksPerArsenal()
	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return idxs

	if ( blocksToSpawn == 2 )
	{
		idxs.append( 1 )
		idxs.append( arsenalEnt.GetItemCount() - 1 - ((arsenalEnt.GetItemCount() + 1) % 2) )
	}
	else
	{
		for ( int i = 0; i < blocksToSpawn; i++ )
		{
			idxs.append( arsenalEnt.GetItemCount() - 1 - i )
		}
	}

	return idxs
}

vector function Arsenals_GetOriginForWeaponIdxAtArsenal( int i, ArsenalData arsenalData, int ammoType = -1 )
{
	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return ZERO_VECTOR










		int numWeapons = arsenalEnt.GetItemCount()


	return GetWeaponPositionForIdx_Internal( i, arsenalEnt, numWeapons )
}

const float WEAPON_POS_DISTANCE_BUFFER = 5 * 5
int function Arsenals_GetWeaponIdxForOriginAtArsenal( vector origin, ArsenalData arsenalData, int ammoType = -1 )
{
	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return -1










		int numWeapons = arsenalEnt.GetItemCount()


	bool isEven = DotProduct( arsenalEnt.GetForwardVector(), ( origin - arsenalEnt.GetOrigin() ) ) > 0
	int startIdx = isEven ? 0 : 1
	for ( int i = startIdx; i < numWeapons; i+=2 )
	{
		vector testPos = GetWeaponPositionForIdx_Internal( i, arsenalEnt, numWeapons )
		if ( DistanceSqr( testPos, origin ) < WEAPON_POS_DISTANCE_BUFFER )
			return i
	}

	return -1
}

const float ARSENALS_FORWARD_SCALAR = 32
const float ARSENALS_UP_SCALAR = 27
const float ARSENALS_RIGHT_SCALAR = -30
const float ARSENALS_LENGTH = 50
vector function GetWeaponPositionForIdx_Internal( int idx, entity arsenalEnt, int numWeapons )
{
	vector rackAngles = AnglesCompose( arsenalEnt.GetAngles(), < 0, 360.0 / 2 * (idx % 2), 0 > )
	vector weaponForward = AnglesToForward( rackAngles ) * ARSENALS_FORWARD_SCALAR

	vector upAdjustment = arsenalEnt.GetUpVector() * ARSENALS_UP_SCALAR
	
	
	int countPerSide = int( floor( (numWeapons + ((idx + 1) % 2)) / 2.0 ) )
	float rightMultiplier = ARSENALS_LENGTH / ( countPerSide - 1 ) * ( floor( idx / 2 ) - ( countPerSide - 1 ) / 2.0 )
	vector rightAdjustment = rightMultiplier * arsenalEnt.GetRightVector()

	return arsenalEnt.GetOrigin() + upAdjustment + weaponForward + rightAdjustment
}

const float ARSENAL_ROTATION = 48
vector function Arsenals_GetWeaponAngleForIdxAtArsenal( int idx, entity arsenalEnt, bool isAmmo )
{
	if ( !IsValid( arsenalEnt ) )
		return ZERO_VECTOR

	vector rackAngles = AnglesCompose( arsenalEnt.GetAngles(), < 0, 180.0 * (idx % 2), 0 > )
	if ( isAmmo )
		return AnglesCompose( rackAngles, < 90 - ARSENAL_ROTATION, 0, 0 > )

	return AnglesCompose( AnglesCompose( rackAngles, < -90, 90, 0 > ), < 0, ARSENAL_ROTATION, 0> )
}

vector function Arsenals_GetRespawnTimerAngleForIdxAtArsenal( int idx, entity arsenalEnt )
{
	if ( !IsValid( arsenalEnt ) )
		return ZERO_VECTOR

	vector rackAngles = AnglesCompose( arsenalEnt.GetAngles(), < 0, 180.0 * ((idx + 1) % 2), 0 > )

	return AnglesCompose( rackAngles, < 58, 0, 0 > )
}

bool function Arsenals_PlayerCanUseArsenalConsole( entity player, ArsenalData arsenalData )
{
	if ( !IsValid( player ) )
		return false

	if ( player.p.isInExtendedUse )
		return false






		if ( file.arsenalsUsed.contains( arsenalData.arsenalEHI ) )
			return false


	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return false

	string ammoTypeStr = AmmoType_GetRefFromIndex( arsenalEnt.GetAmmoType() )
	return DoesPlayerHaveUpgradableWeaponOfAmmoType( player, ammoTypeStr )
}

bool function DoesPlayerHaveUpgradableWeaponOfAmmoType( entity player, string ammoType )
{
	if ( !IsValid( player ) )
		return false

	if ( !SURVIVAL_Loot_IsRefValid( ammoType ) )
		return false

	for ( int i = 0; i < 2; i++ )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
		if( IsWeaponUpgradableOfAmmoType( weapon, ammoType ) )
			return true
	}

	return false
}

bool function PlayerHasAllWeapons( entity player )
{
	if ( !IsValid( player ) )
		return false

	bool hasSlingOrNotBallistic = !DoesPlayerHaveWeaponSling( player ) || IsValid( GetPlayerSlingWeapon( player ) )
	return IsValid( player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 ) ) && IsValid( player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 ) ) && hasSlingOrNotBallistic
}



string function Arsenals_GetWeaponSetStringForTier( int tier )
{
	return ARSENALS_WEAPON_SET_STRINGS_FOR_TIER[tier]
}

string function GetParticleWeaponRef( string baseWeaponRef )
{
	if ( IsLootRefAmmo( baseWeaponRef ) )
		return baseWeaponRef

	
	if ( ARSENALS_PARTICLE_REF_EXCEPTIONS.contains( baseWeaponRef ) )
		return baseWeaponRef

	return Weapon_GetBaseClassName( baseWeaponRef )
}

int function Arsenals_GetStackCount( string ref )
{
	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )

	if ( data.lootType == eLootType.MAINWEAPON )
		return 1

	bool isShotgunOrSniper = ref == SHOTGUN_AMMO || ref == SNIPER_AMMO

	bool giveFullAmmo = Arsenals_AmmoSpawnsFullStacks() || ( Arsenals_ArsenalResetResetsAmmo() && file.arsenalsReset )
	if ( giveFullAmmo && isShotgunOrSniper )
		return 2 * data.countPerDrop
	else if ( giveFullAmmo )
		return 3 * data.countPerDrop
	else if ( isShotgunOrSniper )
		return int( data.countPerDrop * Arsenals_ShotgunSniperAmmoMultiplier() )

	return int( data.countPerDrop * Arsenals_LightHeavyEnergyAmmoMultiplier() )
}

bool function SpawnDataHasPresetAmmoSpawning( ArsenalSpawnData arsenalSpawnData )
{
	if ( !arsenalSpawnData.canSpawnLight )
		return true

	if ( !arsenalSpawnData.canSpawnHeavy )
		return true

	if ( !arsenalSpawnData.canSpawnEnergy )
		return true

	if ( !arsenalSpawnData.canSpawnShotgun )
		return true

	if ( !arsenalSpawnData.canSpawnSniper )
		return true

	return false
}

array< string > function GetPresetAmmoTypesFromArsenalSpawnData( ArsenalSpawnData arsenalSpawnData, array< string > possibleAmmoTypes )
{
	array< string > allowedAmmoTypes
	if ( arsenalSpawnData.canSpawnLight && possibleAmmoTypes.contains( BULLET_AMMO ) )
	{
		allowedAmmoTypes.append( BULLET_AMMO )
	}
	if ( arsenalSpawnData.canSpawnHeavy && possibleAmmoTypes.contains( HIGHCAL_AMMO ) )
	{
		allowedAmmoTypes.append( HIGHCAL_AMMO )
	}
	if ( arsenalSpawnData.canSpawnEnergy && possibleAmmoTypes.contains( SPECIAL_AMMO ) )
	{
		allowedAmmoTypes.append( SPECIAL_AMMO )
	}
	if ( arsenalSpawnData.canSpawnShotgun && possibleAmmoTypes.contains( SHOTGUN_AMMO ) )
	{
		allowedAmmoTypes.append( SHOTGUN_AMMO )
	}
	if ( arsenalSpawnData.canSpawnSniper && possibleAmmoTypes.contains( SNIPER_AMMO ) )
	{
		allowedAmmoTypes.append( SNIPER_AMMO )
	}

	Assert( allowedAmmoTypes.len() > 0, "We tried to spawn an Arsenal while preventing it from being any ammo type. This breaks shit. Send to BR Systems" )
	return allowedAmmoTypes
}














void function ServerToClient_Arsenals_SetGroupParentLocation( int groupID, vector pos )
{
	if ( groupID in file.arsenalGroupParentLocations )
		return

	file.arsenalGroupParentLocations[groupID] <- pos
}


const float ARSENAL_POI_LABEL_MAX_DISTANCE = 5000.0
const float ARSENAL_POI_LABEL_MAX_DISTANCE_SQR = ARSENAL_POI_LABEL_MAX_DISTANCE * ARSENAL_POI_LABEL_MAX_DISTANCE
void function Arsenals_LoadPOINameData( table< int, vector > zonePositions )
{
	
	table< int, array< EHI > > groupToArsenalEHIMap
	foreach ( arsenalData in file.arsenalEHIToArsenalDataMap )
	{
		entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
		if ( !IsValid( arsenalEnt ) )
			continue

		int group = arsenalEnt.GetGroupNumber()
		if ( group in groupToArsenalEHIMap )
		{
			groupToArsenalEHIMap[group].append( arsenalData.arsenalEHI )
		}
		else
		{
			groupToArsenalEHIMap[group] <- [ arsenalData.arsenalEHI ]
		}
	}

	
	table < int, string > zoneIdMapNames = clone ZoneSkyWriting_GetZoneIdMapNamesToDisplay()
	foreach ( zoneId in zonePositions.clonekeys() )
	{
		if ( !( zoneId in zoneIdMapNames ) )
		{
			delete zonePositions[zoneId]
		}
	}

	
	
	
	table< EHI, int > arsenalEHIToPOIZoneIdMap
	foreach ( zoneId, zonePosition in zonePositions )
	{
		vector zonePosition2D = FlattenVec( zonePosition )
		array< EHI > nearbyArsenalEHIs = GetClosestArsenalEHIArrayWithinRangeOfLocation( zonePosition2D, ARSENAL_POI_LABEL_MAX_DISTANCE, Arsenals_MaxDisplayedPerPOI() )

		
		
		
		foreach ( groupId, pos in file.arsenalGroupParentLocations )
		{
			if ( Distance2DSqr( pos, zonePosition2D ) < ARSENAL_POI_LABEL_MAX_DISTANCE_SQR )
			{
				foreach ( groupedArsenalEHI in groupToArsenalEHIMap[groupId] )
				{
					if ( !nearbyArsenalEHIs.contains( groupedArsenalEHI ) )
					{
						nearbyArsenalEHIs.append( groupedArsenalEHI )
					}
				}
			}
		}

		int i = 0;
		while ( i < nearbyArsenalEHIs.len() )
		{
			EHI arsenalEHI = nearbyArsenalEHIs[i]
			entity arsenalEnt = FromEHI( arsenalEHI )
			if ( !IsValid( arsenalEnt ) )
				continue

			array < EHI > arsenalsInGroup = groupToArsenalEHIMap[arsenalEnt.GetGroupNumber()]
			foreach ( groupedArsenalEHI in arsenalsInGroup )
			{
				if ( !nearbyArsenalEHIs.contains( groupedArsenalEHI ) )
				{
					nearbyArsenalEHIs.append( groupedArsenalEHI )
				}
			}

			if ( !( arsenalEHI in arsenalEHIToPOIZoneIdMap ) )
			{
				arsenalEHIToPOIZoneIdMap[arsenalEHI] <- zoneId
			}
			else if ( Distance2DSqr( zonePositions[arsenalEHIToPOIZoneIdMap[arsenalEHI]], arsenalEnt.GetOrigin() ) > Distance2DSqr( zonePosition2D, arsenalEnt.GetOrigin() ) )
			{
				arsenalEHIToPOIZoneIdMap[arsenalEHI] = zoneId
			}

			i++
		}
	}

	
	foreach ( arsenalEHI, zoneId in arsenalEHIToPOIZoneIdMap )
	{
		entity arsenalEnt = FromEHI( arsenalEHI )
		if ( !IsValid( arsenalEHI ) )
			continue

		if ( zoneId in file.zoneIdToArsenalsMap )
		{
			file.zoneIdToArsenalsMap[zoneId].append( file.arsenalEHIToArsenalDataMap[arsenalEHI] )
		}
		else
		{
			file.zoneIdToArsenalsMap[zoneId] <- [ file.arsenalEHIToArsenalDataMap[arsenalEHI] ]
		}
	}
}

array< ArsenalData > function Arsenals_GetArsenalsWithinRangeOfPOIZone( int zoneId )
{
	if ( zoneId in file.zoneIdToArsenalsMap )
	{
		return file.zoneIdToArsenalsMap[zoneId]
	}

	array< ArsenalData > emptyArray
	return emptyArray
}


