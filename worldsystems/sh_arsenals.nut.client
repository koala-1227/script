int function Arsenals_GetPingTypeForEnt( entity arsenalEnt )
{
	Assert( IsValid( arsenalEnt ), "The ping ent for an arsenal must be valid, send this to BR Systems" )

	int ammoType = arsenalEnt.GetAmmoType()
	int pingType
	switch( ammoType )
	{
		case eAmmoPoolType.bullet:
			pingType = ePingType.ARSENAL_LIGHT
			break



		case eAmmoPoolType.highcal:
			pingType = ePingType.ARSENAL_HEAVY
			break
		case eAmmoPoolType.special:
			pingType = ePingType.ARSENAL_ENERGY
			break
		case eAmmoPoolType.shotgun:
			pingType = ePingType.ARSENAL_SHOTGUN
			break
		case eAmmoPoolType.sniper:
			pingType = ePingType.ARSENAL_SNIPER
			break
		default:
			Warning( "entity " + arsenalEnt + " has unknown ammo type " + ammoType + ". Returning a default value." )
			pingType = ePingType.ARSENAL_LIGHT
			break
	}

#if DEV
		printt( FUNC_NAME() + "(): Arsenal Ping Type == " + GetEnumStringSlow( ePingType, pingType ) )
#endif
	return pingType
}

int function Arsenals_GetPingTypeForEnt_FromInventory( entity arsenalEnt )
{
	Assert( IsValid( arsenalEnt ), "The ping ent for an arsenal must be valid, send this to BR Systems" )
	int ammoType = arsenalEnt.GetAmmoType()
	int pingType
	switch( ammoType )
	{
		case eAmmoPoolType.bullet:
			pingType = ePingType.ARSENAL_LIGHT_FROM_INVENTORY
			break



		case eAmmoPoolType.highcal:
			pingType = ePingType.ARSENAL_HEAVY_FROM_INVENTORY
			break
		case eAmmoPoolType.special:
			pingType = ePingType.ARSENAL_ENERGY_FROM_INVENTORY
			break
		case eAmmoPoolType.shotgun:
			pingType = ePingType.ARSENAL_SHOTGUN_FROM_INVENTORY
			break
		case eAmmoPoolType.sniper:
			pingType = ePingType.ARSENAL_SNIPER_FROM_INVENTORY
			break
		default:
			Warning( "entity " + arsenalEnt + " has unknown ammo type " + ammoType + ". Returning a default value." )
			pingType = ePingType.ARSENAL_LIGHT_FROM_INVENTORY
			break
	}

#if DEV
		printt( FUNC_NAME() + "(): Arsenal Ping Type from Inventory == " + GetEnumStringSlow( ePingType, pingType ) )
#endif
	return pingType
}

