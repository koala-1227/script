{}
#endif

string function Arsenals_GetWeaponRefToUpgradeAtArsenal( entity player, ArsenalData arsenalData, bool checkAfterLootReset = false )
{
	if ( !IsValid( player ) )
		return ""

	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return ""

	int indexToUpgrade = Arsenals_GetWeaponIdxToUpgradeAtArsenal( player, AmmoType_GetRefFromIndex( arsenalEnt.GetAmmoType() ), checkAfterLootReset )
	if ( indexToUpgrade == -1 )
		return ""

	entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + indexToUpgrade )
	return GetBaseWeaponRef( GetWeaponClassNameWithLockedSet( weapon ) )
}

int function Arsenals_GetWeaponIdxToUpgradeAtArsenal( entity player, string ammoTypeStr, bool checkAfterLootReset = false )
{
	if ( !IsValid( player ) )
		return -1

	array< int > slotsToCheck

	entity selectedWeapon = player.GetSelectedWeapon( eActiveInventorySlot.mainHand )
	entity weapon1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
	entity weapon2 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
	if ( selectedWeapon == weapon1 )
	{
		slotsToCheck = [ 0, 1 ]
	}
	else if ( selectedWeapon == weapon2 )
	{
		slotsToCheck = [ 1, 0 ]
	}
	else
	{
		int activeSlot = SURVIVAL_GetActiveWeaponSlot( player )
		slotsToCheck = [ activeSlot, 1 - activeSlot ]
	}

	foreach( weaponIdx in slotsToCheck )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + weaponIdx )
		if ( IsWeaponUpgradableOfAmmoType( weapon, ammoTypeStr, checkAfterLootReset ) )
			return weaponIdx
	}

	return -1
}







































































































































































































































































































































string function Arsenals_GetAmmoTypeStringForBaseWeaponRef( string baseWeaponRef )
{
	string overrideAmmoType = GetCurrentPlaylistVarString( "arsenals_ammo_override_" + baseWeaponRef, "" )
	if ( overrideAmmoType == NOT_ON_ARSENAL_STR )
		return NOT_ON_ARSENAL_STR

	string ammoType = (overrideAmmoType == "") ? GetWeaponAmmoType( baseWeaponRef ) : overrideAmmoType








	if ( !SURVIVAL_Loot_IsRefValid( ammoType ) || ammoType == ARROWS_AMMO )



	{
		
		ammoType = SNIPER_AMMO
	}

	return ammoType
}

string function Arsenals_GetAmmoTypeForWeaponEnt( entity weapon )
{
	if( !IsValid( weapon ) )
		return ""

	string weaponRef = GetWeaponClassNameWithLockedSet( weapon )
	if( !SURVIVAL_Loot_IsRefValid( weaponRef ) )
		return ""

	LootData data = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
	if( data.lootType != eLootType.MAINWEAPON || data.tier == eLootTier.MYTHIC )
		return ""

	return Arsenals_GetAmmoTypeStringForBaseWeaponRef( data.baseWeapon )
}

array< string > function GetPlayerWeaponsOfAmmoType( entity player, string ammoTypeStr )
{
	array< string > weapons
	if ( !SURVIVAL_Loot_IsRefValid( ammoTypeStr ) )
		return weapons

	for( int i = 0; i < 2; i++ )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
		if ( !IsValid( weapon ) )
			continue

		string weaponAmmoTypeStr = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
		if ( weaponAmmoTypeStr == ammoTypeStr || ( GetBaseWeaponRef( GetWeaponClassNameWithLockedSet( weapon ) ) == "mp_weapon_car" &&
				ammoTypeStr == BULLET_AMMO && weaponAmmoTypeStr != NOT_ON_ARSENAL_STR ) )
		{
			weapons.append( GetBaseWeaponRef( GetWeaponClassNameWithLockedSet( weapon ) ) )
		}
	}

	return weapons
}

bool function IsWeaponUpgradableOfAmmoType( entity weapon, string ammoTypeStr, bool checkAfterLootReset = false )
{
	if ( !SURVIVAL_Loot_IsRefValid( ammoTypeStr ) )
		return false

	if ( !IsValid( weapon ) )
		return false

	string baseWeaponRef = GetBaseWeaponRef( GetWeaponClassNameWithLockedSet( weapon ) )
	if ( GetCurrentPlaylistVarBool( "arsenals_disable_upgrade_" + baseWeaponRef, false ) )
		return false

	string ammoRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
	bool carArsenalOverride = baseWeaponRef == "mp_weapon_car" && ammoTypeStr == BULLET_AMMO && ammoRef != NOT_ON_ARSENAL_STR
	if ( ( ammoRef != ammoTypeStr && !carArsenalOverride ) || Arsenals_IsWeaponMaxed( weapon, true, checkAfterLootReset ) )
		return false

	return true
}

bool function Arsenals_IsWeaponMaxed( entity weapon, bool testSight = false, bool checkAfterLootReset = false )
{
	if ( !IsValid( weapon ) )
		return false

	string weaponRef = GetWeaponClassNameWithLockedSet( weapon )

	if ( Arsenals_EnableUpgradingLockedSets() && WeaponLootRefIsLockedSet( weaponRef ) )
		return Arsenals_IsLockedSetRefMaxed( weaponRef, checkAfterLootReset )
	else if ( WeaponLootRefIsLockedSet( weaponRef ) )
		return true

	string baseRef = GetBaseWeaponRef( weaponRef )
	LootData baseWeaponData = SURVIVAL_Loot_GetLootDataByRef( baseRef )
	array< string > attachmentSlots = clone baseWeaponData.supportedAttachments

	table< string, string > attachmentSlotsToCurrentAttachmentMap

	foreach ( attachment in attachmentSlots )
	{
		attachmentSlotsToCurrentAttachmentMap[attachment] <- GetInstalledWeaponAttachmentForPoint( weapon, attachment )
	}

	for ( int i = 0; i < attachmentSlotsToCurrentAttachmentMap.len(); i++ )
	{
		string attachmentType = attachmentSlots[i]
		if ( SURVIVAL_IsAttachmentPointLocked( weaponRef, attachmentType, weapon.GetMods() ) )
			continue

		string currentAttachment = attachmentSlotsToCurrentAttachmentMap[attachmentType]

		bool isSight = attachmentType == "sight"
		if ( (!testSight && isSight) || (isSight && currentAttachment != "") )
			continue

		string upgradeAttachment
		if ( currentAttachment == "" )
		{
			upgradeAttachment = Arsenals_GetFirstAttachmentForAttachPointOfTier( attachmentType, weaponRef, attachmentType == "hopup" ? EMPTY_HOPUP_TIER + 1 : Arsenals_GetMinAttachmentUpgradeTier(), checkAfterLootReset )
		}
		else
		{
			upgradeAttachment = Arsenals_GetUpgradeForWeaponAttachment( weaponRef, currentAttachment, checkAfterLootReset )
		}

		
		
		if ( !SURVIVAL_Loot_IsRefValid( upgradeAttachment ) )
			continue

		LootData upgradeData = SURVIVAL_Loot_GetLootDataByRef( upgradeAttachment )
		if ( Arsenals_PreventGoldUpgradeBeforeBinResets() && !file.arsenalsReset && upgradeData.tier > PURPLE_TIER && !checkAfterLootReset )
			continue

		if ( currentAttachment != upgradeAttachment )
			return false
	}


		LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )
		if ( DormantHopups_WeaponHasDormantHopupInBaseMods( weaponData ) && !DormantHopups_IsHopupUnlocked( weapon, weaponData ) )
			return false


	return true
}

int function Arsenals_GetMinAttachmentTierForWeapon( entity weapon, bool includeSight = false )
{
	if ( !IsValid( weapon ) )
		return 0

	if ( Arsenals_IsWeaponMaxed( weapon ) )
		return 4

	string weaponRef = GetWeaponClassNameWithLockedSet( weapon )
	if ( WeaponLootRefIsLockedSet( weaponRef ) )
		return Arsenals_GetLockedSetTier( weaponRef )

	string baseRef = GetBaseWeaponRef( weaponRef )
	LootData baseWeaponData = SURVIVAL_Loot_GetLootDataByRef( baseRef )
	array< string > attachmentSlots = clone baseWeaponData.supportedAttachments

	int minTier = 10
	foreach ( attachment in attachmentSlots )
	{
		if ( SURVIVAL_IsAttachmentPointLocked( weaponRef, attachment, weapon.GetMods() ) )
			continue

		if ( !includeSight && attachment == "sight" )
			continue

		string currAttachment = GetInstalledWeaponAttachmentForPoint( weapon, attachment )

		if ( !SURVIVAL_Loot_IsRefValid( currAttachment ) )
		{
			if ( attachment.find( "hopup" ) == -1 )
			{
				return 0
			}
			else if ( minTier > EMPTY_HOPUP_TIER ) 
			{
				minTier = EMPTY_HOPUP_TIER
			}

			continue
		}

		LootData attachmentData = SURVIVAL_Loot_GetLootDataByRef( currAttachment )
		if ( attachmentData.tier < minTier )
		{
			minTier = attachmentData.tier
		}
	}

	return minTier
}

array< string > function Arsenals_GetWeaponAttachmentsOfLevel( string weaponRef, int tier )
{
	LootData baseWeaponData = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
	array< string > attachmentSlots = clone baseWeaponData.supportedAttachments
	array< string > attachments

	foreach ( attachmentSlot in attachmentSlots )
	{
		int tierToUse = tier
		if ( attachmentSlot == "sight" && tier > 1 )
		{
			tierToUse = 1
		}

		string attachmentRef = Arsenals_GetFirstAttachmentForAttachPointOfTier( attachmentSlot, weaponRef, tierToUse )
		if ( attachmentRef != "" )
		{
			attachments.append( attachmentRef )
		}
	}

	return attachments
}

bool function Arsenals_IsLockedSetRefMaxed( string weaponRef, bool checkAfterLootReset )
{
	int weaponTier = Arsenals_GetLockedSetTier( weaponRef )
	if ( Arsenals_PreventGoldUpgradeBeforeBinResets() && !file.arsenalsReset && !checkAfterLootReset )
		return weaponTier >= 3

	return weaponTier >= 4
}

int function Arsenals_GetLockedSetTier( string weaponRef )
{
	LootData data = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
	return data.tier
}

string function Arsenals_GetLockedSetUpgradeRef( string weaponRef )
{
	string baseWeaponRef = GetBaseWeaponRef( weaponRef )
	if ( weaponRef.find( WEAPON_LOCKEDSET_SUFFIX_GOLD ) != -1 )
		return weaponRef
	else if( weaponRef.find( WEAPON_LOCKEDSET_SUFFIX_PURPLESET ) != -1 )
		return baseWeaponRef + WEAPON_LOCKEDSET_SUFFIX_GOLD
	else if( weaponRef.find( WEAPON_LOCKEDSET_SUFFIX_BLUESET ) != -1 )
		return baseWeaponRef + WEAPON_LOCKEDSET_SUFFIX_PURPLESET
	else if( weaponRef.find( WEAPON_LOCKEDSET_SUFFIX_WHITESET ) != -1 )
		return baseWeaponRef + WEAPON_LOCKEDSET_SUFFIX_BLUESET

	return weaponRef + WEAPON_LOCKEDSET_SUFFIX_WHITESET
}


array< string > function Arsenals_GetQuickUpgradeAttachments_Ordered( entity weapon )
{
	string weaponRef = GetWeaponClassNameWithLockedSet( weapon )
	Assert( !WeaponLootRefIsLockedSet( weaponRef ), "You cannot call this function with a locked set weapon. Send this to BR Systems" )
	string baseRef = GetBaseWeaponRef( weaponRef )
	LootData baseWeaponData = SURVIVAL_Loot_GetLootDataByRef( baseRef )
	array< string > attachmentSlots = clone baseWeaponData.supportedAttachments

	table< string, string > attachmentSlotsToCurrentAttachmentMap
	int minTier = 10

	foreach ( attachment in attachmentSlots )
	{
		if ( SURVIVAL_IsAttachmentPointLocked( weaponRef, attachment, weapon.GetMods() ) )
			continue

		string currAttachment = GetInstalledWeaponAttachmentForPoint( weapon, attachment )
		attachmentSlotsToCurrentAttachmentMap[attachment] <- currAttachment

		if ( attachment == "sight" )
			continue

		if ( !SURVIVAL_Loot_IsRefValid( currAttachment ) )
		{
			if ( attachment.find( "hopup" ) == -1 )
			{
				minTier = 0
			}
			else if ( minTier > EMPTY_HOPUP_TIER ) 
			{
				minTier = EMPTY_HOPUP_TIER
			}

			continue
		}

		LootData attachmentData = SURVIVAL_Loot_GetLootDataByRef( currAttachment )
		if ( attachmentData.tier < minTier )
		{
			minTier = attachmentData.tier
		}
	}

	array< string > upgradeAttachments
	foreach ( attachPoint, attachmentRef in attachmentSlotsToCurrentAttachmentMap )
	{
		if ( attachPoint == "sight" )
		{
			
			upgradeAttachments.append( attachmentRef )
			continue
		}

		if ( !SURVIVAL_Loot_IsRefValid( attachmentRef ) )
		{
			if ( attachPoint == "hopup" )
			{
				if ( minTier == EMPTY_HOPUP_TIER )
				{
					upgradeAttachments.append( Arsenals_GetFirstAttachmentForAttachPointOfTier( attachPoint, baseRef, EMPTY_HOPUP_TIER + 1 ) )
				}
				else
				{
					upgradeAttachments.append( "" )
				}
				continue
			}

			upgradeAttachments.append( Arsenals_GetFirstAttachmentForAttachPointOfTier( attachPoint, baseRef ) )

			continue
		}

		LootData attachmentData = SURVIVAL_Loot_GetLootDataByRef( attachmentRef )
		if ( attachmentData.tier == minTier )
		{
			upgradeAttachments.append( Arsenals_GetUpgradeForWeaponAttachment( weaponRef, attachmentRef ) )
		}
		else
		{
			upgradeAttachments.append( attachmentRef )
		}
	}

	return upgradeAttachments
}

string function Arsenals_GetFirstAttachmentForAttachPointOfTier( string attachPoint, string weaponRef, int startTier = 1, bool checkAfterLootReset = false, string ammoTypeStr = "" )
{
	if ( startTier > Arsenals_GetMaxAttachmentUpgradeTier() )
		return ""

	int attachmentType = SURVIVAL_Loot_GetAttachmentType_Enum( attachPoint )
	array<LootData> upgrades = GetAttachmentData_OfType_OfTier( attachmentType, startTier )
	string attachmentStyle = GetAttachmentPointStyle( attachPoint, weaponRef )

	if ( Arsenals_PreventGoldUpgradeBeforeBinResets() && !file.arsenalsReset && startTier > PURPLE_TIER && !checkAfterLootReset )
		return ""

	
	if ( attachmentStyle == "hopup" )
	{
		array< string > validHopups
		foreach ( LootData item in upgrades )
		{
			if ( CanAttachToWeapon( item.ref, weaponRef ) && !SURVIVAL_Loot_IsRefDisabled( item.ref ) )
			{
				validHopups.append( item.ref )
			}
		}

		if ( validHopups.len() > 0 )
			return validHopups.getrandom()
	}

	
	if ( attachmentStyle == "mag_car" )
	{
		attachmentStyle = ammoTypeStr == BULLET_AMMO ? "mag_straight" : "mag"
	}

	foreach ( LootData item in upgrades )
	{
		if ( ammoTypeStr != "" && item.ammoType != "" && item.ammoType != ammoTypeStr )
			continue

		if ( item.attachmentStyle == attachmentStyle && CanAttachToWeapon( item.ref, weaponRef ) )
			return item.ref
	}

	if ( attachmentStyle == "sight" && startTier >= 3 ) 
	{
		return Arsenals_GetFirstAttachmentForAttachPointOfTier( attachPoint, weaponRef, 2, checkAfterLootReset, ammoTypeStr )
	}
	else if ( startTier == 4 ) 
	{
		return Arsenals_GetFirstAttachmentForAttachPointOfTier( attachPoint, weaponRef, 3, checkAfterLootReset, ammoTypeStr )
	}

	return ""
}

string function Arsenals_GetUpgradeForWeaponAttachment( string weaponRef, string attachmentRef, bool checkAfterLootReset = false, string ammoTypeStr = "" )
{
	LootData lootItem = SURVIVAL_Loot_GetLootDataByRef( attachmentRef )

	int currTier = lootItem.tier
	if ( currTier >= Arsenals_GetMaxAttachmentUpgradeTier() )
		return attachmentRef

	if ( Arsenals_PreventGoldUpgradeBeforeBinResets() && !file.arsenalsReset && currTier >= PURPLE_TIER && !checkAfterLootReset )
		return attachmentRef

	array<LootData> upgrades = GetAttachmentData_OfType_OfTier( lootItem.attachmentType, currTier + 1 )

	foreach ( LootData item in upgrades )
	{
		if ( ammoTypeStr != "" && item.ammoType != "" && item.ammoType != ammoTypeStr )
			continue

		if ( CanAttachToWeapon( item.ref, weaponRef ) )
			return item.ref
	}

	return attachmentRef
}

void function Arsenasl_SetCustomConsoleOnUseFunc( void functionref( entity, entity, int ) func )
{
	file.customArsenalConsoleOnUse = func
}

array< string > function Arsenals_CombineAttachmentUpgradesForWeapon( array< string > currentMods, array< string > newMods, string newWeaponRef )
{
	array< string > currentModsCopy = clone currentMods
	array< string > newModsCopy = clone newMods

	foreach ( attachmentRef in newModsCopy )
	{
		if ( attachmentRef == "" )
			continue

		LootData data = SURVIVAL_Loot_GetLootDataByRef( attachmentRef )
		if ( data.lootType == eLootType.ATTACHMENT && CanAttachToWeapon( data.ref, newWeaponRef ) )
		{
			bool shouldAddRef = true
			for ( int i = 0; i < currentModsCopy.len(); i++ ) 
			{
				string existingMod = currentModsCopy[i]
				if ( existingMod == "" )
					continue

				LootData existingData = SURVIVAL_Loot_GetLootDataByRef( existingMod )
				if ( existingData.attachmentType == data.attachmentType )
				{
					if ( data.tier > existingData.tier )
					{
						currentModsCopy.fastremove( i )
					}
					else
					{
						shouldAddRef = false
					}

					break
				}
			}

			if ( shouldAddRef )
			{
				currentModsCopy.append( data.ref )
			}
		}
	}

	return currentModsCopy
}

array< LootData > function GetAttachmentData_OfType_OfTier( int attachmentType, int tier )
{
	array< LootData > returnData
	array<LootData> attachments = SURVIVAL_Loot_GetByType( eLootType.ATTACHMENT )

	foreach( LootData ld in attachments )
	{
		if ( ld.attachmentType != attachmentType )
			continue

		if( ld.tier == tier)
		{
			returnData.append( ld )
		}
	}

	return returnData
}

