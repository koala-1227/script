bool function IsLootRefAmmo( string lootRef )
{



	return lootRef == SHOTGUN_AMMO || lootRef == SNIPER_AMMO || lootRef == BULLET_AMMO || lootRef == HIGHCAL_AMMO || lootRef == SPECIAL_AMMO

}



















