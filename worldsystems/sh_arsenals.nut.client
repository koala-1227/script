void function Arsenals_OnGameStatePlaying_Client()
{
	if ( Arsenals_ArsenalShowWeaponRespawnTime() )
	{
		thread TrackClosestArsenalRespawns_Thread()
	}

	if ( Arsenals_OnlyShowClosestOnMinimap() || Arsenals_OnlyShowClosestOnFullmap() )
	{
		thread TrackClosestArsenalsToPlayerOnMinimap_Thread()
	}
}

void function Arsenals_OnWaitingForPlayers_Client()
{
	if ( Arsenals_ArsenalShowWeaponRespawnTime() )
	{
		thread TrackClosestArsenalRespawns_Thread()
	}
}

void function Arsenals_OnPlayerConnectionStateChanged( entity player )
{
	if ( IsValid( player ) && player == GetLocalClientPlayer() && player.IsConnectionActive() )
	{
		SetMapHudIdentifierSettings_Internal()
	}
}

void function OnPlayerMatchStateChanged_Client( entity player, int newState )
{
	if ( player != GetLocalViewPlayer() )
		return

	if ( Arsenals_ShowArsenalsInSkydive() && newState == ePlayerMatchState.SKYDIVE_FALLING )
	{
		MarkAllArsenalsForSkydive()
	}

	if ( newState == ePlayerMatchState.NORMAL )
	{
		DestroySkydiveArsenalMarkers()

		foreach ( key, value in clone file.zoneIdToArsenalsMap )
		{
			file.zoneIdToArsenalsMap[key].clear()
			delete file.zoneIdToArsenalsMap[key]
		}
	}
}

void function Arsenals_OnArsenalCreated_Client( entity ent )
{
	if ( !IsValid( ent ) )
		return

	if ( ent.GetScriptName() != ARSENAL_SCRIPTNAME )
		return

	EHI arsenalEHI = ToEHI( ent )

	vector origin = ent.GetOrigin()

	int ammoType = ent.GetAmmoType()
	if ( !( ammoType in file.showArsenalHudIconsOfAmmoType ) || !file.showArsenalHudIconsOfAmmoType[ammoType] )
	{
		file.showArsenalHudIconsOfAmmoType[ammoType] <- true
	}

	
	if ( !file.arsenalsUsed.contains( arsenalEHI ) )
	{
		if ( Arsenals_ArsenalConsolesUpgradeWeapon() )
		{
			if ( file.customArsenalConsoleOnUse == null )
			{
				AddCallback_OnUseEntity_ClientServer( ent, Arsenal_Console_OnUse )
				AddEntityCallback_GetUseEntOverrideText( ent, Arsenal_Console_UseTextOverride )
			}
			else
			{
				AddCallback_OnUseEntity_ClientServer( ent, file.customArsenalConsoleOnUse )
			}

			SetCallback_CanUseEntityCallback( ent, Arsenal_Console_CanUse )

			printt("Arsenal: ", ent)
		}

		ent.SetRenderColor( ARSENAL_BASE_COLOR_R, ARSENAL_BASE_COLOR_G, ARSENAL_BASE_COLOR_B )
		ent.OverrideClientSideBodyGroupModelByIndex( ent.FindBodygroup( ARSENAL_CONSOLE_BODYGROUP_NAME ), ARSENAL_CONSOLE_UNUSED_BODYGROUP_INT )
	}
	else
	{
		ent.SetRenderColor( ARSENAL_USED_COLOR_R, ARSENAL_USED_COLOR_G, ARSENAL_USED_COLOR_B )
		ent.OverrideClientSideBodyGroupModelByIndex( ent.FindBodygroup( ARSENAL_CONSOLE_BODYGROUP_NAME ), ARSENAL_CONSOLE_USED_BODYGROUP_INT )
	}

	file.arsenalsSpawned = true

	if ( Arsenals_ShowHudDisplay() )
	{
		WorldspaceIconData iconSettings
		iconSettings.ent = ent
		iconSettings.imageAsset = Arsenals_GetArsenalIcon( FromEHI( arsenalEHI ) )
		iconSettings.upOffset = EVO_HARVESTER_ICON_UP_OFFSET
		iconSettings.descriptiveText = GetPromptPingForArsenalEnt( ent )
		iconSettings.pingType = Arsenals_GetPingTypeForEnt( ent )
		iconSettings.pingDistance = ARSENAL_PING_DISTANCE * file.displayDistanceModifier
		iconSettings.minAlphaDistance = Arsenals_ArsenalMinHudDisplayDistance() * file.displayDistanceModifier
		iconSettings.maxAlphaDistance = Arsenals_ArsenalMaxHudDisplayDistance() * file.displayDistanceModifier
		iconSettings.closeUpFadeMinAlphaDistance = Arsenals_ArsenalCloseUpFadeMinHudDisplayDistance() * file.displayDistanceModifier
		iconSettings.closeUpFadeMaxAlphaDistance = Arsenals_ArsenalCloseUpFadeMaxHudDisplayDistance() * file.displayDistanceModifier
		iconSettings.mapPingFilterFunction = Arsenals_IsArsenalPingableOnMap

		SetupWorldspaceIcon( iconSettings )

		file.spawnedArsenals.append( arsenalEHI )

#if DEV
			printt( "Arsenal( Client ): ------ Arsenal Created." )
			printt( "Arsenal( Client ): 	--- ammo type: " + ammoType  )
			printt( "Arsenal( Client ): 	--- ping type: " + iconSettings.pingType )
			printt( "Arsenal( Client ): 	--- ping text: " + iconSettings.descriptiveText )
#endif
	}

	ArsenalData arsenalData
	arsenalData.arsenalEHI = arsenalEHI
	file.arsenalEHIToArsenalDataMap[arsenalEHI] <- arsenalData
}

