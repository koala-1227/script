void function Arsenal_Console_OnUse( entity arsenal, entity player, int useFlags )
{
	if( !IsValid( arsenal ) )
		return

	if( !IsValid( player ) )
		return

	if ( !IsBitFlagSet( useFlags, USE_INPUT_LONG ) )
		return

	EHI arsenalEHI = ToEHI( arsenal )
	if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
		return

	ArsenalData arsenalData = file.arsenalEHIToArsenalDataMap[ToEHI( arsenal )]

	if ( !Arsenals_PlayerCanUseArsenalConsole( player, arsenalData ) )
		return

	ExtendedUseSettings settings
	settings.duration = Arsenals_ArsenalExtendedUseDuration()
	settings.successFunc = Arsenal_ExtendedUseSuccess
	settings.failureFunc = Arsenal_ExtendedUseFailure
	settings.movementDisable = true










		string weaponRef = Arsenals_GetWeaponRefToUpgradeAtArsenal( player, arsenalData )
		settings.outlineAlpha = 0.0
		settings.hint = Localize ( "#ARSENALS_ACTIVATE_HINT", GetWeaponInfoFileKeyField_GlobalString( weaponRef, "shortprintname" ) )


	thread ExtendedUse( arsenal, player, settings, false )
}





















































































































void function Arsenal_ExtendedUseSuccess( entity arsenal, entity player, ExtendedUseSettings settings )
{
	if ( !IsValid( player ) )
		return

	if ( !IsValid( arsenal ) )
		return

	EHI arsenalEHI = ToEHI( arsenal )
	if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
		return

	ArsenalData arsenalData = file.arsenalEHIToArsenalDataMap[arsenalEHI]




























}

void function Arsenal_ExtendedUseFailure( entity arsenal, entity player, ExtendedUseSettings settings )
{
	if ( !IsValid( player ) )
		return

	if ( !IsValid( arsenal ) )
		return

	EHI arsenalEHI = ToEHI( arsenal )
	if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
		return

	ArsenalData arsenalData = file.arsenalEHIToArsenalDataMap[arsenalEHI]













}

bool function Arsenal_Console_CanUse( entity player, entity ent, int useFlags )
{

		if( GetLocalClientPlayer() != GetLocalViewPlayer() )
			return false


	if ( Bleedout_IsBleedingOut( player ) )
		return false

	if ( player.ContextAction_IsActive() )
		return false

	if ( PlayerDrone_IsPlayerInDroneView( player ) )
		return false

	if ( !SURVIVAL_PlayerAllowedToPickup( player ) )
		return false

	if ( IsPlayerInCryptoDroneCameraView( player ) )
		return false

	if ( player.IsPhaseShifted() )
		return false

	if ( GetPlayerIsEmoting( player ) )
		return false

	if ( player.IsInventoryOpen() )
		return false

	if ( player.Player_IsSkywardLaunching() )
		return false

	if ( player.Player_IsSkywardFollowing() )
		return false

	if ( Arsenals_GetActivationTimeGateDuration() > 0.0 && Time() <= GetGlobalNetTime( ARSENAL_ACTIVATION_TIME ) )
		return false

	return true
}


string function Arsenal_Console_UseTextOverride( entity arsenalEnt )
{
	if ( !IsValid( arsenalEnt ) )
		return ""

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return ""

	CustomUsePrompt_Show( arsenalEnt )
	vector consolePos = arsenalEnt.GetClosestConsolePosition( player.GetOrigin() )
	CustomUsePrompt_SetSourcePos( consolePos + < 0, 0, 30 > )

	EHI arsenalEHI = ToEHI( arsenalEnt )
	if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
		return ""

	ArsenalData arsenalData = file.arsenalEHIToArsenalDataMap[arsenalEHI]

	int ammoType = arsenalEnt.GetAmmoType()
	array< string > weaponsOfCorrectType = GetPlayerWeaponsOfAmmoType( player, AmmoType_GetRefFromIndex( ammoType ) )

	string weaponRef = Arsenals_GetWeaponRefToUpgradeAtArsenal( player, arsenalData )
	string weaponRefPostLootReset = ""
	if ( Arsenals_PreventGoldUpgradeBeforeBinResets() )
	{
		weaponRefPostLootReset = Arsenals_GetWeaponRefToUpgradeAtArsenal( player, arsenalData, true )
	}

	if ( file.arsenalsUsed.contains( ToEHI( arsenalEnt ) ) )
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_AMMO_CANNOT_USE_PROMPT" ) )
	}
	else if ( weaponRef != "")
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_USE_PROMPT_HOLD", GetWeaponInfoFileKeyField_GlobalString( weaponRef, "shortprintname" ) ) )
	}
	else if ( weaponRefPostLootReset != "" )
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_WAIT_UNTIL_LOOT_RESET_USE_PROMPT", GetWeaponInfoFileKeyField_GlobalString( weaponRefPostLootReset, "shortprintname" ) ) )
	}
	else if ( weaponsOfCorrectType.len() == 2 )
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_MAXED_WEAPONS_USE_PROMPT", Localize( AmmoType_GetRefFromIndex_GlobalString( ammoType ) ) ) )
	}
	else if ( weaponsOfCorrectType.len() == 1 )
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_MAXED_WEAPON_USE_PROMPT", GetWeaponInfoFileKeyField_GlobalString( weaponsOfCorrectType[0], "shortprintname" ) ) )
	}
	else
	{
		
		CustomUsePrompt_SetText( Localize( "#ARSENALS_NO_AVAILABLE_USE_PROMPT", Localize( AmmoType_GetRefFromIndex_GlobalString( ammoType ) ) ) )
	}

	string ammoTypeStr = AmmoType_GetRefFromIndex( arsenalEnt.GetAmmoType() )
	LootData ammoTypeData = SURVIVAL_Loot_GetLootDataByRef( ammoTypeStr )
	vector ammoColor = GetAmmoColorByType( ammoTypeStr ) * 255

	CustomUsePrompt_SetHintImage( ammoTypeData.hudIcon )
	CustomUsePrompt_SetLineColor( < 1, 1, 1 > )
	CustomUsePrompt_SetShouldCenterImage( true )

	if ( PlayerIsInADS( player ) )
		CustomUsePrompt_ShowSourcePos( false )
	else
		CustomUsePrompt_ShowSourcePos( true )

	return ""
}


