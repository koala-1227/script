asset function Arsenals_GetArsenalIcon( entity arsenalEnt )
{
	if ( !IsValid( arsenalEnt ) )
		return $""

	if ( arsenalEnt.GetScriptName() != ARSENAL_SCRIPTNAME )
		return $""

	int ammoType = arsenalEnt.GetAmmoType()
	asset hudAsset = $""
	switch( ammoType )
	{
		case eAmmoPoolType.bullet:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_light_icon"
			break
		case eAmmoPoolType.highcal:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_heavy_icon"
			break
		case eAmmoPoolType.special:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_energy_icon"
			break
		case eAmmoPoolType.shotgun:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_shotgun_icon"
			break
		case eAmmoPoolType.sniper:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_sniper_icon"
			break
		default:
			hudAsset = $"rui/hud/gametype_icons/survival/arsenals_icon"
			break
	}

	return hudAsset
}

