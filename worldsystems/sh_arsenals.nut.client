void function _____________ARSENAL_DISCOVERY_SYSTEMS___________________________()
{}


#endif



void function MarkAllArsenalsForSkydive()
{
	if ( Arsenals_GetActivationTimeGateDuration() > 0.0 )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

	float minDistanceSqr = pow( Arsenals_GetMaxBeaconDisplayDistance(), 2 )
	foreach( arsenalData in file.arsenalEHIToArsenalDataMap.clonevalues() )
	{
		entity arsenal = FromEHI( arsenalData.arsenalEHI )
		if ( !IsValid( arsenal ) )
			continue

		if ( minDistanceSqr > 0 && Distance2DSqr( player.GetOrigin(), arsenal.GetOrigin() ) > minDistanceSqr )
			continue

		table<int, var> result = CreateArsenalSkydiveMarker( arsenalData )
		foreach( fxId, rui in result )
		{
			file.arsenalMarkerList.append( fxId )
			file.arsenalMarkerRuiList.append( rui )
		}
	}
}

table< int, var > function CreateArsenalSkydiveMarker( ArsenalData arsenalData, bool shouldFadeOutNearCrosshair = false )
{
	table<int, var> resultTable
	entity arsenal = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenal ) )
		return resultTable

	string ammoTypeStr = AmmoType_GetRefFromIndex( arsenal.GetAmmoType() )
	if ( !SURVIVAL_Loot_IsRefValid( ammoTypeStr ) )
		return resultTable

	LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( ammoTypeStr )
	asset iconToUse = Arsenals_GetArsenalIcon( arsenal )
	vector color = GetAmmoColorByType( ammoTypeStr ) * 255

	int fxHandle = StartParticleEffectInWorldWithHandle( GetParticleSystemIndex( FX_AIRDROP_BEAM_CP ), arsenal.GetOrigin(), ZERO_VECTOR )
	EffectSetControlPointVector( fxHandle, 1, color )

	entity localViewPlayer = GetLocalViewPlayer()
	vector pos = arsenal.GetOrigin() + (arsenal.GetUpVector() * 200)
	var rui = CreatePermanentCockpitRui( $"ui/arsenals_skydive_marker_icon.rpak", RuiCalculateDistanceSortKey( localViewPlayer.EyePosition(), pos ) )
	RuiSetImage( rui, "beaconImage", iconToUse )
	RuiSetGameTime( rui, "startTime", Time() )
	RuiSetFloat3( rui, "pos", pos )
	RuiSetFloat( rui, "sizeMin", 24 )
	RuiSetFloat( rui, "sizeMax", 40 )
	RuiSetFloat( rui, "minAlphaDist", 29000 )
	RuiSetFloat( rui, "maxAlphaDist", 30000 )
	RuiSetBool( rui, "shouldHideNearCrosshairs", shouldFadeOutNearCrosshair )


	float skyWritingFadeOutHeight = ZoneSkyWriting_GetActiveHeightFadeOut()



	if ( skyWritingFadeOutHeight == 0 )
	{
		skyWritingFadeOutHeight = localViewPlayer.GetOrigin().z
	}

	float minIconFadeOutDistanceHeight = skyWritingFadeOutHeight - ( skyWritingFadeOutHeight - GetSeaHeightForDisplay() ) * 0.5

	RuiSetFloat( rui, "fadeInHeight", skyWritingFadeOutHeight + Arsenals_AdditionalHeightForPOINameArsenalIconFade() )
	RuiSetFloat( rui, "distAlphaAdjustMinHeight", minIconFadeOutDistanceHeight )
	RuiSetFloat( rui, "minDistAtMinHeight", 10000 )
	RuiTrackFloat3( rui, "playerPos", localViewPlayer, RUI_TRACK_ABSORIGIN_FOLLOW )

	RuiKeepSortKeyUpdated( rui, true, "pos" )

	resultTable[fxHandle] <- rui
	return resultTable
}

void function DestroySkydiveArsenalMarkers()
{
	foreach( id in file.arsenalMarkerList )
	{
		EffectStop( id, true, false )
	}

	file.arsenalMarkerList.clear()

	foreach( rui in file.arsenalMarkerRuiList )
	{
		RuiSetBool( rui, "isFinished", true )
	}

	file.arsenalMarkerRuiList.clear()
}


void function ListenForArsenalPinged( EHI entEHI, var rui )
{
	entity arsenalEnt = FromEHI( entEHI )
	arsenalEnt.EndSignal( "OnDestroy" )

	int ammoType = arsenalEnt.GetAmmoType()

	while( true )
	{
		if( !file.pingedArsenals.contains( entEHI ) )
			arsenalEnt.WaitSignal( "PerkPropPinged" )

		arsenalEnt = FromEHI( entEHI )
		file.worldspaceArsenalIconVisibility[entEHI] <- false
		RuiSetBool( rui, "isVisible", false )

		arsenalEnt.WaitSignal( "PerkPropPingDestroyed" )

		file.worldspaceArsenalIconVisibility[entEHI] <- true
		UpdateWorldspaceIconsShown_Internal()
		RuiSetBool( rui, "isVisible", !(file.mapHudIdentifierSettings == eArsenalIdentifierSettings.MINIMAL || Arsenals_HideUnneededWorldIcons()) || file.showArsenalHudIconsOfAmmoType[ammoType] )
	}
}

void function Arsenals_ArsenalPinged( entity arsenalEnt, entity wp )
{
	if ( !Perks_Enabled() )
		return

	EHI arsenalEHI = ToEHI( arsenalEnt )

	arsenalEnt.Signal( "PerkPropPinged" )
	file.pingedArsenals.append( arsenalEHI )
	
	SetMapRuiVisibleForArsenal( arsenalEHI, true, true )

	wp.WaitSignal( "OnDestroy" )

	file.pingedArsenals.fastremovebyvalue( arsenalEHI )
	
	if ( arsenalEHI in file.ruiEHITable )
	{
		int proximityCount = file.ruiEHITable[arsenalEHI].proximityCount

		array < int > numArsenals = Arsenals_GetNumArsenalsArrayForMaps()
		SetMapRuiVisibleForArsenal( arsenalEHI, proximityCount < numArsenals[MINIMAP_ARRAY_INDEX], proximityCount < numArsenals[FULLMAP_ARRAY_INDEX] )
	}

	arsenalEnt.Signal( "PerkPropPingDestroyed" )
}

entity function Arsenals_GetArsenalUnderAim( vector worldPos, float worldRange )
{
	if ( !Arsenals_ShowHudDisplay() )
		return null

	float closestDistSqr = FLT_MAX
	float worldRangeSqr = worldRange * worldRange
	entity closestEnt = null

	if( MapPing_Modify_DistanceCheck_Enabled() )
	{
		float modifier = MapPing_DistanceCheck_GetModifier()

		if( worldRange >= MapPing_DistanceCheck_GetDistanceRange() )
			modifier *= 0.5

		worldRangeSqr = ( worldRange * modifier ) * ( worldRange * modifier )
	}

	foreach ( entEHI, rui in file.arsenalToWorldspaceRui )
	{
		entity arsenal = FromEHI( entEHI )
		if ( !IsValid( arsenal ) )
			continue

		vector objOrigin = arsenal.GetOrigin()

		float distSqr = Distance2DSqr( objOrigin, worldPos )
		if ( distSqr < worldRangeSqr && distSqr < closestDistSqr )
		{
			closestDistSqr = distSqr
			closestEnt = arsenal
		}
	}

	if ( !IsValid( closestEnt ) )
	{
		return null
	}

	return closestEnt
}

bool function Arsenals_PingArsenalUnderAim( entity ent )
{
	if ( !Arsenals_ShowHudDisplay() )
		return false

	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsPingAllowedForPlayer( player ) )
		return false

	if ( !IsPingEnabledForPlayer( player ) )
		return false

	Remote_ServerCallFunction( "ClientToServer_PingArsenalFromMap", ent )

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )
	return true
}

bool function Arsenals_IsArsenalPingableOnMap( WorldspaceIconData data, vector worldPos, float worldRange )
{
	if ( GetBigMapZoomScale() < 2 )
		return false

	EHI arsenalEHI = ToEHI( data.ent )
	if ( !( arsenalEHI in file.ruiEHITable ) )
		return false

	return file.ruiEHITable[arsenalEHI].proximityCount < Arsenals_GetNumArsenalsArrayForMaps()[FULLMAP_ARRAY_INDEX]
}

bool function Arsenals_UpdateHighlightedArsenalIcon()
{
	if ( !Arsenals_ArsenalsShowHighlight() )
		return false

	if ( Perks_GetPerkPingInfo().ent != null || DeathBoxInsight_GetCurrentPingInfo().loot != null )
		return false

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return false

	vector playerEyePos = player.EyePosition()
	vector viewVector = player.GetViewVector()
	float minDot = deg_cos( PERK_HIGHLIGHT_DEGREES )
	float bestDot = 0
	entity bestEnt = null

	array< entity > arsenals = GetArsenalEntitiesNearLocalPlayer( ARSENAL_PING_DISTANCE * file.displayDistanceModifier )
	if ( !(file.mapHudIdentifierSettings == eArsenalIdentifierSettings.MINIMAL || Arsenals_HideUnneededWorldIcons()) )
	{
		float smallDistSqr = ARSENAL_PING_DISTANCE_SMALL * ARSENAL_PING_DISTANCE_SMALL * file.displayDistanceModifier * file.displayDistanceModifier
		for ( int i = arsenals.len() - 1; i >= 0; i-- )
		{
			entity arsenalEnt = arsenals[i]
			if ( !(arsenalEnt instanceof C_ArsenalProp) )
				continue

			if ( !file.showArsenalHudIconsOfAmmoType[arsenalEnt.GetAmmoType()] && DistanceSqr( arsenalEnt.GetOrigin(), playerEyePos ) > smallDistSqr )
			{
				arsenals.fastremove( i )
			}
		}
	}

	foreach( entity ent in arsenals )
	{
		EHI entEHI = ToEHI( ent )
		if( !(entEHI in file.worldspaceArsenalIconVisibility) || !file.worldspaceArsenalIconVisibility[entEHI] || !( entEHI in file.arsenalToWorldspaceRui ) )
			continue

		vector iconPos
		iconPos = ent.GetOrigin() + <0, 0, EVO_HARVESTER_ICON_UP_OFFSET>
		vector eyeToIcon = iconPos - playerEyePos
		vector eyeToIconNormalized = Normalize( eyeToIcon )
		float dot = DotProduct( eyeToIconNormalized, viewVector )
		if( dot < minDot || dot < bestDot )
			continue

		bestDot = dot
		bestEnt = ent
	}

	Arsenals_SetHighlightedArsenalIcon( bestEnt )
	return bestEnt != null
}

entity function Arsenals_GetHighlightedArsenal()
{
	return FromEHI( file.highlightedPingEntEHI )
}


void function MinimapPackage_Arsenal( entity ent, var rui )
{
	thread WaitAndSetMapData_Thread( rui, ent, true )
}

void function FullmapPackage_Arsenal( entity ent, var rui )
{
	thread WaitAndSetMapData_Thread( rui, ent, false )
}

void function WaitAndSetMapData_Thread( var rui, entity arsenalEnt, bool isMinimap )
{
	ArsenalData arsenalData
	EHI arsenalEHI = ToEHI( arsenalEnt )

	while( true )
	{
		WaitFrame()

		if ( !RuiIsAlive( rui ) )
			return

		if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
			continue

		arsenalData = file.arsenalEHIToArsenalDataMap[arsenalEHI]
		break
	}

	if ( !RuiIsAlive( rui ) )
		return

	arsenalEnt = FromEHI( arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return

	RuiSetImage( rui, "defaultIcon", Arsenals_GetArsenalMapIcon( FromEHI( arsenalData.arsenalEHI ) ) )
	RuiSetBool( rui, "hasSmallIcon", true )
	RuiSetBool( rui, "showPulseAnimation", true )
	RuiSetImage( rui, "clampedDefaultIcon", $"" )
	RuiSetFloat3( rui, "iconColor", < 1.0, 1.0, 1.0 > )
	if( !isMinimap )
	{
		RuiSetBool( rui, "isArsenal", true )
	}

	vector pos = arsenalEnt.GetOrigin()
    bool shouldBeVisible = true

	if ( arsenalEHI in file.ruiEHITable )
	{
		if ( isMinimap )
		{
			file.ruiEHITable[arsenalEHI].minimapRui = rui
			shouldBeVisible = file.ruiEHITable[arsenalEHI].visibleOnMinimap
		}
		else
		{
			file.ruiEHITable[arsenalEHI].fullmapRui = rui
			shouldBeVisible = file.ruiEHITable[arsenalEHI].visibleOnFullmap
		}
	}
	else
	{
		RuiLocationData ruiLocationData
		ruiLocationData.pos = pos

		if ( isMinimap )
		{
			ruiLocationData.minimapRui = rui
			shouldBeVisible = ruiLocationData.visibleOnMinimap
		}
		else
		{
			ruiLocationData.fullmapRui = rui
			shouldBeVisible = ruiLocationData.visibleOnFullmap
		}

		file.ruiEHITable[arsenalEHI] <- ruiLocationData
	}

	RuiSetBool( rui, "isVisible", shouldBeVisible )
}

void function TrackClosestArsenalsToPlayerOnMinimap_Thread()
{
	int numArsenalsToShowOnMinimap, numArsenalsToShowOnFullmap

	while ( true )
	{
		array < int > numArsenals = Arsenals_GetNumArsenalsArrayForMaps()
		numArsenalsToShowOnMinimap = numArsenals[MINIMAP_ARRAY_INDEX]
		numArsenalsToShowOnFullmap = numArsenals[FULLMAP_ARRAY_INDEX]

		array< EHI > sortedArsenalEHI = GetSortedArsenalEHIArrayNearLocalPlayer()
		int count = 0
		foreach ( arsenalEHI in sortedArsenalEHI )
		{
			if ( !(arsenalEHI in file.ruiEHITable) )
				continue

			bool isPinged = file.pingedArsenals.contains( arsenalEHI )
			bool visibleOnMinimap = isPinged || count < numArsenalsToShowOnMinimap
			bool visibleOnFullmap = isPinged || count < numArsenalsToShowOnFullmap
			SetMapRuiVisibleForArsenal( arsenalEHI, visibleOnMinimap, visibleOnFullmap )
			file.ruiEHITable[arsenalEHI].proximityCount = count
			count++
		}

		wait 1
	}
}

void function SetMapRuiVisibleForArsenal( EHI arsenalEHI, bool visibleOnMinimap, bool visibleOnFullmap )
{
	if ( !( arsenalEHI in file.ruiEHITable ) )
		return

	if ( Arsenals_GetActivationTimeGateDuration() > 0.0 && Time() <= GetGlobalNetTime( ARSENAL_ACTIVATION_TIME ) )
	{
		visibleOnMinimap = false
		visibleOnFullmap = false
	}

	RuiLocationData ruiLocationData = file.ruiEHITable[arsenalEHI]

	ruiLocationData.visibleOnMinimap = visibleOnMinimap
	ruiLocationData.visibleOnFullmap = visibleOnFullmap

	if ( ruiLocationData.minimapRui != null && RuiIsAlive( ruiLocationData.minimapRui ) )
	{
		RuiSetBool( ruiLocationData.minimapRui, "isVisible", visibleOnMinimap )
	}

	if ( ruiLocationData.fullmapRui != null && RuiIsAlive( ruiLocationData.fullmapRui ) )
	{
		RuiSetBool( ruiLocationData.fullmapRui, "isVisible", visibleOnFullmap )
	}

	file.ruiEHITable[arsenalEHI] = ruiLocationData
}


void function Arsenals_SetHighlightedArsenalIcon( entity ent )
{
	if( file.highlightedPingEntEHI == ToEHI( ent ) )
		return

	entity oldEnt = FromEHI( file.highlightedPingEntEHI )

	if( IsValid( oldEnt ) )
	{
		RuiSetBool( file.arsenalToWorldspaceRui[file.highlightedPingEntEHI], "isHighlighted", false )
	}
	file.highlightedPingEntEHI = ToEHI( ent )
	if( ent )
	{
		RuiSetBool( file.arsenalToWorldspaceRui[file.highlightedPingEntEHI], "isHighlighted", true )
	}
}


void function Arsenals_HighlightArsenalInRangeMap()
{
	if ( !Arsenals_ShowHudDisplay() )
		return

	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsPingAllowedForPlayer( player ) )
		return

	if ( !IsPingEnabledForPlayer( player ) )
		return

	array< entity > nearbyArsenalEnts = GetArsenalEntitiesNearLocalPlayer( Arsenals_ArsenalMapMaxDisplayDistance() )
	foreach ( arsenalEnt in nearbyArsenalEnts )
	{
		EHI arsenalEHI = ToEHI( arsenalEnt )
		if ( !(arsenalEHI in file.ruiEHITable) )
			continue

		if ( Arsenals_OnlyShowClosestOnMinimap() )
		{
			RuiSetGameTimeIfExists( file.ruiEHITable[arsenalEHI].minimapRui, "pulseAnimationStartime", ClientTime() )
		}
		if ( Arsenals_OnlyShowClosestOnFullmap() )
		{
			RuiSetGameTimeIfExists( file.ruiEHITable[arsenalEHI].fullmapRui, "pulseAnimationStartime", ClientTime() )
		}
	}

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )
}



var function Arsenals_CreateClientSideHudMarkerForArsenal( asset hudImage, vector pos, float upOffset )
{
	entity localViewPlayer = GetLocalViewPlayer()
	var rui = CreateFullscreenRui( PERK_IN_WORLD_HUD_OBJECT, RuiCalculateDistanceSortKey( localViewPlayer.EyePosition(), pos ) )
	RuiSetImage( rui, "beaconImage", hudImage )
	RuiSetGameTime( rui, "startTime", Time() )
	RuiSetFloat3( rui, "pos", pos )
	RuiSetFloat( rui, "upOffset", upOffset )
	RuiKeepSortKeyUpdated( rui, true, "pos" )
	RuiSetBool( rui, "isVisible", false )
	RuiSetFloat3( rui, "iconColor", <1.0,1.0,1.0> )

	RuiSetFloat( rui, "minAlphaDist", Arsenals_ArsenalMinHudDisplayDistance() * file.displayDistanceModifier )
	RuiSetFloat( rui, "maxAlphaDist", Arsenals_ArsenalMaxHudDisplayDistance() * file.displayDistanceModifier )

	return rui
}

void function Arsenals_WorldspaceUseIconThink_Thread( EHI entEHI, var rui )
{
	Assert( IsNewThread() )

	entity ent = FromEHI( entEHI )
	if ( !IsValid( ent ) )
		return

	ent.EndSignal( "OnDestroy" )

	RuiSetString( rui, "descriptiveTextLocString", GetPromptPingForArsenalEnt( ent ) )
	RuiSetBool( rui, "isVisible", true )

	file.worldspaceArsenalIconVisibility[entEHI] <- true

	thread ListenForArsenalPinged( entEHI, rui )

	OnThreadEnd( void function() : ( entEHI, rui ) {
		RuiDestroyIfAlive( rui )
		if ( entEHI in file.arsenalToWorldspaceRui )
		{
			delete file.arsenalToWorldspaceRui[entEHI]
		}

		if ( entEHI in file.worldspaceArsenalIconVisibility )
		{
			delete file.worldspaceArsenalIconVisibility[entEHI]
		}

		if( file.highlightedPingEntEHI == entEHI )
		{
			file.highlightedPingEntEHI = 0
		}
	} )

	WaitForever()
}

void function Arsenals_OnLocalPlayerPickedUpLoot( entity pickupEnt, LootData lootData, int pickupAction )
{
	if ( !file.arsenalsSpawned )
		return

	if ( lootData.lootType != eLootType.MAINWEAPON && lootData.lootType != eLootType.ATTACHMENT )
		return

	entity player = GetLocalViewPlayer()

	if ( lootData.lootType == eLootType.ATTACHMENT ) 
	{
		bool updatedValues = false
		for ( int i = 0; i < 2; i++ )
		{
			entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
			string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
			if( ammoTypeRef != "" && ammoTypeRef != NOT_ON_ARSENAL_STR && Arsenals_IsWeaponMaxed( weapon, true ) )
			{
				int ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )
				file.showArsenalHudIconsOfAmmoType[ammoType] = false

				CheckShowHudIconsForWeaponCar( weapon, false )

				updatedValues = true
			}
		}

		if ( !updatedValues )
			return
	}
	else if ( !PlayerHasAllWeapons( player ) ) 
	{
		foreach( ammoType in file.showArsenalHudIconsOfAmmoType.clonekeys() )
		{
			file.showArsenalHudIconsOfAmmoType[ammoType] = true
		}
	}
	else 
	{
		foreach( ammoType in file.showArsenalHudIconsOfAmmoType.clonekeys() )
		{
			file.showArsenalHudIconsOfAmmoType[ammoType] = false
		}

		for ( int i = 0; i < 2; i++ )
		{
			entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
			string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
			if( ammoTypeRef != "" && ammoTypeRef != NOT_ON_ARSENAL_STR && !Arsenals_IsWeaponMaxed( weapon, true ) )
			{
				int ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )
				file.showArsenalHudIconsOfAmmoType[ammoType] = true

				CheckShowHudIconsForWeaponCar( weapon, true )
			}
		}
	}

	UpdateWorldspaceIconsShown_Internal()
}

void function Arsenals_OnLocalPlayerDroppedLoot( entity droppedEnt, LootData lootData )
{
	if ( !file.arsenalsSpawned )
		return

	if ( lootData.lootType != eLootType.MAINWEAPON && lootData.lootType != eLootType.ATTACHMENT )
		return

	if ( lootData.lootType == eLootType.ATTACHMENT ) 
	{
		bool updatedValues = false
		entity player = GetLocalViewPlayer()
		for ( int i = 0; i < 2; i++ )
		{
			entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
			string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
			if( ammoTypeRef != "" && ammoTypeRef != NOT_ON_ARSENAL_STR && !Arsenals_IsWeaponMaxed( weapon, true ) )
			{
				int ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )
				file.showArsenalHudIconsOfAmmoType[ammoType] = true

				CheckShowHudIconsForWeaponCar( weapon, true )

				updatedValues = true
			}
		}

		if ( !updatedValues )
			return
	}
	else
	{
		
		foreach( ammoType in file.showArsenalHudIconsOfAmmoType.clonekeys() )
		{
			file.showArsenalHudIconsOfAmmoType[ammoType] = true
		}
	}

	UpdateWorldspaceIconsShown_Internal()
}

void function Arsenals_CheckInventoryChanged()
{
	if ( !file.arsenalsSpawned )
		return

	bool updatedValues = false
	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

	for ( int i = 0; i < 2; i++ )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
		if ( !IsValid( weapon ) )
		{
			foreach( ammoType in file.showArsenalHudIconsOfAmmoType.clonekeys() )
			{
				file.showArsenalHudIconsOfAmmoType[ammoType] = true
			}

			updatedValues = true
			break
		}

		string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
		if ( ammoTypeRef == "" || ammoTypeRef == NOT_ON_ARSENAL_STR )
			continue

		bool isMaxed = Arsenals_IsWeaponMaxed( weapon, true )
		int ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )
		if ( !( ammoType in file.showArsenalHudIconsOfAmmoType ) )
			continue

		if( isMaxed && file.showArsenalHudIconsOfAmmoType[ammoType] )
		{
			file.showArsenalHudIconsOfAmmoType[ammoType] = false

			CheckShowHudIconsForWeaponCar( weapon, false )

			updatedValues = true
		}
		else if ( !isMaxed && !file.showArsenalHudIconsOfAmmoType[ammoType] )
		{
			file.showArsenalHudIconsOfAmmoType[ammoType] = true

			CheckShowHudIconsForWeaponCar( weapon, true )

			updatedValues = true
		}
	}

	if ( updatedValues )
	{
		UpdateWorldspaceIconsShown_Internal()
	}
}

void function UpdateWorldspaceIconsShown_Internal()
{
	foreach ( EHI ehi in file.spawnedArsenals )
	{
		entity arsenalEnt = FromEHI( ehi )
		if ( !IsValid( arsenalEnt ) )
			continue

		if ( file.mapHudIdentifierSettings == eArsenalIdentifierSettings.MINIMAL || Arsenals_HideUnneededWorldIcons() )
		{
			SetWorldspaceIconIsHidden( arsenalEnt, !file.showArsenalHudIconsOfAmmoType[arsenalEnt.GetAmmoType()] )
		}
		else if ( Arsenals_GetActivationTimeGateDuration() > 0.0 && Time() <= GetGlobalNetTime( ARSENAL_ACTIVATION_TIME ) )
		{
			SetWorldspaceIconIsHidden( arsenalEnt, !file.showArsenalHudIconsOfAmmoType[arsenalEnt.GetAmmoType()] )
		}
		else if ( file.showArsenalHudIconsOfAmmoType[arsenalEnt.GetAmmoType()] )
		{
			SetWorldspaceIconIsHidden( arsenalEnt, false )
			SetWorldspaceIconFadeDistance( arsenalEnt, Arsenals_ArsenalMinHudDisplayDistance() * file.displayDistanceModifier, Arsenals_ArsenalMaxHudDisplayDistance() * file.displayDistanceModifier )
			SetWorldspaceIconPingDistance( arsenalEnt, Arsenals_ArsenalMinHudDisplayDistance() * file.displayDistanceModifier )
		}
		else
		{
			SetWorldspaceIconIsHidden( arsenalEnt, false )
			SetWorldspaceIconFadeDistance( arsenalEnt, Arsenals_ArsenalMinHudDisplayDistance_Small() * file.displayDistanceModifier, Arsenals_ArsenalMaxHudDisplayDistance_Small() * file.displayDistanceModifier )
			SetWorldspaceIconPingDistance( arsenalEnt, Arsenals_ArsenalMinHudDisplayDistance_Small() * file.displayDistanceModifier )
		}
	}
}

void function UIToClient_Arsenals_SetMapHudIdentifierSettings()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	SetMapHudIdentifierSettings_Internal()
}

void function SetMapHudIdentifierSettings_Internal()
{
	file.mapHudIdentifierSettings = GetConVarInt( "player_setting_arsenals_maphudidentifiers" )

	switch( file.mapHudIdentifierSettings )
	{
		case eArsenalIdentifierSettings.MINIMAL:
			file.displayDistanceModifier = Arsenals_ArsenalHudDisplayDistanceModifier_Minimal()
			break
		case eArsenalIdentifierSettings.MODERATE:
			file.displayDistanceModifier = Arsenals_ArsenalHudDisplayDistanceModifier_Moderate()
			break
		default:
			file.displayDistanceModifier = 1.0
			break
	}

	UpdateWorldspaceIconsShown_Internal()
}


