void function Arsenals_Init()
{
	if ( !Arsenals_Enabled() )
		return

	PrecacheModel( ARSENALS_MODEL )

	PrecacheParticleSystem( ARSENALS_RESET_FLASH )

	foreach ( particleSystem in ARSENALS_REF_TO_HOLO_MAP.clonevalues() )
	{
		PrecacheParticleSystem( particleSystem )
	}

	foreach( particleSystem in ARSENALS_REF_TO_HOLO_FADEIN_MAP.clonevalues() )
	{
		PrecacheParticleSystem( particleSystem )
	}

	RegisterNetworkedVariable( ARSENAL_ACTIVATION_TIME, SNDC_GLOBAL, SNVT_TIME , 0.0 )





























		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			AddCallback_GameStateEnter( eGameState.WaitingForPlayers, Arsenals_OnWaitingForPlayers_Client )
		}
		else
		{
			AddCallback_GameStateEnter( eGameState.Playing, Arsenals_OnGameStatePlaying_Client )
		}

		AddCreateCallback( "prop_arsenal", Arsenals_OnArsenalCreated_Client )

		RegisterNetVarTimeChangeCallback( ARSENAL_ACTIVATION_TIME, Arsenals_ArsenalActivationTimeChange )

		Fullmap_AddCallback_OnMapLegendCreated( Arsenals_OnMapLegendCreated )

		if ( Arsenals_ArsenalsShowOnMap() )
		{
			RegisterMinimapPackage( "prop_arsenal", eMinimapObject_prop_script.ARSENAL, MINIMAP_OBJECT_PROXIMITY_RUI, MinimapPackage_Arsenal, FULLMAP_OBJECT_PROXIMITY_RUI, FullmapPackage_Arsenal )
		}

		if ( Arsenals_PingNearestArsenalOnInventoryEvent() )
		{
			Arsenals_InitQuickChatEvents()
			RegisterSignal( "WeaponQuickchatIdxSet" )
		}

		
		
		
		

		AddCallback_OnPlayerMatchStateChanged( OnPlayerMatchStateChanged_Client )

		AddCallback_LocalPlayerPickedUpLoot( Arsenals_OnLocalPlayerPickedUpLoot )
		AddCallback_LocalPlayerDroppedLoot( Arsenals_OnLocalPlayerDroppedLoot )

		AddCallback_ClientOnPlayerConnectionStateChanged( Arsenals_OnPlayerConnectionStateChanged )

		SetMapHudIdentifierSettings_Internal()

		for ( int i = 0; i < eAmmoPoolType.len(); i++ )
		{
			file.showArsenalHudIconsOfAmmoType[i] <- false
		}

		AddCallback_OnEnterDroneView( Arsenal_OnPlayerEnterDroneView )


	if ( Arsenals_ArsenalConsolesUpgradeWeapon() )
	{
		PrecacheParticleSystem( FX_WEAPON_EVO_UPGRADE_FP )
		PrecacheParticleSystem( FX_EXP_LEVELUP_3P )
	}














	if ( Arsenals_ArsenalConsolesUpgradeWeapon() )
	{
		Remote_RegisterClientFunction( "ServerToClient_Arsenals_ShowWeaponUpgrade", "entity", "int", 0, 8, "int", -1, 1023, "int", -1, 1023, "int", -1, 1023 )
		Remote_RegisterClientFunction( "ServerToClient_Arsenals_Play3PWeaponUpgradeFX", "entity", "int", 0, 8 )
	}

	Remote_RegisterServerFunction( "ClientToServer_PingArsenalFromMap", "typed_entity", "prop_arsenal" )
	Remote_RegisterServerFunction( "ClientToServer_PingArsenalAfterQuickchat", "typed_entity", "prop_arsenal" )

	if ( Arsenals_LootBinResetEnabled() && Arsenals_ArsenalResetResestUpgradeConsole() )
	{
		Remote_RegisterClientFunction( "ServerToClient_ResetArsenals" )
	}

	Remote_RegisterClientFunction( "ServerToClient_ArsenalUsed", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_Arsenals_SetGroupParentLocation", "int", 0, 256, "vector", -FLT_MAX, FLT_MAX, 32 )
}



void function Arsenals_InitQuickChatEvents()
{
	array< int > arsenalRelatedQuickChatEvents = [
		
		eCommsAction.INVENTORY_NEED_AMMO_BULLET,
		eCommsAction.INVENTORY_NEED_AMMO_SPECIAL,
		eCommsAction.INVENTORY_NEED_AMMO_HIGHCAL,
		eCommsAction.INVENTORY_NEED_AMMO_SHOTGUN,
		eCommsAction.INVENTORY_NEED_AMMO_SNIPER,
		eCommsAction.INVENTORY_NO_AMMO_BULLET,
		eCommsAction.INVENTORY_NO_AMMO_SPECIAL,
		eCommsAction.INVENTORY_NO_AMMO_HIGHCAL,
		eCommsAction.INVENTORY_NO_AMMO_SHOTGUN,
		eCommsAction.INVENTORY_NO_AMMO_SNIPER,
		eCommsAction.INVENTORY_NO_AMMO_ARROWS,

		
		eCommsAction.INVENTORY_NEED_FIRST_WEAPON,
		eCommsAction.INVENTORY_NEED_ANOTHER_WEAPON,
	]

	if ( Arsenals_AllowPingingForAttachmentRequests() )
	{
		arsenalRelatedQuickChatEvents.extend( [
			
			eCommsAction.INVENTORY_NEED_ATTACHMENT_MAG_BULLET,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_MAG_SPECIAL,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_MAG_SHOTGUN,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_MAG_HIGHCAL,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_MAG_SNIPER,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_PISTOL,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_SMG,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_ASSAULT,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_LMG,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_SHOTGUN,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_SNIPER,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_GRIP_MARKSMAN,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_PISTOL,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_SMG,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_ASSAULT,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_LMG,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_SHOTGUN,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_SNIPER,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_BARREL_MARKSMAN,
			eCommsAction.INVENTORY_NEED_ATTACHMENT_LASERSIGHT_SMG
			eCommsAction.INVENTORY_NEED_ATTACHMENT_LASERSIGHT_PISTOL
			eCommsAction.INVENTORY_NEED_WEAPONATTACHMENT_HOPUP,
			eCommsAction.INVENTORY_NEED_WEAPONATTACHMENT_HOPUP_MULTI_A,
			eCommsAction.INVENTORY_NEED_WEAPONATTACHMENT_HOPUP_MULTI_B,
			eCommsAction.INVENTORY_NEED_HOPUP_CHOKE,
			eCommsAction.INVENTORY_NEED_HOPUP_SELECTFIRE,
			eCommsAction.INVENTORY_NEED_HOPUP_TURBOCHARGER,
			eCommsAction.INVENTORY_NEED_HOPUP_SKULLPIERCER,
			eCommsAction.INVENTORY_NEED_HOPUP_DISRUPTOR,
			eCommsAction.INVENTORY_NEED_HOPUP_HAMMERPOINT,



			eCommsAction.INVENTORY_NEED_HOPUP_DOUBLE_TAP,
			eCommsAction.INVENTORY_NEED_HOPUP_BOOSTED_LOADER,
			eCommsAction.INVENTORY_NEED_HOPUP_MARKSMANS_TEMPO,
			eCommsAction.INVENTORY_NEED_HOPUP_QUICKDRAW_HOLSTER,
			eCommsAction.INVENTORY_NEED_HOPUP_SHATTER_ROUNDS,
			eCommsAction.INVENTORY_NEED_HOPUP_DUAL_SHELL,
			eCommsAction.INVENTORY_NEED_HOPUP_KINETIC_FEEDER,
			eCommsAction.INVENTORY_NEED_HOPUP_GUNSHIELD,
		] )

		if ( Arsenals_AllowPingingForAllSightRequests() )
		{
			arsenalRelatedQuickChatEvents.extend( [
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_PISTOL,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_SMG,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_ASSAULT,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_LMG,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_SHOTGUN,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_SNIPER,
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_MARKSMAN,
			] )
		}
		else if ( Arsenals_AllowPingingForSniperSightRequests() )
		{
			arsenalRelatedQuickChatEvents.extend( [
				eCommsAction.INVENTORY_NEED_ATTACHMENT_SIGHT_SNIPER,
			] )
		}
	}

	foreach( commsAction in arsenalRelatedQuickChatEvents )
	{
		AddCallback_OnQuickchatEvent( commsAction, PingRelevantArsenalForChatEvent )
	}
}










































































































