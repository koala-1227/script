void function Arsenals_ArsenalActivationTimeChange( entity unused, float time )
{
	thread Arsenals_ArsenalActivation_Wait_Thread( time )
}

void function Arsenals_ArsenalActivation_Wait_Thread( float activationTime )
{
	float currentTime = Time()

	if( currentTime < activationTime )
		wait activationTime - currentTime
	else
		return


	Arsenals_Announce_ArsenalActivation()
}

void function Arsenals_Announce_ArsenalActivation()
{
	if( !EvoLevels_IsDisplayingLevelUpMessage() )
	{
		
		bool  doMinimapAnnounce = false
		if ( MinimapAnnouncements_IsEnabled() && doMinimapAnnounce )
		{
			MapAnnouncementItem mapAnnouncementItem
			mapAnnouncementItem.message = "#ARSENALS_ONLINE_ANNOUNCEMENT"
			mapAnnouncementItem.colorIn =  < 255, 255, 0 > / 255.0
			mapAnnouncementItem.icon = $"rui/hud/small_announcements/icon_evo_online"
			mapAnnouncementItem.iconShadow = $"rui/hud/small_announcements/icon_evo_online_shadow"
			mapAnnouncementItem.priority = eHudNotificationQueuePriority.LOW
			mapAnnouncementItem.speakerDialogueLines = []

			MinimapAnnouncement_QueueItem( mapAnnouncementItem )
			return
		}

		AnnouncementData announcement = Announcement_Create( "" )
		Announcement_SetStyle( announcement, ANNOUNCEMENT_STYLE_LOOT_REFRESHED )
		announcement.messageText = "#ARSENALS_ONLINE_ANNOUNCEMENT"
		Announcement_SetPurge( announcement, true )
		Announcement_SetSoundAlias( announcement, "UI_Crafting_Harvester_AvailableWarning" )
		Announcement_SetDuration( announcement, 4.0 )
		AnnouncementFromClass( GetLocalViewPlayer(), announcement )
	}
}

void function TrackClosestArsenalRespawns_Thread()
{
	const float waitDelay = 0.5
	EHI oldArsenalEHI
	while ( true )
	{
		wait waitDelay

		entity player = GetLocalViewPlayer()
		if ( !IsValid( player ) )
			continue

		ArsenalData arsenalData = GetClosestArsenalDataToLocalPlayer_Internal()

		entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
		if ( !IsValid( arsenalEnt ) || arsenalData.arsenalEHI == oldArsenalEHI )
			continue

		oldArsenalEHI = arsenalData.arsenalEHI

		UpdateArsenalRespawnRUI_Internal( arsenalData )
	}
}

void function UpdateArsenalRespawnRUIs()
{
	ArsenalData arsenalData = GetClosestArsenalDataToLocalPlayer_Internal()

	UpdateArsenalRespawnRUI_Internal( arsenalData )
}

ArsenalData function GetClosestArsenalDataToLocalPlayer_Internal()
{
	ArsenalData arsenalData
	array< EHI > arsenalEHIarray = GetSortedArsenalEHIArrayNearLocalPlayer()
	foreach( arsenalEHI in arsenalEHIarray )
	{
		entity arsenalEnt = FromEHI( arsenalEHI )
		if ( !IsValid( arsenalEnt ) )
			continue

		if ( arsenalEHI in file.arsenalEHIToArsenalDataMap )
		{
			return file.arsenalEHIToArsenalDataMap[arsenalEHI]
		}
	}

	return arsenalData
}

void function UpdateArsenalRespawnRUI_Internal( ArsenalData arsenalData )
{
	entity arsenalEnt = FromEHI( arsenalData.arsenalEHI )
	if ( !IsValid( arsenalEnt ) )
		return

	int numItems = arsenalEnt.GetItemCount()
	for ( int i = 0; i < numItems; i++ )
	{
		if ( file.weaponRespawnTopos.len() <= i )
		{
			AddNewWeaponRespawnRUI()
		}

		var topo = file.weaponRespawnTopos[i]
		var rui = file.weaponRespawnRuis[i]

		if ( !RuiIsAlive( rui ) )
		{
			if ( !IsValid( topo ) || topo == null )
			{
				topo = CreateRUITopology_Worldspace( ZERO_VECTOR, ZERO_VECTOR, 95, 95 )
				file.weaponRespawnTopos[i] = topo
			}
			rui = RuiCreate( $"ui/arsenal_item_respawn_timer.rpak", topo, RUI_DRAW_WORLD, 0 )
			file.weaponRespawnRuis[i] = rui
		}

		vector weaponPos = Arsenals_GetOriginForWeaponIdxAtArsenal( i, arsenalData )
		vector weaponAngle = Arsenals_GetRespawnTimerAngleForIdxAtArsenal( i, arsenalEnt )
		UpdateRUITopologyPos_Worldspace( topo, weaponPos, weaponAngle, 95, 95 )

		RuiSetFloat( rui, "respawnDuration", arsenalEnt.GetItemRespawnDuration( i ) )
		RuiTrackGameTime( rui, "endTime", arsenalEnt, RUI_TRACK_ARSENAL_RESPAWN_ENDTIME, i )
	}
}

void function ServerToClient_ArsenalUsed( entity arsenalEnt )
{
	if( !IsValid( arsenalEnt ) )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

#if DEV
	if ( !INFINITE_UPGRADES_ENABLED )
#endif
	{
		file.arsenalsUsed.append( ToEHI( arsenalEnt ) )

		
		for ( int i = 0; i < 2; i++ )
		{
			entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + i )
			string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
			if( ammoTypeRef != "" && ammoTypeRef != NOT_ON_ARSENAL_STR && Arsenals_IsWeaponMaxed( weapon, true ) )
			{
				int ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )
				file.showArsenalHudIconsOfAmmoType[ammoType] = false

				CheckShowHudIconsForWeaponCar( weapon, false )

				UpdateWorldspaceIconsShown_Internal()
				break
			}
		}

		EHI arsenalEHI = ToEHI( arsenalEnt )
		if ( arsenalEHI in file.ruiEHITable )
		{
			RuiLocationData data = file.ruiEHITable[arsenalEHI]
			if ( RuiIsAlive( data.minimapRui ) )
			{
				RuiSetFloat3( data.minimapRui, "iconColor", NON_INTERACTIBLE_PERK_MINIMAP_COLOR )
			}
			if ( RuiIsAlive( data.fullmapRui ) )
			{
				RuiSetFloat3( data.fullmapRui, "iconColor", NON_INTERACTIBLE_PERK_MINIMAP_COLOR )
			}
		}

		SetWorldspaceIconColor( arsenalEnt, NON_INTERACTIBLE_PERK_MINIMAP_COLOR, NON_INTERACTIBLE_PERK_MINIMAP_COLOR )

		arsenalEnt.SetRenderColor( ARSENAL_USED_COLOR_R, ARSENAL_USED_COLOR_G, ARSENAL_USED_COLOR_B )
		arsenalEnt.OverrideClientSideBodyGroupModelByIndex( arsenalEnt.FindBodygroup( ARSENAL_CONSOLE_BODYGROUP_NAME ), ARSENAL_CONSOLE_USED_BODYGROUP_INT )
	}
}


void function ServerToClient_Arsenals_ShowWeaponUpgrade( entity player, int expTier, int lootIdx1, int lootIdx2, int lootIdx3 )
{
	if ( !IsValid( player ) || !IsAlive( player ) )
		return

	if ( expTier <= 0 || expTier > CONTROL_MAX_EXP_TIER )
		return

	thread Arsenals_ShowWeaponUpgrade_Thread( player, expTier, lootIdx1, lootIdx2, lootIdx3 )
}

const float WEAPON_UPGRADE_VFX_DELAY = 0.1

void function Arsenals_ShowWeaponUpgrade_Thread( entity player, int expTier, int lootIdx1, int lootIdx2, int lootIdx3 )
{
	Assert( IsNewThread(), "Must be threaded off" )

	EndSignal( player, "OnDestroy", "OnDeath" )

	int activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player )
	entity activePrimaryWeapon = player.GetNormalWeapon( activeWeaponSlot )
	float timeToWait = WEAPON_UPGRADE_VFX_DELAY

	
	if ( IsValid( activePrimaryWeapon ) )
		timeToWait += activePrimaryWeapon.GetWeaponSettingFloat( eWeaponVar.deploy_time )

	wait timeToWait

	if ( !IsValid( player ) )
		return

	ShowWeaponUpgradeAnnouncement_Internal( lootIdx1, lootIdx2, lootIdx3 )

	
	switch ( expTier )
	{
		case 1:
			EmitUISound( CONTROL_SFX_WEAPON_EVO_LVL_1 )
			break

		case 2:
			EmitUISound( CONTROL_SFX_WEAPON_EVO_LVL_2 )
			break

		case 3:
			EmitUISound( CONTROL_SFX_WEAPON_EVO_LVL_3 )
			break

		case 4:
			EmitUISound( CONTROL_SFX_WEAPON_EVO_LVL_4 )
			break
		default:
			EmitUISound( CONTROL_SFX_WEAPON_EVO_LVL_1 )
			break
	}

	
	thread Arsenals_PlayWeaponUpgradeVFX_Thread( player, expTier, FX_WEAPON_EVO_UPGRADE_FP, FX_EXP_LEVELUP_3P )
}

void function ShowWeaponUpgradeAnnouncement_Internal( int lootIdx1, int lootIdx2, int lootIdx3 )
{
	string announcementMessage = Localize( "#ARSENALS_UPGRADED_WEAPON_BASE" )
	array< asset > upgradeIcons
	array< int > upgradeTiers
	array< vector > iconAspectRatios


		int whichLootIsHopup = 0
		int lootIdxCount = 0


	array< int > lootIdxs = [ lootIdx1, lootIdx2, lootIdx3 ]
	foreach ( lootIdx in lootIdxs )
	{
		if ( !SURVIVAL_Loot_IsLootIndexValid( lootIdx ) )
			continue

		LootData data = SURVIVAL_Loot_GetLootDataByIndex( lootIdx )
		upgradeTiers.append( data.tier )
		upgradeIcons.append( data.hudIcon )

		vector imageSize = GetImageSize( data.hudIcon )
		vector aspectRatio = GetAspectRatioBase1( imageSize )
		iconAspectRatios.append( aspectRatio )


			lootIdxCount++
			if ( DormantHopups_IsEnabled() && data.ref.find( "hopup" ) > -1 )
			{
				whichLootIsHopup = lootIdxCount
			}

	}

	AnnouncementData announcement = Announcement_Create( announcementMessage )
	Announcement_SetStyle( announcement, ANNOUNCEMENT_STYLE_WEAPON_UPGRADED )
	Announcement_SetPurge( announcement, true )
	Announcement_SetSoundAlias( announcement, "UI_Crafting_Harvester_AvailableWarning" )
	Announcement_SetDuration( announcement, 3.0 )


	if ( upgradeIcons.len() > 0 )
	{
		Announcment_SetOptionalImageAssetArgsArray( announcement, upgradeIcons )
		Announcment_SetOptionalImageTierArgsArray( announcement, upgradeTiers )
		Announcment_SetOptionalImageAspectRatioArgsArray( announcement, iconAspectRatios )


			Announcement_SetCustomHopupBorderInt( announcement, whichLootIsHopup )

	}

	AnnouncementFromClass( GetLocalViewPlayer(), announcement )
}

void function ServerToClient_Arsenals_Play3PWeaponUpgradeFX( entity player, int expTier )
{
	if ( !IsValid( player ) || !IsAlive( player ) )
		return

	if ( player == GetLocalClientPlayer() )
		return

	if ( !player.DoesShareRealms( GetLocalClientPlayer() ) )
		return

	if ( expTier <= 0 || expTier > CONTROL_MAX_EXP_TIER )
		return

	thread Arsenals_Play3PWeaponUpgradeFX_Thread( player, expTier )
}


void function Arsenals_Play3PWeaponUpgradeFX_Thread( entity player, int expTier )
{
	Assert( IsNewThread(), "Must be threaded off" )

	EndSignal( player, "OnDestroy", "OnDeath" )

	int activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player )
	entity activePrimaryWeapon = player.GetNormalWeapon( activeWeaponSlot )
	float timeToWait = WEAPON_UPGRADE_VFX_DELAY

	
	if ( IsValid( activePrimaryWeapon ) )
		timeToWait += activePrimaryWeapon.GetWeaponSettingFloat( eWeaponVar.deploy_time )

	wait timeToWait

	thread Arsenals_PlayWeaponUpgradeVFX_Thread( player, expTier, $"", FX_EXP_LEVELUP_3P )
}

const float VFX_LIFETIME = 3.0
void function Arsenals_PlayWeaponUpgradeVFX_Thread( entity player, int expTier, asset firstPersonVFXAsset, asset thirdPersonVFXAsset )
{
	Assert( IsNewThread(), "Must be threaded off" )

	if ( !IsValid( player ) || !IsAlive( player ) )
		return

	
	int activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player )
	entity activePrimaryWeapon = player.GetNormalWeapon( activeWeaponSlot )

	if ( !IsValid( activePrimaryWeapon ) )
		return

	PassByReferenceInt fpFXHandleMain

	entity akimboWeapon
	PassByReferenceInt fpFXHandleAkimbo
	if ( activePrimaryWeapon.IsAkimboAvailable() )
	{
		int althandSlot = activeWeaponSlot + WEAPON_INVENTORY_SLOT_DUALPRIMARY_0
		akimboWeapon = player.GetNormalWeapon( althandSlot )
	}

	EndSignal( player, "OnDestroy", "OnDeath" )
	EndSignal( activePrimaryWeapon, "OnDestroy" )

	OnThreadEnd(
		function() : ( fpFXHandleMain, fpFXHandleAkimbo, activePrimaryWeapon, akimboWeapon, thirdPersonVFXAsset )
		{
			if ( EffectDoesExist( fpFXHandleMain.value ) )
			{
				EffectStop( fpFXHandleMain.value, true, false )
			}

			if ( EffectDoesExist( fpFXHandleAkimbo.value ) )
			{
				EffectStop( fpFXHandleAkimbo.value, true, false )
			}

			if ( IsValid( activePrimaryWeapon ) )
			{
				activePrimaryWeapon.StopWeaponEffect( $"", thirdPersonVFXAsset )
			}

			if ( IsValid( akimboWeapon ) )
			{
				akimboWeapon.StopWeaponEffect( $"", thirdPersonVFXAsset )
			}
		}
	)

	
	vector tierColor = GetFXRarityColorForTier( expTier )
	
	int attachmentID = activePrimaryWeapon.LookupAttachment( "hcog" )
	if ( attachmentID != 0 )
	{
		fpFXHandleMain.value = activePrimaryWeapon.PlayWeaponEffectReturnViewEffectHandle( firstPersonVFXAsset, thirdPersonVFXAsset, "hcog", true )
		EffectSetControlPointVector( fpFXHandleMain.value, 1, tierColor )
	}

	if ( IsValid( akimboWeapon ) && akimboWeapon.LookupAttachment( "hcog" ) != 0 )
	{
		fpFXHandleAkimbo.value = akimboWeapon.PlayWeaponEffectReturnViewEffectHandle( firstPersonVFXAsset, thirdPersonVFXAsset, "hcog", true )
		EffectSetControlPointVector( fpFXHandleAkimbo.value, 1, tierColor )
	}

	wait VFX_LIFETIME
}

void function ServerToClient_ResetArsenals()
{
	file.arsenalsReset = true

	if ( Arsenals_ArsenalResetResestUpgradeConsole() )
	{
		foreach ( arsenalEHI in file.arsenalsUsed )
		{
			entity arsenal = FromEHI( arsenalEHI )
			if ( !IsValid( arsenal ) )
				continue

			SetWorldspaceIconColor( arsenal, INTERACTIBLE_PERK_MINIMAP_COLOR, INTERACTIBLE_PERK_MINIMAP_COLOR )

			arsenal.SetRenderColor( ARSENAL_BASE_COLOR_R, ARSENAL_BASE_COLOR_G, ARSENAL_BASE_COLOR_B )
			arsenal.OverrideClientSideBodyGroupModelByIndex( arsenal.FindBodygroup( ARSENAL_CONSOLE_BODYGROUP_NAME ), ARSENAL_CONSOLE_UNUSED_BODYGROUP_INT )
		}

		file.arsenalsUsed.clear()
	}

	foreach ( ruiLocationData in file.ruiEHITable.clonevalues() )
	{
		if ( RuiIsAlive( ruiLocationData.minimapRui ) )
		{
			RuiSetFloat3( ruiLocationData.minimapRui, "iconColor", INTERACTIBLE_PERK_MINIMAP_COLOR )
		}

		if ( RuiIsAlive( ruiLocationData.fullmapRui ) )
		{
			RuiSetFloat3( ruiLocationData.fullmapRui, "iconColor", INTERACTIBLE_PERK_MINIMAP_COLOR )
		}
	}

	
	UpdateArsenalRespawnRUIs()
}

const string MAIN_WEAPON_STR = "main_weapon"
void function Arsenals_SetWeaponSlotPinged( string equipSlot )
{
	if ( equipSlot.find( MAIN_WEAPON_STR ) == -1 )
		return

	int slotIdx = MAIN_WEAPON_STR.len()
	string slot = equipSlot.slice( slotIdx, slotIdx + 1 )
	if ( !slot.isnumeric() )
		return

	file.weaponIdxPinged = ConvertStringToInt( slot )

	thread ResetWeaponIdxPingedIfQuickchatFails_Thread()
}

void function PingRelevantArsenalForChatEvent( entity player, int commsAction, entity subjectEnt )
{
	if ( !IsValid( player ) )
		return

	if ( !file.arsenalsSpawned )
		return

	if ( !( file.weaponIdxPinged == 0 || file.weaponIdxPinged == 1 ) )
		return

	array< EHI > sortedArsenalEHI = GetSortedArsenalEHIArrayNearLocalPlayer()
	ArsenalData closestArsenalData
	int ammoType = -1
	bool checkAmmoType = !( commsAction == eCommsAction.INVENTORY_NEED_FIRST_WEAPON || commsAction == eCommsAction.INVENTORY_NEED_ANOTHER_WEAPON )
	bool isAttachmentRequest = commsAction >= REQUEST_ATTACHMENT_COMMS_START
	int additionalAmmoType = -1
	if ( checkAmmoType )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + file.weaponIdxPinged )
		string ammoTypeRef = Arsenals_GetAmmoTypeForWeaponEnt( weapon )
		if ( ammoTypeRef == NOT_ON_ARSENAL_STR || ammoTypeRef == "" )
			return

		ammoType = AmmoType_GetTypeFromRef( ammoTypeRef )

		if ( IsValid( weapon ) && GetBaseWeaponRef( GetWeaponClassNameWithLockedSet( weapon ) ) == "mp_weapon_car" )
		{
			additionalAmmoType = AmmoType_GetTypeFromRef( BULLET_AMMO )
		}
	}

	foreach ( arsenalEHI in sortedArsenalEHI )
	{
		if ( !(arsenalEHI in file.arsenalEHIToArsenalDataMap) )
			continue

		entity arsenalEnt = FromEHI( arsenalEHI )
		if ( !IsValid( arsenalEnt ) )
			continue

		if ( checkAmmoType && arsenalEnt.GetAmmoType() != ammoType && arsenalEnt.GetAmmoType() != additionalAmmoType )
			continue

		
		
		if ( isAttachmentRequest && file.arsenalsUsed.contains( arsenalEHI ) )
			continue

		if ( !DeathField_IsPointInsideRing( arsenalEnt.GetOrigin(), player.DeathFieldIndex() ) )
			continue

		closestArsenalData = file.arsenalEHIToArsenalDataMap[arsenalEHI]
		break
	}

	entity arsenalEnt = FromEHI( closestArsenalData.arsenalEHI )

	if ( IsValid( arsenalEnt ) )
	{
		Remote_ServerCallFunction( "ClientToServer_PingArsenalAfterQuickchat", arsenalEnt )
	}

	file.weaponIdxPinged = -1
}

void function ResetWeaponIdxPingedIfQuickchatFails_Thread()
{
	Signal( clGlobal.signalDummy, "WeaponQuickchatIdxSet" )
	EndSignal( clGlobal.signalDummy, "WeaponQuickchatIdxSet" )

	wait QUICKCHAT_FAIL_TIME

	if ( file.weaponIdxPinged != -1 )
	{
		file.weaponIdxPinged = -1
	}
}


