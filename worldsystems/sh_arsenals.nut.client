bool function Arsenals_Enabled()
{
	if ( !file.hasCheckedIfEnabled )
	{
		file.hasCheckedIfEnabled = true




		file.arsenalsEnabled = GetCurrentPlaylistVarBool( "arsenals_enabled", true ) && GameMode_IsActive( eGameModes.SURVIVAL ) && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING )

	}

	return file.arsenalsEnabled
}

