void function ForcedSpawn_SetMapViewValues( vector origin, float scalar, float heightOffset = 37620 )
{
	file.mapViewCenter = origin
	file.mapViewVectorScalar = scalar 
	file.mapViewOffsetHeight = heightOffset
}



void function ServerToClient_ForcedSpawn_Set_EnemySpawnPoints( vector enemySpawnPos )
{
	if ( enemySpawnPos == < 0, 0, 0 > )
	{
		return
	}

	file.enemySpawnPoints.append( enemySpawnPos )
}

void function ServerToClient_ForcedSpawn_Begin_Overhead_PreviewForClient( vector cameraPosition, vector cameraAngles, float fov )
{
	thread function() : ( cameraPosition, cameraAngles, fov)
	{
		entity player = GetLocalViewPlayer()
		EHI playerEHI = ToEHI( player )

		
		WaitFrame() 
		
		

		if ( !IsValid( FromEHI( playerEHI ) ) )
			return

		thread SetupPreviewCamera_Thread( playerEHI, cameraPosition, cameraAngles, fov )
	}()
}


void function SetupPreviewCamera_Thread( EHI playerEHI, vector cameraPosition, vector cameraAngles, float fov )
{
	Assert( IsNewThread(), "Must be threaded off" )

	entity player = FromEHI( playerEHI )

	entity camera      = CreateClientSidePointCamera( cameraPosition, cameraAngles, fov )

	file.playerPOIPreviewCamera = camera

	OnThreadEnd(
		function() : ( playerEHI, camera )
		{
			entity player = FromEHI( playerEHI )
			if ( IsValid( player ) )
			{
				player.ClearMenuCameraEntity()
			}
			if ( IsValid( camera ) )
			{
				camera.Destroy()
			}
		}
	)

	if ( tuning.preview_camera_preview_spawn_point )
	{
		entity spawnWaypoint = file.assignedSpawnWaypoint
		if ( IsValid( spawnWaypoint ) )
		{
			bool hybridCameraConfig = (tuning.previewType == ePOIPreviewType.HYBRID)
			vector targetPos = spawnWaypoint.GetWaypointVector( FORCEDSPAWN_WP_INDEX_POS )

			OptimizeInitialCameraViewPosition( targetPos, hybridCameraConfig, fov )
		}
	}

	player.SetMenuCameraEntity( camera )

	float timeToWait = max( 0, tuning.pre_game_preview_duration - ( Time() - GetGlobalNetTime( "ForcedSpawnPreviewStartTime" ) ) )

	wait timeToWait
}

void function OptimizeInitialCameraViewPosition( vector targetPos, bool hybridCameraConfig, float fov )
{
	float distance = tuning.preview_camera_distance
	float angle = tuning.preview_camera_angle

	vector mapCenterToTargetPos = targetPos - file.mapViewCenter
	mapCenterToTargetPos.z = 0

	vector dirMapCenterToTargetPos = Normalize( mapCenterToTargetPos )
	vector perp = AnglesToRight( VectorToAngles( dirMapCenterToTargetPos ) )

	vector dirTargetPosToCamera = VectorRotateAxis( dirMapCenterToTargetPos, perp, angle )
	vector cameraPosition = targetPos + dirTargetPosToCamera * distance

	vector cameraForward = -dirTargetPosToCamera
	vector cameraAngles = VectorToAngles( cameraForward )

	if ( hybridCameraConfig )
	{
		

		float fovScalingFactor = 1.3  
		float parallaxFactor = tan( fov * 0.5 * DEG_TO_RAD ) * fovScalingFactor
		float screenOffset = Clamp( tuning.preview_camera_hybrid_screen_offset, 0.0, 1.0 )  
		float remappedScreenOffset = -1 + 2 * screenOffset    
		float lateralShift = distance * parallaxFactor * remappedScreenOffset
		vector cameraRight = AnglesToRight( cameraAngles )
		cameraPosition = cameraPosition - cameraRight * lateralShift
	}

	file.playerPOIPreviewCamera.SetAngles( cameraAngles )
	file.playerPOIPreviewCamera.SetOrigin( cameraPosition )
}

void function ServerToClient_ForcedSpawn_Begin_MapView_PreviewForClient( vector spawnPosition, float dropZoneRadius )
{
	thread function() : ( spawnPosition, dropZoneRadius)
	{
		entity player = GetLocalViewPlayer()
		EHI playerEHI = ToEHI( player )

		
		WaitFrame() 
		
		

		if ( !IsValid( FromEHI( playerEHI ) ) )
			return

		thread SetupMapViewPreview_Thread( playerEHI, spawnPosition, dropZoneRadius )
	}()
}

void function SetupMapViewPreview_Thread( EHI playerEHI, vector spawnPosition, float dropZoneRadius )
{
	printt( "[Forced Spawns] Begining the Map View Preview for Drop Zones..." )
	var screenRui = CreatePermanentCockpitPostFXRui( $"ui/drop_zones_prematch.rpak", RUI_DRAW_POSTEFFECTS - 1 )

	OnThreadEnd(
		function() : ( screenRui )
		{
			foreach ( mapRui in file.fullmapPreviewRuis )
			{
				if ( IsValid ( mapRui ) )
				{
					Fullmap_RemoveRui( mapRui )
					RuiDestroyIfAlive( mapRui )
				}
			}

			Fullmap_SetVisible_MapOnly( false, eMapState.PregamePOIPreview )
			Fullmap_ToggleInteractivity( false )

			if( screenRui != null )
			{
				RuiDestroyIfAlive( screenRui )
			}
		}
	)

	Fullmap_SetVisible_MapOnly( true, eMapState.PregamePOIPreview )
	Fullmap_ToggleInteractivity( true )

	string poiName = Localize( ForcedSpawn_Assignments_ClientGet() )
	RuiSetString( screenRui, "spawnLocation", poiName )
	RuiSetString( screenRui, "gameModeString", GetCurrentPlaylistVarString( "name", "#PLAYLIST_UNAVAILABLE" ) )
	RuiSetString( screenRui, "mapName", GetCurrentPlaylistVarString( "map_name", "#PLAYLIST_UNAVAILABLE" ) )
	RuiSetImage( screenRui , "gameModeIcon", GetGamemodeLogoFromImageMap( GetCurrentPlaylistVarString( "gamemode_logo", "BATTLE_ROYALE" )) )

	if ( tuning.preview_stagger_info_reveal_enabled )
	{
		
		int positionInStaggerSequence = 1

		float waitTime = tuning.preview_stagger_delay_time * float( positionInStaggerSequence )

		wait waitTime
	}

	
	var fRui = FullMap_CommonAdd( $"ui/in_world_minimap_square_simple.rpak" )
	if ( fRui == null )
	{
		Warning( "[Forced Spawn] Couldn't add Icon icon to fullmap." )
		return
	}

	RuiSetFloat( fRui, "objectSize", 8 )
	RuiSetFloat3( fRui, "objColor", GetKeyColor( COLORID_COLORSWATCH_GREEN ) * ( 1.0 / 255.0 ) )
	RuiSetImage( fRui, "iconImage", $"rui/hud/gametype_icons/survival/friendly_dropzone_icon" )

	RuiSetFloat3( fRui, "objectAngles", < 0,0,0 > )
	RuiSetFloat3( fRui, "objectPos", spawnPosition )
	Fullmap_AddRui( fRui )
	file.fullmapPreviewRuis.append( fRui )

	
	
	
	
	
	

	
	
		
		
		
		
		
		
		
		
		
		
		
		
		
		
	

	if ( tuning.preview_stagger_info_reveal_enabled )
	{
		int positionInStaggerSequence = 2

		float waitTime = tuning.preview_stagger_delay_time * float( positionInStaggerSequence )

		wait waitTime
	}

	
	if ( file.enemySpawnPoints.len() > 0 )
	{
		if ( tuning.show_enemy_spawn_previews )
		{
			foreach ( vector enemyPos in file.enemySpawnPoints )
			{
				if ( DistanceSqr( enemyPos, spawnPosition ) < tuning.maximum_distance_to_primary_threat_starts * tuning.maximum_distance_to_primary_threat_starts )
				{
					var enemyRui = FullMap_CommonAdd( $"ui/in_world_minimap_square_simple.rpak" )
					if ( enemyRui == null )
					{
						Warning( "[Forced Spawn] Couldn't add Icon icon to fullmap." )
						return
					}

					RuiSetFloat( enemyRui, "objectSize", 8 )
					RuiSetFloat3( enemyRui, "objColor", GetKeyColor( COLORID_COLORSWATCH_RED ) * ( 1.0 / 255.0 ) )
					RuiSetImage( enemyRui, "iconImage", $"rui/hud/gametype_icons/survival/enemy_dropzone_icon" ) 

					RuiSetFloat3( enemyRui, "objectAngles", < 0,0,0 > )
					RuiSetFloat3( enemyRui, "objectPos", enemyPos )
					Fullmap_AddRui( enemyRui )
					file.fullmapPreviewRuis.append( enemyRui )
				}
			}
		}
	}

	if ( tuning.preview_stagger_info_reveal_enabled )
	{
		float waitTime = tuning.preview_stagger_delay_time

		wait waitTime
	}

	if ( file.enemySpawnPoints.len() > 0 )
	{
		if ( tuning.show_enemy_spawn_previews && !tuning.show_only_primary_threat_preview )
		{
			foreach ( vector enemyPos in file.enemySpawnPoints )
			{
				if ( DistanceSqr( enemyPos, spawnPosition ) > tuning.maximum_distance_to_primary_threat_starts * tuning.maximum_distance_to_primary_threat_starts )
				{
					var secondaryEnemyRui = FullMap_CommonAdd( $"ui/in_world_minimap_square_simple.rpak" )
					if ( secondaryEnemyRui == null )
					{
						Warning( "[Forced Spawn] Couldn't add Icon icon to fullmap." )
						return
					}

					RuiSetFloat( secondaryEnemyRui, "objectSize", 8 )
					RuiSetFloat3( secondaryEnemyRui, "objColor", GetKeyColor( COLORID_COLORSWATCH_RED ) * ( 1.0 / 255.0 ) )
					RuiSetImage( secondaryEnemyRui, "iconImage", $"rui/hud/gametype_icons/survival/enemyfar_dropzone_icon" )

					RuiSetFloat3( secondaryEnemyRui, "objectAngles", < 0,0,0 > )
					RuiSetFloat3( secondaryEnemyRui, "objectPos", enemyPos )
					Fullmap_AddRui( secondaryEnemyRui )
					file.fullmapPreviewRuis.append( secondaryEnemyRui )
				}
			}
		}
	}

	float remainingTime = tuning.pre_game_preview_duration

	
	if ( tuning.preview_stagger_info_reveal_enabled )
	{
		remainingTime = tuning.pre_game_preview_duration - ( tuning.preview_stagger_delay_time * 4 )
	}

	float timeToWait = max( 0, remainingTime ) 

	wait timeToWait
}


void function SetupMapRui( entity ent, var rui, bool isFullMap )
{
	RuiSetAsset( rui, "areaImage", $"rui/hud/gametype_icons/survival/drop_zone_radius" )
	RuiSetFloat( rui, "areaImageAlpha",
		GetLocalClientPlayer().GetTeam() == TEAM_SPECTATOR ? 0.2 : 0.5 )
	RuiSetImage( rui, "clampedImage", $"" )

	
	string areaColorArgName = "objColor"
	if ( !isFullMap )
	{
		RuiSetBool( rui, "useOverrideColor", true )
		areaColorArgName = "overrideColor"
	}
	RuiSetColorAlpha( rui, areaColorArgName, <0.168, 0.696, 0.199>, 1 )
	

	if ( ent.IsClientOnly() )
	{
		RuiSetImage( rui, "centerImage", $"" )
		RuiSetFloat( rui, "objectRadius", ent.e.clientEntMinimapScale )
	}
	else
	{
		RuiSetImage( rui, "centerImage", $"rui/hud/gametype_icons/survival/loba_ult_map_icon" )
		RuiTrackFloat( rui, "objectRadius", ent, RUI_TRACK_MINIMAP_SCALE )
	}
}




void function ServerToClient_ForcedSpawn_SpinUp_DropZoneMarker_FX()
{
	if( !IsValid( file.assignedSpawnWaypoint ) )
		return

	ForcedSpawn_LandingMarkers_SpinUp_FlareFX()
	ForcedSpawn_LandingMarkers_SpinUp_DropRadius()
}

void function ForcedSpawn_LandingMarkers_SpinUp_FlareFX()
{
	entity player = GetLocalViewPlayer()
	int playerTeam = player.GetTeam()
	entity spawnWaypoint = file.assignedSpawnWaypoint

	if ( !IsValid( spawnWaypoint ) )
		return

	if ( !tuning.drop_zone_flare_enabled )
		return

	
	vector destination = spawnWaypoint.GetWaypointVector( FORCEDSPAWN_WP_INDEX_POS )

	int markerFXIndex       = GetParticleSystemIndex( DROPZONE_MARKER_FX_BEACON )

	
	int flareFX = StartParticleEffectInWorldWithHandle( markerFXIndex, destination, < 0, 0 ,0 > )

	
	EffectSetControlPointVector( flareFX, 1, FRIENDLY_SPAWNPOINT_FLARE_VFX_COLOR )

	file.DropZoneMarker_FX_Flares.append( flareFX )

	if ( file.enemySpawnPoints.len() > 0 )
	{
		foreach ( vector enemyPos in file.enemySpawnPoints )
		{
			
			int enemyflareFX = StartParticleEffectInWorldWithHandle( markerFXIndex, enemyPos, < 0, 0 ,0 > )

			
			EffectSetControlPointVector( enemyflareFX, 1, ENEMY_SPAWNPOINT_FLARE_VFX_COLOR )

			file.DropZoneMarker_FX_Flares.append( enemyflareFX )
		}
	}
}

void function ForcedSpawn_LandingMarkers_SpinUp_DropRadius()
{
	if ( !tuning.drop_zone_radius_shown_in_skydive )
		return

	entity player = GetLocalViewPlayer()
	int playerTeam = player.GetTeam()
	entity spawnWaypoint = file.assignedSpawnWaypoint

	if ( !IsValid( spawnWaypoint ) )
		return

	
	vector destination = spawnWaypoint.GetWaypointVector( FORCEDSPAWN_WP_INDEX_POS )

	
	float skydiveRadius = tuning.drop_zone_radius

	int markerFXIndex       = GetParticleSystemIndex( DROPZONE_MARKER_FX_RADIUS )
	float zOffset = 1000 

	destination += < 0, 0 , zOffset >

	
	int radiusFX = StartParticleEffectInWorldWithHandle( markerFXIndex, destination, < 0, 0 ,0 > )

	EffectSetControlPointVector( radiusFX, 1, FRIENDLY_SPAWNPOINT_FLARE_VFX_COLOR )
	EffectSetControlPointVector( radiusFX, 2, < skydiveRadius, 0, 0 > )

	file.DropZoneMarker_FX_Radii.append( radiusFX )
}

void function ServerToClient_ForcedSpawn_LandingMarkers_CleanUp()
{
	foreach( flareFX in file.DropZoneMarker_FX_Flares )
	{
		if ( EffectDoesExist( flareFX ) )
		{
			EffectStop( flareFX, false, true )
		}
	}
	file.DropZoneMarker_FX_Flares.clear()

	if ( !tuning.drop_zone_skydive_radius_never_delete )
	{
		foreach( radiusFX in file.DropZoneMarker_FX_Radii )
		{
			if ( EffectDoesExist( radiusFX ) )
			{
				EffectStop( radiusFX, false, true )
			}
		}
		file.DropZoneMarker_FX_Radii.clear()
	}

	file.enemySpawnPoints.clear()
}

void function ServerToClient_ForcedSpawn_WarningSystem_DisplayWarningAnnouncement( bool beingInvaded )
{
	if ( beingInvaded )
	{
		string message = Localize( "#DROP_ZONES_WARNING_ENEMY_INVASION" )

		AnnouncementMessageSweep( GetLocalViewPlayer(),  message , "", GetKeyColor( COLORID_COLORSWATCH_RED ), $"", "menu_deny", tuning.zone_invasion_warning_duration )
		
	}
	else
	{
		string poiName = "ENEMY POI" 
		string message = Localize( "#DROP_ZONES_WARNING_FRIENDLY_INVASION", poiName )

		AnnouncementMessageSweep( GetLocalViewPlayer(),  message , "", GetKeyColor( COLORID_DANGER_WARNING_ORANGE ), $"", "menu_deny", tuning.zone_invasion_warning_duration )
		
	}
}



void function ServerToClient_SimulatePreviewCamera( vector targetPos, bool hybridCameraConfig, float fov, float time )
{
#if DEV
	entity player = GetLocalViewPlayer()
	thread DEV_SimulatePreviewCamera_Thread( player, targetPos, hybridCameraConfig, fov, time  )
#endif
}


#if DEV
void function DEV_SimulatePreviewCamera_Thread( entity player, vector targetPos, bool hybridCameraConfig, float fov, float time )
{
	if ( !IsValid( player ) )
		return

	player.Signal( "EndSimulatePreviewCamera" )
	player.EndSignal( "EndSimulatePreviewCamera" )

	entity camera      = CreateClientSidePointCamera( targetPos, <0, 0, 0>, fov )

	file.playerPOIPreviewCamera = camera

	OnThreadEnd(
		function() : ( player, camera )
		{
			if ( IsValid( player ) )
			{
				player.ClearMenuCameraEntity()
			}
			if ( IsValid( camera ) )
			{
				camera.Destroy()
			}
		}
	)

	OptimizeInitialCameraViewPosition( targetPos, hybridCameraConfig, fov )

	player.SetMenuCameraEntity( camera )

	vector targetToCamera = camera.GetOrigin() - targetPos
	float dist = Length( targetToCamera )
	float sin = targetToCamera.z / dist
	float angle = asin( sin ) * RAD_TO_DEG
	printt( "[DropZones] target pos:", targetPos, "cameraPos:", camera.GetOrigin(), "cameraAngles:", camera.GetAngles(), "cameraFOV:", fov )
	printt( "[DropZones] target to camera dist:", dist, "angle", angle )

	wait time
}
#endif

