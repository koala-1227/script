void function ForcedSpawn_Init()
{
#if DEV
		DevOut( FUNC_NAME() + "():> Entered." )
#endif

	ForcedSpawn_Tuning_Init()

	if ( !ForcedSpawn_Enabled() )
		return

	ForcedSpawn_Networking_Init()

	AddCallback_EntitiesDidLoad( ForcedSpawn_EntitiesDidLoad )

	PrecacheParticleSystem( DROPZONE_MAKER_FX_BEAM )
	PrecacheParticleSystem( DROPZONE_MARKER_FX_RING )
	PrecacheParticleSystem( DROPZONE_MARKER_FX_CENTER )
	PrecacheParticleSystem( DROPZONE_MARKER_FX_BEACON )
	PrecacheParticleSystem( DROPZONE_MARKER_FX_RADIUS )











		Waypoints_RegisterCustomType( FORCEDSPAWN_WP_NAME, CL_ForcedSpawnNameEnt_Created )



		
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.DROP_ZONE_RADIUS,
			MINIMAP_OBJ_AREA_RUI, void function( entity ent, var rui ) {
				SetupMapRui( ent, rui, false )
			},
			$"ui/in_world_minimap_objective_area.rpak", void function( entity ent, var rui ) {
				SetupMapRui( ent, rui, true )
			}
		)

}

void function ForcedSpawn_EntitiesDidLoad()
{
#if DEV
		DevOut( FUNC_NAME() + "():> Entered." )



#endif
}

void function ForcedSpawn_Networking_Init()
{
	Remote_RegisterClientFunction( "ForcedSpawn_Assignments_ClientUpdate", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_SpawnLocationBeams" )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_DisplayPOIName_Overhead_Preview" )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_SpinUp_DropZoneMarker_FX" )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_LandingMarkers_CleanUp" )

	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_WarningSystem_DisplayWarningAnnouncement", "bool" )

	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_Begin_Overhead_PreviewForClient", "vector", -FLT_MAX, FLT_MAX, 32, "vector", -FLT_MAX, FLT_MAX, 32, "float", 0.0, 200.0, 32 )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_Begin_MapView_PreviewForClient", "vector", -FLT_MAX, FLT_MAX, 32, "float", 0.0, FLT_MAX, 32 )
	Remote_RegisterClientFunction( "ServerToClient_ForcedSpawn_Set_EnemySpawnPoints", "vector", -FLT_MAX, FLT_MAX, 32 )

	Remote_RegisterClientFunction( "ServerToClient_SimulatePreviewCamera", "vector", -FLT_MAX, FLT_MAX, 32, "bool", "float", 0.0, 180.0, 32, "float", 0.0, 6000.0, 32 )
	RegisterSignal( "EndSimulatePreviewCamera" )

	RegisterNetworkedVariable( "ForcedSpawnPreviewStartTime", SNDC_GLOBAL, SNVT_TIME, -1 )
}

























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































void function ForcedSpawn_Tuning_Init()
