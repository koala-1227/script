	tuning.gamemodeType = GetCurrentPlaylistVarInt( "forced_spawn_gamemode", defaults.gamemodeType )
	tuning.previewType = GetCurrentPlaylistVarInt( "forced_spawn_preview_type", defaults.previewType )
