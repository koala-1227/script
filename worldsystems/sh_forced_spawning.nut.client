	tuning.multiple_teams_per_poi_enabled = GetCurrentPlaylistVarBool( "forced_spawn_multiple_teams_per_poi_enabled", defaults.multiple_teams_per_poi_enabled )
	tuning.max_teams_per_poi = GetCurrentPlaylistVarInt( "forced_spawn_max_teams_per_poi", defaults.max_teams_per_poi )
