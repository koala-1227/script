int function ForcedSpawn_GetMode()
{
	return tuning.spawnMode
}

bool function ForcedSpawn_Enabled()
{
	return ForcedSpawn_GetMode() != eForcedSpawnMode.NONE
}

bool function ForcedSpawn_POIPreview_Enabled()
{
	return ForcedSpawn_GetMode() == eForcedSpawnMode.AUTOMATIC
}

bool function ForcedSpawn_ShowEnemyStartPings()
{
	return ForcedSpawn_Enabled() && tuning.show_enemy_start_pings
}

bool function ForcedSpawn_ShowFriendlyStartPings()
{
	return ForcedSpawn_Enabled() && tuning.show_friendly_start_pings
}

float function ForcedSpawn_EvoHarvesterTimegateOverride()
{
	return tuning.evoharvester_timegate_override
}

float function ForcedSpawn_GetPreviewPingDisplayTime()
{
	return tuning.preview_ping_display_time
}

float function ForcedSpawn_POIPreview_Duration()
{
	return tuning.pre_game_preview_duration
}



string function ForcedSpawn_Assignments_ClientGet()
{
	return file.poiName
}


void function CL_ForcedSpawnNameEnt_Created( entity wp )
{
	if( !IsValid( wp ) )
		return

	string poiName = NameEnt_GetName( wp )
	printt( "():> Custom Waypoint created for POI: " + poiName )


}


void function ForcedSpawn_Assignments_ClientUpdate( entity wp )
{
	if( !IsValid( wp ) )
		return

	string poiName = NameEnt_GetName( wp )
	file.poiName = poiName

	file.assignedSpawnWaypoint = wp

#if DEV
		DevOut( FUNC_NAME() + "(): poiName == " + poiName )
#endif
}

void function ServerToClient_ForcedSpawn_SpawnLocationBeams()
{
	thread ForcedSpawn_Manage_SpawnLocationBeams_thread()
}

void function ServerToClient_ForcedSpawn_DisplayPOIName_Overhead_Preview()
{
	string poiName = Localize( ForcedSpawn_Assignments_ClientGet() )
	string message         = Localize( "#SPAWNING_IN_SPAWNING_AT_LOBBY", poiName )

	entity localViewPlayer = GetLocalViewPlayer()

	AnnouncementData announcement = Announcement_Create( message )
	announcement.useColorOnSubtext = true
	announcement.announcementStyle = ANNOUNCEMENT_STYLE_BIG
	announcement.duration          = tuning.pre_game_preview_duration

	AnnouncementFromClass( localViewPlayer, announcement )
}

void function ForcedSpawn_Manage_SpawnLocationBeams_thread()
{
	if ( !tuning.show_team_spawn_beams )
		return

	if( !IsValid( file.assignedSpawnWaypoint ) )
		return

	CL_DropZoneMarkerFX_Setup( file.assignedSpawnWaypoint )

	wait tuning.pre_game_preview_duration + 1.0
	CL_DropZoneMarkerFX_Destroy()
}

void function CL_DropZoneMarkerFX_Setup( entity waypoint, asset beamParticleSystem = DROPZONE_MAKER_FX_BEAM )
{
	if ( !IsValid( waypoint ) )
		return

	
	int beamIndex       = GetParticleSystemIndex( beamParticleSystem )
	vector location 	= waypoint.GetWaypointVector( FORCEDSPAWN_WP_INDEX_POS )
	int beamFx       = StartParticleEffectInWorldWithHandle( beamIndex, location, <0, 0, 0> + <90, 0, 0> ) 
	EffectSetControlPointVector( beamFx, 1, FRIENDLY_SPAWNPOINT_FLARE_VFX_COLOR )

	file.DropZoneMarker_FX_Beams.append( beamFx )
}

void function CL_DropZoneMarkerFX_Destroy()
{
	foreach( beamFX in file.DropZoneMarker_FX_Beams )
	{
		if ( EffectDoesExist( beamFX ) )
		{
			EffectStop( beamFX, true, true )
		}
	}
	file.DropZoneMarker_FX_Beams.clear()
}


























































































































































































































































































































































string function NameEnt_GetName( entity wp )
{
	string name = wp.GetWaypointString( FORCEDSPAWN_WP_INDEX_NAME )
	return( name )
}

