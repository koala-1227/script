bool function Unhinged_IsModeActive()
{
	return GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_UNHINGED )
}
bool function Unhinged_IsThreeStrikes()
{
	return GetCurrentPlaylistVarBool( "uh_strikeout_enabled", false )
}















void function Unhinged_PopulateSummaryDataStrings( SquadSummaryPlayerData data )
{
	data.modeSpecificSummaryData[0].displayString = "#DEATH_SCREEN_SUMMARY_KILLS"
	data.modeSpecificSummaryData[1].displayString = "#DEATH_SCREEN_SUMMARY_ASSISTS"
	data.modeSpecificSummaryData[2].displayString = "#DEATH_SCREEN_SUMMARY_KNOCKDOWNS"
	data.modeSpecificSummaryData[3].displayString = "#DEATH_SCREEN_SUMMARY_DAMAGE_DEALT"
	data.modeSpecificSummaryData[4].displayString = "#DEATH_SCREEN_SUMMARY_SURVIVAL_TIME"
	data.modeSpecificSummaryData[5].displayString = "#DEATH_SCREEN_SUMMARY_LAST_LEGEND_STANDING_SURVIVED"
	data.modeSpecificSummaryData[6].displayString = "#DEATH_SCREEN_SUMMARY_SELF_RES_COMPLETED"
}


