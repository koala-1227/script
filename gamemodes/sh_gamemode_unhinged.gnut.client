void function Unhinged_OnPlayerCreated( entity player )
{

	if ( ReservedInventory_IsEnabled() )
	{
		Survival_SetInventorySlotVisibility( "gadgetslot", false )
		Survival_SetInventorySlotVisibility( "helmet", false )
		Survival_SetInventorySlotVisibility( "armor", false )
		Survival_SetInventorySlotVisibility( "incapshield", false )
		Survival_SetInventorySlotVisibility( "backpack", false )
		Survival_SetInventorySlotVisibility( "augment", false )
		RunUIScript( "SurvivalQuickInventory_SetHudElementVisibility", "GearBracketL", false )
		RunUIScript( "SurvivalQuickInventory_SetHudElementVisibility", "GearBracketR", false )

		InventoryUltimatePositionData ultPos
		ultPos.pinCorner = ePinCorners.TOP
		ultPos.siblingCorner = ePinCorners.BOTTOM




#if SUPPORTS_COMPACT_UI
            ultPos.xPos = 0
            if ( IsUsingCompactUILayout() )
                ultPos.yPos = 10
            else
                ultPos.yPos = 45
#else
			ultPos.xPos = 0
			ultPos.yPos = 45
#endif

		SetInventoryUltimatePosition( ultPos )
	}

}



void function Unhinged_OnResolutionChanged()
{
	
	RunUIScript( "SurvivalQuickInventory_SetHudElementVisibility", "GearBracketL", false )
	RunUIScript( "SurvivalQuickInventory_SetHudElementVisibility", "GearBracketR", false )
	RunUIScript( "UpgradeCore_InitTuningValues" )
}



void function Unhinged_OverrideGameState()
{

		if ( MatchModifiers_Enabled() )
		{
			ClGameState_RegisterGameStateFullmapAsset( $"ui/juiced_gamestate_info_fullmap.rpak" )
		}

}





























































































































































































void function Unhinged_MessageForRemovedMythicWeapons( int removedWeapon1, int removedWeapon2 )
{
	entity player = GetLocalViewPlayer()
	if ( !IsValidPlayer( player ) )
		return

	

	if ( removedWeapon2 >= 0 && SURVIVAL_Loot_IsLootIndexValid( removedWeapon2 ) )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( removedWeapon2 )

		LootFeedItem item 			= LootFeed_CreateItem( player, data, -1 )
		item.itemIconOverride 		= Unhinged_GetLootFeedItemIconOverrideForItem( data )
		item.itemIconColorOverride 	= Unhinged_GetLootFeedItemIconColorOverrideForItem( data )
		item.itemIconShadow			= Unhinged_GetLootFeedItemShadowIconForItem( data )
		item.icon2Override 			= Unhinged_GetLootFeedIcon2OverrideForItem( data )
		item.icon2ColorOverride 	= Unhinged_GetLootFeedIcon2ColorOverrideForItem( data )
		item.backgroundEnabled 		= true
		item.backgroundColor		= UNHINGED_COLOR_UI
		LootFeed_QueueItem( item )
	}

	if ( removedWeapon1 >= 0 && SURVIVAL_Loot_IsLootIndexValid( removedWeapon1 ) )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( removedWeapon1 )

		LootFeedItem item 			= LootFeed_CreateItem( player, data, -1 )
		item.itemIconOverride 		= Unhinged_GetLootFeedItemIconOverrideForItem( data )
		item.itemIconColorOverride 	= Unhinged_GetLootFeedItemIconColorOverrideForItem( data )
		item.itemIconShadow			= Unhinged_GetLootFeedItemShadowIconForItem( data )
		item.icon2Override 			= Unhinged_GetLootFeedIcon2OverrideForItem( data )
		item.icon2ColorOverride 	= Unhinged_GetLootFeedIcon2ColorOverrideForItem( data )
		item.backgroundEnabled 		= true
		item.backgroundColor		= UNHINGED_COLOR_UI
		LootFeed_QueueItem( item )
	}
}

asset function Unhinged_GetLootFeedItemIconOverrideForItem( LootData data )
{
	switch ( data.ref )
	{
		
		default:
			return $"rui/events/unhinged/brand_icon_wildcard" 
	}

	unreachable
}

vector function Unhinged_GetLootFeedItemIconColorOverrideForItem( LootData data )
{
	switch ( data.ref )
	{
		
		default:
			return <-1, -1, -1>
	}

	unreachable
}


asset function Unhinged_GetLootFeedItemShadowIconForItem( LootData data )
{
	switch ( data.ref )
	{
		default:
			return $"rui/events/unhinged/icon_wildcard_shadow"
	}

	unreachable
}

asset function Unhinged_GetLootFeedIcon2OverrideForItem( LootData data )
{
	switch ( data.ref )
	{
		
		default:
			return $""
	}

	unreachable
}

vector function Unhinged_GetLootFeedIcon2ColorOverrideForItem( LootData data )
{
	switch ( data.ref )
	{
		
		default:
			return <-1, -1, -1>
	}

	unreachable
}
























































































void function Unhinged_OnLauncherCreated( entity ent )
{
	array<entity> launcherLights = GetEntitiesFromArrayNearPos( GetEntArrayByScriptName( "uh_horizontal_light" ), ent.GetOrigin(), 100 )
	if ( launcherLights.len() > 0 )
	{
		entity launcherLight = launcherLights[0]
		string launcherName = ent.GetScriptName()
		if ( launcherName == "district_launcher_horizontal_trigger_small" )
		{
			launcherLight.SetTweakLightColor( <0.0, 1.0, 0.901> )
		}
		else if ( launcherName == "district_launcher_horizontal_trigger_medium" )
		{
			launcherLight.SetTweakLightColor( <0.0, 1.0, 0.277> )
		}
		else if ( launcherName == "district_launcher_horizontal_trigger_heavy" )
		{
			launcherLight.SetTweakLightColor( <0.199, 1.0, 0.0> )
		}
	}
}














































