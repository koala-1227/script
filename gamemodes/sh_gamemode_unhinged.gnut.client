global function Sh_GamemodeSurvivalUnhinged_Init



void function Sh_GamemodeSurvivalUnhinged_Init()
{
	printt( FUNC_NAME() )

	Unhinged_InitSettings()
	if ( !Unhinged_IsModeActive() )
		return


		
		SetCustomScreenFadeAsset( $"ui/screen_fade_wildcard.rpak" )


	
	if ( Unhinged_IsThreeStrikes() )
	{
		Sh_Survival_Strikeout_Init()
	}

	GamemodeVariant_UH_Holiday_Init()






		GamemodeVariant_UH_Beamstick_Init()



		GamemodeVariant_UH_ClockUp_Init()














	PrecacheModel( UNHINGED_HORIZONTAL_LAUNCHER_MODEL )

	Remote_RegisterClientFunction( UNHINGED_DEATHFIELD_REPEAT_REVIVE_SHOULD_WARN_TARGET_FUNCTION, "bool" )
	Remote_RegisterClientFunction( UNHINGED_DEATHFIELD_REPEAT_REVIVE_SHOULD_WARN_REVIVER_FUNCTION, "bool" )
	Remote_RegisterClientFunction( UNHINGED_MESSAGE_MYTHIC_WEAPON_REMOVED_FUNCTION, "int", -1, INT_MAX, "int", -1, INT_MAX )
	Remote_RegisterClientFunction( string(ServerToClient_Unhinged_SetSummaryScreen) )




















































		Pickup_SelfRevive_Kit_Init()


		Endorsements_Init()


		Unhinged_MatchModifiers_Init()

		Unhinged_SetUpScoreEvents()



		AddCreateCallback( "player", Unhinged_OnPlayerCreated )
		AddClientCallback_OnResolutionChanged( Unhinged_OnResolutionChanged )

		SetChatHUDPosition( DEFAULT_TEXTCHAT_VERTICAL_OFFSET + 80 )

#if SUPPORTS_COMPACT_UI
		    SetChatHUDPositionCompactUi( DEFAULT_TEXTCHAT_Y_OFFSET_COMPACT_UI + 30 )
#endif

		Unhinged_OverrideGameState()

		AddScriptNameCreateCallback( "district_launcher_horizontal_trigger_small", Unhinged_OnLauncherCreated )
		AddScriptNameCreateCallback( "district_launcher_horizontal_trigger_medium", Unhinged_OnLauncherCreated )
		AddScriptNameCreateCallback( "district_launcher_horizontal_trigger_heavy", Unhinged_OnLauncherCreated )

}



void function Unhinged_InitSettings()
{




































	file.isEnabled = GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_UNHINGED )
}


void function Unhinged_SetUpScoreEvents()
{
	ScoreEvent shareEvoEvent = GetScoreEvent( "Evo_MaxLevel_Shared" )
	ScoreEvent_SetMessagingDelay( shareEvoEvent, UNHINGED_EVO_SCORE_MESSAGING_DELAY )

}


