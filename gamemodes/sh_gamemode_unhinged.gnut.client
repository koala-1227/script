void function Unhinged_ServerToClient_SetRepeatRevivesShouldWarnUI( bool state )
{
	entity localViewPlayer = GetLocalViewPlayer()
	if ( !IsValid( localViewPlayer ) )
		return

	file.repeatRevivesShouldWarn = state
#if DEV
		printt( "Tracking Target: " + file.repeatRevivesShouldWarn )
#endif
}



bool function Unhinged_GetRepeatRevivesShouldWarnUI()
{
	return file.repeatRevivesShouldWarn
}



void function Unhinged_ServerToClient_SetRepeatRevivesWarnIsReviver( bool state )
{
	entity localViewPlayer = GetLocalViewPlayer()
	if ( !IsValid( localViewPlayer ) )
		return

	file.repeatedRevivesWarnIsReviver = state
#if DEV
		printt( "Tracking Reviver: " + file.repeatedRevivesWarnIsReviver )
#endif
}



bool function Unhinged_GetRepeatRevivesWarnIsReviver()
{
	return file.repeatedRevivesWarnIsReviver
}


