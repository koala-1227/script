string function Playlist_GetDataTableString( string ref, var datatable, int rowIndex, string columnName, string override )
{
	string val = GetDataTableString( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )
	return GetCurrentPlaylistVarString( (ref + override + columnName), val )
}







asset function Playlist_GetDataTableAssetNoPrecache( string ref, var datatable, int rowIndex, string columnName, string override )
{
	
	asset val = GetDataTableAsset( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )

	string playlistVarName = (ref + override + columnName)
	string assetRaw = GetCurrentPlaylistVarString( playlistVarName, "" )
	if ( assetRaw.len() == 0 )
		return val

	return CastStringToAsset( assetRaw )
}

int function Playlist_GetDataTableInt( string ref, var datatable, int rowIndex, string columnName, string override )
{
	int val = GetDataTableInt( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )
	return GetCurrentPlaylistVarInt( (ref + override + columnName), val )
}

bool function Playlist_GetDataTableBool( string ref, var datatable, int rowIndex, string columnName, string override )
{
	bool val = GetDataTableBool( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )
	return GetCurrentPlaylistVarBool( (ref + override + columnName), val )
}

float function Playlist_GetDataTableFloat( string ref, var datatable, int rowIndex, string columnName, string override )
{
	float val = GetDataTableFloat( datatable, rowIndex, GetDataTableColumnByName( datatable, columnName ) )
	return GetCurrentPlaylistVarFloat( (ref + override + columnName), val )
}






