		image = GetModeEmblemImage( playlistName )
	}
	return image
}












array<asset> function GetModeBannerImages( string playlistName )
{
	string bannersKey = GetPlaylistVarString( playlistName, "banner_bg_set", "defaults" )
	array<asset> modeBanners = []

	if ( bannersKey != "" )
	{
		if ( bannersKey in GAMEMODE_BANNER_BACKGROUNDS_MAP )
		{
			modeBanners = GAMEMODE_BANNER_BACKGROUNDS_MAP[bannersKey]
		}
		else
		{
			Warning( "Playlist '%s' has invalid value for 'emblem': %s", playlistName, bannersKey )
		}
	}

	return modeBanners
}

array<asset> function GetModeBannerImagesByKey( string bannersKey )
{
	if ( bannersKey != "" && bannersKey in GAMEMODE_BANNER_BACKGROUNDS_MAP )
	{
		return GAMEMODE_BANNER_BACKGROUNDS_MAP[bannersKey]
	}

	return []
}


