struct AirdropData
{
	int dropCount
	array<vector> potentialSpots
	float preWait
	bool startOnShrink
	array< array<string> > content
}

struct PvEDroppodEncounter
{
	entity blocker
	entity oobTrigger
	entity beamFX
	entity shieldFX
	entity holoFX
	array< entity > doorWarningFXs
	array< entity > doorLightFXs
	vector currentColor
	float colorTransitionTimeRemaining
	array<entity> npcs
	table< int, array<entity> > teamIdToPlayersInEncounter
	array<entity> exitingPlayersQueue
	table< entity, float > exitingPlayerToEncounterRemovalTime
}

struct {
	table<int, AirdropData> airdropData
	table<entity, PvEDroppodEncounter> activeEncounters
	var destroySpectresRui = null
	bool playerInBubble = false




} file

void function PvEAirdrops_Init()
{
	if ( !GetCurrentPlaylistVarBool( "pve_airdrops_enable", false ) )
		return

	NPCs_Init()

	PvEAirdrops_RegisterWPObjective()

	PrecacheModel( MODEL_PVE_AIRDROPS_DROPPOD_ADDITIVE_MODEL )
	PrecacheModel( NPC_ENGAGEMENT_RANGE_BLOCKER )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_EMP_BURST )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_SHIELD_START )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_SHIELD_END )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_HOLO )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_WARNING_HOLO )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_DOOR_LIGHT_LEFT )
	PrecacheParticleSystem( VFX_PVE_AIRDROPS_DOOR_LIGHT_RIGHT )
	PrecacheScriptString( SCRIPTNAME_PVE_AIRDROPS_PING_ICON )

	Remote_RegisterClientFunction( string( ServerToClient_PvEAirdrops_AnnounceAirdropsIncoming ) )
	Remote_RegisterClientFunction( string( ServerToClient_PvEAirdrops_OnPlayerEntersEncounter ), "entity" )
	Remote_RegisterClientFunction( string( ServerToClient_PvEAirdrops_OnPlayerLeavesEncounter ), "entity" )
	Remote_RegisterClientFunction( string( ServerToClient_PvEAirdrops_OnEncounterComplete ) )

	RegisterSignal( SIG_PVE_AIRDROPS_CHECK_FOR_STATE_UPDATE )
	RegisterSignal( SIG_PVE_AIRDROPS_COLOR_TRANSITION_START )


		SetMapFeatureItem( 500, Localize( "#SECURED_AIRDROPS" ), Localize( "#SECURED_AIRDROPS_DESC" ), MINIMAP_ICON )

		AddTargetNameCreateCallback( TARGETNAME_PVE_AIRDROP_SHIELD, PvEAirDrops_ClientDropPodShieldCreated )












}

int function PvEAirdrops_GetMaxNPCCount()
{
	return minint( GetCurrentPlaylistVarInt( "pve_airdrops_max_npc_count", PVE_AIRDROPS_MAX_NPC_COUNT_DEFAULT ), PVE_AIRDROPS_MAX_NPC_COUNT_DEFAULT )
}

int function PvEAirdrops_GetMainNPCCount()
{
	return minint( GetCurrentPlaylistVarInt( "pve_airdrops_main_npc_count", 3 ), 3 )
}

int function PvEAirdrops_GetMainNPCDifficulty()
{
	return GetCurrentPlaylistVarInt( "pve_airdrops_main_npc_difficulty", 2 )
}

float function PvEAirdrops_GetEMPDamage()
{
	return GetCurrentPlaylistVarFloat( "pve_airdrops_emp_damage", PVE_AIRDROPS_EMP_DAMAGE )
}






















































































































































































void function PvEAirdrops_RegisterWPObjective()
{
	WPObjective_Settings settings

	settings.scriptName = SCRIPTNAME_PVE_AIRDROPS_PING_ICON

	settings.enumWaypoint = eWaypoint.AIRDROP_PVE
	settings.enumPingType = ePingType.AIRDROP_PVE
	settings.enumCommsAction = eCommsAction.PING_AIRDROP_PVE
	settings.enumMinimapObject_prop_script = eMinimapObject_prop_script.PVE_AIRDROP

	settings.iconInWorld = MINIMAP_ICON
	settings.iconMap = MINIMAP_ICON

	settings.worldIconPingDistance = 3000.0
	settings.worldIconMinAlphaDistance = 3000.0
	settings.worldIconMaxAlphaDistance = 3500.0

	settings.pingText = "#SECURED_AIRDROPS"

	WPObjective_Register( settings )
}




























void function ServerToClient_PvEAirdrops_AnnounceAirdropsIncoming()
{

	
	CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
	mainBanner.mainText = Localize( "#SECURED_AIRDROPS_INCOMING" )
	mainBanner.mainIcon1 = EVENT_ICON
	CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
	mainBanner.imageContainerFrameColor = ( GetKeyColor( COLORID_FRAME_LOOT_TIER5 ) / 255 )
	mainBanner.frameColor = ( GetKeyColor( COLORID_FRAME_LOOT_TIER5 ) / 255 )
	mainBanner.textureColor = ( COLOR_BLACK / 255)
	mainBanner.imageContainerHeight = 75.0
	mainBanner.imageContainerLeftPadding = 60.0
	mainBanner.imageContainerRightPadding = 60.0
	mainBanner.imageContainerVerticalPadding = 12.0
	mainBanner.leftEndPadding = 110.0
	mainBanner.rightEndPadding = 110.0

	
	AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner ] )
	CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.GLOBAL )



}

void function PvEAirdrops_ShowDestroySpectresMessage()
{

		file.playerInBubble = true

		if ( file.destroySpectresRui == null )
		{
			file.destroySpectresRui = CreateCockpitPostFXRui( $"ui/pve_airdrop_message_hud.rpak", HUD_Z_BASE )
			RuiSetBool( file.destroySpectresRui, "isVisible", true )
		}



}

void function PvEAirdrops_HideDestroySpectresMessage( float delay )
{

		file.playerInBubble = false

		thread PvEAirdrops_HideMessageAfterDelay( delay )



}

void function PvEAirdrops_HideMessageAfterDelay( float delay )
{

		wait delay

		if ( !file.playerInBubble && file.destroySpectresRui != null )
		{
			RuiDestroyIfAlive( file.destroySpectresRui )
			file.destroySpectresRui = null
		}

}

entity function PvEAirdrops_GetRestrictedLootPanelForAirdropLoot( entity loot )
{
	entity droppod = loot.GetParent()

	if ( IsValid( droppod ) && droppod.GetTargetName() == TARGETNAME_PVE_AIRDROP )
	{
		return droppod
	}

	return null
}































































































































































































































































































































































































































































void function ServerToClient_PvEAirdrops_OnPlayerEntersEncounter( entity player )
{

		PvEAirdrops_ShowDestroySpectresMessage()



}

void function ServerToClient_PvEAirdrops_OnPlayerLeavesEncounter( entity player )
{

		PvEAirdrops_HideDestroySpectresMessage( PVE_AIRDROPS_ENCOUNTER_AGGRO_COOLDOWN )



}

void function ServerToClient_PvEAirdrops_OnEncounterComplete()
{

		PvEAirdrops_HideDestroySpectresMessage( 0 )



}


















































































































































































































































































































































void function PvEAirDrops_ClientSoundThread( entity fxEnt )
{
	float sphereRadius = (fxEnt.GetBoundingMaxs().x - fxEnt.GetBoundingMins().x) / 2
	float maxUpdateRadius = sphereRadius + 5000
	entity soundEmitter = CreateClientSideAmbientGeneric( fxEnt.GetOrigin(), SFX_PVE_AIRDROPS_SHIELD_SUSTAIN, 0 );
	SetTeam( soundEmitter, fxEnt.GetTeam() )
	CopyRealmsFromTo( fxEnt, soundEmitter )
	soundEmitter.SetEnabled( true )

	EndSignal( fxEnt, "OnDestroy", "OnDeath" )

	OnThreadEnd( void function() : (soundEmitter) { if ( IsValid( soundEmitter ) ) soundEmitter.Destroy() } )


	while ( true )
	{
		entity viewPlayer = GetLocalViewPlayer()
		if ( viewPlayer )
		{
			vector origin = fxEnt.GetOrigin()
			vector sphere2player = viewPlayer.EyePosition() - origin
			float distSq = LengthSqr( sphere2player )
			if ( distSq < maxUpdateRadius * maxUpdateRadius )
				soundEmitter.SetOrigin( origin + sphere2player * (sphereRadius / sqrt( distSq )) )
		}

		WaitFrame()
	}
}

void function PvEAirDrops_ClientDropPodShieldCreated( entity fxEnt )
{
	thread PvEAirDrops_ClientSoundThread( fxEnt )
}

