void function POILootTier_Set( string poi, int tier = 1 )
{
	



	
#if POI_LOOT_TIER_DEBUG
		printt( "%s(): >>>--- %s loot tier set: %s", FUNC_NAME(), poi, tier )
#endif
	file.poiTiers_Default[ poi ] <- tier
}

void function POILootTier_Set_IfUndefined( string poi, int defaultTier = 1 )
{
	string poiKey = "#" + poi
	bool alreadySet = (( poi in file.poiTiers_Default ) && ( file.poiTiers_Default[ poi ] != INVALID_RETURNINT ))
	if( alreadySet )
	{
#if POI_LOOT_TIER_DEBUG
			printf( "%s(): >>>--- %s loot tier already set. Skipping...", FUNC_NAME(), poi )
#endif
		return
	}

	string poiPlaylistVar = poi + "_LootTier"
	int tier = GetCurrentPlaylistVarInt( poiPlaylistVar, defaultTier )

#if POI_LOOT_TIER_DEBUG
		printf( "%s(): >>>--- %s loot tier undefined, setting: %s", FUNC_NAME(), poiKey, tier )
#endif
	file.poiTiers_Default[ poiKey ] <- tier
}

int function POILootTierDefault_Get( string poi )
{
	if( !( poi in file.poiTiers_Default ))
	{
#if POI_LOOT_TIER_DEBUG
			printf( "%s(): >>>--- POI %s does not have a default Tier.", FUNC_NAME(), poi )
#endif
		return -1
	}

	return file.poiTiers_Default[ poi ]
}

