bool function LootBinReset_IsLootBinSpecial( entity lootBin )
{
	if ( file.mythicBinEnts.contains( lootBin ) )
		return true

	foreach ( bin in file.goldBinEnts )
	{
		if ( bin == lootBin )
			return true
	}

	return false
}

bool function LootBinReset_IsLootBin_PotentialMythic( entity lootBin )
{
	if ( file.potentialMythicBinEnts.contains( lootBin ) )
		return true

	return false
}

bool function LootBinReset_IsLootBin_PotentialGold( entity lootBin )
{
	if ( lootBin in file.potentialGoldBins )
		return true

	return false
}

bool function LootBinReset_IsLootBin_Mythic( entity lootBin )
{
	if ( file.mythicBinEnts.contains( lootBin ) )
		return true

	return false
}

bool function LootBinReset_IsLootBin_GoldBin( entity lootBin )
{
	
	
	
	
	

	foreach ( bin in file.goldBinEnts )
	{
		if ( bin == lootBin )
			return true
	}

	return false
}

bool function LootBinReset_SupportedMode_ForHUD()
{
	if ( GameMode_IsActive( eGameModes.SURVIVAL ) )
	{
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
			return false

		return true
	}

	return false
}










































































































































