bool function LootBinReset_Enabled()
{
	if ( file.lootbinSystemInitialized )
		return ( file.sys.systemType != eLootBinResetSystemType.NONE )

	return ( LootBinReset_PVAR_LootBinResetType() != eLootBinResetSystemType.NONE )
}

int function LootBinReset_PVAR_LootBinResetType()
{
	if ( file.lootbinSystemInitialized )
		return file.sys.systemType

	return eLootBinResetSystemType[ GetCurrentPlaylistVarString( "lootbin_reset_type", "NONE" ) ]
}

