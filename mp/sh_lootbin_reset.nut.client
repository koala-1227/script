		file.lootbinResetTriggered = newVal
}


void function PlayWarningSFX_Thread()
{
	string audioRef = "LootBin_UI_InGame_LootBinsReset"

	EmitSoundOnEntity( GetLocalViewPlayer(), audioRef )
}

void function ServertoClient_LootBinAnnouncement()
{
	string message         = Localize( "#LOOTBIN_REFRESH_ANNOUNCEMENT_TITLE" )

	if( Arsenals_Enabled())
		message         = Localize( "#HUD_LOOT_STATION_RESET" )

	entity localViewPlayer = GetLocalViewPlayer()

	CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
	mainBanner.mainText = message

	vector backgroundColor = <0, 0, 0>
	vector frameColor = COLOR_WHITE / 255.0


	if ( LootBinReset_MultiRound_Enabled() )
	{
		backgroundColor = GetKeyColor( COLORID_DIM_LOOT_TIER0, LootBinReset_GetMinLootTierPerRound( SURVIVAL_GetCurrentDeathFieldStage() - 1 ) ) / 255.0
		frameColor = GetKeyColor( COLORID_LOOT_TIER0, LootBinReset_GetMinLootTierPerRound( SURVIVAL_GetCurrentDeathFieldStage() - 1 ) ) / 255.0
	}


	mainBanner.backgroundColor = backgroundColor
	mainBanner.frameColor = frameColor
	mainBanner.backgroundAlpha = 0.8
	mainBanner.textureColor = mainBanner.frameColor
	mainBanner.soundAliases.append( "LootBin_UI_InGame_LootBinsReset" )

	if ( LootBinReset_Announce_VO_Enabled() )
	{
		table< int, bool > disabledRounds
		string disabledRoundsString = GetCurrentPlaylistVarString( "lootbin_reset_announce_vo_disabled_rounds", "" )

		if ( disabledRoundsString.len() > 0 )
		{
			array<string> trimmedSplitString = GetTrimmedSplitString( disabledRoundsString , " " )
			foreach ( string roundString in trimmedSplitString )
			{
				int round = int( roundString )
				if ( !( round in disabledRounds ) )
				{
					disabledRounds[round] <- true
				}
			}
		}

		int currentRound = SURVIVAL_GetCurrentDeathFieldStage()
		if ( !( currentRound in disabledRounds ) )
		{
			mainBanner.speakerDialogueLines.append( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.LOOTBIN_RESET ) )
		}
	}

	if ( MinimapAnnouncements_IsEnabled() )
	{
		
		if ( Arsenals_Enabled() && GetCurrentPlaylistVarBool( "secondary_announcement_location_loot_short", false ) )
		{
			MapAnnouncementItem mapAnnouncementItem
			mapAnnouncementItem.message = Localize( "#HUD_LOOT_RESET" )
			mapAnnouncementItem.colorIn = < 255, 255, 255 > / 255.0
			mapAnnouncementItem.icon = $"rui/hud/small_announcements/icon_loot_reset"
			mapAnnouncementItem.iconShadow = $"rui/hud/small_announcements/icon_loot_reset_shadow"
			mapAnnouncementItem.priority = eHudNotificationQueuePriority.LOW
			mapAnnouncementItem.speakerDialogueLines = mainBanner.speakerDialogueLines

			MinimapAnnouncement_QueueItem( mapAnnouncementItem )
		} else if ( Arsenals_Enabled() && GetCurrentPlaylistVarBool( "secondary_announcement_location_loot_split", true ) )
		{
			MapAnnouncementItem mapAnnouncementItem1
			mapAnnouncementItem1.message = Localize( "#HUD_LOOT_BINS_RESET" )
			mapAnnouncementItem1.colorIn = < 255, 255, 255 > / 255.0
			mapAnnouncementItem1.icon = $"rui/hud/small_announcements/icon_loot_reset"
			mapAnnouncementItem1.iconShadow = $"rui/hud/small_announcements/icon_loot_reset_shadow"
			mapAnnouncementItem1.priority = eHudNotificationQueuePriority.LOW
			mapAnnouncementItem1.speakerDialogueLines = mainBanner.speakerDialogueLines
			MinimapAnnouncement_QueueItem( mapAnnouncementItem1 )

			MapAnnouncementItem mapAnnouncementItem2
			mapAnnouncementItem2.message = Localize( "#HUD_LOOT_ARSENALS_RESET" )
			mapAnnouncementItem2.colorIn = < 255, 255, 255 > / 255.0
			mapAnnouncementItem2.icon = $"rui/hud/small_announcements/icon_loot_reset"
			mapAnnouncementItem2.iconShadow = $"rui/hud/small_announcements/icon_loot_reset_shadow"
			mapAnnouncementItem2.priority = eHudNotificationQueuePriority.LOW
			MinimapAnnouncement_QueueItem( mapAnnouncementItem2 )
		}
		else
		{
			MapAnnouncementItem mapAnnouncementItem
			mapAnnouncementItem.message = message
			mapAnnouncementItem.colorIn = mainBanner.frameColor
			mapAnnouncementItem.icon = $"rui/hud/small_announcements/icon_loot_upgraded"
			mapAnnouncementItem.iconShadow = $"rui/hud/small_announcements/icon_loot_upgraded_shadow"
			mapAnnouncementItem.priority = eHudNotificationQueuePriority.LOW
			mapAnnouncementItem.speakerDialogueLines = mainBanner.speakerDialogueLines

			MinimapAnnouncement_QueueItem( mapAnnouncementItem )
		}
		return
	}

	CenterAnnouncements_QueueItem( mainBanner, ePersistenceContext.GLOBAL )
}

void function ServertoClient_LootBinReset_Warning_Announcement( float duration )
{
	thread ServertoClient_LootBinReset_Warning_Announcement_Internal_Thread( duration )
}

void function ServertoClient_LootBinReset_Warning_HUD_Indicator_Set( bool reveal )
{
	LootBinReset_Warning_HUD_Indicator_Set( reveal )
}

void function ServertoClient_LootBinReset_Warning_Announcement_Internal_Thread( float duration )
{
	float timeToWait

	if ( LootBinReset_Announce_Warning_NearTrigger_TimeOffset() > 0 )
		timeToWait = duration - LootBinReset_Announce_Warning_NearTrigger_TimeOffset()
	else
		timeToWait = 20.0

	wait timeToWait

	string message         = Localize( "#LOOTBIN_REFRESH_WARNING_ANNOUNCEMENT" )

	if( Arsenals_Enabled())
		message         = Localize( "#HUD_LOOT_STATION_RESET" )

	entity localViewPlayer = GetLocalViewPlayer()

	AnnouncementData announcement  = Announcement_Create( message )
	announcement.useColorOnSubtext = true
	announcement.announcementStyle = ANNOUNCEMENT_STYLE_GENERIC_WARNING
	announcement.duration          = 5.0

	AnnouncementFromClass( localViewPlayer, announcement )

	thread PlayWarningSFX_Thread()
}

void function ServerToClient_Set_GoldBinEnts( entity lootBin )
{
	if ( !IsValid( lootBin ) )
		return

	file.goldBinEnts.append( lootBin )
}

void function ServerToClient_MythicBinOpened( entity lootbin )
{
	if ( IsValid( lootbin ) )
	{
		lootbin.Signal( "OpenMythicBin" )
		lootbin.Signal( "HideWorldSpaceIconMinimapVisibility" )
	}
}

void function ServerCallback_MythicBin_Client_MythicBinSpawned( entity binFromServer )
{
	if ( !IsValid( binFromServer ) )
		return

	AddCallback_OnUseEntity_ClientServer( binFromServer, MythicBin_OnUse )

	WorldspaceIconData iconSettings
	iconSettings.ent = binFromServer
	iconSettings.color = SrgbToLinear( GetKeyColor( COLORID_MYTHIC_BIN_ICON ) / 255.0 )
	iconSettings.imageAsset = MYTHIC_BIN_ICON
	iconSettings.upOffset = MYTHIC_BIN_ICON_UP_OFFSET
	iconSettings.descriptiveText = "#PROMPT_PING_RESET_BIN_MYTHIC_SHORT"
	iconSettings.pingType = ePingType.RESET_BIN_MYTHIC

	SetupWorldspaceIcon( iconSettings )
}

void function ServerCallback_UpdateBinPulse( entity binFromServer )
{
	binFromServer.kv.rendercolor = "255 255 255"
}

void function LootBinReset_Warning_HUD_Indicator_Set( bool reveal )
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) || GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return

	string message
	if ( reveal )
	{
		if ( LootBinReset_Announce_Warning_HudIndicator_UseLongText() )
		{

			if( Arsenals_Enabled())
				message = Localize( "#HUD_LOOT_STATION_RESET" )
			else

				message = Localize( "#LOOTBIN_REFRESH_HUD_WARNING_MESSAGE_LONG" )
		}
		else
		{

			if( Arsenals_Enabled())
				message = Localize( "#HUD_LOOT_STATION_RESET" )
			else

				message = Localize( "#LOOTBIN_REFRESH_HUD_WARNING_MESSAGE_SHORT" )
		}

	}

	NextCircleClosingStatusChanged( message )
}

var function Bin_CreateClientSideHUDMarker_thread ( asset hudImage, entity lootbin, float upOffset, bool trackPosition )
{
	lootbin.EndSignal( "OnDestroy" )
	lootbin.EndSignal( "OnDeath" )
	lootbin.EndSignal( "OpenMythicBin" )

	entity localViewPlayer = GetLocalViewPlayer()
	vector pos             = lootbin.GetOrigin()
	var rui                = CreateFullscreenRui( PERK_IN_WORLD_HUD_OBJECT, RuiCalculateDistanceSortKey( localViewPlayer.EyePosition(), pos ) )

	RuiSetImage( rui, "beaconImage", hudImage )
	printt( "Mythic Bin Color: " + SrgbToLinear( GetKeyColor( COLORID_MYTHIC_BIN_ICON ) / 255.0 ) )
	RuiSetFloat3( rui, "iconColor", SrgbToLinear( GetKeyColor( COLORID_MYTHIC_BIN_ICON ) / 255.0 ) )
	RuiSetGameTime( rui, "startTime", Time() )
	if ( trackPosition )
	{
		RuiTrackFloat3( rui, "pos", lootbin, RUI_TRACK_ABSORIGIN_FOLLOW  )
	}
	else
	{
		RuiSetFloat3( rui, "pos", pos )
	}
	RuiSetFloat( rui, "upOffset", upOffset )
	RuiKeepSortKeyUpdated( rui, true, "pos" )
	RuiSetBool( rui, "isVisible", true )

	file.binToWorldSpaceRui[ lootbin ] <- rui

	thread LootBinReset_WorldspaceUseIconThink_Thread( rui, lootbin )

	OnThreadEnd(
		function() : ( rui )
		{
			if ( IsValid( rui ) )
				RuiSetBool( rui, "isVisible", false )
		}
	)

	WaitForever()
}

void function LootBinReset_WorldspaceUseIconThink_Thread( var rui, entity ent )
{
	Assert( IsNewThread() )
	ent.EndSignal( "OnDestroy", "OpenMythicBin")
	ent.EndSignal( "OnDeath" )

	RuiSetString( rui, "descriptiveTextLocString", "#PROMPT_PING_RESET_BIN_MYTHIC_SHORT" )
	file.mythicBinWorldspaceIconVisibility[ent] <- true
	RuiSetBool( rui, "isVisible", true )
	thread MythicBin_ListenForBinPinged( ent, rui )

	OnThreadEnd( void function() : ( ent, rui ) {
		RuiDestroyIfAlive( rui )
		if( ent in file.binToWorldSpaceRui )
			delete file.binToWorldSpaceRui[ent]
		if( ent in file.mythicBinWorldspaceIconVisibility )
			delete file.mythicBinWorldspaceIconVisibility[ent]
		if( file.highlightedPingEnt == ent )
		{
			file.highlightedPingEnt = null
		}
	} )

	WaitForever()
}

void function MythicBin_ListenForBinPinged( entity prop, var rui )
{
	prop.EndSignal( "OnDestroy", "OpenMythicBin")

	while( true )
	{
		if( !file.mythicBinPingedEnts.contains( prop ) )
			prop.WaitSignal( "MythicBinPinged" )

		file.mythicBinWorldspaceIconVisibility[ prop ] <- false
		RuiSetBool( rui, "isVisible", false )
		prop.WaitSignal( "MythicBinPingDestroyed" )
		file.mythicBinWorldspaceIconVisibility[prop] <- true
		RuiSetBool( rui, "isVisible", true )
	}
}

void function LootBinReset_MythicBins_BinPinged( entity prop, entity wp )
{
	if ( !LootBinReset_Enabled() )
		return

	prop.Signal( "MythicBinPinged" )
	file.mythicBinPingedEnts.append( prop )
	wp.WaitSignal( "OnDestroy" )
	file.mythicBinPingedEnts.fastremovebyvalue( prop )
	prop.Signal( "MythicBinPingDestroyed" )
}

void function LootBinReset_SetHighlightedBinIcon( entity ent )
{
	if( file.highlightedPingEnt == ent )
		return

	if( IsValid( file.highlightedPingEnt ) )
	{
		RuiSetBool( file.binToWorldSpaceRui[file.highlightedPingEnt], "isHighlighted", false )
	}

	file.highlightedPingEnt = ent

	if( IsValid( file.highlightedPingEnt ) )
	{
		RuiSetBool( file.binToWorldSpaceRui[file.highlightedPingEnt], "isHighlighted", true )
	}
}

entity function LootBinReset_MythicBins_GetHighlightedBin()
{
	return file.highlightedPingEnt
}

bool function LootBinReset_MythicBins_UpdateHighlightedBinIcon()
{
	
	

	entity player = GetLocalClientPlayer()
	vector playerEyePos = player.EyePosition()
	vector viewVector = player.GetViewVector()
	float minDot = deg_cos( 3.0 )
	float bestDot = 0
	entity bestEnt = null

	array<entity> bins
	foreach( bin, rui in file.binToWorldSpaceRui )
	{
		bins.append( bin )
	}

	bins = GetEntitiesFromArrayNearPos( bins, playerEyePos, MYTHIC_BIN_PING_DISTANCE )

	foreach( entity ent in bins )
	{
		if( !(ent in file.mythicBinWorldspaceIconVisibility) || !file.mythicBinWorldspaceIconVisibility[ent] || !( ent in file.binToWorldSpaceRui ) )
			continue

		vector iconPos
		iconPos = ent.GetOrigin() + <0,0,EVO_HARVESTER_ICON_UP_OFFSET>
		vector eyeToIcon = iconPos - playerEyePos
		vector eyeToIconNormalized = Normalize( eyeToIcon )
		float dot = DotProduct( eyeToIconNormalized, viewVector )
		if( dot < minDot || dot < bestDot )
			continue

		bestDot = dot
		bestEnt = ent
	}


	LootBinReset_SetHighlightedBinIcon( bestEnt )
	return bestEnt != null
}

void function LootBinReset_ServerToClient_SetMythicBinEnt( entity lootBin )
{
	if ( !IsValid( lootBin ) )
		return

	file.mythicBinEnts.append( lootBin )
}

