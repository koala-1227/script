void function Init_SingleRoundTuningVars()
{
	Init_BlockedGoldWeaponRegistry()

	tuning.lootBinResetEnabled = LootBinReset_SingleRound_Enabled()

	RegisterTuningStruct( "tuning", "lootbin_reset_" )
}

bool function Sh_Lootbin_Reset_SingleRound_Init()
{
	Init_SingleRoundTuningVars()

	if ( !LootBinReset_SingleRound_Enabled() )
		return false

	LootBinReset_RegisterSingleRoundSystem()

	return true
}

void function LootBinReset_RegisterSingleRoundSystem()
{
	LootbinResetSystem system
	system.systemType = eLootBinResetSystemType.SINGLE_ROUND
	system.GetMinResetLootTier = int function( int deathStage ) : () { return LOOTBIN_RESET_MINIMUM_LOOT_TIER }





	LootBinReset_RegisterSystem( system )
}

bool function LootBinReset_SingleRound_Enabled()
{
	return LootBinReset_PVAR_LootBinResetType() == eLootBinResetSystemType.SINGLE_ROUND
}



























































