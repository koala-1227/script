void function RespawnEntitySpawned( entity ent )
{
	if( !IsValid( ent ) )
		return

	if ( !IsRespawnStationEnt( ent ) )
		return

	if ( !RespawnBeacons_PLV_Enabled() && ent.GetScriptName() != MOBILE_RESPAWN_BEACON_SCRIPTNAME )
	{
		
		
		
		





		return
	}


		if ( RespawnBeacons_ShouldShowInGameUI() )
		{

				if ( ReusableBeacon_AreInfiniteRespawnBeaconUsesEnabled() && ReusableBeacon_IsValidReusableMapBeacon( ent ) )
				{
					AddEntityCallback_GetUseEntOverrideText( ent, ReusableBeacon_TextOverride )
				}
				else

				{
					SetBeaconToDefaultState_Client( ent )
					AddEntityCallback_GetUseEntOverrideText( ent, RespawnChamber_TextOverride )
				}
		}
		else if ( IsValid( ent ) && ent in file.chamberToBeamFX )
		{
			if ( EffectDoesExist( file.chamberToBeamFX[ ent ] ) )
				EffectStop( file.chamberToBeamFX[ ent ], true, true )
		}


























	AddBeaconEntToRespawnBeaconsArray( ent )

	SetCallback_CanUseEntityCallback( ent, Beacon_CanUse )
	SetCallback_ShouldUseBlockReloadCallback( ent, SimpleShouldNotBlockReloadCallback )

	AddCallback_OnUseEntity_ClientServer( ent, RespawnChamberOnUse )
	AddEntityDestroyedCallback( ent, RespawnEntityDestroyed )

	
	
	
	
	
	
	
}

void function RespawnEntityDestroyed( entity ent )
{

		if ( ent in file.beaconEntToMiniMapIconRuiTable )
		{
			delete file.beaconEntToMiniMapIconRuiTable[ ent ]
		}

		if ( ent in file.beaconEntToFullMapIconRuiTable )
		{
			delete file.beaconEntToFullMapIconRuiTable[ ent ]
		}

		if ( ent in file.beaconEntToInWorldIconRuiTable )
		{
			delete file.beaconEntToInWorldIconRuiTable[ ent ]
		}



		if ( ReusableBeacon_AreInfiniteRespawnBeaconUsesEnabled() )
		{
			if ( ent in file.reusableBeaconEntToWaypointTable )
				delete file.reusableBeaconEntToWaypointTable[ ent ]
		}


	file.allStations.fastremovebyvalue( ent )
}


void function SetBeaconToDefaultState_Client( entity ent )
{
	var rui
	if ( ent.GetScriptName() == MOBILE_RESPAWN_BEACON_SCRIPTNAME )
		rui = AddOverheadIcon( ent, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_mobile_respawn_beacon.rpak" )
	else
		rui = AddOverheadIcon( ent, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_respawn_beacon.rpak" )
	RuiSetFloat2( rui, "iconSize", <80, 80, 0> )
	RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_NEAR )
	RuiSetBool( rui, "adsFade", true )
	RuiSetString( rui, "hint", "#RESPAWN_ALLCAPS" )

	thread ManageRespawnChamberData( ent, rui )

	if ( ent.GetScriptName() == RESPAWN_CHAMBER_SCRIPTNAME ) 
		thread RespawnBeacon_PlayHologramVFX( ent )
}




void function AddBeaconEntToRespawnBeaconsArray( entity beacon )
{
	if ( IsValid( beacon ) )
		file.allStations.append( beacon )
}































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































bool function Beacon_CanUse( entity player, entity ent, int useFlags )
{
	if ( Bleedout_IsBleedingOut( player ) )
		return false

	if ( player.ContextAction_IsActive() )
		return false

	if ( PlayerDrone_IsPlayerInDroneView( player ) )
		return false

	if ( !SURVIVAL_PlayerAllowedToPickup( player ) )
	{

		
		entity exclusiveUseEnt = ent.GetExclusiveUseEnt()
		if ( exclusiveUseEnt != player )
		{
			return false
		}



	}

	if ( ent.e.isBusy )
		return false

	if ( GetCurrentPlaylistVarBool( "interrupted_stops_revive", false ) )
	{
		if ( StatusEffect_HasSeverity( player, eStatusEffect.interrupted ) )
			return false
	}

	return true
}

bool function Has_BR_Respawn_WithArmor()
{
	bool hasRespawnWithArmor = GameMode_IsActive( eGameModes.SURVIVAL ) && GetCurrentPlaylistVarBool( "has_br_respawn_witharmor", true )


	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_STRIKEOUT ) )
		hasRespawnWithArmor = true


	return( hasRespawnWithArmor )
}

