void function RespawnChamberOnUse( entity pickup, entity player, int pickupFlags )
{
	if ( !IsBitFlagSet( pickupFlags, USE_INPUT_LONG ) )
		return






	if ( !HasTeammatesToRespawn( player.GetTeam() ) )
		return


	RespawnChamberOnUse_Common( pickup, player )
}

void function RespawnChamberOnUse_Common( entity pickup, entity player )
{
	bool isMobile = pickup.GetScriptName() == MOBILE_RESPAWN_BEACON_SCRIPTNAME

		if ( ReusableBeacon_AreInfiniteRespawnBeaconUsesEnabled() && ReusableBeacon_IsValidReusableMapBeacon( pickup ) )
		{
			
			
			if ( !ReusableBeacon_IsBeaconUsable( pickup, player.GetTeam() ) )
			{




				return
			}
		}



		HidePlayerHint( "#RESPAWN_AT_BEACONS_HINT" )


	ExtendedUseSettings settings
	settings.successSound = RESPAWN_BEACON_SUCCESS_SOUND


		settings.loopSound = RESPAWN_BEACON_LOOP_SOUND
		settings.ruiType = eExtendedUseRui.PROGRESS_BAR
		settings.displayRuiFunc = DisplayRuiForRespawnChamber















		settings.hint = "#HINT_RESPAWNING"
		settings.icon = RESPAWN_BEACON_ICON_NO_FRAME

		if ( isMobile )
		{
			settings.successFunc = RespawnSuccessClient_Mobile
		}





























	if ( isMobile )
	{
		settings.duration = GetRespawnStationUseTime_Mobile( pickup )
	}






	else
		settings.duration = GetRespawnStationUseTime( pickup )

	settings.useInputFlag = IN_USE_LONG
	settings.movementDisable = true

	thread ExtendedUse( pickup, player, settings )
}









































void function DisplayRuiForRespawnChamber( entity ent, entity player, var rui, ExtendedUseSettings settings )
{
	float startTime = settings.startTime_Internal > 0.0 ? settings.startTime_Internal : Time()
	float endTime = startTime + settings.duration
	DisplayRuiForRespawnChamber_Internal( rui, settings.icon, startTime, endTime, settings.hint )
}

void function DisplayRuiForRespawnChamber_Internal( var rui, asset icon, float startTime, float endTime, string hint )
{
	RuiSetBool( rui, "isVisible", true )
	RuiSetImage( rui, "icon", icon )
	RuiSetGameTime( rui, "startTime", startTime )
	RuiSetGameTime( rui, "endTime", endTime )
	RuiSetString( rui, "hintKeyboardMouse", hint )
	RuiSetString( rui, "hintController", hint )
}








































































































































































array< entity > function GetPlayersWaitingToBeRespawned( int team, bool checkDelivery = true, bool checkBeacon = true )
{
	array<entity> playersToSpawn
	foreach ( p in GetPlayerArrayOfTeam( team ) )
	{
		int respawnStatus 		= p.GetPlayerNetInt( "respawnStatus" )
		bool inDelivery 		= checkDelivery && ( respawnStatus == eRespawnStatus.WAITING_FOR_DELIVERY )
		bool inBeaconRespawn 	= checkBeacon	&& ( respawnStatus == eRespawnStatus.WAITING_FOR_BEACON )

		if ( !IsAlive( p ) && inDelivery || inBeaconRespawn )
		{
			playersToSpawn.append( p )
		}
	}

	return playersToSpawn
}

int function CountTeammatesWaitingToBeRespawned( int team, bool checkDelivery = true, bool checkBeacon = true )
{
	array< entity > playersToRespawn = GetPlayersWaitingToBeRespawned( team, checkDelivery, checkBeacon )
	return playersToRespawn.len()
}

bool function HasTeammatesToRespawn( int team, bool checkDelivery = true, bool checkBeacon = true )
{
	return CountTeammatesWaitingToBeRespawned( team, checkDelivery, checkBeacon ) > 0
}

bool function HasTeammatesRespawningFromBeacon( int team )
{
	return HasTeammatesToRespawn( team, false, true )
}



array< entity > function GetPlayers_WaitingForRespawn( int team )
{
	array< entity > teamPlayers = GetPlayerArrayOfTeam( team )
	array< entity > playersWaitingToRespawn
	foreach( pl in teamPlayers )
	{
		int respawnStatus = pl.GetPlayerNetInt( "respawnStatus" )
		if( respawnStatus == eRespawnStatus.WAITING_FOR_RESPAWN )
		{
			playersWaitingToRespawn.append( pl )
		}
	}

	return playersWaitingToRespawn
}

bool function HasTeammates_WaitingForRespawn( int team )
{
	array< entity > playersWaitingForRespawn = GetPlayers_WaitingForRespawn( team )

	bool hasWaitingPlayers = playersWaitingForRespawn.len() > 0

	return  hasWaitingPlayers
}


