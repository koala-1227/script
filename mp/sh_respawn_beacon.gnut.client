	}

	return false
}


void function RespawnSuccessClient_Mobile( entity ent, entity playerUser, ExtendedUseSettings settings )
{
	file.mobileRespawnSpawnInProgress = true

	entity viewPlayer = GetLocalViewPlayer()

	if ( !IsValid( viewPlayer ) )
		viewPlayer = GetLocalClientPlayer()

	if ( !IsValid( viewPlayer ) )
		return

	bool waitingToBeRespawned = HasTeammatesToRespawn( viewPlayer.GetTeam() )
	foreach ( rui in file.beaconEntToInWorldIconRuiTable.clonevalues() )
	{
		UpdateRespawnChamberRuis( rui, waitingToBeRespawned )
	}
}









































































entity function GetRespawnBeaconUnderAim( vector worldPos, float worldRange )
{
	float closestDistSqr = FLT_MAX
	float worldRangeSqr = worldRange * worldRange
	entity closestEnt = null

	if( MapPing_Modify_DistanceCheck_Enabled() )
	{
		float modifier = MapPing_DistanceCheck_GetModifier()

		if( worldRange >= MapPing_DistanceCheck_GetDistanceRange() )
			modifier *= 0.5

		worldRangeSqr = ( worldRange * modifier ) * ( worldRange * modifier )
	}

	foreach ( beacon in file.allStations )
	{
		if ( !IsValid( beacon ) )
			continue

		vector beaconOrigin = beacon.GetOrigin()

		float distSqr = Distance2DSqr( beaconOrigin, worldPos )
		if ( distSqr < worldRangeSqr && distSqr < closestDistSqr  )
		{
			closestDistSqr = distSqr
			closestEnt     = beacon
		}
	}

	if ( !IsValid( closestEnt ) )
	{
		return null
	}

	
	return closestEnt
}

bool function PingRespawnBeaconUnderAim( entity beacon )
{
	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsPingAllowedForPlayer( player ) )
		return false

	if ( !IsPingEnabledForPlayer( player ) )
		return false

	Remote_ServerCallFunction( FUNCNAME_PingBeaconFromMap, beacon )

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )

	return true
}























bool function ReusableBeacon_AreInfiniteRespawnBeaconUsesEnabled()
{
	return GetCurrentPlaylistVarBool( "infinite_respawn_beacon_use", true )
}





bool function ReusableBeacon_AreTeamBasedReusableRespawnBeaconUsesEnabled()
{
	return ReusableBeacon_AreInfiniteRespawnBeaconUsesEnabled() && GetCurrentPlaylistVarBool( "infinite_respawn_beacon_use_team_based", true )
}





bool function ReusableBeacon_ShouldResetOnRound()
{
	return ReusableBeacon_AreTeamBasedReusableRespawnBeaconUsesEnabled() && GetCurrentPlaylistVarBool( "infinite_respawn_beacon_reset_per_round", false )
}





float function ReusableBeacon_GetCooldownDuration()
{
	return GetCurrentPlaylistVarFloat( "infinite_respawn_beacon_cooldown_duration", 0.0 )
}





bool function ReusableBeacon_IsBeaconUsable( entity beacon, int team = -1 )
{
	if ( !ReusableBeacon_IsValidReusableMapBeacon( beacon ) )
		return false

	int beaconState = ReusableBeacon_GetBeaconState( beacon, team )

	
	if ( beaconState == eReusableRespawnBeaconState.AVAILABLE )
		return true

	return false
}






bool function ReusableBeacon_IsValidReusableMapBeacon( entity beacon )
{
	
	return  IsValid( beacon ) && beacon.GetScriptName() == RESPAWN_CHAMBER_SCRIPTNAME
}






































































































































































































































void function ReusableBeacon_OnWaypointInstanced( entity wp )
{
	if ( !IsValid( wp ) )
		return

	if ( wp.GetWaypointCustomType() != WAYPOINT_REUSABLE_RESPAWNBEACON )
		return

	thread ReusableBeacon_SetupClientSideData_Thread( wp )
}






const float RESPAWNBEACON_ENT_VALIDITY_GRACE_PERIOD = 10.0
void function ReusableBeacon_SetupClientSideData_Thread( entity wp )
{
	Assert( IsNewThread(), "Must be threaded off" )

	
	FlagWait( "EntitiesDidLoad" )

	entity localPlayer = GetLocalClientPlayer()
	if ( !IsValid( localPlayer ) || !IsValid( wp ) )
		return

	localPlayer.EndSignal( "OnDestroy" )
	wp.EndSignal( "OnDestroy" )

	entity respawnBeacon = wp.GetWaypointEntity( WAYPOINT_ENT_IDX_RESPAWN_BEACON_ENT )
	if ( !ReusableBeacon_IsValidReusableMapBeacon( respawnBeacon ) )
	{
		Warning( "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " Waypoint: " + wp + " returned a beacon ent that might be invalid or an unsupported type going to wait a few secs and try again one more time" )
		
		wait RESPAWNBEACON_ENT_VALIDITY_GRACE_PERIOD

		respawnBeacon = wp.GetWaypointEntity( WAYPOINT_ENT_IDX_RESPAWN_BEACON_ENT )

		if ( !ReusableBeacon_IsValidReusableMapBeacon( respawnBeacon ) )
		{
			Assert( false, "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " Waypoint: " + wp + " returned a beacon ent that might be invalid or an unsupported type" )
			return
		}
	}

	file.reusableBeaconEntToWaypointTable[ respawnBeacon ] <- wp

	thread ReusableBeacon_UpdateBeaconStateOnClient_Thread( respawnBeacon ) 
}





void function ReusableBeacon_UpdateBeaconState( entity beacon, int beaconState )
{
	
	if ( GetGameState() > eGameState.Playing  )
		return

	if ( !ReusableBeacon_IsValidReusableMapBeacon( beacon ) )
		return

	switch ( beaconState )
	{
		case eReusableRespawnBeaconState.INVALID:
			
			ReusableBeacon_UpdateMapIconsForBeacon( beacon, $"", false )
			ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
			break
		case eReusableRespawnBeaconState.AVAILABLE:
			
			ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
			
			SetBeaconToDefaultState_Client( beacon )
			ReusableBeacon_UpdateMapIconsForBeacon( beacon, $"", true )
			break
		case eReusableRespawnBeaconState.COOLDOWN:
			
			ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
			
			var rui = AddOverheadIcon( beacon, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_respawn_beacon_states.rpak" )
			RuiSetFloat2( rui, "iconSize", <80, 80, 0> )
			RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_NEAR )
			RuiSetBool( rui, "adsFade", true )
			RuiSetString( rui, "hint", "#RESPAWN_ALLCAPS" )
			RuiSetFloat3( rui, "iconColor", <1, 1, 1> )
			RuiSetFloat3( rui, "bgColor", <0, 0, 0> )
			RuiSetFloat3( rui, "borderColor", <1, 1, 1> )
			RuiSetFloat3( rui, "cdStripes" , <0.4, 0.4, 0.4> )
			RuiSetBool( rui, "isOnCooldown", true )
			RuiSetFloat( rui, "remainingCdTime", ReusableBeacon_GetRemainingCooldownDuration( beacon ) )
			RuiSetFloat( rui, "maxCdTime", ReusableBeacon_GetCooldownDuration() )
			RuiSetBool( rui, "isInUse", false )
			RuiSetBool( rui, "showHint", false )
			file.beaconEntToInWorldIconRuiTable[beacon] <- rui
			
			ReusableBeacon_UpdateMapIconsForBeacon( beacon, RESPAWN_BEACON_DISABLED_ICON, false )
			
			beacon.Signal( "ReusableBeaconDisabled" )
			break
		case eReusableRespawnBeaconState.USED:
			if ( ReusableBeacon_ShouldResetOnRound() )
			{
				
				ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
				
				var rui = AddOverheadIcon( beacon, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_respawn_beacon_states.rpak" )
				RuiSetFloat2( rui, "iconSize", <80, 80, 0> )
				RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_NEAR )
				RuiSetBool( rui, "adsFade", true )
				RuiSetString( rui, "hint", "#RESPAWN_ALLCAPS" )
				RuiSetFloat3( rui, "iconColor", <1, 1, 1> )
				RuiSetFloat3( rui, "bgColor", <0, 0, 0> )
				RuiSetFloat3( rui, "borderColor", <1, 1, 1> )
				RuiSetFloat3( rui, "cdStripes" , <0.4, 0.4, 0.4> )
				RuiSetBool( rui, "isOnCooldown", true )
				RuiSetFloat( rui, "remainingCdTime", 0.0 )  
				RuiSetFloat( rui, "maxCdTime", 0.0 ) 
				RuiSetBool( rui, "isInUse", false )
				RuiSetBool( rui, "showHint", false )
				file.beaconEntToInWorldIconRuiTable[beacon] <- rui
				
				ReusableBeacon_UpdateMapIconsForBeacon( beacon, RESPAWN_BEACON_DISABLED_ICON, false )
			}
			else
			{
				
				ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
				ReusableBeacon_UpdateMapIconsForBeacon( beacon, $"", false )
			}
			
			beacon.Signal( "ReusableBeaconDisabled" )
			break
		default:
			
			ReusableBeacon_UpdateMapIconsForBeacon( beacon, $"", false )
			ReusableBeacon_DestroyInWorldIconForBeacon( beacon )
			Assert( false, "REUSABLE RESPAWN BEACON: Unsupported beacon state: " + beaconState + " for beacon: " + beacon + " in " + FUNC_NAME() )
			break
	}
}






string function ReusableBeacon_TextOverride( entity beacon )
{
	entity localPlayer = GetLocalClientPlayer()
	string hintString = ""

	if ( !IsValid( localPlayer ) || !IsValid( beacon ) )
		return hintString

	if ( !( beacon in file.reusableBeaconEntToWaypointTable ) )
		return hintString

	int currentBeaconState = ReusableBeacon_GetBeaconState( beacon, localPlayer.GetTeam() )

	switch( currentBeaconState )
	{
		case eReusableRespawnBeaconState.INVALID: 
			break
		case eReusableRespawnBeaconState.AVAILABLE: 
			hintString = RespawnChamber_TextOverride( beacon )
			break
		case eReusableRespawnBeaconState.COOLDOWN: 
			hintString = Localize( "#SHADOW_ARMY_RESPAWNBEACON_COOLDOWN", int( ReusableBeacon_GetRemainingCooldownDuration( beacon ) ) )
			break
		case eReusableRespawnBeaconState.USED:
			if ( ReusableBeacon_ShouldResetOnRound() && !DeathField_IsPointInsideRing( beacon.GetOrigin(), localPlayer.DeathFieldIndex() ) )
				hintString = Localize( "#HINT_BEACON_OUTSIDE_RING" )
			else if ( ReusableBeacon_ShouldResetOnRound() )
				hintString = Localize( "#HINT_BEACON_DISABLED_FOR_ROUND" )
			break
		default:
			Assert( false, "REUSABLE RESPAWN BEACON: Unsupported beacon state: " + currentBeaconState + " for beacon: " + beacon + " in " + FUNC_NAME() )
			break
	}

	return hintString
}






int function ReusableBeacon_GetBeaconState( entity beacon, int team = -1 )
{
	if ( !ReusableBeacon_IsValidReusableMapBeacon( beacon ) )
	{
		Assert( false, "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " is going to return eReusableRespawnBeaconState.INVALID due to beacon being invalid or an unsupported type" )
		return eReusableRespawnBeaconState.INVALID
	}

	entity beaconWaypoint = ReusableBeacon_GetBeaconWaypointForBeaconEnt( beacon )
	if ( !IsValid( beaconWaypoint ) || beaconWaypoint.GetWaypointCustomType() != WAYPOINT_REUSABLE_RESPAWNBEACON )
		return eReusableRespawnBeaconState.INVALID

	int beaconState = eReusableRespawnBeaconState.INVALID

	if ( ReusableBeacon_AreTeamBasedReusableRespawnBeaconUsesEnabled() )
		beaconState = ReusableBeacon_GetTeamBeaconStateFromWaypoint( beaconWaypoint, team )
	else
		beaconState = beaconWaypoint.GetWaypointInt( WAYPOINT_INT_IDX_BEACON_STATE )

	return beaconState
}

































int function ReusableBeacon_GetTeamBeaconStateFromWaypoint( entity waypoint, int team )
{
	Assert( eReusableRespawnBeaconState._count == 4, "REUSABLE RESPAWN BEACON: The number of possible beacon states has changed, so the data layout for per team beacon states may need to change" )
	Assert( WAYPOINT_INT_MAX_TEAMS >= ABSOLUTE_MAX_TEAMS, "REUSABLE RESPAWN BEACON: The maximum number of beacon states that can be stored may be insufficient, so the data layout for per team beacon states may need to change" )

	if ( team < 0 || team >= ABSOLUTE_MAX_TEAMS )
		return eReusableRespawnBeaconState.INVALID

	int beaconStateBitOffset = team * WAYPOINT_INT_NUM_BITS_PER_BEACON_STATE
	int waypointIntIdx = beaconStateBitOffset / 32
	int waypointIntBitOffset = beaconStateBitOffset % 32

	int waypointInt = waypoint.GetWaypointInt( waypointIntIdx )
	
	waypointInt = waypointInt >> waypointIntBitOffset
	
	waypointInt = waypointInt & WAYPOINT_INT_BEACON_STATE_MASK

	return waypointInt
}






float function ReusableBeacon_GetRemainingCooldownDuration( entity beacon )
{
	float duration = UNSET_TIME

	if ( !ReusableBeacon_IsValidReusableMapBeacon( beacon ) )
	{
		Warning( "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " going to return UNSET_TIME because the Beacon was not valid or an unsupported type." )
		return duration
	}

	entity beaconWaypoint = ReusableBeacon_GetBeaconWaypointForBeaconEnt( beacon )
	if ( IsValid( beaconWaypoint ) && beaconWaypoint.GetWaypointCustomType() == WAYPOINT_REUSABLE_RESPAWNBEACON )
	{
		duration = max( 0.0, ( beaconWaypoint.GetWaypointFloat( WAYPOINT_FLOAT_IDX_RESPAWN_BEACON_COOLDOWN_END_TIME ) - Time() ) )
	}
#if DEV
	else
	{
		Warning( "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " going to return UNSET_TIME because the Beacon Waypoint was not valid." )
	}
#endif

	return duration
}






entity function ReusableBeacon_GetBeaconWaypointForBeaconEnt( entity beacon )
{
	if ( !ReusableBeacon_IsValidReusableMapBeacon( beacon ) )
	{
		Assert( false, "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " is going to return null due to beacon that is invalid or an unsupported type" )
		return null
	}

	entity beaconWaypoint
	if ( beacon in file.reusableBeaconEntToWaypointTable )
	{
		beaconWaypoint = file.reusableBeaconEntToWaypointTable[ beacon ]
	}

	if ( !IsValid( beaconWaypoint ) )
	{
		Assert( false, "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " failed to get beacon waypoint from file.reusableBeaconEntToWaypointTable, going to return null" )
		return null
	}

	if ( beaconWaypoint.GetWaypointCustomType() != WAYPOINT_REUSABLE_RESPAWNBEACON )
	{
		Assert( false, "REUSABLE RESPAWN BEACON: " + FUNC_NAME() + " beacon waypoint assigned to " + beacon + " is not the correct waypoint type, expect: " + WAYPOINT_REUSABLE_RESPAWNBEACON + " type is: " + beaconWaypoint.GetWaypointCustomType() + " , going to return null" )
		return null
	}

	return beaconWaypoint
}






void function ReusableBeacon_ServerCallback_OnBeaconStateChanged( entity beacon, int newValue )
{
	ReusableBeacon_UpdateBeaconState( beacon, newValue )
}






void function ReusableBeacon_ServerCallback_OnBeaconShouldBlink( entity beacon )
{
	thread ReusableBeacon_BlinkMapIconsForBeacon_Thread( beacon )
}






void function ReusableBeacon_UpdateBeaconStateOnClient_Thread( entity beacon )
{
	if ( !IsValid( beacon ) )
		return

	Assert( IsNewThread(), "Must be threaded off" )

	beacon.EndSignal( "OnDestroy" )

	WaitEndFrame()

	if ( beacon in file.reusableBeaconEntToWaypointTable )
	{
		entity viewPlayer = GetLocalViewPlayer()
		int beaconState = IsValid( viewPlayer ) ? ReusableBeacon_GetBeaconState( beacon, viewPlayer.GetTeam() ) : eReusableRespawnBeaconState.INVALID
		ReusableBeacon_UpdateBeaconState( beacon, beaconState )
	}
	else
	{
		Assert( false, "REUSABLE RESPAWN BEACON: Beacon Ent: " + beacon + " not already in reusableBeaconEntToWaypointTable when calling " + FUNC_NAME() )
	}
}





void function ReusableBeacon_BlinkMapIconsForBeacon_Thread( entity beacon )
{
	if ( !IsValid( beacon ) )
		return

	Assert( IsNewThread(), "Must be threaded off" )

	beacon.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( beacon )
		{
			if ( IsValid( beacon ) )
			{
				if ( beacon in file.beaconEntToMiniMapIconRuiTable )
				{
					var rui = file.beaconEntToMiniMapIconRuiTable[beacon]
					if ( rui != null && RuiIsAlive( rui ) )
					{
						RuiSetBoolIfExists( rui, "showPulseAnimation", false )
						RuiSetGameTimeIfExists( rui, "pulseAnimationStartime", RUI_BADGAMETIME )
					}
				}

				if ( beacon in file.beaconEntToFullMapIconRuiTable )
				{
					var rui = file.beaconEntToFullMapIconRuiTable[beacon]
					if ( rui != null && RuiIsAlive( rui ) )
					{
						RuiSetBoolIfExists( rui, "showPulseAnimation", false )
						RuiSetGameTimeIfExists( rui, "pulseAnimationStartime", RUI_BADGAMETIME )
					}
				}
			}
		}
	)

	
	if ( beacon in file.beaconEntToMiniMapIconRuiTable )
	{
		var rui = file.beaconEntToMiniMapIconRuiTable[beacon]
		RuiSetBoolIfExists( rui, "showPulseAnimation", true )
		RuiSetFloatIfExists( rui, "pulseAnimationTime", RESPAWN_DROP_TIME )
		RuiSetGameTimeIfExists( rui, "pulseAnimationStartime", ClientTime() )
	}

	
	if ( beacon in file.beaconEntToFullMapIconRuiTable )
	{
		var rui = file.beaconEntToFullMapIconRuiTable[beacon]
		RuiSetBoolIfExists( rui, "showPulseAnimation", true )
		RuiSetFloatIfExists( rui, "pulseAnimationTime", RESPAWN_DROP_TIME )
		RuiSetGameTimeIfExists( rui, "pulseAnimationStartime", ClientTime() )
	}

	wait RESPAWN_DROP_TIME
}





void function ReusableBeacon_UpdateMapIconsForBeacon( entity beacon, asset icon, bool setToDefault )
{
	
	if ( beacon in file.beaconEntToMiniMapIconRuiTable )
	{
		var rui = file.beaconEntToMiniMapIconRuiTable[beacon]

		if ( setToDefault )
		{
			RespawnChamber_SetMapIconsToDefaultState( beacon, rui )
		}
		else
		{
			RuiSetImage( rui, "defaultIcon", icon )
		}
	}

	
	if ( beacon in file.beaconEntToFullMapIconRuiTable )
	{
		var rui = file.beaconEntToFullMapIconRuiTable[beacon]
		if ( setToDefault )
		{
			RespawnChamber_SetMapIconsToDefaultState( beacon, rui )
		}
		else
		{
			RuiSetImage( rui, "defaultIcon", icon )
		}
	}
}





void function ReusableBeacon_DestroyInWorldIconForBeacon( entity beacon )
{
	if ( beacon in file.beaconEntToInWorldIconRuiTable )
	{
		var rui = file.beaconEntToInWorldIconRuiTable[ beacon ]
		if ( IsValid( rui ) )
			RuiDestroyIfAlive( rui )

		delete file.beaconEntToInWorldIconRuiTable[ beacon ]
	}
}



