void function MinimapPackage_SurveyBeacon( entity ent, var rui )
{
	RuiSetImage( rui, "defaultIcon", $"rui/hud/gametype_icons/survival/survey_beacon_only_pathfinder" )
	RuiSetImage( rui, "clampedDefaultIcon", $"" )
	RuiSetBool( rui, "useTeamColor", false )
}

void function FullmapPackage_SurveyBeacon( entity ent, var rui )
{
	MinimapPackage_SurveyBeacon( ent, rui )
	RuiSetFloat2( rui, "iconScale", <1.5,1.5,0.0> )
	RuiSetFloat3( rui, "iconColor", <0.5,0.5,0.5> )
}


void function SurvivalDeathfield_SetDeathfieldFXSettings( SurvivalDeathfieldFXSettings customDeathfieldFXSettings )
{
	Assert( (file.customDeathfieldFXSettings.colorCorrection.len() == 0) && (customDeathfieldFXSettings.colorCorrection.len() != 0), "Color Correction needs to be provided for customDeathfieldFXSettings" )
	file.customDeathfieldFXSettings.colorCorrection = customDeathfieldFXSettings.colorCorrection

	Assert( (file.customDeathfieldFXSettings.deathfieldEffect == $"") && (customDeathfieldFXSettings.deathfieldEffect != $""), "Deathfield FX needs to be provided for customDeathfieldFXSettings" )
	file.customDeathfieldFXSettings.deathfieldEffect = customDeathfieldFXSettings.deathfieldEffect

	Assert( (file.customDeathfieldFXSettings.observerDeathfieldEffect == $"") && (customDeathfieldFXSettings.observerDeathfieldEffect != $""), "Observer Deathfield FX needs to be provided for customDeathfieldFXSettings" )
	file.customDeathfieldFXSettings.observerDeathfieldEffect = customDeathfieldFXSettings.observerDeathfieldEffect

	file.customDeathfieldFXSettings.deathfieldInnerOpacityFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldInnerOpacityFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerOpacityFxIdx )
	file.customDeathfieldFXSettings.deathfieldOuterOpacityFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldOuterOpacityFxIdx.extend( customDeathfieldFXSettings.deathfieldOuterOpacityFxIdx )

	file.customDeathfieldFXSettings.deathfieldInnerPreciseFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldInnerPreciseFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerPreciseFxIdx )
	file.customDeathfieldFXSettings.deathfieldOuterPreciseFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldOuterPreciseFxIdx.extend( customDeathfieldFXSettings.deathfieldOuterPreciseFxIdx )

	file.customDeathfieldFXSettings.deathfieldInnerFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldInnerFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerFxIdx )
	file.customDeathfieldFXSettings.deathfieldOuterFxIdx.clear()
	file.customDeathfieldFXSettings.deathfieldOuterFxIdx.extend( customDeathfieldFXSettings.deathfieldOuterFxIdx )

	file.customDeathfieldFXSettings.fxTransitionTime = customDeathfieldFXSettings.fxTransitionTime


		{
			if ( file.ringOpacityOverrideEnabled )
			{
				if ( customDeathfieldFXSettings.deathfieldInnerOpacityFxIdx.len() != 0 )
				{
					file.deathFieldFxIdx.clear()
					file.deathFieldFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerOpacityFxIdx )
				}

				if ( customDeathfieldFXSettings.deathfieldOuterOpacityFxIdx.len() != 0 )
				{
					file.deathFieldFxOuterIdx.clear()
					file.deathFieldFxOuterIdx.extend( customDeathfieldFXSettings.deathfieldOuterOpacityFxIdx )
				}
			}
			else if ( file.usePreciseRingFx )
			{
				if ( customDeathfieldFXSettings.deathfieldInnerPreciseFxIdx.len() != 0 )
				{
					file.deathFieldFxIdx.clear()
					file.deathFieldFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerPreciseFxIdx )
				}

				if ( customDeathfieldFXSettings.deathfieldOuterPreciseFxIdx.len() != 0 )
				{
					file.deathFieldFxOuterIdx.clear()
					file.deathFieldFxOuterIdx.extend( customDeathfieldFXSettings.deathfieldOuterPreciseFxIdx )
				}
			}
			else
			{
				if ( customDeathfieldFXSettings.deathfieldInnerFxIdx.len() != 0 )
				{
					file.deathFieldFxIdx.clear()
					file.deathFieldFxIdx.extend( customDeathfieldFXSettings.deathfieldInnerFxIdx )
				}

				if ( customDeathfieldFXSettings.deathfieldOuterFxIdx.len() != 0 )
				{
					file.deathFieldFxOuterIdx.clear()
					file.deathFieldFxOuterIdx.extend( customDeathfieldFXSettings.deathfieldOuterFxIdx )
				}
			}
		}

}














































































































































































































































































































































































































































































