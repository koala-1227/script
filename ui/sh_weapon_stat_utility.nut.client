void function Sh_InitWeaponStatUtility()
{





		AddCallback_EntitiesDidLoad( AttachmentStatData_EntitiesDidLoad )





}



WeaponStatData function WeaponStatData_GetStatForMod( entity weapon, LootData attachmentData, string statRef )
{
	WeaponStatData data

	LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )

	if ( !SURVIVAL_Loot_IsRefValid( weaponData.ref ) )
		return data

	array<string> currentlyEquipedAttachments = weapon.GetMods()
	data = WeaponStatData_GetStatForWeaponBetweenAttachments( weaponData.baseWeapon, currentlyEquipedAttachments, [attachmentData.ref], statRef )

	return data
}



array<WeaponStatData> function WeaponStatData_GetStatsForAllMods( entity weapon )
{
	array<WeaponStatData> changedStats = []

	if ( !IsValid( weapon ) )
		return changedStats

	LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )

	if ( !SURVIVAL_Loot_IsRefValid( weaponData.ref ) )
		return changedStats

	array<string> allMods = weapon.GetMods()

	array<string> listOfAttachments = []

	foreach ( mod in allMods )
	{
		if ( !DoesModExist( weapon, mod ) )
			continue

		listOfAttachments.append( mod )
	}

	changedStats = WeaponStatData_GetStatsForWeaponWithAttachments( weaponData.baseWeapon, listOfAttachments, DISPLAY_STAT_VALUE_NAMES_IN_GAME )

	return changedStats
}



array<WeaponStatData> function WeaponStatData_GetStatsDataForAttachment( entity weapon, LootData newAttachmentData, bool isNewAttachmentEquipped = false )
{
	array<WeaponStatData> changedStats = []

	if ( !SURVIVAL_Loot_IsRefValid( newAttachmentData.ref ) )
		return changedStats

	LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )

	if ( !SURVIVAL_Loot_IsRefValid( weaponData.ref ) )
		return changedStats

	array<string> currentlyEquippedAttachments = weapon.GetMods()
	array<string> newAttachments = clone currentlyEquippedAttachments
	array<string> newAttachmentsUpdated = clone newAttachments
	for ( int i = 0; i < newAttachments.len(); i++ )
	{
		string attachment = newAttachments[i]
		if ( !SURVIVAL_Loot_IsRefValid( attachment ) )
			continue

		LootData curAttachment = SURVIVAL_Loot_GetLootDataByRef( attachment )
		if ( curAttachment.attachmentType == newAttachmentData.attachmentType )
		{
			newAttachmentsUpdated.remove(i)

			if ( isNewAttachmentEquipped )
			{
				currentlyEquippedAttachments.remove( i ) 
			}

			break
		}
	}
	newAttachmentsUpdated.append( newAttachmentData.ref )

	changedStats = WeaponStatData_GetModifiedStatsForWeaponBetweenAttachments( weaponData.baseWeapon, currentlyEquippedAttachments, newAttachmentsUpdated, DISPLAY_STAT_VALUE_NAMES_IN_GAME )

	return changedStats
}



array<AttachmentStatData> function AttachmentStatData_GetAttachmentStatDataForAttachment_NoWeapon( LootData attachmentData )
{
	array<AttachmentStatData> stats = []

	if ( !SURVIVAL_Loot_IsRefValid( attachmentData.ref ) )
		return stats

	if ( attachmentData.ref in file.attachmentStatsByAttachmentRef )
	{
		stats = file.attachmentStatsByAttachmentRef[ attachmentData.ref ]
	}
	else
	{
		Warning( "%s Attachment %s not cached", WEAPON_STAT_UTILITY_DEBUG_PREFIX, attachmentData.ref )
	}

	return stats
}



AttachmentStatData function AttachmentStatData_GetExtraStatForAttachment( LootData attachmentData )
{
	return AttachmentStatData_GetExtraStatForAttachmentRef( attachmentData.ref )
}



AttachmentStatData function AttachmentStatData_GetExtraStatForWeapon( entity weapon )
{
	AttachmentStatData extraStat

	if ( !IsValid( weapon ) )
		return extraStat

	array<string> currentlyEquippedAttachments = weapon.GetMods()

	foreach ( attachmentRef in currentlyEquippedAttachments )
	{
		if ( !SURVIVAL_Loot_IsRefValid( attachmentRef ) )
		return extraStat

		if ( attachmentRef in STATS_BY_ATTACHMENT_EXTRA_STAT )
		{
			foreach ( statRef, isImprovedBool in STATS_BY_ATTACHMENT_EXTRA_STAT[ attachmentRef ] )
			{
				extraStat.statRef = statRef
				extraStat.statName = STAT_NAME_TO_LOCALIZATION_KEY[ statRef ]
				extraStat.isStatImproved = ( isImprovedBool )
			}
		}

	}

	return extraStat
}



void function BuildAndCacheStatsForAttachment_Internal()
{
	if ( file.hasAttachmentClientCacheLoaded )
		return

	array<string> allAttachments = GetWeaponMods_Global( EMPTY_WEAPON_REF )
	if ( allAttachments.len() == 0 )
	{
		Warning( "%s No attachments found to process", WEAPON_STAT_UTILITY_DEBUG_PREFIX )
		return
	}

	foreach ( attachmentRef in allAttachments )
	{
		if ( !SURVIVAL_Loot_IsRefValid( attachmentRef ) )
		{
			Warning( "%s Skipping attachment with invalid ref %s", WEAPON_STAT_UTILITY_DEBUG_PREFIX, attachmentRef )
			continue
		}

		if ( attachmentRef == "" )
		{
			Warning( "%s Skipping attachment with empty ref %s", WEAPON_STAT_UTILITY_DEBUG_PREFIX, attachmentRef )
			continue
		}
		file.attachmentStatsByAttachmentRef[ attachmentRef ] <- BuildDefaultBaseStatsForAttachment( attachmentRef )
	}

	file.hasAttachmentClientCacheLoaded = true
}



array<AttachmentStatData> function BuildDefaultBaseStatsForAttachment( string attachmentRef )
{
	
	array<AttachmentStatData> baseAttachmentStats = []

	array<WeaponStatData> weaponStatsForEmptyWeapon = WeaponStatData_GetModifiedStatsForWeaponBetweenAttachments( EMPTY_WEAPON_REF, [], [ attachmentRef ], DISPLAY_STAT_VALUE_NAMES_IN_GAME )

	foreach ( stat in weaponStatsForEmptyWeapon )
	{
		AttachmentStatData newAttachStat

		newAttachStat.statRef = stat.statRef
		newAttachStat.statName = stat.statName
		newAttachStat.isStatImproved = ( stat.linearStatValAdded > 0 ) 

		baseAttachmentStats.append( newAttachStat )
	}

	baseAttachmentStats.sort( SortAttachmentStatDataByPositiveToNegative )

	return baseAttachmentStats
}



void function AttachmentStatData_EntitiesDidLoad()
{
	BuildAndCacheStatsForAttachment_Internal()
}



bool function WeaponStatData_ShouldDisplayStats( LootData attachmentData )
{
	if ( attachmentData.ref in file.attachmentStatsByAttachmentRef )
		return true

	return false
}



bool function WeaponStatData_ShouldDisplayStatBars()
{
	return GetCurrentPlaylistVarBool( "streamlined_looting_bars_enabled", true )
}



string function GetStringForWeaponRange( LootData weaponData )
{
	string weaponRef = weaponData.baseWeapon
	if ( !SURVIVAL_Loot_IsRefValid( weaponRef ) )
	{
		Warning( "%s Not valid weapon ref, returning empty weapon range string: %s", WEAPON_STAT_UTILITY_DEBUG_PREFIX, weaponRef )
		return ""
	}

	float rangeIndex = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "stat_range" )

	if ( !( rangeIndex in RANGE_NUM_TO_LOCALIZATION_KEY ) )
	{
		Warning( "%s Not valid rangeIndex in weapon txt file, returning empty weapon range string: %s", WEAPON_STAT_UTILITY_DEBUG_PREFIX, weaponRef )
		return ""
	}

	return RANGE_NUM_TO_LOCALIZATION_KEY[ rangeIndex ]
}



string function GetAmmoTypeStringForStatsDisplay( LootData weaponData )
{
	string ammoString = ""

	if ( !SURVIVAL_Loot_IsRefValid( weaponData.ref ) )
	{
		Warning( "%s Not valid weapon ref, returning empty ammo type string: %s", WEAPON_STAT_UTILITY_DEBUG_PREFIX, weaponData.ref )
		return ammoString
	}

	if ( SURVIVAL_Loot_IsRefValid( weaponData.ammoType ) )
	{
		LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( weaponData.ammoType )
		ammoString = ammoData.pickupString
	}
	else if (  weaponData.tier == eLootTier.MYTHIC  )
	{
		if ( IsWeaponKeyFieldDefined( weaponData.baseWeapon, "ammo_pool_type" ) && weaponData.baseMods.contains( "crate") )
		{
			int ammoType = GetWeaponInfoFileKeyField_GlobalInt( weaponData.baseWeapon, "ammo_pool_type" )
			switch ( ammoType )
			{
			case eAmmoPoolType.bullet:
				return "#AMMO_TYPE_MYTHIC_BULLET"
			case eAmmoPoolType.highcal:
				return "#AMMO_TYPE_MYTHIC_HIGHCAL"
			case eAmmoPoolType.special:
				return "#AMMO_TYPE_MYTHIC_SPECIAL"
			case eAmmoPoolType.shotgun:
				return "#AMMO_TYPE_MYTHIC_SHOTGUN"
			case eAmmoPoolType.sniper:
				return "#AMMO_TYPE_MYTHIC_SNIPER"
			case eAmmoPoolType.arrows:
				return "#AMMO_TYPE_MYTHIC_ARROW"
			}
		}
	}
	else if ( GetWeaponInfoFileKeyField_GlobalInt( weaponData.baseWeapon, "ammo_pool_type" ) == eAmmoPoolType.arrows )
	{
		ammoString = "#SURVIVAL_PICKUP_ARROWS"
	}
	else if ( GetWeaponInfoFileKeyField_GlobalInt( weaponData.baseWeapon, "ammo_pool_type" ) == eAmmoPoolType.special )
	{
		ammoString = "#SURVIVAL_PICKUP_SPECIAL"
	}

	return ammoString
}



float function WeaponStatData_GetWeaponROF( string weaponRef, array<string> attachmentsRef )
{
	if ( weaponRef == "" )
		return 0

	float baseRof
	float rechamberTime
	float burstFireDelay
	float chargeTime 
	float chargeTimePostFire 
	int burstCount

	if ( attachmentsRef.len() > 0 )
	{
		baseRof = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "fire_rate" )
		rechamberTime = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "rechamber_time" )
		burstFireDelay = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "burst_fire_delay" )
		chargeTime = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "charge_time" )
		chargeTimePostFire = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "charge_cooldown_time_post_fire" )
		burstCount = GetWeaponInfoFileKeyField_WithMods_GlobalInt( weaponRef, attachmentsRef, "burst_fire_count" )
	}
	else
	{
		baseRof = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "fire_rate" )
		rechamberTime = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "rechamber_time" )
		burstFireDelay = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "burst_fire_delay" )
		chargeTime = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "charge_time" )
		chargeTimePostFire = GetWeaponInfoFileKeyField_GlobalFloat( weaponRef, "charge_cooldown_time_post_fire" )
		burstCount = GetWeaponInfoFileKeyField_GlobalInt( weaponRef, "burst_fire_count" )
	}

	burstCount = burstCount > 0 ? burstCount : 1
	float totalDelay = rechamberTime + burstFireDelay + chargeTimePostFire

	float finalRof = ( 60 / ( ( burstCount / baseRof ) + totalDelay ) ) * burstCount
	return Round(finalRof, 0)
}

float function WeaponStatData_GetWeaponDamage( string weaponRef, array<string> attachmentsRef )
{
	if ( weaponRef == "" )
		return 0

	float projectilesPerShot = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "projectiles_per_shot" )
	float damageNearValue = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "damage_near_value" )

	if ( projectilesPerShot < 0 || damageNearValue < 0 )
	{
		Warning( "Missing values for calculating damage for weapon ref: " + weaponRef )
		return -1
	}

	return projectilesPerShot * damageNearValue
}

float function WeaponStatData_GetWeaponHeadshotDamage( string weaponRef, array<string> attachmentsRef )
{
	
	
	float projectilesPerShot = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "projectiles_per_shot" )
	float damageNearValue = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "damage_near_value" )
	float headshotScale = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "damage_headshot_scale" )

	if ( damageNearValue < 0 || headshotScale < 0 || projectilesPerShot < 0 )
	{
		Warning( "Missing values for calculating damage_headshot for weapon ref: " + weaponRef )
		return -1
	}

	return Round(damageNearValue * headshotScale, 0) * projectilesPerShot

}

float function WeaponStatData_GetWeaponMagSize( string weaponRef, array<string> attachmentsRef )
{
	float magSize = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "ammo_clip_size" )
	bool usesAmmoPool = GetWeaponInfoFileKeyField_GlobalBool( weaponRef, "uses_ammo_pool" )
	bool usesClips = magSize > 0

	if ( !usesAmmoPool && !usesClips )
		return GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "ammo_stockpile_max" )

	if ( attachmentsRef.contains( AKIMBO_ACTIVE_MOD ) )
		return magSize * 2 

	return magSize
}

float function WeaponStatData_GetWeaponReloadTime( string weaponRef, array<string> attachmentsRef )
{
	float reloadTime = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "reloadempty_time" )
	bool isSegmented = GetWeaponInfoFileKeyField_GlobalBool( weaponRef, "reload_is_segmented" )

	if ( isSegmented )
	{
		
		float magSize = WeaponStatData_GetWeaponMagSize( weaponRef, attachmentsRef )
		float segmentTimeEnd = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "reloadsegmentempty_time_end" )
		float segmentTimeLoop = GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, "reloadsegment_time_loop" )

		switch ( weaponRef )
		{
			case "mp_weapon_mastiff_crate":
			case "mp_weapon_mastiff":
				reloadTime = reloadTime + (segmentTimeLoop * (magSize - 2)) + segmentTimeEnd
				break
			case "mp_weapon_3030_crate":
			case "mp_weapon_3030":
				reloadTime = reloadTime + ((segmentTimeLoop * 0.85) * (magSize - 2))  + segmentTimeEnd
				break
		}
	}

	return reloadTime
}


AttachmentStatData function AttachmentStatData_GetExtraStatForAttachmentRef( string attachmentRef )
{
	AttachmentStatData extraStat

	if ( !SURVIVAL_Loot_IsRefValid( attachmentRef ) )
		return extraStat

	if ( attachmentRef in STATS_BY_ATTACHMENT_EXTRA_STAT )
	{
		foreach ( statRef, isImprovedBool in STATS_BY_ATTACHMENT_EXTRA_STAT[ attachmentRef ] )
		{
			extraStat.statRef = statRef
			extraStat.statName = STAT_NAME_TO_LOCALIZATION_KEY[ statRef ]
			extraStat.isStatImproved = ( isImprovedBool )
		}
	}

	return extraStat
}



WeaponBaseStatData function GetBaseStatForWeaponWithAttachments( string weaponRef, array<string> attachmentsRef, string statRef )
{
	WeaponBaseStatData data
	data.statRef = statRef
	data.statName = STAT_NAME_TO_LOCALIZATION_KEY[ statRef ]
	data.statShortName = STAT_SHORT_NAME_TO_LOCALIZATION_KEY[ statRef ]
	data.statUnitShortLocKey = GetStatUnitShortLocKeyForStatRef( statRef )

	data.statValue = GetWeaponStatValue_WithMods( weaponRef, attachmentsRef, statRef )
	return data
}

array<WeaponBaseStatData> function GetBaseStatsForWeaponWithAttachments( string weaponRef, array<string> attachmentsRef, array<string> statRefs )
{
	array<WeaponBaseStatData> stats
	foreach ( stat in statRefs )
	{
		WeaponBaseStatData data = GetBaseStatForWeaponWithAttachments( weaponRef, attachmentsRef, stat )
		if ( data.statValue < 0 )
			continue
		stats.append( data )
	}
	return stats
}

WeaponStatData function WeaponStatData_GetStatForWeaponBetweenAttachments( string weaponRef, array<string> currentAttachmentsRef, array<string> newAttachmentsRef, string statRef )
{
	WeaponBaseStatData baseData = GetBaseStatForWeaponWithAttachments( weaponRef, currentAttachmentsRef, statRef )

	WeaponStatData data
	data.statRef = statRef
	data.statName = baseData.statName
	data.statShortName = baseData.statShortName
	data.statUnitShortLocKey = baseData.statUnitShortLocKey

	data.newStatValue = GetWeaponStatValue_WithMods( weaponRef, newAttachmentsRef, statRef )
	data.previousStatValue = baseData.statValue
	data.statValAdded = data.newStatValue - data.previousStatValue

	data.linearNewVal = GetLinearStatValue( statRef, data.newStatValue )
	data.linearPreviousVal = GetLinearStatValue( statRef, data.previousStatValue )
	data.linearStatValAdded = data.linearNewVal - data.linearPreviousVal

	return data
}


array<WeaponStatData> function WeaponStatData_GetStatsForWeaponBetweenAttachments( string weaponRef, array<string> currentAttachmentsRef, array<string> newAttachmentsRef, array<string> statRefs )
{
	array<WeaponStatData> stats

	foreach ( statRef in statRefs )
	{
		WeaponStatData data = WeaponStatData_GetStatForWeaponBetweenAttachments( weaponRef, currentAttachmentsRef, newAttachmentsRef, statRef )
		stats.append( data )
	}

	return stats
}


array<WeaponStatData> function WeaponStatData_GetModifiedStatsForWeaponBetweenAttachments( string weaponRef, array<string> currentAttachmentsRef, array<string> newAttachmentsRef, array<string> statRefs )
{
	array<WeaponStatData> moddedStats

	foreach ( statRef in statRefs )
	{
		WeaponStatData data = WeaponStatData_GetStatForWeaponBetweenAttachments( weaponRef, currentAttachmentsRef, newAttachmentsRef, statRef )

		if ( data.previousStatValue == data.newStatValue )
			continue

		moddedStats.append( data )
	}

	return moddedStats
}


array<WeaponStatData> function WeaponStatData_GetStatsForWeaponWithAttachments( string weaponRef, array<string> attachmentsRef, array<string> statRefs )
{
	return WeaponStatData_GetStatsForWeaponBetweenAttachments( weaponRef, [], attachmentsRef, statRefs )
}


float function GetWeaponStatValue_WithMods( string weaponRef, array<string> attachmentsRef, string statRef )
{
	
	switch ( statRef )
	{
		case "fire_rate":
			return WeaponStatData_GetWeaponROF( weaponRef, attachmentsRef )
		case "damage_near_value":
			return WeaponStatData_GetWeaponDamage( weaponRef, attachmentsRef )
		case "damage_headshot":
			return WeaponStatData_GetWeaponHeadshotDamage( weaponRef, attachmentsRef )		
		case "ammo_clip_size":
			return WeaponStatData_GetWeaponMagSize( weaponRef, attachmentsRef )		
		case "reloadempty_time":
			return WeaponStatData_GetWeaponReloadTime( weaponRef, attachmentsRef )
	}

	return GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( weaponRef, attachmentsRef, statRef )
}


float function GetWeaponInfoFileKeyField_WithMods_Global_ToFloat( string weaponRef, array<string> attachmentsRef, string statRef )
{
	var statValue = GetWeaponInfoFileKeyField_WithMods_Global( weaponRef, attachmentsRef, statRef )

	if ( statValue == null )
	{
		Warning( "Stat ref: " + statRef + " not found for weapon ref: " + weaponRef )
		return -1
	}

	if ( IsFloat( statValue ) )
	{
		return expect float(statValue)
	}
	else if ( IsInt( statValue ) )
	{
		return float( expect int(statValue) )
	}

	Warning( "Stat value for " + statRef + " is not a number." )
	return -1
}

float function GetLinearStatValue( string statRef, float statValue )
{
	Assert( statRef in file.statMaxValues, "Missing max stat value for stat ref: " + statRef )

	float normalizedValue = statValue / file.statMaxValues[ statRef ]

	if ( INVERSED_STATS.contains( statRef ) )
		return 1.0 - normalizedValue

	return normalizedValue
}

string function GetWeaponRefByItemFlavor_Internal( ItemFlavor weapon )
{
	if ( ItemFlavor_GetType( weapon ) != eItemType.loot_main_weapon )
		return ""


		if ( WeaponItemFlavor_HasTakeover( weapon ) )
		{
			string takeoverClassname = WeaponItemFlavor_GetTakeoverClassname( weapon )
			if ( takeoverClassname != "" )
				return takeoverClassname
		}


	return WeaponItemFlavor_GetClassname( weapon )
}

string function GetStatUnitShortLocKeyForStatRef( string statRef )
{
	if ( statRef in STAT_NAME_TO_UNIT_SHORT_LOC_KEY )
		return STAT_NAME_TO_UNIT_SHORT_LOC_KEY[ statRef ]

	return "%s1" 
}



int function SortAttachmentStatDataByPositiveToNegative( AttachmentStatData a, AttachmentStatData b )
{
	if ( a.isStatImproved && !b.isStatImproved )
		return -1

	if ( !a.isStatImproved && b.isStatImproved )
		return 1

	return 0
}

























































































































































































