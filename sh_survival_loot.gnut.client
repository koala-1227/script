	string autoLootSuppressedTypes = GetCurrentPlaylistVarString( "loot_pickup_hud_feed_autoloot_suppressed_loot_types", "" )
	array<string> autoLootSuppressedTypeTokens = split( autoLootSuppressedTypes, WHITESPACE_CHARACTERS )
	foreach ( string lootTypeToken in autoLootSuppressedTypeTokens )
	{
		string normalizedLootTypeToken = strip( lootTypeToken ).toupper()
		if ( normalizedLootTypeToken == "" )
			continue

		if ( normalizedLootTypeToken in eLootType )
		{
			file.lootPickupHudFeed_AutoLootSuppressedTypes[ eLootType[ normalizedLootTypeToken ] ] <- 1
		}
		else
		{
			Warning( "%s Invalid loot type in loot_pickup_hud_feed_autoloot_suppressed_loot_types: %s", FUNC_NAME(), normalizedLootTypeToken )
		}
	}
}

array< AttachmentData > function ReadAttachmentDataFromMatrix( var matrix, array< LootData > weapons )
{
	int amRowCount = GetDataTableRowCount( matrix )
	array< AttachmentData > result

	for ( int i = 0; i < amRowCount; i++ )
	{
		string attachmentName = GetDataTableString( matrix, i, GetDataTableColumnByName( matrix, "attachmentName" ) )

		AttachmentData aData
		aData.ref = attachmentName
		aData.attachPoints = split( GetDataTableString( matrix, i, GetDataTableColumnByName( matrix, "attachmentPoint" ) ), WHITESPACE_CHARACTERS )

		if ( SURVIVAL_Loot_IsRefValid( aData.ref ) && !SURVIVAL_Loot_IsRefDisabled( aData.ref ) )
		{
			foreach ( LootData data in weapons )
			{
				string weaponRef = data.baseWeapon
				if ( aData.compatibleWeapons.contains( weaponRef ) )
					continue

				Assert( !IsAttachmentAmbiguousForWeapon( aData.ref, data.ref, aData.attachPoints ) )

				int col = GetDataTableColumnByName( matrix, weaponRef )
				if ( col == -1 ) 
				{
					string baseWeapon = Weapon_GetBaseClassNameOrEmpty( weaponRef )
					if ( baseWeapon != "" ) 
					{
						col = GetDataTableColumnByName( matrix, baseWeapon )
						if ( col == -1 ) 
							continue
					}
					else
						continue
				}

				bool attachmentIsEnabled = GetDataTableBool( matrix, i, col )

				foreach ( string attachPoint in aData.attachPoints )
				{
					if ( attachmentIsEnabled && data.supportedAttachments.contains( attachPoint ) )
					{
						aData.compatibleWeapons.append( weaponRef )
						aData.compatibleWeaponSet[ weaponRef ] <- 1
					}
				}
			}
		}

		result.append( aData )
	}

	return result
}

bool function IsWeaponSlot( string slot )
{
	foreach( weaponSlot in WEAPON_SLOT_NAMES )
	{
		if( weaponSlot == slot )
			return true
	}

	return false
}

int function GetPlayerPrimaryWeaponNetvar( entity player, int slot )
{
	Assert( IsValidPlayer( player ) )
	string weaponIndexNetIntName = "playerPrimaryWeapon" + string( slot )
	int index = player.GetPlayerNetInt( weaponIndexNetIntName )

	if ( index == NETVAR_UNSIGNED_INT_MAX )
	{
		index = -1
	}
	return index
}























string function PVAR_GetAttachmentMatrixOverrideTableString()
{
	return GetCurrentPlaylistVarString( "weapon_attachment_matrix_override_table", "" )
}

asset ornull function GetAttachmmentMatrixOverrideTableAsset()
{
	return SURVIVAL_Loot_GetLootOverrideTableAsset( PVAR_GetAttachmentMatrixOverrideTableString() )
}

void function InitAttachmentData()
{
	var attachmentMatrix = GetDataTable( $"datatable/weapon_attachment_matrix.rpak" )
	int amRowCount       = GetDataTableRowCount( attachmentMatrix )

	array<LootData> allWeapons = SURVIVAL_Loot_GetByType( eLootType.MAINWEAPON )

	table< string, array<string> > weaponsByClass
	foreach ( LootData wData in allWeapons )
	{
		if ( !(wData.lootTags[0] in weaponsByClass) )
			weaponsByClass[wData.lootTags[0]] <- []

		if ( WeaponLootRefIsLockedSet( wData.ref ) )
			continue

		if ( wData.baseMods.contains ( "crate" ) )
			continue

		foreach ( callback in file.preWeaponAttachmentInit )
		{
			callback( wData )
		}

		if ( wData.supportedAttachments.len() == 0 )
			continue

		if ( SURVIVAL_Loot_IsRefDisabled( wData.ref ) )
			continue

		
		if ( wData.floorSpawnCategory != eFloorSpawnCategory.CORE )
			continue

		weaponsByClass[wData.lootTags[0]].append( wData.ref )
	}

	array< AttachmentData > attachmentData = ReadAttachmentDataFromMatrix( attachmentMatrix, allWeapons )
	foreach ( AttachmentData aData in attachmentData )
	{
		file.attachmentMatrix[aData.ref] <- aData
	}

	asset ornull attachmentOverrideTableAsset = GetAttachmmentMatrixOverrideTableAsset()
	if ( attachmentOverrideTableAsset != null )
	{
		expect asset( attachmentOverrideTableAsset )
		array< AttachmentData > attachmentOverrideData = ReadAttachmentDataFromMatrix( GetDataTable( attachmentOverrideTableAsset ), allWeapons )
		foreach( AttachmentData aData in attachmentOverrideData )
		{
			file.attachmentMatrix[aData.ref] <- aData
		}
	}

	bool debugAttachments = false

	
	foreach ( aData in file.attachmentMatrix )
	{
		foreach ( string attachPoint in aData.attachPoints )
		{
			if ( attachPoint == "mag" ) 
			{
				foreach ( weaponClass, weaponList in weaponsByClass )
				{
					foreach ( weaponRef in weaponList )
					{
						if ( aData.compatibleWeapons.contains( weaponRef ) )
						{
							LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
							if ( weaponData.ammoType != "" && weaponData.baseWeapon != "mp_weapon_car" ) 
							{
								aData.tagData.ammoRef = weaponData.ammoType
								if ( !aData.tagData.multiAmmoRefs.contains( weaponData.ammoType ) )
								{
									aData.tagData.multiAmmoRefs.append( weaponData.ammoType )
								}
							}
						}
					}
				}
			}
			else
			{
				array<int> attachmentTags       = []
				
				int mostExceptions = 0

				foreach ( weaponClass, weaponList in weaponsByClass )
				{
					array<string> attachableWeapons = []
					string incompatibleWeapon = ""
					foreach ( weaponRef in weaponList )
					{
						if ( !aData.compatibleWeapons.contains( weaponRef ) )
						{
							if ( debugAttachments )
								printt( format( "Attachment %s: NOT compatible with weaponRef %s", aData.ref, weaponRef ) )

							incompatibleWeapon = weaponRef
						}
						else
						{
							if ( debugAttachments )
								printt( format( "Attachment %s: appending weaponRef %s", aData.ref, weaponRef ) )

							attachableWeapons.append( weaponRef )
						}
					}

					if ( attachableWeapons.len() == weaponList.len() && weaponList.len() != 0 )
					{
						if ( debugAttachments )
							printt( format( "Attachment %s: appending weaponClass %s", aData.ref, string(weaponClassToTag[weaponClass] ) ) )

						attachmentTags.append( weaponClassToTag[weaponClass] )
					}
					else if ( attachableWeapons.len() >= weaponList.len() / 2 ) 
					{
						if ( debugAttachments )
							printt( format( "Attachment %s: appending weaponClass as most %s", aData.ref, string(weaponClassToTag[weaponClass] ) ) )

						
						array<string> classesToSkip = ["melee", "launcher"]
						if ( !classesToSkip.contains( weaponClass ) )
						{
							attachmentTags.append( weaponClassToTag[weaponClass+"_most"] )
							mostExceptions++
						}
					}
					
					
					
					

					
					
				}

				bool supportsAll = attachmentTags.len() == weaponsByClass.len() && mostExceptions == 0

				if ( supportsAll )
					attachmentTags = [eAttachmentTag.ALL]

				aData.tagData.attachmentTags = attachmentTags
				
			}
		}
	}

	int attachRefCol = GetDataTableColumnByName( attachmentMatrix, "attachmentName" )
	Assert( attachRefCol != -1, "Attachment Ref column not found in weapon attachment matrix datatable" )
	foreach ( LootData wData in allWeapons )
	{
		if ( SURVIVAL_Loot_IsRefDisabled( wData.ref ) )
			continue

		int weaponCol = GetDataTableColumnByName( attachmentMatrix, wData.baseWeapon )
		if ( weaponCol == -1 )
			continue

		array< string > attachmentsToDisable
		foreach ( supportedAttachment in wData.supportedAttachments )
		{
			int matchingAttachments = 0
			foreach ( AttachmentData aData in file.attachmentMatrix )
			{
				string attachmentRef = aData.ref
				if ( !SURVIVAL_Loot_IsRefValid( attachmentRef) || SURVIVAL_Loot_IsRefDisabled( attachmentRef ) )
					continue

				string attachPoint = GetAttachPointForAttachmentOnWeapon_Fast( wData, aData)

				if ( attachPoint != supportedAttachment )
					continue

				bool attachmentIsEnabled = aData.compatibleWeapons.contains( wData.baseWeapon )
				if ( attachmentIsEnabled )
					matchingAttachments += 1
			}

			if ( matchingAttachments == 0 )
			{
				attachmentsToDisable.append( supportedAttachment )
			}
		}

		foreach ( attachmentToDisable in attachmentsToDisable )
		{
			wData.supportedAttachments.removebyvalue( attachmentToDisable )
			wData.disabledAttachments.append( attachmentToDisable )
		}

		foreach ( callback in file.postWeaponAttachmentInit )
		{
			callback( wData )
		}
	}
}









































































