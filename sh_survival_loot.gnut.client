void function Survival_AddLockedInventoryCallback( entity player, array< LockedInventoryData > functionref( entity, array< LockedInventoryData > ) lockedInventoryCallback )
{










		Assert( !file.lockedInventoryCallbacks.contains( lockedInventoryCallback ), "You cannot add the same locked inventory callback twice" )
		file.lockedInventoryCallbacks.append( lockedInventoryCallback )


	Survival_UpdateLockedInventoryPositions( player )
}

void function Survival_RemoveLockedInventoryCallback( entity player, array< LockedInventoryData > functionref( entity, array< LockedInventoryData > ) lockedInventoryCallback )
{













		if ( file.lockedInventoryCallbacks.contains( lockedInventoryCallback ) )
		{
			file.lockedInventoryCallbacks.fastremovebyvalue( lockedInventoryCallback )

			Survival_UpdateLockedInventoryPositions( player )
		}

}

void function Survival_UpdateLockedInventoryPositions( entity player )
{
	Assert( !Augments_GetInfAmmoAugReworkEnabled() )
	if ( !Augments_GetInfAmmoAugReworkEnabled() )
		return

	if ( !IsValid( player ) )
		return













		array< LockedInventoryData > allLockedSlots
		foreach ( lockedInventoryCallback in file.lockedInventoryCallbacks )
		{
			allLockedSlots.extend( lockedInventoryCallback( player, allLockedSlots ) )
		}

		file.inventoryLockedPositionsMap.clear()


	foreach ( lockedData in allLockedSlots )
	{



			file.inventoryLockedPositionsMap[lockedData.slot] <- lockedData

	}

	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player, true )

	foreach ( lockedData in allLockedSlots )
	{
#if DEV
		if ( LOCKED_INV_EMPTY_SLOT_DEBUG && lockedData.slot == -1 )
		{
			printt( "Locked Inv Debug: Tried checking a locked slot with slot idx -1, this will crash.")
		}
#endif
		if ( lockedData.isEmptySlot && lockedData.slot < playerInventory.len() && playerInventory[lockedData.slot].type == lockedData.lootIdx && playerInventory[lockedData.slot].count > 0 )
		{
			lockedData.isEmptySlot = false
		}
	}
}


void function RectifyLockedSlotPositions_Internal( entity player )
{













		table< int, LockedInventoryData > lockedPositionsClone

		foreach ( lockedData in file.inventoryLockedPositionsMap.clonevalues() )
		{
			lockedPositionsClone[lockedData.slot] <- lockedData
		}

		file.inventoryLockedPositionsMap = lockedPositionsClone

}

bool function Survival_GetInventoryPositionLocked( entity player, int position )
{



		return position in file.inventoryLockedPositionsMap

}

int function Survival_GetInventoryPositionLockedReason( entity player, int position )
{






		if ( !( position in file.inventoryLockedPositionsMap ) )
			return eLockedInventoryReason.NOT_LOCKED

		return file.inventoryLockedPositionsMap[position].lockedReason

}

table< int, LockedInventoryData > function Survival_GetAllLockedInventoryData( entity player )
{
	table< int, LockedInventoryData > lockedData
	if ( !IsValid( player ) )
		return lockedData







		return file.inventoryLockedPositionsMap

}

LockedInventoryData function Survival_GetLockedInventoryDataForSlot( entity player, int position )
{
	LockedInventoryData notLockedData
	notLockedData.lockedReason = eLockedInventoryReason.NOT_LOCKED
	if ( !IsValid( player ) )
		return notLockedData







		if ( !( position in file.inventoryLockedPositionsMap ) )
			return notLockedData

		return file.inventoryLockedPositionsMap[position]

}

array< LockedInventoryData > function Survival_GetAllEmptyLockedInventoryData( entity player )
{
	array< LockedInventoryData > emptyLockedData
	if ( !IsValid( player ) )
		return emptyLockedData







		table< int, LockedInventoryData > inventoryLockedPositionsMap = file.inventoryLockedPositionsMap


	foreach ( lockedData in inventoryLockedPositionsMap.clonevalues() )
	{
		if ( lockedData.isEmptySlot )
		{
			emptyLockedData.append( lockedData )
		}
	}

	return emptyLockedData
}

#if DEV
void function DEV_PrintAllLootRefsWithNames()
{
	array<string> pickupString   = []
	array<string> tier           = []
	array<string> ref            = []
	array<string> type			 = []

	int pickupStringLen   = 0
	int tierLen           = 0
	int refLen            = 0
	int typeLen           = 0

	printt( "-------------- ALL LOOT --------------" )
	foreach ( string name, LootData data in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( name == "blank" )
			continue

		string _pickupString = Localize( data.pickupString )
		string _type         = GetEnumString( "eLootType", data.lootType ) 
		string _tier = ""
		switch ( data.tier )
		{
			case 1:
				_tier = "WHITE"
				break
			case 2:
				_tier = "BLUE"
				break
			case 3:
				_tier = "PURPLE"
				break
			case 4:
				_tier = "GOLD"
				break
			case 5:
				_tier = "RED"
				break
			default:
				_tier = "NONE"
		}
		string _ref			 = name

		ref.append( _ref )
		pickupString.append( _pickupString )
		tier.append( _tier )
		type.append( _type )

		if ( _ref.len() > refLen )
			refLen = _ref.len()
		if ( _pickupString.len() > pickupStringLen )
			pickupStringLen = _pickupString.len()
		if ( _tier.len() > tierLen )
			tierLen = _tier.len()
		if ( _type.len() > typeLen )
			typeLen = _type.len()
	}

	Assert( type.len() == ref.len() && pickupString.len() == ref.len() && type.len() == ref.len() )

	ref.insert( 0, "LOOT REF" )
	pickupString.insert( 0, "GAME NAME" )
	type.insert( 0, "TYPE" )
	tier.insert( 0, "TIER" )

	for ( int i = 0 ; i < ref.len() ; i++ )
	{
		string _ref            = ref[i]
		string _pickupString   = pickupString[i]
		string _tier           = tier[i]
		string _type           = type[i]

		while( _ref.len() < refLen )
			_ref += " "
		while( _pickupString.len() < pickupStringLen )
			_pickupString += " "
		while( _tier.len() < tierLen )
			_tier += " "
		while( _type.len() < typeLen )
			_type += " "

		printl( format( "%s  %s  %s  %s", _pickupString, _ref, _tier, _type ) )
	}

	printt( "-------------- END LOOT --------------" )
}
#endif



















