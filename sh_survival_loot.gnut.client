int function SURVIVAL_GetTitanWeaponStoreCount( entity weapon )
{
	if ( weapon.IsChargeWeapon() )
	{
		return int( (1.0 - weapon.GetWeaponChargeFraction()) * 100.0 )
	}

	return weapon.GetWeaponPrimaryClipCount()
}

bool function Survival_IsAmmoCompatibleWithCurrentWeapons( entity player, string ammoRef )
{
	foreach ( entity weapon in SURVIVAL_GetPrimaryWeaponsIncludingSling( player ) )
	{
		string weaponRef = weapon.GetWeaponClassName()
		if ( SURVIVAL_Loot_IsRefValid( weaponRef ) && IsWeaponKeyFieldDefined( weaponRef, "ammo_pool_type" ) )
		{
			string primaryAmmoType = GetWeaponAmmoType( weaponRef )
			string secondaryAmmoType
			if ( IsWeaponKeyFieldDefined( weaponRef, "secondary_ammo_pool_type" ) )
			{
				secondaryAmmoType = GetWeaponInfoFileKeyField_GlobalString( weaponRef, "secondary_ammo_pool_type" )
			}

			if ( !GetWeaponInfoFileKeyField_GlobalBool( weaponRef, "uses_ammo_pool" ) && ammoRef == AmmoType_GetRefFromIndex(GetWeaponInfoFileKeyField_GlobalInt( weaponRef, "ammo_pool_type" ) ) )
			{
				return true
			}

			if ( primaryAmmoType == ammoRef || secondaryAmmoType == ammoRef )
			{
				return true
			}
		}
	}
	return false
}

int function Survival_GetAmmoForStockpileWeapon( entity player, string ammoRef )
{
	int totalAmmo = 0
	foreach ( entity weapon in SURVIVAL_GetPrimaryWeaponsIncludingSling( player ) )
	{
		string weaponRef = weapon.GetWeaponClassName()
		if ( SURVIVAL_Loot_IsRefValid( weaponRef ) && IsWeaponKeyFieldDefined( weaponRef, "ammo_pool_type" ) )
		{
			if ( !GetWeaponInfoFileKeyField_GlobalBool( weaponRef, "uses_ammo_pool" ) && ammoRef == AmmoType_GetRefFromIndex(GetWeaponInfoFileKeyField_GlobalInt( weaponRef, "ammo_pool_type" ) ) )
			{
				totalAmmo += GetWeaponAmmoCount( weapon )
			}
		}
	}
	return totalAmmo
}

int function Survival_GetMaxAmmoForStockpileWeapon( entity player, string ammoRef )
{
	int totalMaxAmmo = 0
	foreach ( entity weapon in SURVIVAL_GetPrimaryWeaponsIncludingSling( player ) )
	{
		string weaponRef = weapon.GetWeaponClassName()
		if ( SURVIVAL_Loot_IsRefValid( weaponRef ) && IsWeaponKeyFieldDefined( weaponRef, "ammo_pool_type" ) )
		{
			if ( !GetWeaponInfoFileKeyField_GlobalBool( weaponRef, "uses_ammo_pool" ) && ammoRef == AmmoType_GetRefFromIndex(GetWeaponInfoFileKeyField_GlobalInt( weaponRef, "ammo_pool_type" ) ) )
			{
				totalMaxAmmo += weapon.GetWeaponSettingInt( eWeaponVar.ammo_stockpile_max )
			}
		}
	}
	return totalMaxAmmo
}

string function GetWeaponAmmoType( string weaponName )
{
	if ( SURVIVAL_Loot_IsRefValid( weaponName ) )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByRef( weaponName )
		return data.ammoType
	}

	return ""
}

string function GetWeaponAmmoTypeFromWeaponEnt( entity weapon )
{
	string ammoType = ""

	if ( IsValid( weapon ) )
	{
		LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )

		if ( SURVIVAL_Loot_IsRefValid( weaponData.ref ) )
			ammoType = weaponData.ammoType
	}

	return ammoType
}

int function GetWeaponAmmoCount( entity weapon )
{
	if ( !IsValid( weapon ) )
		return -1

	if ( IsMeleeWeapon( weapon ) )
		return -1

	int ammoCount
	if ( weapon.IsWeaponX() ) 
	{
		entity owner = weapon.GetWeaponOwner()
		bool showAkimboCount

		if ( owner != GetLocalViewPlayer() )
		{
			showAkimboCount = false
		}
		else

		{
			showAkimboCount = weapon.IsAkimboAvailable() && !weapon.IsAkimboDisabled() && owner.GetAkimboState() != AKIMBO_STATE_OFFHAND;
		}

		if ( weapon.UsesClipsForAmmo() )
		{

			if ( !IsLocalViewPlayer( owner ) )
			{
				return -1
			}
			else

			{
				ammoCount = ( showAkimboCount ) ? weapon.GetAkimboSharedClipCount() :  weapon.GetWeaponPrimaryClipCount()
			}
		}
		else
		{
			int source = weapon.GetActiveAmmoSource()
			ammoCount = ( showAkimboCount ) ? weapon.GetWeaponAkimboSharedAmmoCount( source ) : weapon.GetWeaponPrimaryAmmoCount( source )
		}
	}
	else 
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( weapon.GetSurvivalInt() )
		if ( data.lootType != eLootType.MAINWEAPON )
			return -1

		ammoCount = weapon.GetClipCount()

		if ( ammoCount == -1 ) 
		{
			if ( GetWeaponInfoFileKeyField_GlobalInt( data.baseWeapon, "ammo_clip_size" ) > 0 )
				ammoCount = GetWeaponInfoFileKeyField_GlobalInt( data.baseWeapon, "ammo_clip_size" ) 
			else 
				ammoCount = GetWeaponInfoFileKeyField_GlobalInt( data.baseWeapon, "ammo_default_total" )
		}
	}

	return ammoCount
}

int function SURVIVAL_GetInventoryLimit( entity player )
{
	int limit  = 0
	int bpTier = EquipmentSlot_GetEquipmentTier( player, "backpack" )
	switch ( bpTier )
	{
		case 0:
			limit = SURVIVAL_BACKPACK_LIMIT
			break

		case 1:
			limit = SURVIVAL_BACKPACK_LIMIT_SMALL
			break

		case 2:
			limit = SURVIVAL_BACKPACK_LIMIT_MEDIUM
			break

		case 3:
		case 4:
			limit = SURVIVAL_BACKPACK_LIMIT_MAX
			break

		default:
			Assert( false, "invalid backpack tier " + bpTier )
			break
	}




















































		if ( ReservedInventory_IsEnabled() )
			limit = ReservedInventory_GetMaxBackpackSlots()

	return limit
}


int function SURVIVAL_GetMaxInventoryLimit( entity player )
{
	int limit = SURVIVAL_BACKPACK_LIMIT_MAX






		if ( ReservedInventory_IsEnabled() )
			limit = ReservedInventory_GetMaxBackpackSlots()


	return limit
}


int function SURVIVAL_GetInventoryCount( entity player )
{
	return SURVIVAL_GetPlayerInventory( player ).len()
}


int function SURVIVAL_CountSquaresInInventory( entity player, string ref )
{
	LootData data                                  = SURVIVAL_Loot_GetLootDataByRef( ref )
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
	int count                                      = 0
	foreach ( invItem in playerInventory )
	{
		if ( invItem.type == data.index )
		{
			count += 1
		}
	}

	return count
}


int function SURVIVAL_CountItemsInInventory( entity player, string ref )
{
	LootData data                                  = SURVIVAL_Loot_GetLootDataByRef( ref )
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
	int count                                      = 0






	foreach ( invItem in playerInventory )
	{
		if ( invItem.type == data.index )
		{
			count += invItem.count
		}
	}

	return count
}


entity function SURVIVAL_GetLastActiveWeapon( entity player, bool includeSling = false )
{
	array<entity> weapons
	if( includeSling )
		weapons = SURVIVAL_GetPrimaryWeaponsIncludingSling( player, true )
	else
		weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )

	entity weapon

	if ( weapons.len() > 0 )
		weapon = weapons[0]

	return weapon
}

entity function SURVIVAL_GetActiveWeaponEntity( entity player )
{
	if ( !IsValid( player ) )
		return null

	return player.GetActiveWeapon( eActiveInventorySlot.mainHand )
}

string function SURVIVAL_GetActiveWeapon( entity player )
{
	if ( IsValid( player.GetActiveWeapon( eActiveInventorySlot.mainHand ) ) )
		return player.GetActiveWeapon( eActiveInventorySlot.mainHand ).GetWeaponClassName()

	return ""
}


string function SURVIVAL_GetStowedWeapon( entity player )
{
	string equipmentSlotName
	int activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player )

	int stowedWeaponSlot = EquipmentSlot_GetOtherWeaponSlotInt( activeWeaponSlot )
	if ( stowedWeaponSlot == -1 )
		return ""

	equipmentSlotName = "main_weapon" + stowedWeaponSlot

	
	return EquipmentSlot_GetEquippedLootDataForSlot( player, equipmentSlotName ).ref
}


int function SURVIVAL_GetActiveWeaponSlot( entity player, bool includeSling = false )
{
	entity activeWeapon = SURVIVAL_GetLastActiveWeapon( player, includeSling )
	return GetSlotForWeapon( player, activeWeapon )
}


int function SURVIVAL_GetStowedWeaponSlot( entity player )
{
	int activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player )

	return activeWeaponSlot == SLING_WEAPON_SLOT ? player.GetLastCycleSlot() : EquipmentSlot_GetOtherWeaponSlotInt( activeWeaponSlot )
}


entity function GetOtherWeapon( entity weapon, entity player )
{
	if ( !IsValid( weapon ) )
		return null

	if ( !IsValid( player ) )
		return null

	int slot      = GetSlotForWeapon( player, weapon )
	int otherSlot = EquipmentSlot_GetOtherWeaponSlotInt( slot )
	if ( otherSlot < 0 )
		return null

	entity otherWeapon = player.GetNormalWeapon( otherSlot )
	if ( !IsValid( otherWeapon ) )
		return null

	return otherWeapon
}


int function SURVIVAL_CountItemsTypesInInventory( entity player, int lootType )
{
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
	int count                                      = 0
	foreach ( invItem in playerInventory )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( invItem.type )
		if ( data.lootType == lootType )
		{
			count += 1
		}
	}

	return count
}


array<ConsumableInventoryItem> function ClonePlayerInventory( array<ConsumableInventoryItem> inventory )
{
	array<ConsumableInventoryItem> newInv

	foreach ( item in inventory )
	{
		newInv.append( clone item )
	}

	return newInv
}

array<ConsumableInventoryItem> function SURVIVAL_GetPlayerInventory( entity player, bool forceLockedUpdate = false, bool avoidLockedUpdate = false )
{







	array<ConsumableInventoryItem> playerInventory = player.ConsumableInventory_Get()


	if ( !Augments_GetInfAmmoAugReworkEnabled() )
	{
		if ( !avoidLockedUpdate )
		{
			UpdateInventoryForEmptyLockedSlots( player, playerInventory, forceLockedUpdate )
		}
	}

	return playerInventory
}

void function UpdateInventoryForEmptyLockedSlots( entity player, array< ConsumableInventoryItem > playerInventory, bool forceLockedUpdate )
{
	Assert( !Augments_GetInfAmmoAugReworkEnabled() )
	if ( !Augments_GetInfAmmoAugReworkEnabled() )
		return

	
	
	
	
	array< LockedInventoryData > emptyLockedInventoryData = Survival_GetAllEmptyLockedInventoryData( player )
#if DEV
		if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
		{
			printt("Locked Inv Debug: STARTING")
			foreach ( lockedSlot in emptyLockedInventoryData )
			{
				printt( "Locked Inv Debug: found empty locked slot - " + lockedSlot.slot + ", lootIdx - " + lockedSlot.lootIdx + ", lockedReason - " + lockedSlot.lockedReason + ". isEmpty - "+ lockedSlot.isEmptySlot )
			}
		}
#endif
	if ( emptyLockedInventoryData.len() == 0 && !forceLockedUpdate )
		return

	table< int, LockedInventoryData > allLockedSlots = Survival_GetAllLockedInventoryData( player )
	int initialInventoryCount = playerInventory.len()

#if DEV
		if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
		{
			foreach ( lockedSlot in allLockedSlots.clonevalues() )
			{
				printt( "Locked Inv Debug: starting with locked slot - " + lockedSlot.slot + ", lootIdx - " + lockedSlot.lootIdx + ", lockedReason - " + lockedSlot.lockedReason + ". isEmpty - "+ lockedSlot.isEmptySlot )
			}
		}
#endif

	
	foreach ( lockedData in emptyLockedInventoryData )
	{
		ConsumableInventoryItem fakeInventoryData
		fakeInventoryData.type = lockedData.lootIdx
		fakeInventoryData.count = 0

#if DEV
			if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
			{
				printt("Locked Inv Debug: Trying to insert empty locked slot with lootIdx - " + lockedData.lootIdx + ", currently at slot " + lockedData.slot )
			}
#endif

		
		for ( int i = playerInventory.len() - 1; i >= -1; i-- )
		{
#if DEV
				if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
				{
					foreach ( tempLockedSlot in allLockedSlots )
					{
						printt("Locked Inv Debug: At step " + i + " we have slot " + tempLockedSlot.slot + " with lootIdx " + lockedData.lootIdx )
					}
				}
#endif
			
			if ( i == -1 || SortByPriorityThenTier( fakeInventoryData, playerInventory[i] ) > 0 )
			{
#if DEV
					if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
					{
						printt("Locked Inv Debug: Inserting empty locked slot at position - " + ( i + 1 ) + ", moved from position " + lockedData.slot )
					}
#endif

				int initialSlot = lockedData.slot

				playerInventory.insert( i + 1, fakeInventoryData )
				if ( lockedData.slot == i + 1 )
					break

				lockedData.slot = i + 1

				
				bool insertedNewLockedSlotIntoInitialSlot = false
				for ( int j = initialSlot + 1; j <= lockedData.slot; j++ )
				{
					if ( j in allLockedSlots )
					{
						if ( j - 1 == initialSlot )
						{
							insertedNewLockedSlotIntoInitialSlot = true
						}

						allLockedSlots[j].slot = j - 1
#if DEV
							if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
							{
								printt("Locked Inv Debug: Moved in front of another locked slot at - " + j + ", with lootIdx - " + allLockedSlots[j].lootIdx + ", moved it to " + ( j - 1 ) )
							}
#endif
						allLockedSlots[j - 1] <- allLockedSlots[j]
						delete allLockedSlots[j]
					}
				}

				allLockedSlots[i + 1] <- lockedData
				if ( !insertedNewLockedSlotIntoInitialSlot )
				{
					delete allLockedSlots[initialSlot]
				}

				break
			}
			
			else if ( i in allLockedSlots && lockedData.slot > i )
			{
				allLockedSlots[i].slot = i + 1
#if DEV
					if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
					{
						printt("Locked Inv Debug: Went past another locked slot at position - " + i + ", with lootIdx - " + allLockedSlots[i].lootIdx + ", moved it to " + ( i + 1 ) )
					}
#endif

				
				if ( lockedData.slot == i + 1 )
				{
#if DEV
						if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
						{
							printt("Locked Inv Debug: Also swapping with the empty slot we are currently inserting" )
						}
#endif
					LockedInventoryData tempData = allLockedSlots[i + 1]
					allLockedSlots[i + 1] <- allLockedSlots[i]

					tempData.slot = i
					allLockedSlots[i] <- tempData
				}
				else
				{

					allLockedSlots[i + 1] <- allLockedSlots[i]
					delete allLockedSlots[i]
				}
			}
		}
	}

	
	for ( int i = 0; i < playerInventory.len(); i++ )
	{
#if DEV
			if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
			{
				printt("Locked Inv Debug: Final inventory info - slot " + i + " lootIdx " + playerInventory[i].type + " count " + playerInventory[i].count + " was previously at " + playerInventory[i].slot )
			}
#endif

		playerInventory[i].slot = i
	}

	
	RectifyLockedSlotPositions_Internal( player )

#if DEV
		if ( LOCKED_INV_EMPTY_SLOT_DEBUG )
		{
			foreach ( lockedSlot in Survival_GetAllLockedInventoryData( player ).clonevalues() )
			{
				printt( "Locked Inv Debug: ending with locked slot - " + lockedSlot.slot + ", lootIdx - " + lockedSlot.lootIdx + ", lockedReason - " + lockedSlot.lockedReason + ". isEmpty - "+ lockedSlot.isEmptySlot )
			}
			printt("Locked Inv Debug: ENDING")
		}
#endif
}


array<ConsumableInventoryItem> function SURVIVAL_GetGrenadeInventory( entity player )
{
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
	array<ConsumableInventoryItem> grenadeInventory
	int extraGrenadeSlots = ExtraFirepower_GetMaxExtraSlotsForPlayer( player )
	int inventoryIndex = 0
	while( extraGrenadeSlots > 0 && inventoryIndex < playerInventory.len() )
	{
		ConsumableInventoryItem item = playerInventory[ inventoryIndex ]
		LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( item.type )
		if( lootData.lootType == eLootType.ORDNANCE )
		{
			extraGrenadeSlots -= 1
			grenadeInventory.append( playerInventory[inventoryIndex] )
		}
		inventoryIndex += 1
	}
	return grenadeInventory
}



array<ConsumableInventoryItem> function SURVIVAL_GetMainInventory( entity player, bool forceLockedUpdate = false, bool avoidLockedUpdate = false )
{
	array<ConsumableInventoryItem> playerInventory
	if ( !Augments_GetInfAmmoAugReworkEnabled() )
	{
		playerInventory = SURVIVAL_GetPlayerInventory( player, forceLockedUpdate, avoidLockedUpdate )
	}
	else
	{
		playerInventory = SURVIVAL_GetPlayerInventory( player )
	}


		int extraGrenadeSlots = ExtraFirepower_GetMaxExtraSlotsForPlayer( player )
		int inventoryIndex = 0
		while( extraGrenadeSlots > 0 && inventoryIndex < playerInventory.len() )
		{
			ConsumableInventoryItem item = playerInventory[ inventoryIndex ]
			LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( item.type )
			if( lootData.lootType == eLootType.ORDNANCE )
			{
				extraGrenadeSlots -= 1
				
				playerInventory.remove( inventoryIndex )
			}
			else
			{
				inventoryIndex += 1
			}
		}

	return playerInventory
}


array< string > function SURVIVAL_ConsumableInventoryItems_To_ItemRefs( array< ConsumableInventoryItem > itemsArray )
{
	array< string > result
	foreach( item in itemsArray )
	{
		LootData lData = SURVIVAL_Loot_GetLootDataByIndex( item.type )
		for( int i = 0; i < item.count; i++ )
		{
			result.append( lData.ref )
		}
	}
	return result
}


int function SURVIVAL_GetCountToFillStack( entity player, string ref )
{
	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	int type      = data.index

	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
	int slotCount                                  = SURVIVAL_GetInventorySlotCountForPlayer( player, data )

	foreach ( invItem in playerInventory )
	{
		if ( invItem.type != type )
			continue

		if ( invItem.count == slotCount )
			continue

		int diff = slotCount - invItem.count

		return diff
	}

	return slotCount
}










































































































































































































































































































int function SURVIVAL_AddToInventory( entity player, array<ConsumableInventoryItem> inventory, int inventoryLimit, LootData itemLootFlav, int itemCount, int itemSlotCount, bool doSorting )
{

		if ( ReservedInventory_IsEnabled() )
			return ReservedInventory_AddToInventory( player, inventory, inventoryLimit, itemLootFlav, itemCount, itemSlotCount, doSorting )














	{
		if ( itemSlotCount <= 0 )
			return 0

		int numToAdd = itemCount
		int numAdded = 0

		for ( int i = 0; i < inventory.len(); i++ )
		{
			if ( numToAdd <= 0 )
				break

			ConsumableInventoryItem invItem = inventory[i]

			if ( invItem.type != itemLootFlav.index )
				continue

			if ( invItem.count >= itemSlotCount )
				continue


			 if ( ConsumableItem_HasFlag( invItem, eConsumableItemFlag.DUMMY_AMMO ) )
			 {
				  if ( InfAmmoAug_ShouldReplaceDummyAmmoWithPickup( player ) )
				  {
						ConsumableItem_ClearFlag( invItem, eConsumableItemFlag.DUMMY_AMMO )
						Assert( ConsumableItem_HasFlag( invItem, eConsumableItemFlag.LOCKED ) )
						invItem.count = 0
				  }
				  else
					   continue
			 }
			 else if ( ConsumableItem_IsItemLocked( invItem ) && !InfAmmoAug_ShouldConsolidateAmmoPickupWithLockedAmmo( player ) )
				  continue


			int diff = itemSlotCount - invItem.count
			int add  = minint( numToAdd, diff )
			invItem.count += add
			numToAdd -= add
			numAdded += add
		}


		while ( numToAdd > 0 && (inventory.len() < inventoryLimit || ExtraFirepower_GetPlayerAvailableSlots( player, itemLootFlav.lootType == eLootType.ORDNANCE ) > 0) )



		{
			ConsumableInventoryItem item
			item.slot = inventory.len()
			item.type = itemLootFlav.index

			int add = minint( numToAdd, itemSlotCount )
			item.count = add
			numToAdd -= add
			numAdded += add

			int insertPoint = inventory.len()
			if ( doSorting )
			{
				for ( int i = 0; i < inventory.len(); i++ )
				{
					int compare = SortByPriorityThenTier( item, inventory[i] )
					if ( compare <= 0 )
					{
						insertPoint = i
						break
					}
				}
			}

			inventory.insert( insertPoint, item )
		}
		return numAdded
	}
	unreachable
}


int function SURVIVAL_AddToPlayerInventory( entity player, string ref, int count = 1, bool reallyAdd = true )
{
	
	if ( !SURVIVAL_Loot_IsRefValid (ref) ) 
	{
		Warning( "Trying to add non-valid loot to player inventory" )
		return 0 
	}

	PerfStart( PerfIndexServer.AddToInventory )

	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )

	LootData data      = SURVIVAL_Loot_GetLootDataByRef( ref )
	int inventoryLimit = SURVIVAL_GetInventoryLimit( player )
	int itemSlotCount  = SURVIVAL_GetInventorySlotCountForPlayer( player, data )

	
	bool doSorting = SERVER

	int numAdded = SURVIVAL_AddToInventory( player, playerInventory, inventoryLimit, data, count, itemSlotCount, doSorting )








	PerfEnd( PerfIndexServer.AddToInventory )

	return numAdded
}


void function SURVIVAL_RemoveFromInventory( entity player, array<ConsumableInventoryItem> inventory, LootData itemLootFlav, int itemCount )
{
	int numToRemove = itemCount
	for ( int i = inventory.len() - 1; i >= 0; i-- )
	{
		ConsumableInventoryItem invItem = inventory[i]
		if ( invItem.type == itemLootFlav.index )
		{

			if ( ConsumableItem_IsItemLocked( invItem ) )
				continue


			int numToRemoveHere = minint( invItem.count, numToRemove )
			numToRemove -= numToRemoveHere
			invItem.count -= numToRemoveHere

			if ( invItem.count == 0 )
			{
				inventory.remove( i )
			}

			if ( numToRemove == 0 )
				break
		}
	}
	SURVIVAL_ConsolidateInventoryItems( player, inventory )
}


void function SURVIVAL_RemoveFromPlayerInventory( entity player, string ref, int count = 1 )
{
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )

	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	SURVIVAL_RemoveFromInventory( player, playerInventory, data, count )



















}


void function SURVIVAL_ConsolidateInventoryItems( entity player, array<ConsumableInventoryItem> inventory )
{
	int INVENTORY_EMPTY = SURVIVAL_Loot_GetLootDataTable().len()

	for ( int i = 0; i < inventory.len() - 1; i++ )
	{
		ConsumableInventoryItem invItem1 = inventory[i]

		if ( invItem1.type == INVENTORY_EMPTY )
			continue


			if ( ConsumableItem_IsItemLocked( invItem1 ) )
				continue


		LootData data = SURVIVAL_Loot_GetLootDataByIndex( invItem1.type )
		int slotCount = SURVIVAL_GetInventorySlotCountForPlayer( player, data )

		if ( slotCount <= invItem1.count || invItem1.count == 0 )
			continue

		for ( int j = i + 1; j < inventory.len(); j++ )
		{
			ConsumableInventoryItem invItem2 = inventory[j]


				if ( ConsumableItem_IsItemLocked( invItem2 ) )
					continue


			if ( invItem1.type == invItem2.type )
			{
				int numToFull = slotCount - invItem1.count
				int numToMove = minint( numToFull, invItem2.count )
				invItem2.count -= numToMove
				invItem1.count += numToMove

				if ( slotCount == invItem1.count )
					break
			}
		}
	}

	for ( int i = inventory.len() - 1; i >= 0; i-- )
	{
		ConsumableInventoryItem invItem = inventory[i]

		if ( invItem.count == 0 )
		{
			inventory.remove( i )
		}
	}
}

void function SURVIVAL_ClearExcessInventoryItems( entity player, array<ConsumableInventoryItem> inventory )
{
	int INVENTORY_EMPTY = SURVIVAL_Loot_GetLootDataTable().len()

	for ( int i = 0; i < inventory.len(); i++ )
	{
		ConsumableInventoryItem item = inventory[i]

		if ( item.type == INVENTORY_EMPTY )
			continue

		LootData data = SURVIVAL_Loot_GetLootDataByIndex( item.type )
		int slotCount = SURVIVAL_GetInventorySlotCountForPlayer( player, data )

		if( item.count > slotCount )
			item.count = slotCount
	}
}




















































