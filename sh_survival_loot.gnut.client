LootActionStruct function SURVIVAL_GetActionForBackpackItem( entity player, LootData lootData, int actionType )
{
	switch( actionType )
	{
		case eLootActionType.ALT_ACTION:
			return SURVIVAL_GetAltActionForBackpackItem( player, lootData )
			break

		case eLootActionType.CHARACTER_ACTION1:
			return SURVIVAL_GetCharacterAction1ForBackpackItem( player, lootData )
			break

		case eLootActionType.CHARACTER_ACTION2:
			return SURVIVAL_GetCharacterAction2ForBackpackItem( player, lootData )
			break
	}

	LootTypeData lt = GetLootTypeData( lootData.lootType )

	int action = lt.backpackAction

	
	LootActionStruct as
	if ( action == eLootAction.ATTACH_TO_ACTIVE )
	{
		as = SURVIVAL_GetActionForAttachment( player, lootData, false, true, false )
	}
	else
	{
		as.action = action
	}

	return as
}

