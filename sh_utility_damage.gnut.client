bool function ShouldPreventDamageDueToFriendlyFire( entity attacker, entity ent, var damageInfo )
{





	
	if ( attacker == ent )
		return false

	int entTeam      = ent.GetTeam()
	int attackerTeam = attacker.GetTeam()
	if ( !IsFriendlyTeam( entTeam, attackerTeam ) )
		return false

	if ( damageInfo != null && DamageIgnoresFriendlyFire( damageInfo ) )
		return false






	if ( (ent.GetOwner() != attacker) && (ent.GetBossPlayer() != attacker) )
	{
		
		return true
	}















	return false
}

bool function DamageIgnoresFriendlyFire( var damageInfo )
{
	if ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS ) )
		return true

	int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )

	switch ( damageSourceID )
	{
		case eDamageSourceId.switchback_trap:
		case eDamageSourceId.suicideSpectreAoE:
		case eDamageSourceId.mp_weapon_defensive_bombardment_weapon: 
		case eDamageSourceId.mp_weapon_defensive_bombardment_triple_weapon:
		case eDamageSourceId.damagedef_defensive_bombardment: 

		case eDamageSourceId.mp_weapon_creeping_bombardment_weapon: 

		case eDamageSourceId.damagedef_creeping_bombardment_detcord_explosion: 

		case eDamageSourceId.mp_weapon_tesla_trap: 
		case eDamageSourceId.mp_ability_frag_drone: 



		case eDamageSourceId.spider_poison:    




		case eDamageSourceId.damagedef_wrecking_ball:    

		case eDamageSourceId.mp_ability_crypto_drone_emp_trap:

		case eDamageSourceId.mp_weapon_mortar_ring:    





		case eDamageSourceId.mp_weapon_bow_ult_missile:


		case eDamageSourceId.titan_explosion:
		case eDamageSourceId.vehicle_explosion:

			return true
	}

	return false
}






































































































































































































