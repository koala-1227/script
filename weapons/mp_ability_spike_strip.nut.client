		if( weapon.GetOwner() == GetLocalViewPlayer() )
			weapon.Signal( KILL_CLIENT_THREAD_SIGNAL )


	return Grenade_OnWeaponTossReleaseAnimEvent( weapon, attackParams )
}


void function OnProjectileCollision_ability_spike_strip( entity projectile, vector pos, vector normal, entity hitEnt, int hitBox, bool isCritical, bool isPassthrough )
{
	entity owner = projectile.GetOwner()

	if( !IsValid( owner ) || !IsAlive( owner ) )
	{



		return
	}

	if ( projectile.GrenadeHasIgnited() )
		return

	vector targetPos = pos
	vector targetNormal = normal

	projectile.proj.projectileBounceCount++
	int maxBounceCount = projectile.GetProjectileWeaponSettingInt( eWeaponVar.projectile_ricochet_max_count )
	bool destroyIfNotPlanted = ( projectile.proj.projectileBounceCount > maxBounceCount )


























	bool projectileIsOnGround = normal.Dot( <0,0,1> ) > tuning.placementAngleDOTMax
	if ( !projectileIsOnGround )
	{





		return
	}

	if( !CanDeployOnEnt( hitEnt, pos ) )
	{




		return
	}

	DeployableCollisionParams collisionParams
	collisionParams.pos = targetPos
	collisionParams.normal = targetNormal
	collisionParams.hitEnt = hitEnt
	collisionParams.hitBox = hitBox
	collisionParams.isCritical = isCritical

	bool result = PlantStickyEntity( projectile, collisionParams, <90, 0, 0> )
	if( !result )
	{




		return
	}





























}

bool function CanDeployOnEnt( entity ent, vector pos )
{
	if ( IsValid( ent ) )
	{
		if ( ent.IsPlayer() || ent.IsNPC() || IsDeathboxFlyer( ent ) )
			return false

		if ( ent.GetScriptName() == CRYPTO_DRONE_SCRIPTNAME  )
			return false

		if( ent.GetScriptName() == BUBBLE_SHIELD_SCRIPTNAME )
			return false

		if ( IsBreachableGlass( ent ) && ent.GetHealth() <= 0 )
			return false

		if ( ent.IsProjectile() )
			return false

		entity lootBin = GetLootBinForHitEnt( ent )
		if( IsValid( lootBin ) && !LootBin_IsBusy( lootBin ) )
			return true
	}

	return true
}

bool function CanReclaimSpikeTrap( entity trap )
{
	entity totem = trap.GetParent()
	if( !IsValid( totem ) )
		return false

	return totem.GetScriptName() != "busy"
}





































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































void function OnClientAnimEvent_ability_spike_strip( entity weapon, string name )
{
	GlobalClientEventHandler( weapon, name )

	if ( name == "muzzle_flash" )
	{
		weapon.PlayWeaponEffect( SPIKE_STRIP_MUZZLE_FLASH_FP, SPIKE_STRIP_MUZZLE_FLASH_3P, "muzzle_flash" )
	}
}

void function WeaponActive_Client( entity owner, entity weapon )
{
	EndSignal( weapon, KILL_CLIENT_THREAD_SIGNAL )
	EndSignal( weapon, "OnDestroy" )
	EndSignal( owner, "OnDestroy" )

}

entity function SpikeStripCreatePlacementProxy( asset modelName )
{
	entity proxy = CreateClientSidePropDynamic( <0, 0, 0>, <0, 0, 0>, modelName )
	proxy.EnableRenderAlways()
	proxy.kv.rendermode = 3
	proxy.kv.renderamt = 1
	proxy.Hide()

	return proxy
}

void function MainSpikeCreated( entity spike )
{
	
	if ( spike.GetNetworkedClassName() != "prop_ferro_prop" )
		return

	SetAllowForKillreplayProjectileCam( spike )
	SetCustomKillreplayChaseCamFromWeaponClass( spike, SPIKE_STRIP_WEAPON_NAME )

	entity player = GetLocalViewPlayer()
	ShowGrenadeArrow( player, spike, GetTriggerRadius( ), 0.0, true, eThreatIndicatorVisibility.INDICATOR_SHOW_TO_ENEMIES )

	if ( !IsValid( spike.GetOwner() ) )
		return

	if( spike in file.totemToInfoEntTable && IsValid( file.totemToInfoEntTable[ spike ] ) )
	{
		thread CreateSpikeStrip_Client( spike.GetOwner(), spike, VectorToAngles( spike.GetForwardVector() ), spike.GetOwner().GetTeam(), file.totemToInfoEntTable[ spike ] )
	}
}

void function InfoEntityCreated( entity spikeInfoEnt )
{
	entity spike = spikeInfoEnt.GetMainSpike()
	if( spike != null )
	{
		file.totemToInfoEntTable[ spike ] <- spikeInfoEnt
	}

	if( IsValid( spike ) )
	{
		thread CreateSpikeStrip_Client( spike.GetOwner(), spike, VectorToAngles( spike.GetForwardVector() ), spike.GetOwner().GetTeam(), file.totemToInfoEntTable[ spike ] )
	}
}

void function GetAdjustedTestOffsets( entity mainSpike, array< vector > testOffsets )
{
	testOffsets.clear()
	vector pos = mainSpike.GetOrigin() + ( mainSpike.GetUpVector() * 30 )
	foreach( offset in SPIKE_STRIP_TEST_OFFSETS )
	{
		TraceResults testTrace = TraceLine( pos , mainSpike.GetOrigin() + offset, mainSpike, TRACE_MASK_SHOT & ~CONTENTS_WATER, TRACE_COLLISION_GROUP_DEBRIS )
		testOffsets.append( testTrace.endPos )
#if ( DEV && SPIKE_STRIP_DEBUG )
			DebugDrawSphere( testTrace.endPos, 5.0, COLOR_GREEN, true, 5.0 )
#endif
	}
}

void function CreateSpikeStrip_Client( entity owner, entity mainSpike, vector angles, int team, entity spikeInfoEnt )
{
	EndSignal( mainSpike, "OnDestroy" )
	EndSignal( spikeInfoEnt, "OnDestroy" )

	wait tuning.spikeDelayBeforeExpanding

	SpikeGridData spikeGridData = GetSpikeGridData( owner, mainSpike )
	int gridLength = spikeGridData.gridLengthAdjusted
	int gridWidth = spikeGridData.gridWidthAdjusted

	for( int i = 0; i < gridLength; i++  )
	{
		for( int j = 0; j < gridWidth; j++  )
		{
			if( spikeInfoEnt.GetSpikeEnabled( i, j ) )
			{
				asset model = SPIKE_STRIP_SPIKE_DORMANT
				if( i == 0 )
				{
					if ( j == 0 )
					{
						model = SPIKE_STRIP_SPIKE_R_CORNER_DORMANT
					}
					else if ( j == gridWidth - 1 )
					{
						model = SPIKE_STRIP_SPIKE_L_CORNER_DORMANT
					}
				}
				else if ( i == gridLength - 1 )
				{
					if ( j == 0 )
					{
						model = SPIKE_STRIP_SPIKE_L_CORNER_DORMANT
					}
					else if ( j == gridWidth - 1 )
					{
						model = SPIKE_STRIP_SPIKE_R_CORNER_DORMANT
					}
				}
				else if ( i == gridLength && j == gridWidth )
				{
					model = SPIKE_STRIP_SPIKE_CORE_DORMANT
				}

				CreateSpikeSegment_Client( spikeInfoEnt.GetSpikeParent( i, j ), mainSpike, spikeInfoEnt.GetSpikeAbsPosition( i, j ), spikeInfoEnt.GetSpikeAbsAngles( i, j ), team, model, spikeInfoEnt, i, j )
			}
		}
	}
}

void function CreateSpikeSegment_Client( entity moveParent, entity mainSpike, vector pos, vector angles, int team, asset model, entity spikeInfoEnt, int gridX, int gridY )
{
	entity proxy = CreateClientSidePropDynamic( pos, angles, model )
	if ( IsValid( moveParent ) )
		proxy.SetParent( moveParent, "", true, 0, true )

	proxy.e.baseModel = model
	if( model in file.altModelTable )
	{
		proxy.e.altModel = file.altModelTable[ model ]
	}
	else
	{
		proxy.e.altModel = SPIKE_STRIP_SPIKE_ACTIVE
	}

	thread SpikeLifetime_ClientThread( proxy, mainSpike, spikeInfoEnt, gridX, gridY )
}


void function SpikeLifetime_ClientThread( entity proxySpike, entity mainSpike, entity spikeInfoEnt, int gridX, int gridY )
{
	EndSignal( proxySpike, "OnDestroy" )
	EndSignal( mainSpike, "OnDestroy" )
	EndSignal( spikeInfoEnt, "OnDestroy" )
	entity parentEnt = proxySpike.GetParent()
	if ( IsValid( parentEnt ) )
	{
		EndSignal( parentEnt, "OnDestroy" )
	}

	entity owner = mainSpike.GetOwner()

	proxySpike.SetModelScale( tuning.spikeScaleDormant )
	proxySpike.SetModel( proxySpike.e.baseModel )

	OnThreadEnd(
		function() : ( proxySpike )
		{
			if ( IsValid( proxySpike ) )
			{
				proxySpike.Destroy()
			}
		}
	)

	float activationTime = spikeInfoEnt.GetMainSpikeCreationTime() + GetActivationDelay( owner )	
	while( Time() < activationTime )
	{
		if( IsValid( mainSpike ) && DistanceSqr( mainSpike.GetOrigin(), proxySpike.GetOrigin() ) > tuning.spikeDistanceFromCoreThresholdSQR )
		{
			proxySpike.Destroy()
			return
		}
		float remainingTime = activationTime - Time()
		wait (remainingTime > 0.1 ? 0.1 : remainingTime)
	}

	if ( !IsValid( proxySpike ) || !IsValid( mainSpike ) )
		return

	int lastSpikeState = eSpikeState.DORMANT
	while( true )
	{
		if ( !spikeInfoEnt.GetSpikeEnabled( gridX, gridY ) )
			return

		if( IsValid( mainSpike ) && DistanceSqr( mainSpike.GetOrigin(), proxySpike.GetOrigin() ) > tuning.spikeDistanceFromCoreThresholdSQR )
		{
			return
		}

		if( IsValid( parentEnt ) )
		{
			entity lootBin = GetLootBinForHitEnt( parentEnt )
			if( lootBin && LootBin_IsBusy( lootBin ) )
			{
				return
			}
		}

		if ( IsValid( mainSpike ) && mainSpike.IsSolid() )
		{
			if ( lastSpikeState != eSpikeState.ACTIVE  )
			{
				if ( lastSpikeState == eSpikeState.HIDDEN )
				{
					thread FadeSpikeIn( proxySpike )
				}
				proxySpike.SetModel( proxySpike.e.altModel )
				proxySpike.SetModelScale( tuning.spikeScaleActive )
				lastSpikeState = eSpikeState.ACTIVE
			}

		}
		else if ( IsValid( mainSpike ) && !mainSpike.IsSolid() )
		{
			
			bool areEnemiesInStrip = spikeInfoEnt.GetArePlayersInStrip()
			if ( !areEnemiesInStrip && PlayerHasHiddenSpikes( owner ) )
			{
				
				if ( lastSpikeState != eSpikeState.HIDDEN )
				{
					lastSpikeState = eSpikeState.HIDDEN
					if ( GetLocalViewPlayer().GetTeam() == owner.GetTeam() && proxySpike.e.baseModel in file.arModelTable )
					{
						
						thread FadeSpikeOutIn( proxySpike, file.arModelTable[ proxySpike.e.baseModel],  tuning.spikeScaleAR )
					}
					else
					{
						thread FadeSpikeOut( proxySpike )
					}
				}
			}
			else
			{
				if ( lastSpikeState != eSpikeState.DORMANT )
				{
					if ( lastSpikeState == eSpikeState.HIDDEN )
					{
						thread FadeSpikeIn( proxySpike )
					}
					proxySpike.SetModel( proxySpike.e.baseModel )
					proxySpike.SetModelScale( tuning.spikeScaleDormant )
					lastSpikeState = eSpikeState.DORMANT
				}
			}
		}

		wait 0.1
	}
}

void function UseEntityCreated( entity useEnt )
{
	AddCallback_OnUseEntity_ClientServer( useEnt, SpikeStrip_OnUseClient )
}

void function SpikeStrip_OnUseClient( entity spike, entity player, int useFlags )
{
	if ( IsControllerModeActive() )
	{
		if ( !IsBitFlagSet( useFlags, USE_INPUT_LONG ) )
		{
			thread IssueReloadCommand( player )
		}
	}
}

void function OnCharacterButtonPressed( entity player )
{
	if( Perk_QuickPackup_RemoteInteractEnabled() )
		return

	entity useEnt = player.GetUsePromptEntity()
	if ( !IsValid( useEnt ) || useEnt.GetTargetName() != SPIKE_STRIP_USE_ENTITY_NAME )
		return

	if ( useEnt.GetOwner() != player )
		return

	CustomUsePrompt_SetLastUsedTime( Time() )

	entity coreSpike = useEnt.GetParent()
	if( IsValid( coreSpike ) )
		Remote_ServerCallFunction( "ClientCallback_TryPickupSpikeStrip", coreSpike )
}

void function SpikeStrip_OnGainFocus( entity ent )
{
	if ( !IsValid( ent ) )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

	if ( player == ent.GetOwner() && ent.GetTargetName() == SPIKE_STRIP_USE_ENTITY_NAME )
	{
		if( Perk_QuickPackup_RemoteInteractEnabled() )
		{

			bool isRemotePickup = Perk_QuickPackup_IsRemotePickup( ent, player )

			if( isRemotePickup && !CanReclaimSpikeTrap( ent ) )
			{
				CustomUsePrompt_SetText( Localize( "#WPN_SPIKES_PICKUP_USE_CANT_RECLAIM_BUSY" ) )
			}
			else
			{
				CustomUsePrompt_SetText( Localize( "#WPN_SPIKES_PICKUP_USE" ) )
			}
		}
		else
		{
			CustomUsePrompt_SetText( Localize( "#WPN_SPIKES_PICKUP" ) )
		}
		CustomUsePrompt_Show( ent )
	}
}

void function SpikeStrip_OnLoseFocus( entity ent )
{
	CustomUsePrompt_ClearForAny()
}

void function MinimapPackage_SpikeStrip( entity ent, var rui )
{
#if MINIMAP_DEBUG
		printt( "Adding 'rui/hud/gametype_icons/survival/catalyst_ult_map_icon' icon to minimap" )
#endif
	RuiSetImage( rui, "defaultIcon", $"rui/hud/gametype_icons/survival/catalyst_ult_map_icon" )
	RuiSetImage( rui, "clampedDefaultIcon", $"rui/hud/gametype_icons/survival/catalyst_ult_map_icon" )
	RuiSetBool( rui, "useTeamColor", false )
	RuiSetFloat( rui, "iconBlend", 0.0 )
}


void function FadeSpikeOutIn( entity spike, asset newModel, float newModelScale )
{
	waitthread FadeModelAlphaOverTime( spike, 0.25 )

	if ( !IsValid( spike ) )
		return




	spike.SetModel( newModel )
	spike.SetModelScale( newModelScale )
	waitthread FadeModelAlphaOverTime( spike, 0.25, 0, 255 )
}

void function FadeSpikeOut( entity spike )
{
	waitthread FadeModelAlphaOverTime( spike, 0.5 )
}

void function FadeSpikeIn( entity spike )
{



	waitthread FadeModelAlphaOverTime( spike, 0.25, 0, 255 )
}
