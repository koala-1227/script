const asset SKYWARD_JUMPJETS_FRIENDLY = $"P_valk_jet_fly_ON"
const asset SKYWARD_JUMPJETS_ENEMY = $"P_valk_jet_fly_ON"
const asset SKYWARD_AFTERBURNER_FX = $"P_valk_launch_eng"
const asset SKYWARD_RADIUS_FX = $"P_radius_marker"


const string SKYWARD_PROXY_SCRIPT_NAME = "valk_ult_proxy"

const asset VALK_SKYWARD_USE_MODEL = $"mdl/humans_r5/pilots_r5/pilot_valkyrie/invisible_prop.rmdl"

const array<vector> attachPositions = [<-10, -50, -40>, <-10, 50, -40>, <-50, 25, -60>, <-20, -50, -60>]

struct LaunchSettings
{
	float totalUpTime
	float slowUpTime
	float fastUpTime
	float totalUpDistance
	float slowUpDistance
}

struct
{

		var countdownRui
		var launchRui
		var flightRui

	float ultStartTime
	table<entity, bool> isInLaunchingState
	table<entity, float> valkUltDebounce

	table<entity, bool>	playerToFinishedLaunchSuccessfully











} file


enum eSkydiveFiringMode
{
	None,
	OnlyFromValkUlt,
	ExceptFromPlane,
	Always
}

struct Tuning
{
	int allowedToFireTacDuringUltMode = eSkydiveFiringMode.ExceptFromPlane

	float launchTime = 5.0
	float transitionTime = 1.2
	float transitionSpeedScale = 0.5

	float launchHeightScaleUpgraded = 1.15

	float waitTimeBeforeLaunch = 1.5
	float slowTime = 1.33
	float refundAmount = 0.8

	float maxHeight = 4500.0

	float launchTimeUpgraded = 3.0





	float slowTimeUpgraded = 0.6
	float transitionTimeUpgraded = 0.6
	float fastLaunchHeightScale = 1.0

	float allyUseDebounceTime = 1.0
	float valkUseDebounceTime = 0.75
}
Tuning tuning

void function MpAbilityValkSkyward_Init()
{
	SetupTuning()

	PrecacheParticleSystem( SKYWARD_JUMPJETS_FRIENDLY )
	PrecacheParticleSystem( SKYWARD_JUMPJETS_ENEMY )
	PrecacheParticleSystem( SKYWARD_AFTERBURNER_FX )
	PrecacheParticleSystem( SKYWARD_RADIUS_FX )
	PrecacheParticleSystem( $"P_valk_launch_engage" )
	PrecacheParticleSystem( $"P_valk_launch_eng" )

	PrecacheModel( VALK_SKYWARD_USE_MODEL )
	PrecacheScriptString( SKYWARD_PROXY_SCRIPT_NAME )

	PrecacheMaterial( $"models/cable/valk_team_cable" )

	RegisterSignal( "OnSkywardLaunched" )
	RegisterSignal( "OnSkywardCanceled" )
	RegisterSignal( "OnSkywardDone" )
	RegisterSignal( "AllyCanceledSkyward" )
	RegisterSignal( "ValkUltAllyLaunchFinished" )
	RegisterSignal( "OnSkywardInterrupted" )
	RegisterSignal( "OnSkywardAllyUse" )
	RegisterSignal( "HideSkydiveTacHint" )

	
	RegisterSignal( "OnSkywardDeployStateEnd" )

	Remote_RegisterClientFunction( "ServerToClient_PlayPleaseWaitSound", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_ValkUltCanceled", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_SetSkydiveAfterUlt", "entity", "bool" )
	Remote_RegisterClientFunction( "ServerToClient_RemoveFromPlayersWaiting", "entity", "entity" )








		StatusEffect_RegisterEnabledCallback( eStatusEffect.skyward_embark, ValkUlt_ShowEmbarkUI )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.skyward_embark, ValkUlt_DestroyEmbarkUI )
		AddCreateCallback( "prop_script", OnPropScriptCreated )
		AddCallback_PlayerClassChanged( OnPlayerClassChanged )
		AddOnSpectatorTargetChangedCallback( OnSpectatorTargetChanged )


	AddCallback_GameStateEnter( eGameState.Resolution, ValkUlt_EnterGameStateResolution)
}

void function SetupTuning()
{
	Tuning defaultTuning

	tuning.launchTime = GetCurrentPlaylistVarFloat( "valk_ult_launchTime", defaultTuning.launchTime )
	tuning.transitionTime = GetCurrentPlaylistVarFloat( "valk_ult_transitionTime", defaultTuning.transitionTime )
	tuning.transitionSpeedScale = GetCurrentPlaylistVarFloat( "valk_ult_transitionSpeedScale", defaultTuning.transitionSpeedScale )

	tuning.waitTimeBeforeLaunch = GetCurrentPlaylistVarFloat( "valk_ult_waitTimeBeforeLaunch", defaultTuning.waitTimeBeforeLaunch )
	tuning.slowTime = GetCurrentPlaylistVarFloat( "valk_ult_slowTime", defaultTuning.slowTime )
	tuning.refundAmount = GetCurrentPlaylistVarFloat( "valk_ult_cancel_refund_amount", defaultTuning.refundAmount )
	tuning.maxHeight = GetCurrentPlaylistVarFloat( "valk_ult_up_distance", defaultTuning.maxHeight )
	tuning.launchHeightScaleUpgraded = GetCurrentPlaylistVarFloat( "valk_ult_launchHeightScaleUpgraded", defaultTuning.launchHeightScaleUpgraded )

	tuning.launchTimeUpgraded = GetCurrentPlaylistVarFloat( "valk_ult_launchTimeUpgraded", defaultTuning.launchTimeUpgraded )
	tuning.slowTimeUpgraded = GetCurrentPlaylistVarFloat( "valk_ult_slowTimeUpgraded", defaultTuning.slowTimeUpgraded )
	tuning.transitionTimeUpgraded = GetCurrentPlaylistVarFloat( "valk_ult_transitionTimeUpgraded", defaultTuning.transitionTimeUpgraded )
	tuning.fastLaunchHeightScale = GetCurrentPlaylistVarFloat( "valk_ult_fastLaunchHeightScale", defaultTuning.fastLaunchHeightScale )

	tuning.allowedToFireTacDuringUltMode = GetCurrentPlaylistVarInt( "valk_ult_allowedToFireTacDuringUltMode", defaultTuning.allowedToFireTacDuringUltMode )

	tuning.allyUseDebounceTime = GetCurrentPlaylistVarFloat( "valk_ult_allyUseDebounceTime", defaultTuning.allyUseDebounceTime )
	tuning.valkUseDebounceTime = GetCurrentPlaylistVarFloat( "valk_ult_valkUseDebounceTime", defaultTuning.valkUseDebounceTime )
}

