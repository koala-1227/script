void function CoverFireNetvarChangedCallback( entity player, bool newValue )
{
	CoverFireFX( player )
}
void function CoverFireSpectatorTargetChangedDelay_Thread( entity player )
{
	WaitFrame()
	CoverFireFX( player )
}

void function CoverFireFX( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	if ( player.GetPlayerNetBool( COVER_FIRE_ACTIVE_NETVAR ) )
	{
		LootData wallCoverUpgrade = SURVIVAL_Loot_GetLootDataByIndex( 0 )
		wallCoverUpgrade.hudIcon = $"rui/hud/legend_upgrades/rampart_cover_fire_icon"
		LootFeedItem wallUpgradeMessage = LootFeed_CreateItem( player, wallCoverUpgrade )
		wallUpgradeMessage.itemNameText = "#UPGRADED_WALL_COVER_MESSAGE"
		LootFeed_QueueItem( wallUpgradeMessage )

		if ( EffectDoesExist( file.coverFireFxHandle ) )
		{
			EffectStop( file.coverFireFxHandle, false, true )
		}

		int fxIndex = GetParticleSystemIndex( COVER_FIRE_1P_FX )
		file.coverFireFxHandle = StartParticleEffectOnEntityWithPos( player, fxIndex, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, player.EyePosition(), <0, 0, 0> )
		EffectSetIsWithCockpit( file.coverFireFxHandle, true )
	}
	else
	{
		if ( EffectDoesExist( file.coverFireFxHandle ) )
		{
			EffectStop( file.coverFireFxHandle, false, true )
			file.coverFireFxHandle = 0
		}
	}
}



#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________Use___________________________(){}
#endif
bool function CoverWall_CanUse( entity player, entity ent, int useFlags )
{
	if ( ! IsValid( player ) )
		return false

	entity weapon = player.GetOffhandWeapon( eOffhandInv.TACTICAL )
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != COVER_WALL_WEAPON_NAME )
		return false

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	entity ultWeapon = player.GetOffhandWeapon( eOffhandInv.ULTIMATE )

	if( IsValid( ultWeapon ) && activeWeapon == ultWeapon && ultWeapon.GetWeaponClassName() == MOBILE_HMG_WEAPON_NAME )
		return false

	bool currentlyInPlacementMode = IsValid( player.GetActiveWeapon( eActiveInventorySlot.mainHand ) )
			&& player.GetActiveWeapon( eActiveInventorySlot.mainHand ).GetWeaponClassName() == COVER_WALL_WEAPON_NAME

	return ent.GetOwner() == player &&
			( currentlyInPlacementMode || SURVIVAL_PlayerAllowedToPickup( player ) ) &&
			! GradeFlagsHas( ent, eGradeFlags.IS_BUSY )
}


void function CoverWall_OnPropScriptCreated( entity ent )
{
	if ( ent.GetScriptName() == BASE_WALL_SCRIPT_NAME )
	{
		SetCallback_CanUseEntityCallback( ent, CoverWall_CanUse )
		AddEntityCallback_GetUseEntOverrideText( ent, CoverWall_UseTextOverride )
		AddCallback_OnUseEntity_ClientServer( ent, CoverWall_OnUseWall )
		if ( tuning.showWallHealthRui )
		{
			thread CoverWall_CreateHUDMarker( ent )
		}
		if ( tuning.speedBoostShowFx )
		{
			thread CoverWall_ChargeTrackingFX( ent )
		}
	}
}

void function CoverWall_OnPropScriptDestroyed( entity ent )
{
	if ( !IsValid( ent ) )
		return

	if ( ent.GetScriptName() == BASE_WALL_SCRIPT_NAME )
	{
		CustomUsePrompt_ClearForEntity( ent )
	}
}

void function OnCharacterButtonPressed( entity player )
{
	if( Perk_QuickPackup_RemoteInteractEnabled() )
		return

	entity useEnt = player.GetUsePromptEntity()
	if ( !IsValid( useEnt ) || useEnt.GetScriptName() != BASE_WALL_SCRIPT_NAME )
		return

	if ( useEnt.GetOwner() != player )
		return

	CustomUsePrompt_SetLastUsedTime( Time() )

	Remote_ServerCallFunction( "ClientCallback_TryPickupCoverWall", useEnt )
}

string function CoverWall_UseTextOverride( entity ent )
{
	entity player = GetLocalViewPlayer()

	entity weapon = player.GetOffhandWeapon( eOffhandInv.TACTICAL )
	if ( !CoverWall_CanUse( player, ent, USE_FLAG_NONE ) || !IsValid( weapon ) || weapon.GetWeaponClassName() != COVER_WALL_WEAPON_NAME )
	{
		CustomUsePrompt_Hide()
	}
	else if ( player == ent.GetOwner() )
	{
		CustomUsePrompt_Show( ent )
		CustomUsePrompt_SetSourcePos( ent.GetOrigin() + < 0, 0, 30 > )

		bool isRemotePickup = Perk_QuickPackup_IsRemotePickup( ent, player )
		bool blockedByNearbyEnemies = isRemotePickup && IsEnemyBlockingRemoteReclaim( ent )

		if ( CanReclaimWall( ent ) && !blockedByNearbyEnemies )
		{
			if( Perk_QuickPackup_RemoteInteractEnabled() )
			{
				entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
				if ( IsValid( activeWeapon ) && activeWeapon.GetWeaponBaseClassName() == COVER_WALL_WEAPON_NAME )
				{
					return Localize("#WPN_COVER_WALL_PLAYER_DEPLOY_HINT_RECLAIM")
				}
				return Localize("#WPN_COVER_WALL_DYNAMIC_RECLAIM")
			}

			CustomUsePrompt_SetText( Localize("#WPN_COVER_WALL_DYNAMIC_RECLAIM") )
			CustomUsePrompt_SetHintImage( $"rui/hud/character_abilities/rampart_cover_pickup" )
			CustomUsePrompt_SetLineColor( <0.0, 1.0, 1.0> )
		}
		else
		{
			if( Perk_QuickPackup_RemoteInteractEnabled() )
			{
				if( isRemotePickup )
				{
					if( blockedByNearbyEnemies )
					{
						return Localize( "#WPN_COVER_WALL_DYNAMIC_CANT_RECLAIM_ENEMIES" )
					}
					else
					{
						return Localize( "#WPN_COVER_WALL_DYNAMIC_CANT_RECLAIM_DAMAGED" )
					}
				}
				else
				{
					entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
					if ( IsValid( activeWeapon ) && activeWeapon.GetWeaponBaseClassName() == COVER_WALL_WEAPON_NAME )
					{
						return Localize("#WPN_COVER_WALL_PLAYER_DEPLOY_HINT_DESTROY")
					}
					return Localize( "#WPN_COVER_WALL_DYNAMIC_DESTROY" )
				}
			}

			CustomUsePrompt_SetText( Localize("#WPN_COVER_WALL_DYNAMIC_DESTROY") )
			
			CustomUsePrompt_SetHintImage( $"" )
			CustomUsePrompt_SetLineColor( <1.0, 0.5, 0.0> )
		}

		if ( PlayerIsInADS( player ) )
			CustomUsePrompt_ShowSourcePos( false )
		else
			CustomUsePrompt_ShowSourcePos( true )
	}

	return ""
}

void function CoverWall_OnUseWall( entity wallProxy, entity player, int useFlags )
{
	if ( IsControllerModeActive() )
	{
		if ( !IsBitFlagSet( useFlags, USE_INPUT_LONG ) )
		{
			thread IssueReloadCommand( player )
		}
	}
}

#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________ClientWork___________________________(){}
#endif
void function CoverWall_CreateHUDMarker( entity wall )
{
	wall.EndSignal( "OnDestroy" )

	while ( wall.GetTeam() != GetLocalViewPlayer().GetTeam() )
	{
		WaitSignal( GetLocalClientPlayer(), COVER_WALL_CHANGED_TEAMS_SIGNAL )
	}

	vector pos = wall.GetOrigin() + <0,0,COVER_WALL_ICON_HEIGHT>
	var rui = CreateCockpitRui( $"ui/cover_wall_marker_icons.rpak", RuiCalculateDistanceSortKey( GetLocalViewPlayer().EyePosition(), pos ) )
	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		RuiTrackFloat3( rui, "pos", wall, RUI_TRACK_POINT_FOLLOW, wall.LookupAttachment( "rui_attach" ) )
	}
	else
	{
		RuiTrackFloat( rui, "healthFrac", wall, RUI_TRACK_HEALTH )
		RuiTrackFloat3( rui, "pos", wall, RUI_TRACK_OVERHEAD_FOLLOW )
	}
	RuiKeepSortKeyUpdated( rui, true, "pos" )

	OnThreadEnd(
	function() : ( rui )
	{
		RuiDestroy( rui )
	}
	)

	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		RuiSetBool( rui, "isVisible", false )
		while( !IsValid( GetChargedWallTrackerEntFromWall( wall ) ) )
		{
			WaitFrame()
		}

		while( true )
		{
			entity player = GetLocalViewPlayer()
			int playerTeam = player.GetTeam()
			int wallTeam = wall.GetTeam()

			if ( playerTeam != wallTeam )
			{
				thread CoverWall_CreateHUDMarker( wall )
				return
			}

			if  ( wall.GetOwner() != player && !IsFriendlyTeam( playerTeam, wallTeam ) )
			{
				RuiSetBool( rui, "isVisible", false )
			}
			else
			{
				float chargeFrac = GetChargeFracForPlayerFromWall( player, wall )

				RuiSetBool( rui, "isVisible", true )
				RuiSetFloat( rui, "healthFrac", chargeFrac )
			}
			WaitFrame()
		}
	}
}

void function CoverWall_ChargeTrackingFX( entity wall )
{
	wall.EndSignal( "OnDestroy" )

	while ( wall.GetTeam() != GetLocalViewPlayer().GetTeam() )
	{
		WaitSignal( GetLocalClientPlayer(), COVER_WALL_CHANGED_TEAMS_SIGNAL )
	}

	PassByReferenceInt fxHandle

	OnThreadEnd(
	function() : ( fxHandle )
	{
		if ( EffectDoesExist( fxHandle.value ) )
		{
			EffectStop( fxHandle.value, true, false )
		}
	}
	)

	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		while( !IsValid( GetChargedWallTrackerEntFromWall( wall ) ) )
		{
			WaitFrame()
		}

		entity tracker = GetChargedWallTrackerEntFromWall( wall )

		int currentChargeLevel = 0
		while( true )
		{
			entity player = GetLocalViewPlayer()
			int playerTeam = player.GetTeam()
			int wallTeam = wall.GetTeam()

			if ( playerTeam != wallTeam )
			{
				thread CoverWall_ChargeTrackingFX( wall )
				return
			}

			if  ( wall.GetOwner() != player && !IsFriendlyTeam( playerTeam, wallTeam ) )
			{
				if ( EffectDoesExist( fxHandle.value ) )
				{
					EffectStop( fxHandle.value, true, false )
					fxHandle.value = 0
				}
			}
			else
			{
				float chargeFrac = GetChargeFracForPlayerFromChargeTracker( player, tracker )

				if ( GradeFlagsHas( wall, eGradeFlags.IS_BUSY ) )
				{
					chargeFrac = 0
				}

				int newChargeLevel = GetWallChargeLevelForFX( chargeFrac )
				if ( newChargeLevel != currentChargeLevel )
				{
					if ( EffectDoesExist( fxHandle.value ) )
					{
						EffectStop( fxHandle.value, true, false )
						fxHandle.value = 0
					}

					currentChargeLevel = newChargeLevel
					if ( newChargeLevel > 0 )
					{
						int fxIndex = GetParticleSystemIndex( GetWallChargeFXForLevel( newChargeLevel ) )
						fxHandle.value = StartParticleEffectOnEntity( wall, fxIndex, FX_PATTACH_POINT_FOLLOW, wall.LookupAttachment( "charge_tracker" ) )
					}
				}

			}
			WaitFrame()
		}
	}
}
int function GetWallChargeLevelForFX( float chargeFrac )
{
	if ( chargeFrac <= 0.0 )
		return 0

	if ( chargeFrac < 0.33 )
		return 1

	if ( chargeFrac < 0.67 )
		return 2

	if ( chargeFrac < 0.99 )
		return 3

	return 4

}

asset function GetWallChargeFXForLevel( int level )
{
	switch( level )
	{
		case 1:
			return WALL_CHARGE_AMOUNT_LV1_FX
		case 2:
			return WALL_CHARGE_AMOUNT_LV2_FX
		case 3:
			return WALL_CHARGE_AMOUNT_LV3_FX
		case 4:
			return WALL_CHARGE_AMOUNT_LV4_FX
	}

	return $""
}

vector function CoverWall_OffsetDamageNumbersLower( entity wall, vector damageFlyoutPosition )
{
	return ( damageFlyoutPosition - < 0, 0, wall.GetBoundingMaxs().z/2.0 > )
}

void function CoverWall_OnGainFocus( entity ent )
{
	if ( !IsValid( ent ) )
		return

	if ( ent.GetScriptName() == BASE_WALL_SCRIPT_NAME )
	{
		entity viewPlayer = GetLocalViewPlayer()
		if ( IsValid( viewPlayer ) )
		{
			entity activeWeapon = viewPlayer.GetActiveWeapon( eActiveInventorySlot.mainHand )
			if ( IsValid( activeWeapon ) && activeWeapon.GetWeaponBaseClassName() != COVER_WALL_WEAPON_NAME )
			{
				CustomUsePrompt_Show( ent )
			}
		}
	}
}

void function CoverWall_OnLoseFocus( entity ent )
{
	CustomUsePrompt_ClearForAny()
}



void function MinimapPackage_RampartWall( entity ent, var rui )
{
#if MINIMAP_DEBUG
		printt( "Adding 'rui/hud/tactical_icons/tactical_rampart' icon to minimap" )
#endif
	RuiSetImage( rui, "defaultIcon", $"rui/hud/tactical_icons/tactical_rampart" )
	RuiSetImage( rui, "clampedDefaultIcon", $"rui/hud/tactical_icons/tactical_rampart" )
	RuiSetBool( rui, "useTeamColor", false )
	RuiSetFloat( rui, "iconBlend", 0.0 )
}

