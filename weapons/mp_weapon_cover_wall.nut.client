void function OnSpectatorTargetChanged( entity player, entity previousTarget, entity currentTarget )
{
	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		Signal( player, COVER_WALL_CHANGED_TEAMS_SIGNAL )
	}

	if ( currentTarget )
	{
		thread CoverFireSpectatorTargetChangedDelay_Thread( currentTarget )
	}
}


