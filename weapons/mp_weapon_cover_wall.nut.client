entity function GetChargedWallTrackerEntFromWall( entity wall )
{
	Assert( IsCoverWallEnt( wall ) )

	return FindScriptNameInChildren( wall, WALL_CHARGE_TRACKER_SCRIPT_NAME, false )
}

void function CoverWall_UpdateTrackingOnTeamChanged( entity player, int oldTeam, int newTeam )
{

























	Signal( player, COVER_WALL_CHANGED_TEAMS_SIGNAL )
}
















float function GetChargeFracForPlayerFromWall( entity player, entity wall )
{
	Assert( tuning.speedBoostBasedOnAmpDamage )

	entity tracker = GetChargedWallTrackerEntFromWall( wall )

	return GetChargeFracForPlayerFromChargeTracker( player, tracker )
}

float function GetChargeFracForPlayerFromChargeTracker( entity player, entity tracker )
{

	if ( !IsValid( tracker ) )
		return 0.0

	int index = player.GetTeamMemberIndex()

	if ( index < 0 )
	{
		Warning("Player " + player + "doesn't have a valid team member index. this is likely due to changing teams while connecting to a match." )

		return 0.0
	}

	
	const int PROP_MAX_SQUAD_SIZE = 6
	if ( index >= PROP_MAX_SQUAD_SIZE )
	{
		Warning("More than max allowed players on a squad, charged walls won't work for them")

		return 0.0
	}

	return tracker.GetChargeFracByIndex( index )
}










































#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________SpeedBoost___________________________(){}
#endif




















































































void function StartAmpedSpeedVisualEffect( entity player, int statusEffect, bool actuallyChanged )
{
	if ( player != GetLocalViewPlayer() )
		return

	player.Signal( COVER_WALL_STOP_AMPED_SPEED_EFFECT )
	thread (void function() : ( player, statusEffect ) {
		player.EndSignal( "OnDeath", "OnDestroy", "BleedOut_OnStartDying", COVER_WALL_STOP_AMPED_SPEED_EFFECT )

		int fxHandle = StartParticleEffectOnEntityWithPos( player,
			GetParticleSystemIndex( AMPED_SPEED_1P_SCREEN_FX ),
			FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, player.EyePosition(), <0, 0, 0> )

		EffectSetIsWithCockpit( fxHandle, true )

		
		EffectSetControlPointVector( fxHandle, 1, <1.0, 999, 0> )
		EffectSetControlPointVector( fxHandle, 3, <0.8,0.8,0.8> )

		OnThreadEnd( function() : ( player, fxHandle ) {
			CleanupFXHandle( fxHandle, false, true )
			StopSoundOnEntityByName( player, AMPED_SPEED_SFX_1P )
		} )

		float remainingTime = StatusEffect_GetTimeRemaining( player, statusEffect )

		EmitSoundOnEntityWithSeek( player, AMPED_SPEED_SFX_1P, (tuning.speedBoostDurationAtMaxDamage - remainingTime) )

		while( true )
		{
			float newRemainingTime = StatusEffect_GetTimeRemaining( player, statusEffect )

			if ( newRemainingTime > remainingTime )
			{
				thread StartAmpedSpeedVisualEffect( player, statusEffect, true )
				return
			}
			remainingTime = newRemainingTime

			WaitFrame()
		}
	})()
}

void function StopAmpedSpeedVisualEffect( entity player, int statusEffect, bool actuallyChanged )
{
	if ( player != GetLocalViewPlayer() || (GetLocalViewPlayer() == GetLocalClientPlayer() && !actuallyChanged) )
		return

	player.Signal( COVER_WALL_STOP_AMPED_SPEED_EFFECT )
}


