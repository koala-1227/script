struct
{
	float delayBeforeSwitchingFromUlt = 0.6

	int startingHealth = 100

	bool showWallHealthRui = false

	bool speedBoostBasedOnAmpDamage = true
	bool speedBoostShowFx = true
	float speedBoostDurationAtMaxDamage = 15.0
	float speedBoostDebounce = 0.2
































































} tuning

void function MpWeaponCoverWall_Init()
{
	SetupTuning()

	Remote_RegisterServerFunction( "ClientCallback_TryPickupCoverWall", "typed_entity", "prop_script" )

	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		RegisterNetworkedVariable( COVER_FIRE_ACTIVE_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_BOOL )
	}




























		RegisterConCommandTriggeredCallback( "+scriptCommand5", OnCharacterButtonPressed )

		AddCallback_UseEntGainFocus( CoverWall_OnGainFocus )
		AddCallback_UseEntLoseFocus( CoverWall_OnLoseFocus )

		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.RAMPART_WALL, MINIMAP_OBJECT_RUI, MinimapPackage_RampartWall, FULLMAP_OBJECT_RUI, MinimapPackage_RampartWall )

		RegisterNetVarBoolChangeCallback( COVER_FIRE_ACTIVE_NETVAR, CoverFireNetvarChangedCallback )
		AddOnSpectatorTargetChangedCallback( OnSpectatorTargetChanged )

		if ( tuning.speedBoostBasedOnAmpDamage )
		{
			StatusEffect_RegisterEnabledCallback( eStatusEffect.rampart_amped_speed, StartAmpedSpeedVisualEffect )
			StatusEffect_RegisterDisabledCallback( eStatusEffect.rampart_amped_speed, StopAmpedSpeedVisualEffect )
		}



	RegisterSignal( "CoverWall_PickedUp" )




	if ( tuning.speedBoostBasedOnAmpDamage )
	{
		AddCallback_OnPlayerChangedTeam( CoverWall_UpdateTrackingOnTeamChanged )

		RegisterSignal( COVER_WALL_STOP_AMPED_SPEED_EFFECT )
		RegisterSignal( COVER_WALL_CHANGED_TEAMS_SIGNAL )





	}

	PrecacheScriptString( BASE_WALL_SCRIPT_NAME )
	PrecacheScriptString( AMPED_WALL_SCRIPT_NAME )
	PrecacheScriptString( AMPED_WALL_MOVER_SCRIPTNAME )
	PrecacheScriptString( HEALTH_TICKS_SCRIPT_NAME )
	PrecacheScriptString( AMPED_ROOF_SCRIPT_NAME )
	PrecacheScriptString( WALL_BOOST_TRIGGER_SCRIPT_NAME )
	PrecacheScriptString( WALL_AREA_TRIGGER_SCRIPT_NAME )
	PrecacheScriptString( WALL_CHARGE_TRACKER_SCRIPT_NAME )

	PrecacheModel( COVER_WALL_MODEL )
	PrecacheModel( COLLISION_CYLINDER_MODEL )
	PrecacheModel( DEPLOYABLE_SHIELD_MODEL )
	PrecacheModel( HEALTH_TICKS_MODEL )
	PrecacheModel( AMPED_ROOF_MODEL )

	PrecacheParticleSystem( DEPLOYABLE_SHIELD_FX_AMPED )
	PrecacheParticleSystem( AMPED_WALL_DESTROYED_FX )
	PrecacheParticleSystem( AMPED_WALL_PACKED_UP_FX )
	PrecacheParticleSystem( AMPED_SPEED_1P_SCREEN_FX )
	PrecacheParticleSystem( DEPLOYABLE_SHIELD_ROOF_FX )
	PrecacheParticleSystem( WALL_CHARGE_AMOUNT_LV1_FX )
	PrecacheParticleSystem( WALL_CHARGE_AMOUNT_LV2_FX )
	PrecacheParticleSystem( WALL_CHARGE_AMOUNT_LV3_FX )
	PrecacheParticleSystem( WALL_CHARGE_AMOUNT_LV4_FX )
	PrecacheParticleSystem( WALL_REGEN_FX )
	PrecacheParticleSystem( COVER_FIRE_3P_FX )

	PrecacheParticleSystem( BASE_WALL_DESTROYED_FX )
	PrecacheParticleSystem( BASE_WALL_DAMAGE_STATE_TRANSITION_FX )
	file.persistentDamageFxIndex = PrecacheParticleSystem( BASE_WALL_DAMAGE_STATE_PERSISTENT_FX )
	PrecacheParticleSystem( BASE_WALL_TAKE_DAMAGE_WHILE_HEALTH_LOW_FX )


		PrecacheParticleSystem( COVER_FIRE_1P_FX )

		AddCreateCallback( "prop_script", CoverWall_OnPropScriptCreated )
		AddDestroyCallback( "prop_script", CoverWall_OnPropScriptDestroyed )

		

}

void function SetupTuning()
{
	RegisterTuningStruct( "tuning", "rampart_wall_" )



}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________Getters___________________________(){}
#endif
bool function IsAmpedWallEnt( entity ent )
{
	bool isAmpedWall = ent.GetScriptName() == AMPED_WALL_SCRIPT_NAME

	if ( !isAmpedWall )
	{
		isAmpedWall = ent.GetScriptName() == AMPED_ROOF_SCRIPT_NAME
	}

	return isAmpedWall
}

bool function IsCoverWallEnt( entity ent )
{
	return ent.GetScriptName() == BASE_WALL_SCRIPT_NAME
}

entity function GetAmpedWallForBase( entity baseWall )
{
	foreach( entity ent in baseWall.GetLinkEntArray() )
	{
		if ( IsAmpedWallEnt( ent ) )
			return ent
	}

	return null
}

entity function GetBaseWallFromAmped( entity amped )
{
	if ( amped.GetScriptName() == AMPED_WALL_SCRIPT_NAME )
	{
		return amped.GetParent()
	}
	else if ( amped.GetScriptName() == AMPED_ROOF_SCRIPT_NAME )
	{
		entity otherShield = amped.GetParent()
		if ( IsValid( otherShield ) )
		{
			return otherShield.GetParent()
		}
	}

	return null
}

entity function GetOtherAmpedShieldFromAmpedShield( entity ampedShield )
{
	if ( ampedShield.GetScriptName() == AMPED_WALL_SCRIPT_NAME )
	{
		foreach ( entity child in ampedShield.GetChildren() )
		{
			if ( IsValid( child ) && child.GetScriptName() == AMPED_ROOF_SCRIPT_NAME )
				return child
		}
	}
	else if ( ampedShield.GetScriptName() == AMPED_ROOF_SCRIPT_NAME )
	{
		return ampedShield.GetParent()
	}

	return null
}











