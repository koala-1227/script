void function _____________WeaponFuncs___________________________(){}
#endif
void function OnWeaponActivate_weapon_cover_wall( entity weapon )
{
	entity ownerPlayer = weapon.GetWeaponOwner()
	weapon.w.startChargeTime = Time()

	Assert( ownerPlayer.IsPlayer() )

	if ( !IsLocalClientPlayer( ownerPlayer ) || IsWatchingKillReplay() )
		return

	string hintText = "#WPN_COVER_WALL_PLAYER_DEPLOY_HINT"
	AddPlayerHint( 120, 0, $"", hintText )

}


void function OnWeaponDeactivate_weapon_cover_wall( entity weapon )
{
	entity ownerPlayer = weapon.GetWeaponOwner()
	Assert( ownerPlayer.IsPlayer() )

	if ( !IsLocalClientPlayer( ownerPlayer ) )
		return

	HidePlayerHint( "#WPN_COVER_WALL_PLAYER_DEPLOY_HINT" )


	file.playersWithFastSwitch.fastremovebyvalue( ownerPlayer )






}

bool function OnWeaponAttemptOffhandSwitch_weapon_cover_wall( entity weapon )
{
	entity player = weapon.GetWeaponOwner()

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	entity ultWeapon = player.GetOffhandWeapon( eOffhandInv.ULTIMATE )
	entity placementWeapon = player.GetOffhandWeapon( eOffhandInv.BOMBARDMENT )

	if( IsValid( ultWeapon ) && ultWeapon.GetWeaponClassName() == MOBILE_HMG_WEAPON_NAME && IsValid( placementWeapon ) && placementWeapon.GetWeaponClassName() == MOUNTED_TURRET_PLACEABLE_WEAPON_NAME
			&& ( activeWeapon == ultWeapon || activeWeapon == placementWeapon ) )
	{
		float timeSinceStart = Time() - ultWeapon.w.startChargeTime
		if( timeSinceStart < tuning.delayBeforeSwitchingFromUlt )
			return false
	}

	return true
}


void function OnCreateClientOnlyModel_weapon_cover_wall( entity weapon, entity model, bool validHighlight )
{
	if ( validHighlight )
	{
		DeployableModelHighlight( model )
	}
	else
	{
		DeployableModelInvalidHighlight( model )
	}
}


var function OnWeaponPrimaryAttack_weapon_cover_wall( entity weapon, WeaponPrimaryAttackParams attackParams )
{
	
	if ( !weapon.ObjectPlacementHasValidSpot() )
	{
		weapon.DoDryfire()
		return 0
	}

	entity ownerPlayer = weapon.GetWeaponOwner()
	Assert( ownerPlayer.IsPlayer() )









	if ( file.playersWithFastSwitch.contains( ownerPlayer ) )
	{
		weapon.AddMod( "fast_place" )
	}

	PlayerUsedOffhand( ownerPlayer, weapon )
	return weapon.GetAmmoPerShot()
}

void function OnWeaponStartZoomIn_weapon_cover_wall( entity weapon )
{
	entity ownerPlayer = weapon.GetWeaponOwner()

	if ( !IsValid( ownerPlayer ) )
		return


		if ( ownerPlayer != GetLocalViewPlayer() )
			return


	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )
	if ( serverOrPredicted )
	{
		file.playersWithFastSwitch.append( ownerPlayer )
	}
}

void function OnWeaponStartZoomOut_weapon_cover_wall( entity weapon )
{
	entity ownerPlayer = weapon.GetWeaponOwner()
	if ( !IsValid( ownerPlayer ) )
		return

	if ( file.playersWithFastSwitch.contains( ownerPlayer ) )
		return


		if ( ownerPlayer != GetLocalViewPlayer() )
			return

	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )
	if ( serverOrPredicted )
	{
		if ( !weapon.HasMod( "fast_place" ) )
		{
			file.playersWithFastSwitch.fastremovebyvalue( ownerPlayer )
		}
	}
}













































































































































































































































































































































































































































































































































































































































































































































































































#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________PickupAndReclaimWall___________________________(){}
#endif
bool function IsEnemyBlockingRemoteReclaim( entity baseWall )
{
	entity owner = baseWall.GetOwner()
	if( !IsValid( owner ) )
		return false
	int team = owner.GetTeam()
	array<entity> enemies = GetPlayerArrayOfEnemies_Alive( team )
	array<entity> nearbyEnemies = GetEntitiesFromArrayNearPos( enemies, baseWall.GetOrigin(), Perk_QuickPackup_GetRemotePickupBlockRange() )
	return nearbyEnemies.len() > 0
}

bool function CanReclaimWall( entity baseWall )
{
	entity ampedWall = GetAmpedWallForBase( baseWall )

	if ( !IsValid( baseWall ) )
		return false

	if ( !IsValid( ampedWall) )
	{
		if ( baseWall.GetMaxHealth() != tuning.startingHealth )
			return false
	}

	if ( baseWall.GetHealth() <= 0 )
		return false

	if ( IsValid( ampedWall ) && ampedWall.GetHealth() <= 0 )
		return false

	if ( baseWall.GetHealth() < baseWall.GetMaxHealth() )
		return false

	if ( IsValid( ampedWall ) && ampedWall.GetHealth() < ampedWall.GetMaxHealth() )
		return false

	return true
}
































































































































































































































































































































































































































































































































































































































































































































































