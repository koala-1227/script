bool function OctaneStimSurge_IsEnabled()
{
	
	return tuning.stimSurgeEnabled
}
























































































































































































































































float function OctaneStimSurge_GetDuration( entity player )
{
	float duration = tuning.stimSurgeDuration
	if ( PlayerHasPassive( player, ePassives.PAS_OCTANE ) && PlayerHasPassive( player, ePassives.PAS_PAS_UPGRADE_ONE ) ) 
	{
		float durationScalar = GraphCapped( player.GetHealth(), 0.0, player.GetMaxHealth(), 1.0, 0.0 )
		duration += tuning.stimSurgeExtraHPMaxTime * durationScalar
	}

	return duration
}

float function OctaneStimSurge_GetCooldownDuration( entity player, bool hasLegendExpert )
{
	if( IsInfiniteAmmoEnabled() )
	{
		const float NO_COOLDOWN = 0.0
		return NO_COOLDOWN
	}

	float stimSurgeCooldown = tuning.stimSurgeCooldown
	if( hasLegendExpert )
	{
		stimSurgeCooldown  *= tuning.legendExpertScalar
	}
	return stimSurgeCooldown
}












































void function OctaneStimSurge_StartClientVisualEffect( entity player, int statusEffect, bool actuallyChanged )
{
	if ( !actuallyChanged && GetLocalViewPlayer() == GetLocalClientPlayer() )
		return

	if ( player != GetLocalViewPlayer() )
		return

	thread OctaneStimSurge_ClientVisualEffectThread( player )
	StimSurge_UpdateWidgetAnimation( playTacAnim.EXTEND )
}

void function OctaneStimSurge_StopClientVisualEffect( entity player, int statusEffect, bool actuallyChanged )
{
	if ( !actuallyChanged && GetLocalViewPlayer() == GetLocalClientPlayer() )
		return

	if ( player != GetLocalViewPlayer() )
		return

	Signal( player, STIM_SURGE_STOP_CLIENT )
	StimSurge_UpdateWidgetAnimation( playTacAnim.HIDE )
}

void function OctaneStimSurge_OnTimeNetvarChanged( entity player, float availableTime )
{
	thread OctaneStimSurge_PlayCooldownSoundThread( player, availableTime )
}

void function OctaneStimSurge_PlayCooldownSoundThread( entity player, float availableTime )
{
	EndSignal( player, "OnDeath", "OnDestroy" )

	wait availableTime - Time()

	const string ABILITY_READY_SOUND = "survival_ui_tactical_ready"
	EmitSoundOnEntity( player, ABILITY_READY_SOUND )
}

void function OctaneStimSurge_ClientVisualEffectThread( entity player )
{
	Assert ( IsNewThread(), "Must be threaded off." )
	EndSignal( player, "OnDeath", "OnDestroy", "BleedOut_OnStartDying" )
	EndSignal( player, STIM_SURGE_STOP_CLIENT )

	entity viewPlayer = GetLocalViewPlayer()
	int stimSurge1pFx = StartParticleEffectOnEntity( viewPlayer, GetParticleSystemIndex( STIM_SURGE_1P_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )

	ColorCorrection_SetExclusive( file.colorCorrection, true )

	const float COLOR_FADE_IN			= 0.1
	const float COLOR_DURATION			 = 2.0
	float fadeInEndTime					= Time() + COLOR_FADE_IN
	float firstFadeTime					= Time() + COLOR_FADE_IN + COLOR_DURATION
	float stimSurgeEndTime 				= Time() + OctaneStimSurge_GetDuration( player )
	const float COLOR_MIN 				= 0.07
	const float COLOR_DEFAULT			= 0.25
	const float COLOR_MAX 				= 1.0

	OnThreadEnd(
		function() : ( player, stimSurge1pFx )
		{
			if ( IsValid( player ) )
			{
				if ( EffectDoesExist( stimSurge1pFx ) )
				{
					EffectStop( stimSurge1pFx, true, false )
				}
				thread OctaneStimSurge_FadeOutColor( player )
			}
		}
	)

	while( Time() < fadeInEndTime )
	{
		float colorWeight = GraphCapped( fadeInEndTime - Time(), COLOR_FADE_IN, 0, COLOR_MIN, COLOR_MAX )
		ColorCorrection_SetWeight( file.colorCorrection, colorWeight )
		WaitFrame()
	}

	ColorCorrection_SetWeight( file.colorCorrection, COLOR_MAX )

	while( Time() <  firstFadeTime )
	{
		float colorWeight = GraphCapped( firstFadeTime - Time(), COLOR_DURATION, 0, COLOR_MAX, COLOR_DEFAULT )
		ColorCorrection_SetWeight( file.colorCorrection, colorWeight )
		WaitFrame()
	}

	WaitForever()
}

void function OctaneStimSurge_FadeOutColor( entity player)
{
	EndSignal( player, "OnDeath", "OnDestroy" )
	OnThreadEnd(
		function() : ()
		{
			ColorCorrection_SetWeight( file.colorCorrection, 0.0 )
			ColorCorrection_SetExclusive( file.colorCorrection, false )
		}
	)

	const float COLOR_FADE_OUT_DURATION = 0.2
	const float COLOR_MAX 				= 1.0
	float colorEndTime 					= Time() + COLOR_FADE_OUT_DURATION
	while( Time() < colorEndTime )
	{
		float colorWeight = GraphCapped( colorEndTime - Time(), COLOR_FADE_OUT_DURATION, 0, COLOR_MAX, 0.0 )
		ColorCorrection_SetWeight( file.colorCorrection, colorWeight )
		WaitFrame()
	}
}

var function GetOctaneStimSurgeTacticalRui()
{
	return file.stimSurgeRui
}

void function CreateOctaneStimSurgeTacticalRui( entity player )
{
	if( file.stimSurgeRui != null )
		return

	if ( OctaneStimSurge_IsEnabled() && PlayerHasPassive( player, ePassives.PAS_OCTANE ) )
	{
		file.stimSurgeRui = CreateCockpitPostFXRui( $"ui/octane_stim_surge_tactical.rpak", HUD_Z_BASE )
		UpdateStimSurgeRui( player )



	}
}

void function DestroyOctaneStimSurgeTacticalRui( entity player )
{
	if( !OctaneStimSurge_IsEnabled() || !PlayerHasPassive( player, ePassives.PAS_OCTANE ) )
	{
		if ( file.stimSurgeRui != null )
		{
			RuiDestroy( file.stimSurgeRui )
			file.stimSurgeRui = null
		}
	}
}

void function StimSurge_WeaponStatusCheck( entity player, var rui, int slot )
{
	if ( !OctaneStimSurge_IsEnabled() || !PlayerHasPassive( player, ePassives.PAS_OCTANE ) )
		return

	if( slot == eOffhandInv.TACTICAL )
	{
		entity offhandWeapon = player.GetOffhandWeapon( eOffhandInv.TACTICAL )

		if ( IsValid( offhandWeapon ) && file.stimSurgeRui != null )
		{
			UpdateStimSurgeRui( player )
		}
		
		RuiSetBool( rui, "isVisible", false )
	}

}

void function StimSurge_UpdateWidgetAnimation( int playMode )
{
	if (file.stimSurgeRui == null)
		return

	if ( playMode == playTacAnim.EXTEND )
	{
		RuiSetBool( file.stimSurgeRui, "extendSurgeWidgetFlag", true )
		RuiSetFloat( file.stimSurgeRui, "surgeStartTime", Time() )
	}
	else if ( playMode == playTacAnim.HIDE )
	{
		RuiSetBool( file.stimSurgeRui, "hideSurgeWidgetFlag", true )
	}
	else
	{
		RuiSetBool( file.stimSurgeRui, "extendSurgeWidgetFlag", false )
		RuiSetBool( file.stimSurgeRui, "hideSurgeWidgetFlag", false )
	}
}

void function UpdateStimSurgeRui( entity player )
{
	if ( !IsValid( player ) || player != GetLocalViewPlayer() )
		return

	RuiTrackFloat( file.stimSurgeRui, "isInSurge", player, RUI_TRACK_STATUS_EFFECT_SEVERITY, eStatusEffect.octane_stim_surge )
	RuiTrackFloat(file.stimSurgeRui, "isInStim", player, RUI_TRACK_STATUS_EFFECT_SEVERITY, eStatusEffect.stim_visual_effect )

	RuiTrackFloat( file.stimSurgeRui, "cooldownTimeEnd", player, RUI_TRACK_SCRIPT_NETWORK_VAR, GetNetworkedVariableIndex( STIM_SURGE_AVAILABLE_TIME_NETVAR ) )

	RuiSetFloat( file.stimSurgeRui, "totalCooldownTime", OctaneStimSurge_GetCooldownDuration( player, PlayerHasPassive( player, ePassives.PAS_AUGMENT_LEGEND_EXPERT ) ) )
	if( !StatusEffect_HasSeverity( player, eStatusEffect.octane_stim_surge ) )
	{
		RuiSetFloat( file.stimSurgeRui, "stimsurgeDuration", OctaneStimSurge_GetDuration(  player ) )
	}

	RuiTrackFloat( file.stimSurgeRui, "bleedoutEndTime", player, RUI_TRACK_SCRIPT_NETWORK_VAR, GetNetworkedVariableIndex( "bleedoutEndTime" ) )


		if ( StatusEffect_HasSeverity( player, eStatusEffect.is_boxing ) )
			RuiSetBool( file.stimSurgeRui, "isBoxing", true )
		else
			RuiSetBool( file.stimSurgeRui, "isBoxing", false )



}

