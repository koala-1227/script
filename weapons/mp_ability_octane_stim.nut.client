global function OctaneStim_Init


global function CreateOctaneStimSurgeTacticalRui
global function DestroyOctaneStimSurgeTacticalRui
global function GetOctaneStimSurgeTacticalRui

global function OctaneStim_OnWeaponActivate
global function OctaneStim_OnWeaponDeactivate
global function OctaneStim_OnWeaponChargeBegin
global function OctaneStim_OnWeaponChargeEnd
global function OctaneStim_OnWeaponAttemptOffhandSwitch

global function OctaneStim_GetStimDuration

const float STIM_DURATION 			 	= 6.0
const int	STIM_HEALTH_COST 		 	= 20
const int 	STIM_HEALTH_COST_UPGRADE 	= 5

const float STIM_SURGE_ACTIVE_FADE_OUT	= 0.6
const string STIM_SURGE_ACTIVE_MOD		= "octane_stim_surge_active"
const string STIM_SURGE_INPUT_MOD		= "octane_stim_surge_input"
const string STIM_SURGE_INPUT_STOP		= "octane_stim_surge_input_stop"
const string STIM_SURGE_STOP	 		= "stim_surge_stop"
const asset STIM_SURGE_3P_FX 			= $"P_pilot_stim_surge_hld"
global const string STIM_WEAPON_NAME	= "mp_ability_octane_stim"

const string STIM_SURGE_STOP_CLIENT		= "stim_surge_stop_client"
const asset STIM_SURGE_1P_FX 			= $"P_octane_stim_surge_FP"


global const string STIM_SURGE_AVAILABLE_TIME_NETVAR = "octane_stim_surge_cooldown_time"

struct
{

	int colorCorrection
	var stimSurgeRui

	table< entity, bool > 	isTacHeld
}file

struct
{
	bool stimSurgeEnabled 			= true
	bool stimSurgeFromHealth		= false
	bool stimSurgeFromButton		= true
	bool stimSurgeGivesFortified    = false
	int stimSurgeHealthCost			= 0
	float stimSurgeHealthThreshold 	= 0.5
	float stimSurgeDuration 		= 6.0
	float stimSurgeDamageScale		= 0.85
	float stimSurgeCooldown			= 26.0
	float legendExpertScalar		= 0.66
	float stimSurgeExtraHPMaxTime	= 6.0
	int stimUpgradeHealthReduction	= 5
	int stimSurgeVOChance			= 30
} tuning


enum playTacAnim
{
	DONT_PLAY = 0,
	EXTEND,
	HIDE
}


void function OctaneStim_Init()
{
	RegisterTuningStruct( "tuning", "octane_tac_" )

	RegisterSignal( STIM_SURGE_STOP )
	RegisterSignal( STIM_SURGE_INPUT_STOP )
	PrecacheParticleSystem( STIM_SURGE_3P_FX )
	RegisterNetworkedVariable( STIM_SURGE_AVAILABLE_TIME_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_TIME , -1.0 )






		RegisterSignal( STIM_SURGE_STOP_CLIENT )
		PrecacheParticleSystem( STIM_SURGE_1P_FX )
		StatusEffect_RegisterEnabledCallback( eStatusEffect.octane_stim_surge, OctaneStimSurge_StartClientVisualEffect )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.octane_stim_surge, OctaneStimSurge_StopClientVisualEffect )
		file.colorCorrection = ColorCorrection_Register( "materials/correction/octane_stim_surge.raw_hdr" )

		AddCallback_CreatePlayerPassiveRui( CreateOctaneStimSurgeTacticalRui )
		AddCallback_DestroyPlayerPassiveRui( DestroyOctaneStimSurgeTacticalRui )

		AddCallback_OnWeaponStatusUpdate( StimSurge_WeaponStatusCheck )
		RegisterNetVarTimeChangeCallback( STIM_SURGE_AVAILABLE_TIME_NETVAR, OctaneStimSurge_OnTimeNetvarChanged )

}

int function OctaneStim_GetHealthCost( entity weapon )
{
	int result = GetCurrentPlaylistVarInt( "octane_health_cost", STIM_HEALTH_COST )
	entity owner = weapon.GetOwner()
	if( !IsValid( weapon ) )
		return result
	if( !IsValid( owner ) )
		return result

	if( owner.HasPassive( ePassives.PAS_TAC_UPGRADE_ONE ) ) 
	{
		result -= tuning.stimUpgradeHealthReduction
	}


	return result
}

float function OctaneStim_GetStimDuration()
{
	float duration = GetCurrentPlaylistVarFloat( "octane_stim_duration", STIM_DURATION )
	return duration
}

#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________WEAPON_CALLBACKS___________________________(){}
#endif
void function OctaneStim_OnWeaponActivate( entity weapon )
{
	entity owner = weapon.GetWeaponOwner()
	if ( !IsValid( owner ) )
		return









	if( InPrediction() && IsFirstTimePredicted() )

	{
		if( weapon.HasMod( STIM_SURGE_ACTIVE_MOD ) )
		{
			weapon.SetWeaponChargeFraction( 0.0 )
		}
		else
		{



		}
	}
	const string AKIMBO_ACTIVE_MOD = "akimbo_active"


	if ( InPrediction() )

	{
		if ( owner.GetAkimboState() == AKIMBO_STATE_ACTIVE || owner.GetAkimboState() == AKIMBO_STATE_OFFHAND)
		{
			weapon.AddMod( AKIMBO_ACTIVE_MOD )

				if ( owner == GetLocalViewPlayer() )
					EmitSoundOnEntity( owner,  weapon.GetWeaponSettingString( eWeaponVar.charge_sound_1p ) )

		}
		else
		{
			weapon.RemoveMod( AKIMBO_ACTIVE_MOD )
		}
	}
}

void function OctaneStim_OnWeaponDeactivate( entity weapon )
{










}

bool function OctaneStim_OnWeaponChargeBegin( entity weapon )
{
	entity owner = weapon.GetWeaponOwner()
	if( !IsValid( owner ) )
		return false


	if( weapon.HasMod( STIM_SURGE_ACTIVE_MOD ) )
	{
		if( tuning.stimSurgeFromButton && StatusEffect_HasSeverity( owner, eStatusEffect.octane_stim_surge ) )
			return false



	}
	else
	{




		float duration     = OctaneStim_GetStimDuration()






















		StimPlayerWithOffhandWeapon( owner, duration, weapon )









			Rumble_Play( "rumble_stim_activate", {} )

	}
	return true
}


void function OctaneStim_OnWeaponChargeEnd( entity weapon )
{













}


bool function OctaneStim_OnWeaponAttemptOffhandSwitch( entity weapon )
{
	entity owner = weapon.GetWeaponOwner()
	if( !IsValid( owner ) )
		return false

	entity activeTacWeapon = owner.GetActiveWeapon( eActiveInventorySlot.altHand )

	entity activeAltHand = owner.GetActiveWeapon( eActiveInventorySlot.altHand )
	bool isAltHandFree = !IsValid( activeAltHand ) || activeAltHand != weapon

	if ( StatusEffect_HasSeverity( owner, eStatusEffect.octane_stim_surge ) )
		return false

	if( StatusEffect_HasSeverity( owner, eStatusEffect.stim_visual_effect ) )
	{
		if( weapon.HasMod( STIM_SURGE_ACTIVE_MOD ) )
			return false
		else if( Time() < owner.GetPlayerNetTime( STIM_SURGE_AVAILABLE_TIME_NETVAR ) )
			return false
		else if( weapon.HasMod( STIM_SURGE_INPUT_MOD ) )
			return true
	}
	else if( !isAltHandFree )
	{
		return false
	}


	if( !IsValid( activeTacWeapon ) )
		return true

	if ( StatusEffect_HasSeverity( owner, eStatusEffect.stim_visual_effect ) )
	{
		return false
	}

	return true
}

