void function MpWeaponMeleeBat_Init()
{
	if ( !MeleeBat_IsEnabled() )
	{
		SURVIVAL_Loot_AddDisabledRef( WEAPON_MELEE_BAT_REF )
		return
	}

	MeleeWeaponInterface meleeWeaponInterface
	meleeWeaponInterface.callback_OnMeleeHit                   = MeleeBat_OnMeleeHit
	meleeWeaponInterface.callback_GetCustomKnockbackForce      = MeleeBat_GetCustomKnockbackForce
	meleeWeaponInterface.callback_PerformCustomVictimKnockback = MeleeBat_PerformCustomVictimKnockback
	Melee_RegisterMeleeWeaponInterface( WEAPON_MELEE_BAT_REF, meleeWeaponInterface )

	RegisterNetworkedVariable( MELEE_BAT_SPEED_BOOST_BEST_TARGET_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_ENTITY )
	RegisterNetworkedVariable( MELEE_BAT_SPEED_BOOST_CHARGE_END_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_TIME, -1 )

	






	Melee_AddCallback_OnMeleeAttackAnimEvent( MeleeBat_OnMeleeAttackAnimEvent )

	RegisterScriptAnimWindowCallbacks( MELEE_BAT_VFX_CALLBACK_NAME, MeleeBat_ScriptAnimWindowStartCallback, MeleeBat_ScriptAnimWindowStopCallback )


		RegisterNetVarEntityChangeCallback( MELEE_BAT_SPEED_BOOST_BEST_TARGET_NETVAR, Start_SpeedBoost_Rui )

		RegisterSignal( SIGNAL_MELEE_BAT_HEAT_HUD_UPDATE )
		RegisterSignal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )

		StatusEffect_RegisterEnabledCallback( eStatusEffect.speed_boost, MeleeBat_SpeedBoost_OnStatusEnabled )


	Remote_RegisterClientFunction( FUNCNAME_MeleeBat_ServerToClient_AcknowledgeBatPickup )

	RegisterSignal( SIGNAL_MELEE_BAT_SPEED_BOOST_STOP )
	RegisterSignal( SIGNAL_MELEE_BAT_SPEED_BOOST_TARGETING_STOP )

	PrecacheParticleSystem( BAT_FX_THRUSTER_SWIPE_L_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_SWIPE_R_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_L_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_R_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_cover_L_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_cover_R_FP )
	PrecacheParticleSystem( BAT_FX_IMPACT_CHARGED )
	PrecacheParticleSystem( BAT_FX_THRUSTER_CHARGED_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_CHARGED_3P )
	PrecacheParticleSystem( BAT_FX_THRUSTER_CHARGED_READY_FP )
	PrecacheParticleSystem( BAT_FX_THRUSTER_CHARGED_READY_3P )

	

	
	
	RegisterImpactTable( IMPACT_TABLE_MELEE_BAT_SLAM )
}




