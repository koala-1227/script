void function MeleeBat_SpeedBoost_OnStatusDisabled( entity player, int statusEffect, bool actuallyChanged )
{
	if ( !IsValid( player ) )
		return
}



void function MeleeBat_SpeedBoost_OnStatusEnabled( entity player, int statusEffect, bool actuallyChanged )
{
	if ( !IsValid( player ) )
		return

	if ( player != GetLocalViewPlayer() )
		return

	if ( !player.HasPassive( ePassives.PAS_MELEE_BAT_SPEED_BOOST ) )
		return

	if ( !IsValid( player.GetPlayerNetEnt( MELEE_BAT_SPEED_BOOST_BEST_TARGET_NETVAR ) ) )
		return

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	int fxHandle = StartParticleEffectOnEntity( cockpit, GetParticleSystemIndex( SPEED_BOOST_COCKPIT_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	thread MeleeBat_SpeedBoost_FX_Thread( player, fxHandle, cockpit )
}



void function MeleeBat_SpeedBoost_FX_Thread( entity player, int fxHandle, entity cockpit )
{
	if( player != GetLocalViewPlayer() )
		return

	EndSignal( player, "OnDestroy"  )
	EndSignal( player, "OnDeath" )
	EndSignal( player, SIGNAL_MELEE_BAT_SPEED_BOOST_TARGETING_STOP )
	EndSignal( cockpit,"OnDestroy" )

	OnThreadEnd(
		function() : ( fxHandle , player )
		{
			if ( !EffectDoesExist( fxHandle ) )
				return

			EffectStop( fxHandle, false, true )

			if( IsValid( player ) )
			{
				StopSoundOnEntity( player, SFX_MELEE_BAT_SPEED_BOOST_ACTIVATION_1P )
			}
		}
	)

	EmitSoundOnEntity( player, SFX_MELEE_BAT_SPEED_BOOST_ACTIVATION_1P )
	while( IsValid( player ) && EffectDoesExist( fxHandle ) )
	{
		float velocityX = Length( player.GetVelocity() )
		velocityX = GraphCapped( velocityX, 0.0, 360, 5, 200 )
		EffectSetControlPointVector( fxHandle, 1, <velocityX,999,0> )
		WaitFrame()
	}
}



void function Start_SpeedBoost_Rui( entity player, entity target )
{
	if ( !IsValid( player ) )
		return

	player.Signal( SIGNAL_MELEE_BAT_SPEED_BOOST_TARGETING_STOP )
	thread SpeeedBoost_Rui_Thread( player, target )
}



void function SpeeedBoost_Rui_Thread(  entity player, entity target )
{
	AssertIsNewThread()

	if ( !IsValid( player ) || !IsValid( target ) )
		return

	if ( GetGameState() >= eGameState.Resolution )
		return

	EndSignal( target, "OnDestroy", "OnDeath" )
	EndSignal( target, "OnModelChanged" )
	EndSignal( player, SIGNAL_MELEE_BAT_SPEED_BOOST_TARGETING_STOP )
	EndSignal( player, SIGNAL_MELEE_BAT_SPEED_BOOST_STOP )
	EndSignal( player, "OnDestroy" )

	var rui = RuiCreate( $"ui/in_world_targeted_speed_boost.rpak", clGlobal.topoFullScreen, RUI_DRAW_HUD, RuiCalculateDistanceSortKey( player.EyePosition(), target.GetOrigin() ) )
	InitHUDRui( rui )

	RuiSetBool( rui, "isVisible", false )
	RuiSetBool( rui, "isEnemyTarget", true )

	RuiKeepSortKeyUpdated( rui, true, "pos" )

	target.DoModelChangeScriptCallback( true )

	OnThreadEnd(
		function() : ( rui, target, player)
		{
			RuiDestroyIfAlive( rui )

			if ( IsValid( target ) && target.IsPlayer() )
			{
				target.DoModelChangeScriptCallback( false )
				target.SetTargetInfoStatusIcon( $"" )
			}
		}
	)

	while ( IsValid( player ) )
	{
		
		bool isValidTarget = IsValid( target )

		if ( isValidTarget )
		{
			RuiSetFloat3( rui, "pos", target.GetWorldSpaceCenter() )
			RuiSetBool( rui, "isVisible", true )

			
			RuiSetBool( rui, "showPassive", true )

			float chargeEndTime = player.GetPlayerNetTime( MELEE_BAT_SPEED_BOOST_CHARGE_END_NETVAR )
			float chargeTimeRemaining = chargeEndTime != -1 ? max( chargeEndTime - Time(), 0.0 ) : MELEE_BAT_SPEED_BOOST_ACTIVATION_TIME
			RuiSetFloat( rui, "passiveFill", 1.0 - chargeTimeRemaining / MELEE_BAT_SPEED_BOOST_ACTIVATION_TIME )
			RuiSetBool( rui, "enemyObstructing", CheckIfEnemyIsObstructing( player, target ) )
		}
		else
		{
			RuiSetBool( rui, "isVisible", false )
		}

		WaitFrame()
	}
}





