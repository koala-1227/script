void function _____________ANIMATION___________________________(){}
#endif

void function MeleeBat_OnWeaponCustomActivityStart( entity weapon, int activity, int sequence )
{
	if ( !IsValid( weapon ) )
		return

	switch( activity )
	{
		case ACT_VM_WEAPON_INSPECT:
		{

				weapon.Signal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )


			MeleeBat_ResetHitStreak( weapon )
			MeleeBat_ClearMods( weapon )
		}
		case ACT_VM_MELEE_ATTACK2:
		{

				if ( weapon.GetWeaponChargeLevel() == 0)
				{
					weapon.Signal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )
				}

		}
		default:
		{
			break
		}
	}
}

void function MeleeBat_OnWeaponCustomActivityEnd( entity weapon, int activity )
{
	if ( !IsValid( weapon ) )
		return

	switch ( activity )
	{
		case ACT_VM_MELEE_ATTACK2:
		{
			if ( file.wasLaunchAttack || MeleeBat_HasChargeLevelMod( weapon ) )
			{
				file.wasLaunchAttack = false
				MeleeBat_ResetHitStreak( weapon )
				MeleeBat_ClearMods( weapon )
			}
			else
			{
				weapon.TryUpdatingFullyHeated()
			}

			weapon.StopWeaponEffect( BAT_FX_THRUSTER_SWIPE_L_FP, BAT_FX_THRUSTER_SWIPE_L_3P )
			weapon.StopWeaponEffect( BAT_FX_THRUSTER_SWIPE_R_FP, BAT_FX_THRUSTER_SWIPE_R_3P )

			break
		}
		default:
		{
			break
		}
	}
}

void function MeleeBat_ScriptAnimWindowStartCallback( entity ent, string parameter )
{
	entity weapon = TryResolveScriptAnimWindowWeapon( ent )

	
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != WEAPON_MELEE_BAT_REF )
		return
}

void function MeleeBat_ScriptAnimWindowStopCallback( entity ent, string parameter )
{
	entity weapon = TryResolveScriptAnimWindowWeapon( ent )

	
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != WEAPON_MELEE_BAT_REF )
		return
}


void function MeleeBat_OnClientAnimEvent( entity weapon, string name )
{
	ClientCodeCallback_HandleClientAnimEvent( weapon, name )
}





