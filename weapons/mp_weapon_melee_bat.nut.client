void function _____________CHARGE___________________________(){}
#endif

bool function MeleeBat_OnWeaponChargeBegin( entity weapon )
{
	entity player = weapon.GetWeaponOwner()
	if ( !IsValid( player ) || !IsAlive( player ) )
		return false

	if ( weapon.IsWeaponInAds() && player.IsZiplining() )
		return false

#if DEV
		printt( "BAT - Charge Begin" )
#endif

	MeleeBat_ResetHitStreak( weapon )
	MeleeBat_ClearMods( weapon )


		if ( GetLocalViewPlayer() == player  )
		{
			thread MeleeBat_ChargeCrosshairRui_Thread( weapon , player )
		}

	return true
}

void function MeleeBat_OnWeaponChargeEnd( entity weapon )
{
	if ( !MeleeBat_IsEnabled() )
		return

	if ( !IsValid( weapon ) )
		return

#if DEV
		printt( "BAT - Charge End" )
#endif


		entity player = weapon.GetWeaponOwner()
		if ( !IsValid( player ) )
			return

		if ( !weapon.IsWeaponInAds() )
		{
			weapon.Signal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )
		}

}

bool function MeleeBat_OnWeaponChargeLevelIncreased( entity weapon )
{
	MeleeBat_ApplyModsForChargeLevel( weapon, weapon.GetWeaponChargeLevel() )

	return true
}

bool function MeleeBat_ApplyModsForChargeLevel( entity weapon, int level )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return false


	MeleeBat_ClearMods( weapon )
	if ( level > 0 )
	{
		weapon.AddMod( MELEE_BAT_CHARGE_MODS_BASE_STR + (level) )
#if DEV
			printt( "BAT - Charge Level: " + level )
#endif
		return true
	}

	return false
}

void function MeleeBat_ClearChargeLevelMods( entity weapon )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return


	for ( int i = MELEE_BAT_CHARGE_LEVEL_MIN; i <= weapon.GetWeaponChargeLevelMax(); i++ )
	{
		weapon.RemoveMod( MELEE_BAT_CHARGE_MODS_BASE_STR + i )
	}
}

bool function MeleeBat_HasChargeLevelMod( entity weapon )
{
	for ( int i = MELEE_BAT_CHARGE_LEVEL_MIN; i <= weapon.GetWeaponChargeLevelMax(); i++ )
	{
		if ( weapon.HasMod( MELEE_BAT_CHARGE_MODS_BASE_STR + i ) )
			return true
	}

	return false
}

int function MeleeBat_GetChargeLevelFromMod( entity weapon )
{
	for ( int i = MELEE_BAT_CHARGE_LEVEL_MIN; i <= weapon.GetWeaponChargeLevelMax(); i++ )
	{
		if ( weapon.HasMod( MELEE_BAT_CHARGE_MODS_BASE_STR + i ) )
			return i
	}

	return 0
}




#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________HIT_STREAK___________________________(){}
#endif

void function MeleeBat_SetupHitStreak( entity weapon )
{
	if ( !( weapon in file.batHitStreaks ) )
	{
		HitStreak streak
		file.batHitStreaks[weapon] <- streak
	}
}

HitStreak function MeleeBat_GetHitStreak( entity weapon )
{
	MeleeBat_SetupHitStreak( weapon )

	return file.batHitStreaks[weapon]
}

void function MeleeBat_SetHitStreak( entity weapon, HitStreak streak )
{
	MeleeBat_SetupHitStreak( weapon )

	file.batHitStreaks[weapon] = streak
}

void function MeleeBat_IncrementHitStreak( entity weapon )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return


	MeleeBat_SetupHitStreak( weapon )
	HitStreak streak = MeleeBat_GetHitStreak( weapon )

	
	float timeSinceLastIncrement = Time() - streak.lastIncrementTime
#if DEV
		printt( "BAT - Hit Streak - Time Since Last: " + timeSinceLastIncrement )
#endif
	if( timeSinceLastIncrement <= 0.0 )
		return
	streak.lastIncrementTime = Time()

	
	float currentHeat = weapon.GetHeatValue()
	float newHeat = clamp( currentHeat + MELEE_BAT_HIT_STREAK_HEAT_INCREMENT, 0, 1 )
	weapon.SetHeatValue( newHeat )

	MeleeBat_SetHitStreak( weapon, streak )
}

void function MeleeBat_ResetHitStreak( entity weapon )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return


#if DEV
		printt( "BAT - Reset Hit Streak" )
#endif
	HitStreak streak
	MeleeBat_SetHitStreak( weapon, streak )

	weapon.SetHeatValue( 0 )
	if ( GetWeaponInfoFileKeyField_GlobalBool( WEAPON_MELEE_BAT_REF, "heat_decay_sound_play_only_on_fully_heated_decay" ) )
	{
		weapon.TryUpdatingFullyHeated()
	}


		
		entity weaponOwner = weapon.GetOwner()
		if ( weaponOwner in file.attackerComboTrackerTable )
		{
			delete file.attackerComboTrackerTable[weaponOwner]
		}

}




#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________HUD___________________________(){}
#endif


void function MeleeBat_ClearHints()
{
	HidePlayerHint( MELEE_BAT_LOC_MAIN_HINT )
	HidePlayerHint( MELEE_BAT_LOC_MAIN_HINT_ALT )
}

void function MeleeBat_DisplayHint( entity player, string message, float time = 6.0, float debounce = 0.0 )
{
	if ( !IsLocalViewPlayer( player ) )
		return

	switch( message )
	{
		case MELEE_BAT_LOC_MAIN_HINT:
		case MELEE_BAT_LOC_MAIN_HINT_ALT:
			if ( Time() < file.debounceMainMsg )
				return
			file.debounceMainMsg = Time() + debounce
			break

		default:
			break
	}

	MeleeBat_ClearHints()
	AddPlayerHint( time, 0.5, $"", message )
}



void function MeleeBat_HeatHud_Thread( entity weapon, entity player )
{
	AssertIsNewThread()

	if ( !IsValid( player ) || !IsLocalViewPlayer( player ) )
		return

	if ( weapon != player.GetActiveWeapon( eActiveInventorySlot.mainHand ) )
		return

	weapon.Signal( SIGNAL_MELEE_BAT_HEAT_HUD_UPDATE )
	weapon.EndSignal( SIGNAL_MELEE_BAT_HEAT_HUD_UPDATE )
	weapon.EndSignal( "OnDestroy" )
	player.EndSignal( WEAPON_CHARGED_RUI_ABORT_SIGNAL )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )


	var rui = ClWeaponStatus_GetWeaponHudRui( player )
	if ( rui == null )
		return

	RuiDestroyNestedIfAlive( rui, "chargedHandle" )

	var nestedRui = RuiCreateNested( rui, "chargedHandle", RUI_MELEE_BAT_HEAT_HUD )
	if ( nestedRui == null )
		return

	vector batFrameColor = SrgbToLinear( GetAmmoColorByType( "supply_drop" ) )
	RuiSetFloat3( nestedRui, "frameColor", batFrameColor )

	OnThreadEnd(
		function() : ( player )
	{
		if ( !IsValid( player ) )
			return

		var weaponRui = ClWeaponStatus_GetWeaponHudRui( player )
		if ( weaponRui == null )
			return

		RuiDestroyNestedIfAlive( weaponRui, "chargedHandle" )
	})

	while ( IsValid( weapon ) && weapon == player.GetActiveWeapon( eActiveInventorySlot.mainHand ) )
	{
		float frac = weapon.GetHeatValue()

		if ( nestedRui == null || !RuiIsAlive( nestedRui ) )
			return

		RuiSetFloat( nestedRui, "batHeatFrac", frac )
		RuiSetBool( nestedRui, "showBatHeatBar", true )

		WaitFrame()
	}
}



void function MeleeBat_ChargeCrosshairRui_Thread( entity weapon, entity player )
{
	AssertIsNewThread()

	if ( !IsValid( player ) || !IsLocalViewPlayer( player ) )
		return

	if ( weapon != player.GetActiveWeapon( eActiveInventorySlot.mainHand ) )
		return

	weapon.EndSignal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )
	weapon.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )

	var rui = CreateCockpitPostFXRui( $"ui/crosshair_bat_sweetspot.rpak" )
	if ( rui == null )
		return

	OnThreadEnd( function() : ( rui )
	{
		if ( rui != null )
			RuiDestroyIfAlive( rui )
	})

	while ( IsValid( weapon ) && weapon == player.GetActiveWeapon( eActiveInventorySlot.mainHand ) )
	{
		float frac = weapon.GetWeaponChargeFraction()

		if ( rui == null || !RuiIsAlive( rui ) )
			return

		RuiSetFloat( rui, "meterFrac", frac )
		WaitFrame()
	}
}





