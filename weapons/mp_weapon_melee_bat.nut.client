void function _____________ATTACKS___________________________(){}
#endif

int function MeleeBat_OnMeleeWeaponPrimaryAttack( entity weapon, entity player )
{
	if ( !MeleeBat_IsEnabled() )
		return PLAYER_MELEE_STATE_NONE

	if ( !IsValid( weapon ) || !IsValid( player ) )
		return PLAYER_MELEE_STATE_NONE

	
	if ( weapon.IsWeaponInAds() && !player.IsInputCommandPressed( IN_ATTACK ) )
	{
#if DEV
			printt( "BAT - Weapon in ADS")
#endif
		return PLAYER_MELEE_STATE_NONE
	}

	
	weapon.PlayWeaponEffect( BAT_FX_THRUSTER_SWIPE_L_FP, BAT_FX_THRUSTER_SWIPE_L_3P, MELEE_BAT_FX_TOP_JET_L_ATTACHMENT )
	weapon.PlayWeaponEffect( BAT_FX_THRUSTER_SWIPE_R_FP, BAT_FX_THRUSTER_SWIPE_R_3P, MELEE_BAT_FX_TOP_JET_R_ATTACHMENT )

	if ( weapon.GetWeaponChargeLevel() > 0 )
	{
#if DEV
			printt( "BAT - Charge Attack")
#endif

		weapon.Signal( SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )

		return PLAYER_MELEE_STATE_KICK_ATTACK
	}

	if ( weapon.GetHeatValue() == MELEE_BAT_HIT_STREAK_MAX_HEAT )
	{
#if DEV
			printt( "BAT - Hit Streak Trigger Attack" )
#endif
		return PLAYER_MELEE_STATE_KICK_ATTACK
	}

	
#if DEV
		printt( "BAT - Standard Attack")
#endif
	return PLAYER_MELEE_STATE_KICK_ATTACK
}

void function MeleeBat_OnMeleeHit( entity attacker, entity target, entity weapon )
{
	if ( !MeleeBat_WeaponIsMeleeBat( weapon ) )
		return

	bool isValidTarget = target.IsPlayer() || IsTrainingDummie( target ) || target.IsNPC()
	if ( isValidTarget )
	{
		if ( MeleeBat_HasLauncherMod( weapon ) )
		{
			file.wasLaunchAttack = true


				if ( !IsFriendlyTeam( attacker.GetTeam(), target.GetTeam() ) )
				{
					MeleeBat_PlayBattleChatterToSelfOnClient( SFX_VO_MELEE_BAT_CHARGE_ATTACK )
				}





		}
		else
		{
			
			MeleeBat_IncrementHitStreak( weapon )

				if ( !IsFriendlyTeam( attacker.GetTeam(), target.GetTeam() ) )
				{
					MeleeBat_PlayBattleChatterToSelfOnClient( SFX_VO_MELEE_BAT_STANDARD_ATTACK )
				}

		}
	}

















}
































bool function MeleeBat_OnMeleeAttackAnimEvent( entity attacker, entity meleeAttackWeapon, int impactTableOverride )
{
	if ( !MeleeBat_WeaponIsMeleeBat( meleeAttackWeapon ) )
		return false

	return MeleeBat_TryMultiAttack( attacker, meleeAttackWeapon, impactTableOverride )
}

bool function MeleeBat_TryMultiAttack( entity attacker, entity weapon, int impactTableOverride )
{
	array<entity> hitList = PlayerMelee_MultiAttackTrace( attacker, MELEE_BAT_MULTI_ATTACK_DISTANCE, MELEE_BAT_MULTI_ATTACK_ANGLE_HORIZONTAL, MELEE_BAT_MULTI_ATTACK_ANGLE_VERTICAL,
				(int function( entity blockingEntity ) {
			return TitanSword_CanGoThroughBlockingEntity( blockingEntity ) 
		}),
				(bool function( entity attacker, entity target ) : ( weapon ) {
			return IsValidMeleeAttackTarget( attacker, null, weapon, target ) 
		}),
				(void function( entity attacker, table attackInfo ) : ( weapon, impactTableOverride ) {
			Melee_Attack( attacker, weapon, impactTableOverride, attackInfo ) 
		}) )






	return hitList.len() > 0
}




