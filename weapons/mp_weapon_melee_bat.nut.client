void function _____________VO___________________________(){}
#endif


void function MeleeBat_ServerToClient_AcknowledgeBatPickup()
{
	MeleeBat_PlayBattleChatterToSelfOnClient( SFX_VO_MELEE_BAT_PICKUP )
}



void function MeleeBat_PlayBattleChatterToSelfOnClient( string chatterLine )
{
	entity localPlayer = GetLocalViewPlayer()

	float playChance = 1.0
	switch( chatterLine )
	{
		case SFX_VO_MELEE_BAT_PICKUP:
		{
			playChance = SFX_VO_MELEE_BAT_PICKUP_CHANCE
			break
		}
		case SFX_VO_MELEE_BAT_STANDARD_ATTACK:
		{
			playChance = SFX_VO_MELEE_BAT_STANDARD_ATTACK_CHANCE
			break
		}
		case SFX_VO_MELEE_BAT_CHARGE_ATTACK:
		{
			playChance = SFX_VO_MELEE_BAT_CHARGE_ATTACK_CHANCE
			break
		}
	}

	float chance = RandomFloat( 1.0 )
	if ( chance < playChance )
	{
		PlayBattleChatterToSelfOnClient( localPlayer, chatterLine )
	}
}





#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________LAUNCH_MOD___________________________(){}
#endif

bool function MeleeBat_HasLauncherMod( entity weapon )
{
	if ( !MeleeBat_WeaponIsMeleeBat( weapon ) )
		return false

	return MeleeBat_HasChargeLevelMod( weapon )
		|| weapon.HasMod( MELEE_BAT_HIT_STREAK_LAUNCHER_MOD )
}

vector function MeleeBat_GetCustomKnockbackForce( entity weapon, entity attacker, entity victim, vector velocity )
{
	if ( !MeleeBat_WeaponIsMeleeBat( weapon ) )
		return velocity

	if ( MeleeBat_HasLauncherMod( weapon ) && MeleeBat_ShouldLaunchVictim( attacker, victim ) )
	{
		string launchVelZVar = MeleeBat_HasChargeLevelMod( weapon ) ? ( MELEE_BAT_CHARGE_MODS_BASE_STR + ( MeleeBat_GetChargeLevelFromMod( weapon ) ) + "_vel_z" ) : "launcher_vel_z"
		float velZ = GetWeaponInfoFileKeyField_GlobalFloat( WEAPON_MELEE_BAT_REF, launchVelZVar )
		return <velocity.x , velocity.y, velZ>
	}

	return velocity
}

bool function MeleeBat_PerformCustomVictimKnockback( entity weapon, entity attacker, entity victim, vector velocity )
{
	if ( !MeleeBat_WeaponIsMeleeBat( weapon ) )
		return false

	if ( MeleeBat_HasLauncherMod( weapon ) && MeleeBat_ShouldLaunchVictim( attacker, victim ) )
	{
		TitanSword_LaunchEntity( victim, velocity ) 
		return true
	}

	return false
}

bool function MeleeBat_ShouldLaunchVictim( entity attacker, entity victim )
{
	if ( MeleeBat_ShouldLaunchFriendlyTeammates() )
		return true

	return !IsFriendlyTeam( attacker.GetTeam(), victim.GetTeam() )
}




#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________MODS___________________________(){}
#endif

void function MeleeBat_SafelyAddAttackMod( entity weapon, string mod )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return


	
	MeleeBat_ClearMods( weapon )

	
	weapon.AddMod( mod )
}

void function MeleeBat_ClearMods( entity weapon )
{

		if ( !InPrediction() || !IsFirstTimePredicted() )
			return


	MeleeBat_ClearChargeLevelMods( weapon )
	weapon.RemoveMod( MELEE_BAT_HIT_STREAK_LAUNCHER_MOD )
}




