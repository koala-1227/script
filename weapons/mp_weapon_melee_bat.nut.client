bool function MeleeBat_WeaponRefIsMeleeBat( string ref )
{
	return ref == WEAPON_MELEE_BAT_REF
}

bool function MeleeBat_WeaponIsMeleeBat( entity weapon )
{
	return IsValid( weapon) && MeleeBat_WeaponRefIsMeleeBat( weapon.GetWeaponClassName() )
}

entity function MeleeBat_GetMainWeapon( entity player )
{
	entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( weapon ) )
		return null

	if ( !MeleeBat_WeaponIsMeleeBat( weapon ) )
		return null

	return weapon
}

bool function MeleeBat_IsActiveWeapon( entity player )
{
	entity weapon = MeleeBat_GetMainWeapon( player )
	return IsValid( weapon )
}




