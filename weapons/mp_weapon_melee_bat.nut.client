bool function MeleeBat_IsEnabled()
{
	return GetCurrentPlaylistVarBool( PVAR_MELEE_BAT_IS_ENABLED, false )
}

bool function MeleeBat_ShouldSpawnInDeathbox()
{
	return GetCurrentPlaylistVarBool( PVAR_MELEE_BAT_SPAWN_IN_DEATHBOX, true )
}

bool function MeleeBat_ShouldLaunchFriendlyTeammates()
{
	return GetCurrentPlaylistVarBool( PVAR_MELEE_BAT_LAUNCH_FRIENDLY_TEAMMATES, true )
}

bool function MeleeBat_IsSpeedBoostEnabled()
{
	return GetCurrentPlaylistVarBool( PVAR_MELEE_BAT_SPEED_BOOST_ENABLED, true )
}

float function MeleeBat_GetSpeedBoostScale()
{
	return GetCurrentPlaylistVarFloat( PVAR_MELEE_BAT_SPEED_BOOST_SCALE, MELEE_BAT_SPEED_BOOST_DEFAULT_SPEED )
}




