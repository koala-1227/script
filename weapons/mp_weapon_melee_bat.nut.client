void function _____________ACTIVATE_DEACTIVATE___________________________(){}
#endif

void function MeleeBat_OnWeaponActivate( entity weapon )
{
	if ( !MeleeBat_IsEnabled() )
		return

	entity player = weapon.GetWeaponOwner()
	if ( !IsValid( player ) )
		return






		if ( !player.IsZiplining() )
		{
			string hint = weapon.GetWeaponSettingBool( eWeaponVar.charge_is_triggered_by_ADS ) ? MELEE_BAT_LOC_MAIN_HINT_ALT : MELEE_BAT_LOC_MAIN_HINT
			MeleeBat_DisplayHint( player, hint, MELEE_BAT_HINT_MAIN_DISPLAY_TIME, MELEE_BAT_HINT_MAIN_DEBOUNCE_TIME )
		}

		if ( GetLocalViewPlayer() == player )
		{
			thread MeleeBat_HeatHud_Thread( weapon, player )
		}


	weapon.PlayWeaponEffect( BAT_FX_THRUSTER_L_FP, BAT_FX_THRUSTER_L_3P, MELEE_BAT_FX_TOP_JET_L_ATTACHMENT )
	weapon.PlayWeaponEffect( BAT_FX_THRUSTER_R_FP, BAT_FX_THRUSTER_R_3P, MELEE_BAT_FX_TOP_JET_R_ATTACHMENT )
	
	
	
}

void function MeleeBat_OnWeaponDeactivate( entity weapon )
{
	if ( !MeleeBat_IsEnabled() )
		return

	entity player = weapon.GetWeaponOwner()
	if ( !IsValid( player ) )
		return

	MeleeBat_ResetHitStreak( weapon )
	MeleeBat_ClearMods( weapon )






		Signal( weapon, SIGNAL_MELEE_BAT_HEAT_HUD_UPDATE )
		Signal( weapon, SIGNAL_MELEE_BAT_CHARGE_METER_UPDATE )
		MeleeBat_ClearHints()


	weapon.StopWeaponEffect( BAT_FX_THRUSTER_SWIPE_L_FP, BAT_FX_THRUSTER_SWIPE_L_3P )
	weapon.StopWeaponEffect( BAT_FX_THRUSTER_SWIPE_R_FP, BAT_FX_THRUSTER_SWIPE_R_3P )
	weapon.StopWeaponEffect( BAT_FX_THRUSTER_L_FP, BAT_FX_THRUSTER_L_3P )
	weapon.StopWeaponEffect( BAT_FX_THRUSTER_R_FP, BAT_FX_THRUSTER_R_3P )
	
	
	
}

















