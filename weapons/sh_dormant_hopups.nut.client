#if DEV
void function DormantHopups_DEVPrintCurrentWeaponAnalytics()
{
	if ( !SHOW_DEBUG )
		return

	entity player = gp()[0]
	entity latestWeapon = player.GetLatestPrimaryWeapon( eActiveInventorySlot.mainHand )

	if ( !( player in file.playerWeaponsPointSourceTable ) )
	{
		printt( "PLAYER NOT IN TABLE" )
		return
	}

	if ( !( latestWeapon in file.playerWeaponsPointSourceTable[player] ) )
	{
		printt( "WEAPON NOT IN PLAYER TABLE" )
		return
	}

	foreach( val, key in file.playerWeaponsPointSourceTable[player][latestWeapon] )
	{
		printt( "FINAL SOURCE:" + val + " has " + key + " points." )
	}
}
void function DormantHopups_PrintCurrentWeaponPoints()
{
	entity latestWeapon = gp()[0].GetLatestPrimaryWeapon( eActiveInventorySlot.mainHand )
	printt ( "DORMANT HOPUPS: " + latestWeapon + " points are currently " + latestWeapon.GetLockedHopupPoints() )
}

void function DormantHopups_ResetCurrentWeaponPoints()
{
	entity latestWeapon = gp()[0].GetLatestPrimaryWeapon( eActiveInventorySlot.mainHand )
	LootData weaponData = SURVIVAL_GetLootDataFromWeapon( latestWeapon )
	if ( DormantHopups_IsHopupUnlocked( latestWeapon, weaponData ) )
	{
		printt ( "DORMANT HOPUPS: Can't unlock hop-up on " + latestWeapon + " because it is already unlocked."  )
		return
	}







	printt ( "DORMANT HOPUPS: " + latestWeapon + " points reset." )
}

void function DormantHopups_UnlockCurrentWeaponHopup()
{
	entity latestWeapon = gp()[0].GetLatestPrimaryWeapon( eActiveInventorySlot.mainHand )





	printt ( "DORMANT HOPUPS: " + latestWeapon + " hop-up enabled." )
}
#endif

