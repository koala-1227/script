void function ServerToClient_DormantHopups_UpdateCurrentWeaponHud( entity weapon, bool dormantHopupActive )
{
	if ( !DormantHopups_IsEnabled() )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) || !IsValid( weapon ) )
		return

	if ( tuning.shouldDisplayToggleHint && dormantHopupActive )
		DormantHopups_DisplayToggleHintIfAble( weapon )

	DormantHopups_UpdateProgressRui( player, false, true )

	UpdateHudDataForMainWeapons( player, weapon )
}

void function ServerToClient_DormantHopups_DoProgressPresentation( entity weapon, int evoXp, bool forcePlayOnly )
{
	if ( !DormantHopups_IsEnabled() )
		return

	if ( !IsValid( weapon ) )
		return

	if ( forcePlayOnly )
	{
		EmitSoundOnEntity( weapon, DORMANT_HOPUP_PROGRESS_SFX )








		return
	}






	if ( ( weapon in file.dormantHopupWeaponPassedHalfwayPoint ) && file.dormantHopupWeaponPassedHalfwayPoint[ weapon ] )
		return

	bool isHalfway = evoXp <= DormantHopups_GetThresholdOfActivation( SURVIVAL_GetLootDataFromWeapon( weapon ) ) / 2
	if ( isHalfway )
	{
		file.dormantHopupWeaponPassedHalfwayPoint[ weapon ] <- true
		EmitSoundOnEntity( weapon, DORMANT_HOPUP_PROGRESS_SFX )
	}
}

void function ServerToClient_DormantHopups_SlingWeaponSwitched( entity player )
{
	if ( !DormantHopups_IsEnabled() )
		return

	if ( !IsValid( player ) )
		return

	if ( player != GetLocalViewPlayer() )
		return

	DormantHopups_UpdateProgressRui( player, true, false, false, true )
}

void function ServerToClient_DoHopupUnlockFx( entity weapon )
{
	if ( !DormantHopups_IsEnabled() )
		return

	entity player = GetLocalViewPlayer()

	if ( !IsValid( player ) || !IsValid( weapon ) )
		return

	EmitSoundOnEntity( weapon, DORMANT_HOPUP_ACTIVATION_SFX )

	if ( player.GetActiveWeapon( eActiveInventorySlot.mainHand ) == weapon )
	{







		thread DormantHopups_PlayCockpitVFX_Thread( player, DORMANT_HOPUP_ACTIVATION_COCKPIT_FX )
	}
}















void function DormantHopups_UpdateProgressRui( entity player, bool weaponChanged = false, bool justActivated = false, bool weaponPickedUp = false, bool isSlingWeapon = false )
{
	if ( !DormantHopups_IsEnabled() )
		return

	if ( !IsValid( player ) )
		return

	var weaponRui = ClWeaponStatus_GetWeaponHudRui( player )

	if ( weaponRui == null || !RuiIsAlive( weaponRui ) )
		return

	bool finalProgressBarVisible = false
	bool finalNotifVisible = false

	
	if ( file.dormantHopupRui == null || !RuiIsAlive( file.dormantHopupRui ) )
	{
		RuiDestroyNestedIfAlive( weaponRui, "hopupProgressHandle" )







		{
			file.dormantHopupRui = RuiCreateNested( weaponRui, "hopupProgressHandle", $"ui/weapon_hopup_progress_bar.rpak" )
		}
	}

	
	if ( file.dormantHopupNotifRui == null || !RuiIsAlive( file.dormantHopupNotifRui ) )
	{
		RuiDestroyNestedIfAlive( weaponRui, "hopupNotifHandle" )
		file.dormantHopupNotifRui = RuiCreateNested( weaponRui, "hopupNotifHandle", $"ui/weapon_hopup_notification.rpak" )
	}

	entity weapon = DormantHopups_IsActiveWeaponADormantHopupWeapon() ? player.GetActiveWeapon( eActiveInventorySlot.mainHand ) : null
	int evoXp = DormantHopups_GetPoints( weapon )

	
	
	
	RuiSetBoolIfExists( file.dormantHopupRui, "weaponPickedUp", weaponPickedUp )
	RuiSetBoolIfExists( file.dormantHopupRui, "weaponChangedFlag", weaponChanged )

	RuiSetBoolIfExists( file.dormantHopupNotifRui, "weaponPickedUp", weaponPickedUp )
	RuiSetBoolIfExists( file.dormantHopupNotifRui, "weaponChangedFlag", weaponChanged )

	if( isSlingWeapon || !IsValid( weapon ) || (weapon.GetWeaponClassName() == "") )
	{
		RuiSetBoolIfExists( file.dormantHopupRui, "showHopupProgressBar", false )
		RuiSetBoolIfExists( file.dormantHopupNotifRui, "showHopupProgressBar", false )

		RuiSetIntIfExists(  file.dormantHopupRui, "hopupTier", 0 )
		RuiSetIntIfExists(  file.dormantHopupNotifRui, "hopupTier", 0 )

		RuiSetBoolIfExists( file.dormantHopupRui, "justActivated", false )
		RuiSetBoolIfExists( file.dormantHopupNotifRui, "justActivated", false )

		RuiSetBoolIfExists( file.dormantHopupNotifRui, "notifSettingOn", false )

		HopupPopupQueue_SetDormantHopupProgress( false )
		HopupPopupQueue_SetDormantHopupNotif( false )

		return
	}

	LootData data = SURVIVAL_GetLootDataFromWeapon( weapon )
	bool isUnlocked = DormantHopups_IsHopupUnlocked( weapon, data )
	int hopupTier = DormantHopups_GetHopupTier( data, isUnlocked )
	asset icon = DormantHopups_GetHopupIcon( data )
	asset arsenalIcon = Arsenals_GetArsenalIconFromWeaponData( data )
	string hopupName = Localize( DormantHopups_GetHopupTitle( data  ) )
	string hopupDesc = Localize( DormantHopups_GetHopupDescription( data, isUnlocked  ) )

	bool notifSettingOn = DisplayHopupPopup()

	if ( !DormantHopups_IsEnabled() || evoXp == 0 || isUnlocked )
	{
		RuiSetBoolIfExists( file.dormantHopupRui, "showHopupProgressBar", false )
		RuiSetIntIfExists(  file.dormantHopupRui, "hopupTier", hopupTier )

		RuiSetBoolIfExists( file.dormantHopupNotifRui, "showHopupProgressBar", false )
		RuiSetIntIfExists(  file.dormantHopupNotifRui, "hopupTier", hopupTier )

		RuiSetBoolIfExists( file.dormantHopupRui, "justActivated", justActivated )
		RuiSetBoolIfExists( file.dormantHopupNotifRui, "justActivated", justActivated )

		
		RuiSetStringIfExists( file.dormantHopupNotifRui, "hopupDesc", hopupDesc )

		
		RuiSetImageIfExists( file.dormantHopupNotifRui, "hopupIcon", icon )
		RuiSetStringIfExists( file.dormantHopupNotifRui, "hopupName", hopupName )
		RuiSetImageIfExists( file.dormantHopupNotifRui, "arsenalIcon", arsenalIcon )

		RuiSetBoolIfExists( file.dormantHopupNotifRui, "notifSettingOn", notifSettingOn )

		finalProgressBarVisible = false
		finalNotifVisible = false
	}
	else
	{



		int totalDamageToEvolve =  DormantHopups_GetThresholdOfActivation( data )

		int currentTierExp =  totalDamageToEvolve - evoXp

		
		RuiSetBoolIfExists( file.dormantHopupRui, "showHopupProgressBar", true )
		RuiSetIntIfExists( file.dormantHopupRui, "numPoints", currentTierExp )
		RuiSetIntIfExists( file.dormantHopupRui, "numPointsNeeded", totalDamageToEvolve )
		RuiSetImageIfExists( file.dormantHopupRui, "hopupIcon", icon )
		RuiSetIntIfExists(  file.dormantHopupRui, "hopupTier", hopupTier )

		
		RuiSetBoolIfExists( file.dormantHopupNotifRui, "showHopupProgressBar", true )
		RuiSetImageIfExists( file.dormantHopupNotifRui, "hopupIcon", icon )
		RuiSetIntIfExists(  file.dormantHopupNotifRui, "hopupTier", hopupTier )
		RuiSetStringIfExists( file.dormantHopupNotifRui, "hopupName", hopupName )
		RuiSetStringIfExists( file.dormantHopupNotifRui, "hopupDesc", hopupDesc )
		RuiSetImageIfExists( file.dormantHopupNotifRui, "arsenalIcon", arsenalIcon )

		RuiSetBoolIfExists( file.dormantHopupNotifRui, "notifSettingOn", notifSettingOn )

		finalProgressBarVisible = true
		finalNotifVisible = true









		if ( !isUnlocked && weaponChanged && !weaponPickedUp )
		{
			RuiSetBoolIfExists( file.dormantHopupNotifRui, "showHopupProgressBar", false )
			finalNotifVisible = false
		}

	}

	HopupPopupQueue_SetDormantHopupProgress( finalProgressBarVisible )
	HopupPopupQueue_SetDormantHopupNotif( finalNotifVisible )
}

void function DormantHopups_DisplayToggleHintIfAble( entity weapon )
{
	if ( DormantHopups_WeaponHasFireModeSelect( weapon ) )
		AddPlayerHint( 3.0, 0.25, $"", "#WPN_HOPUP_SELECTFIRE_POPUP_DESC" )
}

bool function DormantHopups_WeaponHasFireModeSelect( entity weapon )
{
	if ( DoesModExist( weapon, "hopup_selectfire" ) && IsModActive( weapon, "hopup_selectfire" ) )
		return true




	else if ( DoesModExist( weapon, "hopup_double_tap" ) && IsModActive( weapon, "hopup_double_tap" ) )
		return true

	return false
}

void function DormantHopups_PlayCockpitVFX_Thread( entity player, asset cockpitFx )
{
	if ( !IsValid( player ) )
		return

	Signal ( player, SIGNAL_DORMANT_HOPUP_FORCE_END_VFX )

	EndSignal( player, "OnDeath", "OnDestroy", SIGNAL_DORMANT_HOPUP_FORCE_END_VFX )

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	if ( EffectDoesExist( file.dormantHopupScreenFxHandle ) )
		return

	int fxID = GetParticleSystemIndex( cockpitFx )
	file.dormantHopupScreenFxHandle = StartParticleEffectOnEntity( cockpit, fxID, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	EffectSetIsWithCockpit( file.dormantHopupScreenFxHandle, true )
	EffectSetControlPointVector( file.dormantHopupScreenFxHandle, 1, UNLOCK_EFFECT_COLOR )

	OnThreadEnd( function() {
		if ( EffectDoesExist( file.dormantHopupScreenFxHandle ) )
			EffectStop( file.dormantHopupScreenFxHandle, false, true )
	} )

	wait 2
}

void function DormantHopups_PickedUpWeapon( entity player, LootData data, int lootAction )
{
	if ( data.lootType != eLootType.MAINWEAPON )
		return

	if ( !DormantHopups_WeaponHasDormantHopupInBaseMods( data ) )
		return

	file.dormantHopupJustPickedUpWeapon = true
}

void function DormantHopups_OnPlayerWeaponSwitched( entity player, entity newWeapon, entity oldWeapon )
{
	if ( !IsValid( player ) )
		return

	entity localPlayer = GetLocalViewPlayer()
	if ( !IsValid( localPlayer ) || localPlayer != player )
		return

	bool wasPickedUp = file.dormantHopupJustPickedUpWeapon
	file.dormantHopupJustPickedUpWeapon = false
	DormantHopups_UpdateProgressRui( player, true, false, wasPickedUp )
}

int function DormantHopups_GetHopupTier( LootData weaponData, bool isActive  )
{
	string hopup = DormantHopups_GetDormantHopupFromBaseMods( weaponData )

	if( hopup == "" )
		return 0

	if( isActive )
	{
		string hopupActive = DormantHopups_GetNonDormantHopupFromString( hopup )
		LootData hopupDataActive = SURVIVAL_Loot_GetLootDataByRef( hopupActive )
		return hopupDataActive.tier
	}

	LootData hopupDataBase = SURVIVAL_Loot_GetLootDataByRef( hopup )
	return hopupDataBase.tier
}

asset function DormantHopups_GetHopupIcon( LootData weaponData  )
{
	string hopup = DormantHopups_GetDormantHopupFromBaseMods( weaponData )

	if( hopup == "" )
		return $""

	LootData hopupData = SURVIVAL_Loot_GetLootDataByRef( hopup )

	return hopupData.hudIcon
}

string function DormantHopups_GetHopupTitle( LootData weaponData  )
{
	string hopup = DormantHopups_GetDormantHopupFromBaseMods( weaponData )

	if( hopup == "" )
		return ""

	LootData hopupData = SURVIVAL_Loot_GetLootDataByRef( hopup )

	return hopupData.pickupString
}

string function DormantHopups_GetHopupDescription( LootData weaponData, bool isActive  )
{
	string hopup = DormantHopups_GetDormantHopupFromBaseMods( weaponData )

	if( hopup == "" )
		return ""

	if( isActive )
	{
		string hopupActive = DormantHopups_GetNonDormantHopupFromString( hopup )
		LootData hopupDataActive = SURVIVAL_Loot_GetLootDataByRef( hopupActive )
		return hopupDataActive.hopupPopupDesc
	}

	LootData hopupDataBase = SURVIVAL_Loot_GetLootDataByRef( hopup )
	return hopupDataBase.hopupPopupDesc
}

bool function DormantHopups_SetAttachmentCount( var rui, LootData attachData, int attachmentCount, string ruiArgName = "hopupAttachmentCount" )
{
	if ( !DormantHopups_IsEnabled() )
		return false

	if ( attachData.lootTags.contains( "LockedHopup" ) )
	{
		RuiSetIntIfExists( rui, ruiArgName, attachmentCount )
		return true
	}
	return false
}

bool function DormantHopups_IsActiveWeaponADormantHopupWeapon()
{
	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return false

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	if ( !IsValid( activeWeapon ) )
		return false

	bool isSlingWeapon = GetSlotForWeapon( player, activeWeapon ) == SLING_WEAPON_SLOT
	if ( isSlingWeapon )
		return false

	LootData weaponData = SURVIVAL_GetLootDataFromWeapon( activeWeapon )
	if ( DormantHopups_GetPoints( activeWeapon ) > 0 || DormantHopups_IsHopupUnlocked( activeWeapon, weaponData ) )
		return true

	return false

}

void function OnSpectateTargetChanged( entity spectatingPlayer, entity oldSpectatorTarget, entity newSpectatorTarget )
{
	if ( !IsValid( newSpectatorTarget ) )
		return

	DormantHopups_UpdateProgressRui( newSpectatorTarget, true, false, false, false )
}


