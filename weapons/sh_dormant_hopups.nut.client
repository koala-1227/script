void function DormantHopups_Init()
{
	RegisterTuningStruct( "tuning", "dormant_hopup_" )


	SURVIVAL_AddCallback_PreWeaponAttachmentInit( DormantHopups_Switcheroo )
	SURVIVAL_AddCallback_PostWeaponAttachmentInit( DormantHopups_Switcheroo_LockedSets )







		
		if ( EvoWeapons_IsEnabled() )
			return


	if ( !DormantHopups_IsEnabled() )
		return


		PrecacheParticleSystem( DORMANT_HOPUP_ACTIVATION_COCKPIT_FX )
		PrecacheParticleSystem( DORMANT_HOPUP_ACTIVATION_WEAPON_FX )
		RegisterSignal( SIGNAL_DORMANT_HOPUP_FORCE_END_VFX )

		AddCallback_LocalPlayerPickedUpLoot( DormantHopups_PickedUpWeapon )
		AddCallback_OnPlayerWeaponSwitched( DormantHopups_OnPlayerWeaponSwitched )
		AddOnSpectatorTargetChangedCallback( OnSpectateTargetChanged )



		DormantHopups_SetUpPointSourceReferenceTable()
		Remote_RegisterClientFunction( "ServerToClient_DormantHopups_UpdateCurrentWeaponHud", "entity", "bool" )
		Remote_RegisterClientFunction( "ServerToClient_DoHopupUnlockFx", "entity" )
		Remote_RegisterClientFunction( "ServerToClient_DormantHopups_DoProgressPresentation", "entity", "int", 0, 2048, "bool" ) 
		Remote_RegisterClientFunction( "ServerToClient_DormantHopups_SlingWeaponSwitched", "entity" )
		RegisterCustomItemPickupAction( HOPUP_POINTS_PICKUP, DormantHopups_ItemPickup )

}


void function DormantHopups_Switcheroo( LootData wData )
{
	if ( DormantHopups_IsEnabled() )
		return

	DormantHopups_RemoveHopup( wData )
}

void function DormantHopups_Switcheroo_LockedSets( LootData wData )
{
	if ( DormantHopups_IsEnabled() )
		return

	if ( wData.baseWeapon == wData.ref )
		return

	bool isLocked = SURVIVAL_Weapon_IsAttachmentLocked( wData.ref )
	if ( isLocked )
		DormantHopups_RemoveHopup( wData )

}

void function DormantHopups_RemoveHopup( LootData wData )
{
	
	

	if ( DormantHopups_IsDormantHopupWeapon( wData ) )
	{
		if ( wData.supportedAttachments.contains( "hopup" ) )
		{
			wData.supportedAttachments.fastremovebyvalue( "hopup" )
		}

		if ( DormantHopups_WeaponHasDormantHopupInBaseMods( wData ) )
		{
			string dormantHopup = DormantHopups_GetDormantHopupFromBaseMods( wData )
			if ( dormantHopup != "" )
			{
				if ( wData.baseMods.contains( dormantHopup ) )
				{
					wData.baseMods.fastremovebyvalue( dormantHopup )
				}
			}
		}
	}
}

bool function DormantHopups_IsDormantHopupWeapon( LootData data )
{
	if ( !WeaponHasLockedHopup( data ) )
		return false

	if ( DormantHopups_WeaponHasDormantHopupInBaseMods( data ) )
		return false

	if ( data.baseMods.contains( ULTIMATE_ACCELERATOR_WEAPON_MOD ) )
		return true

	return false
}
















