	bool  arrowsAutoFillWeapon			= true
	float arrowsFragDelayTime			= 2.0
	int   arrowsFragDamage				= 25
	float arrowsFragRadiusInner			= 150.0
	float arrowsFragRadiusOuter			= 200.0
