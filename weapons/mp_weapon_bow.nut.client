} tuning


void function MpWeaponBow_spicey_Init()
{
	MpWeaponBow_spicey_InitTuningValues()

	PrecacheWeapon( $"mp_weapon_bow" )

	RegisterSignal( BOW_DEACTIVATE_SIGNAL )
	RegisterSignal( HELPER_DOT_RUI_ABORT_SIGNAL )
	RegisterSignal( CHARGE_END )

	PrecacheModel( SINGLE_ARROW_MODEL )
	PrecacheModel( SINGLE_ARROW_MODEL_PICKUP )
	PrecacheModel( BOW_1P_MODEL )

	PrecacheParticleSystem( BOW_FRAG_ARROW_CHARGEUP_FX )
	PrecacheParticleSystem( STUCK_ARROW_COCKPIT_FX )
	PrecacheParticleSystem( FX_ENERGIZED_BOW_ARROW_TIP_FULL_DRAW )
	PrecacheParticleSystem( FX_ENERGIZED_BOW_ARROW_FULL_DRAW )

	PrecacheScriptString( ARROW_SCRIPTNAME )

	PrecacheImpactEffectTable( BOW_SPICEY_ENERGIZED_IMPACT_TABLE )
	PrecacheImpactEffectTable( FRAG_ARROW_IMPACT_TABLE )

	file.fxLightAssets1p = {}
	string settingStr
	foreach ( string optic, array<string> attachments in fxLightPointsForOptic )
	{
		array<asset> fxLightArr = []
		for ( int i = 0; i < FX_BOW_LIGHT_COUNT; i++ )
		{
			settingStr = format( "%s%s_%d_1p", FX_BOW_LIGHT_PREFIX, optic, i )
			asset fx1p = GetWeaponInfoFileKeyFieldAsset_Global( BOW_WEAPON_NAME, settingStr )



			fxLightArr.append( fx1p )
		}
		file.fxLightAssets1p[optic] <- fxLightArr
	}






	Remote_RegisterServerFunction( "Remote_CancelCharge_spicey" )
	RegisterCustomItemPickupAction( ARROW_BUNDLE_NAME, WeaponBow_ArrowBundle_ItemPickup )


		RegisterConCommandTriggeredCallback( "+weaponcycle", AttemptCancelCharge_spicey )
		RegisterConCommandTriggeredCallback( "+reload", AttemptCancelCharge_spicey )

		StatusEffect_RegisterEnabledCallback( eStatusEffect.stuck_by_frag_arrow, StuckVisualsEnabled )



		file.inspectDOF = GetCurrentPlaylistVarBool( "bow_inspect_dof", true )




}

void function MpWeaponBow_spicey_InitTuningValues()
{
	tuning.arrowsStickChance         	= GetCurrentPlaylistVarFloat( "spicey_arrows_stick_chance", tuning.arrowsStickChance )
	tuning.arrowsStickMaxPlayer      	= GetCurrentPlaylistVarInt( "spicey_arrows_stick_max_player", tuning.arrowsStickMaxPlayer )
	tuning.arrowsStickMaxWorld       	= GetCurrentPlaylistVarInt( "spicey_arrows_stick_max_world", tuning.arrowsStickMaxWorld )
	tuning.arrowsStickMaxZone        	= GetCurrentPlaylistVarInt( "spicey_arrows_stick_max_per_zone", tuning.arrowsStickMaxZone )
	tuning.arrowsStickMaxUnknownZone 	= GetCurrentPlaylistVarInt("spicey_arrows_stick_max_unknown_zone", tuning.arrowsStickMaxUnknownZone )
	tuning.arrowsStickIntoPlayerDist 	= GetCurrentPlaylistVarFloat( "spicey_arrows_stick_into_player_dist", tuning.arrowsStickIntoPlayerDist )
	tuning.arrowsStickIntoAdjustDist 	= GetCurrentPlaylistVarFloat( "spicey_arrows_stick_into_adjust_dist", tuning.arrowsStickIntoAdjustDist )
	tuning.arrowsStickLifetimePlayer 	= GetCurrentPlaylistVarFloat( "spicey_arrows_stick_lifetime_player", tuning.arrowsStickLifetimePlayer )
	tuning.arrowsStickLifetimeWorld  	= GetCurrentPlaylistVarFloat( "spicey_arrows_stick_lifetime_world", tuning.arrowsStickLifetimeWorld )
	tuning.arrowsCanBePickedUp       	= GetCurrentPlaylistVarBool( "spicey_arrows_can_be_picked_up", tuning.arrowsCanBePickedUp )
	tuning.arrowsAutoFillWeapon       	= GetCurrentPlaylistVarBool( "spicey_arrows_autofill_weapon", tuning.arrowsAutoFillWeapon )
	tuning.arrowsFragDelayTime  		= GetCurrentPlaylistVarFloat( "spicey_arrows_frag_delay_time", tuning.arrowsFragDelayTime )
	tuning.arrowsFragDamage	  		= GetCurrentPlaylistVarInt( "spicey_arrows_frag_damage", tuning.arrowsFragDamage )
	tuning.arrowsFragRadiusInner	  	= GetCurrentPlaylistVarFloat( "spicey_arrows_frag_radius_inner", tuning.arrowsFragRadiusInner )
	tuning.arrowsFragRadiusOuter	  	= GetCurrentPlaylistVarFloat( "spicey_arrows_frag_radius_outer", tuning.arrowsFragRadiusOuter )
	tuning.arrowsFragForce	  			= GetCurrentPlaylistVarFloat( "spicey_arrows_frag_force", tuning.arrowsFragForce )
	tuning.arrowsStickDisabled	  		= GetCurrentPlaylistVarBool( "arrows_stick_disable", tuning.arrowsStickDisabled )
	tuning.arrowsAutoPickupDistance	= GetCurrentPlaylistVarFloat( "spicey_arrows_pickup_distance", tuning.arrowsAutoPickupDistance )
	tuning.arrowsRefundNonSticky	  	= GetCurrentPlaylistVarBool( "arrows_refund_non_sticky", tuning.arrowsRefundNonSticky )
}

bool function ArrowsCanBePickedUp_spicey()
{
	return tuning.arrowsCanBePickedUp
}

bool function ArrowsAutofillWeapon_spicey()
{
	return tuning.arrowsAutoFillWeapon
}

asset function Bow_spicey_GetEnergizedIcon()
{
	if ( file.bowEnergizedConsumable == "mp_weapon_frag_grenade" )
		return $"rui/ordnance_icons/grenade_frag"









	return $""
}

bool function ArrowsIsAutoLootableArrow( LootData data )
{
	return data.lootType == eLootType.AMMO && data.ref == ARROWS_AMMO && ArrowsCanBePickedUp_spicey()
}

void function OnWeaponActivate_weapon_bow_spicey( entity weapon )
{
	
	if ( !file.fileStructInitialized )
	{
		file.fileStructInitialized = true

		file.fullChargeSpeed      = GetWeaponInfoFileKeyField_GlobalFloat( BOW_WEAPON_NAME, "projectile_launch_speed_full_charge" )

		file.chargeCompleteSound = GetWeaponInfoFileKeyField_GlobalString( BOW_WEAPON_NAME, CHARGE_COMPLETE_SOUND_SETTING )
		file.energizeChargeCompleteSound = GetWeaponInfoFileKeyField_GlobalString( BOW_WEAPON_NAME, "energize_charge_complete_sound_1p" )

		file.centerDotHelperMinChargeLvl           = GetWeaponInfoFileKeyField_GlobalInt( BOW_WEAPON_NAME, CENTER_DOT_MIN_CHARGE_SETTING )
		file.centerDotHelperMinChargeLvlOpticClamp = GetWeaponInfoFileKeyField_GlobalInt( BOW_WEAPON_NAME, CENTER_DOT_MIN_CHARGE_SETTING + "_optic_clamp" )

		Assert( eArrowTypes._count == 2 )    
		file.arrowTypeColors.append( GetWeaponInfoFileKeyField_GlobalVectorInt( BOW_WEAPON_NAME, ARROW_COLOR_STANDARD_SETTING ) )
		file.arrowTypeColors.append( GetWeaponInfoFileKeyField_GlobalVectorInt( BOW_WEAPON_NAME, ARROW_COLOR_ENERGIZED_SETTING ) )

		

		file.singleArrowLootData = SURVIVAL_Loot_GetLootDataByRef( ARROWS_AMMO )

		if ( ArrowsCanBePickedUp_spicey() )
			SetCallback_LootTypeExtraCanUseFunction( file.singleArrowLootData, StuckArrow_ExtraCanUseFunction )








	}






















	file.bowEnergizedConsumable = GetWeaponInfoFileKeyField_GlobalString ( BOW_WEAPON_NAME, "energized_consumable" )

	if ( InPrediction() )

	{
		if ( file.bowEnergizedConsumable == "mp_weapon_frag_grenade" )
		{
			if ( !weapon.HasMod( BOW_SPICEY_FRAG_MOD ) )
			{
				weapon.AddMod( BOW_SPICEY_FRAG_MOD )
			}
		}














	}

	WeaponBow_spicey_UpdateArrowColor( weapon )

	entity player = weapon.GetWeaponOwner()

		if ( IsValid( player ) )
		{
			int slot = GetSlotForWeapon( player, weapon )
			if ( slot >= 0 )
				weapon.w.activeOptic = SURVIVAL_GetWeaponAttachmentForPoint( player, slot, "sight" )
			else
				weapon.w.activeOptic = ""

			thread UpdateWeaponEnergizeRui( player, weapon, Bow_spicey_GetEnergizedIcon(), ENERGIZED_CROSSHAIR_RUI,  AMMO_ENERGIZED_ICON )
		}

		if ( weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) )
		{
			weapon.EmitWeaponSound_1p3p( EQUIPPED_WHILE_CHARGED, $"" )
		}

}

void function OnWeaponDeactivate_weapon_bow_spicey( entity weapon )
{
	ClearChargeAndDmgLevelMods( weapon )

		weapon.Signal( BOW_DEACTIVATE_SIGNAL )

	weapon.Signal( ENERGIZED_WEAPON_DEACTIVATE_SIGNAL )
	weapon.StopWeaponSound( EQUIPPED_WHILE_CHARGED )
}

var function OnWeaponPrimaryAttack_weapon_bow_spicey( entity weapon, WeaponPrimaryAttackParams attackParams )
{
	if ( !IsValid( weapon ) )
		return 0

	entity player = weapon.GetWeaponOwner()
	if ( !IsValid( player ) || !player.IsPlayer() )
		return 0


		if ( !(InPrediction() && weapon.ShouldPredictProjectiles()) )
			return 0


	ApplyModsForChargeLevel( weapon, weapon.GetWeaponChargeLevel() )

	weapon.SetSoundCodeControllerValue( 100.0 * weapon.GetWeaponChargeFractionCurved() )

	
	float adjustedChargeFrac = max( 0.0, min( weapon.GetWeaponChargeFractionCurved(), 1.0 ) )

	float baseSpeed       = weapon.GetWeaponSettingFloat( eWeaponVar.projectile_launch_speed )
	float speedMultiplier = 0.0
	bool ignoreSpread     = false

	if ( weapon.HasMod( SHATTER_ROUNDS_HIPFIRE_MOD ) )
	{
		speedMultiplier = GraphCapped( adjustedChargeFrac, 0.0, 1.0, baseSpeed, file.fullChargeSpeedSplit )
		ignoreSpread    = true
	}
	else
	{
		speedMultiplier = GraphCapped( adjustedChargeFrac, 0.0, 1.0, baseSpeed, file.fullChargeSpeed )
	}
	speedMultiplier /= baseSpeed        


	GoldenHorsePurple_OnWeaponPrimaryAttack( weapon, attackParams )
	weapon.FireWeapon_Default( attackParams.pos, attackParams.dir, speedMultiplier, 1.0, ignoreSpread )
	GoldenHorsePurple_PostFire( weapon )

	WeaponBow_spicey_StopChargedArrowEffects( weapon )

	thread ClearChargeAfterFrame( weapon )


		if ( InPrediction() )
		{
			int slot     = GetSlotForWeapon( player, weapon )
			string optic = ""
			if ( slot >= 0 )
			{
				optic = SURVIVAL_GetWeaponAttachmentForPoint( player, slot, "sight" )
			}
			else
			{
				Warning( "Invalid weapon slot " + slot + " for bow on player " + player )
				return weapon.GetWeaponSettingInt( eWeaponVar.ammo_per_shot )
			}

			if ( optic == "" )
				optic = "ironsights"
			bool isClampedOptic   = optic in UI_OPTIC_CLAMP_OPTICS
			float clampOpticDelay = isClampedOptic ? UI_OPTIC_CLAMP_OPTICS[optic] : 0.0
			int minChargeLevel    = isClampedOptic ? file.centerDotHelperMinChargeLvlOpticClamp : file.centerDotHelperMinChargeLvl
			int chargeLvl         = weapon.GetWeaponChargeLevel() - 1
			if ( chargeLvl >= minChargeLevel )
			{
				weapon.Signal( HELPER_DOT_RUI_ABORT_SIGNAL )
				float seqDur   = weapon.GetSequenceDuration( HELPER_DOT_FIRE_ANIM )
				float frac     = weapon.GetScriptedAnimEventCycleFrac( HELPER_DOT_FIRE_ANIM, HELPER_DOT_HIDE_ANIM_EVENT )
				float duration = seqDur * frac
				float delay    = 0.0
				if ( isClampedOptic && chargeLvl < file.centerDotHelperMinChargeLvl && chargeLvl >= file.centerDotHelperMinChargeLvlOpticClamp )
				{
					duration -= clampOpticDelay
					delay = clampOpticDelay
				}
				thread DisplayCenterDotRui( weapon, HELPER_DOT_RUI_ABORT_SIGNAL, delay, duration, 0.7, 0.05, 0.1 )
			}
		}


	return weapon.GetWeaponSettingInt( eWeaponVar.ammo_per_shot )
}

void function OnWeaponCustomActivityStart_weapon_bow_spicey( entity weapon, int activity, int sequence )
{

		if ( !file.inspectDOF )
			return

		
		if ( weapon.GetWeaponActivity() == ACT_VM_WEAPON_INSPECT )
		{
			DoF_LerpNearDepth( 0.5, 6.4, 0.3 )
		}

}

void function OnWeaponCustomActivityEnd_weapon_bow_spicey( entity weapon, int activity )
{

		if ( !file.inspectDOF )
			return

		if ( activity == ACT_VM_WEAPON_INSPECT )
		{
			DoF_LerpNearDepthToDefault( 0.3 )
		}

}

void function ClearChargeAfterFrame( entity weapon )
{
	
	AssertIsNewThread()
	weapon.EndSignal( "OnDestroy" )
	weapon.EndSignal( BOW_DEACTIVATE_SIGNAL )

	OnThreadEnd(
		function() : ( weapon )
		{
			if ( IsValid( weapon ) )
				ClearChargeAndDmgLevelMods( weapon )
		}
	)

	WaitFrame()
}

bool function OnWeaponChargeBegin_weapon_bow_spicey( entity weapon )
{
	entity player = weapon.GetWeaponOwner()
	if ( !IsValid( player ) || !IsAlive( player ) )
		return false


		weapon.Signal( HELPER_DOT_RUI_ABORT_SIGNAL )
		thread PlayChargeFX( player, weapon )


	return true
}

void function OnWeaponChargeEnd_weapon_bow_spicey( entity weapon )
{
	if ( !IsValid( weapon ) )
		return

	weapon.Signal( CHARGE_END )
	WeaponBow_spicey_StopChargedArrowEffects( weapon )

	if ( weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) )
	{
		if ( weapon.IsReadyToFire() )
			weapon.EmitWeaponSound_1p3p( CHARGE_END_SOUND_FP, $"" )
		else
			weapon.EmitWeaponSound_1p3p( CHARGE_END_SOUND_SHOOTING_FP, $"" )
	}


		WeaponBow_spicey_UpdateArrowColor( weapon )

}

bool function OnWeaponChargeLevelIncreased_weapon_bow_spicey( entity weapon )
{
	if ( weapon.GetWeaponChargeLevel() == weapon.GetWeaponChargeLevelMax() )
	{
		entity player = weapon.GetWeaponOwner()
		if ( !IsValid( player ) )
			return true


		if ( weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) )
			weapon.EmitWeaponSound_1p3p( file.energizeChargeCompleteSound, "" )
		else
			weapon.EmitWeaponSound_1p3p( file.chargeCompleteSound, "" )

			if ( IsValid( player ) && IsLocalClientPlayer( player ) )
			{
				Rumble_Play( "rumble_bow_max_charge", {} )
			}


	}

	
	ApplyModsForChargeLevel( weapon, weapon.GetWeaponChargeLevel() )


		WeaponBow_spicey_UpdateArrowColor( weapon )


	return true
}

void function OnWeaponStartEnergizing_weapon_bow_spicey( entity weapon, entity player )
{
	if ( !IsValid( weapon ) )
		return


	if ( InPrediction() )

	{
		weapon.ForceChargeEndNoAttack()
	}

	weapon.EmitWeaponSound_1p3p( $"", CHARGING_SOUND_3P )
}

void function OnWeaponEnergizedStart_weapon_bow_spicey( entity weapon, entity player, bool costConsumable )
{
	OnWeaponEnergizedStart( weapon, player, costConsumable )






}

void function OnWeaponEnergizedEnd_weapon_bow_spicey( entity weapon, entity player )
{
	weapon.StopWeaponSound( CHARGING_SOUND_3P )

		WeaponBow_spicey_UpdateArrowColor( weapon )

}







