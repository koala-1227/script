} file

struct
{
	float arrowsStickChance				= 1.0
	int   arrowsStickMaxPlayer			= 4
	int   arrowsStickMaxWorld			= 750
	int   arrowsStickMaxZone			= 40
	int   arrowsStickMaxUnknownZone		= 80
	float arrowsStickIntoPlayerDist		= 9
	float arrowsStickLifetimePlayer		= 90
	float arrowsStickLifetimeWorld		= 90
	float arrowsStickIntoAdjustDist		= 10
