bool function StuckArrow_ExtraCanUseFunction( entity player, entity arrow, int useFlags )
{
	

	if ( Bleedout_IsBleedingOut( player ) )
		return false

	if ( !ArrowsCanBePickedUp_spicey() )
		return false

	if ( player.GetRealms()[0] != arrow.GetRealms()[0] )
		return false

	if ( IsBitFlagSet( useFlags, USE_FLAG_AUTO ) )
	{
		
		array<entity> weapons = player.GetMainWeapons()
		foreach ( entity weapon in weapons )
		{
			if ( IsValid( weapon ) && weapon.GetWeaponClassName().find( BOW_WEAPON_NAME ) >= 0 )
			{
				int arrowCount = weapon.GetWeaponPrimaryAmmoCount( weapon.GetActiveAmmoSource() )
				if ( arrowCount < weapon.GetWeaponSettingInt( eWeaponVar.ammo_stockpile_max ) )
					return true
			}
		}
	}

	return false
}









































































