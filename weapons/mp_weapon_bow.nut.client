entity function WeaponBow_spicey_GetPlayerBowWeaponWithLowestArrowCount( entity player )
{
	if ( !IsValid( player ) )
		return null

	array< entity > playerWeapons = player.GetMainWeapons()
	playerWeapons.append( GetPlayerSlingWeapon( player ) )

	entity bowWeapon = null
	foreach ( weapon in playerWeapons )
	{
		LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )
		if ( GetBaseWeaponRef( weaponData.ref ).find( BOW_WEAPON_NAME ) >= 0 )
		{
			int currentArrows = weapon.GetWeaponPrimaryAmmoCount( weapon.GetActiveAmmoSource() )
			if ( bowWeapon == null || ( bowWeapon != null && ( currentArrows < bowWeapon.GetWeaponPrimaryAmmoCount( weapon.GetActiveAmmoSource() ) ) ))
			{
				bowWeapon = weapon
			}
		}
	}

	return bowWeapon
}






void function WeaponBow_spicey_UpdateArrowColor( entity weapon )
{
	if ( weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) && weapon.HasMod( BOW_FRAG_EXPLOSIVE_MOD ))
	{
		
		
		weapon.kv.rendercolor = "255 255 255"
		return
	}
	else
	{
		
		weapon.kv.rendercolor = "255 255 255"
	}
}

void function WeaponBow_spicey_StartChargedArrowEffects( entity weapon )
{
	if ( !IsValid( weapon ) )
		return

	weapon.PlayWeaponEffect( FX_ENERGIZED_BOW_ARROW_TIP_FULL_DRAW,  $"", FX_ENERGIZED_BOW_ARROW_TIP_FULL_DRAW_ATTACHPOINT )
	weapon.PlayWeaponEffect( FX_ENERGIZED_BOW_ARROW_FULL_DRAW,  $"", FX_ENERGIZED_BOW_ARROW_FULL_DRAW_ATTACHPOINT )
}

void function WeaponBow_spicey_StopChargedArrowEffects( entity weapon )
{
	if ( !IsValid( weapon ) )
		return

	weapon.StopWeaponEffect( FX_ENERGIZED_BOW_ARROW_TIP_FULL_DRAW,  $"" )
	weapon.StopWeaponEffect( FX_ENERGIZED_BOW_ARROW_FULL_DRAW, $"" )
}






void function ApplyModsForChargeLevel( entity weapon, int level )
{

		if ( !InPrediction() )
			return


	ClearChargeAndDmgLevelMods( weapon )

	if ( level - 1 > 0 )
		weapon.AddMod( CHARGE_MODS_BASE_STR + (level - 1) )

	string baseDmgModStr = STANDARD_CHARGE_DMG_MODS_BASE_STR
	int dmgModLevel   = GetBestAvailableModLevel( STANDARD_ARROWS_AVAILABLE_DMG_LEVELS, level - 1 )
	
	if ( dmgModLevel == 0 )
		return

	if ( dmgModLevel == 5 && weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) )
	{
		weapon.AddMod( BOW_FRAG_EXPLOSIVE_MOD )
		WeaponBow_spicey_StartChargedArrowEffects( weapon )
		return
	}

	weapon.AddMod( baseDmgModStr + dmgModLevel )
}

void function ClearChargeAndDmgLevelMods( entity weapon )
{

		if ( !InPrediction() )
			return


	for ( int i = 0; i < CHARGE_MODS_MAX_LEVEL + 1; i++ )
	{
		weapon.RemoveMod( CHARGE_MODS_BASE_STR + i )

		weapon.RemoveMod( STANDARD_CHARGE_DMG_MODS_BASE_STR + i )
	}

	if ( weapon.HasMod( BOW_FRAG_EXPLOSIVE_MOD ) )
		weapon.RemoveMod( BOW_FRAG_EXPLOSIVE_MOD )


		WeaponBow_spicey_UpdateArrowColor( weapon )

}

int function GetBestAvailableModLevel( array<int> availableLevels, int desiredLevel )
{
	if ( availableLevels[0] >= desiredLevel )
		return availableLevels[0]

	for ( int i = 0; i < availableLevels.len(); i++ )
	{
		if ( availableLevels[i] > desiredLevel )
			return availableLevels[maxint( i - 1, 0 )]
	}

	return availableLevels[availableLevels.len() - 1]
}


void function AttemptCancelCharge_spicey( entity player )
{
	if ( !IsValid( player ) )
		return

	entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( weapon ) )
		return

	if ( weapon.GetWeaponClassName() != BOW_WEAPON_NAME )
		return

	if ( !weapon.IsWeaponCharging() )
		return

	Remote_ServerCallFunction( "Remote_CancelCharge_spicey" )
	ClearChargeAndDmgLevelMods( weapon )
}

























void function PlayChargeFX( entity player, entity weapon )
{
	if ( !IsValid( weapon ) || !IsValid( player ) || !IsAlive( player ) )
		return

	weapon.EndSignal( CHARGE_END )
	weapon.EndSignal( BOW_DEACTIVATE_SIGNAL )
	weapon.EndSignal( "OnDestroy" )

	entity vm = weapon.GetWeaponViewmodel()
	if ( !IsValid( vm ) )
		return

	string opticAttachment = GetInstalledWeaponAttachmentForPoint( weapon, "sight" )
	if ( opticAttachment == "" )
		opticAttachment = "ironsights"
	array<string> attachPoints = fxLightPointsForOptic[opticAttachment]
	array<int> fxHandles = []
	for ( int i = 0; i < FX_BOW_LIGHT_COUNT; i++ )
	{
		asset fx1p = file.fxLightAssets1p[opticAttachment][i]

		

		if ( fx1p == "" )
			continue

		int handle = weapon.PlayWeaponEffectNoCullReturnViewEffectHandle( fx1p, $"", attachPoints[i], true, FX_PATTACH_WEAPON_CHARGE_FRACTION_CURVED )
		fxHandles.append( handle )

		if ( weapon.HasMod( BOW_SPICEY_ENERGIZED_MOD ) )
		{
			EffectSetControlPointVector( handle, 2, ENERGIZED_COLOR_VEC )
		}
		else
		{
			EffectSetControlPointVector( handle, 2, file.arrowTypeColors[ weapon.GetScriptInt0() ] )
		}
	}

	OnThreadEnd(
		function() : ( fxHandles )
		{
			foreach ( handle in fxHandles )
			{
				if ( EffectDoesExist( handle ) )
				{
					EffectStop( handle, true, false )
				}
			}
		}
	)

	WaitForever()
}


void function StopChargeFX( entity weapon )
{
	if ( !IsValid( weapon ) )
		return

	entity vm = weapon.GetWeaponViewmodel()
	if ( !IsValid( vm ) )
		return

	string opticAttachment = GetInstalledWeaponAttachmentForPoint( weapon, "sight" )
	if ( opticAttachment == "" )
		opticAttachment = "ironsights"
	string settingStr
	for ( int i = 0; i < FX_BOW_LIGHT_COUNT; i++ )
	{
		settingStr = FX_BOW_LIGHT_PREFIX + opticAttachment + "_" + i
		asset fx1p = weapon.GetWeaponInfoFileKeyFieldAsset( settingStr + "_1p" )

		if ( fx1p == "" )
			continue

		weapon.StopWeaponEffect( fx1p, $"" )
	}
}


























































































































































































































































































































void function StuckVisualsEnabled( entity player, int statusEffect, bool actuallyChanged )
{
	if ( player != GetLocalViewPlayer() )
		return

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	int fxHandle = StartParticleEffectOnEntity( cockpit, GetParticleSystemIndex( STUCK_ARROW_COCKPIT_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	thread StuckScreenFXThink( player, fxHandle, cockpit )
}

void function StuckScreenFXThink( entity player, int fxHandle, entity cockpit )
{
	player.EndSignal( "OnDeath" )
	cockpit.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( fxHandle )
		{
			if ( !EffectDoesExist( fxHandle ) )
				return

			EffectStop( fxHandle, false, true )
		}
	)

	wait tuning.arrowsFragDelayTime
}


float function WeaponBow_GetArrowFragForce()
{
	return tuning.arrowsFragForce
}
