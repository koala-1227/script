bool function Consumable_PlayerCanQueueItem( entity player, int consumableType )
{
	if ( !(consumableType in file.consumableTypeToInfo) )
		return false

	ConsumableInfo info = file.consumableTypeToInfo[consumableType]

	if ( info.canQueueItem == null )
		return false

	return info.canQueueItem( player )
}

bool function Consumable_PlayerCanQueueHealthItem( entity player, int nextItem )
{
	if ( nextItem == eHealthPickupType.INVALID )
		return false

	if ( !IsValidPlayer( player ) )
		return false

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	if ( !IsValid( activeWeapon ) || !(activeWeapon.GetWeaponClassName() == CONSUMABLE_WEAPON_NAME) )
		return false

	string currentMod = GetConsumableModOnWeapon( activeWeapon )   
	int currentConsumableType = currentMod in file.modNameToConsumableType ? file.modNameToConsumableType[currentMod] : eHealthPickupType.INVALID

	if ( currentConsumableType == eHealthPickupType.INVALID )
		return false

	ConsumableInfo currentInfo = Consumable_GetInfo_ByType( currentConsumableType )

	
	bool playerWillNeedHealth = false
	bool playerWillNeedShields = false

	switch ( currentConsumableType )
	{
		case eHealthPickupType.COMBO_FULL:
			playerWillNeedHealth = false
			playerWillNeedShields = false
			break

		case eHealthPickupType.HEALTH_LARGE:
			playerWillNeedHealth = false
			playerWillNeedShields = player.GetShieldHealth() < player.GetShieldHealthMax()
			break

		case eHealthPickupType.HEALTH_SMALL:
			int currentHealth  = player.GetHealth()
			float healAmount   = Consumable_CalculateTotalHealFromItem( player, currentInfo )
			bool currentHealWillMaxOutHealth = int( healAmount + currentHealth ) >= player.GetMaxHealth()
			playerWillNeedHealth = !currentHealWillMaxOutHealth
			playerWillNeedShields = player.GetShieldHealth() < player.GetShieldHealthMax()
			break

		case eHealthPickupType.SHIELD_LARGE:
			playerWillNeedShields = false
			playerWillNeedHealth = player.GetHealth() < player.GetMaxHealth()
			break

		case eHealthPickupType.SHIELD_SMALL:
			int currentShields = player.GetShieldHealth()
			float shieldAmount = Consumable_CalculateTotalShieldFromItem( player, currentInfo )
			bool currentHealWillMaxOutShields = int( currentShields + shieldAmount ) >= player.GetShieldHealthMax()
			playerWillNeedShields = !currentHealWillMaxOutShields
			playerWillNeedHealth = player.GetHealth() < player.GetMaxHealth()
			break

		default:
			return false
	}

	ConsumableInfo nextInfo = Consumable_GetInfo_ByType( nextItem )
	int nextItemCount = SURVIVAL_CountItemsInInventory( player, nextInfo.lootData.ref )
	if ( nextItem == currentConsumableType && !PlayerHasPassive( player, ePassives.PAS_INFINITE_HEAL ) )
	{
		nextItemCount -= 1 		
	}

	if ( nextItemCount <= 0 )
		return false

	switch( nextItem )
	{
		case eHealthPickupType.COMBO_FULL:
			return playerWillNeedHealth || playerWillNeedShields

		case eHealthPickupType.HEALTH_LARGE:
		case eHealthPickupType.HEALTH_SMALL:
			return playerWillNeedHealth

		case eHealthPickupType.SHIELD_LARGE:
		case eHealthPickupType.SHIELD_SMALL:
			return playerWillNeedShields

		default:
			return false
	}

	unreachable
}

                         ␀