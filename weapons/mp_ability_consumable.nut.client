void function TryQueueNextItem( entity player, int nextConsumableType )
{
	Assert( Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )

	if ( file.clientPlayerNextMod == "" )
	{
#if CHAIN_HEAL_LOGGING_ENABLED
			printt("[ChainHeal]", FUNC_NAME(), "returning early... file.clientPlayerNextMod empty string" )
#endif
		return
	}

#if CHAIN_HEAL_LOGGING_ENABLED
		printt("[ChainHeal]", FUNC_NAME(), "called with nextConsumableType:", nextConsumableType, "current queued type:", chainHeal.nextHealInQueue )
#endif

	int curQueuedType = chainHeal.nextHealInQueue

	if ( Consumable_PlayerCanQueueItem( player, nextConsumableType ) )
	{
		chainHeal.nextHealInQueue = nextConsumableType
	}

	if ( curQueuedType != chainHeal.nextHealInQueue )
	{
		if ( IsValid( file.progressBarRui ) && RuiIsAlive( file.progressBarRui ) )
		{
			RuiSetInt( file.progressBarRui, "nextHealInQueue", chainHeal.nextHealInQueue )
			if ( chainHeal.nextHealInQueue != eHealthPickupType.INVALID )
				RuiSetImage( file.progressBarRui, "nextHealInQueueIcon", GetConsumableItemIcon( chainHeal.nextHealInQueue ) )
		}
		EmitSoundOnEntity( player, CHAIN_HEAL_SOUND_QUEUE )
#if CHAIN_HEAL_LOGGING_ENABLED
			printt("[ChainHeal]", FUNC_NAME(), "setting nextHealInQueue and calling RPC.  Type:", chainHeal.nextHealInQueue )
#endif
		Remote_ServerCallFunction( "ClientToServer_SetPlayerNextHealInQueue", chainHeal.nextHealInQueue )

		
		
		
		if ( Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE && curQueuedType != eHealthPickupType.INVALID )
		{
			chainHeal.shouldClearQueue = true
			Remote_ServerCallFunction( "ClientToServer_SetPlayerClearQueue", true )
		}
	}
	else
	{
		EmitSoundOnEntity( player, CHAIN_HEAL_SOUND_QUEUE_BLOCKED )
#if CHAIN_HEAL_LOGGING_ENABLED
			printt("[ChainHeal]", FUNC_NAME(), "nextHealInQueue unchanged" )
#endif
	}
}

void function Consumable_ClearQueuedHeal( entity player )
{
	if ( (Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE) && chainHeal.nextHealInQueue != eHealthPickupType.INVALID )
	{
		chainHeal.nextHealInQueue = eHealthPickupType.INVALID
		if ( IsValid( file.progressBarRui ) && RuiIsAlive( file.progressBarRui ) )
		{
			RuiSetInt( file.progressBarRui, "nextHealInQueue", eHealthPickupType.INVALID )
		}
		EmitSoundOnEntity( player, CHAIN_HEAL_SOUND_QUEUE_CANCEL )
		Remote_ServerCallFunction( "ClientToServer_SetPlayerNextHealInQueue", eHealthPickupType.INVALID )

#if CHAIN_HEAL_LOGGING_ENABLED
			printt("[ChainHeal]", FUNC_NAME(), ". Calling RPC with type INVALID" )
#endif

	}
}

