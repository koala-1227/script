bool function ShouldTryChainHeal( entity player, int consumableType )
{
	if ( !chainHeal.enabled )
		return false

	if ( !IsValidPlayer( player ) )
		return false

	if ( Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_OFF )
		return false

	switch ( Consumable_GetChainHealMode( player ) )
	{
		case eChainHealMode.CHAIN_HEAL_AUTO_QUEUE:
		case eChainHealMode.CHAIN_HEAL_QUEUE_NEXT:















			if ( chainHeal.nextHealInQueue == eHealthPickupType.INVALID )
			{
				return false
			}

			if ( Consumable_CanUseConsumable( player, chainHeal.nextHealInQueue, false ) )
				return true


			return false
		default:
			return false
	}

	unreachable
}

