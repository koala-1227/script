void function Consumable_HandleConsumableUseCommand( entity player, string consumableCommand )
{
	
	string consumableCommand_Lower = consumableCommand.tolower()
	int consType = -1
	if( consumableCommand_Lower in file.modNameToConsumableType )
	{
		consType = file.modNameToConsumableType[ consumableCommand_Lower ]

#if DEV
			printt( FUNC_NAME() + "(): consumableCommand_Lower = " + consumableCommand_Lower )
			printt( FUNC_NAME() + "(): consumableType = " + consType )
#endif

		Consumable_UseItemByType( player, consType )
		return
	}
	else
	{
		string warnString = FUNC_NAME() + "(): WARNING: consumableCommand " + consumableCommand + " unsupported."
		Warning( warnString )
	}
}

void function AddModAndFireWeapon_Thread( entity player, string modName )
{
	if ( !( player == GetLocalClientPlayer() && player == GetLocalViewPlayer() ) )
		return

	if ( player.IsBot() )
		return

	int consumableType  = file.modNameToConsumableType[ modName ]
	if ( !Consumable_CanUseConsumable( player, consumableType, true ) )
	{
#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABLE] Not allowed to use consumable (%s), not activating offhand weapon", modName )
#endif
		return
	}

	entity selectedWeapon = player.GetSelectedWeapon( eActiveInventorySlot.mainHand )
	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	if ( IsValid( selectedWeapon ) && selectedWeapon.GetWeaponClassName() == CONSUMABLE_WEAPON_NAME
			|| IsValid( activeWeapon ) && activeWeapon.GetWeaponClassName() == CONSUMABLE_WEAPON_NAME)
	{

		if ( chainHeal.enabled && (Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE) )
		{
			if ( chainHeal.nextHealInQueue != consumableType && Time() > file.timeActivated + chainHeal.queueDelay && Time() > file.timeDeactivated + chainHeal.queueDelay )
			{
				TryQueueNextItem( player, consumableType )
			}
			else if ( chainHeal.nextHealInQueue == consumableType && consumableType != eHealthPickupType.INVALID )
			{
				EmitSoundOnEntity( player, CHAIN_HEAL_SOUND_QUEUE_BLOCKED )
			}
		}
		else

		{
#if CONSUMABLE_LOGGING_ENABLED
			printf( "[CONSUMABLE] Already using consumable, not activating offhand weapon", modName )
#endif
		}
		return
	}


		if ( chainHeal.enabled )
		{
			chainHeal.nextHealInQueue = eHealthPickupType.INVALID
#if CHAIN_HEAL_LOGGING_ENABLED
				printt("[ChainHeal] AddModAndFireWeapon_Thread setting nextHealInQueue to INVALID.  Calling RPC to set on server." )
#endif
			Remote_ServerCallFunction( "ClientToServer_SetPlayerNextHealInQueue", chainHeal.nextHealInQueue )
		}


	if ( !IsWatchingReplay() )
	{
		if ( CharacterSelect_MenuIsOpen() )
			CloseCharacterSelectMenu()

		RunUIScript( "CloseAllMenus" )
	}

#if CONSUMABLE_LOGGING_ENABLED
	printf( "[CONSUMABLE] Activating offhand weapon, mod is %s", modName )
#endif
	file.clientPlayerNextMod = modName

	if( modName in file.modNameToConsumableType )
		Remote_ServerCallFunction( "ClientCallback_SetNextHealModType", file.modNameToConsumableType[ modName ] )

	ActivateOffhandWeaponByIndex( OFFHAND_SLOT_FOR_CONSUMABLES )
}

