void function Consumable_Init()
{
	RegisterWeaponForUse( CONSUMABLE_WEAPON_NAME )
	RegisterSignal( "HealEnded" )
	RegisterSignal( "ConsumableDestroyRui" )

	PrecacheParticleSystem( VFX_ULT_ACCEL_POP )

	Remote_RegisterServerFunction( "ClientCallback_SetSelectedConsumableTypeNetInt", "int", 0, MAX_SETABLE_CONSUMABLE_INDEX )
	Remote_RegisterServerFunction( "ClientCallback_SetNextHealModType", "int", 0, eHealthPickupType._count - 1 )
	Remote_RegisterClientFunction( "ServerToClient_TryUpdateCurrentSelectedConsumableToBest" )


		chainHeal.enabled = GetCurrentPlaylistVarBool( "chain_heal_enabled", true )
		if ( chainHeal.enabled )
		{
			Remote_RegisterServerFunction( "ClientToServer_SetPlayerNextHealInQueue", "int", eHealthPickupType.INVALID, eHealthPickupType._count )
			Remote_RegisterServerFunction( "ClientToServer_SetPlayerClearQueue", "bool" )

			chainHeal.additionalHolsterAnimDurationEnabled = GetCurrentPlaylistVarBool( "chain_heal_additional_holster_anim_duration_enabled", chainHeal.additionalHolsterAnimDurationEnabled )
			chainHeal.additionalHolsterAnimDuration = GetCurrentPlaylistVarFloat( "chain_heal_additional_holster_anim_duration", chainHeal.additionalHolsterAnimDuration )


				chainHeal.queueDelay = GetCurrentPlaylistVarFloat( "chain_heal_queue_delay", chainHeal.queueDelay )

		}


	RegisterNetworkedVariable( "isHealing", SNDC_PLAYER_EXCLUSIVE, SNVT_BOOL, false )
	RegisterNetworkedVariable( "healingKitTypeCurrentlyBeingUsed", SNDC_PLAYER_GLOBAL, SNVT_INT, -1 )
	RegisterNetworkedVariable( "healingKitEndTime", SNDC_PLAYER_GLOBAL, SNVT_TIME, 0.0 )

	int defaultHealOption = GetCurrentPlaylistVarBool( "auto_heal_option", false ) ? -1 : 0
	RegisterNetworkedVariable( "selectedHealthPickupType", SNDC_PLAYER_EXCLUSIVE, SNVT_INT, defaultHealOption )
	Remote_RegisterClientFunction( "ServerCallback_TryUseConsumable", "entity", "int", 0, 128 )
	Remote_RegisterClientFunction( "ServerToClient_DoUltAccelScreenFx" )
	Remote_RegisterClientFunction( "ServerToClient_SetClientChargeTime", "int", 0, 64, "float", 0.0 , 100.0, 32)

	
	
	
	
	

	Consumable_ShieldLarge_Init()





	Consumable_ShieldSmall_Init()
	Consumable_PhoenixKit_Init()
	Consumable_HealthLarge_Init()
	Consumable_HealthSmall_Init()

	Consumable_UltimateBattery_Init()









		Consumable_ClockUp_Syringe_Init()

















		AddCallback_OnPlayerConsumableInventoryChanged( SwitchSelectedConsumableIfEmptyAndPushClientSelectionToServer ) 
		if ( GetPlaylistVar_ConsumableSelectAggressive() )
		{
			AddLocalPlayerTookDamageCallback( Consumable_OnPlayerDamaged )
		}

		SetCallback_UseConsumable( Consumable_HandleConsumableUseCommand )
		AddCallback_GameStateEnter( eGameState.Resolution, Consumable_OnGamestateEnterResolution )

		RegisterNetVarBoolChangeCallback( "isHealing", OnIsHealingChanged )
		RegisterNetVarIntChangeCallback( "healingKitTypeCurrentlyBeingUsed", OnInUseHealingKitTypeChanged )
		RegisterNetVarIntChangeCallback( "selectedHealthPickupType", OnHealthPickupTypeChanged )

		file.doExtraPredictableCheck = GetCurrentPlaylistVarBool( "consumable_do_extra_predictable_check", true )


		AddCallback_OnPassiveChanged( ePassives.PAS_ULT_ACCEL_CHARGE, UpgradedUltAccel_PassiveToggle ) 


}



void function Consumable_Register_ConsumableInfo( ConsumableInfo consumableInfo, bool addToUseOrder = true  )
{
	
	
	

	int consumableType = consumableInfo.consumableType

	if( consumableType <= eHealthPickupType.INVALID )
		return

	if( consumableType >= eHealthPickupType._count )
		return

	file.consumableTypeToInfo[ consumableType ] <- consumableInfo
	Consumable_Register_ModNameToConsumableType( consumableInfo.modName, consumableType )

	if( ( addToUseOrder ) && !file.consumableUseOrder.contains( consumableType ) )
	{
		file.consumableUseOrder.append( consumableType )
	}
}

ConsumableInfo function Consumable_GetInfo_ByType( int consumableType )
{
	Assert( consumableType in file.consumableTypeToInfo, "ERROR: Tried to get ConsumableInfo from unsupported type " + consumableType  )
	return file.consumableTypeToInfo[ consumableType ]
}

asset function GetConsumableItemIcon( int itemType )
{
	ConsumableInfo info = Consumable_GetInfo_ByType( itemType )
	return info.lootData.hudIcon
}

void function Consumable_Register_ModNameToConsumableType( string modName, int consumableType )
{
	file.modNameToConsumableType[ modName ] <- consumableType
}













bool function ShouldHaveFastUltAccel( entity player )
{
	bool shouldHaveFastUltAccel = false
	shouldHaveFastUltAccel = shouldHaveFastUltAccel || PlayerHasPassive( player, ePassives.PAS_ULT_ACCEL_CHARGE)

	return shouldHaveFastUltAccel
}

void function UpgradedUltAccel_PassiveToggle( entity player, int pas, bool didHave, bool nowHas )
{

		if ( !InPrediction() )
			return


	bool shouldToggleFastUltAccel = false
	shouldToggleFastUltAccel = shouldToggleFastUltAccel || pas == ePassives.PAS_ULT_ACCEL_CHARGE

	if ( shouldToggleFastUltAccel )
	{
		if ( nowHas )
		{
			entity weapon = player.GetOffhandWeapon( OFFHAND_SLOT_FOR_CONSUMABLES )
			if( IsValid( weapon ) )
			{
				if( weapon.HasMod( "ultimate_battery" ) )
				{
					weapon.RemoveMod( "ultimate_battery" )
					weapon.AddMod( "ultimate_battery_fast" )
				}
			}

		}
		if ( didHave )
		{
			entity weapon = player.GetOffhandWeapon( OFFHAND_SLOT_FOR_CONSUMABLES )
			if( IsValid( weapon ) )
			{
				if ( weapon.HasMod( "ultimate_battery_fast" ) )
				{
					weapon.RemoveMod( "ultimate_battery_fast" )
					weapon.AddMod( "ultimate_battery" )
				}
			}
		}
	}
}












void function TryAddWeaponPersistenceData( entity weapon )
{
	if (!( weapon in file.weaponPersistentData ))
	{
		ConsumablePersistentData data
		file.weaponPersistentData[ weapon ] <- data
	}
}

void function OnWeaponOwnerChanged_Consumable( entity weapon, WeaponOwnerChangedParams changeParams )
{
	entity weaponOwner = weapon.GetOwner()

	if ( !IsValid( changeParams.oldOwner ) )
	{

		if ( weaponOwner == GetLocalViewPlayer() )

		{
			TryAddWeaponPersistenceData( weapon )
		}
	}

	file.playerToLastHealChatterTime[ weaponOwner ] <- Time()
	file.playerToLastShieldChatterTime[ weaponOwner ] <- Time()

	if ( file.chargeTimesInitialized )
		return

	foreach ( string modName, int consumableType in file.modNameToConsumableType )
	{
		ConsumableInfo info = Consumable_GetInfo_ByType( consumableType )
		if ( info.chargeTime == UNSET_CHARGE_TIME )
		{










				if ( weapon.GetOwner() != GetLocalClientPlayer() || !InPrediction() )
					return

				weapon.SetMods( [ modName ] )
#if CONSUMABLE_LOGGING_ENABLED
				printf( "[CONSUMABlE-%s] OnWeaponOwnerChanged_Consumable: Add mod (%s)", weaponOwner.GetPlayerName(), modName )
#endif
				info.chargeTime = weapon.GetWeaponSettingFloat( eWeaponVar.charge_time )

		}
	}

	file.chargeTimesInitialized = true




		if( InPrediction()  )
			weapon.SetMods( [] )


#if CONSUMABLE_LOGGING_ENABLED
	printf( "[CONSUMABlE-%s] OnWeaponOwnerChanged_Consumable: Remove mods", weaponOwner.GetPlayerName() )
#endif
}

bool function WeaponShouldReactivateOnLower_Consumable( entity weapon )
{

	if ( !chainHeal.enabled )
		return false

	entity weaponOwner = weapon.GetOwner()
	if ( IsValid( weaponOwner ) )
	{
		if ( Consumable_GetChainHealMode( weaponOwner ) != eChainHealMode.CHAIN_HEAL_QUEUE_NEXT && Consumable_GetChainHealMode( weaponOwner ) != eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
			return false

























			if ( chainHeal.nextHealInQueue == eHealthPickupType.INVALID )
				return false

#if CHAIN_HEAL_LOGGING_ENABLED
				printt("[ChainHeal]", FUNC_NAME(), "returning true on type", chainHeal.nextHealInQueue )
#endif
			return true


	}

	return false
}

float function GetAdditionalHolsterAnimDuration_Consumable( entity weapon )
{
	entity weaponOwner = weapon.GetOwner()
	float duration = 0.0

	if ( IsValid( weaponOwner ) && chainHeal.additionalHolsterAnimDurationEnabled )
	{
















		if ( file.healCompletedSuccessfully && chainHeal.nextHealInQueue != eHealthPickupType.INVALID )
		{
			duration = chainHeal.additionalHolsterAnimDuration
		}

	}
	return duration
}

bool function OnWeaponAttemptOffhandSwitch_Consumable( entity weapon )
{
	string nextMod


















		nextMod = file.clientPlayerNextMod


	if ( !CanSwitchToWeapon( weapon, nextMod ) )
	{
#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABlE-%s] Offhand switch NOT allowed for nextMod (%s)", weapon.GetOwner().GetPlayerName(), nextMod )
#endif
		return false
	}

#if CONSUMABLE_LOGGING_ENABLED
	printf( "[CONSUMABlE-%s] Offhand switch allowed for nextMod (%s)", weapon.GetOwner().GetPlayerName(), nextMod )
#endif
	return true
}




















void function ApplyStickers( entity weapon )
{
	entity weaponOwner = weapon.GetOwner()
	string modName = GetConsumableModOnWeapon( weapon )

	entity weaponVm = weapon.GetWeaponViewmodel()
	if ( weaponVm )
	{
		DestroyAllStickersOnEntity( weaponVm )

		int stickerObjectType = GetStickerObjectType( modName )
		if ( stickerObjectType != -1 )
		{
			EHI weaponOwnerEHI = ToEHI( weaponOwner )
			int maxStickersForObjectType = GetMaxStickersForObjectType( stickerObjectType )

			for ( int stickerSlot = 0; stickerSlot < maxStickersForObjectType; ++stickerSlot )
			{
				SettingsAssetGUID stickerLoadoutSlotGuid = weaponOwner.GetStickerSlot( stickerObjectType * maxStickersForObjectType + stickerSlot )
				ItemFlavor ornull stickerItemOrNull = GetItemFlavorOrNullByGUID( stickerLoadoutSlotGuid )

				if (stickerItemOrNull == null)
					continue

				ItemFlavor stickerItem = expect ItemFlavor( stickerItemOrNull )

				if ( !Sticker_IsTheEmpty( stickerItem ) )
				{
					float scale = Sticker_GetDecalScale( stickerItem, stickerObjectType, stickerSlot + 1 )
					Sticker_PlaceDecalForLocalPlayer( weaponVm, Sticker_GetDecalMaterialAsset( stickerItem ), "STICKER_" + ( stickerSlot + 1 ), scale )
				}
			}
		}
	}
}


void function Consumable_RemoveDoubleJumpDisableStatusEffect( entity player )
{
	if ( !IsValid( player ) )
		return

	entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( weapon ) || !(weapon in file.weaponPersistentData) )
		return

	ConsumablePersistentData useData = file.weaponPersistentData[weapon]
	useData.statusEffectHandles.removebyvalue( useData.doubleJumpDisableStatusEffectHandle )
	StatusEffect_Stop( player, useData.doubleJumpDisableStatusEffectHandle )
}





















void function OnWeaponActivate_Consumable( entity weapon )
{
	entity weaponOwner = weapon.GetOwner()
	string modName

#if CHAIN_HEAL_LOGGING_ENABLED
		printt( "[ChainHeal]", FUNC_NAME(), Time() )
#endif


	TryAddWeaponPersistenceData( weapon )

























		
		
		if ( weapon.GetOwner() != GetLocalClientPlayer() && GetLocalViewPlayer() == weapon.GetOwner() )		
		{
			ApplyStickers( weapon )
		}




			file.timeActivated = Time()




		if ( weapon.GetOwner() != GetLocalViewPlayer() && !IsSpectatorSpectatingPlayer( weapon.GetOwner() ) )
			return


		if( file.clientPlayerNextMod == "ultimate_battery" )
		{
			if( ShouldHaveFastUltAccel( weapon.GetOwner() ) )
				file.clientPlayerNextMod = "ultimate_battery_fast"
		}

		modName = file.clientPlayerNextMod
#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABlE] Activating consumable (%s)", modName )
#endif

		if ( IsSpectator( GetLocalClientPlayer() ) )
		{
			modName = GetConsumableModOnWeapon( weapon )
			Assert( modName != "", "No consumable mod on weapon for pure spectator" )
		}

		
		if ( modName == "" )
			return

		file.healCompletedSuccessfully = false




	bool inPrediction = InPrediction() && weapon.IsPredicted()
	
	
	Assert( !inPrediction || weapon.GetPredictable() )
	inPrediction = file.doExtraPredictableCheck ? inPrediction && weapon.GetPredictable() : inPrediction
	if ( inPrediction )

	{















		if ( modName == "phoenix_kit" )
			weapon.SetWeaponSkin( 1 )
		else
			weapon.SetWeaponSkin( 0 )


		weapon.SetScriptTime0( Time() ) 
		weapon.SetMods( [ modName ] )
#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABLE-%s] OnWeaponActivate_Consumable: Add mod (%s)", weaponOwner.GetPlayerName(), modName )
#endif
	}


	ApplyStickers( weapon )

	
	if ( IsSpectatorSpectatingPlayer( weapon.GetOwner() ) )
	{
		TryAddWeaponPersistenceData( weapon )
	}


	ConsumablePersistentData useData = file.weaponPersistentData[weapon]
	ResetConsumableData( useData )

	if ( GetCurrentPlaylistVarBool( "survival_healthkits_limit_movement", true ) )
	{

		inPrediction = InPrediction()
		Assert( !inPrediction || weapon.GetPredictable() )
		inPrediction = file.doExtraPredictableCheck ? inPrediction && weapon.GetPredictable() : inPrediction
		if ( inPrediction )

		{




				if( Perk_CanPlayerSprintHeal( weaponOwner ) )
				{
					
					useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.move_slow, .06 ) )
				}
				else if( modName == "ultimate_battery" )
				{
					useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.move_slow, GetCurrentPlaylistVarFloat( "ult_accel_move_speed_reduction", .06 ) ) )
				}

				else if( Perk_CanPlayerSkirmisherHeal( weaponOwner ) )
				{
					float slowAmount = GetCurrentPlaylistVarFloat( "perk_sprint_heal_skirmisher_slow", 0.0 )
					useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.move_slow, slowAmount ) )

					const string SKIRMISHER_HEAL_MOD = "skirmisher_heal"
					if( !weapon.HasMod( SKIRMISHER_HEAL_MOD) )
						weapon.AddMod( SKIRMISHER_HEAL_MOD )
				}

				else if( GetCurrentPlaylistVarBool( "octane_run_with_meds_enabled", true ) && PlayerHasPassive( weaponOwner, ePassives.PAS_OCTANE ) && StatusEffect_HasSeverity( weaponOwner, eStatusEffect.speed_boost ) )
				{
					float slowAmount = GetCurrentPlaylistVarFloat( "octane_run_with_meds_slow", 0.0 )
					if( slowAmount > 0.0 )
					{
						useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.move_slow, slowAmount ) )
					}

					if( !weapon.HasMod( OCTANE_HEAL_MOD) )
						weapon.AddMod( OCTANE_HEAL_MOD )
				}
				else
				{
					useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.move_slow, GetCurrentPlaylistVarFloat( "survival_healthkits_move_speed_reduction", 0.4 ) ) )
				}



			useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.disable_wall_run, 1.0 ) )
			if ( !HasDoubleJumpFromJumpPad( weaponOwner ) )
			{
			 	int doubleJumpDisableHandle = StatusEffect_AddEndless( weaponOwner, eStatusEffect.disable_double_jump, 1.0 )
				useData.statusEffectHandles.append( doubleJumpDisableHandle )
				useData.doubleJumpDisableStatusEffectHandle = doubleJumpDisableHandle
			}


			useData.statusEffectHandles.append( StatusEffect_AddEndless( weaponOwner, eStatusEffect.disable_dodge, 1.0 ) )

		}
	}

	int consumableType  = file.modNameToConsumableType[ modName ]
	ConsumableInfo info = Consumable_GetInfo_ByType( consumableType )

























		if ( SURVIVAL_CountItemsInInventory( weapon.GetOwner(), info.lootData.ref ) <= 0 )
		{
#if CONSUMABLE_LOGGING_ENABLED
			printf( "[CONSUMABlE] Cancelling activation since we don't have required item (%s)", info.lootData.ref	)
#endif
			Consumable_CancelHeal( weapon.GetOwner() )
		}

		Chroma_ConsumableBegin( weapon, info )








	if ( Consumable_IsHealthItem( consumableType ) )
	{
		if ( (weaponOwner in file.playerToLastHealChatterTime) && Time() - file.playerToLastHealChatterTime[ weaponOwner ] > HEAL_CHATTER_DEBOUNCE )
		{

			if ( !IsSpectatorSpectatingPlayer( weaponOwner ) )

			{
				file.playerToLastHealChatterTime[ weaponOwner ] <- Time()
				if(modName == "phoenix_kit")
				{
					PlayBattleChatterToSelfOnClientAndTeamOnServer( weaponOwner, "bc_healingPhoenix" )
				}
				else
				{
					PlayBattleChatterToSelfOnClientAndTeamOnServer( weaponOwner, "bc_healing" )
				}
			}
		}
	}
	else if ( Consumable_IsShieldItem( consumableType ) )
	{
		if ( (weaponOwner in file.playerToLastHealChatterTime) && Time() - file.playerToLastShieldChatterTime[ weaponOwner ] > HEAL_CHATTER_DEBOUNCE )
		{

			if ( !IsSpectatorSpectatingPlayer( weaponOwner ) )

			{
				file.playerToLastShieldChatterTime[ weaponOwner ] <- Time()
				PlayBattleChatterToSelfOnClientAndTeamOnServer( weaponOwner, "bc_usingShieldCell" )
			}
		}
	}

	int consumableRecoveryType = Consumable_GetConsumableRecoveryType( consumableType )


	inPrediction = InPrediction()
	Assert( !inPrediction || weapon.GetPredictable() )
	inPrediction = file.doExtraPredictableCheck ? inPrediction && weapon.GetPredictable() : inPrediction
	if ( inPrediction )

	{
		weapon.SetScriptInt0( consumableRecoveryType )
#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABlE-%s] Done activating, setting consumable int to %d", weaponOwner.GetPlayerName(), consumableRecoveryType )
#endif
	}




























		thread Consumable_DisplayProgressBar( weaponOwner, weapon, consumableRecoveryType )

}


void function OnWeaponDeactivate_Consumable( entity weapon )
{
	entity weaponOwner = weapon.GetOwner()

	
	if ( !IsValid( weaponOwner ) )
		return

	ConsumablePersistentData useData














































































		if ( IsValid( weaponOwner ) && weaponOwner != GetLocalViewPlayer() )
			return

		Signal( weaponOwner, "ConsumableDestroyRui" )
		Chroma_ConsumableEnd()

#if CONSUMABLE_LOGGING_ENABLED
		printf( "[CONSUMABLE] OnWeaponDeactivate, file struct's nextMod is (%s)", file.clientPlayerNextMod )
#endif

		if ( !InPrediction() )
			return

		useData = file.weaponPersistentData[ weapon ]

		string currentMod = GetConsumableModOnWeapon( weapon )
		if ( currentMod != "" )
		{
			int consumableType  = file.modNameToConsumableType[ currentMod ]
			ConsumableInfo info = Consumable_GetInfo_ByType( consumableType )

			if ( !file.healCompletedSuccessfully && info.cancelSoundName != "" && DoesAliasExist( info.cancelSoundName ) )
			{
				EmitSoundOnEntity( weaponOwner, info.cancelSoundName )
			}

			if ( file.healCompletedSuccessfully && PlayerHasPassive( weaponOwner, ePassives.PAS_ENDORSEMENT_UPGRADE_CELL_TO_BAT ) && (currentMod == "shield_small" ) )
			{
				EmitSoundOnEntity( weaponOwner, "Shield_Battery_Primary_End_Overcharged_Wildcard" )
			}
		}


	if ( IsValid( weaponOwner ) )
	{
		foreach ( effectHandle in useData.statusEffectHandles )
			StatusEffect_Stop( weaponOwner, effectHandle )
		useData.doubleJumpDisableStatusEffectHandle = -1
	}


		bool previousHealCompleted = false

			previousHealCompleted = file.healCompletedSuccessfully
			file.timeDeactivated = Time()




		bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )   

		bool shouldTryChainHeal = previousHealCompleted && ShouldTryChainHeal( weaponOwner, file.modNameToConsumableType[ currentMod ] )
#if CHAIN_HEAL_LOGGING_ENABLED
			printt("[ChainHeal]", FUNC_NAME(), "shouldTryChainHeal:", string( shouldTryChainHeal ) )
#endif

		if ( shouldTryChainHeal )
		{
			if ( Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
			{
				int nextHealType = eHealthPickupType.INVALID






					nextHealType = chainHeal.nextHealInQueue


#if CHAIN_HEAL_LOGGING_ENABLED
					printt("[ChainHeal]", FUNC_NAME(), "nextHealType:", nextHealType )
#endif

				Assert( nextHealType in file.consumableTypeToInfo )
				ConsumableInfo nextHealTypeInfo = file.consumableTypeToInfo[nextHealType]






					file.clientPlayerNextMod = nextHealTypeInfo.modName

			}
		}
		else
		{
			if ( Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
			{










					chainHeal.nextHealInQueue = eHealthPickupType.INVALID
					if ( GetCurrentPlaylistVarBool( "chain_heal_clear_next_mod_on_deactivate", true ) )
					{
						file.clientPlayerNextMod = ""
					}



#if CHAIN_HEAL_LOGGING_ENABLED
					printt("[ChainHeal]", FUNC_NAME(), "setting nextHealInQueue to INVALID " )
#endif
			}

		}




	entity weaponVm = weapon.GetWeaponViewmodel()
	if ( IsValid( weaponVm ) && GetLocalViewPlayer() == weapon.GetOwner() )
	{
		thread function() : ( weaponVm, weapon )
		{
			
			while( IsValid( weapon ) && IsValid( weaponVm ) && GetLocalViewPlayer() == weapon.GetOwner() && weapon.GetOwner().GetActiveWeapon( eActiveInventorySlot.mainHand  ) == weapon )
			{
				WaitFrame()
			}

#if CONSUMABLE_LOGGING_ENABLED
			printt( "[CONSUMABLE] Removing stickers" )
#endif

			
			if ( IsValid( weaponVm ) )
				DestroyAllStickersOnEntity( weaponVm )
		}()
	}








}


void function OnWeaponRaise_Consumable( entity weapon )
{
	string modName
	entity weaponOwner = weapon.GetOwner()






		Assert( weaponOwner == GetLocalClientPlayer() )
		Assert( InPrediction() )

		if ( !IsFirstTimePredicted() )
			return

		modName = file.clientPlayerNextMod



		if ( chainHeal.enabled && (Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE) )
		{
				bool clearQueue = true

























				if ( Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
				{
					if ( Consumable_PlayerCanQueueItem( weaponOwner, chainHeal.nextHealInQueue ) )
					{
						if ( !chainHeal.shouldClearQueue )
						{
							clearQueue = false
						}
					}
				}

				if ( clearQueue )
				{
					chainHeal.nextHealInQueue = eHealthPickupType.INVALID
					if ( IsValid( file.progressBarRui ) && RuiIsAlive( file.progressBarRui ) )
					{
						RuiSetInt( file.progressBarRui, "nextHealInQueue", eHealthPickupType.INVALID )
					}
				}
#if CHAIN_HEAL_LOGGING_ENABLED
					printt("[ChainHeal]", FUNC_NAME(), clearQueue ? "next heal in queue set to" : "next heal type", chainHeal.nextHealInQueue )
#endif


			if ( Consumable_GetChainHealMode( weaponOwner ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
			{

					chainHeal.shouldClearQueue = false








			}
		}


#if CONSUMABLE_LOGGING_ENABLED
	printf( "[CONSUMABLE-%s] OnWeaponRaise for mod (%s)", weaponOwner.GetPlayerName(), modName )
#endif


		
		if ( modName == "" )
			return


	int consumableType = file.modNameToConsumableType[ modName ]
















	if ( modName == "phoenix_kit" )
		weapon.SetWeaponSkin( 1 )
	else
		weapon.SetWeaponSkin( 0 )


	weapon.SetMods( [ modName ] )
#if CONSUMABLE_LOGGING_ENABLED
	printf( "[CONSUMABlE-%s] OnWeaponRaise_Consumable: Add mod (%s)", weaponOwner.GetPlayerName(), modName )
#endif

	bool playSuperchargedFX = (file.consumableTypeToInfo[consumableType].ultimateAmount > 0) && ShouldPlayUltimateSuperchargedFX( weaponOwner )

	playSuperchargedFX = playSuperchargedFX && (consumableType != eHealthPickupType.CLOCKUP_SYRINGE)

	if ( playSuperchargedFX )
	{
			weapon.AddMod( "ultimate_battery_supercharged_fx" )
	}

	if( GetCurrentPlaylistVarBool( "octane_run_with_meds_enabled", true ) && PlayerHasPassive( weaponOwner, ePassives.PAS_OCTANE ) && StatusEffect_HasSeverity( weaponOwner, eStatusEffect.speed_boost ) )
	{
		weapon.AddMod( OCTANE_HEAL_MOD )
	}
}



void function Consumable_DisplayProgressBar( entity player, entity weapon, int consumableRecoveryType )
{
	player.EndSignal( "OnDeath", "OnChargeEnd", "ConsumableDestroyRui" )
	weapon.EndSignal( "OnDestroy" )

	string consumableName = weapon.GetWeaponSettingString( eWeaponVar.printname )
	asset hudIcon         = weapon.GetWeaponSettingAsset( eWeaponVar.hud_icon )
	float raiseTime       = weapon.GetWeaponSettingFloat( eWeaponVar.raise_time )
	float chargeTime      = weapon.GetWeaponSettingFloat( eWeaponVar.charge_time )

	var rui = CreateFullscreenRui( $"ui/consumable_progress.rpak" )

		if ( chainHeal.enabled )
		{
			file.progressBarRui = rui
			Consumable_RuiSetQueueActive()
			Consumable_RuiSetChainHealMode()
			Consumable_RuiSetPlayerCanQueueSelectedItem( player )
			if ( Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE )
			{
				RuiSetInt( file.progressBarRui, "nextHealInQueue", chainHeal.nextHealInQueue )
				if ( chainHeal.nextHealInQueue != eHealthPickupType.INVALID )
					RuiSetImage( file.progressBarRui, "nextHealInQueueIcon", GetConsumableItemIcon( chainHeal.nextHealInQueue ) )
			}
			RuiSetString( rui, "hintController", "#CHAIN_HEAL_CANCEL_HEAL_GAMEPAD" )
			RuiSetString( rui, "hintKeyboardMouse", "#CHAIN_HEAL_CANCEL_HEAL_PC" )
		}

	RuiSetGameTime( rui, "healStartTime", Time() )
	RuiSetString( rui, "consumableName", consumableName )
	RuiSetFloat( rui, "totalHealTime", raiseTime + chargeTime )
	RuiSetImage( rui, "hudIcon", hudIcon )
	RuiSetInt( rui, "consumableType", consumableRecoveryType )

	OnThreadEnd(
		function() : ( rui, player )
		{
			RuiDestroy( rui )

				file.progressBarRui = null

		}
	)

	
	float startTime = Time()
	float endTime = startTime + raiseTime + chargeTime
	float timeSpentInRaise = 0.0
	bool raiseDone = false
	float setPointTime = 0.0
	float ratioAtSetPoint = 0.0
	while ( Time() < endTime )
	{
		RuiSetVisible( rui, !file.observerModeNoShow )
		if ( !raiseDone && weapon.GetWeaponChargeFraction() > 0.0 )
		{
			timeSpentInRaise = weapon.GetWeaponSettingFloat( eWeaponVar.raise_time )
			raiseDone = true
		}
		
		if ( IsPlayerInCryptoDroneCameraView( player ) )
		{
			RuiSetString( rui, "hintController", "" )
			RuiSetString( rui, "hintKeyboardMouse", "" )
		} 
		else
		{

				if ( chainHeal.enabled )
				{
					RuiSetString( rui, "hintController", "#CHAIN_HEAL_CANCEL_HEAL_GAMEPAD" )
					RuiSetString( rui, "hintKeyboardMouse", "#CHAIN_HEAL_CANCEL_HEAL_PC" )
				}
				else

			{
				RuiSetString( rui, "hintController", "#SURVIVAL_CANCEL_HEAL_GAMEPAD" )
				RuiSetString( rui, "hintKeyboardMouse", "#SURVIVAL_CANCEL_HEAL_PC" )
			}
		}

		float newChargeTime = weapon.GetWeaponSettingFloat( eWeaponVar.charge_time )
		if( chargeTime != newChargeTime )
		{
			float newRaiseTime = weapon.GetWeaponSettingFloat( eWeaponVar.raise_time )

			float oldProgress
			if ( setPointTime == 0.0 )
			{
				oldProgress = ( Time() - startTime) / (endTime - startTime)
			}
			else
			{
				float tempProgress = (Time() - setPointTime) / ( endTime - setPointTime )
				oldProgress = Graph( tempProgress, 0, 1.0, ratioAtSetPoint, 1.0 )
			}

			if ( raiseDone )
			{
				raiseTime = timeSpentInRaise
			}
			else
			{
				raiseTime = newRaiseTime
			}

			chargeTime = newChargeTime
			float remainingTime = ( (raiseDone ? 0.0 : ( raiseTime - (Time() - startTime) ) ) + chargeTime * (1 - weapon.GetWeaponChargeFraction()) )
			float completedTime = ( Time() - startTime)
			endTime = Time() + remainingTime

			setPointTime = Time()
			ratioAtSetPoint = oldProgress
			RuiSetGameTime( rui, "endTime", endTime )
			RuiSetGameTime( rui, "setPointTime", setPointTime )
			RuiSetFloat( rui, "ratioAtSetPointTime", ratioAtSetPoint )
			RuiSetFloat( rui, "totalHealTime", remainingTime + completedTime )
		}

		bool isBoosted = PlayerHasPassive( player, ePassives.PAS_FAST_HEAL )
		string modName = GetConsumableModOnWeapon( weapon )
		bool hasSupportBoost = Perk_CanPlayerSprintHeal( player ) && (modName == "health_small" || modName == "shield_small")

		int MAX_PROGRESS_BUFFS_SHOWN = 3
		for(int i = 0; i < MAX_PROGRESS_BUFFS_SHOWN; i++ )
		{
			RuiSetFloatIfExists( rui, "iconBuffAlpha" + i, 0.0 )
		}
		array< asset > progressBuffAssets

		bool healDomeBoosted = false

		if( PlayerHasPassive( player, ePassives.PAS_BONUS_SMALL_HEAL ) )
		{
			if ( InDomeShield( player ) )
			{
				if ( modName == "health_small" || modName == "shield_small" )
				{
					isBoosted = true
					healDomeBoosted = true

					RuiSetFloatIfExists( rui, "iconBuffInlineAlpha", 1.0 )

					if ( modName == "health_small" )
					{
						RuiSetImageIfExists( rui, "iconBuffInline", $"rui/hud/legend_upgrades/upgrade_generic_health_regen" )
					}
					else
					{
						RuiSetImageIfExists( rui, "iconBuffInline", $"rui/hud/legend_upgrades/upgrade_generic_damage_mitigation" )
					}
				}
			}
		}

		if ( PlayerHasPassive( player, ePassives.PAS_ENDORSEMENT_FAST_RELOAD_FAST_HEALS ) && ( modName == "health_pickup_combo_small"  || modName == "shield_small" ) )
		{
			EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromRef( "fastreloadfastheals" )
			progressBuffAssets.push( endorsementDefinition.endorsementIcon )
		}
		if ( PlayerHasPassive( player, ePassives.PAS_ENDORSEMENT_UPGRADE_CELL_TO_BAT ) && ( modName == "health_pickup_combo_small"  || modName == "shield_small" ) )
		{
			EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromRef( "upgradecelltobat" )
			progressBuffAssets.push( endorsementDefinition.endorsementIcon )
		}
		if ( PlayerHasPassive( player, ePassives.PAS_HEAL_RADIUS ) && ( modName == "health_pickup_combo_small"  || modName == "shield_small" ) )
		{
			EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromRef( "squadheal" )
			progressBuffAssets.push( endorsementDefinition.endorsementIcon )
		}











		foreach ( int i, asset buffAsset in progressBuffAssets )
		{
			if( i >= MAX_PROGRESS_BUFFS_SHOWN )
				break

			RuiSetFloatIfExists( rui, "iconBuffAlpha" + i, 1.0 )
			RuiSetImageIfExists( rui, "iconBuff" + i, buffAsset )
		}

		RuiSetBool( rui, "isBoosted", isBoosted )

		if ( !healDomeBoosted )
			RuiSetFloat( rui, "iconBuffInlineAlpha", 0 )

		if( healDomeBoosted )
			RuiSetColorAlpha( rui, "boostedColor", SrgbToLinear( < 0.0, 0.8227857543962835, 1.0 > ), 1.0)
		else
			RuiSetColorAlpha( rui, "boostedColor", SrgbToLinear( < 0.0, 1.0, 0.73 > ), 1.0)

		RuiSetBool( rui, "isSupportClass", hasSupportBoost )
		RuiSetColorAlpha( rui, "supportClassColor", SrgbToLinear(CharacterClass_GetRoleColor(eCharacterClassRole.SUPPORT)), 1.0)



		WaitFrame()
	}
}


void function OnCreateMuzzleFlashEffect_Consumable( entity weapon, int fxHandle )
{
	if ( !IsValid( weapon.GetOwner() ) )
		return

	string modName = GetConsumableModOnWeapon( weapon )

	if ( modName == "health_small" )
		return

	if ( modName == "health_large" )
		return


		int armorTier   = UpgradeCore_GetPlayerArmorTier( weapon.GetOwner() )




	vector colorVec = GetFXRarityColorForTier( armorTier )

	EffectSetControlPointVector( fxHandle, 2, colorVec )
}

void function OnCreateChargeEffect_Consumable( entity weapon, int fxHandle )
{
	if ( !IsValid( weapon.GetOwner() ) )
		return

	if( weapon.GetOwner().IsCloaked(true) )
	{
		if ( EffectDoesExist( fxHandle ) )
			EffectStop( fxHandle, true, false ) 
		return
	}

	string modName = GetConsumableModOnWeapon( weapon )

	if ( modName == "health_small" )
		return

	if ( modName == "health_large" )
		return


		int armorTier   = UpgradeCore_GetPlayerArmorTier( weapon.GetOwner() )




	vector colorVec = GetFXRarityColorForTier( armorTier )

	if ( armorTier == 0 || weapon.GetOwner().GetShieldHealth() >= weapon.GetOwner().GetShieldHealthMax() )
		colorVec = HEALTH_RGB

	weapon.kv.renderColor = colorVec
	EffectSetControlPointVector( fxHandle, 2, colorVec )
}



bool function OnWeaponChargeBegin_Consumable( entity weapon )
{
	string currentMod = GetConsumableModOnWeapon( weapon )

#if CONSUMABLE_LOGGING_ENABLED
	if( currentMod == "" )
	{
		foreach ( string mod in weapon.GetMods() )
		{
			printt( "[CONSUMABLE] OnWeaponChargeBegin: No consumable mods on weapon, print current weapon mods: %s", mod )
		}
	}
#endif

	Assert( currentMod != "", "[CONSUMABLE] No consumable mods on weapon" )
	if ( currentMod == "" )
		return false

	entity player = weapon.GetOwner()

#if CONSUMABLE_LOGGING_ENABLED
	if ( IsValid( player ) )
		printf( "[CONSUMABLE-%s] OnWeaponChargeBegin (%s)", player.GetPlayerName(), currentMod )
#endif

	Assert( currentMod in file.modNameToConsumableType, "Invalid mod on consumable weapon: " + currentMod )
	if ( !(currentMod in file.modNameToConsumableType) )
		return false

	int consumableType  = file.modNameToConsumableType[ currentMod ]
	ConsumableInfo info = Consumable_GetInfo_ByType( consumableType )

	weapon.SetWeaponChargeFractionForced( 0.0 )

	TryAddWeaponPersistenceData( weapon )








		if ( player != GetLocalViewPlayer() || !(InPrediction() && IsFirstTimePredicted()) )
			return true

		if ( ShouldPlayUltimateSuperchargedFX( player ) && DoesAliasExist( WATTSON_EXTRA_ULT_ACCEL_SFX ) )
		{
			EmitSoundOnEntity( player, WATTSON_EXTRA_ULT_ACCEL_SFX )
		}










		if ( SURVIVAL_CountItemsInInventory( weapon.GetOwner(), info.lootData.ref ) <= 0 )
		{
#if CONSUMABLE_LOGGING_ENABLED
			printf( "[CONSUMABlE] Cancelling charge since we don't have required item (%s)", info.lootData.ref	)
#endif
			Consumable_CancelHeal( weapon.GetOwner() )
		}


	return true

}


void function OnWeaponChargeEnd_Consumable( entity weapon )
{
	string currentMod = GetConsumableModOnWeapon( weapon )
#if CONSUMABLE_LOGGING_ENABLED
	if( currentMod == "" )
	{
		foreach ( string mod in weapon.GetMods() )
		{
			printf( "[CONSUMABLE] OnWeaponChargeBegin: No consumable mods on weapon, print current weapon mods: %s", mod )
		}
	}
#endif

	Assert( currentMod != "", "[CONSUMABlE] No consumable mod on weapon" )
	entity player = weapon.GetOwner()

#if CONSUMABLE_LOGGING_ENABLED
	if ( IsValid( player ) )
		printf( "[CONSUMABLE-%s] OnWeaponChargeEnd (%s)", player.GetPlayerName(), currentMod )
#endif

	float chargeFracAtEnd = weapon.GetWeaponChargeFraction()
	if ( chargeFracAtEnd < 1.0 )
	{
		Signal( player, "OnChargeEnd" )
	}


	if ( player != GetLocalViewPlayer() )
		return

	if ( currentMod != "" ) 
	{
		if ( ShouldPlayUltimateSuperchargedFX( player ) )
		{
			StopSoundOnEntity( player, WATTSON_EXTRA_ULT_ACCEL_SFX )
		}
	}














}


var function OnWeaponPrimaryAttack_Consumable( entity weapon, WeaponPrimaryAttackParams attackParams )
{
	entity player = weapon.GetOwner()

	if ( weapon.GetWeaponChargeFraction() < 1.0 )
		return 0

	string currentMod = GetConsumableModOnWeapon( weapon )

#if CONSUMABLE_LOGGING_ENABLED
	if ( IsValid( player ) )
		printf( "[CONSUMABlE-%s] OnWeaponPrimaryAttack (%s)", player.GetPlayerName(), currentMod )
#endif

	if ( currentMod == "" )
		return 0

	int consumableType  = file.modNameToConsumableType[ currentMod ]
	ConsumableInfo info = Consumable_GetInfo_ByType( consumableType )












	if ( SURVIVAL_CountItemsInInventory( weapon.GetOwner(), info.lootData.ref ) <= 0 )
	{
		return 1
	}


	int healAmount = int( Consumable_CalculateTotalHealFromItem( player, info ) )
	int shieldAmount = int( Consumable_CalculateTotalShieldFromItem( player, info ) )


		string itemName  = info.lootData.ref





































		if( Augments_BatteryPrinter_PlayerHasInfiniteConsumableUses( player, itemName ) )
		{
			
			thread SetBeingReusedAnimationThread( player, REUSE_ANIMATION_DURATION )
		}










		if ( player != GetLocalViewPlayer() )
			return

		file.healCompletedSuccessfully = true

		if ( !IsFirstTimePredicted() )
			return

		bool playerAtFullHealthAndShields = (player.GetHealth() + healAmount) >= player.GetMaxHealth() && (player.GetShieldHealth() + shieldAmount) >= player.GetShieldHealthMax()



		if ( !playerAtFullHealthAndShields && !IsConsumableTypeUsefulToPlayer( player, file.clientSelectedConsumableType, healAmount, shieldAmount ) )

		{
			TryUpdateCurrentSelectedConsumableToBest( player, healAmount, shieldAmount )
		}


		if ( GamemodeVariant_UH_ClockUp_IsClockUpEnabled() )
		{
			TryUpdateCurrentSelectedConsumableToBest( player, healAmount, shieldAmount )
		}


		if ( info.callback_DoOnUseFX != null )
		{
			info.callback_DoOnUseFX( player )
		}
		else
		{
			if ( healAmount > 0 && (shieldAmount == 0 || (player.GetShieldHealth() >= player.GetShieldHealthMax())) )
			{
				Consumable_DoHealScreenFx( player )
			}
			else if ( info.ultimateAmount > 0 )
			{
				Consumable_DoUltAccelScreenFx( player )
			}
		}

		Chroma_ConsumableSucceeded( info )


	return 1
}


float function Consumable_CalculateTotalHealFromItem( entity player, ConsumableInfo info )
{

		if ( Augments_Enabled() && info.healAmount == 0 && PlayerHasPassive( player, ePassives.PAS_AUGMENT_HEAL_OVERFLOW ) )
		{
			return Augment_HealOverflow_GetShieldOverflowToHealAmount( info )
		}


	if ( info.healAmount == 0 )
		return 0.0

	if ( PlayerHasPassive( player, ePassives.PAS_SYRINGE_BONUS ) )
		return info.healAmount + info.healBonus[ ePassives.PAS_SYRINGE_BONUS ]

	if ( PlayerHasPassive( player, ePassives.PAS_HEALTH_BONUS_MED ) )
		return info.healAmount + info.healBonus[ ePassives.PAS_HEALTH_BONUS_MED ]

	if ( PlayerHasPassive( player, ePassives.PAS_HEALTH_BONUS_ALL ) )
		return info.healAmount + info.healBonus[ ePassives.PAS_HEALTH_BONUS_ALL ]

	if ( PlayerHasPassive( player, ePassives.PAS_BONUS_SMALL_HEAL ) && info.lootData.ref == "health_pickup_health_small" && !RingLethality_Is_Player_InRingOutWarning( player ) )
		return info.healAmount + info.healBonus[ ePassives.PAS_BONUS_SMALL_HEAL ]

	return float( info.healAmount )
}


float function Consumable_CalculateTotalShieldFromItem( entity player, ConsumableInfo info )
{

		if ( Augments_Enabled() && info.shieldAmount == 0 && PlayerHasPassive( player, ePassives.PAS_AUGMENT_HEAL_OVERFLOW ) )
		{
			return Augment_HealOverflow_GetHealOverflowToShieldAmount( info )
		}


	if ( info.shieldAmount == 0 )
		return 0.0

	if ( PlayerHasPassive( player, ePassives.PAS_BONUS_SMALL_HEAL ) && info.lootData.ref == "health_pickup_combo_small" )
		return info.shieldAmount + info.shieldBonus[ ePassives.PAS_BONUS_SMALL_HEAL ]










	return float( info.shieldAmount )
}

ConsumableInfo function GetConsumableInfoFromRef( string ref )
{
	foreach ( int consumableType, ConsumableInfo info in file.consumableTypeToInfo )
	{
		if ( info.lootData.ref == ref )
			return info
	}

	Assert( false, "Unknown ref \"" + ref + "\" used in mp_ability_consumable." )
	unreachable
}

bool function IsConsumableTypeUsefulToPlayer( entity player, int consumableType, int addedHealth, int addedShields )
{
	if ( !IsValid( player ) || !IsAlive( player ) )
		return false

	if ( ! (consumableType in file.consumableTypeToInfo) )
		return false

	ConsumableInfo info = file.consumableTypeToInfo[consumableType]

	int healAmount = int( Consumable_CalculateTotalHealFromItem( player, info ) )
	bool canHealHealth = healAmount > 0 && ((player.GetHealth() + addedHealth) < player.GetMaxHealth())
	int shieldAmount = int( Consumable_CalculateTotalShieldFromItem( player, info ) )
	bool canHealShields = shieldAmount > 0 && ((player.GetShieldHealth() + addedShields) < player.GetShieldHealthMax())


	if ( (consumableType == eHealthPickupType.CLOCKUP_SYRINGE) && (ClockUp_Cyberform_PlayerHasCyberwareEquipped( player ) || ClockUp_Cyberform_IsPlayerInCyberform(player)) )
		return true


	return canHealShields || canHealHealth
}

