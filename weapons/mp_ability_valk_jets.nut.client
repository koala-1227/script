			if ( nowHas )
				RuiSetFloat( Valk_GetJetPackRui(), "glideRechargeDelay", player.GetPlayerSettingFloat( "glideRechargeDelay" ) )

			if ( didHave )
			{
				if ( Valk_GetJetPackRui() != null )
					RuiSetFloat( Valk_GetJetPackRui(), "glideRechargeDelay", player.GetPlayerSettingFloat( "glideRechargeDelay" ) )
			}
		}














}












































































