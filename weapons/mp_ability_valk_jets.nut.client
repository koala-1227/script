const asset SKYWARD_JUMPJETS_FRIENDLY = $"P_valk_jet_fly_ON"
const asset SKYWARD_JUMPJETS_ENEMY = $"P_valk_jet_fly_ON"
const asset VALK_AMB_EXHAUST_FP = $"P_valk_spear_thruster_idle"
const asset VALK_AMB_EXHAUST_3P = $"P_valk_spear_thruster_idle_3P"


global const string VALK_JETPACK_WEAPON_NAME = "mp_ability_valk_jets"


const string JETPACK_OFF_SIGNAL = "JetpackOff"

const string VALK_TEAMMATE_START_TRACKING_SIGNAL = "ValkTeammateStartTracking"
const string VALK_FLIGHT_REVEAL_SIGNAL = "ValkFlightReveal"







const string VALK_TRACKING_ACTIVE_NETVAR = "valkTrackingActive"


global const string VALK_UPGRADE_PAS_AIR_CONTROL = "valk_jetpack_manuverability"
global const string VALK_UPGRADE_PAS_EFFICIENCY = "valk_jetpack_increased_efficiency"
global const string VALK_SKYDIVE_IMPROVEMENTS = "valk_skydive_improvements"
global const string VALK_JETPACK_COOLDOWN_ON_GROUND = "valk_jetpack_cooldown_on_ground"

enum eJetpackCooldownMode
{
	ALWAYS,
	WAIT_FOR_FIRST_GROUND_TOUCH,
	ONLY_WHEN_GROUNDED
}

struct
{
	float jetpackReactivationDelay = 0.25
	bool valkJetsPredictFix = true


		float ultHudHighlightRange = 210 * METERS_TO_INCHES
		float ultHudHighlightRangeSqr
		float ultHudHighlightRangeUpgrade = 250 * METERS_TO_INCHES
		float ultHudHighlightRangeUpgradeSqr

		float ultHudHighlightRangeUpgradeThroughWalls = 100 * METERS_TO_INCHES
		float ultHudHighlightRangeUpgradeThroughWallsSqr









} tuning

struct
{

		int  colorCorrection
		bool colorCorrectionActive

		int						valkTrackersActive
		array<entity>			valkEnemiesTracked
		table<entity, int>		valkEnemiesTrackedCount

		var jetPackRui


	table<entity, float>                  valkToJumpHeldStartTime
	table<entity, array<entity> >         valkToJumpJetFXs








} file


void function MpAbilityValkJets_Init()
{
	SetupTuning()

	PrecacheWeapon( VALK_JETPACK_WEAPON_NAME )

	PrecacheParticleSystem( VALK_AMB_EXHAUST_FP )
	PrecacheParticleSystem( VALK_AMB_EXHAUST_3P )

	RegisterSignal( JETPACK_OFF_SIGNAL )

	RegisterSignal( VALK_FLIGHT_REVEAL_SIGNAL )
	RegisterSignal( VALK_TEAMMATE_START_TRACKING_SIGNAL )






	RegisterNetworkedVariable( VALK_TRACKING_ACTIVE_NETVAR, SNDC_PLAYER_GLOBAL, SNVT_BOOL, false )






		RegisterNetVarBoolChangeCallback( VALK_TRACKING_ACTIVE_NETVAR, OnValkTrackingChanged )
		AddCallback_CreatePlayerPassiveRui( Valk_CreateJetPackRui )
		AddCallback_DestroyPlayerPassiveRui( Valk_DestroyJetPackRui )
		file.colorCorrection = ColorCorrection_Register( "materials/correction/launch_hud.raw_hdr" )


	AddCallback_OnPassiveChanged( ePassives.PAS_VALK, OnPassiveChanged )

	AddCallback_OnPassiveChanged( ePassives.PAS_BOOSTED_JETPACK, BoostedJets_OnPassiveChanged )
	AddCallback_OnPassiveChanged( ePassives.PAS_EXTRA_JETPACK_FUEL, JetpackFuel_OnPassiveChanged )










}

void function SetupTuning()
{
	RegisterTuningStruct( "tuning", "valk_" )

		tuning.ultHudHighlightRangeSqr = pow( tuning.ultHudHighlightRange, 2 )
		tuning.ultHudHighlightRangeUpgradeSqr = pow( tuning.ultHudHighlightRangeUpgrade, 2 )

		tuning.ultHudHighlightRangeUpgradeThroughWallsSqr = pow( tuning.ultHudHighlightRangeUpgradeThroughWalls, 2 )


}

#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________JetpackRui___________________________(){}
