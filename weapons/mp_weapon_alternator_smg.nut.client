global function OnWeaponActivate_alternator_smg
global function OnWeaponDeactivate_alternator_smg
global function OnWeaponPrimaryAttack_alternator_smg
global function OnWeaponOwnerChanged_alternator_smg
global function MpWeaponAlternatorSMG_Init






	global function OnClientAnimEvent_alternator_smg



const ALTERNATOR_SMG_TRACER_FX = $"weapon_tracers_xo16_speed"
const ALTERNATOR_SMG_PRECACHE_FIX = $"P_mythic_alternt1_kill_3p"







const string MYTHIC_ALTERNATOR_ENGAGE_SIGNAL = "OnDeactivate_MythicAlternatorCompanionVO"



void function MpWeaponAlternatorSMG_Init()
{

		PrecacheParticleSystem( ALTERNATOR_SMG_TRACER_FX )

		RegisterNetVarIntChangeCallback( "kills", OnNetVarChange_PlayerKills )
		PrecacheParticleSystem( ALTERNATOR_SMG_PRECACHE_FIX )
		RegisterSignal( MYTHIC_ALTERNATOR_ENGAGE_SIGNAL )




		
		
		AddCallback_OnItemFlavorRegistered( eItemType.weapon_skin, void function( ItemFlavor skin ) {
			if ( MYTHIC_ALTERNATOR_WEAPON_SKIN_GUIDS.contains( ItemFlavor_GetGUID( skin ) ) )
			{
				PrecacheAllParticleSystemsOfMeleeSkinVfxAliases( skin )
			}
		} )

}

void function OnWeaponActivate_alternator_smg( entity weapon )
{
	GoldenHorseGreen_OnWeaponActivate( weapon )




}

void function OnWeaponDeactivate_alternator_smg( entity weapon )
{










	weapon.Signal( MYTHIC_ALTERNATOR_ENGAGE_SIGNAL )


}

var function OnWeaponPrimaryAttack_alternator_smg( entity weapon, WeaponPrimaryAttackParams attackParams )
{
	return FireWeaponPlayerAndNPC( weapon, attackParams, true )
}

void function OnWeaponOwnerChanged_alternator_smg( entity weapon, WeaponOwnerChangedParams wocp )
{


	entity localPlayer = GetLocalViewPlayer()
	if ( !IsValid( localPlayer ) )
		return

	int aliasId = GetAnyAliasIdForName( "bc_engagingEnemy" )
	if ( wocp.oldOwner == localPlayer && aliasId in localPlayer.p.battleChatterIdCallbackMap )
		delete localPlayer.p.battleChatterIdCallbackMap[ aliasId ]

	if ( wocp.newOwner == localPlayer )
	{
		
		
		localPlayer.p.battleChatterIdCallbackMap[ aliasId ] <- bool function( entity speaker ) : ( weapon )
		{
			thread PlayDelayedCompanionVO( speaker, weapon, "wpn_engageEnemy" )
			return false
		}
	}


}



const string DIALOGUE_VM_ATTACH = "fx_companion_center"

void function OnNetVarChange_PlayerKills( entity killer, int killCount )
{
	if ( killer != GetLocalViewPlayer() )
		return

	entity weapon = killer.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( weapon ) || weapon.GetReactiveKillLevelCount() == 0 )
		return

	int killThreshold         = GetConVarInt( "script_weapon_mythic_multikill_kill_threshold" )
	int varietyTimeoutSec     = GetConVarInt( "script_weapon_mythic_multikill_variety_timeout_sec" )
	float multikillRollChance = GetConVarFloat( "script_weapon_mythic_multikill_roll_chance" )

	int roundThreshold        = GetCurrentPlaylistVarInt( "mythic_alternator_multikill_round_threshold", -1 )

	int currentRingRound = SURVIVAL_GetCurrentDeathFieldStage()
	bool thresholdMet    = ( killCount >= killThreshold )
	                       && ( roundThreshold < 0 || currentRingRound >= roundThreshold )

	int currentTimestamp = GetUnixTimestamp()
	int secSinceLastKill = currentTimestamp - killer.p.mythicAlternatorLastKillTimestamp

	bool playMultikill = false
	if ( thresholdMet )
	{
		if ( killCount == killThreshold )
			playMultikill = true                                    
		else if ( secSinceLastKill > varietyTimeoutSec )
			playMultikill = true                                    
		else
			playMultikill = RandomFloat( 1.0 ) < multikillRollChance 
	}

	string milesAlias
	if ( playMultikill )
	{
		int skinGUID = weapon.GetItemFlavorGUID()
		asset skinAsset = ItemFlavor_GetAsset( GetItemFlavorByGUID( skinGUID ) )
		milesAlias = skinAsset.find( "level02" ) != -1 ? "wpn_multikillTier2" : "wpn_multikillTier1"
	}
	else
	{
		milesAlias = killer.IsMechanical() ? "wpn_tauntRobot" : "wpn_tauntHuman"
	}

	thread PlayDelayedCompanionVO( killer, weapon, milesAlias )

	killer.p.mythicAlternatorLastKillTimestamp = currentTimestamp
}

void function PlayDelayedCompanionVO( entity player, entity weapon, string milesAlias )
{
	Assert ( IsNewThread(), "Must be threaded off." )

	weapon.EndSignal( MYTHIC_ALTERNATOR_ENGAGE_SIGNAL )
	weapon.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )

	entity weaponVM = player.GetViewModelEntity( eActiveInventorySlot.mainHand )
	if ( !IsValid( weaponVM ) )
		return

	int attachId = weaponVM.LookupAttachment( DIALOGUE_VM_ATTACH )
	if ( attachId == 0 )
		return

	weaponVM.EndSignal( "OnDestroy" )
	int weaponVMIdx = weaponVM.GetEntIndex()

	OnThreadEnd(
		function ( string signalId ) : ( weaponVMIdx )
		{
			if ( signalId != "" )
				Dialogue_CancelAllHandlesForSpeaker( weaponVMIdx )
		}
	)

	wait GetConVarInt( "script_weapon_mythic_vo_delay_sec" )

	thread PlayClientDialogueOnEntity( GetAnyAliasIdForName( milesAlias ), 0, weaponVM )
}










int function FireWeaponPlayerAndNPC( entity weapon, WeaponPrimaryAttackParams attackParams, bool playerFired )
{
	weapon.EmitWeaponNpcSound( LOUD_WEAPON_AI_SOUND_RADIUS_MP, 0.2 )
	int damageType = weapon.GetWeaponDamageFlags()
	
	
	
	
	
	
	
	
	weapon.FireWeaponBullet( attackParams.pos, attackParams.dir, 1, damageType )

	return 1
}


void function OnClientAnimEvent_alternator_smg( entity weapon, string name )
{
	GlobalClientEventHandler( weapon, name )
}








