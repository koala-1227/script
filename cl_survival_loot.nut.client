table<int, float> s_highlightFillCache
float function GetHighlightFillAlphaForLoot( entity lootEnt )
{
	int survivalInt = lootEnt.GetSurvivalInt()

	
	
	

	if ( !(survivalInt in s_highlightFillCache) )
	{
		vector mins = lootEnt.GetBoundingMins()
		vector maxs = lootEnt.GetBoundingMaxs()

		float volume = (maxs.x - mins.x) * (maxs.y - mins.y) * (maxs.z - mins.z)

		s_highlightFillCache[survivalInt] <- GraphCapped( volume, LOOT_FILL_VOLUME_MIN, LOOT_FILL_VOLUME_MAX, LOOT_FILL_ALPHA_MAX, LOOT_FILL_ALPHA_MIN )
	}

	return s_highlightFillCache[survivalInt]

}

void function ApplyEquipmentColorAndFXOverrides( entity prop )
{
	if ( !IsValid( prop ) )
		return

	if ( Deathbox_IsLootEntInsideDeathbox( prop ) )
		return

	LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( prop.GetSurvivalInt() )
	int lootType      = lootData.lootType

	if ( (lootType == eLootType.ARMOR || lootType == eLootType.HELMET) && lootData.skinOverride <= 0 )
	{
		vector tierColor       = GetFXRarityColorForTier( lootData.tier )
		string tierColorString = format( "%f %f %f", tierColor.x, tierColor.y, tierColor.z )

		if( UpgradeCore_IsEquipmentArmorCore( lootData.ref ) && GetPropSurvivalMainPropertyFromEnt( prop ) == 0 )
		{
			tierColorString = format( "%f %f %f", 50.0, 50.0, 50.0 )
		}

		prop.kv.rendercolor = tierColorString

		if ( EvolvingArmor_IsEquipmentEvolvingArmor( lootData.ref ) )
		{
			int fxIdx   = GetParticleSystemIndex( EVO_ARMOR_FX )

			if( (prop in file.equipmentFX) && EffectDoesExist( file.equipmentFX[prop] ) )
				EffectStop( file.equipmentFX[prop], true, false )

			int armorFX = StartParticleEffectOnEntityWithPos( prop, fxIdx, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, < 0, 0, 15>, <0, 0, 0> )
			EffectSetControlPointVector( armorFX, 1, tierColor )
			file.equipmentFX[prop] <- armorFX
		}
	}
}

void function ClearLootBrand( var rui )
{
	RuiSetBoolIfExists( rui, "hasBrand", false )
	RuiSetImageIfExists( rui, "brandLogo", $"" )
	RuiSetImageIfExists( rui, "brandTexture", $"" )
	RuiSetBoolIfExists( rui, "hasBrandTierColor", false )
}

asset function GetWeaponLootIcon_Square( LootData weaponData ) 
{
	asset icon = weaponData.hudIcon

	
	if ( weaponData.lootType != eLootType.MAINWEAPON )
		return icon

	bool showAkimboIcon = CanWeaponAkimbo( weaponData.baseWeapon ) && weaponData.baseMods.contains( WEAPON_LOCKEDSET_MOD_AKIMBO )
	string iconField = showAkimboIcon ? "hud_icon_akimbo_square" : "hud_icon_square"

	if ( IsWeaponKeyFieldDefined( weaponData.baseWeapon, iconField ) )
		icon = GetWeaponInfoFileKeyFieldAsset_Global( weaponData.baseWeapon, iconField )

	return icon
}

asset function GetWeaponLootIcon_WeaponLootHint( entity player, LootData weaponData ) 
{
	asset icon = weaponData.hudIcon

	
	if ( weaponData.lootType != eLootType.MAINWEAPON || !CanWeaponAkimbo( weaponData.baseWeapon ) )
		return icon

	bool showAkimboActiveIcon = false

	if ( SURVIVAL_Weapon_IsAttachmentLocked( weaponData.ref ) )
	{
		if ( weaponData.baseMods.contains( WEAPON_LOCKEDSET_MOD_AKIMBO ) ) 
		{
			showAkimboActiveIcon = true
		}
		else 
		{
			return GetWeaponInfoFileKeyFieldAsset_Global( weaponData.baseWeapon, "hud_icon" )
		}
	}
	else
	{
		array<entity> weapons = SURVIVAL_GetPrimaryWeapons( player )
		foreach ( weapon in weapons )
		{
			if ( weapon.GetWeaponClassName() == weaponData.baseWeapon && !SURVIVAL_Weapon_IsAttachmentLocked( GetWeaponClassNameWithLockedSet( weapon ) ) && !weapon.IsAkimboAvailable() ) 
			{
				showAkimboActiveIcon = true
				break
			}
		}
	}

	string weaponInfoField = showAkimboActiveIcon ? "hud_icon_akimbo_active" : "hud_icon_akimbo_empty"
	if ( IsWeaponKeyFieldDefined( weaponData.baseWeapon, weaponInfoField ) )
	{
		icon = GetWeaponInfoFileKeyFieldAsset_Global( weaponData.baseWeapon, weaponInfoField )
	}

	return icon
}

asset function GetWeaponLootIcon_ItemLootHint( entity player, LootData weaponData, entity weaponEntity ) 
{
	asset icon = weaponData.hudIcon
	if ( weaponData.lootType != eLootType.MAINWEAPON || !CanWeaponAkimbo( weaponData.baseWeapon ) )
		return icon

	bool showAkimboActiveIcon = false

	if ( SURVIVAL_Weapon_IsAttachmentLocked( GetWeaponClassNameWithLockedSet( weaponEntity ) ) ) 
	{
		if ( weaponEntity.IsAkimboAvailable() ) 
		{
			showAkimboActiveIcon = true
		}
		else 
		{
			return GetWeaponInfoFileKeyFieldAsset_Global( weaponData.baseWeapon, "hud_icon" )
		}
	}
	else if ( weaponEntity.IsAkimboAvailable() )
	{
		showAkimboActiveIcon = true
	}

	string weaponInfoField = showAkimboActiveIcon ? "hud_icon_akimbo_active" : "hud_icon_akimbo_empty"
	if ( IsWeaponKeyFieldDefined( weaponData.baseWeapon, weaponInfoField ) )
	{
		icon = GetWeaponInfoFileKeyFieldAsset_Global( weaponData.baseWeapon, weaponInfoField )
	}

	return icon
}

void function UpdateMapPingRuiForLoot( var rui, LootData lootData )
{
	
	RuiSetFloat2IfExists( rui, "backgroundScale", <1, 1, 0> )
	RuiSetAssetIfExists( rui, "backgroundImage", $"" )
	RuiSetAssetIfExists( rui, "frameImage", $"" )
	RuiSetBoolIfExists( rui, "useGradeColor", false )

	
	
	

		if ( lootData.lootTags.contains( "corrupted_attachment" ) )
		{
			RuiSetFloat2IfExists( rui, "backgroundScale", <1.5, 1.5, 0> )
			RuiSetAssetIfExists( rui, "backgroundImage", $"rui/hud/ping/icon_ping_loot_inner_fill_corrupted" )
			RuiSetAssetIfExists( rui, "frameImage", $"rui/hud/ping/icon_ping_loot_inner_corrupted" )
			RuiSetBoolIfExists( rui, "useGradeColor", true )
		}

}

