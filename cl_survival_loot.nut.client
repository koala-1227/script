		if ( Consumable_ChainHealEnabled() && (Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE) && Consumable_GetNextHealInQueue( player ) != eHealthPickupType.INVALID )
			return

	Remote_ServerCallFunction( CMDNAME_PLAYER_SWITCHED_WEAPONS, -1 )
}


