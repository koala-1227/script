var function GetLootPrompt( entity lootEnt )
{
	int style = GetLootPromptStyle()

	LootData data = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )
	if ( data.lootType in file.lootTypePromptRui )
		return file.lootTypePromptRui[data.lootType][style]

	return file.lootPromptRui[style]
}


int lastPromptStyle
int function GetLootPromptStyle()
{
	int style = GetConVarInt( HUD_SETTING_LOOTPROMPTSTYLE )
	Assert( style < eLootPromptStyle._COUNT )

	if ( style != lastPromptStyle )
	{
		HideLootPrompts()
		MarkLootPromptDirty()
	}

	lastPromptStyle = style

	return style
}


void function HideLootPrompts()
{
	foreach ( lootType, ruis in file.lootTypePromptRui )
	{
		foreach ( rui in ruis )
		{
			RuiSetVisible( rui, false )
			RuiSetBool( rui, "isVisible", false )
		}
	}

	foreach ( rui in file.lootPromptRui )
	{
		RuiSetVisible( rui, false )
		RuiSetBool( rui, "isVisible", false )
	}
}

void function MarkLootPromptDirty()
{
	file.lootPromptDirty = true
}

void function ResetLootPromptDirtyState()
{
	file.lootPromptDirty = true

	
	LootPromptSnapshot emptySnapshot
	file.lootPromptSnapshot = emptySnapshot
}

void function Sur_OnPlayerConsumableInventoryChanged( entity player )
{
	if ( player == GetLocalViewPlayer() )
	{
		MarkLootPromptDirty()
	}
}

string function GetLootPromptWeaponStateKey( entity weapon )
{
	if ( !IsValid( weapon ) )
		return ""

	
	string weaponStateKey = weapon.GetWeaponClassName()
	foreach ( string mod in weapon.GetMods() )
	{
		weaponStateKey += "|" + mod
	}

	return weaponStateKey
}

bool function ShouldRefreshFocusedLootPrompt( entity player, entity ent, LootRef lootRef, string lootRefString )
{
	
	LootPromptSnapshot snapshot
	entity weapon0 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
	entity weapon1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
	snapshot.ent = ent
	snapshot.entHandle = ent.GetEncodedEHandle()
	snapshot.lootIndex = ent.GetSurvivalInt()
	snapshot.count = lootRef.count
	snapshot.lootProperty = lootRef.lootProperty
	snapshot.lootExtraProperty = lootRef.lootExtraProperty
	snapshot.weapon0 = GetLootPromptWeaponStateKey( weapon0 )
	snapshot.weapon1 = GetLootPromptWeaponStateKey( weapon1 )
	snapshot.activeWeaponSlot = SURVIVAL_GetActiveWeaponSlot( player, true )
	snapshot.inventoryCount = SURVIVAL_GetInventoryCount( player )
	snapshot.itemCount = SURVIVAL_CountItemsInInventory( player, lootRefString )
	snapshot.extendedUseActive = player.p.isInExtendedUse

	
	bool shouldRefresh = file.lootPromptDirty
		|| file.lootPromptSnapshot.ent != snapshot.ent
		|| file.lootPromptSnapshot.entHandle != snapshot.entHandle
		|| file.lootPromptSnapshot.lootIndex != snapshot.lootIndex
		|| file.lootPromptSnapshot.count != snapshot.count
		|| file.lootPromptSnapshot.lootProperty != snapshot.lootProperty
		|| file.lootPromptSnapshot.lootExtraProperty != snapshot.lootExtraProperty
		|| file.lootPromptSnapshot.weapon0 != snapshot.weapon0
		|| file.lootPromptSnapshot.weapon1 != snapshot.weapon1
		|| file.lootPromptSnapshot.activeWeaponSlot != snapshot.activeWeaponSlot
		|| file.lootPromptSnapshot.inventoryCount != snapshot.inventoryCount
		|| file.lootPromptSnapshot.itemCount != snapshot.itemCount
		|| file.lootPromptSnapshot.extendedUseActive != snapshot.extendedUseActive

	if ( shouldRefresh )
	{
		
		file.lootPromptDirty = false
		file.lootPromptSnapshot = snapshot
	}

	return shouldRefresh
}


bool function ShouldOpenQuickswap( LootRef lootRef )
{
	entity player = GetLocalViewPlayer()

	if ( LootGoesInPack( GetLocalViewPlayer(), lootRef ) )
	{
		if ( SURVIVAL_AddToPlayerInventory( player, lootRef.lootData.ref, lootRef.count, false ) == 0 )
			return true
	}

	return false
}


string function Sur_LootTextOverride( entity ent )
{
	var rui = GetLootPrompt( ent )

	if ( Time() - ent.e.lastPredictedPickupSuccessTime < 0.5 )
	{
		RuiSetVisible( rui, false )
	}
	else
	{
		RuiSetVisible( rui, true )
	}

	entity player = GetLocalViewPlayer()
	LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )

	if( DoesPlayerHaveWeaponSling( player ) && IsPlayerWeaponSlingEmpty( player ) && CanPlayerEquipWeaponRefToSling( player, data.ref, true ) )
	{
		var slingPassiveRui = GetSlingPassiveRui()

		if ( slingPassiveRui != null )
		{
			RuiSetBool( slingPassiveRui, "slingEmptyAimingAtWeapon", true )
		}
	}

	UpdateUseHintForEntity( ent )

	LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )
	LootRef lootRef   = SURVIVAL_CreateLootRef( lootData, ent )
	lootRef.count = ent.GetClipCount()

	if ( LootGoesInPack( player, lootRef ) )
	{
		bool playerHasRoomForLoot = SURVIVAL_AddToPlayerInventory( player, lootRef.lootData.ref, lootRef.count, false ) > 0
		if ( !playerHasRoomForLoot )
		{
			LootActionStruct asMain = SURVIVAL_BuildStringForAction( GetLocalViewPlayer(), eLootContext.GROUND, lootRef, eLootActionType.PRIMARY_ACTION, false )
			LootActionStruct asAlt  = SURVIVAL_BuildStringForAction( GetLocalViewPlayer(), eLootContext.GROUND, lootRef, eLootActionType.ALT_ACTION, false )


			if ( ReservedInventory_IsEnabled() && !ReservedInventory_IsItemSwappable( lootRef.lootData ) )
			{
				if ( asMain.action == eLootAction.PICKUP )
				{
					 RuiSetString( rui, "usePromptText", Localize( "#INVENTORY_SLOT_FULL" ) )
				}
				else if ( asAlt.action == eLootAction.PICKUP && ShouldShowButtonHints() )
				{
					 RuiSetString( rui, "altUsePromptText", Localize( "#INVENTORY_SLOT_FULL" ) )
				}
			}
			else

			{
				if ( asMain.action == eLootAction.PICKUP )
				{
					if ( GetLootPromptStyle() == eLootPromptStyle.COMPACT )
						RuiSetString( rui, "usePromptText", Localize( "#HINT_SWAP_COMPACT" ) )
					else
						RuiSetString( rui, "usePromptText", Localize( "#HINT_SWAP_ON_USE" ) )
				}
				else if ( asAlt.action == eLootAction.PICKUP && ShouldShowButtonHints() )
				{
					if ( GetLootPromptStyle() == eLootPromptStyle.COMPACT )
						RuiSetString( rui, "altUsePromptText", Localize( "#HINT_SWAP_COMPACT_ALT" ) )
					else
						RuiSetString( rui, "altUsePromptText", Localize( "#HINT_SWAP_ON_USE_ALT" ) )
				}
			}
		}
	}

	return ""
}


void function Sur_OnUseEntGainFocus( entity ent )
{
	MarkLootPromptDirty()
	UpdateUseHintForEntity( ent )

	if ( ent.GetNetworkedClassName() == "prop_survival" )
	{
		GetLocalViewPlayer().Signal( "TrackLootToPing" )

		ent.e.isSelected = true
		SURVIVAL_Loot_UpdateHighlightForLoot( ent )
		RuiSetGameTime( GetLootPrompt( ent ), "lastUseTime", 0 )

		int index = ent.GetSurvivalInt()

		LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )
		if ( data.lootType == eLootType.MAINWEAPON )
			TryStreamHintForWeapon( ent )
	}
}


void function TryStreamHintForWeapon( entity ent )
{
	int skinGUID = ent.GetItemFlavorGUID()
	ItemFlavor ornull weaponSkinOrNull
	if ( IsValidItemFlavorGUID( skinGUID ) )
	{
		weaponSkinOrNull = GetItemFlavorByGUID( skinGUID )
	}
	else
	{
		ItemFlavor ornull weaponItemOrNull = GetWeaponItemFlavorByClass( ent.GetWeaponName() )
		if ( weaponItemOrNull != null )
		{
			expect ItemFlavor( weaponItemOrNull )
			if ( LoadoutSlot_IsReady( ToEHI( GetLocalViewPlayer() ), Loadout_WeaponSkin( weaponItemOrNull  ) ) )
				weaponSkinOrNull = LoadoutSlot_GetItemFlavor( ToEHI( GetLocalViewPlayer() ), Loadout_WeaponSkin( weaponItemOrNull ) )
		}
	}

	if ( weaponSkinOrNull == null )
		return

	expect ItemFlavor( weaponSkinOrNull )


	if ( ItemFlavor_GetType( weaponSkinOrNull ) != eItemType.weapon_skin ) 
		return

	asset viewModel = WeaponSkin_GetViewModel( weaponSkinOrNull )

	StreamModelHint( viewModel )
}


void function Sur_OnUseEntLoseFocus( entity ent )
{
	entity player = GetLocalViewPlayer();

	if ( IsValid( player ) )
		thread TrackLootToPing( player )

	HideLootPrompts()
	ResetLootPromptDirtyState()

	if ( IsValid( player ) )
	{
		Signal( player, "ClearSwapOnUseThread" )
	}

	if ( IsValid( ent ) && ent.GetNetworkedClassName() == "prop_survival" )
	{
		ent.e.isSelected = false
		SURVIVAL_Loot_UpdateHighlightForLoot( ent )
	}

	if( IsValid( player ) && DoesPlayerHaveWeaponSling( player ) )
	{
		var slingPassiveRui = GetSlingPassiveRui()

		if ( GetPlayerSlingWeapon( player ) == null )
		{
			if ( slingPassiveRui != null )
			{
				RuiSetBool( slingPassiveRui, "slingEmptyAimingAtWeapon", false )
			}
		}
	}
}


void function SURVIVAL_Loot_UpdateRuiLastUseTime( entity ent, var rui = null )
{
	if ( !IsFullyConnected() )
		return

	if ( rui == null )
		rui = GetLootPrompt( ent )

	RuiSetGameTime( rui, "lastUseTime", Time() )
}


void function UpdateUseHintForEntity( entity ent, var rui = null, int promptDetail = LOOT_PROMPT_DETAIL_FULL )
{
	if ( !IsFullyConnected() )
		return

	if ( !ShouldLootHintBeVisible( ent ) )
	{
		HideLootPrompts()
		if ( rui != null )
			RuiSetVisible( rui, false )
		return
	}

	PerfStart( PerfIndexClient.UpdateLootRui )

	if ( rui == null )
		rui = GetLootPrompt( ent )

	entity player                 = GetLocalViewPlayer()
	bool isPinged                 = Waypoint_LootItemIsBeingPingedByAnyone( ent )
	entity focusedWp              = GetFocusedWaypointEnt()

	bool isFocusedOnOtherWaypoint

	
	if( IsValid( focusedWp ) )
	{
		if( focusedWp.GetParent() == ent ) 
		{
			isFocusedOnOtherWaypoint = false
		}
		else if ( focusedWp != ent ) 
		{
			isFocusedOnOtherWaypoint = true
		}
	}
	else
	{
		isFocusedOnOtherWaypoint = false
	}

	LootData data                 = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )

	data.hudIcon = GetWeaponLootIcon_WeaponLootHint( player, data )

	RuiSetBool( rui, "isTooltip", false )
	RuiSetBool( rui, "isPinged", isPinged )
	RuiSetBool( rui, "isFocusedOnOtherWaypoint", isFocusedOnOtherWaypoint )
	RuiSetGameTime( rui, "localPingBeginTime", ent.e.localPingBeginTime )

	if ( EyeForQualityAllowLongRangeItems( player ) )
	{
		RuiSetBool( rui, "hideDuringADS", false )
	}
	else
	{
		RuiSetBool( rui, "hideDuringADS", true )
	}

	LootRef lootRef = SURVIVAL_CreateLootRef( data, ent )
	lootRef.count = ent.GetClipCount()

	
	
	bool shouldRefresh = promptDetail == LOOT_PROMPT_DETAIL_FAR || ShouldRefreshFocusedLootPrompt( player, ent, lootRef, data.ref )
	if ( shouldRefresh )
	{
		UpdateLootRuiWithData( player, rui, data, eLootContext.GROUND, lootRef, false, eLockedInventoryReason.NOT_LOCKED, promptDetail )
	}

	entity pingWaypoint = Waypoint_GetWaypointForLootItemPingedByPlayer( ent, player )
	RuiSetBool( rui, "isPingedByUs", IsValid( pingWaypoint ) )
	RuiSetInt( rui, "eHandle", ent.GetEncodedEHandle() )
	RuiSetInt( rui, "predictedUseCount", ent.e.predictedUseCount )

	RuiTrackFloat3( rui, "worldPos", ent, RUI_TRACK_ABSORIGIN_FOLLOW )

	float zOffset = ent.GetBoundingMaxs().z

		if ( TitanSword_WeaponRefIsTitanSword( data.ref ) )
			zOffset = 10 

	RuiSetFloat( rui, "zOffset", zOffset )

	PerfEnd( PerfIndexClient.UpdateLootRui )

	if( DoesPlayerHaveWeaponSling( player ) && CanPlayerEquipWeaponRefToSling( player, data.ref, true ) )
		RuiSetBool( rui, "usesSlingWeapon", true )
	else
		RuiSetBool( rui, "usesSlingWeapon", false )
}


table<string, string> function BuildAttachmentMapForPickupPrompt( entity player, LootData data, LootRef lootRef, LootActionStruct asMain )
{
	
	if ( IsValid( lootRef.lootEnt ) && SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )
	{
		table<string, string> results
		array<string> mods = lootRef.lootEnt.GetWeaponMods()
		foreach ( mod in mods )
		{
			if ( SURVIVAL_Loot_IsRefValid( mod ) && (SURVIVAL_Loot_GetLootDataByRef( mod ).lootType == eLootType.ATTACHMENT) )
			{
				array<string> attachPoints = GetAttachPointsForAttachment( mod )
				foreach ( string attachPoint in attachPoints )
				{
					results[attachPoint] <- mod
				}
			}
		}

		return results
	}

	
	array<entity> weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )
	entity latestPrimary  = (weapons.len() > 0) ? weapons[0] : null
	if ( IsValid( latestPrimary ) && (asMain.action == eLootAction.SWAP) )
	{
		LootData weapData = SURVIVAL_GetLootDataFromWeapon( latestPrimary )
		if ( (weapData.lootType == eLootType.MAINWEAPON) && SURVIVAL_Loot_IsRefValid( weapData.ref ) && !SURVIVAL_Weapon_IsAttachmentLocked( weapData.ref ) )
			return GetCompatibleAttachmentMap( player, latestPrimary, data.ref, true )
	}

	
	return GetCompatibleAttachmentsFromInventory( player, data.ref )
}

table<string, string> function AddLockedAttachPointsToAttachmentMapForPickupPrompt( LootData data, LootRef lootRef )
{
	table<string, string> results

	if ( IsValid( lootRef.lootEnt ) )
	{
		array<string> mods = lootRef.lootEnt.GetWeaponMods()
		foreach ( mod in mods )
		{
			if ( SURVIVAL_Loot_IsRefValid( mod ) && (SURVIVAL_Loot_GetLootDataByRef( mod ).lootType == eLootType.ATTACHMENT) )
			{
				array<string> attachPoints = GetAttachPointsForAttachment( mod )
				foreach ( string attachPoint in attachPoints )
				{
					if ( SURVIVAL_IsAttachmentPointLocked( data.ref, attachPoint, mods ) )
						results[attachPoint] <- mod
				}
			}
		}
	}

	return results
}


table<string, CustomItemPromptUpdateCB_t> s_customItemPromptUpdateCallbacks
void function RegisterCustomItemPromptUpdate( string lootRef, CustomItemPromptUpdateCB_t func )
{
	Assert( !(lootRef in s_customItemPromptUpdateCallbacks) )
	s_customItemPromptUpdateCallbacks[lootRef] <- func
}


void function UpdateLootRuiWithData( entity player, var rui, LootData data, int lootContext, LootRef lootRef, bool isInMenu, int lockedReason = eLockedInventoryReason.NOT_LOCKED, int promptDetail = LOOT_PROMPT_DETAIL_FULL )
{
	bool hasFullPromptDetail = promptDetail == LOOT_PROMPT_DETAIL_FULL

	RuiSetVisible( rui, true )
	if ( hasFullPromptDetail )
	{
		RuiDestroyNestedIfAlive( rui, "compatibleWeaponsHandle" )

			RuiDestroyNestedIfAlive( rui, "attachmentStatDisplayHandle" )

	}
	var nestedCompatibleWeaponsRui = hasFullPromptDetail ? RuiCreateNested( rui, "compatibleWeaponsHandle", $"ui/loot_pickup_tag_text.rpak" ) : null
	RuiSetBool( rui, "teammateNeedsThis", false )

	if ( file.showTeammateUsefulIcon )
	{
		foreach ( teammate in GetPlayerArrayOfTeam_Alive( player.GetTeam() ) )
		{
			if ( teammate == player )
				continue

			if ( SURVIVAL_IsLootAnUpgrade( teammate, lootRef.lootEnt, data, lootContext ) )
			{
				RuiSetBool( rui, "teammateNeedsThis", true )
				break
			}
		}
	}

	RuiSetBool( rui, "isVisible", true )
	RuiSetBool( rui, "isFocused", true )

	RuiSetImage( rui, "iconImage", data.hudIcon )

	bool isLootLocked = lockedReason != eLockedInventoryReason.NOT_LOCKED
	bool useCustomLootColor = false
	bool useAltTextColor = false
	bool useAltSubTextColor = false
	if( data.ref == CRAFTED_BANNER_REF || data.ref == BLACK_MARKET_BANNER_REF )
	{
		useCustomLootColor = true
		RuiSetFloat3( rui, "customLootColor", SrgbToLinear( GetKeyColor( COLORID_HUD_HEAL_COLOR ) / 255.0 ) )
	}
	if( data.ref == "hopup_golden_horse_green" )
	{
		useCustomLootColor = true
		RuiSetFloat3( rui, "customLootColor", SrgbToLinear( GetKeyColor( COLORID_HUD_LOOT_TIER_GH ) / 255.0 ) )
	}

	else if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
	{
		useCustomLootColor = true
		vector color
		switch ( data.skinOverride )
		{
			
			case 0:
				color = <73, 209, 27>
				break
			case 1:
				color = <235, 223, 63>
				break
			case 2:
				color = <255, 179, 242>
				break
			case 3:
				color = <64, 224, 208>
				break
			case 4:
				color = <44, 117, 255>
				break
			case 5:
				color = <240, 30, 2>
				break
			case 6:
				color = <235, 223, 63>
				useAltTextColor = true
				useAltSubTextColor = true
				RuiSetFloat3( rui, "altTextColor", SrgbToLinear( < 194, 142, 221 > / 255.0 ) )
				RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 194, 142, 221 > / 255.0 ) )
				break
			case 7:
				color = <192, 84, 255>
				break
			case 8:
				color = <255, 255, 255>
				break
			case 9:
				color = <255, 139, 0>
				break
			case 10:
				color = <0, 0, 0>
				useAltTextColor = true
				useAltSubTextColor = true
				RuiSetFloat3( rui, "altTextColor", SrgbToLinear( < 150, 150, 150 > / 255.0 ) )
				RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 150, 150, 150 > / 255.0 ) )
				break






		}
		RuiSetFloat3( rui, "customLootColor", SrgbToLinear( color / 255.0 ) )
	}


	RuiSetInt( rui, "lootTier", data.tier )
	RuiSetBool( rui, "useCustomLootColor", useCustomLootColor )
	RuiSetBool( rui, "useAltTextColor", useAltTextColor )

	ClearLootBrand( rui )

	LootBrand ornull brand = SurvivalLootBrands_GetBrandForLootData( data )
	if ( brand != null )
	{
		expect LootBrand( brand )
		RuiSetBoolIfExists( rui, "hasBrand", true )
		RuiSetImageIfExists( rui, "brandLogo", brand.brandLogoImage )
		RuiSetImageIfExists( rui, "brandTexture", brand.lootHintImage )
		RuiSetBoolIfExists( rui, "hasBrandTierColor", brand.applyColorFromItemQuality )
		RuiSetIntIfExists( rui, "brandTextureAnchoringBehavior", brand.lootHintAnchoring )
	}

	vector iconScale = data.lootType == eLootType.MAINWEAPON ? <2.0, 1.0, 0.0> : <1.0, 1.0, 0.0>
	RuiSetFloat2( rui, "iconScale", iconScale )

	RuiSetString( rui, "titleText", Localize( data.pickupString ).toupper() )
#if DEV
		if ( file.devShowLootRefs )
			RuiSetString( rui, "titleText", Localize( data.pickupString ).toupper() + " | " + data.ref )
#endif
	RuiSetString( rui, "subText", SURVIVAL_Loot_GetDesc( data, player ) )

	RuiSetBool( rui, "canPing", IsPingEnabledForPlayer( player ) && IsValid( lootRef.lootEnt ) )


		string passiveName = data.passive != ePassives.INVALID && !Augments_IsValidRef( data.ref ) ? PASSIVE_NAME_MAP[data.passive] : ""



	string passiveDesc = data.passive != ePassives.INVALID ? PASSIVE_DESCRIPTION_SHORT_MAP[data.passive] : ""
	RuiSetString( rui, "passiveText", passiveName )
	RuiSetString( rui, "passiveDesc", passiveDesc )

	LootActionStruct asMain
	LootActionStruct asAlt
	LootActionStruct asCharacterAction1
	LootActionStruct asCharacterAction2

	
	if ( hasFullPromptDetail )
	{
		asMain = SURVIVAL_BuildStringForAction( player, lootContext, lootRef, eLootActionType.PRIMARY_ACTION, isInMenu, "", isLootLocked )
		asAlt = SURVIVAL_BuildStringForAction( player, lootContext, lootRef, eLootActionType.ALT_ACTION, isInMenu, "", isLootLocked )
		asCharacterAction1 = SURVIVAL_BuildStringForAction( player, lootContext, lootRef, eLootActionType.CHARACTER_ACTION1, isInMenu, "", isLootLocked )
		asCharacterAction2 = SURVIVAL_BuildStringForAction( player, lootContext, lootRef, eLootActionType.CHARACTER_ACTION2, isInMenu, "", isLootLocked )
	}

	bool forceShowAltAction = false

		if ( Augments_Enabled() && data.lootType == eLootType.AUGMENT )
		{
			useAltSubTextColor = true
			RuiSetBool( rui, "useAltSubTextColor", true )
			RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 248, 231, 28 > / 255.0 ) )
		}


	RuiSetInt( rui, "lootTierReplace", 0 )
	RuiSetImage( rui, "replaceImage", $"" )
	RuiSetString( rui, "replacePassive", "" )
	RuiSetString( rui, "replaceName", "" )
	RuiSetBool( rui, "hasReplace", false )
	RuiSetInt( rui, "propertyValue", -1 )
	RuiSetInt( rui, "replacePropertyValue", -1 )
	RuiSetInt( rui, "extraPropertyValue", -1 )
	RuiSetInt( rui, "replaceExtraPropertyValue", -1 )
	RuiSetString( rui, "replaceSlot", Localize("#REPLACE" ) )
	RuiSetBool( rui, "useAltSubTextColor", useAltSubTextColor )
	RuiSetString( rui, "extraBottomText", "" )
	RuiSetBoolIfExists( rui, "replacePassiveTextIsUpper", true )

	RuiSetBoolIfExists( rui, "useCustomFrame", false )
	RuiSetImageIfExists( rui, "customFrameImage", $"" )
	RuiSetImageIfExists( rui, "customBackgroundImage", $"" )
	RuiSetImageIfExists( rui, "customGradientMask", $"" )
	RuiSetFloat2IfExists( rui, "customFrameScale", < 1, 1, 0 > )


	RuiSetStringIfExists( rui, "weaponStatName1", "" )
	RuiSetStringIfExists( rui, "weaponStatName2", "" )
	RuiSetStringIfExists( rui, "weaponStatName3", "" )
	RuiSetStringIfExists( rui, "weaponStatName4", "" )

	RuiSetFloatIfExists( rui, "weaponStatLinearPrevVal1", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearPrevVal2", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearPrevVal3", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearPrevVal4", 0.0 )

	RuiSetFloatIfExists( rui, "weaponStatLinearNewVal1", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearNewVal2", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearNewVal3", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatLinearNewVal4", 0.0 )

	RuiSetFloatIfExists( rui, "weaponStatNewVal1", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatNewVal2", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatNewVal3", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatNewVal4", 0.0 )

	RuiSetFloatIfExists( rui, "weaponStatOldVal1", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatOldVal2", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatOldVal3", 0.0 )
	RuiSetFloatIfExists( rui, "weaponStatOldVal4", 0.0 )

	RuiSetBoolIfExists( rui, "isStatImproved1", false )
	RuiSetBoolIfExists( rui, "isStatImproved2", false )
	RuiSetBoolIfExists( rui, "isStatImproved3", false )
	RuiSetBoolIfExists( rui, "isStatImproved4", false )

	RuiSetIntIfExists( rui, "numStatsToDisplay", 0 )

	RuiSetStringIfExists( rui, "extraStatName", "" )
	RuiSetBoolIfExists( rui, "isExtraStatPos", false )
	RuiSetBoolIfExists( rui, "useAltSubTextColor2", false )
	RuiSetFloat3IfExists( rui, "altSubTextColor2", SrgbToLinear( < 150, 150, 150 > / 255.0 ) )


	RuiSetBoolIfExists( rui, "displayStats", false )
	RuiSetBoolIfExists( rui, "displayStatBars", false )

	RuiSetStringIfExists( rui, "compatibilityText", "" )

	RuiSetStringIfExists( rui, "ammoText", "" )

	RuiSetBoolIfExists( rui, "isCorruptedAttachment", false )

	RuiSetImageIfExists( rui, "frame1", $"" )
	RuiSetImageIfExists( rui, "frame2", $"" )
	RuiSetImageIfExists( rui, "frame3", $"" )
	RuiSetImageIfExists( rui, "frame4", $"" )
	RuiSetImageIfExists( rui, "frame5", $"" )

	RuiSetFloat3IfExists( rui, "corruptedTextColor", <1.0,1.0,1.0> )
	RuiSetFloat3IfExists( rui, "corruptedTagColor", <1.0,1.0,1.0> )


	if ( lootRef.lootData.lootType == eLootType.ARMOR )
	{
		bool isEvo = EvolvingArmor_IsEquipmentEvolvingArmor( lootRef.lootData.ref )

		isEvo = isEvo || UpgradeCore_IsEquipmentArmorCore( lootRef.lootData.ref )

		RuiSetBool( rui, "isEvolvingArmor", isEvo )
	}

	if ( hasFullPromptDetail )
	{
		RuiSetString( rui, "usePromptText", asMain.displayString )
		if ( asMain.additionalData.ref != "" && !SURVIVAL_EquipmentPretendsToBeBlank( asMain.additionalData.ref ) && !forceShowAltAction )
		{
			RuiSetInt( rui, "lootTierReplace", asMain.additionalData.tier )
			RuiSetImage( rui, "replaceImage", asMain.additionalData.hudIcon )
			if ( asMain.additionalData.pickupString.len() <= 1 )
				RuiSetString( rui, "replaceName", "#EMPTY" )
			else
				RuiSetString( rui, "replaceName", asMain.additionalData.pickupString )

			RuiSetBool( rui, "hasReplace", true )

			if ( asMain.additionalData.passive != ePassives.INVALID )
			{
				RuiSetString( rui, "replacePassive", PASSIVE_NAME_MAP[asMain.additionalData.passive] )


					if ( Augments_Enabled() && data.lootType == eLootType.AUGMENT )
					{
						RuiSetString( rui, "replacePassive", asMain.additionalData.desc )
						RuiSetBoolIfExists( rui, "replacePassiveTextIsUpper", false )
					}

			}

			if ( asMain.additionalData.lootType == eLootType.ARMOR )
			{
				int replacePropertyValue = int( SURVIVAL_GetPlayerShieldHealthFromArmor( player ) / float(SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, asMain.additionalData )) * 100)

				if ( EvolvingArmor_IsEquipmentEvolvingArmor( asMain.additionalData.ref ) )
				{



						replacePropertyValue = int( SURVIVAL_GetPlayerShieldHealthFromArmor( player ) / float(SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, asMain.additionalData )) * 125)


					RuiSetBool( rui, "isReplaceEvolvingArmor", EvolvingArmor_IsEquipmentEvolvingArmor( asMain.additionalData.ref ) )

					RuiSetInt( rui, "replaceExtraPropertyValue", EvolvingArmor_GetEvolutionProgress( player ) )
				}
				else if( UpgradeCore_IsEquipmentArmorCore( asMain.additionalData.ref ) )
				{
					RuiSetBool( rui, "isReplaceEvolvingArmor", true )



						replacePropertyValue = int( SURVIVAL_GetPlayerShieldHealthFromArmor( player ) / float(SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, asMain.additionalData )) * 125)

				}
				else
				{
					RuiSetBool( rui, "isReplaceEvolvingArmor", false )
				}
				RuiSetInt( rui, "replacePropertyValue", replacePropertyValue )
			}
		}

		RuiSetString( rui, "altUsePromptText", "" )

		if ( ( asMain.action != asAlt.action || forceShowAltAction ) && !isLootLocked )
		{
			if ( ShouldShowButtonHints() || isInMenu )
				RuiSetString( rui, "altUsePromptText", asAlt.displayString )

			if ( asAlt.additionalData.ref != "" && !forceShowAltAction )
			{
				RuiSetInt( rui, "lootTierReplace", asAlt.additionalData.tier )
				RuiSetImage( rui, "replaceImage", asAlt.additionalData.hudIcon )
				RuiSetString( rui, "replaceName", asAlt.additionalData.pickupString )
				RuiSetBool( rui, "hasReplace", true )
			}
		}

		RuiSetString( rui, "characterAction1Text", asCharacterAction1.displayString )
		RuiSetString( rui, "characterAction2Text", asCharacterAction2.displayString )
	}
	else
	{
		RuiSetString( rui, "usePromptText", "" )
		RuiSetString( rui, "altUsePromptText", "" )
		RuiSetString( rui, "characterAction1Text", "" )
		RuiSetString( rui, "characterAction2Text", "" )
	}

	RuiSetBool( rui, "isSurvivalGadget", false )
	if ( data.lootType == eLootType.AMMO && isLootLocked )
	{
		RuiSetString( rui, "titleText", Localize( "#SURVIVAL_PICKUP_STACK_INFINITY", Localize( data.pickupString ).toupper() ) )
	}
	else if ( (data.lootType == eLootType.HEALTH || data.lootType == eLootType.AMMO || data.lootType == eLootType.ORDNANCE ) && lootRef.count > 1 )
	{
		RuiSetString( rui, "titleText", Localize( "#SURVIVAL_PICKUP_STACK_COUNT", Localize( data.pickupString ).toupper(), lootRef.count ) )
#if DEV
			if ( file.devShowLootRefs )
				RuiSetString( rui, "titleText", Localize( "#SURVIVAL_PICKUP_STACK_COUNT", Localize( data.pickupString ).toupper(), lootRef.count ) + " | " + data.ref )
#endif
	}
	else if ( data.lootType == eLootType.GADGET )
	{
		RuiSetBool( rui, "isSurvivalGadget", true )
		RuiSetInt( rui, "propertyValue", lootRef.count )
		RuiSetInt( rui, "extraPropertyValue", lootRef.lootData.inventorySlotCount )
	}
	else if ( data.lootType == eLootType.ARMOR )
	{
		if ( !isInMenu && GetLootPromptStyle() == eLootPromptStyle.COMPACT )
		{
			RuiSetString( rui, "titleText", Localize( "#SURVIVAL_PICKUP_ARMOR_STATUS", Localize( data.pickupString ).toupper(), GetPropSurvivalMainProperty( lootRef.lootProperty ), SURVIVAL_GetArmorShieldCapacity( data.tier ) ) )

			if ( EvolvingArmor_IsEquipmentEvolvingArmor( data.ref ) )
				RuiSetString( rui, "titleText", Localize( "#SURVIVAL_PICKUP_ARMOR_STATUS", Localize( data.pickupString ).toupper(), GetPropSurvivalMainProperty( lootRef.lootProperty ), EvolvingArmor_GetEvolvingArmorHealthForTier( data.tier ) ) )
		}

		int shieldPropertyValue = 0
		if ( EvolvingArmor_IsEquipmentEvolvingArmor( data.ref )
			|| ( UpgradeCore_IsEquipmentArmorCore( data.ref ) )
			)
		{
			int propertyValue = GetPropSurvivalMainProperty( lootRef.lootProperty )
			int armorHealthForTier = EvolvingArmor_GetEvolvingArmorHealthForTier( data.tier )

			if ( armorHealthForTier > 0.0 )
			{
				float armorPct = propertyValue / float(armorHealthForTier)



				shieldPropertyValue = int( armorPct * 125)

			}
		}
		else
		{
			int armorHealthForTier = SURVIVAL_GetArmorShieldCapacity( data.tier )
			if ( armorHealthForTier > 0.0 )
			{
				float armorPct = lootRef.lootProperty / float(armorHealthForTier)
				shieldPropertyValue = int( armorPct * 100 )
			}
		}
		RuiSetInt( rui, "propertyValue", shieldPropertyValue )
		RuiSetInt( rui, "extraPropertyValue", lootRef.lootExtraProperty )

		if( UpgradeCore_IsEquipmentArmorCore( data.ref ) )
		{
			int shieldVal = GetPropSurvivalMainProperty( lootRef.lootProperty )
			RuiSetString( rui, "subText", Localize( data.desc, shieldVal ) )
		}
	}

	else if ( data.lootType == eLootType.HELMET )
	{
		if( UpgradeCore_ArmorUpdates_MythicArmorUpgrade_Enabled() )
		{



			if ( data.ref == UPGRADE_CORE_GOLD_UPGRADE_REF || data.ref == UPGRADE_CORE_MYTHIC_UPGRADE_REF )

			{
				RuiSetString( rui, "passiveText", "" )
				RuiSetString( rui, "passiveDesc", "" )
			}
		}
	}


	

	if ( data.lootType == eLootType.MAINWEAPON && GetWeaponInfoFileKeyField_GlobalBool( data.baseWeapon, "uses_ammo_pool" ) && SURVIVAL_Loot_IsRefValid( data.ammoType ) || data.lootType == eLootType.MAINWEAPON && IsStockpileWeapon ( data.baseWeapon ) )



	{
		string ammoType   = data.ammoType
		LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( ammoType )
		RuiSetImage( rui, "ammoImage", ammoData.hudIcon )
	}
	else
	{
		asset icon = data.fakeAmmoIcon
		RuiSetImage( rui, "ammoImage", icon )
	}

	RuiSetImage( rui, "attachWeapon1Icon", $"" )
	RuiSetBool( rui, "hasAttach1", false )

	for( int weaponIndex = WEAPON_INVENTORY_SLOT_PRIMARY_0; weaponIndex <= WEAPON_INVENTORY_SLOT_PRIMARY_1; ++weaponIndex )
	{
		entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 + weaponIndex )
		if ( !IsValid( weapon ) )
			continue

		string weaponName = weapon.GetWeaponClassName()

		if ( GetWeaponInfoFileKeyField_GlobalInt_WithDefault ( weaponName, "has_energized", 0 ) == 1 && !weapon.HasMod( "start_energized" ) && GetWeaponInfoFileKeyField_GlobalString ( weaponName, "energized_consumable" ) != "" )
		{
			
			if ( !weapon.HasMod( "perma_energized" ) )
			{
				string energizedConsumableData = GetWeaponInfoFileKeyField_GlobalString ( weaponName, "energized_consumable" )
				string weaponNameString = GetWeaponInfoFileKeyField_WithMods_GlobalString ( weaponName, weapon.GetMods(), "printname" )
				string consumableHint = GetWeaponInfoFileKeyField_GlobalString ( weaponName, "energized_consumable_hint" )

				LootData weaponData = SURVIVAL_Loot_GetLootDataByRef ( weaponName )
				LootData ordanenceData = SURVIVAL_Loot_GetLootDataByRef ( energizedConsumableData )

				if ( lootRef.lootData.baseWeapon == energizedConsumableData )
				{
					asset weaponIcon = weaponData.hudIcon
					weaponIcon = GetWeaponLootIcon_ItemLootHint( player, weaponData, weapon )

					RuiSetString( rui, "replaceSlot", Localize( weaponNameString ) )
					RuiSetString( rui, "replaceName", Localize( consumableHint ) )
					RuiSetImage( rui, "attachWeapon1Icon", weaponIcon )
					RuiSetImage( rui, "replaceImage", ordanenceData.hudIcon )
					RuiSetBool( rui, "hasReplace", true )
					RuiSetBool( rui, "hasAttach1", true )
				}
			}
		}

	}

	const int MAX_ATTACHMENT_TAGS = 6
	const int NUM_OF_CATEGORIES_TO_BE_CONSIDERED_UNIVERSAL = 5 
	if ( hasFullPromptDetail )
	{
		for ( int index = 0; index < MAX_ATTACHMENT_TAGS; index++ )
		{
			RuiSetString( nestedCompatibleWeaponsRui, "tagText" + (index + 1), "" )
		}
		RuiSetInt( nestedCompatibleWeaponsRui, "numTags", 0 )
		RuiSetBool( nestedCompatibleWeaponsRui, "useAltColor", false )
		RuiSetFloat3( nestedCompatibleWeaponsRui, "altColor", <0,0,0> )
	}

	RuiSetString( rui, "typeText", "" )
	RuiSetString( rui, "typeTextTag", "" )

		RuiSetStringIfExists( rui, "typeTextTag2", "" )
		RuiSetStringIfExists( rui, "typeTextTag3", "" )
		RuiSetIntIfExists( rui, "weaponRange", 0 )

		RuiSetFloatIfExists( rui, "dmgStat", 0 )
		RuiSetFloatIfExists( rui, "rofStat", 0 )

		RuiSetBoolIfExists( rui, "showWeaponComparison", false )

		RuiSetIntIfExists( rui, "currRange", 0 )
		RuiSetFloatIfExists( rui, "currDmg", 0 )
		RuiSetFloatIfExists( rui, "currRof", 0 )

		RuiSetStringIfExists( rui, "fireMode1", "" )
		RuiSetStringIfExists( rui, "fireMode2", "" )

		RuiSetFloat3IfExists( rui, "tagColor", <0,0,0> )

		RuiSetIntIfExists( rui, "attachmentLockPips", 0 )


	string generalType = SURVIVAL_Loot_GetGeneralTypeString( data )
	string detailType  = SURVIVAL_Loot_GetDetailTypeString( data )


	if ( data.lootType == eLootType.MAINWEAPON )
	{
		RuiSetInt( rui, "extraPropertyValue", lootRef.lootExtraProperty )















			if ( EvoWeapons_IsEnabled() )
			{
				LootData lootData = lootRef.lootData
				int tier = data.tier
				int evoXp = lootRef.lootExtraProperty
				int expTierThreshold = EvoWeapons_GetRequirementForEvolution( tier, lootData )
				int currentTierExp = expTierThreshold - evoXp

				bool isMaxTier = (tier == 4)
				bool isPastMaxTier = (tier > 4)
				int expTotal = isMaxTier ? expTierThreshold : currentTierExp
				bool allMaxTier = EvoWeapon_DoesPlayerHaveAllMaxTierWeapons( player )

				RuiSetBool( rui, "isEvolvingWeapon", evoXp > 0 )
				RuiSetInt( rui, "extraPropertyValue", 0 )

				if ( lootData.tier == eLootTier.MYTHIC && !allMaxTier )
				{
					RuiSetInt( rui, "expTotal", -1 )
					RuiSetInt( rui, "expTierThreshold", -1 )
				}
				else
				{
					RuiSetInt( rui, "expTotal", expTotal )
					RuiSetInt( rui, "expTierThreshold", expTierThreshold )
				}

				RuiSetBool( rui, "isPastMaxTier", isPastMaxTier )
				RuiSetBool( rui, "allMaxTier", allMaxTier )
				RuiSetBool( rui, "isMaxTier", isMaxTier )
				RuiSetBool( rui, "shouldDisplayExpUI", true )
			}
			else
			{
				RuiSetBool( rui, "shouldDisplayExpUI", false )
			}


			bool weaponHasLockedHopup = DormantHopups_WeaponHasDormantHopupInBaseMods( data )
			RuiSetBoolIfExists( rui, "hasLockedHopup", weaponHasLockedHopup )
			if ( weaponHasLockedHopup )
			{
				string hopup = DormantHopups_GetDormantHopupFromBaseMods( data )
				LootData hopupData = SURVIVAL_Loot_GetLootDataByRef( hopup )
				int totalHopupValue = DormantHopups_GetThresholdOfActivation( lootRef.lootData )
				int numHopupPoints = totalHopupValue - lootRef.lootExtraProperty










				RuiSetStringIfExists( rui, "lockedHopupName", Localize( hopupData.pickupString ) )
				RuiSetIntIfExists( rui, "totalHopupValue", totalHopupValue )
				RuiSetIntIfExists( rui, "numHopupPoints", numHopupPoints )
			}
			else
			{
				RuiSetStringIfExists( rui, "lockedHopupName", "")
				RuiSetIntIfExists( rui, "totalHopupValue", -1)
				RuiSetIntIfExists( rui, "numHopupPoints", -1 )
			}


		RuiSetString( rui, "skinName", "" )
		RuiSetInt( rui, "skinTier", 0 )

		RuiSetBool( rui, "isFullyKitted", SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )

		int skinGUID = 0
		if ( IsValid( lootRef.lootEnt ) )
			skinGUID = lootRef.lootEnt.GetItemFlavorGUID()

		if ( IsValidItemFlavorGUID( skinGUID ) )
		{
			ItemFlavor weaponSkin = GetItemFlavorByGUID( skinGUID )
			if ( ItemFlavor_HasQuality( weaponSkin ) )
			{
				string weaponName = GetWeaponInfoFileKeyField_WithMods_GlobalString( data.baseWeapon, data.baseMods,"shortprintname" )
				RuiSetString( rui, "titleText", Localize( weaponName ).toupper() )
				RuiSetString( rui, "skinName", ItemFlavor_GetLongName( weaponSkin ) )
				RuiSetInt( rui, "skinTier", ItemFlavor_GetQuality( weaponSkin ) + 1 )
			}
		}

		for ( int index = 0; index < 5; index++ )
		{
			RuiSetImage( rui, "attachEmptyImage" + (index + 1), $"" )
			RuiSetImage( rui, "attachImage" + (index + 1), $"" )
			RuiSetInt( rui, "attachTier" + (index + 1), -1 )
			RuiSetBool( rui, "attachIsKitted" + (index + 1), false )
		}




			string baseClassName = data.baseWeapon
			if ( baseClassName != "" )
			{
				RuiSetString( rui, "typeText", Localize( detailType ) )
				if ( hasFullPromptDetail )
				{
					string weaponTag1 = IsWeaponKeyFieldDefined( baseClassName, "weapon_tag_1" ) ? GetWeaponInfoFileKeyField_GlobalString( baseClassName, "weapon_tag_1" ) : ""
					string weaponTag2 = IsWeaponKeyFieldDefined( baseClassName, "weapon_tag_2" ) ? GetWeaponInfoFileKeyField_GlobalString( baseClassName, "weapon_tag_2" ) : ""
					string weaponTag3 = IsWeaponKeyFieldDefined( baseClassName, "weapon_tag_3" ) ? GetWeaponInfoFileKeyField_GlobalString( baseClassName, "weapon_tag_3" ) : ""

					RuiSetString( rui, "typeTextTag", Localize( weaponTag1 ) )
					RuiSetStringIfExists( rui, "typeTextTag2", Localize( weaponTag2 ) )
					RuiSetStringIfExists( rui, "typeTextTag3", Localize( weaponTag3 ) )

					int rangeIndex = int( GetWeaponInfoFileKeyField_GlobalFloat( baseClassName, "stat_range" ) )
					if ( rangeIndex > 5 || rangeIndex < 1 )
					{
						rangeIndex = 1
					}

					RuiSetIntIfExists( rui, "weaponRange", rangeIndex )
					RuiSetFloatIfExists( rui, "dmgStat", WeaponStatData_GetWeaponDamage( baseClassName, [] ) )
					RuiSetFloatIfExists( rui, "rofStat", WeaponStatData_GetWeaponROF( baseClassName, [] ) )

					
					array<entity> weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )
					entity latestPrimary  = (weapons.len() > 0) ? weapons[0] : null
					if ( IsValid( latestPrimary ) && (asMain.action == eLootAction.SWAP) )
					{
						LootData weapData = SURVIVAL_GetLootDataFromWeapon( latestPrimary )
						if ( (weapData.lootType == eLootType.MAINWEAPON) && SURVIVAL_Loot_IsRefValid( weapData.baseWeapon ) )
						{
							RuiSetBoolIfExists( rui, "showWeaponComparison", true )
							RuiSetIntIfExists( rui, "currRange", int( GetWeaponInfoFileKeyField_GlobalFloat( weapData.baseWeapon, "stat_range" ) ) )
							RuiSetFloatIfExists( rui, "currDmg", WeaponStatData_GetWeaponDamage( weapData.baseWeapon, [] ) )
							RuiSetFloatIfExists( rui, "currRof", WeaponStatData_GetWeaponROF( weapData.baseWeapon, [] ) )
						}
					}

					string fireMode1 = IsWeaponKeyFieldDefined( baseClassName, "fire_mode_1" ) ? GetWeaponInfoFileKeyField_GlobalString( baseClassName, "fire_mode_1" ) : ""
					string fireMode2 = IsWeaponKeyFieldDefined( baseClassName, "fire_mode_2" ) ? GetWeaponInfoFileKeyField_GlobalString( baseClassName, "fire_mode_2" ) : ""

					RuiSetStringIfExists( rui, "fireMode1", Localize( fireMode1 ) )
					RuiSetStringIfExists( rui, "fireMode2", Localize( fireMode2 ) )
					RuiSetStringIfExists( rui, "ammoText", Localize( GetAmmoTypeStringForStatsDisplay( data ) ) )
					RuiSetFloat3IfExists( rui, "tagColor", SrgbToLinear( GetKeyColor( COLORID_TAG_LOOT_TIER0, data.tier ) / 255.0 ) )
					RuiSetIntIfExists( rui, "attachmentLockPips", SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) && !( data.tier == eLootTier.MYTHIC ) ? data.tier : 0 )
				}
			}







			RuiSetIntIfExists( rui, "hopupAttachmentCount", -1 )


		if ( hasFullPromptDetail )
		{
			int attachmentCount                 = 0
			int numSwaps                        = 0
			table<string, string> attachmentMap = BuildAttachmentMapForPickupPrompt( player, data, lootRef, asMain )
			table<string, string> lockedAttachMap = AddLockedAttachPointsToAttachmentMapForPickupPrompt( data, lootRef )
			foreach ( string attachmentPoint in data.supportedAttachments )
			{
				attachmentCount++

				string attachmentStyle = GetAttachmentPointStyle( attachmentPoint, data.ref )
				if ( attachmentPoint in attachmentMap && attachmentMap[attachmentPoint] != "" )
				{
					LootData attachmentData = SURVIVAL_Loot_GetLootDataByRef( attachmentMap[attachmentPoint] )
					RuiSetImage( rui, "attachImage" + attachmentCount, attachmentData.hudIcon )
					HopupGoldenHorse_SwapLootTier( rui, attachmentData.ref, attachmentData.tier, "attachTier" + attachmentCount )

					if ( SURVIVAL_IsAttachmentPointLocked( data.ref, attachmentPoint, IsValid( lootRef.lootEnt ) ? lootRef.lootEnt.GetWeaponMods() : [""] ) )
					{
						if ( SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )
							RuiSetInt( rui, "attachTier" + attachmentCount, data.tier )
						else
							RuiSetInt( rui, "attachTier" + attachmentCount, attachmentData.tier )
						RuiSetBool( rui, "attachIsKitted" + attachmentCount, true )
					}
					else if ( !SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )
					{
						numSwaps++
					}
				}
				else if ( attachmentPoint in lockedAttachMap && lockedAttachMap[attachmentPoint] != "" )
				{
					LootData attachmentData = SURVIVAL_Loot_GetLootDataByRef( lockedAttachMap[attachmentPoint] )
					RuiSetImage( rui, "attachImage" + attachmentCount, attachmentData.hudIcon )

						DormantHopups_SetAttachmentCount( rui, attachmentData, attachmentCount )

					HopupGoldenHorse_SwapLootTier( rui, attachmentData.ref, attachmentData.tier, "attachTier" + attachmentCount )

					if ( SURVIVAL_IsAttachmentPointLocked( data.ref, attachmentPoint, IsValid( lootRef.lootEnt ) ? lootRef.lootEnt.GetWeaponMods() : [""] ) )
					{
						RuiSetInt( rui, "attachTier" + attachmentCount, attachmentData.tier )
						RuiSetBool( rui, "attachIsKitted" + attachmentCount, true )
					}
					else if ( !SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )
					{
						numSwaps++
					}
				}
				else
				{
					RuiSetImage( rui, "attachImage" + attachmentCount, $"" )
					RuiSetInt( rui, "attachTier" + attachmentCount, 0 )
					RuiSetBool( rui, "attachIsKitted" + attachmentCount, false )

						RuiSetIntIfExists( rui, "hopupAttachmentCount", -1 )

				}

				RuiSetImage( rui, "attachEmptyImage" + attachmentCount, emptyAttachmentSlotImages[attachmentStyle] )
			}

			if ( numSwaps > 1 )
				RuiSetString( rui, "attachSwapText", Localize( "#LOOT_SWAP_COUNT_N", numSwaps ) )
			else if ( numSwaps == 1 )
				RuiSetString( rui, "attachSwapText", Localize( "#LOOT_SWAP_COUNT_1", numSwaps ) )
			else
				RuiSetString( rui, "attachSwapText", "" )
		}
	}
	else if ( detailType != "" && hasFullPromptDetail )
	{
		RuiSetString( rui, "typeText", Localize( "#LOOT_TYPE_GENERAL", Localize( generalType ), Localize( detailType ) ) )
	}
	else if ( hasFullPromptDetail )
	{
		RuiSetString( rui, "typeText", Localize( generalType ) )
	}


	if ( data.lootType == eLootType.ATTACHMENT )
	{
		if ( hasFullPromptDetail )
		{
			array<entity> weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )


			RuiSetBoolIfExists( rui, "displayStats", true )
			RuiSetBool( nestedCompatibleWeaponsRui, "useAltColor", true )
			RuiSetFloat3( nestedCompatibleWeaponsRui, "altColor",  SrgbToLinear( GetKeyColor( COLORID_TAG_LOOT_TIER0, data.tier ) / 255.0 ) )

			string levelString = Localize( "#INVENTORY_ATTACHMENT_LEVEL_TEXT", string( data.tier ) )
			if ( data.lootTags.contains( "corrupted_attachment" ) )
			{
				levelString = Localize( "#CORRUPTED_LABEL" )
			}
			RuiSetString( rui, "typeText", Localize( "#ATTACHMENT_LOOT_TYPE_GENERAL", Localize( generalType ), Localize( detailType ), levelString ) )


			int action = asAlt.action

			if ( action != eLootAction.ATTACH_TO_ACTIVE && action != eLootAction.ATTACH_TO_STOWED )
				action = asMain.action

			int slot = -1
			if ( action == eLootAction.ATTACH_TO_ACTIVE )
			{
				slot = 0
			}

			if ( action == eLootAction.ATTACH_TO_STOWED )
			{
				slot = 1
			}

			if ( slot != -1 && slot < weapons.len() )
			{
				entity weapon = weapons[slot]
				if ( SURVIVAL_Loot_IsRefValid( weapon.GetWeaponClassName() ) )
				{
					LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weapon.GetWeaponClassName() )
					asset weaponIcon = weaponData.hudIcon
					weaponIcon = GetWeaponLootIcon_ItemLootHint( player, weaponData, weapon )
					if ( detailType == GetAttachmentPointName( "sight" ) && CanWeaponAkimbo( weaponData.baseWeapon ) )
						RuiSetString( rui, "extraBottomText", "#AKIMBO_NO_OPTIC" )
					RuiSetImage( rui, "attachWeapon1Icon", weaponIcon )
					RuiSetBool( rui, "hasAttach1", true )
					RuiSetBool( rui, "hasReplace", true )


					array<WeaponStatData> weaponStats = WeaponStatData_GetStatsDataForAttachment( weapon, data )
					if ( WeaponStatData_ShouldDisplayStats( data ) && WeaponStatData_ShouldDisplayStatBars() )
					{
						RuiSetBoolIfExists( rui, "displayStatBars", true )
						var nestedAttachmentStatRui = RuiCreateNested( rui, "attachmentStatDisplayHandle", $"ui/attachment_stats_display_loot.rpak" )

						int index = 1
						foreach ( stat in weaponStats )
						{
							RuiSetStringIfExists( nestedAttachmentStatRui, "weaponStatName" + string( index ), stat.statName )
							RuiSetFloatIfExists( nestedAttachmentStatRui, "statValAdded" + string( index ), stat.statValAdded )
							RuiSetFloatIfExists( nestedAttachmentStatRui, "oldVal" + string( index ), stat.previousStatValue )
							RuiSetFloatIfExists( nestedAttachmentStatRui, "linearStatValAdded" + string( index ), stat.linearStatValAdded )

							index++
						}

						RuiSetBoolIfExists( nestedAttachmentStatRui, "isCorrupted",  data.lootTags.contains( "corrupted_attachment" ) )

						RuiSetIntIfExists( rui, "numStatsToDisplay", weaponStats.len() )
					}

					RuiSetStringIfExists( rui, "compatibilityText", "" )

				}
			}

			else if ( WeaponStatData_ShouldDisplayStats( data ) )
			{
				array<AttachmentStatData> statNamesAffected = AttachmentStatData_GetAttachmentStatDataForAttachment_NoWeapon( data )

				int index = 1
				foreach ( stat in statNamesAffected )
				{
					RuiSetStringIfExists( rui, "weaponStatName" + string( index ), stat.statName )
					RuiSetBoolIfExists( rui, "isStatImproved" + string( index ), stat.isStatImproved )
					RuiSetBool( rui, "useAltSubTextColor", true )
					RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 255, 127, 127 > / 255.0 ) )
					RuiSetBoolIfExists( rui, "displayStatBars", false )

					index++
				}

				if ( !CanAttachToWeaponPlayerHas( player, data.ref ) )
				{
					RuiSetStringIfExists( rui, "compatibilityText", Localize("#ATTACHMENT_NOT_COMPATIBLE_HINT") )
				}
			}

			AttachmentStatData extraStat = AttachmentStatData_GetExtraStatForAttachment( data )
			if ( extraStat.statName != "" )
			{
				RuiSetStringIfExists( rui, "extraStatName", extraStat.statName )
				RuiSetBoolIfExists( rui, "isExtraStatPos", extraStat.isStatImproved )
				RuiSetBoolIfExists( rui, "useAltSubTextColor2", true )
				RuiSetFloat3IfExists( rui, "altSubTextColor2", SrgbToLinear( GetKeyColor( COLORID_LOOT_TIER4 ) / 255.0 ) )
			}

		}

		if ( data.lootTags.contains( "corrupted_attachment" ) )
		{
			RuiSetBoolIfExists( rui, "isCorruptedAttachment", true )

			RuiSetImageIfExists( rui, "frame1", $"rui/loot_brands/corrupted_attachment/tag_glitch_corrupted_00" )
			RuiSetImageIfExists( rui, "frame2", $"rui/loot_brands/corrupted_attachment/tag_glitch_corrupted_01" )
			RuiSetImageIfExists( rui, "frame3", $"rui/loot_brands/corrupted_attachment/tag_glitch_corrupted_02" )
			RuiSetImageIfExists( rui, "frame4", $"rui/loot_brands/corrupted_attachment/tag_glitch_corrupted_03" )
			RuiSetImageIfExists( rui, "frame5", $"rui/loot_brands/corrupted_attachment/tag_glitch_corrupted_04" )

			RuiSetFloat3IfExists( rui, "corruptedTextColor", SrgbToLinear( GetKeyColor( COLORID_LOOT_TIER4 ) / 255.0 ) )
			RuiSetFloat3IfExists( rui, "corruptedTagColor", SrgbToLinear( GetKeyColor( COLORID_TAG_LOOT_TIER0, data.tier ) / 255.0 ) )

			RuiSetBoolIfExists( rui, "useCustomFrame", true )
			RuiSetImageIfExists( rui, "customFrameImage", $"rui/hud/ping/icon_ping_loot_inner_corrupted" )
			RuiSetImageIfExists( rui, "customBackgroundImage", $"rui/hud/ping/icon_ping_loot_inner_fill_corrupted" )
			RuiSetImageIfExists( rui, "customGradientMask", $"rui/hud/ping/icon_ping_loot_inner_fill_corrupted" )
			RuiSetFloat2IfExists( rui, "customFrameScale", < 1.3, 1.3, 0 > )
		}
		if ( hasFullPromptDetail )
		{
			AttachmentTagData attachmentTagData = AttachmentTags( data.ref )
			RuiSetInt( nestedCompatibleWeaponsRui, "numTags", attachmentTagData.attachmentTags.len() )

			if ( attachmentTagData.multiAmmoRefs.len() > 0 )
			{
				array<asset> ammoIconAssetArgs = []
				for( int i = 0; i < attachmentTagData.multiAmmoRefs.len(); i++ )
				{
					LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( attachmentTagData.multiAmmoRefs[i] )
					ammoIconAssetArgs.append( ammoData.hudIcon )
				}

				asset ammoIcon1 = ammoIconAssetArgs.len() > 0 ? ammoIconAssetArgs[0] : $""
				asset ammoIcon2 = ammoIconAssetArgs.len() > 1 ? ammoIconAssetArgs[1] : $""
				asset ammoIcon3 = ammoIconAssetArgs.len() > 2 ? ammoIconAssetArgs[2] : $""
				asset ammoIcon4 = ammoIconAssetArgs.len() > 3 ? ammoIconAssetArgs[3] : $""
				asset ammoIcon5 = ammoIconAssetArgs.len() > 4 ? ammoIconAssetArgs[4] : $""

				RuiSetString( nestedCompatibleWeaponsRui, "tagText1", Localize( "#LOOT_FIT_AMMO", ammoIcon1, ammoIcon2, ammoIcon3, ammoIcon4, ammoIcon5 ) )
			}
			else if ( attachmentTagData.ammoRef != "" )
			{
				LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( attachmentTagData.ammoRef )

				string lootFitTip
				if ( !AttachesToAllWeaponsOfAmmoType( data.ref ) )
					lootFitTip = "#LOOT_FIT_MOST_AMMO"
				else
					lootFitTip = "#LOOT_FIT_AMMO"

				RuiSetString( nestedCompatibleWeaponsRui, "tagText1", Localize( lootFitTip, ammoData.hudIcon ) )
			}
			else
			{
				if ( attachmentTagData.attachmentTags.len() >= NUM_OF_CATEGORIES_TO_BE_CONSIDERED_UNIVERSAL && passiveDesc == "" )
				{
					RuiSetString( nestedCompatibleWeaponsRui, "tagText1", "#TAG_ALL_WEAPONS" )
				}
				else
				{
					int tagIndex = 0
					foreach ( int tagId in attachmentTagData.attachmentTags )
					{
						if ( tagIndex < MAX_ATTACHMENT_TAGS && passiveDesc == "" )
						{
							if ( tagId in attachmentTagData.exceptionToTheRuleForThisWeaponClass )
								RuiSetString( nestedCompatibleWeaponsRui, "tagText" + (tagIndex + 1), Localize( "#WEAPON_CLASS_HAS_EXCEPTION", Localize( GetStringForTagId( tagId ) ) ) ) 
							else
								RuiSetString( nestedCompatibleWeaponsRui, "tagText" + (tagIndex + 1), GetStringForTagId( tagId ) )

							tagIndex++
						}
					}

					array<string> uniqueNames = SURVIVAL_Loot_GetUniqueWeaponNames( attachmentTagData.weaponRefs )

					for ( int i = 0; i < uniqueNames.len(); ++i )
					{
						if ( tagIndex < MAX_ATTACHMENT_TAGS && passiveDesc == "" )
						{
							string weaponName = uniqueNames[i]
							if ( i < uniqueNames.len() - 1 && tagIndex < MAX_ATTACHMENT_TAGS - 1 )
								weaponName += ","

							RuiSetString( nestedCompatibleWeaponsRui, "tagText" + (tagIndex + 1), weaponName )

							tagIndex++
						}
					}

					int exceptionIndex = 0
					foreach ( int tagId in attachmentTagData.attachmentTags )
					{
						if ( tagIndex < MAX_ATTACHMENT_TAGS && passiveDesc == "" )
						{
							if ( tagId in attachmentTagData.exceptionToTheRuleForThisWeaponClass )
							{
								string exceptionName = GetWeaponInfoFileKeyField_GlobalString( attachmentTagData.exceptionToTheRuleForThisWeaponClass[tagId], "shortprintname" )
								if ( exceptionIndex < attachmentTagData.exceptionToTheRuleForThisWeaponClass.len() - 1 && tagIndex < MAX_ATTACHMENT_TAGS - 1 )
									exceptionName += ","

								
								
								if ( tagIndex == 2 )
									tagIndex = 3

								RuiSetString( nestedCompatibleWeaponsRui, "tagText" + ( tagIndex + 1 ), Localize( "#EXCEPT_WEAPON", exceptionName ) )

								tagIndex++
								exceptionIndex++
							}
						}
					}
				}
			}
		}
	}
	else if ( data.lootType == eLootType.AMMO )
	{
		array<entity> weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )

		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) && GetCurrentPlaylistVarBool( "has_infinite_clips", false ) )
			RuiSetString( rui, "subText", "#INFINITE_CLIPS_IN_SETTINGS" )

		array<string> weaponNames
		foreach ( weapon in weapons )
		{
			weaponNames.append( weapon.GetWeaponClassName() )
		}


		string slingRef = EquipmentSlot_GetLootRefForSlot( player, SLING_EQUIPMENT_SLOT_NAME )
		if ( SURVIVAL_Loot_IsRefValid( slingRef ) )
		{
			LootData slingData = SURVIVAL_Loot_GetLootDataByRef( slingRef )
			weaponNames.append( slingData.baseWeapon )
			weapons.append( GetPlayerSlingWeapon( player ) )
		}

		bool ammoCompatibilityFound = false
		foreach ( int i, weaponRef in weaponNames )
		{
			if ( !IsValid( weapons[i] ) )
				continue

			if ( SURVIVAL_Loot_IsRefValid( weaponRef ) && IsWeaponKeyFieldDefined( weaponRef, "ammo_pool_type" ) )
			{
				string ammoType = GetWeaponAmmoType( weaponRef )
				string secondaryAmmoType
				if ( IsWeaponKeyFieldDefined( weaponRef, "secondary_ammo_pool_type" ) )
				{
					secondaryAmmoType = GetWeaponInfoFileKeyField_GlobalString( weaponRef, "secondary_ammo_pool_type" )
				}
				if ( ammoType == data.ref || secondaryAmmoType == data.ref )
				{
					LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
					asset weaponIcon = weaponData.hudIcon
					weaponIcon = GetWeaponLootIcon_ItemLootHint( player, weaponData, weapons[i] )

					if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) && GetCurrentPlaylistVarBool( "has_infinite_clips", false ) )
						RuiSetImage( rui, "attachWeapon1Icon",  $"" )
					else
						RuiSetImage( rui, "attachWeapon1Icon", weaponIcon )

					RuiSetBool( rui, "hasAttach1", true )

					LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( data.ref )
					string weaponNameString = GetWeaponInfoFileKeyField_GlobalString( weaponRef, "printname" )

					RuiSetString( rui, "replaceSlot", Localize( weaponNameString ) )
					RuiSetString( rui, "replaceName", Localize( "#COMPATIBLE_AMMO_TYPE" ) )
					RuiSetImage( rui, "attachWeapon1Icon", weaponIcon )
					RuiSetImage( rui, "replaceImage", ammoData.hudIcon )
					RuiSetBool( rui, "hasReplace", true )
					ammoCompatibilityFound = true

					break
				}
			}
		}

		if ( !ammoCompatibilityFound )
		{
			RuiSetString( rui, "subText", Localize( "#NON_COMPATIBLE_AMMO_TYPE" ) )
			RuiSetBool( rui, "useAltSubTextColor", true )
			RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 255, 127, 127 > / 255.0 ) )
		}


		if ( isLootLocked )
		{
			
			
			
			string lockedMessage = lockedReason == eLockedInventoryReason.DEFAULT ?
					Localize( "#LOOT_LOCKED_WITHOUT_REASON_DESC" ) :
					Localize( "#LOOT_LOCKED_WITH_REASON_DESC", Localize( LOCKED_INVENTORY_UNLOCK_MESSAGES[lockedReason] ).toupper() )

			RuiSetString( rui, "subText", lockedMessage )
			RuiSetBool( rui, "useAltSubTextColor", false )
		}

		bool isInfAmmoSlot = lockedReason == eLockedInventoryReason.AUGMENT_INFINITE_AMMO
		if ( Augments_Enabled() && !Augments_InfiniteAmmo_RequireAltUseForUnneededAmmo() &&
				( !isInMenu || !isInfAmmoSlot ) && Augment_InfiniteAmmo_ShouldBlockDefaultPickup( player, data ) )
		{
			RuiSetString( rui, "subText", Localize( "#PICKUP_WARNING_INFINITE_AMMO" ) )
			RuiSetBool( rui, "useAltSubTextColor", true )
			RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 255, 127, 127 > / 255.0 ) )
		}

	}
	else if ( data.lootType == eLootType.HEALTH )
	{

		if ( Augments_Enabled() && !Augments_BatteryPrinter_RequireAltUseForUnneededAmmo() && !isInMenu && Augments_BatteryPrinter_PlayerHasInfiniteConsumableUses( player, data.ref ) )
		{
			RuiSetString( rui, "subText", Localize( "#PICKUP_WARNING_BATTERY_PRINTER" ) )
			RuiSetBool( rui, "useAltSubTextColor", true )
			RuiSetFloat3( rui, "altSubTextColor", SrgbToLinear( < 255, 127, 127 > / 255.0 ) )
		}

	}





















	if ( data.lootType == eLootType.CUSTOMPICKUP )
	{

		if ( data.ref.find( HOPUP_POINTS_PICKUP ) == 0 )
		{
			array< entity > weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )

			int slot = -1
			foreach ( int index, entity weapon in weapons )
			{
				if ( DormantHopups_WeaponHasDormantHopupOnWeapon( weapon ) && DormantHopups_CanGainPoints( weapon ) )
				{
					slot = index
					break
				}
			}

			if ( slot != -1 && slot < weapons.len() )
			{
				entity weapon = weapons[ slot ]
				string weaponClassName = weapon.GetWeaponClassName()

				if ( SURVIVAL_Loot_IsRefValid( weaponClassName ) )
				{
					LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponClassName )

					if ( DormantHopups_WeaponHasDormantHopupInBaseMods( weaponData ) )
					{
						LootData hopUpData = SURVIVAL_Loot_GetLootDataByRef( data.ref )
						string weaponNameString = GetWeaponInfoFileKeyField_WithMods_GlobalString ( weaponClassName, weapon.GetMods(), "printname" )

						RuiSetBool( rui, "hasReplace", true )
						RuiSetBool( rui, "hasAttach1", true )
						RuiSetImage( rui, "attachWeapon1Icon", weaponData.hudIcon )
						RuiSetString( rui, "replaceSlot", Localize( weaponNameString ) )
						RuiSetString( rui, "replaceName", Localize( "#COMPATIBLE_AMMO_TYPE" ) )
						RuiSetImage( rui, "replaceImage", hopUpData.hudIcon )
					}
				}
			}
		}


		if ( data.ref.find( ARROW_BUNDLE_NAME ) == 0 )
		{
			entity bowWeapon = WeaponBow_spicey_GetPlayerBowWeaponWithLowestArrowCount( player )
			if ( bowWeapon != null && bowWeapon.GetWeaponPrimaryAmmoCount( bowWeapon.GetActiveAmmoSource() ) < bowWeapon.GetWeaponSettingInt( eWeaponVar.ammo_stockpile_max ) )
			{
				string weaponClassName = bowWeapon.GetWeaponClassName()
				LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponClassName )
				string weaponNameString = GetWeaponInfoFileKeyField_WithMods_GlobalString ( weaponClassName, bowWeapon.GetMods(), "printname" )

				RuiSetBool( rui, "hasReplace", true )
				RuiSetBool( rui, "hasAttach1", true )
				RuiSetImage( rui, "attachWeapon1Icon", weaponData.hudIcon )
				RuiSetString( rui, "replaceSlot", Localize( weaponNameString ) )
				RuiSetString( rui, "replaceName", Localize( "#COMPATIBLE_AMMO_TYPE" ) )
				RuiSetImage( rui, "replaceImage", data.hudIcon )
			}
		}

	}





































	RuiSetBool( rui, "isAutoLootItem", false )
	if ( AutoLootHelper_IsEnabled() )
	{
		if ( AutoLootHelper_IsAutoLootEnabledForItem( data ) )
		{
			RuiSetBool( rui, "isAutoLootItem", AutoLootHelper_CanPlayerAutoLootItem( player, data ) )
			RuiSetBool( rui, "canAutoLoot", LootGoesInPack( player, lootRef ) ? SURVIVAL_CanPickupItem( data ) : true )
		}
		else
		{
			RuiSetBool( rui, "isAutoLootItem", false )
			RuiSetBool( rui, "canAutoLoot", LootGoesInPack( player, lootRef ) ? SURVIVAL_CanPickupItem( data ) : true )
		}
	}


	
	SURVIVAL_Loot_DetailType2String ( rui, data )

	if ( data.ref in s_customItemPromptUpdateCallbacks )
		(s_customItemPromptUpdateCallbacks[data.ref])( player, rui, data, lootContext, lootRef, isInMenu )
}

void function SURVIVAL_Loot_DetailType2String ( var rui, LootData data )
{
	string detailType2
	vector color = <255,255,255>

	if  ( data.lootType == eLootType.MAINWEAPON )
	{
			















			if ( data.baseMods.contains( BRAND_MOD_WEAPON_TAKEOVER ) )
			{
				detailType2 = "#WPN_ELITE_TAG"
				color = WEAPON_TAKEOVER_COLOR
			}

	}

	if ( detailType2 != "" )
	{
		RuiSetString( rui, "typeTextTag2", detailType2 )
		RuiSetBool( rui, "useAltTextColor", true )
		RuiSetFloat3( rui, "altTextColor", SrgbToLinear( color / 255.0 ) )
	}
}


array<string> function SURVIVAL_Loot_GetUniqueWeaponNames( array<string> weaponRefs )
{
	array<string> uniqueNames
	foreach ( index, weaponRef in weaponRefs )
	{
		string baseWeapon = Weapon_GetBaseClassNameOrEmpty( weaponRef )
		if ( baseWeapon != "" )
			continue

		string weaponName = GetWeaponInfoFileKeyField_GlobalString( weaponRef, "shortprintname" )
		if ( uniqueNames.contains( weaponName ) )
			continue
		uniqueNames.append( weaponName )
	}
	return uniqueNames
}

bool function AttachesToAllWeaponsOfAmmoType( string attachmentRef )
{
	Assert( IsValidAttachment( attachmentRef ), "must be valid attachment" )

	if ( attachmentRef in file.attachRefAttachesToAllWeaponsOfAmmoTypeCache )
		return file.attachRefAttachesToAllWeaponsOfAmmoTypeCache[ attachmentRef ]

	AttachmentData aData = GetAttachmentData( attachmentRef )
	Assert( aData.tagData.ammoRef != "", "attachment tag data must have ammo ref" )

	if ( file.allWeaponsCache.len() == 0 )
		file.allWeaponsCache = SURVIVAL_Loot_GetByType( eLootType.MAINWEAPON )

	array<LootData> allWeapons = file.allWeaponsCache
	bool retVal = true
	foreach ( LootData wData in allWeapons )
	{
		if ( wData.ammoType != aData.tagData.ammoRef )
			continue

		if ( WeaponLootRefIsLockedSet( wData.ref ) )
			continue

		if ( SURVIVAL_Loot_IsRefDisabled( wData.ref ) )
			continue

		if ( wData.floorSpawnCategory != eFloorSpawnCategory.CORE )
			continue

		if ( !aData.compatibleWeapons.contains( wData.ref ) )
		{
			retVal = false
			break
		}
	}

	file.attachRefAttachesToAllWeaponsOfAmmoTypeCache[ attachmentRef ] <- retVal
	return retVal
}


bool function HasWeaponForTag( entity player, int tagId )
{
	array<entity> weapons = player.GetMainWeapons()
	foreach ( weapon in weapons )
	{
		string weaponRef = weapon.GetWeaponClassName()
		if ( !SURVIVAL_Loot_IsRefValid( weaponRef ) )
			continue

		LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
		if ( weaponData.lootType != eLootType.MAINWEAPON )
			continue

		switch ( tagId )
		{
			case eAttachmentTag.ALL:
				return true;

			case eAttachmentTag.PISTOL:
			case eAttachmentTag.ASSAULT:
			case eAttachmentTag.SHOTGUN:
			case eAttachmentTag.LMG:
			case eAttachmentTag.SNIPER:
			case eAttachmentTag.SMG:
			case eAttachmentTag.LAUNCHER:
			case eAttachmentTag.MELEE:
			case eAttachmentTag.PISTOL_MOST:
			case eAttachmentTag.ASSAULT_MOST:
			case eAttachmentTag.SHOTGUN_MOST:
			case eAttachmentTag.LMG_MOST:
			case eAttachmentTag.SNIPER_MOST:
			case eAttachmentTag.SMG_MOST:
				if ( weaponClassToTag[weaponData.lootTags[0]] == tagId )
					return true
				break

			case eAttachmentTag.BARREL:
				if ( AttachmentPointSupported( "barrel", weaponRef ) )
					return true
				break

			default:
				Assert( false, "Unhandled tag " + tagId )
		}
	}

	return false
}


bool function ShouldLootHintBeVisible( entity prop )
{
	if ( !IsValid( prop ) )
		return false

	if ( prop.GetNetworkedClassName() != "prop_survival" )
		return false

	int index = prop.GetSurvivalInt()
	if ( index < 0 )
		return false

	if ( prop.e.isBusy )
		return false












		if ( index >= 0 )
		{
			LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )
			if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
				return false
		}



		if ( GameMode_IsActive( eGameModes.CONTROL ) && IsScoreboardShown() )
			return false


	entity player = GetLocalViewPlayer()

	if ( file.checkWeaponDisableForLootPingPrompt && player.GetWeaponDisableFlags() == WEAPON_DISABLE_FLAGS_ALL )
	{
		return false
	}

	if ( GetAimAssistCurrentTarget() )
		return false

	return true
}

void function ManageVerticalLines()
{
	while ( true )
	{
		WaitFrame()

		entity player = GetLocalViewPlayer()

		if ( !IsValid( player ) )
			continue

		if ( player != GetLocalClientPlayer() )
			continue

		if ( !IsPingEnabledForPlayer( player ) )
			continue

		if( IsSpectating() )
			continue

		array<entity> loot





		int l
		int v

		entity useEntity = GetPropSurvivalUseEntity( player )
		float scalar     = GraphCapped( GetFovScalar( player ), 1.0, 2.0, 1.0, 3.0 )

		if ( !player.IsPhaseShifted() )
		{
			vector org
			if ( PlayerDrone_IsPlayerInDroneView( player ) )
				org = player.EyePosition()
			else
				org = player.GetOrigin()

			if ( !Survival_IsGroundlistOpen() )
			{
				loot = GetSurvivalLootNearbyPos( org, VERTICAL_LINE_DIST_MAX, false, true, false, player )






















				if ( useEntity != null )
				{
					bool showVerticalLineForUseEnt = true



					int index                      = useEntity.GetSurvivalInt()
					if ( index >= 0 )
					{
						LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

							if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
							{
								showVerticalLineForUseEnt = false
							}















					}

					if ( showVerticalLineForUseEnt )
					{
						vector forward = AnglesToForward( player.CameraAngles() )
						forward = Normalize( < forward.x, forward.y, 0.0 > )
						vector right  = CrossProduct( forward, <0, 0, 1> )

						VerticalLineStruct line = file.verticalLines[v]

						line.width = VERTICAL_LINE_WIDTH
						line.height = VERTICAL_LINE_HEIGHT

						if ( useEntity == player.GetUsePromptEntity() )
						{
							line.width *= VERTICAL_LINE_HIGHLIGHT_SCALAR_X
						}








						float dist = Distance( useEntity.GetOrigin(), player.CameraPosition() ) / scalar
						if ( LOOT_PING_DISTANCE > VERTICAL_LINE_DIST_MAX )
						{
							line.width *= GraphCapped( dist, VERTICAL_LINE_DIST_MAX, LOOT_PING_DISTANCE, 1.0, 2.0 )
						}

						
						vector topoWidth = right * VERTICAL_LINE_TOPO_WIDTH / scalar
						vector topoOrg = useEntity.GetRenderOrigin() + <0, 0, VERTICAL_LINE_TOPO_HEIGHT> + (0.5 * topoWidth)

						
						RuiTopology_UpdatePos( file.verticalLines[v].topo, topoOrg, -topoWidth, <0, 0, -VERTICAL_LINE_TOPO_HEIGHT> )

						
						ShowVerticalLineStruct( file.verticalLines[v], useEntity )
						RuiSetBool( file.verticalLines[v].rui, "isSelected", true )

						file.verticalLines[v].ent = useEntity

						v++
					}
				}
			}
		}

		while ( v < VERTICAL_LINE_COUNT )
		{
























































































			{
				if ( loot.len() > l )
				{
					entity item = loot[ l++ ]

					if ( IsValid( item.GetParent() ) )
					{
						entity p = item.GetParent()
						if ( p.IsPlayer() )
							continue

						if ( p.GetScriptName() == DEATH_BOX_SCRIPTNAME )
							continue
					}

					if ( IsValid( item ) && !item.DoesShareRealms( player ) )
						continue

					if ( !PlayerCanSeePos( player, item.GetOrigin(), false, 65 ) )
						continue

					if ( PropSurvivalFlagsHas( item, ePropSurvivalFlag.HIDE_LOOT_LINE ) )
						continue

					vector forward = AnglesToForward( player.CameraAngles() )
					forward = Normalize( < forward.x, forward.y, 0.0 > )
					vector right = CrossProduct( forward, <0, 0, 1> )

					VerticalLineStruct line = file.verticalLines[v]

					line.width = VERTICAL_LINE_WIDTH
					line.height = VERTICAL_LINE_HEIGHT

					int index = item.GetSurvivalInt()
					LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

					bool canAutoLoot = false

					if ( AutoLootHelper_IsEnabled() && GetCurrentPlaylistVarBool( "autolootbeams_enabled", false ) )
					{
						if ( AutoLootHelper_IsAutoLootEnabledForItem( data ) )
						{
							canAutoLoot = AutoLootHelper_CanPlayerAutoLootItem( player, data ) && SURVIVAL_CanPickupItem( data )
						}
					}


					if ( canAutoLoot )
					{
						line.width *= VERTICAL_LINE_HIGHLIGHT_SCALAR_X
						line.height *= VERTICAL_LINE_HIGHLIGHT_SCALAR_Y
					}

					
					vector topoWidth = right * VERTICAL_LINE_TOPO_WIDTH / scalar
					vector topoOrg = item.GetRenderOrigin() + <0, 0, VERTICAL_LINE_TOPO_HEIGHT> + (0.5 * topoWidth)

					
					RuiTopology_UpdatePos( file.verticalLines[v].topo, topoOrg, -topoWidth, <0, 0, -VERTICAL_LINE_TOPO_HEIGHT> )

					
					ShowVerticalLineStruct( file.verticalLines[v], item )

					file.verticalLines[v].ent = item

					v++
				}
				else
				{
					file.verticalLines[v].ent = null
					HideVerticalLineStruct( file.verticalLines[v] )
					v++
				}
			}
		}
	}
}

void function ShowVerticalLineStruct( VerticalLineStruct lineStruct, entity ent )
{
	if ( !IsValid( ent ) || (ent.GetNetworkedClassName() != "prop_survival") || (ent.GetSurvivalInt() < 0) || ent.HasPredictiveHideForPickup() )
	{
		HideVerticalLineStruct( lineStruct )
		return
	}

	entity player = GetLocalViewPlayer()

	
	RuiSetFloat( lineStruct.rui, "beamWidth", lineStruct.width / VERTICAL_LINE_TOPO_WIDTH )
	RuiSetFloat( lineStruct.rui, "beamHeight", lineStruct.height / VERTICAL_LINE_TOPO_HEIGHT )
	RuiSetImage( lineStruct.rui, "beamImage", lineStruct.beamImage )

	RuiSetBool( lineStruct.rui, "isSelected", false )
	RuiSetVisible( lineStruct.rui, true )
	RuiSetFloat3( lineStruct.rui, "worldPos", ent.GetRenderOrigin() )
	RuiSetBool( lineStruct.rui, "isVisible", true )

#if LINE_COLORS
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )

		HopupGoldenHorse_SwapLootTier( lineStruct.rui, data.ref, data.tier, "tier" )

		
		if ( file.greyTierEnabled && ( data.lootType == eLootType.MAINWEAPON ) && !SURVIVAL_Weapon_IsAttachmentLocked( data.ref ) )
			RuiSetBool( lineStruct.rui, "isGreyTier", true )
		else
			RuiSetBool( lineStruct.rui, "isGreyTier", false )
#else
		RuiSetInt( lineStruct.rui, "tier", 1 )
#endif

	bool isPinged = Waypoint_LootItemIsBeingPingedByAnyone( ent )
	RuiSetBool( lineStruct.rui, "isPinged", isPinged )
}

void function HideVerticalLineStruct( VerticalLineStruct lineStruct )
{
	RuiSetBool( lineStruct.rui, "isVisible", false )
	RuiSetVisible( lineStruct.rui, false )
}

bool function TryOpenQuickSwap( entity overrideItem = null )
{
	entity itemToUse = overrideItem
	if ( !IsValid( itemToUse ) )
	{
		itemToUse = file.swapOnUseItem
	}

	if ( IsValid( itemToUse ) && GetLocalViewPlayer() == GetLocalClientPlayer() && !IsWatchingReplay() )
	{
		entity player = GetLocalClientPlayer()

		entity deathBox = player.GetUsePromptEntity()
		if ( IsValid( deathBox ) && deathBox.GetScriptName() != DEATH_BOX_SCRIPTNAME )
			deathBox = null

		if ( itemToUse.GetScriptName() != DEATH_BOX_SCRIPTNAME )
		{
			LootData data = SURVIVAL_Loot_GetLootDataByIndex( itemToUse.GetSurvivalInt() )
			thread OpenSwapForItem( data.ref, string( itemToUse.GetEncodedEHandle() ) )
		}
		else
		{
			OpenSurvivalGroundList( player, deathBox )
		}

		return true
	}

	return false
}

const int PF_IS_WEAPON = 1 << 0
const int PF_IS_AMMO = 1 << 1
const int PF_IS_KITTED = 1 << 2

void function TrackLootToPing( entity player )
{
	if ( player != GetLocalClientPlayer() )
		return

	player.Signal( "TrackLootToPing" )
	player.EndSignal( "TrackLootToPing" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	EndSignal( clGlobal.signalDummy, "SurvivalLoot_MoveToPodium" )

	if ( !IsPingEnabledForPlayer( player ) )
		return

	table e
	e.farRui <- null

	OnThreadEnd(
		function() : ( e, player )
		{
			if ( e.farRui != null )
				RuiDestroy( e.farRui )
			file.crosshairEntity = null
		}
	)

	entity lastEnt

	while ( IsValid( player ) )
	{
		if ( GetGameState() >= eGameState.Resolution )
			return

		bool shouldLookForLoot = ( GetAimAssistCurrentTarget() == null &&
									player.GetTargetInCrosshairRange() == null &&
									!player.IsPhaseShifted() )

		bool isLobaUnarmedADS = false
		array<entity> loot
		if ( shouldLookForLoot )
		{
			if ( EyeForQualityAllowLongRangeItems( player ) )
			{
				isLobaUnarmedADS = true
			}


			if( !isLobaUnarmedADS && Perks_UpdateHighlightedPerkIcon() )
			{
				WaitFrame()
				continue
			}


			if( !isLobaUnarmedADS && UpdateHighlightedWorldspaceIcons() )
			{
				WaitFrame()
				continue
			}

			if( !isLobaUnarmedADS && UpgradeCore_UpdateHighlightedHarvesterIcon() )
			{
				WaitFrame()
				continue
			}

			if( !isLobaUnarmedADS && DeathBoxInsight_UpdateLookatPing() )
			{
				WaitFrame()
				continue
			}


			if( !isLobaUnarmedADS && Arsenals_Enabled() && Arsenals_ShowHudDisplay() && Arsenals_UpdateHighlightedArsenalIcon() )
			{
				WaitFrame()
				continue
			}



			if( !isLobaUnarmedADS && LootBinReset_Enabled() && LootBinReset_MythicBins_Enabled() && LootBinReset_MythicBins_UpdateHighlightedBinIcon() )
			{
				WaitFrame()
				continue
			}


			if( !isLobaUnarmedADS && WPObjective_UpdateHighlightedIcon() )
			{
				WaitFrame()
				continue
			}

			if ( isLobaUnarmedADS )
			{
				loot.extend( GetEyeForQualityLoot() )
			}
			else
			{
				if ( PlayerDrone_IsPlayerInDroneView( player ) )
					loot.extend( GetSurvivalLootNearbyPos( player.EyePosition(), LOOT_PING_DISTANCE * GetFovScalar( player ), false, false, false, player ) )
				else
					loot.extend( GetSurvivalLootNearbyPlayer( player, LOOT_PING_DISTANCE * GetFovScalar( player ), false, false, false ) )
			}

			file.crosshairEntity = GetEntityPlayerIsLookingAt( player, loot )
		}
		else
		{
			file.crosshairEntity = null
		}

		if ( IsValid( file.crosshairEntity ) )
		{
			LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( file.crosshairEntity.GetSurvivalInt() )

			if ( e.farRui == null )
			{
				switch ( lootData.lootType )
				{
					case eLootType.MAINWEAPON:
						e.farRui = CreateFullscreenRui( $"ui/loot_pickup_hint_weapon_far.rpak", -1 )
						break

					case eLootType.AMMO:
						e.farRui = CreateFullscreenRui( $"ui/loot_pickup_hint_far.rpak", -1 )
						
						break

					default:
						e.farRui = CreateFullscreenRui( $"ui/loot_pickup_hint_far.rpak", -1 )
				}
			}

			UpdateUseHintForEntity( file.crosshairEntity, e.farRui, LOOT_PROMPT_DETAIL_FAR )

			bool lootIsUpgrade = false
			foreach ( teammate in GetPlayerArrayOfTeam_Alive( player.GetTeam() ) )
			{
				if ( teammate == player )
					continue

				if ( SURVIVAL_IsLootAnUpgrade( teammate, file.crosshairEntity, lootData, eLootContext.GROUND ) )
				{
					lootIsUpgrade = true
					RuiSetBool( e.farRui, "teammateNeedsThis", true )
					break
				}
			}

			if ( !lootIsUpgrade )
			{
				RuiSetBool( e.farRui, "teammateNeedsThis", false )
			}
		}
		else
		{
			if ( e.farRui != null )
				RuiSetBool( e.farRui, "isVisible", false )
		}

		if ( lastEnt != file.crosshairEntity )
		{
			if ( e.farRui != null )
			{
				RuiDestroy( e.farRui )
				e.farRui = null
			}

			lastEnt = file.crosshairEntity
		}

		WaitFrame()
	}
}

entity function GetEntityPlayerIsLookingAt( entity player, array<entity> ents, float degrees = 8 )
{
	entity theEnt

	float playerFOVScalar = GetFovScalar( player )

	Assert( playerFOVScalar > 0.001, "Player FOV Scalar close to 0? This could cause division by 0 (or near) issues" )

	float minDot = deg_cos( degrees / playerFOVScalar )
	float dot

	array<PlayerLookAtItem> finalLootEnts

	vector playerEyePos = player.EyePosition()
	vector playerViewVector = player.GetViewVector()

	foreach ( ent in ents )
	{
		dot = DotProduct( Normalize( ent.GetWorldSpaceCenter() - playerEyePos ), playerViewVector )
		if ( dot < minDot )
			continue

		PlayerLookAtItem lootItem
		lootItem.ent = ent
		lootItem.playerViewDot = dot
		finalLootEnts.append( lootItem )

#if DEV
			
			
#endif
	}

	finalLootEnts.sort( PlayerLookSort )
	foreach ( item in finalLootEnts )
	{
		int index     = item.ent.GetSurvivalInt()
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

		if ( PlayerHasPassive( GetLocalViewPlayer(), ePassives.PAS_LOBA_EYE_FOR_QUALITY ) && GetEyeForQualityCanSee( data ) )
		{
			theEnt = item.ent
			break
		}
		else
		{
			TraceResults result = TraceLineHighDetail( playerEyePos, item.ent.GetWorldSpaceCenter(), player, TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_PLAYER )
			if ( IsEqualFloat( result.fraction, 1.0 ) )
			{
				entity parentEnt = item.ent.GetParent()
				if ( IsValid( parentEnt ) )
				{
					string scriptName = parentEnt.GetScriptName()
					if ( scriptName == DEATH_BOX_SCRIPTNAME )
						continue

					else if ( Arsenals_Enabled() && Arsenals_PingArsenalNotWeaponAtDistance() && scriptName == ARSENAL_SCRIPTNAME )
						continue

				}

				theEnt = item.ent
				break
			}
		}
	}

	return theEnt
}

entity function GetPropSurvivalUseEntity( entity player )
{
	entity useEnt = player.GetUsePromptEntity() != null ? player.GetUsePromptEntity() : file.crosshairEntity
	if ( !IsValid( useEnt ) )
		return null

	if ( Bleedout_IsBleedingOut( player ) )
		return null

	if ( useEnt.GetNetworkedClassName() != "prop_survival" )
		return null

	if ( useEnt.GetSurvivalInt() < 0 )
		return null

	return useEnt
}

entity function GetCrosshairEntity( entity player )
{
	return file.crosshairEntity
}

AttachmentTagData function AttachmentTags( string attachment )
{
	AttachmentData aData = GetAttachmentData( attachment )
	return aData.tagData
}


void function SetupSurvivalLoot( var categories, bool functionref( LootData ) filterFunc = null )
{
	string cats              = expect string( categories )
	array<string> stringCats = split( cats, WHITESPACE_CHARACTERS )

	Assert( !( stringCats.contains( "main_weapon" ) && stringCats.contains( "main_weapon_event" ) ) )
	bool wantEventWeapons = false

	
	array<int> catTypes
	foreach ( string cat in stringCats )
	{
		if ( cat == "main_weapon_event" )
		{
			wantEventWeapons = true
			cat = "main_weapon"
		}

		catTypes.append( SURVIVAL_Loot_GetLootTypeFromString( cat ) )
	}

	
	if ( catTypes.contains( eLootType.ATTACHMENT ) )
		RunUIScript( "SetupDevCommand", "Spawn All Optics", "script SpawnAllOptics()" )

	array<string> refs
	table< string, LootData > lootTable = SURVIVAL_Loot_GetLootDataTable()
	table< string, string > refToDisplayString
	foreach( ref, data in lootTable )
	{
		if ( !IsLootTypeValid( data.lootType ) )
			continue
		if ( SURVIVAL_Loot_IsRefDisabled( data.ref ) )
			continue
		if ( !catTypes.contains( data.lootType ) )
			continue

		if ( data.lootType == eLootType.MAINWEAPON && data.lootTags.contains( "event_weapon" ) != wantEventWeapons )
		{
			continue
		}

		if ( filterFunc != null && !filterFunc( data ) )
			continue

		refToDisplayString[ref] <- CreateLootDevDisplayString( data )
		refs.append( ref )
	}
	refs.sort( int function( string aa, string bb ) : (refToDisplayString)
	{
		
		
		string aaS = refToDisplayString[aa]
		string bbS = refToDisplayString[bb]
		int aaLen = aaS.len()
		int bbLen = bbS.len()
		int maxLen = minint( aaLen, bbLen )
		for( int idx = 0; idx < maxLen; ++idx )
		{
			int aaC = expect int( aaS[idx] )
			int bbC = expect int( bbS[idx] )
			if ( aaC < bbC )
				return -1
			if ( aaC > bbC )
				return 1
		}

		if ( aaLen < bbLen )
			return -1
		if ( aaLen > bbLen )
			return 1

		return 0
	} )

	foreach ( ref in refs )
	{
		LootData data = lootTable[ref]
		RunUIScript( "SetupDevCommand", refToDisplayString[ref], "script SpawnGenericLoot( \"" + ref + "\", gp()[0].GetOrigin(), <-1,-1,-1>, " + data.countPerDrop + " )" )
	}
}


string function CreateLootDevDisplayString( LootData data )
{
	string displayString = Localize( data.pickupString )

	if ( data.passive != ePassives.INVALID )
		displayString += " - " + Localize( PASSIVE_NAME_MAP[data.passive] )

	if ( ShouldAppendLootLevel( data ) )
		displayString += " [Lv" + data.tier + "]"

	if ( data.lootTags.contains( WEAPON_LOCKEDSET_MOD_GOLD ) )
		displayString = "[GOLD]/ GOLD " + displayString
	if ( data.lootTags.contains( WEAPON_LOCKEDSET_MOD_WHITESET ) )
		displayString = "[WHITE]/ WHITE " + displayString
	if ( data.lootTags.contains( WEAPON_LOCKEDSET_MOD_BLUESET ) )
		displayString = "[BLUE]/ BLUE " + displayString
	if ( data.lootTags.contains( WEAPON_LOCKEDSET_MOD_PURPLESET ) )
		displayString = "[PURPLE]/ PURPLE " + displayString
	if ( data.baseMods.contains( WEAPON_LOCKEDSET_MOD_PAINTBALL ) )
		displayString = "[GOLD PAINTBALL]/ GOLD " + displayString
	if ( data.baseMods.contains( WEAPON_LOCKEDSET_MOD_AKIMBO ) )
		displayString = "[AKIMBO]/ AKIMBO " + displayString








	if ( data.lootTags.contains( WEAPON_LOCKEDSET_TAG_MYTHIC ) )
		displayString = "[MYTHIC]/ " + displayString
	return displayString
}


bool function ShouldAppendLootLevel( LootData data )
{
	switch ( data.lootType )
	{
		case eLootType.MAINWEAPON:
			return false

		case eLootType.AMMO:
			return false

		case eLootType.ORDNANCE:
			return false
	}

	return true
}




bool function SURVIVAL_Loot_QuickSwap( entity pickup, entity player, int pickupFlags, entity deathBox, int ornull desiredCount )
{
	if ( pickup.GetSurvivalInt() == -1 )
		return false

	LootData data   = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )


		if ( ReservedInventory_IsEnabled() && !ReservedInventory_IsItemSwappable( data ) )
			return false


	int numPickedUp = SURVIVAL_AddToPlayerInventory( player, data.ref, pickup.GetClipCount() )
	if ( numPickedUp > 0 )
		return false

	ExtendedUseSettings settings
	settings.loopSound = "UI_Survival_PickupTicker"
	settings.successSound = "UI_Survival_DeathBoxOpen"
	settings.hint = "#PROMPT_SWAP"
	settings.duration = 0.3
	settings.startFunc = ExtendedQuickSwap_Start
	settings.successFunc = ExtendedTryOpenQuickSwap
	settings.useInputFlag = IN_USE_LONG
	settings.requireMatchingUseEnt = true

	LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )
	LootRef lootRef   = SURVIVAL_CreateLootRef( lootData, pickup )

	LootActionStruct asMain = SURVIVAL_BuildStringForAction( GetLocalViewPlayer(), eLootContext.GROUND, lootRef, eLootActionType.PRIMARY_ACTION, false )
	LootActionStruct asAlt  = SURVIVAL_BuildStringForAction( GetLocalViewPlayer(), eLootContext.GROUND, lootRef, eLootActionType.ALT_ACTION, false )

	if ( asMain.action != eLootAction.PICKUP && asAlt.action == eLootAction.PICKUP )
	{
		settings.holdHint = "%use_alt%"
		settings.useInputFlag = IN_USE_ALT
	}

	thread ExtendedUse( pickup, player, settings )

	return false
}

void function ExtendedQuickSwap_Start( entity item, entity player, ExtendedUseSettings settings )
{
	file.swapOnUseItem = item
}


void function ExtendedTryOpenQuickSwap( entity ent, entity player, ExtendedUseSettings settings )
{
	TryOpenQuickSwap()
}

void function TryHolsterWeapon( entity player )
{
	if ( !IsGamepadEnabled() )
		return

	if ( file.useAltBind == -1 )
		return

	
	if ( !InputIsButtonDown( file.useAltBind ) )
		return

	entity useEnt = player.GetUsePromptEntity()

	if ( IsValid( useEnt ) )
	{
		if ( useEnt.GetNetworkedClassName() == "prop_survival" )
		{
			LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( useEnt.GetSurvivalInt() )
			LootRef lootRef   = SURVIVAL_CreateLootRef( lootData, useEnt )
			if ( SURVIVAL_GetActionForItem( player, eLootContext.GROUND, lootRef, eLootActionType.ALT_ACTION ).action != eLootAction.NONE )
			{
				return
			}
		}

		if( PassiveReinforce_BlockControllerHolster( player, useEnt ) )
			return
	}

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( activeWeapon == player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 ) )
	{
		player.ClientCommand( "invnext" )
		return
	}

	player.ClientCommand( "weaponSelectPrimary2" )
}


void function ExtendedTryHolster( entity ent, entity player, ExtendedUseSettings settings )
{
	player.ClientCommand( "weaponSelectPrimary2" )
}


