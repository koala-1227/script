#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________2_WorldIcon___________________________(){}
#endif


WorldspaceIconData function WPObjective_WorldIcon_Register( WPObjective_Settings settings )
{
	WorldspaceIconData iconSettings

	iconSettings.imageAsset = settings.iconMap
	iconSettings.pingType = settings.enumPingType
	iconSettings.pingDistance = settings.worldIconPingDistance
	iconSettings.minAlphaDistance = settings.worldIconMinAlphaDistance
	iconSettings.maxAlphaDistance = settings.worldIconMaxAlphaDistance
	iconSettings.closeUpFadeMinAlphaDistance = settings.worldIconCloseUpFadeMinAlphaDistance
	iconSettings.closeUpFadeMaxAlphaDistance = settings.worldIconCloseUpFadeMaxAlphaDistance
	iconSettings.mapPingFilterFunction = WPObjective_IsPingableOnMap

	return iconSettings
}



WorldspaceIconData function WPObjective_WorldIcon_Create( string scriptName, entity wp )
{
	WorldspaceIconData instanceSettings

	if ( !( scriptName in file.handleScriptNameToConfig ) )
		return instanceSettings

	WorldspaceIconData settings = file.handleScriptNameToConfig[scriptName].iconInWorld
	instanceSettings.imageAsset = settings.imageAsset
	instanceSettings.pingType = settings.pingType
	instanceSettings.pingDistance = settings.pingDistance
	instanceSettings.minAlphaDistance = settings.minAlphaDistance
	instanceSettings.maxAlphaDistance = settings.maxAlphaDistance
	instanceSettings.closeUpFadeMinAlphaDistance = settings.closeUpFadeMinAlphaDistance
	instanceSettings.closeUpFadeMaxAlphaDistance = settings.closeUpFadeMaxAlphaDistance
	instanceSettings.descriptiveText = settings.descriptiveText

	instanceSettings.ent = wp
	instanceSettings.upOffset = 0.0

	SetupWorldspaceIcon( instanceSettings )
	thread WPObjective_ListenForPing( instanceSettings )

	return instanceSettings
}



void function WPObjective_WorldIcon_Destroy( entity handle )
{
	if ( IsValid( handle ) )
	{
		handle.Signal( "HideWorldSpaceIconMinimapVisibility" )
	}
}



bool function WPObjective_IsPingableOnMap( WorldspaceIconData data, vector worldPos, float worldRange )
{
	array< WPObjective_Instance > worldspaceInstances = file.handleToWorldspaceInstance.clonevalues()
	bool found = false
	foreach ( instance in worldspaceInstances )
	{
		if ( instance.iconInWorld == data )
		{
			found = true
			break
		}
	}
	if ( !found )
		return false

	if ( data.hidden || !data.isInteractable )
		return false

	return true
}



bool function WPObjective_UpdateHighlightedIcon()
{
	if( Perks_GetPerkPingInfo().ent != null || DeathBoxInsight_GetCurrentPingInfo().loot != null )
		return false

	entity player = GetLocalClientPlayer()
	vector playerEyePos = player.EyePosition()
	vector viewVector = player.GetViewVector()
	array< entity > WPObjectives = WPObjective_GetObjectiveWaypointsInPingRange()
	float minDot = deg_cos( PERK_HIGHLIGHT_DEGREES )
	float bestDot = 0

	entity bestEnt = null
	foreach( entity objectiveEnt in WPObjectives )
	{
		if( !( file.handleToWorldspaceInstance[objectiveEnt].isWorldspaceVisible ) )
			continue

		vector iconPos
		iconPos = objectiveEnt.GetOrigin()
		vector eyeToIcon = iconPos - playerEyePos
		vector eyeToIconNormalized = Normalize( eyeToIcon )
		float dot = DotProduct( eyeToIconNormalized, viewVector )
		if( dot < minDot || dot < bestDot )
			continue

		bestDot = dot
		bestEnt = objectiveEnt
	}

	WPObjective_SetHighlightedIcon( bestEnt )
	return bestEnt != null
}



void function WPObjective_SetHighlightedIcon( entity handle )
{
	if( file.highlightedPingEntEHI == ToEHI( handle ) )
		return

	entity oldHandle = FromEHI( file.highlightedPingEntEHI )
	if( IsValid( oldHandle ) && IsValid( file.handleToWorldspaceInstance[oldHandle] ) )
	{
		RuiSetBoolIfExists( file.handleToWorldspaceInstance[oldHandle].iconInWorld.rui, "isHighlighted", false )
	}

	file.highlightedPingEntEHI = ToEHI( handle )

	if( IsValid( handle ) && IsValid( file.handleToWorldspaceInstance[handle] ) )
	{
		RuiSetBoolIfExists( file.handleToWorldspaceInstance[handle].iconInWorld.rui, "isHighlighted", true )
	}
}



void function WPObjective_ListenForPing( WorldspaceIconData instanceSettings )
{
	entity handle = instanceSettings.ent
	var rui = instanceSettings.rui

	handle.EndSignal( "OnDestroy", "OnDeath" )

	OnThreadEnd( function() : ( instanceSettings ) {
		var rui = instanceSettings.rui
		RuiDestroyIfAlive( rui )

		entity handle = instanceSettings.ent
		if ( IsValid( handle ) && IsValid( file.handleToWorldspaceInstance[handle] ) )
		{
			file.handleToWorldspaceInstance[handle].isPinged = false
			file.handleToWorldspaceInstance[handle].isWorldspaceVisible = false
		}
	} )

	
	WaitFrame()

	while( true )
	{
		if( !file.handleToWorldspaceInstance[handle].isPinged )
		{
			handle.WaitSignal( SIG_WPOBJECTIVE_PING )
		}

		file.handleToWorldspaceInstance[handle].isPinged = true
		file.handleToWorldspaceInstance[handle].isWorldspaceVisible = false
		if ( IsValid( rui ) )
		{
			RuiSetBoolIfExists( rui, "isVisible", false )
		}

		handle.WaitSignal( SIG_WPOBJECTIVE_PING_DESTROYED )

		file.handleToWorldspaceInstance[handle].isPinged = false
		if ( IsValid( rui ) )
		{
			file.handleToWorldspaceInstance[handle].isWorldspaceVisible = true
			RuiSetBoolIfExists( rui, "isVisible", true )
		}
	}
}



void function WPObjective_Pinged( entity handle, entity wp )
{
	handle.Signal( SIG_WPOBJECTIVE_PING )

	wp.WaitSignal( "OnDestroy" )

	if ( IsValid( handle ) )
	{
		handle.Signal( SIG_WPOBJECTIVE_PING_DESTROYED )
	}
}


