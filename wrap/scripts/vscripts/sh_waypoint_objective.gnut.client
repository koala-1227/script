void function WPObjective_Minimap_Register( WPObjective_Settings settings )
{
	RegisterMinimapPackage( "prop_script", settings.enumMinimapObject_prop_script,
		MINIMAP_OBJECT_PROXIMITY_RUI, WPObjective_MinimapPackage,
		FULLMAP_OBJECT_PROXIMITY_RUI, WPObjective_FullmapPackage )
}



































void function WPObjective_MinimapPackage( entity ent, var rui )
{
	thread WPObjective_WaitAndSetMapData_Thread( rui, ent, true )
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________4_FullmapIcon___________________________(){}
#endif


void function WPObjective_FullmapPackage( entity ent, var rui )
{
	thread WPObjective_WaitAndSetMapData_Thread( rui, ent, false )
}



void function WPObjective_WaitAndSetMapData_Thread( var rui, entity minimapEnt, bool isMinimap )
{
	entity handle

	while( true )
	{
		WaitFrame()

		if ( !RuiIsAlive( rui ) )
			return

		handle = minimapEnt.GetOwner()
		string scriptName = handle.GetScriptName()
		if ( !file.handleScriptNames.contains( scriptName ) )
			continue

		break
	}

	if ( !RuiIsAlive( rui ) )
		return

	if ( !IsValid( handle ) )
		return

	string scriptName = handle.GetScriptName()
	if ( !file.handleScriptNames.contains( scriptName ) )
		return

	WPObjective_Config config = file.handleScriptNameToConfig[scriptName]

	RuiSetImage( rui, "defaultIcon", config.iconInWorld.imageAsset )
	RuiSetImage( rui, "clampedDefaultIcon", config.iconInWorld.imageAsset )
	RuiSetBool( rui, "useTeamColor", false )

	if ( IsValid( config.iconMapSmall ) )
	{
		RuiSetImage( rui, "smallIcon", config.iconMapSmall )
		RuiSetBool( rui, "hasSmallIcon", config.iconMapSmall != $"" )
	}
	else
	{
		RuiSetBool( rui, "hasSmallIcon", false )
	}
}



