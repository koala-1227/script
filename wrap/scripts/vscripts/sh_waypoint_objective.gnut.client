
global function WPObjective_Init
global function WPObjective_Register

global function WPObjective_IsEntityMarked
global function WPObjective_IsPingTypeRegistered
global function WPObjective_IsWaypointRegistered

global function WPObjective_GetCommsAction
global function WPObjective_GetHandleEnt
global function WPObjective_GetPingType










global function WPObjective_UpdateHighlightedIcon
global function WPObjective_Pinged


const string CLASS_HANDLE_TYPE = "prop_script"


const string SIG_WPOBJECTIVE_PING = "WPObjectivePing"
const string SIG_WPOBJECTIVE_PING_DESTROYED = "WPObjectivePingDestroyed"



global struct WPObjective_Settings
{
	string scriptName = ""

	int enumWaypoint
	int enumPingType
	int enumCommsAction
	int enumMinimapObject_prop_script

	asset iconInWorld
	asset iconMap
	asset iconMapSmall = $""
	float iconScale = 1.0

	string pingText = ""

	float worldIconPingDistance = 1500.0
	float worldIconMinAlphaDistance = 1500.0
	float worldIconMaxAlphaDistance = 2000.0
	float worldIconCloseUpFadeMinAlphaDistance = 200.0
	float worldIconCloseUpFadeMaxAlphaDistance = 300.0
}



global struct WPObjective_SpawnSettings
{
	string scriptName
	vector origin

	entity parentEnt = null
	bool trackParentPos = false
	string extraText = ""
}




struct WPObjective_Config
{
	string scriptName

	int enumWaypoint
	int enumPingType
	int enumCommsAction
	int enumMinimapObject_prop_script

	asset iconMapSmall = $""

	WorldspaceIconData& iconInWorld
}



struct WPObjective_Instance
{
	WorldspaceIconData& iconInWorld

	bool isPinged
	bool isWorldspaceVisible
}


struct
{

		table< string, WPObjective_Config > handleScriptNameToConfig
		array< string > handleScriptNames
		table< entity, EHI > handleToParentEntEHI



		table< entity, WPObjective_Instance > handleToWorldspaceInstance
		EHI highlightedPingEntEHI








} file



void function WPObjective_Init()
{
	if ( !WPObjective_IsEnabled() )
		return


	AddCreateCallback( CLASS_HANDLE_TYPE, WPObjective_OnPropSpawn )
	AddDestroyCallback( CLASS_HANDLE_TYPE, WPObjective_OnPropDestroy )

	RegisterSignal( SIG_WPOBJECTIVE_PING )
	RegisterSignal( SIG_WPOBJECTIVE_PING_DESTROYED )

}



#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________Interface___________________________(){}
#endif


void function WPObjective_Register( WPObjective_Settings settings )
{
	Assert( settings.scriptName != "", "You must set a unique script name when registering a WPObjective!" )
	Assert( !file.handleScriptNames.contains( settings.scriptName ), "Tried to register WPObjective of type " + settings.scriptName + " but this type was already registered!" )

	WPObjective_Register_Internal( settings )
}





















#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________Utilities___________________________(){}
#endif


bool function WPObjective_IsHandleEnt( entity ent )
{
	if ( !IsValid( ent ) )
		return false

	string scriptName = ent.GetScriptName()
	if ( !file.handleScriptNames.contains( scriptName ) )
		return false

	return true
}



bool function WPObjective_IsEntityMarked( entity ent )
{
	if ( !IsValid( ent ) )
		return false

	foreach ( parentEntEHI in file.handleToParentEntEHI )
	{
		if ( ToEHI( ent ) == parentEntEHI )
			return true
	}

	return false
}



bool function WPObjective_IsPingTypeRegistered( int enumPingType )
{
	foreach ( config in file.handleScriptNameToConfig )
	{
		if ( enumPingType == config.enumPingType )
			return true
	}

	return false
}



bool function WPObjective_IsWaypointRegistered( int enumWaypoint )
{
	foreach ( config in file.handleScriptNameToConfig )
	{
		if ( enumWaypoint == config.enumWaypoint )
			return true
	}

	return false
}



int function WPObjective_GetCommsAction( int enumPingType )
{
	if ( !WPObjective_IsPingTypeRegistered( enumPingType ) )
		return eCommsAction._count

	foreach ( config in file.handleScriptNameToConfig )
	{
		if ( enumPingType == config.enumPingType )
			return config.enumCommsAction
	}

	return eCommsAction._count
}



entity function WPObjective_GetHandleEnt( entity ent )
{
	if ( !WPObjective_IsEntityMarked( ent ) )
		return null

	foreach ( entity currentHandle, EHI parentEntEHI in file.handleToParentEntEHI )
	{
		if ( ToEHI( ent ) == parentEntEHI )
		{
			return currentHandle
		}
	}

	return null
}



int function WPObjective_GetPingType( entity ent )
{
	entity handle = WPObjective_GetHandleEnt( ent )
	if ( !IsValid( handle ) )
		return ePingType._count

	string scriptName = handle.GetScriptName()
	if ( !file.handleScriptNames.contains( scriptName ) )
		return ePingType._count

	if( !( scriptName in file.handleScriptNameToConfig ) )
		return ePingType._count

	return file.handleScriptNameToConfig[scriptName].enumPingType
}



array < entity > function WPObjective_GetObjectiveWaypointsInPingRange()
{
	entity player = GetLocalClientPlayer()
	vector playerEyePos = player.EyePosition()

	array < entity > waypoints
	foreach ( entity currentHandle, EHI parentEntEHI in file.handleToParentEntEHI )
	{
		if ( !IsValid( currentHandle ) )
			continue

		string scriptName = currentHandle.GetScriptName()
		if ( !file.handleScriptNames.contains( scriptName ) )
			continue

		if( !( scriptName in file.handleScriptNameToConfig ) )
			continue

		float pingDistance = file.handleScriptNameToConfig[scriptName].iconInWorld.pingDistance
		float pingDistanceSqr = pingDistance * pingDistance

		if ( DistanceSqr( playerEyePos, currentHandle.GetOrigin() ) < pingDistanceSqr )
		{
			waypoints.append( currentHandle )
		}
	}

	return waypoints
}



#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________Internal___________________________(){}
#endif


void function WPObjective_Register_Internal( WPObjective_Settings settings )
{
	WPObjective_Config config
	config.scriptName = settings.scriptName


	config.iconInWorld = WPObjective_WorldIcon_Register( settings )

	WPObjective_Minimap_Register( settings )


	
	{
		config.enumWaypoint = settings.enumWaypoint
		config.enumPingType = settings.enumPingType
		config.enumCommsAction = settings.enumCommsAction
		config.enumMinimapObject_prop_script = settings.enumMinimapObject_prop_script

		config.iconInWorld.imageAsset = settings.iconMap
		config.iconMapSmall = settings.iconMapSmall

		config.iconInWorld.descriptiveText = settings.pingText
	}

	file.handleScriptNameToConfig[ settings.scriptName ] <- config
	file.handleScriptNames.append( settings.scriptName )
}



















void function WPObjective_OnPropSpawn( entity handle )
{
	if( !WPObjective_IsHandleEnt( handle ) )
		return

	thread WPObjective_Spawn_Client( handle )
}



void function WPObjective_Spawn_Client( entity handle )
{
	string scriptName = handle.GetScriptName()
	if ( !( scriptName in file.handleScriptNameToConfig ) )
		return

	if ( handle.GetOwner() != null )
	{
		file.handleToParentEntEHI[handle] <- ToEHI( handle.GetOwner() )
	}

	WPObjective_Instance instance
	instance.iconInWorld = WPObjective_WorldIcon_Create( scriptName, handle )
	instance.isPinged = false
	instance.isWorldspaceVisible = true

	file.handleToWorldspaceInstance[handle] <- instance
}

















void function WPObjective_OnPropDestroy( entity handle )
{
	bool shouldDestroy = false
	foreach ( entity currentHandle, EHI parentEntEHI in file.handleToParentEntEHI )
	{
		if ( handle == currentHandle )
		{
			shouldDestroy = true
			break
		}
	}

	if ( !shouldDestroy )
		return

	thread WPObjective_Destroy_Client( handle )
}



void function WPObjective_Destroy_Client( entity handle )
{
	WPObjective_WorldIcon_Destroy( handle )

	delete file.handleToWorldspaceInstance[handle]
	delete file.handleToParentEntEHI[handle]
}














