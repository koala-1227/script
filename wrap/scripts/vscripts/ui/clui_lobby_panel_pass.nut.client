{




} file






const vector BATTLEPASS_WEAPON_SKIN_LOCAL_ANGLES = <5, -45, 0>
const vector BATTLEPASS_WEAPON_OFFSET = <0, 0, 29.0>








































































































































































































































































































































































































































































































































































































































































