	RuiSetImage( rui, "image2d", image2d )
	RuiSetFloat( rui, "imageWidth", baseImageWidth )
	RuiSetFloat( rui, "imageHeight", baseImageHeight )
	RuiSetFloat( rui, "imageScale", baseImageScale )
	RuiSetBool( rui, "disableLoadIcon", disableLoadIcon )
}

void function ShowBattlePassItem_RewardSetTracker( ItemFlavor tracker, ItemPresentationItemPositionData data )
{
	string displayType = "2DImage"
	if ( ItemFlavor_GetType( tracker ) == eItemType.reward_set_tracker ) 
		displayType = RewardSetTracker_GetDisplayType( tracker )

	switch ( displayType )
	{
		case "2DImage":
		{
			thread ShowBattlePassItem_Image2D( tracker, data )
			break
		}
		case "3DModel":
		{
			ItemFlavor displayFlav = RewardSetTracker_Get3DModelDisplayFlav( tracker )
			int displayFlavType = ItemFlavor_GetType( displayFlav )
			switch( displayFlavType )
			{
				case eItemType.account_currency:
				{
					thread ShowBattlePassItem_Currency( displayFlav, data.scale )
					break
				}
				case eItemType.melee_skin:
				{
					thread ShowBattlePassItem_MeleeSkin( displayFlav, data.scale )
					break
				}
				case eItemType.weapon_skin:
				{
					thread ShowBattlePassItem_WeaponSkin( displayFlav, data.scale )
					break
				}
				case eItemType.character_skin:
				{
					thread ShowBattlePassItem_CharacterSkin( displayFlav, data.scale )
					break
				}
				default:
				{
					Assert( false, format( "Reward set tracker 3D model display isn't supported for item type %d", displayFlavType ) )
					return
				}
			}
			break
		}
		default:
			Assert( false, format( "Invalid reward set tracker display type %s", displayType ) )
	}
}


const float RUI_IMAGE_2D_SCALE = 0.7
const float RUI_IMAGE_2D_WIDTH = 1570.0
const float RUI_IMAGE_2D_HEIGHT = 740.0
const float ORIGIN_IMAGE_2D_YOFFSET = 100.0
const float RUI_BP_IMAGE_WIDTH = 1177.6
const float RUI_BP_IMAGE_HEIGHT = 555.0
const float ORIGIN_BP_IMAGE_XOFFSET = 480.0
const float ORIGIN_BP_IMAGE_YOFFSET = 0.0
const float RUI_STICKER_IMAGE_WIDTH = 640.0
const float RUI_TOKEN_IMAGE_WIDTH = 896.0
const float RUI_TOKEN_IMAGE_HEIGHT = 896.0
const float TOKEN_ORIGIN_OFFSET_FACTOR = 4.0
const float STICKER_ORIGIN_OFFSET = -360.56

const float RUI_LEGEND_PASS_HEIGHT = 640.8
const float RUI_LEGEND_PASS_WIDTH = 460.8
const float RUI_LEGEND_PASS_ICON_SCALE = 0.45

void function ShowBattlePassItem_Image2D( ItemFlavor item, ItemPresentationItemPositionData data )
{
	int type = ItemFlavor_GetType( item )
	UISize screenSize = GetScreenSize()

	
	float yOffset = type == eItemType.image_2d ? ORIGIN_IMAGE_2D_YOFFSET : ORIGIN_BP_IMAGE_YOFFSET
	float heightOffset = yOffset / 1080.0
	
	float xPos = 0.0
	if ( type == eItemType.battlepass && fileLevel.sceneRefName == "battlepass_right_ref" )
		xPos += ORIGIN_BP_IMAGE_XOFFSET * screenSize.width / 1920.0

	asset ruiAsset = $"ui/world_space_image2d.rpak"
	vector origin = <xPos, screenSize.height * heightOffset * -1, 0.0>

	asset image2d
	float baseImageWidth
	float baseImageHeight
	float baseImageScale


		bool isLegendPass = false
		ItemFlavor parentItem


	if ( type == eItemType.image_2d )
	{
		image2d = GetImage2DAssetFromItemFlav( item )
		baseImageWidth = RUI_IMAGE_2D_WIDTH
		baseImageHeight = RUI_IMAGE_2D_HEIGHT
		baseImageScale = RUI_IMAGE_2D_SCALE
	}
	else if ( type == eItemType.battlepass )
	{
		int bpType = BattlePass_GetType( item )

		if ( bpType == ePassType.SEASONAL )
		{
			image2d = BattlePass_GetStoreBundleContentsImage( item )
			baseImageWidth  = RUI_BP_IMAGE_WIDTH
			baseImageHeight = RUI_BP_IMAGE_HEIGHT
			baseImageScale  = RUI_IMAGE_2D_SCALE
		}

		else if ( bpType == ePassType.LEGEND )
		{
			parentItem = expect ItemFlavor( ItemFlavor_GetParentFlavor( item ) )
			ruiAsset = $"ui/world_space_image2d_pass.rpak"
			image2d = $"rui/menu/battlepass/legendpass/legendpass_card_bg"
			isLegendPass = true
			baseImageWidth  = RUI_LEGEND_PASS_WIDTH
			baseImageHeight = RUI_LEGEND_PASS_HEIGHT
			baseImageScale  = RUI_IMAGE_2D_SCALE
		}

	}
	else if ( type == eItemType.reward_set_tracker )
	{
		
		image2d = RewardSetTracker_GetDisplayImageAsset( item )
		vector imageSize = GetImageSize( image2d )
		baseImageWidth = RUI_STICKER_IMAGE_WIDTH
		baseImageHeight = RUI_STICKER_IMAGE_WIDTH * ( imageSize.y / imageSize.x )
		origin += < data.offset.x * GetScreenScaleFrac(), data.offset.y * GetScreenScaleFrac(), 0 >
		baseImageScale = RUI_IMAGE_2D_SCALE
	}
	else if ( type == eItemType.feature_unlock_token )
	{
		image2d = FeatureUnlockToken_GetRewardAssetFromItemFlav( item )
		baseImageWidth = RUI_TOKEN_IMAGE_WIDTH
		baseImageHeight = RUI_TOKEN_IMAGE_HEIGHT
		origin += < screenSize.width / TOKEN_ORIGIN_OFFSET_FACTOR, 0, 0 >
		baseImageScale = RUI_IMAGE_2D_SCALE
	}
	else
	{
		Assert( false )
		return
	}

	var topo = RuiTopology_CreatePlane( origin, <screenSize.width, 0, 0>, <0, screenSize.height, 0>, true )
	var rui = RuiCreate( ruiAsset, topo, RUI_DRAW_POSTEFFECTS, 0 )

	fileLevel.topo = topo
	fileLevel.rui = rui

	RuiSetImage( rui, "image2d", $"" )

	RuiSetImage( rui, "image2d", image2d )
	RuiSetFloat( rui, "imageWidth", baseImageWidth )
	RuiSetFloat( rui, "imageHeight", baseImageHeight )
	RuiSetFloat( rui, "imageScale", baseImageScale )


		if ( isLegendPass )
		{
			RuiSetImage( rui, "icon", ItemFlavor_GetIcon( parentItem ) )
			RuiSetFloat( rui, "iconScale", RUI_LEGEND_PASS_ICON_SCALE )
			RuiSetString( rui, "headerText", Localize( "#LEGENDPASS" ).toupper() )
			RuiSetString( rui, "descText", Localize( ItemFlavor_GetShortName( parentItem ) ).toupper() )
		}


	
	RuiSetBool( rui, "disableLoadIcon", ( type == eItemType.reward_set_tracker || type == eItemType.feature_unlock_token ) ? true : false )
}

