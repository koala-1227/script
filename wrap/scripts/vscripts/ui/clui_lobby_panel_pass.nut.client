void function UIToClient_ItemPresentation( SettingsAssetGUID itemFlavorGUID, int level, float scale, bool showLow, var loadscreenPreviewBox, bool shouldPlayAudioPreview, string sceneRefName, bool isCompactUI = false, bool isMilestoneEvent = false, bool isBattlepassMilestone = false, bool useMenuZoomOffset = true, vector offset = <0, 0, 0>, bool showAnimationOnly = false )
{
	ItemFlavor flav = GetItemFlavorByGUID( itemFlavorGUID )
	int itemType = ItemFlavor_GetType( flav )
	entity sceneRef = GetEntByScriptName( sceneRefName )

	fileLevel.sceneRefName = sceneRefName
	fileLevel.sceneRefOrigin = sceneRef.GetOrigin() + offset
	ItemPresentationItemPositionData data
	ItemPresentationItemPositionData MilestoneEventData
	ItemPresentationItemPositionData battlepassMilestoneData

	
	
	
	if( sceneRefName == "battlepass_center_ref" && ( itemType == eItemType.weapon_skin || itemType == eItemType.weapon_charm ) )
		showLow = false

	if( isMilestoneEvent ) 
	{
		MilestoneEventData = ItemPresentation_GetMilestone_PositionData( flav, itemType, showLow, isCompactUI )
		fileLevel.sceneRefOrigin += MilestoneEventData.offset
	}
	else if( isBattlepassMilestone ) 
	{
		battlepassMilestoneData = ItemPresentation_GetBattlepassMilestone_PositionData( flav, itemType, showLow )
		fileLevel.sceneRefOrigin += battlepassMilestoneData.offset
	}

	switch ( sceneRefName )
	{
		case "battlepass_right_ref":
			data = ItemPresentation_GetBattlePassRight_PositionData( flav, itemType, showLow )
			break
		case "battlepass_center_ref":
			data = ItemPresentation_GetBattlePassCenter_PositionData( flav, itemType, showLow )
			break
		case "collection_event_ref":
			data = ItemPresentation_GetCollectionEvent_PositionData( flav, itemType, showLow )
			
			if ( isMilestoneEvent && ItemFlavor_GetType( flav ) == eItemType.reward_set_tracker && RewardSetTracker_GetDisplayType( flav ) == "2DImage" )
			{
				data.offset += <STICKER_ORIGIN_OFFSET, 0, 0>
			}
			break
		case "customize_character_emote_quip_ref":
			data = ItemPresentation_GetCharacterEmoteQuip_PositionData( flav, itemType, showLow )
			break
		case "customize_character_emotes_ref":
			data = ItemPresentation_GetCharacterEmotes_PositionData( flav, itemType, showLow, isCompactUI )
			break
		default:
			break
	}

	
	ItemPresentationItemPositionData genericData = ItemPresentation_GetGeneric_PositionData( flav, itemType, showLow, isCompactUI, sceneRefName )
	data.offset += genericData.offset
	data.scale *= ( genericData.scale * MilestoneEventData.scale * battlepassMilestoneData.scale )
	data.showEmoteBase = genericData.showEmoteBase && data.showEmoteBase && MilestoneEventData.showEmoteBase && battlepassMilestoneData.showEmoteBase
	data.showAnimationOnly = showAnimationOnly

	if ( sceneRefName == "battlepass_right_ref" || sceneRefName == "battlepass_center_ref" )
	{
		MoveLightsToSceneRef( sceneRef )
	}

	fileLevel.sceneRefOrigin += data.offset
	data.scale *= scale
	fileLevel.sceneRefAngles = sceneRef.GetAngles()

	ShowBattlepassItem( flav, data, level, loadscreenPreviewBox, shouldPlayAudioPreview, showLow, useMenuZoomOffset )
}




ItemPresentationItemPositionData function ItemPresentation_GetBattlePassRight_PositionData( ItemFlavor flav, int itemType, bool showLow )
{
	ItemPresentationItemPositionData data

	if ( fabs( float( GetScreenSize().width ) / float( GetScreenSize().height ) - (16.0 / 10.0) ) < 0.07 )
		data.offset += <0, 25, 0>

	switch( itemType )
	{
		case eItemType.character_emote:
			data.scale *= 0.7
			break

		case eItemType.emote_icon:
			if ( GetNearestAspectRatio( GetScreenSize().width, GetScreenSize().height ) == 1.6 )
			{
				data.offset += <10, 60, 0>
			}
			else
			{
				data.offset += <12, 60, 0>
			}

			break

		case eItemType.weapon_skin:
			ItemFlavor weaponFlavor = WeaponSkin_GetWeaponFlavor( flav )
			vector itemPosition = fileLevel.sceneRefOrigin + BATTLEPASS_WEAPON_OFFSET
			vector baseOffset = GetWeaponOffsetFromCameraToOrigin( Menu_GetCameraTarget(), < 0, 0, 0 >, itemPosition, <0,0,0> )
			data.offset = baseOffset * WeaponItemFlavor_GetItemPresentationTallVectorScale( weaponFlavor ) * 0.9
			break
	}

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetBattlePassCenter_PositionData( ItemFlavor flav, int itemType, bool showLow )
{
	ItemPresentationItemPositionData data

	switch( itemType )
	{
		case eItemType.emote_icon:
			data.offset += <5, 50, 21>
			break

		case eItemType.character_emote:
			data.scale *= 0.7
			break

		case eItemType.artifact_component_activation_emote:
			data.offset += <0, 0, 10>
			data.scale *= 1.8
			break
		case eItemType.character_skin:
		case eItemType.character:
			data.offset += <0, 0, -10>
			data.scale *= 1.25
			break

		case eItemType.weapon_skin:
			asset video = WeaponSkin_GetVideo( flav )
			if ( video == $"" )
			{
					ItemFlavor weaponFlavor = WeaponSkin_GetWeaponFlavor( flav )
					vector itemPosition = fileLevel.sceneRefOrigin + BATTLEPASS_WEAPON_OFFSET
					vector baseOffset = GetWeaponOffsetFromCameraToOrigin( Menu_GetCameraTarget(), < 0, 0.0, 0 >, itemPosition, <0,0,0> )
					data.offset = baseOffset * WeaponItemFlavor_GetItemPresentationWideVectorScale( weaponFlavor ) * 0.9
			}
			else
			{
				data.scale *= 1.5 
				data.offset += <0, 0, -2.5>
			}
			break

		case eItemType.skydive_emote:
			data.scale *= 1.5 
			data.offset += <0, 0, -2.5>
			break

		case eItemType.artifact_component_deathbox:
			data.offset += <0, 60, 5>
			break

		case eItemType.gladiator_card_frame:
			data.offset += <0, 200, 5>
			data.scale *= 0.9
			break
	}

	if ( showLow )
		data.offset += <0, 0, -10.5>

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetCollectionEvent_PositionData( ItemFlavor flav, int itemType, bool showLow )
{
	ItemPresentationItemPositionData data

	switch( itemType )
	{
		case eItemType.emote_icon:



#if SUPPORTS_COMPACT_UI
                        data.offset += IsUsingCompactUILayout() ? <4, 105, 6> : <0, 105, 16>
#else
						data.offset += <0, 105, 16> 
#endif

			break

		case eItemType.weapon_charm:
			data.offset += <0, 0, -10>
			break

		case eItemType.account_currency:
			data.offset += <0, 0, -10>
			break

		case eItemType.account_pack:
			data.offset += <0, 0, -10>
			break

		case eItemType.voucher:
			data.offset += <0, 0, -10>
			break

		case eItemType.character_execution:
			data.offset += <0, 0, -20>
			data.scale *= 0.8
			break

		case eItemType.character_skin:
			data.offset +=  <0, 0, -10>
			break

		case eItemType.gladiator_card_stance:
		case eItemType.gladiator_card_frame:
			data.offset += <0, 0, 1>
			data.scale *= 0.8
			break

		case eItemType.character_emote:
			data.scale *= 0.58
			data.showEmoteBase = false
			break

		case eItemType.weapon_skin:
				ItemFlavor weaponFlavor = WeaponSkin_GetWeaponFlavor( flav )
				vector itemPosition = fileLevel.sceneRefOrigin + BATTLEPASS_WEAPON_OFFSET
				vector baseOffset = GetWeaponOffsetFromCameraToOrigin( Menu_GetCameraTarget(), < 0, 0, 0 >, itemPosition, <0,0,0> )
				data.offset = baseOffset * WeaponItemFlavor_GetItemPresentationTallVectorScale( weaponFlavor ) * 0.9
			break

		case eItemType.melee_skin:
			data.scale *= 0.45
			break

		case eItemType.artifact_component_deathbox:
			data.offset += <-25, 160, 0>
			break
	}

	if ( showLow )
		data.offset += <0, 0, -10.5>

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetCharacterEmoteQuip_PositionData( ItemFlavor flav, int itemType, bool showLow )
{
	ItemPresentationItemPositionData data

#if SUPPORTS_COMPACT_UI

        if ( IsUsingCompactUILayout() )

			data.offset += <10, 0, 0>       
#endif

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetCharacterEmotes_PositionData( ItemFlavor flav, int itemType, bool showLow, bool isCompactUI )
{
	ItemPresentationItemPositionData data

#if SUPPORTS_COMPACT_UI
		if ( !isCompactUI )
		{
			
			data.offset += <0, 60, 20>
		}
		else
		{
			data.offset += <-5, 30, 0>
		}
#endif

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetMilestone_PositionData( ItemFlavor flav, int itemType, bool showLow, bool isCompactUI )
{
	ItemPresentationItemPositionData data

	data.offset += <-45, 0, 0>

	switch( itemType )
	{
		case eItemType.gladiator_card_stat_tracker:
			data.offset += <0, 0, 0>
			break

		case eItemType.gladiator_card_stance:
			data.offset += <0, 0, 0>
			break

		case eItemType.gladiator_card_frame:
			data.offset += <0, 0, 0>
			break

		case eItemType.emote_icon:
#if SUPPORTS_COMPACT_UI
				data.offset += <0, -50, 35>
				if ( isCompactUI )
					data.offset += <5, -50, -35>
				else
					data.offset += <-2, 50, -36>
#else
				data.offset += <0, -50, 20>
#endif
			break

		case eItemType.character_emote:
			data.offset += <0, 0, -25>
			data.scale *= 1.25
			break

		case eItemType.weapon_skin:
			data.offset += <-10, 0, -3>
			data.scale *= 1.25
			break

		case eItemType.character_skin:
			data.offset += <0, 0, 0>
			break

		case eItemType.melee_skin:
			data.offset += MeleeWeapon_GetMilestoneEventOffset( Melee_GetWeaponForSkin( flav ) )
			data.scale *= 1.5
			break
	}

	if ( !showLow )
		data.offset += <0, 0, 5>

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetBattlepassMilestone_PositionData( ItemFlavor flav, int itemType, bool showLow )
{
	ItemPresentationItemPositionData data

	data.offset += <-14, 0, 2.5> 

	switch( itemType )
	{
		case eItemType.character_skin:
			data.scale *= 1.05
			break

		case eItemType.gladiator_card_frame:
			data.offset += <0, 0, 0>
			data.scale *= 0.90
			break

		case eItemType.character_emote:
			data.offset += <0, 0, 2.5>
			break

		case eItemType.skydive_emote:
		case eItemType.weapon_skin:
			data.offset += <1, 0, 0.5>
			data.scale *= 1.5
			break
	}

	return data
}



ItemPresentationItemPositionData function ItemPresentation_GetGeneric_PositionData( ItemFlavor flav, int itemType, bool showLow, bool isCompactUI, string sceneRefName )
{
	ItemPresentationItemPositionData data

	if( sceneRefName != "battlepass_right_ref" && sceneRefName != "battlepass_center_ref")
	{
		data.offset += <0, 0, -2>
	}

	return data
}




void function MoveLightsToSceneRef( entity sceneRef)
{
	foreach ( light in fileLevel.stationaryLights )
	{
		light.SetOrigin( sceneRef.GetOrigin() + fileLevel.stationaryLightOffsets[ light ]  )
		light.SetTweakLightOrigin( sceneRef.GetOrigin() + fileLevel.stationaryLightOffsets[ light ]  )
	}
}

void function ShowBattlepassItem( ItemFlavor item, ItemPresentationItemPositionData data, int level, var loadscreenPreviewBox, bool shouldPlayAudioPreview, bool showLow = false, bool useMenuZoomOffset = true )
{
	fileLevel.loadscreenPreviewBox = loadscreenPreviewBox 

	ClearBattlePassItem()
	if ( fileLevel.didDisableBPLights )
	{
		BattlePassLightsOn()
		fileLevel.didDisableBPLights = false
	}

	fileLevel.loadscreenPreviewBox = loadscreenPreviewBox

	int itemType = ItemFlavor_GetType( item )

	switch ( itemType )
	{
		case eItemType.account_currency:
		case eItemType.account_currency_bundle:
			ShowBattlePassItem_Currency( item, data.scale )
			break

		case eItemType.account_pack:
			ShowBattlePassItem_ApexPack( item, data.scale )
			break

		case eItemType.character_skin:
			ShowBattlePassItem_CharacterSkin( item, data.scale )
			break

		case eItemType.character_execution:
			ShowBattlePassItem_Execution( item, data.scale )
			break

		case eItemType.weapon_skin:
			asset video = WeaponSkin_GetVideo( item )
			if ( video != $"" )
				ShowBattlePassItem_WeaponSkinVideo( item, data.scale, video )
			else
				ShowBattlePassItem_WeaponSkin( item, data.scale )
			break

		case eItemType.weapon_charm:
			ShowBattlePassItem_WeaponCharm( item, data.scale )
			break

		case eItemType.artifact_component_blade:
		case eItemType.artifact_component_power_source:
		case eItemType.artifact_component_theme:
		case eItemType.melee_skin:
			ShowBattlePassItem_MeleeSkin( item, data.scale )
			break

		case eItemType.gladiator_card_stance:
		case eItemType.gladiator_card_frame:
			BattlePassLightsOff() 
			fileLevel.didDisableBPLights = true
			ShowBattlePassItem_Banner( item, data.scale )
			break

		case eItemType.gladiator_card_intro_quip:
		case eItemType.gladiator_card_kill_quip:
			ShowBattlePassItem_Quip( item, data.scale, shouldPlayAudioPreview )
			break

		case eItemType.gladiator_card_stat_tracker:
			ShowBattlePassItem_StatTracker( item, data.scale )
			break

		case eItemType.voucher:
			ShowBattlePassItem_Voucher( item, data.scale )
			break
		case eItemType.gladiator_card_badge:
			ShowBattlePassItem_Badge( item, data.scale, level )
			break

		case eItemType.account_flag:
			ShowBattlePassItem_AccountFlag( item )
			break

		case eItemType.battlepass:
		case eItemType.image_2d:
		case eItemType.reward_set_tracker:
			ShowBattlePassItem_RewardSetTracker( item, data )
			break

		case eItemType.feature_unlock_token:
			if ( data.showAnimationOnly )
			{
				ShowBattlePassItem_FeatureUnlockToken( item )
			}
			else
			{
				ShowBattlePassItem_Image2D( item, data )
			}
			break

		case eItemType.music_pack:
			ShowBattlePassItem_MusicPack( item, data.scale, shouldPlayAudioPreview )
			break

		case eItemType.loadscreen:
			ShowBattlePassItem_Loadscreen( item, data.scale )
			break

		case eItemType.radio_play:
			ShowBattlePassItem_RadioPlay( item, data.scale )
			break

		case eItemType.skydive_emote:
			ShowBattlePassItem_SkydiveEmote( item, data.scale )
			break

		case eItemType.skydive_trail:
			ShowBattlePassItem_SkydiveEmote( item, data.scale, false )
			break

		case eItemType.emote_icon:
			ShowBattlePassItem_EmoteIcon( item, data.scale, showLow )
			break

		case eItemType.character_emote:
			ShowBattlePassItem_Emote( item, data.scale, data.showEmoteBase, useMenuZoomOffset )
			break

		case eItemType.character_select:
			ShowBattlePassItem_CharacterSelect( item, data.scale )
			break

		case eItemType.quest_mission:
			ShowBattlePassItem_QuestMission( item, data.scale )
			break

		case eItemType.quest_comic:
			ShowBattlePassItem_QuestComicPage( item, data.scale )
			break

		case eItemType.battlepass_purchased_xp:
			thread ShowBattlePassItem_Level( item, data.scale )
			break

		case eItemType.character:
			thread ShowBattlePassItem_Character( item, data.scale )
			break

		case eItemType.sticker:
			ShowBattlePassItem_Sticker( item )
			break






		case eItemType.artifact_component_activation_emote:
			ShowBattlePassItem_ArtifactBink( item, data.scale )
			break

		case eItemType.artifact_component_deathbox:
			ShowBattlePassItem_Deathbox( item, data.offset )
			break

		case eItemType.digital_garment:
			ShowBattlePassItem_DigitalGarment( item, data.scale )
			break

		default:
			Warning( "Battle Pass reward item type not supported: " + DEV_GetEnumStringSafe( "eItemType", itemType ) )
			ShowBattlePassItem_Unknown( item, data.scale )
			break
	}
}



void function ClearBattlePassItem()
{
	foreach ( model in fileLevel.models )
	{
		if ( IsValid( model ) )
		{
			MenuWeaponModel_ClearReactiveEffects( model )

			foreach ( entity ent in GetEntityAndAllChildren( model ) )
			{
				if ( IsValid( ent ) )
					ent.Destroy()
			}
		}
	}
	fileLevel.models.clear()

	foreach ( fx in fileLevel.fxs )
	{
		if ( EffectDoesExist( fx ) )
		{
			EffectStop( fx, true, true )
		}
	}
	fileLevel.fxs.clear()

	if ( IsValid( fileLevel.mover ) )
		fileLevel.mover.Destroy()

	CleanupNestedGladiatorCard( fileLevel.bannerHandle )

	if ( fileLevel.rui != null )
		RuiDestroyIfAlive( fileLevel.rui )

	if ( fileLevel.topo != null )
	{
		RuiTopology_Destroy( fileLevel.topo )
		fileLevel.topo = null
	}

	if ( fileLevel.videoChannel != -1 )
	{
		ReleaseVideoChannel( fileLevel.videoChannel )
		fileLevel.videoChannel = -1
	}

	if ( fileLevel.playingPreviewAlias != "" )
		StopSoundOnEntity( GetLocalClientPlayer(), fileLevel.playingPreviewAlias )

	if ( fileLevel.loadscreenPreviewBox != null && IsValid( fileLevel.loadscreenPreviewBox ) )
	{
		UpdateLoadscreenPreviewMaterial( fileLevel.loadscreenPreviewBox, null, 0 )
		fileLevel.loadscreenPreviewBox = null
	}
}

void function ShowBattlePassItem_ApexPack( ItemFlavor item, float scale )
{
	vector origin = fileLevel.sceneRefOrigin + <0, 0, 10.0>
	vector angles = fileLevel.sceneRefAngles

	entity mover = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", origin, angles )
	mover.MakeSafeForUIScriptHack()

	asset ornull tickAsset = GRXPack_GetTickModel( item )
	string tickSkin = GRXPack_GetTickModelSkin( item )

	if ( tickAsset == null || tickSkin == "" )
		return

	expect asset( tickAsset )

	entity model    = CreateClientSidePropDynamic( origin, AnglesCompose( angles, <0, 135, 0> ), tickAsset )
	model.MakeSafeForUIScriptHack()
	model.SetModelScale( scale * 0.60 )
	model.SetParent( mover )
	model.SetSkin( model.GetSkinIndexByName( tickSkin ) )

	mover.NonPhysicsRotate( <0, 0, -1>, fileLevel.rotateSpeed )

	vector flashColor = ItemFlavor_GetQualityColor( item ) / 255
	thread FlashMenuModel( model, eMenuModelFlashType.BATTLEPASS, flashColor )

	fileLevel.mover = mover
	fileLevel.models.append( model )
}


void function ShowBattlePassItem_CharacterSkin( ItemFlavor item, float scale )
{
	
	vector season22BattlePassOffset = fileLevel.sceneRefName == "battlepass_center_ref" ? <-1.0, 60.0, 0.0> : <0.0, 0.0, 0.0>

	ItemFlavor char = CharacterSkin_GetCharacterFlavor( item )
	vector origin   = fileLevel.sceneRefOrigin + season22BattlePassOffset + <0, 0, 4.0> - 0.6 * CharacterClass_GetMenuZoomOffset( char )
	vector angles   = fileLevel.sceneRefAngles

	vector previewVerticalOffset = GetGlobalSettingsVector( ItemFlavor_GetAsset( item ), "previewOffset" )
	origin += previewVerticalOffset

	vector previewAnglesOffset = GetGlobalSettingsVector( ItemFlavor_GetAsset( item ), "previewRotation" )
	angles += previewAnglesOffset

	entity mover = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", origin, angles )
	mover.MakeSafeForUIScriptHack()

	entity model = CreateClientSidePropDynamic( origin, angles, $"mdl/dev/empty_model.rmdl" )


	
	if ( fileLevel.sceneRefName == "battlepass_center_ref" )
		model.SetLightingOrigin( <11328, 2612, 28> ) 


	CharacterSkin_Apply( model, item )
	model.MakeSafeForUIScriptHack()
	model.SetModelScale( scale * 0.75 )
	model.SetParent( mover )
	
	thread MoverPendulum( mover )

	thread PlayAnim( model, "ACT_MP_MENU_LOOT_CEREMONY_IDLE", mover )

	vector flashColor = ItemFlavor_GetQualityColor( item ) / 255
	thread FlashMenuModel( model, eMenuModelFlashType.BATTLEPASS, flashColor )

	fileLevel.mover = mover
	fileLevel.models.append( model )
}

void function MoverPendulum( entity mover )
{
	vector baseAngles = mover.GetAngles()
	bool firstTime    = false
	float dir         = 1
	float delta       = 30.0
	const float MOVE_TIME = 10.0

	while ( IsValid( mover ) )
	{
		float scalar   = firstTime ? 0.5 : 1.0
		float moveTime = MOVE_TIME * scalar
		mover.NonPhysicsRotateTo( baseAngles - (dir * <0, delta, 0>), moveTime, 0.5 * scalar, 0.5 * scalar )
		firstTime = false
		dir *= -1
		wait moveTime
	}
}

void function ShowBattlePassItem_Execution( ItemFlavor item, float scale )
{
	const float BATTLEPASS_EXECUTION_Z_OFFSET = 12.0
	const vector BATTLEPASS_EXECUTION_LOCAL_ANGLES = <0, 15, 0>
	const float BATTLEPASS_EXECUTION_SCALE = 0.8

	
	ItemFlavor attackerCharacter = CharacterExecution_GetCharacterFlavor( item )
	ItemFlavor characterSkin     = LoadoutSlot_GetItemFlavor( LocalClientEHI(), Loadout_CharacterSkin( attackerCharacter ) )

	asset attackerAnimSeq = CharacterExecution_GetAttackerPreviewAnimSeq( item )
	asset victimAnimSeq   = CharacterExecution_GetVictimPreviewAnimSeq( item )

	
	vector origin = fileLevel.sceneRefOrigin + <0, 0, BATTLEPASS_EXECUTION_Z_OFFSET>
	vector angles = AnglesCompose( fileLevel.sceneRefAngles, BATTLEPASS_EXECUTION_LOCAL_ANGLES )

	entity mover         = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", origin, angles )
	entity attackerModel = CreateClientSidePropDynamic( origin, angles, $"mdl/dev/empty_model.rmdl" )
	entity victimModel   = CreateClientSidePropDynamic( origin, angles, $"mdl/dev/empty_model.rmdl" )

	CharacterSkin_Apply( attackerModel, characterSkin )
	victimModel.SetModel( $"mdl/humans/class/medium/dummy_v20_base_w.rmdl" )

	
	bool attackerHasSequence = attackerModel.Anim_HasSequence( attackerAnimSeq )
	bool victimHasSequence   = victimModel.Anim_HasSequence( victimAnimSeq )

	if ( !attackerHasSequence || !victimHasSequence )
	{
		asset attackerPlayerSettings = CharacterClass_GetSetFile( attackerCharacter )
		string attackerRigWeight     = GetGlobalSettingsString( attackerPlayerSettings, "bodyModelRigWeight" )
		string attackerAnim          = "mp_pt_execution_" + attackerRigWeight + "_attacker_loot"

		attackerModel.Anim_Play( attackerAnim )
		victimModel.Anim_Play( "mp_pt_execution_default_victim_loot" )
		Warning( "Couldn't find menu idles for execution reward: " + DEV_DescItemFlavor( item ) + ". Using fallback anims." )
		if ( !attackerHasSequence )
			Warning( "ATTACKER could not find sequence: " + attackerAnimSeq )
		if ( !victimHasSequence )
			Warning( "VICTIM could not find sequence: " + victimAnimSeq )
	}
	else
	{
		attackerModel.Anim_Play( attackerAnimSeq )
		victimModel.Anim_Play( victimAnimSeq )
	}

	mover.MakeSafeForUIScriptHack()

	attackerModel.MakeSafeForUIScriptHack()
	attackerModel.SetParent( mover )

	victimModel.MakeSafeForUIScriptHack()
	victimModel.SetParent( mover )

	
	attackerModel.SetModelScale( scale * BATTLEPASS_EXECUTION_SCALE )
	victimModel.SetModelScale( scale * BATTLEPASS_EXECUTION_SCALE )

	vector flashColor = ItemFlavor_GetQualityColor( item ) / 255
	thread FlashMenuModel( attackerModel, eMenuModelFlashType.BATTLEPASS, flashColor )
	thread FlashMenuModel( victimModel, eMenuModelFlashType.BATTLEPASS, flashColor )

	fileLevel.mover = mover
	fileLevel.models.append( attackerModel )
	fileLevel.models.append( victimModel )
}


void function ShowBattlePassItem_WeaponSkin( ItemFlavor item, float scale )
{
	ItemFlavor weaponFlavor = WeaponSkin_GetWeaponFlavor( item )
	vector origin = fileLevel.sceneRefOrigin + BATTLEPASS_WEAPON_OFFSET
	vector angles = fileLevel.sceneRefAngles

	

	entity mover = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", origin, angles )
	mover.MakeSafeForUIScriptHack()

	entity weaponModel    = CreateClientSidePropDynamic( origin, AnglesCompose( angles, BATTLEPASS_WEAPON_SKIN_LOCAL_ANGLES ), $"mdl/dev/empty_model.rmdl" )
	WeaponCosmetics_Apply( weaponModel, item, null )

	weaponModel.MakeSafeForUIScriptHack()
	weaponModel.SetVisibleForLocalPlayer( 0 )
	weaponModel.Anim_SetPaused( true )

	weaponModel.SetParent( mover )

	
	weaponModel.SetLocalOrigin( GetAttachmentOriginOffset( weaponModel, "MENU_ROTATE", BATTLEPASS_WEAPON_SKIN_LOCAL_ANGLES ) )
	weaponModel.SetLocalAngles( BATTLEPASS_WEAPON_SKIN_LOCAL_ANGLES )

	mover.NonPhysicsRotate( <0, 0, -1>, fileLevel.rotateSpeed )

	vector flashColor = ItemFlavor_GetQualityColor( item ) / 255
	thread FlashMenuModel( weaponModel, eMenuModelFlashType.BATTLEPASS, flashColor )

	UpdateWeaponLights( weaponModel, WEAPON_LIGHT_RIG_OFFSET, item )
	UpdateReactiveWeaponModel( item, weaponFlavor, weaponModel )

	if ( ItemFlavor_GetQuality( item ) == eRarityTier.MYTHIC )
		weaponModel.SetPoseParameter( MYTHIC_301_LOBBY_POSE_PARAM, 1.0 )

	asset animSeq = WeaponSkin_GetMenuAnimSeq( item )
	if ( animSeq != $"" )
		weaponModel.Anim_Play( animSeq )

	fileLevel.mover = mover
	fileLevel.models.append( weaponModel )

#if DEV
	DEV_PositionContext ctx
	ctx.screenName = "Battle Pass (Gun)"
	ctx.weaponName = Localize( ItemFlavor_GetShortName( weaponFlavor ) )
	ctx.mover = mover
	ctx.model = weaponModel
	ctx.cameraEnt = Menu_GetCameraTarget()
	ctx.useCameraEntity = true
	ctx.baseOrigin = origin
	ctx.baseAngles = BATTLEPASS_WEAPON_SKIN_LOCAL_ANGLES

	DEV_RegisterPositionContext( ctx )
#endif
}

