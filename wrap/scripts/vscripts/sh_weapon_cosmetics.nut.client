bool function WeaponAddOn_WeaponHasEquippableAddOn( ItemFlavor weapon, bool functionref( ItemFlavor ) addOnFilterFunc = null )
{
	array<ItemFlavor> items = WeaponAddOn_GetAllAddOnsForWeapon( weapon )
	foreach ( item in items )
	{
		if ( addOnFilterFunc != null && !addOnFilterFunc( item ) )
		{
			continue
		}

		if ( GRX_IsItemOwnedByPlayer( item ) )
			return true
	}

	return false
}

bool function WeaponAddOn_WeaponHasEquippableDoesKnockFXAddOn( ItemFlavor weapon )
{
	return WeaponAddOn_WeaponHasEquippableAddOn( weapon, bool function( ItemFlavor addOn ) {
		return WeaponAddon_DoesKnockFX( addOn )
	} )
}



#if DEV
bool s_debugLights = false
bool s_turnOffRoomLights = false
vector s_debugRotationOverride = <0, 0, 0>
bool s_hasDebugRotationOverride = false
vector s_lastPassedRotation = <0, 0, 0>
const float s_debugTime = 10.0

vector function DEV_GetWeaponLightRigOffset()
{
	return s_lastPassedRotation
}

void function DEV_SetWeaponLightDebugState( bool roomLightsOff, bool debugDraw, vector rotation )
{
	s_turnOffRoomLights = roomLightsOff
	s_debugLights = debugDraw
	s_debugRotationOverride = rotation
	s_hasDebugRotationOverride = true
}
#endif
entity s_lightRigModel = null
entity s_weaponModel = null
string s_weaponModelName = "" 

void function CleanupLights( array<entity> lights )
{
	if ( IsValid( s_lightRigModel ) )
	{
		s_lightRigModel.Destroy()
#if DEV
			if ( s_debugLights )
				printt( "WeaponLightsDbg - OnThreadEnd - s_lightRigModel destroyed" )
#endif
	}

	foreach ( int idx, entity light in lights )
	{
		if ( !IsValid( light ) )
			continue

		light.SetTweakLightRealtimeShadows( false )
		light.SetTweakLightUpdateShadowsEveryFrame( false )
		light.SetTweakLightDistance( 2.0 ) 
		light.SetTweakLightBrightness( 0.01 )
#if DEV
			if ( s_debugLights )
				printf( "WeaponLightsDbg - OnThreadEnd - light %d dimmed", idx )
#endif
	}
}

#if DEV
void function DimRoomLights()
{
	foreach ( string roomLightName in ROOM_LIGHT_NAMES )
	{
		foreach ( entity roomLight in GetEntArrayByScriptName( roomLightName ) )
		{
			if ( IsValid( roomLight ) )
			{
				roomLight.SetTweakLightDistance( 1.0 )
				roomLight.SetTweakLightBrightness( 0.0 )
			}
		}
	}
	foreach ( bpLight in GetEntArrayByScriptName( "battlepass_stationary_light" ) )
	{
		if ( IsValid( bpLight ) )
		{
			bpLight.SetTweakLightDistance( 1.0 )
			bpLight.SetTweakLightBrightness( 0.0 )
		}
	}
}

void function DrawLightDebugArrows( vector origin, entity keyLight, entity rimLightL, entity rimLightR, entity fillLight )
{
	DebugDrawArrow( origin, keyLight.GetOrigin(), 2, COLOR_YELLOW, false, s_debugTime )
	DebugDrawArrow( origin, rimLightL.GetOrigin(), 2, COLOR_RED, false, s_debugTime )
	DebugDrawArrow( origin, rimLightR.GetOrigin(), 2, COLOR_BLUE, false, s_debugTime )
	DebugDrawArrow( origin, fillLight.GetOrigin(), 2, COLOR_GREEN, false, s_debugTime )
}
#endif

void function PositionLightsFromRig( entity keyLight, entity fillLight, entity rimLightL, entity rimLightR, int attachIdx_key, int attachIdx_fill, int attachIdx_rimL, int attachIdx_rimR )
{
	fillLight.SetTweakLightOrigin( s_lightRigModel.GetAttachmentOrigin( attachIdx_fill ) )
	fillLight.SetTweakLightAngles( s_lightRigModel.GetAttachmentAngles( attachIdx_fill ) )
	rimLightL.SetTweakLightOrigin( s_lightRigModel.GetAttachmentOrigin( attachIdx_rimL ) )
	rimLightL.SetTweakLightAngles( s_lightRigModel.GetAttachmentAngles( attachIdx_rimL ) )
	rimLightR.SetTweakLightOrigin( s_lightRigModel.GetAttachmentOrigin( attachIdx_rimR ) )
	rimLightR.SetTweakLightAngles( s_lightRigModel.GetAttachmentAngles( attachIdx_rimR ) )
	keyLight.SetTweakLightOrigin( s_lightRigModel.GetAttachmentOrigin( attachIdx_key ) )
	keyLight.SetTweakLightAngles( s_lightRigModel.GetAttachmentAngles( attachIdx_key ) )
}

void function UpdateWeaponLights( entity model, vector rotation, ItemFlavor item )
{
#if DEV
		s_lastPassedRotation = rotation
		if ( s_turnOffRoomLights )
			DimRoomLights()
#endif

	thread function() : ( model, rotation, item ) {
		if ( IsValid( s_lightRigModel ) && ( s_weaponModel == model ) && ( s_weaponModelName == model.GetModelName() ) )
			return

		Signal( level, WEAPON_LIGHT_SIGNAL_NAME )
		EndSignal( level, WEAPON_LIGHT_SIGNAL_NAME )
		EndSignal( model, "OnDestroy" )

		array<entity> lights = GetEntArrayByScriptName( "close_character_light" ) 

		OnThreadEnd( void function() : ( lights ) {
			CleanupLights( lights )
		} )

		CleanupLights( lights )

		
		vector origin = model.GetAttachmentOrigin( model.LookupAttachment( "MENU_ROTATE" ) )

		s_lightRigModel = CreateClientSidePropDynamic( origin, rotation, LIGHT_RIG_MDL )
		s_lightRigModel.MakeSafeForUIScriptHack()
		s_lightRigModel.Hide()

		s_weaponModel = model
		s_weaponModelName = model.GetModelName()

		LightData lightData
		int type = ItemFlavor_GetType( item )
		ItemFlavor weapon
		if ( type == eItemType.weapon_skin )
			weapon = WeaponSkin_GetWeaponFlavor( item )
		else if ( type == eItemType.melee_skin )
			weapon = Melee_GetWeaponForSkin( item )
		else
			weapon = item

		lightData = WeaponItemFlavor_GetMenuCustomLightData( weapon )

		if ( lightData.initialized )
		{
			Assert( lights.len() == LIGHT_NAMES.len() )
			if ( lights.len() != LIGHT_NAMES.len() )
				return

			foreach ( entity light in lights )
			{
				light.SetTweakLightRealtimeShadows( true )
				light.SetTweakLightUpdateShadowsEveryFrame( true )
			}

			entity keyLight  = lights[0]
			entity fillLight = lights[1]
			entity rimLightL = lights[2]
			entity rimLightR = lights[3]

			keyLight.SetTweakLightColor( lightData.key_color )
			keyLight.SetTweakLightBrightness( lightData.key_brightness )
			keyLight.SetTweakLightCone( lightData.key_cone )
			keyLight.SetTweakLightInnerCone ( lightData.key_innercone )
			keyLight.SetTweakLightDistance( lightData.key_distance )
			keyLight.SetTweakLightHalfBrightFrac( lightData.key_halfbrightfrac )
			keyLight.SetTweakLightSpecIntensity( lightData.key_specint )
			keyLight.SetTweakLightPBRFalloff( lightData.key_pbrfalloff )
			keyLight.SetTweakLightRealtimeShadows( lightData.key_castshadows )

			fillLight.SetTweakLightColor( lightData.fill_color )
			fillLight.SetTweakLightBrightness( lightData.fill_brightness )
			fillLight.SetTweakLightCone( lightData.fill_cone )
			fillLight.SetTweakLightInnerCone ( lightData.fill_innercone )
			fillLight.SetTweakLightDistance( lightData.fill_distance )
			fillLight.SetTweakLightHalfBrightFrac( lightData.fill_halfbrightfrac )
			fillLight.SetTweakLightSpecIntensity( lightData.fill_specint )
			fillLight.SetTweakLightPBRFalloff( lightData.fill_pbrfalloff )
			fillLight.SetTweakLightRealtimeShadows( lightData.fill_castshadows )

			rimLightL.SetTweakLightColor( lightData.rimL_color )
			rimLightL.SetTweakLightBrightness( lightData.rimL_brightness )
			rimLightL.SetTweakLightCone( lightData.rimL_cone )
			rimLightL.SetTweakLightInnerCone ( lightData.rimL_innercone )
			rimLightL.SetTweakLightDistance( lightData.rimL_distance )
			rimLightL.SetTweakLightHalfBrightFrac( lightData.rimL_halfbrightfrac )
			rimLightL.SetTweakLightSpecIntensity( lightData.rimL_specint )
			rimLightL.SetTweakLightPBRFalloff( lightData.rimL_pbrfalloff )
			rimLightL.SetTweakLightRealtimeShadows( lightData.rimL_castshadows )

			rimLightR.SetTweakLightColor( lightData.rimR_color )
			rimLightR.SetTweakLightBrightness( lightData.rimR_brightness )
			rimLightR.SetTweakLightCone( lightData.rimR_cone )
			rimLightR.SetTweakLightInnerCone ( lightData.rimR_innercone )
			rimLightR.SetTweakLightDistance( lightData.rimR_distance )
			rimLightR.SetTweakLightHalfBrightFrac( lightData.rimR_halfbrightfrac )
			rimLightR.SetTweakLightSpecIntensity( lightData.rimR_specint )
			rimLightR.SetTweakLightPBRFalloff( lightData.rimR_pbrfalloff )
			rimLightR.SetTweakLightRealtimeShadows( lightData.rimR_castshadows )

			s_lightRigModel.Anim_Play( lightData.animSeq )

			int attachIdx_fill = s_lightRigModel.LookupAttachment( LIGHT_NAMES[0] )
			int attachIdx_rimL = s_lightRigModel.LookupAttachment( LIGHT_NAMES[1] )
			int attachIdx_rimR = s_lightRigModel.LookupAttachment( LIGHT_NAMES[2] )
			int attachIdx_key  = s_lightRigModel.LookupAttachment( LIGHT_NAMES[3] )

			PositionLightsFromRig( keyLight, fillLight, rimLightL, rimLightR, attachIdx_key, attachIdx_fill, attachIdx_rimL, attachIdx_rimR )

#if DEV
			if ( s_debugLights )
			{
				foreach ( light in lights )
					printf( "WeaponLightDbg: distance to light %s is %1.2f", string( light ), Distance( origin, light.GetOrigin() ) )

				
				DrawLightDebugArrows( origin, keyLight, rimLightL, rimLightR, fillLight )
			}
#endif

#if DEV
			vector lastRotation = rotation
			bool lastRoomLightsOff = s_turnOffRoomLights
			while ( true )
			{
				WaitFrame()
				if ( !IsValid( s_lightRigModel ) )
					break

				if ( s_turnOffRoomLights && !lastRoomLightsOff )
				{
					lastRoomLightsOff = true
					DimRoomLights()
				}

				if ( !s_hasDebugRotationOverride )
					continue

				vector currentRotation = s_debugRotationOverride
				if ( currentRotation == lastRotation )
					continue

				lastRotation = currentRotation
				s_lightRigModel.SetAngles( currentRotation )
				s_lightRigModel.Anim_Play( lightData.animSeq )

				PositionLightsFromRig( keyLight, fillLight, rimLightL, rimLightR, attachIdx_key, attachIdx_fill, attachIdx_rimL, attachIdx_rimR )

				if ( s_debugLights )
					DrawLightDebugArrows( origin, keyLight, rimLightL, rimLightR, fillLight )
			}
#else
			WaitForever()
#endif
		}
	}()
}


#if DEV
void function DEV_TestWeaponSkinData()
{
	entity model = CreateClientSidePropDynamic( <0, 0, 0>, <0, 0, 0>, $"mdl/dev/empty_model.rmdl" )

	foreach ( weapon in GetAllWeaponItemFlavors( false ) )
	{
		array<ItemFlavor> weaponSkins = GetValidItemFlavorsForLoadoutSlot( Loadout_WeaponSkin( weapon ) )

		foreach ( skin in weaponSkins )
		{
			printt( string(ItemFlavor_GetAsset( skin )), "skinName:", WeaponSkin_GetSkinName( skin ) )
			WeaponCosmetics_Apply( model, skin, null )
		}
	}

	model.Destroy()
}
#endif
