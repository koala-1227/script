	if ( IsValid( speaker ) && speaker.IsPlayer() && aliasID in speaker.p.battleChatterIdCallbackMap  )
		shouldPlay = !( speaker.p.battleChatterIdCallbackMap[ aliasID ] ( speaker ) )

	if ( shouldPlay )

		thread PlayClientDialogueOnEntity( aliasID, dialogueFlags, speaker, -1, selector )
}


