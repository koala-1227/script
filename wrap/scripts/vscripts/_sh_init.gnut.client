global function SV_CL_Shared_Init

void function SV_CL_Shared_Init()
{

	if ( !IsLobby() )
		ClMinimap_Pre_Init()


#if DEV
		PrintDebugTimeDetails()
#endif





	GameModes_Init()
	Settings_Init()





	if ( IsLobby() )
	{
		Shared_Lobby_Init()
		PlayerWaypoints_Init()
		return
	}

	SV_CL_Init()


		Crafting_Init()







		Client_Init()





} 


