	return true
}





const string CMDNAME_VEHICLE_EJECT = "ClientCallback_VehicleEject"

void function InitVehicleEject()
{
	Remote_RegisterServerFunction( CMDNAME_VEHICLE_EJECT )


		RegisterConCommandTriggeredCallback( "+offhand4", OnPressEjectButton )

}


















void function OnPressEjectButton( entity player )
{
	if ( !IsValid( player ) || !IsAlive( player ) )
		return
	if ( (player != GetLocalViewPlayer()) || (player != GetLocalClientPlayer()) )
		return

	if ( IsControllerModeActive() )
	{
		if ( TryOnscreenPromptFunction( player, "quickchat" ) )
			return
	}

	if ( !HoverVehicle_PlayerIsDriving( player ) )
		return
	Remote_ServerCallFunction( CMDNAME_VEHICLE_EJECT )
}







