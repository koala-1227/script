void function CL_OnVehicleCreated( entity vehicle )
{
	
	if( vehicle.GetScriptName() != HOVER_VEHICLE_SCRIPTNAME )
		return

	
	SetCallback_CanUseEntityCallback( vehicle, VehicleCanUseEntityCallback )
	HoverVehicle_SetEffects( vehicle )

	if( HoverVehicles_PingFromMap_Enabled() )
	{
		file.vehicleAtSpawnPlatform[vehicle] <- true
	}

	if(	!HoverVehiclesAreEnabled())
		return

	SetMapFeatureItem( 80, "#HOVER_VEHICLE", "#HOVER_VEHICLE_DESC", HOVER_VEHICLE_SPAWNPOINT_ICON )


		thread CL_FX_Vehicle_HealShine( vehicle )
		thread CL_DamageStateTracking_Think_Thread( vehicle )

}



