void function CL_OnPropCreated( entity ent )
{
	if( !IsValid( ent ) )
		return

	string entName = ent.GetScriptName()

	if( entName != AUTORESPAWN_HOLO_SCRIPTNAME )
		return

	
	thread CL_AutoRespawn_CountdownTimer_Thread( ent )
}

void function CL_AutoRespawn_CountdownTimer_Thread( entity spawnHolo )
{
	if( !IsValid( spawnHolo ) )
		return

	entity player = GetLocalViewPlayer()

	player.EndSignal( "OnDestroy" )
	spawnHolo.EndSignal( "OnDestroy" )

	vector loc = spawnHolo.GetOrigin() + < 0,0,85 >
	vector ang = VectorToAngles( Normalize( loc - player.EyePosition() ) )

	
	
	

	int spawnHoloHandle = spawnHolo.GetEncodedEHandle()

	const int timerPixels = 280
	var topo 	= CL_HoverVehicle_AutoRespawn_CountdownTimer_Topo_Get( spawnHoloHandle )
	var rui 	= CL_HoverVehicle_AutoRespawn_CountdownTimer_Rui_Get( spawnHoloHandle, topo )
	UpdateRUITopologyPos_Worldspace( topo, loc, ang, timerPixels, timerPixels )

	OnThreadEnd(
		function () : ( spawnHoloHandle, topo )
		{
			CL_HoverVehicle_AutoRespawn_CountdownTimer_Rui_Destroy( spawnHoloHandle, topo )
		}
	)

	float startTime = ClientTime()
	float endTime 	= startTime + tunings_Shared.autoRespawn_Delay

	RuiSetFloat( rui, "respawnDuration", tunings_Shared.autoRespawn_Delay )
	RuiSetGameTime( rui, "endTime", endTime )

	const float TIMESLICE = 0.025
	while( IsValid( spawnHolo ) && IsValid( player ) && ( ClientTime() < endTime ) )
	{
		
		
		
		ang = VectorToAngles( Normalize( loc - player.EyePosition() ) )
		UpdateRUITopologyPos_Worldspace( topo, loc, ang, timerPixels, timerPixels )

		wait( TIMESLICE )
	}
}

var function CL_HoverVehicle_AutoRespawn_CountdownTimer_Topo_Get( int spawnPtHandle )
{
	if( !( spawnPtHandle in file.autoRespawnTopos_BySpawnspawnPtHandles ) )
	{
		var topo = CreateRUITopology_Worldspace( ZERO_VECTOR, ZERO_VECTOR, 95, 95 )
		file.autoRespawnTopos_BySpawnspawnPtHandles[ spawnPtHandle ] <- topo
	}
	return file.autoRespawnTopos_BySpawnspawnPtHandles[ spawnPtHandle ]
}

var function CL_HoverVehicle_AutoRespawn_CountdownTimer_Rui_Get( int spawnPtHandle, var topo )
{
	if( !( spawnPtHandle in file.autoRespawnRuis_BySpawnspawnPtHandles ) )
	{
		
		var rui = RuiCreate( $"ui/hover_vehicle_respawn_timer.rpak", topo, RUI_DRAW_WORLD, 0 )
		file.autoRespawnRuis_BySpawnspawnPtHandles[ spawnPtHandle ] <- rui
	}
	return file.autoRespawnRuis_BySpawnspawnPtHandles[ spawnPtHandle ]
}

void function CL_HoverVehicle_AutoRespawn_CountdownTimer_Rui_Destroy( int spawnPtHandle, var topo )
{
	var rui = CL_HoverVehicle_AutoRespawn_CountdownTimer_Rui_Get( spawnPtHandle, topo )

	RuiDestroyIfAlive( rui )
	delete file.autoRespawnRuis_BySpawnspawnPtHandles[ spawnPtHandle ]
}
























































































































































































void function HoverVehicle_SV2CL_ParkedIcon_Create( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return

	EHI vehicleEHI = ToEHI( vehicle )
	if( file.vehicleEHIs_WithParkedIcons.contains( vehicleEHI ) )
		return

	thread CL_ParkedIcon_Think_Thread( vehicle )
	file.vehicleEHIs_WithParkedIcons.append( vehicleEHI )
}

void function HoverVehicle_SV2CL_ParkedIcon_Destroy( entity vehicle )
{
	EHI vehicleEHI = ToEHI( vehicle )
	if( !file.vehicleEHIs_WithParkedIcons.contains( vehicleEHI ) )
		return

	vehicle.Signal( SIG_HOVERVEHICLE_PARKEDICON ) 
}

void function CL_ParkedIcon_Think_Thread( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return

	if( !EntIsHoverVehicle( vehicle ) )
		return

	vehicle.Signal( SIG_HOVERVEHICLE_PARKEDICON )
	vehicle.EndSignal( SIG_HOVERVEHICLE_PARKEDICON )
	vehicle.EndSignal( "OnDestroy" )

	vector loc = vehicle.GetOrigin()
	vector ang = FlattenVec( vehicle.GetAngles() )
	vector iconColor = COLOR_DARK_GRAY

	const float SCALE_MINIMAP = 1.2
	const float SCALE_FULLMAP = 12

	var minimapRui = Minimap_AddIconAtPosition	( loc, ang, HOVER_VEHICLE_SPAWNPOINT_ICON, 	SCALE_MINIMAP, iconColor )
	var fullmapRui = FullMap_AddIconAtPos		( loc, ang + < 0, -90, 0 >, HOVER_VEHICLE_SPAWNPOINT_ICON,	SCALE_FULLMAP, iconColor )

	OnThreadEnd(
		function(): ( vehicle, minimapRui, fullmapRui )
		{
			Minimap_CommonCleanup( minimapRui )
			Fullmap_RemoveRui( fullmapRui )
			RuiDestroy( fullmapRui )

			EHI vehicleEHI = ToEHI( vehicle )
			file.vehicleEHIs_WithParkedIcons.fastremovebyvalue( vehicleEHI )
		}
	)

	
	
	
	

	WaitForever()
}

























 





























































































































#if DEV
void function DevOut( string printMe )
{
	if( !file.devOut )
		return

	printt( ":>>" + printMe )
}

void function DevOut_DamageSourceId( int damageSrc )
{
	if( !file.devDmg )
		return

	string damageSource = GetEnumStringSlow( eDamageSourceId, damageSrc )

	float timeDelta = Time() - file.devDmg_LastTime
	if( timeDelta < file.devDmg_Debounce )
		return

	DevOut( "Damage Source == " + damageSource )
	file.devDmg_LastTime = Time()
}

#endif
