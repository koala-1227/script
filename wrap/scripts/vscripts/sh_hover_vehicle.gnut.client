void function Tunings_Shared_PLV_Set()
{
	
	tunings_Shared.cvar_Camera_Yaw_Spring_Enabled			= GetCurrentPlaylistVarBool( "hoverveh_camera_yaw_spring_enabled", 			tunings_Shared_Default.cvar_Camera_Yaw_Spring_Enabled )
	tunings_Shared.cvar_Camera_Yaw_NoSpring_SmoothTime		= GetCurrentPlaylistVarFloat( "hoverveh_camera_yaw_nospring_smoothtime", 	tunings_Shared_Default.cvar_Camera_Yaw_NoSpring_SmoothTime )
	tunings_Shared.cvar_Camera_Yaw_NoSpring_SmoothTime_Boosting		= GetCurrentPlaylistVarFloat( "hoverveh_camera_yaw_nospring_smoothtime_boosting", 	tunings_Shared_Default.cvar_Camera_Yaw_NoSpring_SmoothTime_Boosting )

	
	tunings_Shared.cvar_camera_offset_height_base		= GetCurrentPlaylistVarFloat( "hoverveh_camera_offset_height_base", 		tunings_Shared_Default.cvar_camera_offset_height_base )
	tunings_Shared.cvar_camera_offset_height_speedDelta = GetCurrentPlaylistVarFloat( "hoverveh_camera_offset_height_speeddelta", 	tunings_Shared_Default.cvar_camera_offset_height_speedDelta )
	tunings_Shared.cvar_camera_smooth_rate				= GetCurrentPlaylistVarFloat( "hoverveh_camera_smooth_rate", 				tunings_Shared_Default.cvar_camera_smooth_rate )
	tunings_Shared.cvar_reset_camera_while_embarking	= GetCurrentPlaylistVarBool( "hover_vehicle_reset_camera_while_embarking", 	tunings_Shared_Default.cvar_reset_camera_while_embarking )

	
	tunings_Shared.cvar_Boost_On_Hold					= GetCurrentPlaylistVarBool	( "hoverveh_boost_on_hold", 	tunings_Shared_Default.cvar_Boost_On_Hold )
	tunings_Shared.cvar_hover_vehicle_boost_style 		= GetCurrentPlaylistVarInt	( "hover_vehicle_boost_style", 	tunings_Shared_Default.cvar_hover_vehicle_boost_style )

	
	tunings_Shared.cvar_Air_Brake_Style = GetCurrentPlaylistVarInt( "hoverveh_air_brake_style",	tunings_Shared_Default.cvar_Air_Brake_Style )

	
	tunings_Shared.cvar_Health_Start_On	= GetCurrentPlaylistVarBool( "hoverveh_health_start_on", 	tunings_Shared_Default.cvar_Health_Start_On )

	
	tunings_Shared.cvar_Eject_Enabled	= GetCurrentPlaylistVarBool( "hoverveh_eject_enabled", tunings_Shared_Default.cvar_Eject_Enabled )
	tunings_Shared.cvar_Smoke_Enabled	= GetCurrentPlaylistVarBool( "hoverveh_smoke_enabled", tunings_Shared_Default.cvar_Smoke_Enabled )

	
	tunings_Shared.autoRespawn_Enabled 	= GetCurrentPlaylistVarBool( "hoverveh_autorespawn_enabled", tunings_Shared_Default.autoRespawn_Enabled )
	tunings_Shared.autoRespawn_Delay	= GetCurrentPlaylistVarFloat( "hoverveh_autorespawn_delay",  tunings_Shared_Default.autoRespawn_Delay )

	
	tunings_Shared.damagePropagation_Enabled = GetCurrentPlaylistVarBool( "hoverveh_damagepropagation_enabled", tunings_Shared_Default.damagePropagation_Enabled )

	
	tunings_Shared.vo_VehicleDamaged_Enabled = GetCurrentPlaylistVarBool( "hoverveh_vo_vehicledamaged_enabled", tunings_Shared_Default.vo_VehicleDamaged_Enabled )


		if( HoverVehicle_Rework_Enabled() )
		{
			tunings_Shared.cvar_hover_vehicle_glide_type 			= GetCurrentPlaylistVarInt( "hover_vehicle_glide_type", 			tunings_Shared_Default.cvar_hover_vehicle_glide_type )
			tunings_Shared.cvar_hover_vehicle_glide_debounce 		= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_debounce", 		tunings_Shared_Default.cvar_hover_vehicle_glide_debounce )
			tunings_Shared.cvar_hover_vehicle_glide_thrust_speed	= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_thrust_speed", 	tunings_Shared_Default.cvar_hover_vehicle_glide_thrust_speed )
			tunings_Shared.cvar_hover_vehicle_glide_descent_speed 	= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_descent_speed", 	tunings_Shared_Default.cvar_hover_vehicle_glide_descent_speed )
			tunings_Shared.cvar_hover_vehicle_glide_when_ascending 	= GetCurrentPlaylistVarBool( "hover_vehicle_glide_when_ascending", 	tunings_Shared_Default.cvar_hover_vehicle_glide_when_ascending )
			tunings_Shared.cvar_hover_vehicle_glide_max_thrust		= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_max_thrust", 	tunings_Shared_Default.cvar_hover_vehicle_glide_max_thrust )
			tunings_Shared.cvar_hover_vehicle_glide_min_thrust		= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_min_thrust", 	tunings_Shared_Default.cvar_hover_vehicle_glide_min_thrust )
			tunings_Shared.cvar_hover_vehicle_glide_to_min_thrust_duration	= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_to_min_thrust_duration", tunings_Shared_Default.cvar_hover_vehicle_glide_to_min_thrust_duration )
			tunings_Shared.cvar_hover_vehicle_glide_air_accel		= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_air_accel", 		tunings_Shared_Default.cvar_hover_vehicle_glide_air_accel )
			tunings_Shared.cvar_hover_vehicle_glide_tightness_up	= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_tightness_up", 	tunings_Shared_Default.cvar_hover_vehicle_glide_tightness_up )
			tunings_Shared.cvar_hover_vehicle_glide_tightness_down	= GetCurrentPlaylistVarFloat( "hover_vehicle_glide_tightness_down", tunings_Shared_Default.cvar_hover_vehicle_glide_tightness_down )
			tunings_Shared.cvar_hover_vehicle_glide_max_duration	= GetCurrentPlaylistVarFloat( "hover_vehicle_hold_to_glide", 		tunings_Shared_Default.cvar_hover_vehicle_glide_max_duration )
		}

	tunings_Shared.cvar_hover_vehicle_hover_height = GetCurrentPlaylistVarFloat( "hover_vehicle_hover_height", tunings_Shared_Default.cvar_hover_vehicle_hover_height )
}

void function Tunings_Vehicle_Setup_From_PLV_And_Defaults( sTunings_HoverVehicle tunings, sTunings_HoverVehicle defaults, int vehicleType )
{
	



	string vehName = file.hoverVehicleNames_ByType[ vehicleType ]

	tunings.vehicleType = vehicleType

	
	tunings.maxSpeed_Strafe 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_maxspeed_strafe", 	defaults.maxSpeed_Strafe )
	tunings.maxSpeed_Forward 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_maxspeed_forward", 	defaults.maxSpeed_Forward )
	tunings.maxSpeed_Reverse 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_maxspeed_reverse", 	defaults.maxSpeed_Reverse )

	tunings.accel_Strafe			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_accel_strafe", 	defaults.accel_Strafe )
	tunings.accel_Forward		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_accel_forward", 	defaults.maxSpeed_Forward )
	tunings.accel_Reverse		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_accel_Reverse", 	defaults.accel_Reverse )

	tunings.decel_Strafe			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_decel_strafe", 	defaults.decel_Strafe )
	tunings.decel_Forward		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_decel_forward", 	defaults.decel_Forward )
	tunings.decel_Reverse		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_decel_Reverse", 	defaults.decel_Reverse )

	tunings.accel_air			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_acceleration_air", 	defaults.accel_air )
	tunings.decel_PowerBrake		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_decel_powerbrake", defaults.decel_PowerBrake )

	
	tunings.boostMinSpeed 		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_boost_min_speed", 	defaults.boostMinSpeed )
	tunings.boostMaxSpeed 		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_boost_max_speed", 	defaults.boostMaxSpeed )
	tunings.boostCooldown 		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_boost_cooldown", 	defaults.boostCooldown )
	tunings.boostDuration		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_boost_duration", 	defaults.boostDuration )
	tunings.defaultHealth 		= GetCurrentPlaylistVarInt( "hoverveh_" + vehName + "_health", 				defaults.defaultHealth )

	
	tunings.jumpSpeed			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_jumpspeed", 		defaults.jumpSpeed )
	tunings.jumpDebounce			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_jumpdebounce", 	defaults.jumpDebounce )
	tunings.jumpBoostCost		= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_jumpboostcost", 	defaults.jumpBoostCost )

	
	tunings.collision_Player_Damage						= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collision_player_damage", 		defaults.collision_Player_Damage )
	tunings.collision_Player_PushAway_Speed_Threshold 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collision_player_pushaway_speed_threshold", defaults.collision_Player_PushAway_Speed_Threshold )
	tunings.collision_Requires_Boost = GetCurrentPlaylistVarBool( "hoverveh_" + vehName + "_collision_requires_boost", 	defaults.collision_Requires_Boost )
	tunings.speedBasedCollisionDamage_Enabled 		= GetCurrentPlaylistVarBool( "hoverveh_" + vehName + "_speedbasedcollisiondamage_enabled", 		defaults.speedBasedCollisionDamage_Enabled )
	tunings.speedBasedCollisionDamage_Speed_Min 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_speedbasedcollisiondamage_speed_min", 	defaults.speedBasedCollisionDamage_Speed_Min )
	tunings.speedBasedCollisionDamage_Speed_Max 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_speedbasedcollisiondamage_speed_max", 	defaults.speedBasedCollisionDamage_Speed_Max )
	tunings.speedBasedCollisionDamage_Damage_Min 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_speedbasedcollisiondamage_damage_min", defaults.speedBasedCollisionDamage_Damage_Min )
	tunings.speedBasedCollisionDamage_Damage_Max 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_speedbasedcollisiondamage_damage_max", defaults.speedBasedCollisionDamage_Damage_Max )

	

		tunings.doorRams_SpecialDamage_Enabled	= GetCurrentPlaylistVarBool	( "hoverveh_" + vehName + "_doorrams_specialdamage_enabled", defaults.doorRams_SpecialDamage_Enabled )
		tunings.doorRams_Needed					= GetCurrentPlaylistVarInt	( "hoverveh_" + vehName + "_doorrams_needed", 			defaults.doorRams_Needed )
		tunings.doorRams_Needed_Enforced		= GetCurrentPlaylistVarInt	( "hoverveh_" + vehName + "_doorrams_needed_enforced", 	defaults.doorRams_Needed_Enforced )
		tunings.doorRams_Debounce				= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_doorrams_debounce", 		defaults.doorRams_Debounce )


	tunings.collisionDamage_Factor_vsDestructibles 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collisiondamage_factor_vsdestructibles", defaults.collisionDamage_Factor_vsDestructibles )
	tunings.collisionDamage_Factor_vsLegendObjects 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collisiondamage_factor_vslegendobjects", defaults.collisionDamage_Factor_vsLegendObjects )
	tunings.collisionDamage_Factor_vsOtherVehicles 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collisiondamage_factor_vsothervehicles", defaults.collisionDamage_Factor_vsOtherVehicles )
	tunings.collisionDamage_Factor_vsNPCs = GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_collisiondamage_factor_vsnpcs", defaults.collisionDamage_Factor_vsNPCs )

	
	tunings.hasTurret = GetCurrentPlaylistVarBool( "hoverveh_" + vehName + "_has_turret", defaults.hasTurret )

	
	tunings.healthRegen_Enabled 			= GetCurrentPlaylistVarBool	( "hoverveh_" + vehName + "_healthregen_enabled", 			defaults.healthRegen_Enabled )
	tunings.healthRegen_NoDamageDuration 	= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_healthregen_nodamageduration", 	defaults.healthRegen_NoDamageDuration )
	tunings.healthRegen_TimePeriod			= GetCurrentPlaylistVarFloat( "hoverveh_" + vehName + "_healthregen_timeperiod", 		defaults.healthRegen_TimePeriod )
	tunings.healthRegen_Amount				= GetCurrentPlaylistVarInt	( "hoverveh_" + vehName + "_healthregen_amount", 			defaults.healthRegen_Amount )

	
	tunings.showSpawnBeam 			= GetCurrentPlaylistVarBool( "hoverveh_show_beam", 			defaults.showSpawnBeam )
	tunings.showSpawnMinimapIcon 	= GetCurrentPlaylistVarBool( "hoverveh_show_minimap_icon", 	defaults.showSpawnMinimapIcon )

	tunings.skinVariantName 		= GetCurrentPlaylistVarString( "hoverveh_" + vehName + "_skinvariantname", defaults.skinVariantName )

	
	tunings.vehModel = defaults.vehModel
}




































































void function VehicleTunings_ByType_Set( int vehicleType, sTunings_HoverVehicle tunings )
{
	file.hoverVehTunings_ByType[ vehicleType ] <- tunings
}

sTunings_HoverVehicle function VehicleTunings_ByType_Get( int vehicleType )
{
	sTunings_HoverVehicle result
	if( vehicleType in file.hoverVehTunings_ByType )
	{
		result = file.hoverVehTunings_ByType[ vehicleType ]
	}
	return result
}





















































