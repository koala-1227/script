#if DEV
void function DEV_HoverVehicle_DamageStates_Print()
{
	foreach( vehicle, damageStateNDX in file.vehicleDamageState )
	{
		printt( "vehicle " + vehicle + " damage state index == " + damageStateNDX )
	}
}
#endif

void function CL_DamageStateTracking_Think_Thread( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return

	if( !EntIsHoverVehicle( vehicle ) )
		return

	vehicle.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function ():( vehicle )
		{
			if( vehicle in file.vehicleDamageState )
			{
				delete file.vehicleDamageState[ vehicle ]
			}
		}
	)

	const DAMAGESTATE_CHECK_PERIOD = 0.2
	while( true )
	{
		if ( vehicle.GetHealth() == vehicle.GetMaxHealth() )
			wait 2

		CL_DamageStateTracking_Update( vehicle )
		wait( DAMAGESTATE_CHECK_PERIOD )
	}
}

void function CL_DamageStateTracking_Update( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return

	int prevDamageState = CL_DamageStateTracking_Get( vehicle )
	int damageState		= CL_DamageStateTracking_Calculate( vehicle )

	bool isDamaging
	if( damageState != prevDamageState )
	{
		if( damageState < prevDamageState ) 
		{
#if DEV
				printt( "Vehicle " + vehicle + " healed to damage state:" + damageState )
#endif
			switch( damageState )
			{
				case eDamageStates.DAMAGESTATE_0:
					
					vehicle.Signal( SIG_HOVERVEHICLE_ALARM_OFF )
					break
				case eDamageStates.DAMAGESTATE_1:
					
					vehicle.Signal( SIG_HOVERVEHICLE_ALARM_OFF )
					break
				case eDamageStates.DAMAGESTATE_2:
					
					vehicle.Signal( SIG_HOVERVEHICLE_ALARM_OFF )
					break
				default:
					break
			}
			isDamaging = false
		}
		else 
		{
#if DEV
				printt( "Vehicle " + vehicle + " damaged to damage state:" + damageState )
#endif
			switch( damageState )
			{
				case eDamageStates.DAMAGESTATE_0:
					
					break
				case eDamageStates.DAMAGESTATE_1:
					
					break
				case eDamageStates.DAMAGESTATE_2:
					
					break
				case eDamageStates.DAMAGESTATE_3:
					
					thread CL_DamageState_3_Alarm_Think_Thread( vehicle )
					break
				default:
					break
			}
			isDamaging = true
		}
		CL_DamageStateTracking_Set( vehicle, damageState )
		CL_DamageStateFX_Update( vehicle, damageState, isDamaging )
	}
}

int function CL_DamageStateTracking_Calculate( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return eDamageStates.DAMAGESTATE_0

	float healthFrac = GetHealthFrac( vehicle )

	if( healthFrac > HOVERVEHICLE_DAMAGE_THRESHOLD_1 )
		return eDamageStates.DAMAGESTATE_0

	if( healthFrac > HOVERVEHICLE_DAMAGE_THRESHOLD_2 )
		return eDamageStates.DAMAGESTATE_1

	if( healthFrac > HOVERVEHICLE_DAMAGE_THRESHOLD_3 )
		return eDamageStates.DAMAGESTATE_2

	return eDamageStates.DAMAGESTATE_3
}

void function CL_DamageStateTracking_Set( entity vehicle, int damageState )
{
	file.vehicleDamageState[ vehicle ] <- damageState
}

int function CL_DamageStateTracking_Get( entity vehicle )
{
	if( !( vehicle in file.vehicleDamageState ) )
	{
		file.vehicleDamageState[ vehicle ] <- eDamageStates.DAMAGESTATE_0
	}

	return( file.vehicleDamageState[ vehicle ] )
}

void function CL_DamageState_3_Alarm_Think_Thread( entity vehicle )
{
	if( !IsValid( vehicle ) )
		return

	vehicle.EndSignal( "OnDestroy" )
	vehicle.EndSignal( SIG_HOVERVEHICLE_ALARM_OFF )

	OnThreadEnd(
		function() : ( vehicle )
		{
			if( IsValid( vehicle ) )
			{
				StopSoundOnEntity( vehicle, "HoverVehicle_Alarm" )
			}
		}
	)

	entity player = GetLocalViewPlayer()
	if( vehicle.IsPlayerInVehicle( player ) && tunings_Shared.vo_VehicleDamaged_Enabled )
	{
		Remote_ServerCallFunction( FUNC_VO_TRIDENTDAMAGED, vehicle )
	}

	const ALARMSOUND_DURATION = 20.0
	float healthFrac = GetHealthFrac( vehicle )
	while( IsValid( vehicle ) )
	{
		EmitSoundOnEntity( vehicle, "HoverVehicle_Alarm" )
		wait ALARMSOUND_DURATION
		healthFrac = GetHealthFrac( vehicle )
	}
}

void function CL_DamageStateFX_Update( entity vehicle, int newDamageState, bool isDamage )
{
	



	if( !IsValid( vehicle ) )
		return

	if( !isDamage )
	{
		CL_FX_Vehicle_HealShine( vehicle )
	}
	else
	{
		
	}

	switch( newDamageState )
	{
		case eDamageStates.DAMAGESTATE_3:
			ModelFX_EnableGroup( vehicle, "hover_damagestate_3" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_2" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_2" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_2" )
			EmitSoundOnEntity( vehicle, "HoverVehicle_DamageState_3" )
			break
		case eDamageStates.DAMAGESTATE_2:
			ModelFX_DisableGroup( vehicle, "hover_damagestate_3" )
			ModelFX_EnableGroup( vehicle, "hover_damagestate_2" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_1" )
			string soundPlay = isDamage ? "HoverVehicle_DamageState_2" : "HoverVehicle_DamageState_Heal_2"
			EmitSoundOnEntity( vehicle, soundPlay )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_3" )
			break
		case eDamageStates.DAMAGESTATE_1:
			ModelFX_DisableGroup( vehicle, "hover_damagestate_3" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_2" )
			ModelFX_EnableGroup( vehicle, "hover_damagestate_1" )
			string soundPlay = isDamage ? "HoverVehicle_DamageState_1" : "HoverVehicle_DamageState_Heal_1"
			EmitSoundOnEntity( vehicle, soundPlay )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_2" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_2" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_3" )
			break
		default:
			ModelFX_DisableGroup( vehicle, "hover_damagestate_3" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_2" )
			ModelFX_DisableGroup( vehicle, "hover_damagestate_1" )
			EmitSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_0" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_1" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_2" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_Heal_2" )
			StopSoundOnEntity( vehicle, "HoverVehicle_DamageState_3" )
			break
	}
}

