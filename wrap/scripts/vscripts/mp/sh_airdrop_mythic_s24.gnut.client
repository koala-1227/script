bool function GetPlaylistVar_AirdropMythicS24Enabled()
{
	return GetCurrentPlaylistVarBool( "airdrop_mythic_s24_enabled", false )
}

bool function GetPlaylistVar_AirdropMythicS24MapFeature()
{
	return GetCurrentPlaylistVarBool( "airdrop_mythic_s24_map_feature", false ) && GetPlaylistVar_AirdropMythicS24Enabled()
}

bool function GetPlaylistVar_AirdropMythicS24MapIncoming()
{
	return GetCurrentPlaylistVarBool( "airdrop_mythic_s24_map_incoming", true )
}

string function GetPlaylistVar_AirdropMythicS24Anims()
{
	return GetCurrentPlaylistVarString( "airdrop_mythic_s24_anims", "-1" )
}

bool function GetPlaylistVar_AirdropMythicS24AnimDebug()
{
	return GetCurrentPlaylistVarBool( "airdrop_mythic_s24_anim_debug", false )
}

int function GetPlaylistVar_AirdropMythicS24AnimTriggerRadius()
{
	return GetCurrentPlaylistVarInt( "airdrop_mythic_s24_trigger_radius", 1024 )
}

int function GetPlaylistVar_AirdropMythicS24AnimTriggerHeight()
{
	return GetCurrentPlaylistVarInt( "airdrop_mythic_s24_trigger_height", 1024 )
