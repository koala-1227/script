void function ServerToClient_AirdropMythicS24_Announcement()
{
	vector rampartColorMain = ColorPalette_GetColorFromID( COLORID_AIRDROP_RAMPART_COLOR ) / 255.0
	vector rampartColorDark = rampartColorMain * 0.3

	CenterAnnouncementItem paintBanner = CenterAnnouncements_CreateNotchedStyle()
	paintBanner.mainText = Localize( "#UNHINGED_ANNOUNCE_RAMPART_CARE_PACKAGE_TITLE" )
	paintBanner.frameColor = rampartColorMain
	paintBanner.textureColor = rampartColorMain
	paintBanner.textureAlpha = 0.6
	paintBanner.backgroundColor = rampartColorDark
	paintBanner.imageContainerFrameColor = rampartColorMain
	paintBanner.imageContainerMaskColor = rampartColorDark
	paintBanner.priority = eHudNotificationQueuePriority.LOW
	paintBanner.mainIcon1 = $"rui/hud/loot/rampart_logo"
	paintBanner.mainIcon1Color = rampartColorMain
	paintBanner.leftTexture = $"rui/hud/splash/splash_rampart_paint"
	paintBanner.rightTexture = $"rui/hud/splash/splash_rampart_paint"
	paintBanner.imageContainerHeight = 70.0
	paintBanner.paddingBottom = 5.0

	CenterAnnouncementItem paintSubBanner = CenterAnnouncements_CreateGradientStyle()
	paintSubBanner.mainText = Localize( "#UNHINGED_ANNOUNCE_RAMPART_CARE_PACKAGE_DESC_M27" )
	paintSubBanner.scalar = 0.8
	paintSubBanner.mainTextIsUpper = false
	paintSubBanner.mainTextFontFace = HEADER_FONT
	paintSubBanner.paddingTop = 5.0

	AnnouncementBuilder paintBuilder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ paintBanner, paintSubBanner ] )
	paintBuilder.priority = eHudNotificationQueuePriority.LOW

	CenterAnnouncements_QueueBuilder( paintBuilder, ePersistenceContext.PLAYER )

}


