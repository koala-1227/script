void function Sh_AirdropMythicS24_Init()
{
	if ( !GetPlaylistVar_AirdropMythicS24Enabled() )
		return

	PrecacheScriptString( SCRIPTNAME_DROPPOD_RAMPART_ICON )
























	RegisterSignal( SIG_DROPPOD_RAMPART_MARKER_DESTROY )

	if ( GetPlaylistVar_AirdropMythicS24MapFeature() )
	{
		SetMapFeatureItem( 500, Localize( "#AIRDROP_MYTHIC_S24_MAP_FEATURE_TITLE" ), Localize( "#AIRDROP_MYTHIC_S24_MAP_FEATURE_DESC" ), ICON_DROPPOD_RAMPART_LARGE )
	}


	Remote_RegisterClientFunction( "ServerToClient_AirdropMythicS24_Announcement" )

	Sh_AirdropMythicS24_RegisterWPObjective()
}


