void function Sh_AirdropMythicS24_RegisterWPObjective()
{
	WPObjective_Settings settings
	settings.scriptName = SCRIPTNAME_DROPPOD_RAMPART_ICON

	settings.enumWaypoint = eWaypoint.AIRDROP_RAMPART
	settings.enumPingType = ePingType.AIRDROP_MYTHIC_S24
	settings.enumCommsAction = eCommsAction.PING_AIRDROP_MYTHIC_S24
	settings.enumMinimapObject_prop_script = eMinimapObject_prop_script.MYTHIC_S24

	settings.iconInWorld = ICON_DROPPOD_RAMPART_LARGE
	settings.iconMap = ICON_DROPPOD_RAMPART_LARGE

	settings.worldIconPingDistance = 3000.0
	settings.worldIconMinAlphaDistance = 3000.0
	settings.worldIconMaxAlphaDistance = 3500.0

	settings.pingText = "#AIRDROP_MYTHIC_S24_MAP_FEATURE_TITLE"

	WPObjective_Register( settings )
}




























