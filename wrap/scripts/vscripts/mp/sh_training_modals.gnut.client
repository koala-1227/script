void function EnableTutorialThreads( bool enable )
{
	if ( enable )
	{
		thread Client_PlayerStateThread()
		thread TutorialModalProcessQueueThread()
		file.tutorialEnabled = true
	}
	else
	{
		entity player = GetLocalClientPlayer()
		if ( IsValid( player ) )
			Signal( player, "EndTutorialThreads" )
		file.tutorialEnabled = false
		file.tutorialModalsQueue.clear()
	}
}

void function OnPlayerConnectionStateChanged( entity player )
{
	if ( IsValid( player ) && player == GetLocalClientPlayer() )
	{
		
		if ( player.IsConnectionActive() )
		{
			
			file.tutorialPlayerSettings = GetConVarInt( "player_setting_tutorialization" )
			if ( file.tutorialPlayerSettings == eTutorialPlayerSettings.ON || ( file.tutorialPlayerSettings == eTutorialPlayerSettings.AUTO  && !IsTutorialAccountLevelDisabled() ) )
			{
				if ( GetCurrentPlaylistVarBool( "tutorial_modals_enabled_new_player_only", false ) )
				{
					if ( NewPlayerMatchMaking_IsInMatchMakingFlow( GetLocalClientPlayer() ) )
					{
						EnableTutorialThreads( true )
					}
				}
				else
				{
					EnableTutorialThreads( true )
				}
			}
			else
			{
				EnableTutorialThreads( false )
			}
		}
	}
}


int function ConvertStateStringToEnum( string state )
{
	switch ( state )
	{
		case "low_primary" :
			return ePlayerStatusEnum.LOW_PRIMARY
			break
		case "low_seconary" :
			return ePlayerStatusEnum.LOW_SECONDARY
			break
		case "low_light_ammo" :
			return ePlayerStatusEnum.LOW_LIGHT_AMMO
			break
		case "low_heavy_ammo" :
			return ePlayerStatusEnum.LOW_HEAVY_AMMO
			break
		case "low_energy_ammo" :
			return ePlayerStatusEnum.LOW_ENERGY_AMMO
			break
		case "low_sniper_ammo" :
			return ePlayerStatusEnum.LOW_SNIPER_AMMO
			break
		case "low_shotgun_ammo" :
			return ePlayerStatusEnum.LOW_SHOTGUN_AMMO
			break
		case "low_health" :
			return ePlayerStatusEnum.LOW_HEALTH
			break
		case "low_shields" :
			return ePlayerStatusEnum.LOW_SHIELDS
			break
		case "in_combat" :
			return ePlayerStatusEnum.IN_COMBAT
			break
		case "tac_charged" :
			return ePlayerStatusEnum.TACTICAL_RECHARGED
			break
		case "ult_charged" :
			return ePlayerStatusEnum.ULTIMATE_RECHARGED
			break
		case "taking_damage" :
			return ePlayerStatusEnum.TAKING_DAMAGE
			break
		case "in_ads" :
			return ePlayerStatusEnum.IN_ADS
			break
		case "ordinance_equipped" :
			return ePlayerStatusEnum.ORDINANCE_EQUIPPED
			break
		case "in_air" :
			return ePlayerStatusEnum.IN_AIR
			break
		case "running" :
			return ePlayerStatusEnum.RUNNING
			break
		case "sky_diving" :
			return ePlayerStatusEnum.SKY_DIVING
			break
		case "weapons_holstered" :
			return ePlayerStatusEnum.WEAPONS_HOLSTERED
			break
		case "teammate_downed" :
			return ePlayerStatusEnum.TEAMMATE_DOWNED
			break
		case "out_of_ring" :
			return ePlayerStatusEnum.OUT_OF_RING
			break
		case "in_dropship" :
			return ePlayerStatusEnum.IN_DROPSHIP
			break
		case "weapon_equipped" :
			return ePlayerStatusEnum.WEAPON_EQUIPPED
			break
		case "player_downed" :
			return ePlayerStatusEnum.PLAYER_DOWNED
			break
		default:
			Assert( false, "[ConvertStateStringToEnum] Invalid state string passed: " + state )
			return -INT_MAX
	}

	unreachable
}


void function Client_PlayerStateThread()
{
	entity player = GetLocalClientPlayer()
	EndSignal( player,  "OnDestroy", "EndTutorialThreads" )
	int previousFrameHealthTotal = 0

	while ( !player.GetPlayerNetBool( "playerInPlane" ) && !file.hasTouchedGrass )
		WaitFrame()

	while ( true )
	{
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_LIGHT_AMMO )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_HEAVY_AMMO )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_ENERGY_AMMO )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SNIPER_AMMO )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SHOTGUN_AMMO )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SECONDARY )
		file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_PRIMARY )


		entity weaponInSlot0 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
		entity weaponInSlot1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
		entity mainHandWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

		int weaponAmmoSlot0Flag = ePlayerStatusEnum.LOW_SECONDARY
		int weaponAmmoSlot1Flag = ePlayerStatusEnum.LOW_SECONDARY
		if ( IsValid (mainHandWeapon) && IsValid ( weaponInSlot0 ) && mainHandWeapon == weaponInSlot0 )
		{
			weaponAmmoSlot0Flag = ePlayerStatusEnum.LOW_PRIMARY
		}
		else if ( IsValid (mainHandWeapon) && IsValid ( weaponAmmoSlot1Flag ) && mainHandWeapon == weaponInSlot1  )
		{
			weaponAmmoSlot1Flag = ePlayerStatusEnum.LOW_PRIMARY
		}

		if ( IsValid ( weaponInSlot0 ) )
		{
			LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weaponInSlot0 )
			string weaponRef = weaponData.baseWeapon
			if ( weaponRef != "" && bool ( GetWeaponInfoFileKeyField_Global( weaponRef, "uses_ammo_pool" ) ) )
			{
				if ( SURVIVAL_Loot_IsRefValid( weaponData.ammoType ) && SURVIVAL_CountItemsInInventory( player, weaponData.ammoType ) == 0 )
				{
					file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, weaponAmmoSlot0Flag )
					switch ( weaponData.ammoType )
					{
						case BULLET_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_LIGHT_AMMO )
							break
						case HIGHCAL_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_HEAVY_AMMO )
							break
						case SHOTGUN_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SHOTGUN_AMMO )
							break
						case SPECIAL_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_ENERGY_AMMO )
							break
						case SNIPER_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SNIPER_AMMO )
							break
						default:
							break
					}
				}
			}
		}

		if ( IsValid ( weaponInSlot1 ) )
		{
			LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weaponInSlot1 )
			string weaponRef = weaponData.baseWeapon
			if ( weaponRef != "" && bool ( GetWeaponInfoFileKeyField_Global( weaponRef, "uses_ammo_pool" ) ) )
			{
				if ( SURVIVAL_CountItemsInInventory( player, weaponData.ammoType ) == 0 )
				{
					file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, weaponAmmoSlot1Flag )
					switch ( weaponData.ammoType )
					{
						case BULLET_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_LIGHT_AMMO )
							break
						case HIGHCAL_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_HEAVY_AMMO )
							break
						case SHOTGUN_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SHOTGUN_AMMO )
							break
						case SPECIAL_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_ENERGY_AMMO )
							break
						case SNIPER_AMMO:
							file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SNIPER_AMMO )
							break
						default:
							break
					}
				}
			}
		}

		if ( player.GetHealth() <  ( 0.60 * player.GetMaxHealth() ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_HEALTH )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_HEALTH )
		}

		int armorTier = UpgradeCore_GetPlayerArmorTier( player )
		int shieldMaxHealthForTier = EvolvingArmor_GetCharacterShieldHealthMaxForArmorTier( player, armorTier )
		float regenAmt = ceil( StatusEffect_GetTotalSeverity( player, eStatusEffect.target_shields ) * float(player.GetShieldHealthMax()) )
		if ( player.GetShieldHealth() + regenAmt < shieldMaxHealthForTier && player.GetShieldHealthMax() > 0 )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SHIELDS )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.LOW_SHIELDS )
		}

		if ( PlayerIsInCombat( player ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_COMBAT )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_COMBAT )
		}

		entity ult = player.GetOffhandWeapon( eOffhandInv.ULTIMATE )

		if ( IsValid( ult ) )
		{
			int ammo = ult.GetWeaponPrimaryClipCount()
			int maxAmmo =ult.GetWeaponPrimaryClipCountMax()
			float frac = clamp( (float( ammo ) / float( maxAmmo )), 0.0, 1.0 )
			int burstCount = maxint( ult.GetWeaponSettingInt( eWeaponVar.burst_fire_count ), 1 )
			int minReq = ult.GetWeaponSettingInt( eWeaponVar.ammo_min_to_fire ) * burstCount

			if ( ammo >= minReq )
			{
				file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.ULTIMATE_RECHARGED )
			}
			else
			{
				file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.ULTIMATE_RECHARGED )
			}
		}

		if ( player.Player_IsSkydiving() )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.SKY_DIVING )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.SKY_DIVING )
		}

		if ( HasHolsteredWeapons( player ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.WEAPONS_HOLSTERED )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.WEAPONS_HOLSTERED )
		}

		if ( Bleedout_IsBleedingOut ( player ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.PLAYER_DOWNED )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.PLAYER_DOWNED )
		}

		array<entity> teammates = GetPlayerArrayOfTeam( player.GetTeam() )
		bool isTeammateDowned = false
		foreach ( teammate in teammates )
		{
			if ( !IsValid( teammate ) )
				continue

			if ( teammate == player )
				continue

			if ( Bleedout_IsBleedingOut( teammate ) )
			{
				isTeammateDowned = true
				break
			}
		}

		if ( isTeammateDowned )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TEAMMATE_DOWNED )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TEAMMATE_DOWNED )
		}

		if ( !DeathField_IsPointInsideRing( player.GetOrigin(), player.DeathFieldIndex() ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.OUT_OF_RING )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag(file.playerStatusFlags, ePlayerStatusEnum.OUT_OF_RING)
		}

		entity tac = player.GetOffhandWeapon( eOffhandInv.TACTICAL )

		if ( IsValid( tac ) )
		{
			if ( tac.GetWeaponPrimaryClipCount() == tac.GetWeaponPrimaryClipCountMax() )
			{
				file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TACTICAL_RECHARGED )
			}
			else
			{
				file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TACTICAL_RECHARGED )
			}
		}

		int currentHealth = player.GetHealth() + player.GetShieldHealth()
		if ( currentHealth < previousFrameHealthTotal )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TAKING_DAMAGE )
			previousFrameHealthTotal = currentHealth
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.TAKING_DAMAGE )
			previousFrameHealthTotal = currentHealth
		}

		if ( PlayerIsInADS( player, false ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_ADS )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_ADS )
		}

		entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
		entity heldOrdnance = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_ANTI_TITAN )

		if ( IsValid( heldOrdnance ) && IsValid ( activeWeapon ) && activeWeapon == heldOrdnance )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.ORDINANCE_EQUIPPED )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.ORDINANCE_EQUIPPED )
		}

		if ( SURVIVAL_GetPrimaryWeapons( player ).len() > 0 )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.WEAPON_EQUIPPED )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.WEAPON_EQUIPPED )
		}

		if ( player.IsSprinting() )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.RUNNING )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.RUNNING )
		}

		if ( !player.IsOnGround() )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_AIR )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_AIR )
		}

		if ( player.GetPlayerNetBool( "playerInPlane" ) )
		{
			file.playerStatusFlags = SetBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_DROPSHIP )
		}
		else
		{
			file.playerStatusFlags = ClearBitFlag( file.playerStatusFlags, ePlayerStatusEnum.IN_DROPSHIP )
		}

		ProcessPlayerStateModals()
		wait 1.0
	}
}

void function ProcessPlayerStateModals()
{
	foreach ( stateModal in file.tutorialStateModalArray )
	{
		if ( BitFieldCheck( stateModal.state, stateModal.stateMask, file.playerStatusFlags ) && DoesItemRefsCheckPass( stateModal.inventoryCheckStr, stateModal.inventoryCheckType ))
		{
			AddToTutorialModalQueue( stateModal )
		}
	}

	if ( file.characterRef != "" && ( file.characterRef in file.tutorialStateModalArrayByCharacter ) )
	{
		array< TutorialModalData > legendModalData = file.tutorialStateModalArrayByCharacter[ file.characterRef ]
		foreach ( stateModal in legendModalData )
		{
			if ( BitFieldCheck( stateModal.state, stateModal.stateMask, file.playerStatusFlags ) && DoesItemRefsCheckPass( stateModal.inventoryCheckStr, stateModal.inventoryCheckType ))
			{
				AddToTutorialModalQueue( stateModal )
			}
		}
	}

	if ( !file.isPromptActive )
	{
		foreach ( markOnMapData in file.markOnMapStateArray )
		{
			if ( BitFieldCheck( markOnMapData.state, markOnMapData.stateMask, file.playerStatusFlags ) && DoesItemRefsCheckPass( markOnMapData.inventoryCheckStr, markOnMapData.inventoryCheckType ))
			{
				
				if ( MarkNeededLoot( markOnMapData ) )
					break
			}
		}
	}
}

bool function BitFieldCheck( int state, int mask, int stateCheck )
{
	return (state & mask) == (stateCheck & mask)
}

bool function MarkNeededLoot( MarkOnMapData data )
{
	
	if ( IsTutorialRunCountGreaterThanMaxPerAccount( data.id, data.maxPerAccount ) )
		return false

	if ( file.modalDisplayTimesThisMatch[data.id] >= data.maxPerMatchCount )
		return false

	if ( data.id in file.tutorialCooldownTable )
	{
		float coolDownTime = file.tutorialCooldownTable[ data.id ]
		if ( Time() < coolDownTime )
			return false
	}

	entity player = GetLocalClientPlayer()
	AddOnscreenPromptFunction( "quickchat", CreateLootPingFunction( player, data.itemRef, data.uniqueId ), 10.0, "%chat_wheel%" + Localize( data.promptStr ) )

	Remote_ServerCallFunction( "IncrementTutorialRunCountOnServer", data.id )
	file.tutorialCooldownTable[ data.id ] <- Time() + data.cooldownTime
	file.modalDisplayTimesThisMatch[data.id] = file.modalDisplayTimesThisMatch[data.id] + 1
	PIN_MarkOnMap ("mark_on_map_prompt_display", file.activeUniqueId, file.activeItemRef, <0,0,0> )

	return true
}


void functionref(entity) function CreateLootPingFunction( entity player, string itemRef, string uniqueId )
{
	EmitUISound( "UI_InGame_Tutorial_Mark" )
	file.isPromptActive = true
	file.activeUniqueId = uniqueId
	file.activeItemRef = itemRef
	return void function( entity player ) : ( itemRef )
	{
		LootData item = SURVIVAL_Loot_GetLootDataByRef( itemRef )
		Remote_ServerCallFunction( "ClientCallback_PingRequiredLootItem", item.index )
	}
}
















































bool function DoesItemRefsCheckPass( string itemRef, int inventoryCheckType )
{
	entity player = GetLocalClientPlayer()

	switch( inventoryCheckType )
	{
		case eInventoryCheckTypeEnum.HAS_LOOTGROUP:
		case eInventoryCheckTypeEnum.NOT_HAVE_LOOTGROUP:
		{
			break
		}
		case eInventoryCheckTypeEnum.HAS_ITEMREF:
		case eInventoryCheckTypeEnum.NOT_HAVE_ITEMREF:
		{
			int itemCount = SURVIVAL_CountItemsInInventory( player, itemRef )
			if ( inventoryCheckType == eInventoryCheckTypeEnum.HAS_ITEMREF )
			{
				return (itemCount != 0)
			}
			else
			{
				return (itemCount == 0)
			}
			break
		}
		case eInventoryCheckTypeEnum.HAS_GADGET:
		{
			if ( IsItemEquipped_Gadget( player, itemRef ) && GetItemEquipped_GadgetCount ( player, itemRef ) != 0 )
			{
				return true
			}
			else
			{
				return false
			}
			break
		}
		case eInventoryCheckTypeEnum.NOT_HAVE_GADGET:
		{
			if ( IsItemEquipped_Gadget( player, itemRef ) && GetItemEquipped_GadgetCount ( player, itemRef ) == 0 )
			{
				return false
			}
			else
			{
				return true
			}
			break
		}
		default:
			break
	}

	return true
}



bool function HasHolsteredWeapons( entity player )
{
	int meleeWeapon = WEAPON_INVENTORY_SLOT_PRIMARY_2
	entity weapon = player.GetActiveWeapon(0)

	if ( !IsValid( weapon ) )
	{
		return false
	}

	if (SURVIVAL_GetPrimaryWeapons( player ).len() < 1 )
	{
		return false
	}

	return weapon == player.GetNormalWeapon( meleeWeapon )
}































void function OnDeathBoxCreated( entity ent )
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	if ( ent.GetScriptName() != DEATH_BOX_SCRIPTNAME )
		return

	entity deathBoxOwner    = ent.GetOwner()
	if ( !IsValid( deathBoxOwner ) )
		return

	array<entity> teammates = GetPlayerArrayOfTeam( player.GetTeam() )
	foreach ( teammate in teammates )
	{
		if ( !IsValid( teammate ) )
			continue

		if ( teammate == player )
			continue

		if ( deathBoxOwner == teammate )
		{
			CustomTutorialPopup( "teammate_dead_recover_banner" )
		}
	}
}


















void function PingReminderThread()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	EndSignal( player, "PingReminderEndSignal" )
	OnThreadEnd( function() : ()
	{
		if ( !file.playerPinged )
		{
			CustomTutorialPopup( "player_ping_reminder" )
			thread PingReminderThread()
		}
	})
	wait 150
}



void function GameStateEnter_OnPlaying()
{
	if ( file.tutorialEnabled )
	{
		thread PingReminderThread()
	}
}

void function GameStateEnter_OnWinnerDetermined()
{
	
	EnableTutorialThreads( false )
}

void function OnPlayerLifeStateChanged( entity player, int oldState, int newState )
{
	
	if ( player == GetLocalClientPlayer() && newState == LIFE_DEAD)
	{
		EnableTutorialThreads( false )
	}
}

void function LocalClientPlayerSpawned( entity player )
{
	if ( player == GetLocalClientPlayer() )
	{
		if ( file.tutorialPlayerSettings == eTutorialPlayerSettings.ON || ( file.tutorialPlayerSettings == eTutorialPlayerSettings.AUTO  && !IsTutorialAccountLevelDisabled() ) )
		{
			if ( GetCurrentPlaylistVarBool( "tutorial_modals_enabled_new_player_only", false ) )
			{
				if ( NewPlayerMatchMaking_IsInMatchMakingFlow( GetLocalClientPlayer() ) )
				{
					EnableTutorialThreads( true )
				}
			}
			else
			{
				EnableTutorialThreads( true )
			}
		}
	}
}



void function OnPlayerTookDamageCoverReminder( float damage, vector damageOrigin, int damageType, int damageSourceId, entity attacker )
{
	if ( !file.tutorialEnabled )
		return

	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	if ( IsValid( attacker ) )
	{
		if ( file.timeSinceDamageStarted == -1  || ( Time() > file.timeSinceDamageStarted + DAMAGE_TIME_WINDOW ) )
		{
			file.timeSinceDamageStarted = Time()
			file.totalDamageTakenInWindow = damage

			if ( file.totalDamageTakenInWindow > DAMAGE_THRESHOLD )
			{
				CustomTutorialPopup( "player_cover_reminder", true )
			}
		}
		else
		{
			file.totalDamageTakenInWindow = damage + file.totalDamageTakenInWindow

			if ( file.totalDamageTakenInWindow > DAMAGE_THRESHOLD )
			{
				CustomTutorialPopup( "player_cover_reminder", true )
			}
		}
	}
}



void function ServerToClient_OnLootBinOpen_ShowModal ( entity openingPlayer , entity lootBin )
{
	if ( !file.tutorialEnabled )
		return

	if ( openingPlayer != GetLocalClientPlayer() )
		return


	if( Perk_MunitionsBox_IsEntMunitionsBox( lootBin ) )
	{
		CustomTutorialPopup ("modal_lootbin_assault" )
		return
	}

	if( SupportBin_EntityIsSupportBin( lootBin ) )
	{
		CustomTutorialPopup ("modal_lootbin_support" )
		return
	}



	if( LootBinReset_IsLootBin_GoldBin( lootBin ) )
	{
		CustomTutorialPopup ( "modal_lootbin_gold" )
		return
	}

	if( LootBinReset_IsLootBin_Mythic( lootBin ) )
	{
		CustomTutorialPopup ( "modal_lootbin_mythic" )
		return
	}

	CustomTutorialPopup ( "modal_lootbin" )
}
































void function ServerToClient_OnFreefallEnded_Modals( entity player )
{
	if ( !file.tutorialEnabled )
		return

	if ( !IsValid( player ) )
		return

	file.hasTouchedGrass = true
}

