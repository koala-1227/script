void function Sh_Airdrops_Init()
{
	RegisterSignal( "OpenDroppod" )
	RegisterSignal( "DroppodRemoveLocationMarker" )
	PrecacheScriptString( CARE_PACKAGE_SCRIPTNAME )
	PrecacheScriptString( AIRDROP_MOVER_SCRIPTNAME )


		AddCreateCallback( "prop_dynamic", OnAirdropCreated )





}

int function GetAirdropPingColorIDFromRarityTier( int rarityTier )
{
	switch ( rarityTier )
	{
		case eLootTier.COMMON:
			return COLORID_HUD_LOOT_TIER1
		case eLootTier.RARE:
			return COLORID_HUD_LOOT_TIER2
		case eLootTier.EPIC:
			return COLORID_HUD_LOOT_TIER3
		case eLootTier.LEGENDARY:
			return COLORID_HUD_LOOT_TIER4
		case eLootTier.MYTHIC:
			return COLORID_HUD_LOOT_TIER5
	}
	return COLORID_AIRDROP_DEFAULT_COLOR
}

entity function GetAirdropForHitEnt( entity hitEnt )
{
	if ( hitEnt.GetScriptName() == CARE_PACKAGE_SCRIPTNAME )
		return hitEnt

	entity parentEnt = hitEnt.GetParent()
	if ( IsValid( parentEnt ) && parentEnt.GetScriptName() == CARE_PACKAGE_SCRIPTNAME )
		return parentEnt

	return null
}




























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































bool function IsAirdropCarePackage( entity airdrop )
{
	switch ( airdrop.GetTargetName() )
	{
		case CARE_PACKAGE_TARGETNAME:
		case CARE_PACKAGE_LIFELINE_TARGETNAME:
		case TARGETNAME_DROPPOD_RAMPART:

		case TARGETNAME_DROPPOD_UNHINGED:





		case TARGETNAME_PVE_AIRDROP:

			return true

		default:
			return false
	}

	unreachable
}

void function OnAirdropCreated( entity dropPod )
{
	if ( !IsAirdropCarePackage( dropPod ) )
		return

	AddCallback_OnUseEntity_ClientServer( dropPod, OnAirdropUse )


		AddEntityCallback_GetUseEntOverrideText( dropPod, ExtendedUseTextOverride )

}

void function OnAirdropUse( entity dropPod, entity player, int useInputFlags )
{
	if ( !dropPod.DoesShareRealms( player ) )
		return





















































	if ( IsBitFlagSet( useInputFlags, USE_INPUT_DEFAULT ) )
	{








	}
}





























































































































