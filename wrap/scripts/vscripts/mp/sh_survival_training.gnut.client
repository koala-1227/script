void function ShSurvivalTraining_Lobby_Init()
{

		Remote_RegisterUIFunction( "ServerCallback_SetPlaylistById", "int", PLAYLIST_ID_SURVIVAL, PLAYLIST_ID_NEW_PLAYER_ORIENTATION )

}

void function ShSurvivalTraining_Init()
{
	RegisterNetworkedVariable( "TrainingEndTime", SNDC_PLAYER_EXCLUSIVE, SNVT_TIME, -1 )
	RegisterNetworkedVariable( "tutorialContext", SNDC_PLAYER_EXCLUSIVE, SNVT_INT, -1 )

	RegisterCSVDialogue( $"datatable/dialogue/survival_training.rpak" )

	AddCallback_EntitiesDidLoad( Training_EntitiesDidLoad )

	Remote_RegisterClientFunction( "Bleedout_DisplayTrainingFirstAidProgressBar", "entity", "float", 0.0, 86400.0, 32, "float", 0.0, 86400.0, 32 )
	Remote_RegisterClientFunction( "Bleedout_StopTrainingFirstAidProgressBar" )
	

	if( IsStagingMU1())
	{
		deltaOldNewMap = NEW_BLOODHOUNDSTART_POS - OLD_BLOODHOUNDSTART_POS










	}

	PrecacheScriptString( DEATH_BOX_SCRIPTNAME_TRAINING )
	PrecacheScriptString( RESPAWN_CHAMBER_SCRIPT_NAME )

	Remote_RegisterServerFunction( "ClientCallback_TrainingUsedCommsMenu", "int", 0, 2 )
	Remote_RegisterServerFunction( "ClientCallback_SetProceedToFiringRange", "bool" )


	Remote_RegisterServerFunction( "ClientCallback_TrainingAck" )
	RegisterSignal("TrainingModalAck")
	RegisterSignal("TrainingCloseRingAnnouncment")
	RegisterSignal("TrainingRingClosing")

	file.deathFieldData.center = <-7167.4, 517.7, -20>
	file.deathFieldData.nextCenter = <-5526.2, -856.7, 396>
	file.deathFieldData.startRadius = 5200.0
	file.deathFieldData.currentRadius = 5200.0
	file.deathFieldData.endRadius = 750.0












































		AddLocalPlayerFunc( Training_AddPlayer )
		AddCallback_OnClientScriptInit( OnLocalClientConnected )
		AddScriptNameCreateCallback( RESPAWN_CHAMBER_SCRIPT_NAME, RespawnChamberCreated )
		RegisterNetVarTimeChangeCallback( "TrainingEndTime", TrainingEndTimeChanged )
		SetCommsDialogueEnabled( false )


		PrecacheParticleSystem( $"P_sort_ring_radCP1_opaCP2_1k_x_100k" )
		PrecacheParticleSystem( $"outside_ring_radCP1_opaCP2_1k_x_100k" )

		AddCreateCallback( "script_mover", OnPropScriptCreated )

		SetChampionScreenRuiAsset( $"ui/training_completed_screen.rpak" )

		file.ringColorCorrection = ColorCorrection_Register( COLOR_CORRECTION )


		AddCreateCallback( "prop_death_box", TrainingDeathBoxCreated )

}


