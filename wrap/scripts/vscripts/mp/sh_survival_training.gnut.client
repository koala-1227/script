void function OnPropScriptCreated( entity prop )
{
	printt( "OnPropScriptCreated" )
	if ( prop.GetTargetName() == "training_deathField" )
	{
		printt( "OnPropScriptCreated - training_deathField" )
		thread CreateRing( prop )
	}
}

void function CreateRing( entity deathField )
{
	deathField.EndSignal( "OnDestroy" )
	int ringFX   = StartParticleEffectOnEntity( deathField, GetParticleSystemIndex( $"P_sort_ring_radCP1_opaCP2_1k_x_100k" ), FX_PATTACH_ABSORIGIN, ATTACHMENTID_INVALID )
	int ringFXOuter   = StartParticleEffectOnEntity( deathField, GetParticleSystemIndex( $"outside_ring_radCP1_opaCP2_1k_x_100k" ), FX_PATTACH_ABSORIGIN, ATTACHMENTID_INVALID ) 

	table<string, int> e
	e["fx"] <- ringFX
	e["fxOuter"] <- ringFXOuter

	entity deathfieldSoundEnt = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", deathField.GetOrigin(), <0, 0, 0> )

	OnThreadEnd(
		function() : ( e, deathfieldSoundEnt )
		{
			if ( e["fx"] != -1 )
				EffectStop( e["fx"], true, true )
			if ( e["fxOuter"] != -1 )
				EffectStop( e["fxOuter"], true, true )

			deathfieldSoundEnt.Destroy()
		}
	)

	vector prevDeathFieldOrigin = deathField.GetOrigin()

	entity clientPlayer = GetLocalClientPlayer()
	thread TrackDeathfieldDistance_Training( clientPlayer, deathField )

	string currentSoundPlaying = ""
	bool wasMoving             = false

	int realm = deathField.GetRealms()[0]

	while ( true )
	{
		float radius = DeathField_GetRadiusForNow( realm )

		if ( deathField.GetVelocity() == <0,0,0> || prevDeathFieldOrigin != deathField.GetOrigin() )
		{
			EffectSetControlPointVector( e["fx"], 0, deathField.GetOrigin() )
			EffectSetControlPointVector( e["fx"], 1, <radius / 1000.0, radius, 0> )
			EffectSetControlPointVector( e["fxOuter"], 0, deathField.GetOrigin() )
			EffectSetControlPointVector( e["fxOuter"], 1, <radius / 1000.0, radius, 0> )
		}

		prevDeathFieldOrigin = deathField.GetOrigin()

		EffectSetControlPointVector( e["fx"], 2, < 1.0, 0, 0 > )
		EffectSetControlPointVector( e["fxOuter"], 2, < 1.0, 0, 0 > )

		entity player        = GetLocalViewPlayer()
		vector fwdToPlayer   = Normalize( <player.GetOrigin().x, player.GetOrigin().y, 0> - <deathField.GetOrigin().x, deathField.GetOrigin().y, 0> )
		vector circleEdgePos = deathField.GetOrigin() + (fwdToPlayer * radius)
		circleEdgePos.z = player.EyePosition().z

		if ( PositionIsInMapBounds( circleEdgePos ) )
		{
			deathfieldSoundEnt.SetOrigin( circleEdgePos )

			bool moving = ( deathField.GetVelocity() != <0,0,0> )
			string soundToPlay = "Survival_Circle_Edge_Medium"

			if ( moving )
				soundToPlay = soundToPlay + "_Movement"

			if ( (!moving || currentSoundPlaying == "" || wasMoving != moving) && currentSoundPlaying != soundToPlay )
			{
				if ( currentSoundPlaying != "" )
					StopSoundOnEntity( deathfieldSoundEnt, currentSoundPlaying )
				if ( soundToPlay != "" )
					EmitSoundOnEntity( deathfieldSoundEnt, soundToPlay )

				currentSoundPlaying = soundToPlay
				wasMoving = moving
			}
		}

		WaitFrame()
	}
}

const asset DEATHFIELD_EFFECT = $"P_ring_FP_hit_01"
const asset OBSERVER_DEATHFIELD_EFFECT = $"P_Observer_outside_heat_1p"

void function TrackDeathfieldDistance_Training( entity player, entity deathField )
{
	player.EndSignal( "OnDestroy" )
	deathField.EndSignal( "OnDestroy" )

	bool wasShowingDeathFieldFx = false
	int screenFx

	table<string, int> e
	e["colorCorrection"] <- file.ringColorCorrection
	e["fieldEffectHandle"] <- -1

	OnThreadEnd(
		function() : ( screenFx, player, e )
		{
			
			ColorCorrection_SetWeight( e["colorCorrection"], 0.0 )
			Chroma_EnteredRing()

			if ( EffectDoesExist( e["fieldEffectHandle"] ) )
			{
				EffectStop( e["fieldEffectHandle"], true, false )
			}
		}
	)

	ColorCorrection_SetExclusive( e["colorCorrection"], true )

	while ( true )
	{

		bool shouldShowDeathFieldFx = ( Distance2D( player.GetOrigin(), deathField.GetOrigin())  > 5200.0 )

		if ( wasShowingDeathFieldFx != shouldShowDeathFieldFx )
		{
			if ( shouldShowDeathFieldFx )
			{
				if ( !EffectDoesExist( screenFx ) ) 
				{
					screenFx = StartParticleEffectOnEntity( player, GetParticleSystemIndex( DEATHFIELD_EFFECT ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
					e["fieldEffectHandle"] = screenFx

					EffectSetIsWithCockpit( screenFx, true )
				}

				ColorCorrection_SetWeight( e["colorCorrection"], 1.0 )

				Chroma_LeftRing()
			}
			else
			{
				if ( EffectDoesExist( screenFx ) )
				{
					EffectStop( screenFx, true, true )
				}

				ColorCorrection_SetWeight( e["colorCorrection"], 0.0 )

				Chroma_EnteredRing()
			}
			wasShowingDeathFieldFx = shouldShowDeathFieldFx
		}

		WaitFrame()
	}
}

