bool function CodeCallback_OnControllerSwitchFromActiveOffhandHybrid( entity player, entity activeWeapon )
{

		Assert( IsValid( player ) && IsValid( activeWeapon ) )
		if ( Consumable_ChainHealEnabled() && (Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_QUEUE_NEXT || Consumable_GetChainHealMode( player ) == eChainHealMode.CHAIN_HEAL_AUTO_QUEUE) && activeWeapon.GetWeaponClassName() == CONSUMABLE_WEAPON_NAME )
		{
			if ( Consumable_GetNextHealInQueue( player ) != eHealthPickupType.INVALID )
			{
				Consumable_SetNextHealInQueue( player, eHealthPickupType.INVALID )
				return false
			}
		}

	return true
}

