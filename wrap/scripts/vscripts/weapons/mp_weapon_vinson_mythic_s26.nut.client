void function VinsonMythicS26_BulletBuff_Init( entity weapon )
{
	if ( !tunings.bulletEnabled )
		return

	if ( !IsValid( weapon ) )
		return

	VinsonMythicS26_BulletBuff_Reset( weapon )
}



















































void function VinsonMythicS26_BulletBuff_TryToggleHopup( entity weapon )
{
	if ( !IsValid( weapon ) || weapon.IsProjectile() )
		return

	bool hasMod = VinsonMythicS26_BulletBuff_HasExplosiveMod( weapon )
	VinsonMythicS26_BulletBuff_SetHopup( weapon, !hasMod )
}



void function VinsonMythicS26_BulletBuff_SetHopup( entity weapon, bool enable )
{
	if ( !IsValid( weapon ) || weapon.IsProjectile() )
		return

		if ( !( InPrediction() && IsFirstTimePredicted() ) )
			return


	if ( enable )
	{
		weapon.AddMod( MOD_BULLET_EXPLOSIVE_ROUND )
	}
	else
	{
		weapon.RemoveMod( MOD_BULLET_EXPLOSIVE_ROUND )
	}
}



bool function VinsonMythicS26_BulletBuff_HasExplosiveMod( entity weapon )
{
	if ( !IsValid( weapon ) )
		return false

	bool isProjectile = weapon.IsProjectile()
	bool hasMod
	if ( isProjectile )
	{
		hasMod = weapon.HasWeaponMod( MOD_BULLET_EXPLOSIVE_ROUND )
	}
	else
	{
		hasMod = weapon.HasMod( MOD_BULLET_EXPLOSIVE_ROUND )
	}

	return hasMod
}



void function VinsonMythicS26_BulletBuff_UpdateHopup( entity weapon )
{
	Assert ( IsNewThread(), "Must be threaded off." )

	
	WaitFrame()

	if ( !IsValid( weapon ) )
		return

	if ( VinsonMythicS26_BulletBuff_HasExplosiveMod( weapon ) )
	{
		VinsonMythicS26_BulletBuff_Reset( weapon )
	}
	else if ( weapon.GetHeatValue() >= 1.0 )
	{
		VinsonMythicS26_BulletBuff_SetHopup( weapon, true )
	}
}



void function VinsonMythicS26_BulletBuff_Reset( entity weapon )
{
	if ( !IsValid( weapon ) )
		return
	if ( !tunings.bulletEnabled )
		return

	if ( !( InPrediction() && IsFirstTimePredicted() ) )
		return


	weapon.SetHeatValue( 0 )
	weapon.TryUpdatingFullyHeated()
	VinsonMythicS26_BulletBuff_SetHopup( weapon, false )
}


