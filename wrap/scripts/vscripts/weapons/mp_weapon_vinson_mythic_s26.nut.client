bool function GetPlaylistVar_VinsonMythicS26_Enabled()
{
	return GetCurrentPlaylistVarBool( "mythic_s26_enabled", false )
}

void function VinsonMythicS26_Init()
{
	if ( !GetPlaylistVar_VinsonMythicS26_Enabled() )
	{
		SURVIVAL_Loot_AddDisabledRef( REF_MYTHIC_FLATLINE_WEAPON )
		return
	}













		RegisterConCommandTriggeredCallback( "+scriptCommand3", VinsonMythicS26_OnSelectFirePressed )



		PrecacheParticleSystem( VFX_RING_FIRE_EXPLODE_COCKPIT )
		PrecacheParticleSystem( VFX_RING_FIRE_EXPLODE_1P )
		PrecacheParticleSystem( VFX_RING_FIRE_EXPLODE_3P )
		PrecacheParticleSystem( VFX_BOMB_PLANTED )
		PrecacheParticleSystem( VFX_BOMB_PLANTED_NEAR_END )
		PrecacheImpactEffectTable( IMPACT_FX_BULLET_EXPLODE )
		PrecacheImpactEffectTable( IMPACT_FX_BOMB_EXPLODE )

		Remote_RegisterServerFunction( "VinsonMythicS26_OnSelectFirePressed_ToggleMod", "typed_entity", "prop_script" )

		Remote_RegisterClientFunction( "VinsonMythicS26_BulletBuff_Reset", "entity" )
		Remote_RegisterClientFunction( "VinsonMythicS26_FireRing_ExplodeVFX_Cockpit" )
		Remote_RegisterClientFunction( "VinsonMythicS26_Bomb_Timer", "entity" )

		VinsonMythicS26_InitTunings()

}


void function VinsonMythicS26_InitTunings()
{
	tunings.removeOnDeath =      	GetCurrentPlaylistVarBool( "mythic_s26_remove_on_death", tunings.removeOnDeath )
	tunings.oncePerShieldBreak = 	GetCurrentPlaylistVarBool( "mythic_s26_buff_once_per_shield_break", tunings.oncePerShieldBreak )
	tunings.oncePerKnock =       	GetCurrentPlaylistVarBool( "mythic_s26_buff_once_per_knock", tunings.oncePerKnock )

	tunings.bulletEnabled =			GetCurrentPlaylistVarBool(  "mythic_s26_buff_bullet_enabled", tunings.bulletEnabled )
	tunings.bulletDamageMax =		GetCurrentPlaylistVarInt(   "mythic_s26_buff_bullet_damage_max", tunings.bulletDamageMax )
	tunings.bulletRadiusMin =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_bullet_radius_min", tunings.bulletRadiusMin ) * METERS_TO_INCHES
	tunings.bulletRadiusMax =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_bullet_radius_max", tunings.bulletRadiusMax ) * METERS_TO_INCHES
	tunings.bulletFragForce =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_bullet_frag_force", tunings.bulletFragForce )
	tunings.bulletGivesBomb =		GetCurrentPlaylistVarBool(  "mythic_s26_buff_bullet_gives_bomb", tunings.bulletGivesBomb )
	tunings.bulletDebugHUD =		GetCurrentPlaylistVarBool(  "mythic_s26_buff_bullet_debug_hud", tunings.bulletDebugHUD )

	tunings.ringEnabled =			GetCurrentPlaylistVarBool(  "mythic_s26_buff_ring_enabled", tunings.ringEnabled )
	tunings.ringRadiusMin =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_radius_min", tunings.ringRadiusMin ) * METERS_TO_INCHES
	tunings.ringRadiusMax =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_radius_max", tunings.ringRadiusMax ) * METERS_TO_INCHES
	tunings.ringExplodeTime =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_explode_time", tunings.ringExplodeTime )
	tunings.ringExplodeDamageMax =	GetCurrentPlaylistVarInt(   "mythic_s26_buff_ring_explode_damage_max", tunings.ringExplodeDamageMax )
	tunings.ringExplodeGivesBomb =	GetCurrentPlaylistVarBool(  "mythic_s26_buff_ring_explode_gives_bomb", tunings.ringExplodeGivesBomb )

	tunings.ringBurnDamage =		GetCurrentPlaylistVarInt(   "mythic_s26_buff_ring_burn_damage", tunings.ringBurnDamage )
	tunings.ringBurnTime =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_burn_time", tunings.ringBurnTime )
	tunings.ringBurnTickRate =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_burn_tick_rate", tunings.ringBurnTickRate )
	tunings.ringBurnStackDebounce =	GetCurrentPlaylistVarFloat( "mythic_s26_buff_ring_burn_stack_debounce", tunings.ringBurnStackDebounce )
	tunings.ringBurnStacksMax =		GetCurrentPlaylistVarInt(   "mythic_s26_buff_ring_burn_stacks_max", tunings.ringBurnStacksMax )
	tunings.ringBurnGivesBomb =		GetCurrentPlaylistVarBool(  "mythic_s26_buff_ring_burn_gives_bomb", tunings.ringBurnGivesBomb )

	tunings.bombEnabled =			GetCurrentPlaylistVarBool(  "mythic_s26_buff_bomb_enabled", tunings.bombEnabled )
	tunings.bombDamageMax =			GetCurrentPlaylistVarInt(   "mythic_s26_buff_bomb_damage_max", tunings.bombDamageMax )
	tunings.bombHurtsEveryone =		GetCurrentPlaylistVarBool(  "mythic_s26_buff_bomb_hurts_everyone", tunings.bombHurtsEveryone )
	tunings.bombExplodeTime =		GetCurrentPlaylistVarFloat( "mythic_s26_buff_bomb_explode_time", tunings.bombExplodeTime )
	tunings.bombRadiusMin =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_bomb_radius_min", tunings.bombRadiusMin ) * METERS_TO_INCHES
	tunings.bombRadiusMax =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_bomb_radius_max", tunings.bombRadiusMax ) * METERS_TO_INCHES
	tunings.bombFragForce =			GetCurrentPlaylistVarFloat( "mythic_s26_buff_bomb_frag_force", tunings.bombFragForce )
	tunings.bombDefusedOnThirst =	GetCurrentPlaylistVarBool(  "mythic_s26_buff_bomb_defused_on_thirst", tunings.bombDefusedOnThirst )
	tunings.bombWaitForRevive =		GetCurrentPlaylistVarBool(  "mythic_s26_buff_bomb_wait_for_revive", tunings.bombWaitForRevive )
