void function VinsonMythicS26_OnWeaponActivate( entity weapon )
{
	if ( !GetPlaylistVar_VinsonMythicS26_Enabled() )
		return

	string weaponRef = VinsonMythicS26_GetNameFromWeapon( weapon )
	if ( weaponRef == "" )
		return

	switch ( weaponRef )
	{
		case REF_MYTHIC_FLATLINE_WEAPON:
			VinsonMythicS26_BulletBuff_Init( weapon )



			break

		default:
			break
	}
}



void function VinsonMythicS26_OnWeaponFire( entity weapon )
{
	if ( !GetPlaylistVar_VinsonMythicS26_Enabled() )
		return

	string weaponRef = VinsonMythicS26_GetNameFromWeapon( weapon )
	if ( weaponRef == "" )
		return

	switch ( weaponRef )
	{
		case REF_MYTHIC_FLATLINE_WEAPON:
			break

		default:
			break
	}
}



