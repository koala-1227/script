void function VinsonMythicS26_FireRing_ExplodeVFX_Cockpit()
{
	entity player = GetLocalViewPlayer()
	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	int fxID   = GetParticleSystemIndex( VFX_RING_FIRE_EXPLODE_COCKPIT )
	int handle = StartParticleEffectOnEntity( cockpit, fxID, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	EffectSetIsWithCockpit( handle, true )
}

































































