void function VinsonMythicS26_OnSelectFirePressed( entity player )
{
	if ( !IsValid( player ) || player != GetLocalViewPlayer() || player.IsPhaseShifted() )
		return

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( activeWeapon ) )
		return

	if ( !DoesModExist( activeWeapon, MOD_BULLET_EXPLOSIVE_ROUND_ALT ) )
		return

	
	thread VinsonMythicS26_OnSelectFirePressed_ToggleMod( player, activeWeapon )
}



void function VinsonMythicS26_OnSelectFirePressed_ToggleMod( entity player, entity weapon )
{
	Assert ( IsNewThread(), "Must be threaded off." )

	

	WaitFrame()

	if ( !IsValid( player ) || !IsValid( weapon ) )
		return

	
	if ( weapon.GetHeatValue() >= 1.0 )
	{
		VinsonMythicS26_BulletBuff_SetHopup( weapon, true )
	}
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________WeaponUtilities___________________________(){}
#endif
























string function VinsonMythicS26_GetNameFromWeapon( entity weapon )
{
	if ( !IsValid( weapon ) )
		return ""

	foreach ( mod, weaponRef in MYTHIC_MOD_TO_WEAPON_REF )
	{
		if ( weapon.HasMod( mod ) )
		{
			return weaponRef
		}
	}

	return ""
}



asset function VinsonMythicS26_GetWeaponSkinFromRef( string ref )
{
	switch ( ref )
	{
		case REF_MYTHIC_FLATLINE_WEAPON:
			return SKIN_MYTHIC_WEAPON

		default:
			return $""
	}

	unreachable
}





















































































