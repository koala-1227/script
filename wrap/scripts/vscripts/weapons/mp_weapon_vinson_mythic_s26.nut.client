void function VinsonMythicS26_Bomb_Timer( entity bomb )
{
	if ( !IsValid( bomb ) )
		return

	thread VinsonMythicS26_Bomb_Timer_Thread( bomb )
}



void function VinsonMythicS26_Bomb_Timer_Thread( entity bomb )
{
	if ( !IsValid( bomb ) )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) || !IsLocalClientPlayer( player ) )
		return

	var topo = CreateRUITopology_Worldspace( ZERO_VECTOR, ZERO_VECTOR, SIZE_BOMB_COUNTDOWN_TIMER, SIZE_BOMB_COUNTDOWN_TIMER )
	var ruiWorld = RuiCreate( $"ui/arsenal_item_respawn_timer.rpak", topo, RUI_DRAW_WORLD, 0 )

	float endTime = Time() + tunings.bombExplodeTime
	RuiSetFloat( ruiWorld, "respawnDuration", tunings.bombExplodeTime )
	RuiSetGameTime( ruiWorld, "endTime", endTime )

	file.bombActualEndTimes[bomb] <- endTime

	entity victim = bomb.GetParent()
	bool isOnMe = ( victim == player )

	var ruiHUD = null
	if ( isOnMe )
	{
		ruiHUD = CreateCockpitPostFXRui( $"ui/bleedout_bomb_timer.rpak" )
		RuiSetGameTime( ruiHUD, "endTime", endTime )
		RuiSetFloat( ruiHUD, "bombDuration", tunings.bombExplodeTime )
	}

	if ( IsValid( victim ) )
	{
		file.bombToTarget[bomb] <- victim
	}

	thread VinsonMythicS26_UpdateUnitFrameBombUI( victim, true, endTime )

	bomb.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )

	OnThreadEnd(
		function() : ( topo, ruiWorld, ruiHUD, victim, bomb )
		{
			RuiDestroyIfAlive( ruiWorld )
			if ( ruiHUD != null )
			{
				RuiDestroyIfAlive( ruiHUD )
			}
			RuiTopology_Destroy( topo )

			VinsonMythicS26_UpdateUnitFrameBombUI( victim, false )

			if ( IsValid( bomb ) && ( bomb in file.bombToTarget ) )
			{
				delete file.bombToTarget[bomb]
			}

			if ( bomb in file.bombActualEndTimes )
			{
				delete file.bombActualEndTimes[bomb]
			}
		}
	)

	while ( Time() < endTime )
	{
		if ( ruiHUD != null && RuiIsAlive( ruiHUD ) )
		{
			if ( isOnMe && (player.ContextAction_IsBeingRevived() || player.ContextAction_IsReviving()) )
			{
				RuiSetBool( ruiHUD, "isBeingRevived", true )
			}
		}
		WaitFrame()
	}

	Wait( tunings.bombExplodeTime )
}


























































































bool function VinsonMythicS26_IsPlayerBombed( entity player )
{
	if ( !IsValidPlayer( player ) )
		return false

	array< entity > targets = file.bombToTarget.clonevalues()
	foreach ( target in targets )
	{
		if ( target == player )
			return true
	}

	return false
}

void function VinsonMythicS26_UpdateUnitFrameBombUI( entity victim, bool show, float endTime = 0.0 )
{
	table<entity, UnitFrameDef> teamFrames = GetTeamUnitFrames()
	foreach ( UnitFrameDef frame in teamFrames )
	{
		entity owner = UnitFrame_GetOwnerByIndex( frame.index )
		if ( owner == victim && IsValid( frame.rui ) )
		{
			RuiSetBool( frame.rui, "showBombUI", show )
			if ( show )
			{
				RuiSetGameTime( frame.rui, "bombEndTime", endTime )
				RuiSetFloat( frame.rui, "bombDuration", tunings.bombExplodeTime )
				thread VinsonMythicS26_UpdateUnitFrameBombUI_UpdateState_Thread( victim, frame.rui )
			}
		}
	}
}

void function VinsonMythicS26_UpdateUnitFrameBombUI_UpdateState_Thread( entity victim, var rui )
{
	AssertIsNewThread()
	victim.EndSignal( "OnDeath" )

	float timeout = Time() + tunings.bombExplodeTime

	OnThreadEnd(
		function() : ( rui )
		{
			if ( rui != null && RuiIsAlive( rui ) )
			{
				RuiSetBool( rui, "isBeingRevived", false )
			}
		}
	)

	while ( Time() < timeout && rui != null && RuiIsAlive( rui ) )
	{
		bool isBeingRevived = false
		if ( IsValidPlayer( victim ) && Bleedout_IsBleedingOut( victim ) )
		{
			entity reviver = Bleedout_GetRevivingPlayer( victim )
			isBeingRevived = IsValid( reviver )
		}

		if ( !VinsonMythicS26_IsPlayerBombed( victim ) && !isBeingRevived )
			return

		RuiSetBool( rui, "isBeingRevived", isBeingRevived )

		WaitFrame()
	}
}

void function VinsonMythicS26_UpdateBombUIState_Thread( entity player, var rui )
{
	AssertIsNewThread()
	player.EndSignal( "OnDeath" )

	float timeout = Time() + tunings.bombExplodeTime
	bool bombTimerInitialized = false

	OnThreadEnd(
		function() : ( rui )
		{
			if ( rui != null && RuiIsAlive( rui ) )
			{
				RuiSetBool( rui, "isBeingRevived", false )
			}
		}
	)

	while ( Time() < timeout )
	{
		if ( rui == null || !RuiIsAlive( rui ) )
			return

		bool isBeingRevived = false
		if ( IsValidPlayer( player ) && Bleedout_IsBleedingOut( player ) )
		{
			entity reviver = Bleedout_GetRevivingPlayer( player )
			isBeingRevived = IsValid( reviver )
		}

		if ( VinsonMythicS26_IsPlayerBombed( player ) || isBeingRevived )
		{
			if ( !bombTimerInitialized && VinsonMythicS26_IsPlayerBombed( player ) )
			{
				entity playerBomb = null
				foreach( bomb, target in file.bombToTarget )
				{
					if( target == player )
					{
						playerBomb = bomb
						break
					}
				}

				float bombEndTime
				if( IsValid( playerBomb ) && playerBomb in file.bombActualEndTimes )
				{
					bombEndTime = file.bombActualEndTimes[playerBomb]
				}
				else
				{
					bombEndTime = Time() + tunings.bombExplodeTime
				}

				RuiSetBool( rui, "showBombUI", true )
				RuiSetGameTime( rui, "bombEndTime", bombEndTime )
				RuiSetFloat( rui, "bombDuration", tunings.bombExplodeTime )
				bombTimerInitialized = true

				timeout = bombEndTime
			}

			RuiSetBool( rui, "isBeingRevived", isBeingRevived )
		}
		else
		{
			RuiSetBool( rui, "showBombUI", false )
			RuiSetBool( rui, "isBeingRevived", false )
			bombTimerInitialized = false
		}

		WaitFrame()
	}
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________EVO_Action_Score_Messaging___________________________(){}
#endif


string function VinsonMythicS26_EventMythicWeapon02_Helper( int scoreEventID, EvoXPEvent evoXpEvent, entity associatedEntity, int overrideXP, string eventText )
{
	entity player = GetLocalClientPlayer()

	ScoreEvent scoreEvent = ScoreEvent_FromId( scoreEventID )

	if ( overrideXP > 0 )
	{
		string imageStr = evoXpEvent.baseIsTeamXP ? RUI_SQUAD_TRIOS_ICON : RUI_SQUAD_SOLOS_ICON

		if ( EvoXp_IsProgressionLocked_ForPlayer( GetLocalViewPlayer() ) )
		{
			eventText += "`0 " + "#SCORE_EVENT_PROGRESSION_LOCKED" + " " + imageStr
		}
		else
		{
			eventText += "`0 + " + overrideXP + " " + RUI_EVO_ICON  + " " + imageStr
		}
	}

	eventText += "\n ( "
	array<entity> bombDetonateTargets = GetPlayerArrayEx( TEAM_ANY, player.GetTeam(), associatedEntity.GetOrigin(), tunings.bombRadiusMax )
	bool shouldAddComma = false
	for ( int i=0; i < bombDetonateTargets.len(); i++ )
	{
		bool isBombOwner = ( bombDetonateTargets[i] == associatedEntity )

		if ( shouldAddComma )
		{
			eventText += ", "
		}
		else
		{
			shouldAddComma = true
		}

		if ( isBombOwner || !IsAlive( bombDetonateTargets[i] ) )
		{
			eventText += "%$rui/hud/gamestate/player_kills_icon% `1"
		}

		eventText += GetDisplayablePlayerNameFromEHI( ToEHI( bombDetonateTargets[i] ) ) + "`0"
	}

	eventText += " ) "

	return eventText
}



