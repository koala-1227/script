void function BeamstickStave_ShieldMode_Input1Down( var button )
{
	file.isShieldModeButton1Down = true

	if ( !file.isShieldModeButton2Down )
		return

	entity player = GetLocalClientPlayer()

	if ( !BeamstickStave_CanPerformStaveAction( player ) )
		return

	player.Signal( SIG_BEAMSTICK_DRONE_PLACEMENT_MODE_CHANGED )

	Remote_ServerCallFunction( "BeamstickStave_ClientToServer_ToggleShieldMode" )
}

