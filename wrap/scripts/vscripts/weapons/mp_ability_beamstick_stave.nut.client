void function ____GADGET_ACTIONS___________________________(){}
#endif



void function BeamstickStave_HUD_Think( entity player )
{
	AssertIsNewThread()

	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( SIG_BEAMSTICK_PASSIVE_LOST )

	var rui = GetCustomGadgetRui()

	while ( IsValidPlayer( player ) && RuiIsAlive( rui ) )
	{
		RuiSetInt( rui, "maxPipCount", Beamstick_GetMaxStaveCount( player ) )

		RuiSetBool( rui, "inShieldMode", BeamstickStave_IsInShieldMode( player ) )

		bool anyStavesAvailable = false
		array<StaveStateData> staveStates = BeamstickStave_GetStaveStatesFromPackedNetvar( player, player.GetPlayerNetInt( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES ) )
		foreach ( StaveStateData stateData in staveStates )
		{
			if ( stateData.mode == eStaveModeState.REGENERATE )
				continue

			anyStavesAvailable = true
			break
		}
		RuiSetBool( rui, "isShieldModeAvailable", anyStavesAvailable )

		RuiSetBool( rui, "inDronePlacementMode", BeamstickStave_IsInDronePlacementMode( player ) )
		RuiSetBool( rui, "inDronePassiveMode", BeamstickStave_IsInDronePassiveMode( player ) )

		if ( StatusEffect_HasSeverity( player, eStatusEffect.beamstick_stave_shield_cooldown ) )
		{
			float timeRemaining     = StatusEffect_GetTimeRemaining( player, eStatusEffect.beamstick_stave_shield_cooldown )
			float rechargeFrac 		= 1.0 - ( timeRemaining / BeamstickStave_GetCooldownTotal() )
			int rechargeFracRounded = int( rechargeFrac * 100 )

			RuiSetBool( rui, "isShieldModeInCooldown", true )
			RuiSetFloat( rui, "shieldModeCooldownFrac", rechargeFrac )
			RuiSetFloat( rui, "shieldModeCooldownTimeRemaining", timeRemaining )
		}
		else
		{
			RuiSetBool( rui, "isShieldModeInCooldown", false )
			RuiSetFloat( rui, "shieldModeCooldownFrac", 1.0 )
		}

		WaitFrame()
	}
}











