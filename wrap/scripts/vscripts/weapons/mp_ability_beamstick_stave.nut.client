	[eStaveHUDBitStates.BIT_STATE_IDLE] = IDLE_COLOR_DARK * 0.1,
	[eStaveHUDBitStates.BIT_STATE_TURRET_IDLE] = <DRONE_COLOR_DARK.x * 0.075, DRONE_COLOR_DARK.y * 0.075, DRONE_COLOR_DARK.z * 0.075>,
	[eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING] = <DRONE_COLOR_LIGHT.x * 0.05, DRONE_COLOR_LIGHT.y * 0.05, DRONE_COLOR_LIGHT.z * 0.05>,
	[eStaveHUDBitStates.BIT_STATE_SHIELD] = SHIELD_COLOR_DARK * 0.075,
	[eStaveHUDBitStates.BIT_STATE_REGENERATE] = REGEN_COLOR_DARK * 0.1,
}


