vector function GetDroneIdlePos( entity player )
{
	
	
	int attach_id = player.LookupAttachment( "OFFSET" )
	vector attachPos = player.GetAttachmentOrigin( attach_id )
	vector attachAngles = player.GetAttachmentAngles( attach_id )

	vector attachUp = AnglesToUp( attachAngles )
	vector attachRight = AnglesToRight( attachAngles )

	vector pos = attachPos + attachUp* 85 + attachRight *-10

	return pos
}

CompanionFlightParams function GetDroneFlightData()
{
	CompanionFlightParams flightData

	flightData.boundsMin			= DRONE_BOUND_MINS
	flightData.boundsMax			= DRONE_BOUND_MAXS
	flightData.entSpeed				= BeamstickStave_Drone_GetSpeed()
	flightData.initHeightOffset		= DRONE_INIT_HEIGHT_OFFSET
	flightData.minHeightOffset		= DRONE_ORDER_MIN_HEIGHT
	flightData.finalOffset			= DRONE_FINAL_HEIGHT_OFFSET
	flightData.maxPathLength 		= DRONE_MAX_PATH_LEN
	flightData.maxLengthRatio 		= GetCurrentPlaylistVarFloat( PVAR_BEAMSTICK_DRONE_PATHFIND_MAX_LENGTH_RATIO, 1.6 )
	flightData.maxTimeDiff 			= GetCurrentPlaylistVarFloat( PVAR_BEAMSTICK_DRONE_PATHFIND_MAX_TIME_DIFF, 1.8 )
	flightData.doorErrorRadius		= DRONE_DOOR_ERROR_RADIUS
	flightData.doorEnterHeight		= DRONE_ENTER_DOOR_HEIGHT
	flightData.eBailCondition		= ePathfindingBailCondition.TIME_AND_RATIO

	return flightData
}




















































































































































float function BeamstickStave_Drone_GetScanRadius()
{
	float radius = tuning.droneScanRadius

	

	return radius
}
















int function BeamstickStave_GetHUDBitState( entity player, int staveIdx )
{
	if ( !IsValidPlayer( player ) )
		return eStaveHUDBitStates.BIT_STATE_INVALID

	StaveStateData stateData = BeamstickStave_GetStaveState( player, staveIdx )
	switch ( stateData.mode )
	{
		case eStaveModeState.TURRET:
		case eStaveModeState.SEND_OUT:
			switch ( stateData.droneTurretState )
			{
				case eDroneTurretState.FIRING_AT_TARGET:
				case eDroneTurretState.TARGET_ACQUIRED:
					return eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING

				case eDroneTurretState.SEARCHING_FOR_TARGET:
				case eDroneTurretState.TARGET_LOST:
				default:
					return eStaveHUDBitStates.BIT_STATE_TURRET_IDLE
			}

		case eStaveModeState.SHIELD:
			return eStaveHUDBitStates.BIT_STATE_SHIELD

		case eStaveModeState.REGENERATE:
			return eStaveHUDBitStates.BIT_STATE_REGENERATE

		case eStaveModeState.IDLE:
		case eStaveModeState.RECALL:
		default:
			return eStaveHUDBitStates.BIT_STATE_IDLE
	}

	unreachable
}

vector function BeamstickStave_GetHUDVFXColorForBitState( int bitState )
{
	Assert( bitState in STAVE_STATE_VFX_COLORS, "Bit State does not have an assigned color in STAVE_STATE_VFX_COLORS" )
	return STAVE_STATE_VFX_COLORS[bitState]
}

vector function BeamstickStave_GetHUDVFXPositionForBit( int bit, int bitState, int playerState )
{
	switch ( bitState )
	{
		case eStaveHUDBitStates.BIT_STATE_TURRET_IDLE:
		case eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING:

#if SUPPORTS_COMPACT_UI
			if ( IsUsingCompactUILayout() )
			{
				return DRONE_POSITIONS_IDLE_COMPACT[bit]
			}
			else
#endif

			{
				return DRONE_POSITIONS_IDLE[bit]
			}

		case eStaveHUDBitStates.BIT_STATE_SHIELD:
			return STAVE_POSITIONS_SHIELD[bit]

		case eStaveHUDBitStates.BIT_STATE_REGENERATE:
			return STAVE_POSITIONS_IDLE[bit]

		case eStaveHUDBitStates.BIT_STATE_IDLE:
		default:
			if ( playerState == eStavePlayerState.DRONE_MODE_PLACEMENT )
			{
				return DRONE_POSITIONS_PLACEMENT[bit]
			}
			else
			{
				return STAVE_POSITIONS_IDLE[bit]
			}
	}

	unreachable
}

vector function BeamstickStave_GetHUDVFXScaleAlphaForBit( int bit, int bitState, int playerState )
{
	switch ( bitState )
	{
		case eStaveHUDBitStates.BIT_STATE_TURRET_IDLE:
		case eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING:
			return STAVE_VFX_SCALE_ALPHA_DRONE_IDLE

		case eStaveHUDBitStates.BIT_STATE_SHIELD:
			return STAVE_VFX_SCALE_ALPHA_SHIELD

		case eStaveHUDBitStates.BIT_STATE_REGENERATE:
			return STAVE_VFX_SCALE_ALPHA_REGEN

		case eStaveHUDBitStates.BIT_STATE_IDLE:
			if ( playerState == eStavePlayerState.DRONE_MODE_PLACEMENT )
			{
				return STAVE_VFX_SCALE_ALPHA_DRONE_PLACEMENT
			}
			else if ( playerState == eStavePlayerState.SHIELD_MODE )
			{
				return STAVE_VFX_SCALE_ALPHA_SHIELD
			}
			else
			{
				return STAVE_VFX_SCALE_ALPHA_IDLE
			}

		case eStaveHUDBitStates.BIT_STATE_INVALID:
		default:
			return STAVE_VFX_SCALE_ALPHA_INVALID
	}

	unreachable
}

vector function BeamstickStave_GetHUDVFXPositionForBase( int bit, int bitState, int playerState )
{
	switch ( bitState )
	{
		case eStaveHUDBitStates.BIT_STATE_TURRET_IDLE:
		case eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING:

#if SUPPORTS_COMPACT_UI
			if ( IsUsingCompactUILayout() )
			{
				return BASE_VFX_POSITIONS_DRONE_IDLE_COMPACT[bit]
			}
			else
#endif

			{
				return BASE_VFX_POSITIONS_DRONE_IDLE[bit]
			}

		case eStaveHUDBitStates.BIT_STATE_SHIELD:
			return BASE_VFX_POSITIONS_POSITIONS_SHIELD[bit]

		case eStaveHUDBitStates.BIT_STATE_REGENERATE:
			return BASE_VFX_POSITIONS_IDLE[bit]

		case eStaveHUDBitStates.BIT_STATE_IDLE:
			if ( playerState == eStavePlayerState.DRONE_MODE_PLACEMENT )
			{
				return BASE_VFX_POSITIONS_DRONE_PLACEMENT[bit]
			}
			else
			{
				return BASE_VFX_POSITIONS_IDLE[bit]
			}

		case eStaveHUDBitStates.BIT_STATE_INVALID:
		default:
			return BASE_VFX_OFFSCREEN_POS
	}

	unreachable
}

vector function BeamstickStave_GetHUDVFXRadiusAlphaForBase( int playerState )
{
	switch ( playerState )
	{
		case eStavePlayerState.DRONE_MODE_PLACEMENT:
			return BASE_VFX_RING_RADIUS_ALPHA_PLACEMENT_MODE

		case eStavePlayerState.SHIELD_MODE:
			return BASE_VFX_RING_RADIUS_ALPHA_SHIELD_MODE

		default:
			return BASE_VFX_RING_RADIUS_ALPHA_IDLE
	}

	unreachable
}



