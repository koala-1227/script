int function BeamstickStave_GetPlayerState( entity player )
{
	if ( !IsValidPlayer( player ) )
		return eStavePlayerState.NONE

	return player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE )
}



bool function BeamstickStave_IsInDronePlacementMode( entity player )
{
	if ( !IsValidPlayer( player ) )
		return false

	return player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE ) == eStavePlayerState.DRONE_MODE_PLACEMENT
}



bool function BeamstickStave_IsInDronePassiveMode( entity player )
{
	if ( !IsValidPlayer( player ) )
		return false

	return player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE ) == eStavePlayerState.DRONE_MODE_PASSIVE
}

























































































































































































































































































































































































































void function BeamstickStave_Drone_OrderDrone( entity player, entity drone, bool showAR = true, vector ornull overrideOrderPos = null )
{
	OrderPosData companionOrderData
	if ( overrideOrderPos != null )
	{
		companionOrderData.orderType = eOrderType.GROUND
		companionOrderData.orderPos = expect vector(overrideOrderPos)
	}
	else
	{
		companionOrderData = BeamstickStave_Drone_FindDroneOrderPos( player, drone )
	}













}


















































































































































bool function Beamstick_Drone_IsStaveUnderAim( entity player, entity drone )
{
	if ( !IsValidPlayer( player ) )
		return false

	if ( !IsValid( drone ) )
		return false

	if ( GetViewAngleToPos( player, drone.GetOrigin() ) > STAVE_DRONE_RECALL_MAX_ANGLE )
		return false

	return true
}



