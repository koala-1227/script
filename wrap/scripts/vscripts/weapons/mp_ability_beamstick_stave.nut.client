void function BeamstickStave_OnPlayerStaveStateChanged( entity player, int state )
{
	if ( !IsValid( player ) )
		return

	if ( state < 0 )
		return

	player.Signal( SIG_BEAMSTICK_DRONE_PLACEMENT_MODE_CHANGED )

	switch ( state )
	{
		case eStavePlayerState.NONE :
			break
		case eStavePlayerState.IDLE :
			break
		case eStavePlayerState.DRONE_MODE_PLACEMENT :
			if ( IsLocalClientPlayer( player ) )
			{
				thread BeamstickStave_ManageDronePlacementInputHints_Thread( player )
			}
			break
		case eStavePlayerState.DRONE_MODE_PASSIVE :
			break
		case eStavePlayerState.SHIELD_MODE :
			BeamstickStave_UpdateStaveHUD_ShieldMode( player )
			break
	}
}


void function BeamstickStave_Create_Stave_Hud( entity player )
{
	thread BeamstickStave_Create_Stave_Hud_Think( player )
}

void function BeamstickStave_Create_Stave_Hud_Think( entity player )
{
	
	
	AssertIsNewThread()

	if ( !IsInFiringRange() ) 
	{
		wait 2.0
	}

	entity viewPlayer = GetLocalViewPlayer()
	if ( player != GetLocalViewPlayer() )
		return

	if ( file.playerBitStaveHUD != -1 )
		return

	int baseHudEffect = StartParticleEffectOnEntity( viewPlayer, GetParticleSystemIndex( BEAMSTICK_STAVE_HUD_1P ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	EffectSetIsWithCockpit( baseHudEffect, true )
	EffectSetControlPointVector( baseHudEffect, 1, BeamstickStave_GetHUDVFXRadiusAlphaForBase( eStavePlayerState.IDLE ) ) 
	EffectSetControlPointVector( baseHudEffect, 2, BeamstickStave_GetHUDVFXPositionForBase( 0, eStaveHUDBitStates.BIT_STATE_IDLE, eStavePlayerState.IDLE ) ) 	
	EffectSetControlPointVector( baseHudEffect, 3, BeamstickStave_GetHUDVFXPositionForBase( 1, eStaveHUDBitStates.BIT_STATE_IDLE, eStavePlayerState.IDLE ) ) 	
	EffectSetControlPointVector( baseHudEffect, 4, BeamstickStave_GetHUDVFXPositionForBase( 2, eStaveHUDBitStates.BIT_STATE_INVALID, eStavePlayerState.NONE ) ) 	

	file.playerBitStaveHUD = baseHudEffect

	player.EndSignal( "OnDeath", "OnDestroy", SIG_BEAMSTICK_ON_DISCONNECT, SIG_BEAMSTICK_PASSIVE_LOST )

	OnThreadEnd(
		function() : ( baseHudEffect )
		{
			if ( IsValid( baseHudEffect ) )
			{
				EffectStop( baseHudEffect, true, true )
				file.playerBitStaveHUD = -1
			}
		}
	)

	thread BeamstickStaves_HandleBitHudElements_Thread( player, baseHudEffect )
	WaitForever()
}

void function BeamstickStave_UpdateStaveHUD_ShieldMode( entity player )
{
	thread BeamstickStave_UpdateStaveHUD_ShieldMode_Think( player )
}

void function BeamstickStave_UpdateStaveHUD_ShieldMode_Think( entity player )
{
	if ( !IsValid( player ) )
		return

	entity viewPlayer = GetLocalViewPlayer()
	if ( player != GetLocalViewPlayer() )
		return

	EndSignal( player, "OnDeath", "OnDestroy", "BleedOut_OnStartDying", BEAMSTICK_STAVE_SHIELD_DEACTIVATE_SIGNAL )

	file.shieldFx1P = StartParticleEffectOnEntity( viewPlayer, GetParticleSystemIndex( FX_SHIELD_ACTIVE_1P ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	EffectSetIsWithCockpit( file.shieldFx1P, true )
	EffectSetControlPointVector( file.shieldFx1P, 1, < BEAMSTICK_STAVE_SHIELD_1P_IDLE_SCALE, 0, 0 > ) 
	Rumble_Play( "rumble_stim_activate", {} )

	OnThreadEnd(
		function() : ( viewPlayer )
		{
			if ( EffectDoesExist( file.shieldFx1P ) )
			{
				EffectStop( file.shieldFx1P, true, true )
			}

			StartParticleEffectOnEntity( viewPlayer, GetParticleSystemIndex( FX_SHIELD_ENDCAP_1P ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
		}
	)

	bool previousFirstPerson = !player.IsPlayerCameraInThirdPerson()

	while ( player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE ) == eStavePlayerState.SHIELD_MODE )
	{
		bool firstPerson = !player.IsPlayerCameraInThirdPerson()
		if ( firstPerson != previousFirstPerson )
		{
			float scale = firstPerson ? BEAMSTICK_STAVE_SHIELD_1P_IDLE_SCALE : 0.0
			EffectSetControlPointVector( file.shieldFx1P, 0, <scale,0,0> )
			firstPerson = previousFirstPerson
		}

		WaitFrame()
	}
}



void function BeamstickStaves_HandleBitHudElements_Thread( entity player, int baseHudEffect )
{
	AssertIsNewThread()

	if ( !IsValidPlayer( player ) )
		return

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	player.EndSignal( "OnDeath", "OnDestroy", SIG_BEAMSTICK_PASSIVE_LOST )

	int maxStaveCount = Beamstick_GetMaxStaveCount( player )
	int currentStaves = BeamstickStave_GetHealthyStaveCount( player )
	int playerState = BeamstickStave_GetPlayerState( player )
	bool isFirstPerson = !player.IsPlayerCameraInThirdPerson()

	array<int> bitHudVfxElements
	array<int> bitHudStates

	for ( int bit = 0; bit < maxStaveCount; bit++ )
	{
		int state = eStaveHUDBitStates.BIT_STATE_REGENERATE

		if  ( bit < currentStaves )
		{
			state = BeamstickStave_GetHUDBitState( player, bit )
		}

		bitHudVfxElements.append( BeamstickStave_MakeBitHudElement( cockpit, bit, state, playerState ) )
		bitHudStates.append( state )
	}

	OnThreadEnd(
		function() : ( bitHudVfxElements, bitHudStates )
		{
			foreach ( fx in bitHudVfxElements )
			{
				if ( EffectDoesExist( fx ) )
				{
					EffectStop( fx, true, true )
				}
			}
			bitHudVfxElements.clear()
			bitHudStates.clear()
		}
	)

	while ( IsValid( player ) && player.IsPlayer() && IsValid( cockpit ) )
	{
		int remainingStaves = BeamstickStave_GetHealthyStaveCount( player )

		int previousMaxStaveCount = maxStaveCount
		maxStaveCount = Beamstick_GetMaxStaveCount( player )

		if ( bitHudStates.len() != maxStaveCount || bitHudVfxElements.len() != maxStaveCount ) 
		{
			if ( bitHudVfxElements.len() > maxStaveCount )
			{
				
				EffectStop( bitHudVfxElements[bitHudVfxElements.len() -1], true, true )
			}

			bitHudVfxElements.resize( maxStaveCount, -1 )
			bitHudStates.resize( maxStaveCount, eStaveHUDBitStates.BIT_STATE_REGENERATE )
		}

		bool anyBitStatesChanged = false
		array<int> previousBitHudStates

		int previousPlayerState = playerState
		playerState = BeamstickStave_GetPlayerState( player )

		bool previousFirstPerson = isFirstPerson
		isFirstPerson = !player.IsPlayerCameraInThirdPerson()

		for ( int i = 0; i < maxStaveCount; i++ )
		{
			int bitState = BeamstickStave_GetHUDBitState( player, i )
			int previousBitState = bitHudStates[i]

			if ( bitState != previousBitState )
			{
				
				
				if ( !anyBitStatesChanged )
				{
					anyBitStatesChanged = true
					previousBitHudStates = clone bitHudStates
				}

				
				if ( EffectDoesExist( bitHudVfxElements[i] ) )
				{
					EffectStop( bitHudVfxElements[i], true, true )
				}

				
				bitHudVfxElements[i] = BeamstickStave_MakeBitHudElement( cockpit, i, bitState, playerState )

				vector color = BeamstickStave_GetHUDVFXColorForBitState( bitState )
				EffectSetControlPointVector( bitHudVfxElements[i], 3, color )

				
				bitHudStates[i] = bitState
			}
		}

		if ( anyBitStatesChanged || playerState != previousPlayerState || isFirstPerson != previousFirstPerson || maxStaveCount != previousMaxStaveCount )
		{
			BeamstickStave_UpdateBitStavesPosition( player, baseHudEffect, bitHudVfxElements, previousBitHudStates, bitHudStates, previousPlayerState, playerState, previousFirstPerson, isFirstPerson, previousMaxStaveCount, maxStaveCount )
		}

		WaitFrame()
	}
}



int function BeamstickStave_MakeBitHudElement( entity cockpit, int bit, int bitState, int playerState )
{
	asset bitAsset
	vector color = BeamstickStave_GetHUDVFXColorForBitState( bitState )
	int isAttackingElement = 0

	vector screenLocation = BeamstickStave_GetHUDVFXPositionForBit( bit, bitState, playerState )

	switch ( bitState )
	{
		case eStaveHUDBitStates.BIT_STATE_TURRET_ATTACKING:
			isAttackingElement = 1
		case eStaveHUDBitStates.BIT_STATE_TURRET_IDLE:
			bitAsset = Beamstick_Shield_Mode_GetBitAsset( bit )
			break

		case eStaveHUDBitStates.BIT_STATE_SHIELD:
			bitAsset = Beamstick_Shield_Mode_GetBitAsset( bit )
			break

		case eStaveHUDBitStates.BIT_STATE_REGENERATE:
			bitAsset = BEAMSTICK_SHIELD_MODE_BIT_ERROR
			break

		case eStaveHUDBitStates.BIT_STATE_IDLE:
		default:
			bitAsset = Beamstick_Shield_Mode_GetBitAsset( bit )
			break
	}

	int bitViewPiece = StartParticleEffectOnEntity( cockpit, GetParticleSystemIndex( bitAsset ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	EffectSetIsWithCockpit( bitViewPiece, true )

	
	EffectSetControlPointVector( bitViewPiece, 1, screenLocation )

	
	float scale = 1.0
	float alpha = 0.25
	EffectSetControlPointVector( bitViewPiece, 2, < scale, alpha, isAttackingElement > ) 

	
	EffectSetControlPointVector( bitViewPiece, 3, color ) 

	return bitViewPiece
}



asset function Beamstick_Shield_Mode_GetBitAsset( int bit )
{
	return BIT_ASSETS[bit]
}



void function BeamstickStave_UpdateBitStavesPosition( entity player, int baseHudEffect, array<int> bitVfxElements, array<int> previousBitStates, array<int> currentBitStates, int prevPlayerState, int playerState, bool prevFirstPerson, bool isFirstPerson, int prevMaxStaveCount, int maxStaveCount )
{
	thread BeamstickStave_UpdateBitStavesPosition_Thread( player, baseHudEffect, bitVfxElements, previousBitStates, currentBitStates, prevPlayerState, playerState, prevFirstPerson, isFirstPerson, prevMaxStaveCount, maxStaveCount )
}



void function BeamstickStave_UpdateBitStavesPosition_Thread( entity player, int baseHudEffect, array<int> bitVfxElements, array<int> previousBitStates, array<int> currentBitStates, int prevPlayerState, int playerState, bool prevFirstPerson, bool isFirstPerson, int prevMaxStaveCount, int maxStaveCount )
{
	AssertIsNewThread()

	float clientTimeStart = ClientTime()
	player.Signal( SIG_BEAMSTICK_STAVE_VFXHUD_POSITION_THREAD )
	player.EndSignal( "OnDeath", "OnDestroy", SIG_BEAMSTICK_STAVE_VFXHUD_POSITION_THREAD )

	float frac = 0.0
	vector fullAlpha = <1, 0.75, 0>
	vector hideAlpha = <1, 0, 0>

	while ( frac < 1.0 )
	{
		float elapsedTime = ClientTime() - clientTimeStart

		if ( tuning.clientHudBitMoveDuration > 0.0 )
		{
			frac = min( elapsedTime / tuning.clientHudBitMoveDuration, 1.0 )
		}
		else
		{
			frac = 1.0
		}

		for ( int bit = 0; bit < bitVfxElements.len(); bit++ )
		{
			
			bool forceUpdateIndex = ( bit > prevMaxStaveCount - 1 )

			
			int prevState = previousBitStates.len() > bit ? previousBitStates[bit] : currentBitStates[bit]
			int currentState = currentBitStates[bit]

			
			int baseHudEffectCPIdx = bit + 2

			
			if ( IsValid( baseHudEffect ) && EffectDoesExist( baseHudEffect ) )
			{
				vector baseEffectStartPosition = BeamstickStave_GetHUDVFXPositionForBase( bit, prevState, prevPlayerState )
				vector baseEffectEndPosition   = BeamstickStave_GetHUDVFXPositionForBase( bit, currentState, playerState )
				vector baseEffectPosition

				if ( baseEffectStartPosition != baseEffectEndPosition || forceUpdateIndex )
				{
					baseEffectPosition = LerpVector( baseEffectStartPosition, baseEffectEndPosition, EaseOut( frac ) )
					EffectSetControlPointVector( baseHudEffect, baseHudEffectCPIdx, baseEffectPosition )
				}
			}

			if ( bitVfxElements.len() <= bit )
				continue

			if ( !IsValid( bitVfxElements[bit] ) || !EffectDoesExist( bitVfxElements[bit] ) )
				continue

			
			vector startPosition = BeamstickStave_GetHUDVFXPositionForBit( bit, prevState, prevPlayerState )
			vector endPosition = BeamstickStave_GetHUDVFXPositionForBit( bit, currentState, playerState )
			vector position

			if ( startPosition != endPosition || forceUpdateIndex )
			{
				position = LerpVector( startPosition, endPosition, EaseOut( frac ) )
				EffectSetControlPointVector( bitVfxElements[bit], 1, position )
			}

			
			vector startScaleAlpha = BeamstickStave_GetHUDVFXScaleAlphaForBit( bit, prevState, prevPlayerState )
			vector endScaleAlpha = BeamstickStave_GetHUDVFXScaleAlphaForBit( bit, currentState, playerState )
			vector scaleAlpha

			if ( isFirstPerson != prevFirstPerson )
			{
				scaleAlpha = isFirstPerson ? endScaleAlpha : <0, 0, 0>
				EffectSetControlPointVector( bitVfxElements[bit], 2, scaleAlpha )
			}
			else if ( startScaleAlpha != endScaleAlpha || forceUpdateIndex )
			{
				scaleAlpha = LerpVector( startScaleAlpha, endScaleAlpha, EaseOut( frac ) )
				EffectSetControlPointVector( bitVfxElements[bit], 2, scaleAlpha )
			}
		}

		
		if ( IsValid( baseHudEffect ) && EffectDoesExist( baseHudEffect )  )
		{
			if ( maxStaveCount < prevMaxStaveCount )
			{
				for ( int bit = maxStaveCount; bit < prevMaxStaveCount; bit++ )
				{
					
					int baseHudEffectCPIdx = bit + 2
					EffectSetControlPointVector( baseHudEffect, baseHudEffectCPIdx, BASE_VFX_OFFSCREEN_POS )
				}
			}

			
			vector baseEffectRadAlphaStart = BeamstickStave_GetHUDVFXRadiusAlphaForBase( prevPlayerState )
			vector baseEffectRadAlphaEnd = BeamstickStave_GetHUDVFXRadiusAlphaForBase( playerState )
			vector baseEffectRadAlpha

			if ( isFirstPerson != prevFirstPerson )
			{
				baseEffectRadAlpha = isFirstPerson ? baseEffectRadAlphaEnd : <baseEffectRadAlphaEnd.x, 0, baseEffectRadAlphaEnd.z>
				EffectSetControlPointVector( baseHudEffect, 1, baseEffectRadAlpha )
			}
			else if ( baseEffectRadAlphaStart != baseEffectRadAlphaEnd )
			{
				baseEffectRadAlpha = LerpVector( baseEffectRadAlphaStart, baseEffectRadAlphaEnd, EaseOut( frac ) )
				EffectSetControlPointVector( baseHudEffect, 1, baseEffectRadAlpha )		
			}
		}

		WaitFrame()
	}
}


