OrderPosData function BeamstickStave_Drone_FindDroneOrderPos( entity player, entity drone )
{
	OrderPosData orderPosData

	if ( !IsValid( player ) || !IsValid( drone ) )
		return orderPosData









	
	
	vector startTraceInitial = player.EyePosition()
	vector playerViewVector  = player.GetPlayerOrNPCViewVector()
	vector endTraceInitial   = startTraceInitial + playerViewVector * BeamstickStave_Drone_GetRangeBase()
	array<entity> ignoreEnts = [ player, drone ]
	ignoreEnts.extend( GetPlayerArray_Alive() )

	TraceResults trInitial = TraceLine( startTraceInitial, endTraceInitial,ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, player )

	vector orderEndPos = trInitial.endPos
	orderPosData.orderPos    = trInitial.endPos
	orderPosData.arPos = trInitial.endPos
	orderPosData.orderType = eOrderType.AIR

	if ( trInitial.fraction < 0.99 )
	{
		float boundsAdj = fabs(DRONE_BOUND_MAXS.z)*1.5
		vector startHullTrace = trInitial.endPos + (trInitial.surfaceNormal * boundsAdj) + (playerViewVector * -boundsAdj)

		TraceResults trHull = TraceHull( startHullTrace, trInitial.endPos, DRONE_BOUND_MINS*1.5, DRONE_BOUND_MAXS*1.5, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )

		if ( trHull.startSolid )
		{
			
			TraceResults trInitialHullRedo = TraceHull( startTraceInitial, endTraceInitial, DRONE_BOUND_MINS*1.5, DRONE_BOUND_MAXS*1.5, [ ignoreEnts ], DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )

			
			if ( Distance( trHull.endPos, trInitialHullRedo.endPos ) < (3 * METERS_TO_INCHES) )
			{
				startHullTrace = trInitialHullRedo.endPos + (trInitialHullRedo.surfaceNormal * boundsAdj) + (playerViewVector * -boundsAdj)

				trHull = TraceHull( startHullTrace, trInitialHullRedo.endPos, DRONE_BOUND_MINS * 1.5, DRONE_BOUND_MAXS * 1.5, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )
			}
		}

		orderPosData.orderPos    = trHull.endPos
		orderPosData.arNormal = trInitial.surfaceNormal
		orderPosData.orderType = eOrderType.GROUND

		float upDot = DotProduct( trInitial.surfaceNormal, UP_VECTOR )
		float upDotAbs  = fabs( upDot )
		bool normalIsFlat = upDotAbs < DOT_45DEGREE

		if ( normalIsFlat )
		{
			orderPosData.orderType = eOrderType.WALL
			
			vector flatNormal = FlattenNormalizeVec( trInitial.surfaceNormal )

			
			
			vector traceUpStart = trInitial.endPos + (trInitial.surfaceNormal * DRONE_ORDER_LEDGE_CHECK_BACK / 2.0)
			vector traceUpEnd = traceUpStart + (UP_VECTOR * DRONE_ORDER_LEDGE_CHECK_UP )
			TraceResults trUp = TraceLine( traceUpStart, traceUpEnd, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, player )

			if ( trUp.fraction > 0.99 )
			{

				
				
				vector traceBackStart = trUp.endPos
				vector traceBackEnd = traceBackStart - (flatNormal * DRONE_ORDER_LEDGE_CHECK_BACK * 1.5 )
				TraceResults trBack = TraceLine( traceBackStart, traceBackEnd, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, player )

				if ( trBack.fraction > 0.99 )
				{
					vector ledgeStartTrace = trBack.endPos
					vector ledgeEndTrace = ledgeStartTrace - (UP_VECTOR * DRONE_ORDER_LEDGE_CHECK_UP * 2)

					TraceResults trLedge = TraceHull( ledgeStartTrace, ledgeEndTrace, DRONE_BOUND_MINS, DRONE_BOUND_MAXS, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )

					if ( !trLedge.startSolid && trLedge.fraction < 0.99 )
					{
						orderPosData.orderPos = trLedge.endPos
						orderPosData.arPosSecondary = trLedge.endPos
						orderPosData.arNormalSecondary = trLedge.surfaceNormal
						orderPosData.orderType = eOrderType.CORNER
					}
				}
			}
		}
	}


	
	
	vector adjustedPoint = AdjustDronePosForHeight( orderPosData.orderPos, player )
	orderPosData.orderPos  = adjustedPoint







	Assert( orderPosData.orderType != eOrderType.NONE, "FindDroneOrderPos: Tried to find a position but orderType was NONE" )





































































































































	return orderPosData
}

















































































































































vector function AdjustDronePosForHeight( vector proposedCompanionPos , entity player )
{
	vector adjustedPoint = proposedCompanionPos

	
	array<entity> allDronesArr = GetEntArrayByScriptName( BEAMSTICK_DRONE_COMPANION_SCRIPTNAME )
	array<entity> nearbyDrones = GetEntitiesFromArrayNearPos(allDronesArr, proposedCompanionPos, 30.0 )

	
	int dronesToStack = nearbyDrones.len()
	if (dronesToStack > 0)
	{
		
		adjustedPoint = adjustedPoint + <0, 0, -25.0 * dronesToStack>
	}

	bool traceDownHit = false

	array <entity> ignoreEnts = [ player ]
	ignoreEnts.extend( GetPlayerArray_Alive() )

	
	vector endTracePoint    = adjustedPoint - UP_VECTOR * DRONE_ORDER_MIN_HEIGHT
	TraceResults trHullDown = TraceHull( adjustedPoint, endTracePoint, DRONE_BOUND_MINS, DRONE_BOUND_MAXS, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )
	TraceResults trHullUp
	if ( trHullDown.fraction < 1.0 )
	{
		traceDownHit = true

		
		trHullUp = TraceHull( trHullDown.endPos, trHullDown.endPos + UP_VECTOR * DRONE_ORDER_MIN_HEIGHT, DRONE_BOUND_MINS, DRONE_BOUND_MAXS, ignoreEnts, DRONE_COLLISION_MASK, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT, UP_VECTOR, player )

		
		
		adjustedPoint = trHullUp.endPos 
	}

	return adjustedPoint
}

vector function BeamstickStave_Drone_FindAndDisplayOrderPos( entity player, entity drone )
{
	OrderPosData droneOrderData = BeamstickStave_Drone_FindDroneOrderPos( player, drone )






	return droneOrderData.orderPos
}

























































