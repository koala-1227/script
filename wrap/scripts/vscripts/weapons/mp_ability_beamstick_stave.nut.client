int function BeamstickStave_GetCooldownTotal()
{
	return tuning.shieldCooldown
}















































































































































































array<StaveStateData> function BeamstickStave_GetStaveStatesFromPackedNetvar( entity player, int packedStaveStates )
{
	array<StaveStateData> staveStates

	for ( int idx = 0; idx < Beamstick_GetMaxStaveCount( player ); idx++ )
	{
		StaveStateData stateData = BeamstickStave_GetStaveState( player, idx )
		staveStates.append( stateData )
	}

	return staveStates
}

StaveStateData function BeamstickStave_GetStaveState( entity player, int staveIndex )
{
	StaveStateData stateData

	if ( !IsValidPlayer( player ) )
		return stateData

	int packedStaveStates 		= player.GetPlayerNetInt( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES )
	int baseGroupShift 			= staveIndex * GROUPS_PER_STAVE
	stateData.mode 				= ( packedStaveStates >> ( ( baseGroupShift + 0 ) * BITS_PER_GROUP ) ) & 0xF
	stateData.droneTurretState 	= ( packedStaveStates >> ( ( baseGroupShift + 1 ) * BITS_PER_GROUP ) ) & 0xF

	return stateData
}

int function BeamstickStave_SortStaves( StaveStateData a, StaveStateData b )
{
	bool aIsShield = a.mode == eStaveModeState.SHIELD
	bool bIsShield = b.mode == eStaveModeState.SHIELD

	bool aIsIdle = a.mode == eStaveModeState.IDLE || a.mode == eStaveModeState.RECALL
	bool bIsIdle = b.mode == eStaveModeState.IDLE || b.mode == eStaveModeState.RECALL

	bool aIsRegen = a.mode == eStaveModeState.REGENERATE
	bool bIsRegen = b.mode == eStaveModeState.REGENERATE

	bool aIsTurret = a.mode == eStaveModeState.TURRET || a.mode == eStaveModeState.SEND_OUT
	bool bIsTurret = b.mode == eStaveModeState.TURRET || b.mode == eStaveModeState.SEND_OUT

	
	if ( aIsShield && !bIsShield )
	{
		return -1
	}
	else if ( !aIsShield && bIsShield )
	{
		return 1
	}
	else if ( aIsShield && bIsShield )
	{
		
		if ( a.staveHP > b.staveHP )
		{
			return -1
		}
		else if ( a.staveHP < b.staveHP )
		{
			return 1
		}
		else
		{
			return 0
		}
	}

	
	if ( aIsTurret && !bIsTurret )
	{
		return -1
	}
	else if ( !aIsTurret && bIsTurret )
	{
		return 1
	}
	else if ( aIsTurret && bIsTurret )
	{
		return 0
	}

	
	if ( aIsIdle && !bIsIdle )
	{
		return -1
	}
	else if ( !aIsIdle && bIsIdle )
	{
		return 1
	}
	else if ( aIsIdle && bIsIdle )
	{
		return 0
	}

	
	if ( aIsRegen && !bIsRegen )
	{
		return -1
	}
	else if ( !aIsRegen && bIsRegen )
	{
		return 1
	}
	else
	{
		return 0
	}

	unreachable
}

array<int> function BeamstickStave_GetStaveHealthFromPackedNetvar( entity player, int packedStaveHealth )
{
	array<int> staveHealth

	for ( int idx = 0; idx < Beamstick_GetMaxStaveCount( player ); idx++ )
	{
		int health = BeamstickStave_GetStaveHealth( player, idx )
		staveHealth.append( health )
	}

	return staveHealth
}

int function BeamstickStave_GetStaveHealth( entity player, int staveIndex )
{
	if ( !IsValidPlayer( player ) )
		return -1

	int packedStaveHealth		= player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_CURRENT_HEALTH )
	return ( packedStaveHealth >> ( staveIndex * HEALTH_BITS_PER_STAVE ) ) & HEALTH_MASK
}



void function BeamstickStave_OnPackedStaveStatesChanged( entity player, int packedStaveStates )
{
	if ( !IsValidPlayer( player ) )
		return

	if ( !IsLocalViewPlayer( player ) )
		return

	if ( packedStaveStates <= 0 )
		return

	const int MAX_SUPPORTED_STAVE_PIPS_UI = 4

	array<StaveStateData> staveStates = BeamstickStave_GetStaveStatesFromPackedNetvar( player, packedStaveStates )

	if ( staveStates.len() <= 0 )
		return

	
	for ( int i = 0; i < MAX_SUPPORTED_STAVE_PIPS_UI; i++ )
	{
		if ( file.worldspaceStaveRuis.len() > i && RuiIsAlive( file.worldspaceStaveRuis[i] ) )
		{
			bool isStaveAttacking = staveStates[i].mode == eStaveModeState.TURRET && staveStates[i].droneTurretState == eDroneTurretState.FIRING_AT_TARGET
			RuiSetBool( file.worldspaceStaveRuis[i], "isAttacking", isStaveAttacking )
		}
	}

	
	staveStates.sort( BeamstickStave_SortStaves )

	
	var rui = GetCustomGadgetRui()
	if ( rui != null && RuiIsAlive( rui ) )
	{
		for ( int i = 0; i < MAX_SUPPORTED_STAVE_PIPS_UI; i++ )
		{
			if ( staveStates.len() > i )
			{
				RuiSetIntIfExists( rui, "staveState" + string( i ), staveStates[i].mode )
			}
			else
			{
				RuiSetIntIfExists( rui, "staveState" + string( i ), -1 )
			}
		}
	}
}

void function BeamstickStave_OnPackedStaveHealthChanged( entity player, int packedStaveHealth )
{
	if ( !IsValidPlayer( player ) )
		return

	if ( !IsLocalViewPlayer( player ) )
		return

	int packedStaveStates 		= player.GetPlayerNetInt( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES )
	array<StaveStateData> staveStates = BeamstickStave_GetStaveStatesFromPackedNetvar( player, packedStaveStates )
	array<int> staveHealth = BeamstickStave_GetStaveHealthFromPackedNetvar( player, packedStaveHealth )

	
	for ( int i = 0; i < staveStates.len(); i++ )
	{
		if ( i >= staveHealth.len() )
			break

		
		staveStates[i].staveHP = staveHealth[i] / 100.0
	}

	staveStates.sort( BeamstickStave_SortStaves )

	const int MAX_SUPPORTED_STAVE_PIPS_UI = 4

	var rui = GetCustomGadgetRui()
	if ( rui != null && RuiIsAlive( rui ) )
	{
		for ( int i = 0; i < MAX_SUPPORTED_STAVE_PIPS_UI; i++ )
		{
			if ( staveStates.len() > i )
			{
				RuiSetFloatIfExists( rui, "staveFrac" + string( i ), staveStates[i].staveHP )
			}
			else
			{
				RuiSetFloatIfExists( rui, "staveFrac" + string( i ), -1 )
			}
		}
	}
}


