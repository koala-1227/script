bool function BeamstickStave_IsEnabled()
{
	return GetCurrentPlaylistVarBool( "beamstick_stave_enabled", false )
}

void function BeamstickStave_Init()
{
	if ( !BeamstickStave_IsEnabled() )
	{
		SURVIVAL_Loot_AddDisabledRef( BEAMSTICK_STAVE_WEAPON_REF )
		return
	}

	RegisterTuningStruct( "tuning", "beamstick_stave_" )
	BeamstickStave_Drone_Setup()

	PrecacheModel( BEAMSTICK_STAVE_STAVE_MODEL )
	PrecacheModel( BEAMSTICK_STAVE_DRONE_MODEL )
	PrecacheModel( BEAMSTICK_STAVE_SHIELD_MODEL )

	PrecacheParticleSystem( BEAMSTICK_STAVE_HUD_1P )
	PrecacheParticleSystem( BEAMSTICK_SHIELD_MODE_BIT_ERROR )
	PrecacheParticleSystem( BEAMSTICK_DRONE_HOVER_OVER_AR )

	foreach ( fx in BIT_ASSETS )
	{
		PrecacheParticleSystem( fx )
	}

	PrecacheParticleSystem( FX_SHIELD_ACTIVE_1P )
	PrecacheParticleSystem( FX_SHIELD_ENDCAP_1P )
	PrecacheParticleSystem( FX_SHIELD_ACTIVATION_3P )
	PrecacheParticleSystem( FX_SHIELD_ACTIVE_3P )
	PrecacheParticleSystem( FX_SHIELD_HIT_3P )
	PrecacheParticleSystem( FX_SHIELD_BREAK_3P )

	AddCallback_OnPassiveChanged( ePassives.PAS_BEAMSTICK_STAVE, BeamstickStave_OnPassiveChanged )
	RegisterNetworkedVariable( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE, SNDC_PLAYER_GLOBAL, SNVT_INT, eStavePlayerState.NONE )
	RegisterNetworkedVariable( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES, SNDC_PLAYER_GLOBAL, SNVT_BIG_INT, 0 )
	RegisterNetworkedVariable( NETVAR_BEAMSTICK_STAVE_CURRENT_HEALTH, SNDC_PLAYER_GLOBAL, SNVT_BIG_INT, 0 )

	AddCallback_OnPlayerMatchStateChanged( BeamstickStave_OnPlayerMatchStateChanged )




















	RegisterSignal( BEAMSTICK_STAVE_SHIELD_DEACTIVATE_SIGNAL )
	RegisterSignal( SIG_BEAMSTICK_ON_DISCONNECT )
	RegisterSignal( SIG_BEAMSTICK_PASSIVE_LOST )


		RegisterNetVarIntChangeCallback( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE, BeamstickStave_OnPlayerStaveStateChanged )
		RegisterNetVarIntChangeCallback( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES, BeamstickStave_OnPackedStaveStatesChanged )
		RegisterNetVarIntChangeCallback( NETVAR_BEAMSTICK_STAVE_CURRENT_HEALTH, BeamstickStave_OnPackedStaveHealthChanged )

		RegisterSignal( BEAMSTICK_STAVE_GADGET_RELEASE_SIGNAL )
		RegisterSignal( SIG_BEAMSTICK_STAVE_VFXHUD_POSITION_THREAD )
		AddCallback_OnControllerModeChanged( BeamstickStave_OnControllerModeChanged )
		Survival_AddInventorySlotVisibilityCallback( "gadgetslot", Beamstick_ShouldShowGadgetSlot )
		Survival_AddInventoryPreventGadgetSlotUnequipCallback( BeamstickStave_ShouldPreventGadgetUnequip )
		AddCallback_OnClientScriptInit( Beamstick_RegisterTooltipCallback )
		AddCallback_OnPlayerDisconnected( BeamstickStave_OnPlayerDisconnected )
		AddCallback_GameStateEnter( eGameState.WinnerDetermined, BeamstickStave_OnWinnerDetermined )


	Remote_RegisterServerFunction( "BeamstickStave_ClientToServer_ToggleShieldMode" )
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_EnableStaveHUD", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_ClientSetBeamstickUI", "entity" )
}

void function BeamstickStave_Drone_Setup()
{
	file.droneModeEnabled = GetCurrentPlaylistVarBool( PVAR_BEAMSTICK_DRONE_ENABLED, file.droneModeEnabled )

	if ( !file.droneModeEnabled )
		return

	
	PrecacheScriptString( BEAMSTICK_DRONE_COMPANION_SCRIPTNAME )

	
	PrecacheParticleSystem( FX_TURRET_ON_RECALL )
	PrecacheParticleSystem( FX_TURRET_ON_RECALL_ENEMY )
	PrecacheParticleSystem( FX_COMPANION_ORDER_AR_GROUND )
	PrecacheParticleSystem( FX_COMPANION_ORDER_AR_WALL )
	PrecacheParticleSystem( FX_COMPANION_ORDER_AR_CORNER )
	PrecacheParticleSystem( FX_COMPANION_ORDER_AR_CORNER_TOP )
	PrecacheParticleSystem( FX_COMPANION_ORDER_AR_AIR )

	PrecacheParticleSystem( FX_ZONE_PREVIEW )
	PrecacheParticleSystem( FX_COMPANION_TRAIL )
	PrecacheParticleSystem( FX_COMPANION_TRAIL_ENEMY )

	PrecacheParticleSystem( FX_FIRE_BOLT_HIT )
	PrecacheParticleSystem( FX_DRONE_LOCKED_ON )
	PrecacheParticleSystem( FX_TARGETING_LASER )
	PrecacheParticleSystem( FX_TARGETING_LASER_ENEMY )

	PrecacheParticleSystem( FX_TURRET_DESTROYED )

	foreach ( fx in BIT_RETURN_FX )
	{
		PrecacheParticleSystem( fx )
	}

	
	RegisterSignal( SIG_BEAMSTICK_DRONE_END_LIFETIME )
	RegisterSignal( SIG_BEAMSTICK_DRONE_PATHFINDING_ROUTE_CLEARED )
	RegisterSignal( SIG_BEAMSTICK_DRONE_PLACEMENT_MODE_CHANGED )
	RegisterSignal( SIG_BEAMSTICK_DRONE_RECALL_ACTION )
	RegisterSignal( SIG_BEAMSTICK_DRONE_END_FX_PREVIEW )






	

		AddCreateCallback( "player", BeamstickStave_OnPlayerCreated )


	
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_Messaging", "entity", "int", -1, 16 )
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_Drone_CreateARIndicator", "entity", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_Drone_CreateWaypointIndicator", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_BeamstickStave_Drone_CreatePreviewFx", "entity", "entity" )

	
	tuning.droneBaseSpeed = GetCurrentPlaylistVarFloat( PVAR_BEAMSTICK_DRONE_SPEED_BASE, tuning.droneBaseSpeed )
	tuning.droneScanRadius = GetCurrentPlaylistVarFloat( PVAR_BEAMSTICK_DRONE_SCAN_RADIUS, tuning.droneScanRadius )
	tuning.cooldownBetweenShots = GetCurrentPlaylistVarFloat( PVAR_BEAMSTICK_DRONE_COOLDOWN_BETWEEN_SHOTS, tuning.cooldownBetweenShots )
	tuning.damage = GetCurrentPlaylistVarInt( PVAR_BEAMSTICK_DRONE_DAMAGE, tuning.damage )
	tuning.enableRecallOnResend = GetCurrentPlaylistVarBool( PVAR_BEAMSTICK_DRONE_ENABLE_RECALL_ON_RESEND, tuning.enableRecallOnResend )
}

bool function BeamstickStave_IsValidRef( string ref )
{
	return ref.find( BEAMSTICK_STAVE_WEAPON_REF ) != -1
}

bool function IsInFiringRange()
{
	return file.isInFiringRange
}

bool function IsTrainingDummieDead( entity dummie )
{
	return IsTrainingDummie( dummie ) && dummie.GetHealth() <= 0
}

