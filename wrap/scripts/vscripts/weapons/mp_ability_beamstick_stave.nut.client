void function BeamstickStave_SetupGadgetSlotInputUI()
{
	bool isControllerMode = IsControllerModeActive()
	BeamstickStave_UpdateInputBindingUI( isControllerMode )
}

void function BeamstickStave_CleanupUI()
{
	entity player = GetLocalClientPlayer()

	if ( IsInFiringRange() )
	{
		player.Signal( SIG_BEAMSTICK_PASSIVE_LOST )
		ResetToDefaultGadgetRui()
	}
}

void function BeamstickStave_OnPlayerCreated( entity player )
{
	if ( IsInFiringRange() )
		return

	if ( !IsValidPlayer( player ) )
		return

	if ( !IsLocalViewPlayer( player ) )
		return

	CreateCustomGadgetRui( $"ui/beamstick_stave_gadget_slot.rpak" )
	thread BeamstickStave_HUD_Think( player )
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function ____INPUT_UI___________________________(){}
#endif

void function BeamstickStave_UpdateInputBindingUI( bool isControllerMode )
{
	var customGadgetRui = GetCustomGadgetRui()

	if ( customGadgetRui == null )
		return

	
	string droneModePrompt = Localize( "#BEAMSTICK_STAVE_MODE_PROMPT", "%" + STAVE_COMMAND_HOLD.slice(1) + "%" )
	RuiSetString( customGadgetRui, "droneModePromptText", droneModePrompt )

	if ( isControllerMode )
	{
		string shieldModePrompt = Localize( "#GEAR_SLOT_PROMPT_SHIELD_MODE", STAVE_COMMAND_SHIELD_MODE_1, STAVE_COMMAND_SHIELD_MODE_2 )
		RuiSetString( customGadgetRui, "shieldModePromptText", shieldModePrompt )
	}
	else
	{
		string shieldModePrompt = "%" + STAVE_SHIELD_MODE_TAP.slice(1) + "%"
		RuiSetString( customGadgetRui, "shieldModePromptText", shieldModePrompt )
	}
}

void function BeamstickStave_ManageDronePlacementInputHints_Thread( entity player )
{
	AssertIsNewThread()

	if ( !IsValidPlayer( player ) )
		return

	player.Signal( SIG_BEAMSTICK_DRONE_PLACEMENT_MODE_CHANGED )
	player.EndSignal( SIG_BEAMSTICK_DRONE_PLACEMENT_MODE_CHANGED, "OnDeath", "OnDestroy" )

	vector pos = player.GetOrigin() + <0, 0, 16>
	var placementRui = CreateCockpitPostFXRui( BEAMSTICK_DRONE_PLACEMENT_HINT_RUI, RuiCalculateDistanceSortKey( player.EyePosition(), pos ) )

	file.placementRui = placementRui

	OnThreadEnd(
		function() : ( placementRui ) {
			RuiDestroyIfAlive( placementRui )
			file.placementRui = null
		}
	)

	
	while ( RuiIsAlive( placementRui ) && IsValidPlayer( player ) )
	{
		array<StaveStateData> staveStates = BeamstickStave_GetStaveStatesFromPackedNetvar( player, player.GetPlayerNetInt( NETVAR_BEAMSTICK_CURRENT_STAVE_STATES ) )

		int availableCount = 0
		int idleCount = 0
		int turretCount = 0
		int regenCount = 0
		int shieldCount = 0

		foreach ( StaveStateData stateData in staveStates )
		{
			if ( stateData.mode == eStaveModeState.REGENERATE )
			{
				regenCount++
				continue
			}

			availableCount++

			switch ( stateData.mode )
			{
				case eStaveModeState.IDLE:
				case eStaveModeState.RECALL:
					idleCount++
					break

				case eStaveModeState.SHIELD:
					shieldCount++
					break

				case eStaveModeState.TURRET:
				case eStaveModeState.SEND_OUT:
					turretCount++
					break
			}
		}

		
		string sendDronePromptStringToken = idleCount > 0 ? "#DRONE_PLACEMENT_MODE_SEND_DRONE" : "#DRONE_PLACEMENT_MODE_RELOCATE_OLDEST_DRONE"
		bool sendDronePromptTextVisible = availableCount > 0 ? true : false
		bool sendDronePromptTextDisabled = false
		string sendDronePromptText = Localize( sendDronePromptStringToken, "%" + STAVE_COMMAND_SEND_DRONE.slice(1) + "%" )

		
		bool anyDronesUnderAim = false
		foreach ( entity drone in file.placedTurrets )
		{
			if ( Beamstick_Drone_IsStaveUnderAim( player, drone ) )
			{
				anyDronesUnderAim = true
				break
			}
		}

		
		string recallSinglePromptStringToken = "#DRONE_PLACEMENT_MODE_RECALL_DRONE"
		bool recallSinglePromptTextVisible = anyDronesUnderAim ? true : false
		bool recallSinglePromptTextDisabled = false
		string recallSinglePromptText = Localize( recallSinglePromptStringToken, "%" + STAVE_COMMAND_RECALL.slice(1) + "%" )

		
		string recallAllPromptStringToken = "#DRONE_PLACEMENT_MODE_RECALL_ALL_DRONES"
		bool recallAllPromptTextVisible = turretCount > 0 ? true : false
		bool recallAllPromptTextDisabled = false
		string recallAllPromptText = Localize( recallAllPromptStringToken, "%" + STAVE_COMMAND_RECALL.slice(1) + "%" )

		
		string exitPlacementPromptStringToken = "#DRONE_PLACEMENT_MODE_EXIT"
		bool exitPlacementPromptTextVisible = true
		bool exitPlacementPromptTextDisabled = false
		string exitPlacementPromptText = Localize( exitPlacementPromptStringToken, "%" + STAVE_EXIT_DRONE_MODE_PROMPT.slice(1) + "%" )

		
		string shieldModePromptStringToken = "#DRONE_PLACEMENT_MODE_SWITCH_TO_SHIELD_MODE"

		bool isShieldModeOnCooldown = false
		if ( StatusEffect_HasSeverity( player, eStatusEffect.beamstick_stave_shield_cooldown ) )
		{
			float timeRemaining = StatusEffect_GetTimeRemaining( player, eStatusEffect.beamstick_stave_shield_cooldown )
			isShieldModeOnCooldown = timeRemaining > FLT_EPSILON
		}

		bool shieldModePromptTextVisible = true
		bool shieldModePromptTextDisabled = availableCount <= 0 || isShieldModeOnCooldown ? true : false
		string shieldModeKeybind = IsControllerModeActive() ? Localize( "#GEAR_SLOT_PROMPT_SHIELD_MODE", STAVE_COMMAND_SHIELD_MODE_1, STAVE_COMMAND_SHIELD_MODE_2 ) : "%" + STAVE_SHIELD_MODE_TAP.slice(1) + "%"
		string shieldModePromptText = Localize( shieldModePromptStringToken, shieldModeKeybind )


		RuiSetString( placementRui, "promptText0", sendDronePromptText )
		RuiSetBool( placementRui, "promptVisible0", sendDronePromptTextVisible )
		RuiSetBool( placementRui, "promptDisabled0", sendDronePromptTextDisabled )

		RuiSetString( placementRui, "promptText1", recallSinglePromptText )
		RuiSetBool( placementRui, "promptVisible1", recallSinglePromptTextVisible )
		RuiSetBool( placementRui, "promptDisabled1", recallSinglePromptTextDisabled )

		RuiSetString( placementRui, "promptText2", recallAllPromptText )
		RuiSetBool( placementRui, "promptVisible2", recallAllPromptTextVisible )
		RuiSetBool( placementRui, "promptDisabled2", recallAllPromptTextDisabled )

		RuiSetString( placementRui, "promptText3", exitPlacementPromptText )
		RuiSetBool( placementRui, "promptVisible3", exitPlacementPromptTextVisible )
		RuiSetBool( placementRui, "promptDisabled3", exitPlacementPromptTextDisabled )

		RuiSetString( placementRui, "promptText4", shieldModePromptText )
		RuiSetBool( placementRui, "promptVisible4", shieldModePromptTextVisible )
		RuiSetBool( placementRui, "promptDisabled4", shieldModePromptTextDisabled )

		WaitFrame()
	}
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function ____INVENTORY___________________________(){}
#endif


bool function Beamstick_ShouldShowGadgetSlot()
{
	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return false

	return PlayerHasPassive( player, ePassives.PAS_BEAMSTICK_STAVE )
}

bool function BeamstickStave_ShouldPreventGadgetUnequip( entity player )
{
	if ( !IsValid( player ) )
		return false

	if ( IsInFiringRange() )
		return false

	return PlayerHasPassive( player, ePassives.PAS_BEAMSTICK_STAVE )
}

void function Beamstick_RegisterTooltipCallback( entity player )
{
	AddCallback_OnUpdateTooltip( eTooltipStyle.DEFAULT, Beamstick_OnUpdateTooltip )
}

void function BeamstickStave_OnPlayerDisconnected( entity player )
{
	if ( !IsValidPlayer( player ) )
		return

	player.Signal( SIG_BEAMSTICK_ON_DISCONNECT )
}



void function Beamstick_OnUpdateTooltip( int style, ToolTipData tooltipData )
{
	entity player = GetLocalViewPlayer()

	if ( !PlayerHasPassive( player, ePassives.PAS_BEAMSTICK_STAVE ) )
		return

	entity gadget = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_GADGET )
	if ( !IsValid( gadget ) )
		return

	if ( gadget.GetWeaponClassName() != BEAMSTICK_STAVE_WEAPON_REF )
		return

	if ( tooltipData.titleText == "#BEAMSTICK_STAVE_NAME" )
		return

	if ( tooltipData.titleText.find( "#ENDORSEMENT" ) != -1 )
		return

	string beamStickLocalizedName = Localize( "#BEAMSTICK_STAVE_NAME" )
	if ( tooltipData.titleText.find( beamStickLocalizedName ) == -1 )
		return

	tooltipData.titleText = "#BEAMSTICK_STAVE_NAME"
	tooltipData.descText = IsControllerModeActive() ? "#BEAMSTICK_STAVE_TOOLTIP_CONTROLLER_DESC" : "#BEAMSTICK_STAVE_TOOLTIP_KEYBOARD_DESC"
	tooltipData.actionHint1 = ""
	tooltipData.actionHint2 = ""
	tooltipData.actionHint3 = ""
	tooltipData.actionHint4 = ""
}


