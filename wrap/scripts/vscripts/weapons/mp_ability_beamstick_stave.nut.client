void function ServerToClient_BeamstickStave_Drone_CreateWaypointIndicator( entity droneEnt )
{
	thread BeamstickStave_Drone_CreateHUDMarker_Thread( droneEnt )
}

void function BeamstickStave_Drone_CreateHUDMarker_Thread( entity drone )
{
	AssertIsNewThread()

	entity localViewPlayer = GetLocalViewPlayer()

	if ( !IsValidPlayer( localViewPlayer ) )
		return

	if ( !IsValid( drone ) )
		return

	if ( localViewPlayer != drone.GetOwner() )
		return

	
	if ( file.placedTurrets.contains( drone ) )
		return

	EndSignal( drone, "OnDestroy", SIG_BEAMSTICK_DRONE_RECALL_ACTION, SIGNAL_WAYPOINT_DESTROY )
	EndSignal( localViewPlayer, "OnDeath", "OnDestroy", SIG_BEAMSTICK_DRONE_RECALL_ACTION )

	file.placedTurrets.append( drone )

	var rui = CreateFullscreenRui( $"ui/worldspace_icon_beamstick.rpak", -1 )
	file.worldspaceStaveRuis.append( rui )

	OnThreadEnd( function() : ( rui, drone )
	{
		file.placedTurrets.removebyvalue( drone )

		file.worldspaceStaveRuis.removebyvalue( rui )
		RuiDestroyIfAlive( rui )
	})

	RuiSetResolutionToScreenSize( rui )
	RuiTrackFloat3( rui, "worldPos", drone, RUI_TRACK_ABSORIGIN_FOLLOW )
	RuiTrackFloat3( rui, "entAngles", drone, RUI_TRACK_EYEANGLES_FOLLOW )
	RuiSetAsset( rui, "icon", $"rui/hud/wildcard_huds/beamstick_staves/beamstick_stave_attack_icon" )
	RuiSetFloat2( rui, "iconSize", <32, 32, 0> )
	RuiSetColorAlpha( rui, "iconPadding", <17.0, 19.0, 19.0>, 17.0 )	

	RuiSetColorAlpha( rui, "iconColor", SrgbToLinear( ( DRONE_COLOR_LIGHT * 1.2 ) / 255.0 ), 1.0 )
	RuiSetColorAlpha( rui, "frameColor", SrgbToLinear( ( DRONE_COLOR_LIGHT * 1.2 ) / 255.0 ), 1.0 )

	RuiSetColorAlpha( rui, "backgroundColor", <0, 0, 0>, 0.9 )

	RuiSetBool( rui, "screenEdgeClampingEnabled", true )
	RuiSetBool( rui, "screenEdgeClampingHideIconWhileOnScreen", true )

	float distanceEffectsStartRange = tuning.droneMaxRange * 0.65

	RuiSetBool( rui, "maxDistanceScalingEnabled", true )
	RuiSetFloat( rui, "maxDistanceScalingStartUnits", distanceEffectsStartRange )
	RuiSetFloat( rui, "maxDistanceScalingEndUnits", tuning.droneMaxRange )
	RuiSetFloat( rui, "maxDistanceScalingAtScaleEnd", 0.7 )

	RuiSetBool( rui, "maxDistancePulsingEnabled", true )
	RuiSetFloat( rui, "maxDistancePulsingStartUnits", distanceEffectsStartRange )
	RuiSetFloat( rui, "maxDistancePulsingEndUnits", tuning.droneMaxRange )

	RuiSetFloat( rui, "maxDistancePulsingStartFrequency", 0.5 )
	RuiSetFloat( rui, "maxDistancePulsingEndFrequency", 1.75 )

	RuiSetBool( rui, "maxDistancePulsingEffectsAlpha", true )
	RuiSetFloat( rui, "maxDistancePulsingMinAlpha", 0.4 )
	RuiSetFloat( rui, "maxDistancePulsingMaxAlpha", 1.0 )

	RuiSetBool( rui, "distanceTextColoredByDistance", true )
	RuiSetColorAlpha( rui, "distanceTextColorStart", <1, 1, 1>, 1.0 )
	RuiSetColorAlpha( rui, "distanceTextColorMiddle", SrgbToLinear( GetKeyColor( COLORID_DANGER_WARNING_YELLOW ) / 255.0 ), 1.0 )
	RuiSetColorAlpha( rui, "distanceTextColorEnd", SrgbToLinear( GetKeyColor( COLORID_DANGER_WARNING_ORANGE ) / 255.0 ), 1.0 )
	RuiSetFloat( rui, "distanceTextColorStartUnits", distanceEffectsStartRange )
	RuiSetFloat( rui, "distanceTextColorEndUnits", tuning.droneMaxRange )

	WaitForever()
}

