enum eStavePlayerState
{
	NONE,
	IDLE,
	DRONE_MODE_PLACEMENT,
	DRONE_MODE_PASSIVE,
	SHIELD_MODE,
}

global enum eStaveModeState
{
	INVALID,
	IDLE,
	TURRET,
	SEND_OUT,
	SHIELD,
	REGENERATE,
	RECALL
}

enum eDroneTurretState
{
	INVALID,
	SEARCHING_FOR_TARGET,
	TARGET_ACQUIRED,
	TARGET_LOST,
	FIRING_AT_TARGET
}


const int BITS_PER_GROUP = 4
const int GROUPS_PER_STAVE = 2


const int HEALTH_BITS_PER_STAVE   = 7
const int HEALTH_MASK   = ( 1 << HEALTH_BITS_PER_STAVE ) - 1;

struct StaveStateData
{
	int mode = eStaveModeState.INVALID
	int droneTurretState = eDroneTurretState.INVALID
	float staveHP = -1.0
}

enum eStaveHUDBitStates
{
	BIT_STATE_INVALID = -1,
	BIT_STATE_IDLE,
	BIT_STATE_TURRET_IDLE,
	BIT_STATE_TURRET_ATTACKING,
	BIT_STATE_SHIELD,
	BIT_STATE_REGENERATE
}

struct StaveEffects
{
	entity droneAREffect = null
	entity droneTrailEffect = null
	entity droneTrailEffect_Enemy = null
}

struct Stave
{
	float hp = BEAMSTICK_STAVE_STAVE_HP
	int mode = eStaveModeState.IDLE
	entity staveEntity
	entity staveDroneEntity
	vector ornull orderPosOrNull
	CompanionData companionData
	entity ornull droneTarget
	int droneTurretState = eDroneTurretState.INVALID
	float lastDamageTaken = 0.0 
	entity droneTrigger
	array<entity> playersInDroneTrigger
	float dronePlacedTimestamp = -1.0
	bool hasDroneArrived = false
	bool isDroneNavigating = false
	StaveEffects staveEffects
}

struct StavesData
{
	array<Stave> staves
	entity shieldEntity = null
}

enum eOrderType
{
	NONE,
	GROUND,
	WALL,
	AIR,
	CORNER
}

struct OrderPosData
{
	vector	orderPos = ZERO_VECTOR
	vector	arPos = ZERO_VECTOR
	vector	arNormal = ZERO_VECTOR
	vector	arPosSecondary = ZERO_VECTOR
	vector	arNormalSecondary = ZERO_VECTOR
	int		orderType = eOrderType.NONE
}

