bool function BeamstickStave_CanPerformStaveAction( entity player )
{
	if ( !IsValidPlayer( player ) )
		return false

	if ( player.IsNPC() )
		return false


		if ( !IsLocalClientPlayer( player ) )
			return false


	if ( !IsAlive( player ) )
		return false

	if ( Bleedout_IsBleedingOut( player ) )
		return false

	
	if ( IsVantagePerformingTactical( player ) )
		return false

	if ( IsPlayerInCryptoDroneCameraView( player ) )
		return false






	return true
}



bool function IsVantagePerformingTactical( entity player )
{
	entity weapon = player.GetOffhandWeapon( eOffhandInv.EQUIPMENT )

	if ( !IsValid( weapon ) )
		return false

	entity activeWeapon = player.GetActiveWeapon( weapon.GetOffhandActiveSlot() )
	if ( IsValid( activeWeapon ) && activeWeapon.GetWeaponClassName() == VANTAGE_RECALL_WEAPON_NAME )
		return true

	if ( VantageCompanion_GetPlayerLaunchState( player ) == ePlayerLaunchState.LAUNCHING )
		return true

	return false
}

































































bool function DroneHasLOSToTarget( entity drone, entity target, string attachId, float maxDist )
{
	int attachID       = drone.LookupAttachment( attachId )
	vector startOrigin = drone.GetAttachmentOrigin( attachID )
	int traceMask    = TRACE_MASK_BLOCKLOS  | CONTENTS_WINDOW_NOCOLLIDE | CONTENTS_WINDOW

	array<entity> ignoreEnts = GetPlayerArray_Alive()
	ignoreEnts.append( drone )

	return IsEntityVisibleFromPoint( target, startOrigin, ignoreEnts, traceMask )
}





































entity function BeamstickStave_GetStaveWeapon( entity player )
{
	if ( !IsValidPlayer( player ) )
		return null

	entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_GADGET )

	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != BEAMSTICK_STAVE_WEAPON_REF )
	{
		return null
	}

	return weapon
}

