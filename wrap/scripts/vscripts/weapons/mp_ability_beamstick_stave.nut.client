void function ServerToClient_BeamstickStave_Messaging( entity drone, int actionID )
{
	BeamstickStave_Messaging( drone, actionID )
}

void function BeamstickStave_Messaging( entity drone, int actionID )
{
	entity player = GetLocalClientPlayer()

	string textToDisplay = ""
	string soundToPlay = ""
	bool isDroneSfx = false

	switch( actionID )
	{
		case eStaveMessageState.SHIELD_MODE_ENABLE:
			textToDisplay = "#BEAMSTICK_STAVE_HINT_SHIELD_MODE_ENABLE"
			player.Signal( SIG_BEAMSTICK_DRONE_RECALL_ACTION )
			break
		case eStaveMessageState.SHIELD_MODE_DISABLED:
			textToDisplay = "#BEAMSTICK_STAVE_HINT_SHIELD_MODE_DISABLE"
			break
		case eStaveMessageState.SHIELD_STAVE_DESTROYED:
			textToDisplay = "#BEAMSTICK_STAVE_HINT_SHIELD_STAVE_DESTROYED"
			break
		case eStaveMessageState.SHIELD_MODE_DESTROYED:
			HidePlayerHint( "#BEAMSTICK_STAVE_HINT_SHIELD_STAVE_DESTROYED" )
			textToDisplay = "#BEAMSTICK_STAVE_HINT_SHIELD_MODE_DESTROYED"
			break
		case eStaveMessageState.SHIELD_MODE_ON_COOLDOWN:
			HidePlayerHint( "#BEAMSTICK_STAVE_HINT_SHIELD_MODE_DISABLE" )
			textToDisplay = "#BEAMSTICK_STAVE_HINT_SHIELD_ON_COOLDOWN"
			soundToPlay = SFX_STAVE_UNAVAILABLE_1P
			break
		case eStaveMessageState.ALL_DRONES_SENT:
			textToDisplay = "#BEAMSTICK_STAVE_HINT_ALL_DRONES_SENT"
			soundToPlay = SFX_STAVE_UNAVAILABLE_1P
			break
		case eStaveMessageState.NO_STAVES_AVAILABLE:
			textToDisplay = "#BEAMSTICK_STAVE_HINT_NO_STAVES_AVAILABLE"
			soundToPlay = SFX_STAVE_UNAVAILABLE_1P
			break
		case eStaveMessageState.NO_STAVES_TO_RECALL:
			if ( player.GetPlayerNetInt( NETVAR_BEAMSTICK_STAVE_PLAYER_STATE ) != eStavePlayerState.SHIELD_MODE )
			{
				textToDisplay = "#BEAMSTICK_STAVE_HINT_NO_STAVES_TO_RECALL"
				soundToPlay = SFX_STAVE_UNAVAILABLE_1P
			}
			break
		case eStaveMessageState.SENDING_OUT_DRONE:
			textToDisplay =  "#BEAMSTICK_STAVE_HINT_SEND_OUT"
			soundToPlay = SFX_UI_STAVE_DEPLOY
			break
		case eStaveMessageState.SEND_DRONE_TO_NEW_LOCATION:
			textToDisplay =  "#BEAMSTICK_STAVE_HINT_SEND_TO_NEW_LOCATION"
			soundToPlay = SFX_UI_STAVE_REDIRECT
			break
		case eStaveMessageState.RECALLING_DRONE_ALL:
			HidePlayerHint( "#BEAMSTICK_STAVE_HINT_RECALL" )
			textToDisplay =  "#BEAMSTICK_STAVE_HINT_RECALL_ALL"
			player.Signal( SIG_BEAMSTICK_DRONE_RECALL_ACTION )
			break
		case eStaveMessageState.RECALLING_DRONE:
			textToDisplay =  "#BEAMSTICK_STAVE_HINT_RECALL"
			soundToPlay = SFX_UI_STAVE_RECALL_SINGLE
			if ( IsValid( drone ) )
			{
				drone.Signal( SIG_BEAMSTICK_DRONE_RECALL_ACTION )
			}
			break
		case eStaveMessageState.STAVE_REGENERATED:
			textToDisplay =  "#BEAMSTICK_STAVE_HINT_STAVE_REGENERATED"
			soundToPlay = SFX_UI_STAVE_REGENERATED
			break
		case eStaveMessageState.ENTER_DEPLOY_MODE:
			soundToPlay = SFX_UI_ENTER_PLACEMENT_MODE
			break
		case eStaveMessageState.EXIT_DEPLOY_MODE:
			soundToPlay = SFX_UI_EXIT_PLACEMENT_MODE
			break
		case eStaveMessageState.DRONE_TURRET_DESTROYED:
			textToDisplay = "#BEAMSTICK_STAVE_TURRET_DESTROYED"
			soundToPlay = SFX_UI_STAVE_TURRET_DESTROYED
			if ( IsValid( drone ) )
			{
				drone.Signal( SIGNAL_WAYPOINT_DESTROY )
			}
			break
	}

	if ( textToDisplay != "" )
	{
		AddPlayerHint( 2.0, 0.25, $"", textToDisplay )
	}

	if ( isDroneSfx )
	{
		if ( IsValid( drone ) && soundToPlay != "" )
		{
			EmitSoundOnEntity( drone, soundToPlay )
		}
	}
	else
	{
		if ( IsValidPlayer( player ) && !player.Player_IsSkydiving() && soundToPlay != "" )
		{
			EmitSoundOnEntity( player, soundToPlay )
		}
	}
}































void function BeamstickStave_Drone_ShowDronePositionPreview_Thread( entity weapon, entity drone ) 
{
	AssertIsNewThread()

	if ( !IsValid( weapon ) )
		return

	weapon.EndSignal( "OnDestroy", SIG_BEAMSTICK_DRONE_END_FX_PREVIEW )

	entity localClientPlayer = GetLocalClientPlayer()

	entity player = weapon.GetOwner()

	if ( player != localClientPlayer )
		return

	player.EndSignal( "OnDeath", "OnDestroy" )

	wait 0.2

	int radiusFxHandle
	entity effectProp
	if ( IsValid( weapon ) )
	{
		effectProp = CreateClientSidePropDynamic( weapon.GetOrigin(), <0,0,90>, BEAMSTICK_STAVE_DRONE_MODEL )

		radiusFxHandle = StartParticleEffectInWorldWithHandle( GetParticleSystemIndex( FX_ZONE_PREVIEW ), <0, 0, 0>, <0, 0, 0> )

		EffectSetControlPointVector( radiusFxHandle, 3, < tuning.droneScanRadius, 0,0> )  

		if ( effectProp.HasModel() )
		{
			DeployableModelHighlight( effectProp )
		}
	}

	OnThreadEnd(
		function() : ( radiusFxHandle, effectProp )
		{
			if ( radiusFxHandle != -1 )
			{
				EffectStop( radiusFxHandle, false, true )
			}

			if ( IsValid( effectProp ) )
			{
				effectProp.Destroy()
			}
		}
	)

	while( IsValid( radiusFxHandle ) )
	{
		vector dropPosition = BeamstickStave_Drone_FindDroneOrderPos( player, drone ).orderPos
		EffectSetControlPointVector( radiusFxHandle, 0, dropPosition )

		effectProp.SetOrigin( dropPosition )
		vector viewVec           = player.GetViewVector()
		effectProp.SetAngles( < 0, VectorToAngles( viewVec ).y, 0 > )

		WaitFrame()
	}
}


