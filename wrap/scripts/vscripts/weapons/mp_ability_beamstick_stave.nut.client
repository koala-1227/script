void function BeamstickStave_OnPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	if ( didHave )
	{










			BeamstickStave_UnregisterModeChangeInputBindings()
			BeamstickStave_CleanupUI()

	}

	if ( nowHas )
	{









			if ( !IsInFiringRange() )
			{
				BeamstickStave_RegisterModeChangeInputBindings( IsControllerModeActive() )
				BeamstickStave_SetupGadgetSlotInputUI()
			}

	}
}


















void function BeamstickStave_OnPlayerMatchStateChanged( entity player, int newValue )
{
	if ( !IsValidPlayer( player ) )
		return

	if ( !file.isInFiringRange && newValue < ePlayerMatchState.NORMAL )
	{
		file.isInFiringRange = GetMapName() == "mp_rr_canyonlands_staging_mu1_breach"
	}

	if ( newValue == ePlayerMatchState.STAGING_AREA && IsInFiringRange() )
	{




			ResetToDefaultGadgetRui()


		return
	}




















	if ( newValue == ePlayerMatchState.NORMAL )
	{
		BeamstickStave_Create_Stave_Hud( player )
	}

}

























void function BeamstickStave_OnWinnerDetermined()
{
	entity player = GetLocalViewPlayer()

	if ( !IsValidPlayer( player ) )
		return

	
	player.Signal( SIG_BEAMSTICK_DRONE_RECALL_ACTION )
}






















































































































































