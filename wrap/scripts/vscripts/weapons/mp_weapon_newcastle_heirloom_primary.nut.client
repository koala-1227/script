void function MpWeaponNewcastleHeirloomPrimary_Init()
{
	RegisterSignal( SWORD_ACTIVATE_SIGNAL )

	PrecacheParticleSystem( SWORD_IDLE_FX_1P )
	PrecacheParticleSystem( SWORD_IDLE_FX_1P )
	PrecacheParticleSystem( SWORD_IDLE_FX_3P )
	PrecacheParticleSystem( SWORD_IDLE_FX_1P_RT_01 )
	PrecacheParticleSystem( SWORD_IDLE_FX_3P_RT_01 )
	PrecacheParticleSystem( SWORD_IDLE_FX_1P_RT_02 )
	PrecacheParticleSystem( SWORD_IDLE_FX_3P_RT_02 )
	PrecacheParticleSystem( SWORD_IDLE_FX_1P_RT_03 )
	PrecacheParticleSystem( SWORD_IDLE_FX_3P_RT_03 )

	PrecacheParticleSystem( SWORD_IDLE_JET_FX_1P )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_3P )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_1P_RT_01 )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_3P_RT_01 )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_1P_RT_02 )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_3P_RT_02 )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_1P_RT_03 )
	PrecacheParticleSystem( SWORD_IDLE_JET_FX_3P_RT_03 )

	PrecacheParticleSystem( SWORD_CORE_FX_00 )
	
	PrecacheParticleSystem( SWORD_DEACTIVATED_COVER_FX )

	
	PrecacheParticleSystem( SWORD_ACTIVATE_FX_00 )
	PrecacheParticleSystem( SWORD_ACTIVATE_FX_01 )
	PrecacheParticleSystem( SWORD_ACTIVATE_FX_02 )
	PrecacheParticleSystem( SWORD_ACTIVATE_FX_03 )
	PrecacheParticleSystem( SWORD_DEACTIVATE_FX_00 )
	PrecacheParticleSystem( SWORD_DEACTIVATE_FX_01 )
	PrecacheParticleSystem( SWORD_DEACTIVATE_FX_02 )
	PrecacheParticleSystem( SWORD_DEACTIVATE_FX_03 )
	PrecacheParticleSystem( SWORD_INSPECT_GENERIC_FLICK_FX_00 )
	PrecacheParticleSystem( SWORD_INSPECT_GENERIC_FLICK_FX_01 )
	PrecacheParticleSystem( SWORD_INSPECT_GENERIC_FLICK_FX_02 )
	PrecacheParticleSystem( SWORD_INSPECT_GENERIC_FLICK_FX_03 )
	PrecacheParticleSystem( SWORD_JET_FLAREUP_FX_00 )
	PrecacheParticleSystem( SWORD_JET_FLAREUP_FX_01 )
	PrecacheParticleSystem( SWORD_JET_FLAREUP_FX_02 )
	PrecacheParticleSystem( SWORD_JET_FLAREUP_FX_03 )

	PrecacheParticleSystem(  SWORD_ATTACK_GLOW_1P_FX_00 )
	PrecacheParticleSystem(  SWORD_ATTACK_GLOW_1P_FX_01 )
	PrecacheParticleSystem(  SWORD_ATTACK_GLOW_1P_FX_02 )
	PrecacheParticleSystem(  SWORD_ATTACK_GLOW_1P_FX_03 )

	PrecacheParticleSystem( SWORD_JET_FLAREUP_DRAW_ROCKET_FX_00 )
