	PrecacheParticleSystem( SWORD_JET_FLAREUP_DRAW_ROCKET_FX_02 )
	PrecacheParticleSystem( SWORD_JET_FLAREUP_DRAW_ROCKET_FX_03 )

	PrecacheParticleSystem( SWORD_IMPACT_FX )

	RegisterScriptAnimWindowCallbacks( SWORD_CALLBACK_NAME, NewcastleHeirloom_ScriptAnimWindowStartCallback, NewcastleHeirloom_ScriptAnimWindowStopCallback )









		Melee_AddCallback_MeleeEmoteCompletedWithWeaponSkin( NEWCASTLE_SWORD_WEAPON_GUID, NewcastleHeirloom_ActivationEmoteComplete )

}
















bool function NewcastleHeirloom_HasBaseSkinEquipped( entity weapon )
{
	return weapon.GetSkin() == NEWCASTLE_SWORD_DEFAULT_SKIN_INDEX
}

string function NewcastleHeirloom_GetCurrentActiveSkinName( entity weapon )
{
	return NewcastleHeirloom_HasBaseSkinEquipped( weapon ) ? NEWCASTLE_SWORD_SKIN_NAME_BASE : MeleeSkin_GetSkinNameFromPlayer( weapon.GetWeaponOwner() )
}

void function OnWeaponActivate_weapon_newcastle_heirloom_primary( entity weapon )
{
	weapon.Signal( SWORD_ACTIVATE_SIGNAL )

		if ( IsSpectating() )
		{
			
			
			OnWeaponDeactivate_melee_newcastle_heirloom( weapon )
			OnWeaponDeactivate_weapon_newcastle_heirloom_primary( weapon )
		}

	StartFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
}

void function OnWeaponDeactivate_weapon_newcastle_heirloom_primary( entity weapon )
{
	StopFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
}

void function OnWeaponOwnerChanged_weapon_newcastle_heirloom_primary( entity weapon, WeaponOwnerChangedParams changeParams )
{
	entity owner = changeParams.newOwner
	if ( !IsValid( owner ) )
		return

	EHI ownerEHI = ToEHI( owner )
	if ( !EHIHasValidScriptStruct( ownerEHI ) ) 
	{
		Warning( "%s : ownerEHI '%s' has no valid SS! OnWeaponOwnerChanged is being called before ShEHI_OnPlayerCreated?", FUNC_NAME(), string( ownerEHI ) )
		return
	}

	AddCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( ownerEHI, Loadout_Character(), OnCharacterChanged, false )




















}

void function OnCharacterChanged( EHI playerEHI, ItemFlavor character )
{
	entity player = FromEHI( playerEHI )
	if ( !IsValid( player ) )
		return

	entity weapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 )
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != NEWCASTLE_SWORD_MP_WEAPON_NAME )
		return

	weapon.StopWeaponEffect( SWORD_IDLE_FX_1P, SWORD_IDLE_FX_3P )
	weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P, SWORD_IDLE_JET_FX_3P )
	weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_01, SWORD_IDLE_FX_3P_RT_01 )
	weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_01, SWORD_IDLE_JET_FX_3P_RT_01 )
	weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_02, SWORD_IDLE_FX_3P_RT_02 )
	weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_02, SWORD_IDLE_JET_FX_3P_RT_02 )
	weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_03, SWORD_IDLE_FX_3P_RT_03 )
	weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_03, SWORD_IDLE_JET_FX_3P_RT_03 )

	StartFXForSkin( weapon, MeleeSkin_GetSkinNameFromPlayer( player ) )
}





































void function StartFXForSkin( entity weapon, string meleeSkinName )
{
	switch ( meleeSkinName )
	{
		case NEWCASTLE_SWORD_SKIN_NAME_BASE:
			weapon.PlayWeaponEffect( SWORD_IDLE_FX_1P, SWORD_IDLE_FX_3P, "FX_CORE", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P, SWORD_IDLE_JET_FX_3P, "fx_nozzle_l", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P, SWORD_IDLE_JET_FX_3P, "fx_nozzle_r", true )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT01:
			weapon.PlayWeaponEffect( SWORD_IDLE_FX_1P_RT_01, SWORD_IDLE_FX_3P_RT_01, "FX_CORE", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_01, SWORD_IDLE_JET_FX_3P_RT_01, "fx_nozzle_l", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_01, SWORD_IDLE_JET_FX_3P_RT_01, "fx_nozzle_r", true )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT02:
			weapon.PlayWeaponEffect( SWORD_IDLE_FX_1P_RT_02, SWORD_IDLE_FX_3P_RT_02, "FX_CORE", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_02, SWORD_IDLE_JET_FX_3P_RT_02, "fx_nozzle_l", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_02, SWORD_IDLE_JET_FX_3P_RT_02, "fx_nozzle_r", true )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT03:
			weapon.PlayWeaponEffect( SWORD_IDLE_FX_1P_RT_03, SWORD_IDLE_FX_3P_RT_03, "FX_CORE", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_03, SWORD_IDLE_JET_FX_3P_RT_03, "fx_nozzle_l", true )
			weapon.PlayWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_03, SWORD_IDLE_JET_FX_3P_RT_03, "fx_nozzle_r", true )
			break
	}
}

void function StopFXForSkin( entity weapon, string meleeSkinName )
{
	switch ( meleeSkinName )
	{
		case NEWCASTLE_SWORD_SKIN_NAME_BASE:
			weapon.StopWeaponEffect( SWORD_IDLE_FX_1P, SWORD_IDLE_FX_3P )
			weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P, SWORD_IDLE_JET_FX_3P )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT01:
			weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_01, SWORD_IDLE_FX_3P_RT_01 )
			weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_01, SWORD_IDLE_JET_FX_3P_RT_01 )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT02:
			weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_02, SWORD_IDLE_FX_3P_RT_02 )
			weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_02, SWORD_IDLE_JET_FX_3P_RT_02 )
			break

		case NEWCASTLE_SWORD_SKIN_NAME_RT03:
			weapon.StopWeaponEffect( SWORD_IDLE_FX_1P_RT_03, SWORD_IDLE_FX_3P_RT_03 )
			weapon.StopWeaponEffect( SWORD_IDLE_JET_FX_1P_RT_03, SWORD_IDLE_JET_FX_3P_RT_03 )
			break
	}
}

void function NewcastleHeirloom_ScriptAnimWindowStartCallback( entity ent, string parameter )
{
	entity weapon = TryResolveScriptAnimWindowWeapon( ent )

	
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != NEWCASTLE_SWORD_MP_WEAPON_NAME )
		return

	if ( parameter == "Stop_FX" )
	{
		StopFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
		
		weapon.PlayWeaponEffect( SWORD_CORE_FX_00, SWORD_CORE_FX_00, "FX_CORE", true )
		weapon.PlayWeaponEffect( SWORD_DEACTIVATED_COVER_FX, SWORD_DEACTIVATED_COVER_FX, "FX_CORE", true )
	}
	else if ( parameter == "Play_Idle_FX" ) 
	{
		StartFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
		thread function() : ( weapon ) {
			weapon.EndSignal( "OnDestroy" )
			weapon.EndSignal( SWORD_ACTIVATE_SIGNAL )

			entity owner = weapon.GetOwner()
			owner.EndSignal( "OnDeath" )
			owner.EndSignal( "OnDestroy" )

			OnThreadEnd(
				function() : ( weapon )
				{
					StopFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
				}
			)

			wait SWORD_HOLSTER_TIME_SEC
		}()
	}
}

void function NewcastleHeirloom_ScriptAnimWindowStopCallback( entity ent, string parameter )
{
	entity weapon = TryResolveScriptAnimWindowWeapon( ent )

	
	if ( !IsValid( weapon ) || weapon.GetWeaponClassName() != NEWCASTLE_SWORD_MP_WEAPON_NAME )
		return

	if ( parameter == "Stop_FX" )
	{
		StartFXForSkin( weapon, NewcastleHeirloom_GetCurrentActiveSkinName( weapon ) )
		
		weapon.StopWeaponEffect( SWORD_CORE_FX_00, SWORD_CORE_FX_00 )
		weapon.StopWeaponEffect( SWORD_DEACTIVATED_COVER_FX, SWORD_DEACTIVATED_COVER_FX )
	}
	
}

string function NewcastleHeirloom_GetSkinNameFromWeapon( entity weapon )
{
	int skinIndex = weapon.GetSkin()
	switch ( skinIndex )
	{
		case NEWCASTLE_SWORD_DEFAULT_SKIN_INDEX:
			return NEWCASTLE_SWORD_SKIN_NAME_BASE

		case NEWCASTLE_SWORD_DEFAULT_SKIN_INDEX + 1:
			return NEWCASTLE_SWORD_SKIN_NAME_RT01

		case NEWCASTLE_SWORD_DEFAULT_SKIN_INDEX + 2:
			return NEWCASTLE_SWORD_SKIN_NAME_RT02

		case NEWCASTLE_SWORD_DEFAULT_SKIN_INDEX + 3:
			return NEWCASTLE_SWORD_SKIN_NAME_RT03

		default:
			Assert( false )
	}

	return ""
}


void function NewcastleHeirloom_ActivationEmoteComplete( entity weapon, ItemFlavor oldMeleeSkin )
{
	StopFXForSkin( weapon, MeleeSkin_GetSkinName( oldMeleeSkin ) )
	StartFXForSkin( weapon, NewcastleHeirloom_GetSkinNameFromWeapon( weapon ) ) 
}


















































