void function MeleeGrapple_DetectTarget_Thread( entity player )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( MELEE_GRAPPLE_STOP_TRACKING_SIGNAL )

	OnThreadEnd(
		function() : ()
		{
			file.targetEntity = null
		}
	)

	while( IsValid( player ) )
	{
		
		entity target = GrappleAutoAim_FindTarget( player )
		if ( target != file.targetEntity )
		{
			file.targetEntity = target
			MeleeGrapple_Start_Tracking_Rui(player, file.targetEntity)
		}

		WaitFrame()
	}
}



void function MeleeGrapple_Start_Tracking_Rui( entity player, entity target )
{
	if ( !IsValid( player ) )
		return

	player.Signal( MELEE_GRAPPLE_CHANGED_TARGET_SIGNAL )
	thread MeleeGrapple_Tracking_Rui_Thread( player, target )
}



void function MeleeGrapple_Tracking_Rui_Thread(  entity player, entity target )
{
	AssertIsNewThread()

	if ( !IsValid( player ) || !IsValid( target ) )
		return

	if ( GetGameState() >= eGameState.Resolution )
		return

	EndSignal( target, "OnDestroy", "OnDeath" )
	EndSignal( target, "OnModelChanged" )
	EndSignal( player, MELEE_GRAPPLE_CHANGED_TARGET_SIGNAL )
	EndSignal( player, MELEE_GRAPPLE_STOP_TRACKING_SIGNAL )
	EndSignal( player, "OnDestroy" )

	var rui = RuiCreate( $"ui/endorsement_phase_pull_target.rpak", clGlobal.topoFullScreen, RUI_DRAW_HUD, RuiCalculateDistanceSortKey( player.EyePosition(), target.GetOrigin() ) )
	InitHUDRui( rui )

	RuiSetBool( rui, "isVisible", false )

	RuiKeepSortKeyUpdated( rui, true, "pos" )

	target.DoModelChangeScriptCallback( true )

	OnThreadEnd(
		function() : ( rui, target, player)
		{
			RuiDestroyIfAlive( rui )

			if ( IsValid( target ) && target.IsPlayer() )
			{
				target.DoModelChangeScriptCallback( false )
				target.SetTargetInfoStatusIcon( $"" )
			}
		}
	)

	while ( IsValid( player ) )
	{
		
		bool isValidTarget = IsValid( target )


			if ( !Endorsement_PhasePull_CheckCanUse( player ) )
			{
				RuiSetBool( rui, "isVisible", false )
				WaitFrame()
				continue
			}


		if ( isValidTarget && target.GetTeam() != player.GetTeam() )
		{
			vector pos = target.GetWorldSpaceCenter()
			pos += <0, 0, 15>

			RuiSetFloat3( rui, "pos", pos )
			RuiSetBool( rui, "isVisible", true )

			RuiSetBool( rui, "enemyObstructing", CheckIfEnemyIsObstructing( player, target ) )
		}
		else
		{
			RuiSetBool( rui, "isVisible", false )
		}

		RuiSetBoolIfExists( rui, "fadeOut", file.fadeOutRui )

		entity grappleWeapon = player.GetOffhandWeapon( eOffhandInv.MELEE )
		if ( IsValid( grappleWeapon ) && grappleWeapon.GetWeaponSettingBool( eWeaponVar.grapple_weapon ) )
		{			
			bool isGrappling = player.IsGrappleAttached()
			RuiSetBool( rui, "isGrappling", isGrappling )

			bool isOnCooldown = grappleWeapon.GetWeaponPrimaryClipCount() < grappleWeapon.GetWeaponSettingInt( eWeaponVar.ammo_min_to_fire )
			RuiSetBool( rui, "isOnCooldown", isOnCooldown && !isGrappling ) 
		}

		WaitFrame()
	}
}

