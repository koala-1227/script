bool function ClusterMissile_EntityShouldBeHighlighted( entity viewPlayer, entity hitPlayer )
{
	if ( !tuning.teamHighlight )
	{
		if ( !(hitPlayer in file.playerHighlightEndTime) )
			return false

		if ( file.playerHighlightEndTime[ hitPlayer ] < Time() )
			return false
	}

	if ( !StatusEffect_HasSeverity( hitPlayer, eStatusEffect.valk_tac_scan ) )
		return false

	return true
}


