global const string VALK_UPGRADE_TAC_INCREASE_MISSILES = "upgrade_core_valk_tac_increase_missiles"



const asset FX_BOMBARDMENT_MARKER = $"P_valk_rckt_AR_marker"
const asset FX_BOMBARDMENT_LOCKED = $"P_valk_rckt_AR_lock"

const asset FX_MUZZLE_FLASH_FP = $"P_wpn_mflash_bang_rocket_FP"
const asset FX_MUZZLE_FLASH_3P = $"P_wpn_mflash_bang_rocket"
const asset MISSILE_TRAIL = $"P_valk_rckt_stg2"
const asset GRENADE_TRAIL = $"P_valk_rckt_stg1"


const asset CREEPING_BOMBARDMENT_WEAPON_BOMB_MODEL = $"mdl/weapons_r5/misc_bangalore_rockets/bangalore_rockets_projectile.rmdl"
const asset ROCKET_PROJECTILE = $"mdl/humans_r5/pilots_r5/pilot_valkyrie/w_valkyrie_rocket_projectile.rmdl"


const bool MISSILE_PATH_DEBUG = false

struct {








		array<entity> valkTacWarnEntities
		table<entity, float> playerHighlightEndTime

} file

struct
{
	float stunDuration = 2.0
	float stunEasout = 1.5

	float stunMoveSlow = 0.75 
	float stunTurnSlow = 0.0

	float highlightDuration = 1.5
	bool teamHighlight = false

	bool drainMovementPassives = true

	bool selfDamage = false

	float explosionDamage = 25
	float explosionFollowupFactor = 0.15 
	float explosionFollowUpTime = 5 
	float explosionRadius = 150

	float maxAttackRange = 125.0 * METERS_TO_INCHES 

	float maxAttackRangeInSkydive = 250.0 * METERS_TO_INCHES
	float maxTravelTimeInSkydive = 5.0
	float minTravelTimeInSkydive = 0.3

	float maxTravelTime = 4.0
	float minAttackRange = 400.0 
	float minTravelTime = 2.0

	float verticalClearanceRequired = 0.0

	int sideSteps = 2
	int forwardSteps = 4
	
	int sideStepsWithUpgrade = 3
	int forwardStepsWithUpgrade = 4

	float fanoutOnLaunch = 0.1
	float fanoutOnLaunchWithUpgrade = 0.06

	float stepHeight = 250.0 
	float sideStep = 163.16
	float stepForward = 185.0 
	float missileSpeed = 1600 

	float grenadeLobTime = 0.75
	float inRowDelay = 0.05
	float rowToRowDelay = 0.15
	float initialDelay = 0.75 
} tuning

struct ValkMissileInfo
{
	float  missileSpeed
	vector phase1Vector
	vector phase2Vector
	vector phase3Vector
	vector firePos
	vector targetPos
	float  phase1Time
	float  phase1To2Time
	float  phase2Time
	float  phase2To3Time
	float  phase3ToTarTime
}

array< float > fanAdjustments =
[
	-1.0,
	1.0,
	-2.0,
	2.0,
	-3.0,
	3.0,
	-4.0,
	4.0,
	-5.0,
	5.0,
	-6.0,
	6.0,
	-7.0,
	7.0,
	-8.0,
	8.0,
	-9.0,
	10.0,
	-11.0,
	11.0,
]


struct TraceStepResult
{
	vector pos
	vector normal
}

enum eCanFireTactical
{
	YES,
	NO_CLEARANCE,
	NO_OTHER
}

void function MpAbilityValkClusterMissile_Init()
{
	RegisterTuningStruct( "tuning", "valk_tac_" )

	PrecacheModel( ROCKET_PROJECTILE )

	PrecacheParticleSystem( FX_MUZZLE_FLASH_FP )
	PrecacheParticleSystem( FX_MUZZLE_FLASH_3P )
	PrecacheParticleSystem( FX_BOMBARDMENT_MARKER )
	PrecacheParticleSystem( FX_BOMBARDMENT_LOCKED )
	PrecacheParticleSystem( GRENADE_TRAIL )
	PrecacheParticleSystem( MISSILE_TRAIL )

	PrecacheScriptString( VALK_TAC_WARNING_ENTITY_SCRIPTNAME )

	RegisterSignal( "ValkTacTargetingEnd" )





		AddScriptNameCreateCallback( VALK_TAC_WARNING_ENTITY_SCRIPTNAME, ValkTacAddWarning )

		if ( !tuning.teamHighlight )
		{
			AddLocalPlayerDidDamageCallback( ClusterMissile_OnLocalPlayerDidDamage )
		}
		StatusEffect_RegisterEnabledCallback( eStatusEffect.valk_tac_scan, UpdateHighlightOnStatusEffectChange )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.valk_tac_scan, UpdateHighlightOnStatusEffectChange )



	PrecacheImpactEffectTable( "exp_valk_rocket" )
}

