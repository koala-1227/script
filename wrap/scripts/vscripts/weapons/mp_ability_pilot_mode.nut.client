void function MpAbilityHoverboard_Init()
{
	if( !IsHoverboardEnabled() )
		return

	PrecacheWeapon( HOVERBOARD_OFFHAND_SCRIPTNAME )
	PrecacheModel( HOVERBOARD_MODEL )

	PrecacheScriptString( HOVERBOARD_PROP_SCRIPTNAME )


	PrecacheParticleSystem( HOVERBOARD_SCREEN_FX )
	PrecacheParticleSystem( HOVERBOARD_BOOST_SCREEN_FX )

	PrecacheParticleSystem( HOVERBOARD_TRAIL_FX )
	PrecacheParticleSystem( HOVERBOARD_BOOST_TRAIL_FX )
	PrecacheParticleSystem( HOVERBOARD_JUMPJET_IDLE_LEFT_FX )
	PrecacheParticleSystem( HOVERBOARD_JUMPJET_IDLE_RIGHT_FX )
	PrecacheParticleSystem( HOVERBOARD_JUMPJET_BURST_LEFT_FX )
	PrecacheParticleSystem( HOVERBOARD_JUMPJET_BURST_RIGHT_FX )
	PrecacheParticleSystem( HOVERBOARD_HOVERBOARD_IDLE_FRONT_FX )
	PrecacheParticleSystem( HOVERBOARD_HOVERBOARD_IDLE_BACK_FX )
	PrecacheParticleSystem( HOVERBOARD_HOVERBOARD_BURST_FRONT_FX )
	PrecacheParticleSystem( HOVERBOARD_HOVERBOARD_BURST_BACK_FX )
	PrecacheParticleSystem( HOVERBOARD_HOVERBOARD_WALLRIDE_FX )

	PrecacheImpactEffectTable( HOVERBOARD_RAM_IMPACT_TABLE )

	RegisterSignal( SIG_HOVERBOARD_BOOST )
	RegisterSignal( SIG_HOVERBOARD_END )
	RegisterSignal( SIG_HOVERBOARD_STATS_STARTED )
	RegisterSignal( SIG_HOVERBOARD_WALLRUN_END )

	Remote_RegisterClientFunction( "ServerToClient_ShowHoverboardLandingUI" )
	Remote_RegisterServerFunction( "ClientToServer_Hoverboard_ForceDeactivateHoverboard" )

	AddCallback_OnPassiveChanged( ePassives.PAS_HOVERBOARD, Hoverboard_OnPassiveChanged )











#if DEV
			file.debugSpeedDisplay = GetCurrentPlaylistVarBool( "hoverboard_debug_speed", file.debugSpeedDisplay )
#endif
		Survival_AddInventorySlotVisibilityCallback( "gadgetslot", Hoverboard_ShouldShowGadgetSlot )
		Survival_AddInventoryPreventGadgetSlotUnequipCallback( Hoverboard_ShouldPreventGadgetUnequip )
		AddCallback_OnClientScriptInit( Hoverboard_RegisterTooltipCallback )
		AddCallback_OnViewPlayerChanged( Hoverboard_ViewPlayerChanged )
		
		
		RegisterConCommandTriggeredCallback( "+weaponCycle", Hoverboard_OnAlternateExitButtonPressed )
		RegisterConCommandTriggeredCallback( "weaponSelectPrimary0", Hoverboard_OnAlternateExitButtonPressed )
		RegisterConCommandTriggeredCallback( "weaponSelectPrimary1", Hoverboard_OnAlternateExitButtonPressed )
		RegisterConCommandTriggeredCallback( "weaponSelectPrimary2", Hoverboard_OnAlternateExitButtonPressed )
		RegisterConCommandTriggeredCallback( "weaponSelectOrdnance", Hoverboard_OnAlternateExitButtonPressed )
		RegisterConCommandTriggeredCallback( "+scriptcommand3", Hoverboard_OnAlternateExitButtonPressed ) 

		AddScriptNameCreateCallback( HOVERBOARD_PROP_SCRIPTNAME, Hoverboard_OnHoverboardPropCreated )

}

bool function IsHoverboardEnabled()
{
	return GetCurrentPlaylistVarBool( "hoverboard_enabled", false )
}

float function Hoverboard_GetCooldownTotal( entity player )
{
	bool hoverboardActive = player.IsPilotModeActive() || StatusEffect_HasSeverity( player, eStatusEffect.hoverboard_active )
	return hoverboardActive ? GetCurrentPlaylistVarFloat( "hoverboard_cooldown_sec", HOVERBOARD_COOLDOWN_SEC ) : GetCurrentPlaylistVarFloat( "hoverboard_activate_cooldown_sec", HOVERBOARD_ACTIVATE_COOLDOWN_SEC )
}

float function Hoverboard_GetDamageThreshold()
{
	return GetCurrentPlaylistVarFloat( "hoverboard_damage_thresh", HOVERBOARD_DAMAGE_THRESHOLD )
}

float function Hoverboard_GetDamageTimeThreshold()
{
	return GetCurrentPlaylistVarFloat( "hoverboard_damage_thresh_time", HOVERBOARD_DAMAGE_KNOCKOFF_TIME_DELAY )
}

bool function Hoverboard_IsHoverboardWeaponClass( entity weapon )
{
	if ( !IsValid( weapon ) )
		return false

	return (weapon.GetWeaponClassName() == HOVERBOARD_SCRIPTNAME)
}

