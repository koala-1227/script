const asset HEALING_DOME_FX = $"P_wpn_BBunker_beam_heal"
const asset EMP_WARNING_FX_3P = $"P_emp_body_human"
const asset HALO_HEAL_FX_1P = $"P_LLR_ult_boost_screen"
