bool function SniperUlt_OnWeaponAttemptOffhandSwitch( entity weapon )
{
	return true
}

void function SniperUlt_OnWeaponActivate( entity weapon )
{
	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )

	entity weaponOwner = weapon.GetOwner()
	if ( IsValid( weaponOwner ) )
	{
		if ( serverOrPredicted )
		{
			weapon.SetTargetingLaserEnabled( false )
		}

		if( PlayerHasPassive( weaponOwner, ePassives.PAS_ULT_UPGRADE_THREE ) )
		{
			HopupGunshield_OnWeaponActivate( weapon )
		}







			if ( !Unhinged_IsModeActive() )

			{
				thread UpdateWeaponEnergizeRui( weaponOwner, weapon, ENERGIZE_UI_CONSUMABLE_ICON )
			}

	}



	if( SniperUlt_IsCantedSightsEnabled() && ( GetLocalClientPlayer() == weaponOwner ) )
	{
		thread SniperUlt_CantedHintThread( weaponOwner, weapon )
	}









}

void function SniperUlt_OnWeaponDeactivate( entity weapon )
{

	if ( IsValid(weapon) )
	{
		entity weaponOwner = weapon.GetOwner()
		if ( IsValid(weaponOwner) )
		{
			Signal( weaponOwner, WEAPON_CHARGED_RUI_ABORT_SIGNAL )
		}
	}






	entity weaponOwner = weapon.GetOwner()
	if( IsValid( weaponOwner ) )
	{
		if ( PlayerHasPassive( weaponOwner, ePassives.PAS_ULT_UPGRADE_THREE ) )
		{
			HopupGunshield_OnWeaponDeactivate( weapon )
		}
	}
}

void function SniperUlt_OnWeaponStartZoomIn( entity weapon )
{
	entity weaponOwner = weapon.GetWeaponOwner()

	if ( !IsValid( weaponOwner ) )
		return

	if( PlayerHasPassive( weaponOwner, ePassives.PAS_ULT_UPGRADE_THREE ) )
	{
		HopupGunshield_OnWeaponStartZoomIn( weapon )
	}

	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )
	if ( serverOrPredicted )
	{

		if ( weaponOwner == GetLocalViewPlayer() )
		{
			StopSoundOnEntity( weapon, SNIPERULT_ZOOM_OUT )
		}


		if( !IsVantageBuffsEnabled() || file.playersThatShouldShowSniperLaser.contains( weaponOwner ) )
			weapon.SetTargetingLaserEnabled( true )
	}



	Signal( weaponOwner, SNIPERULT_STOP_CANTED_HINT )


}

void function SniperUlt_OnWeaponStartZoomOut( entity weapon )
{
	entity weaponOwner = weapon.GetWeaponOwner()
	if ( !IsValid( weaponOwner ) )
		return

	if( PlayerHasPassive( weaponOwner, ePassives.PAS_ULT_UPGRADE_THREE ) )
	{
		HopupGunshield_OnWeaponStartZoomOut( weapon )
	}

	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )
	if ( serverOrPredicted )
	{

		if ( weaponOwner == GetLocalViewPlayer() )
		{
			StopSoundOnEntity( weapon, SNIPERULT_ZOOM_IN )
			StopSoundOnEntity( weaponOwner, SNIPER_RECON_UI_START_SOUND )
		}


		weapon.SetTargetingLaserEnabled( false )
	}
}

void function SniperUlt_OnWeaponZoomFOVToggle( entity weapon, float targetFOV )
{

	if ( weapon.GetOwner() != GetLocalViewPlayer() )
		return

	if ( targetFOV == weapon.GetWeaponSettingFloat( eWeaponVar.zoom_fov ) ) 
	{
		EmitSoundOnEntity( weapon, SNIPER_ULT_TOGGLE_ZOOMOUT_1P )
		StopSoundOnEntity( weapon, SNIPER_ULT_TOGGLE_ZOOMIN_1P )
	}
	else 
	{
		EmitSoundOnEntity( weapon, SNIPER_ULT_TOGGLE_ZOOMIN_1P )
		StopSoundOnEntity( weapon, SNIPER_ULT_TOGGLE_ZOOMOUT_1P )
	}

}

void function SniperUlt_OnWeaponEnergizedStart( entity weapon, entity player, bool costConsumable )
{
	OnWeaponEnergizedStart( weapon, player, costConsumable )

	



}

var function SniperUlt_OnWeaponPrimaryAttack( entity weapon, WeaponPrimaryAttackParams attackParams )
{
	entity player  = weapon.GetOwner()
	if ( !IsValid( player ) )
		return 0

	int ammoUsed = weapon.GetAmmoPerShot()

	PlayerUsedOffhand( player, weapon )

	bool shouldCreateProjectile = false
	if ( IsServer() || weapon.ShouldPredictProjectiles() )
		shouldCreateProjectile = true

	if ( shouldCreateProjectile )
	{
		entity projectile = FireBallisticRoundWithDrop( weapon, attackParams.pos, attackParams.dir, true, false, 0, false )
		if( !IsValid( projectile ) )
			return 0

		projectile.proj.savedOrigin = attackParams.pos
		projectile.proj.savedDir    = attackParams.dir
		weapon.EmitWeaponNpcSound( LOUD_WEAPON_AI_SOUND_RADIUS_MP, 0.1 )
		weapon.PlayWeaponEffect( FX_SNUPER_ULT_MUZZLE_FLASH_1P, FX_SNUPER_ULT_MUZZLE_FLASH_3P, "muzzle_flash" )
	}




	if( IsVantageBuffsEnabled() )
	{
		if( weapon.IsWeaponInAds() )
			weapon.SetTargetingLaserEnabled( true )


		file.lastShotTime[player] <- ClientTime()


		thread SniperUlt_TargetingLaserUpdateThread( weapon, player )
	}

	return ammoUsed
}


void function SniperUlt_OnClientAnimEvent( entity weapon, string name )
{
	GlobalClientEventHandler( weapon, name )
}


