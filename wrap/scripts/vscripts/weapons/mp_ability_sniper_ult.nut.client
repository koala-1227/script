float function SniperUlt_GetUpgradedSniperUltMarkedDurationScalar()
{
	return tuning.upgradedMarkDuration
}

float function SniperUlt_GetBaseSniperUltMarkedDuration()
{
	return tuning.markDuration
}

float function SniperUlt_GetMarkedDuration( entity attacker )
{
	float duration = SniperUlt_GetBaseSniperUltMarkedDuration()

	if( PlayerHasPassive( attacker, ePassives.PAS_ULT_UPGRADE_TWO ) )
	{
		duration *= SniperUlt_GetUpgradedSniperUltMarkedDurationScalar()
	}

	return duration
}

































































































































































































































































































































































