void function _____________CantedSights___________________________(){}
#endif

bool function SniperUlt_IsCantedSightsEnabled()
{
	return GetCurrentPlaylistVarBool( "vantage_sniper_ult_canted_sights_enabled", true )
}

void function SniperUlt_ToggleCantedSights( entity player )
{

	if ( !InPrediction() )
		return


	if( !IsValid( player ) )
		return

	entity ult = player.GetOffhandWeapon( eOffhandInv.ULTIMATE )
	entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if( !IsValid( weapon ) || ( weapon != ult ) )
		return

	if( weapon.HasMod( "optic_cq_hcog_bruiser" ) )
	{
		weapon.RemoveMod( "optic_cq_hcog_bruiser" )
	}
	else
	{
		weapon.AddModOnAttackEnd( "optic_cq_hcog_bruiser" )
	}
}

void function SniperUlt_AddedToggleWeaponMod( entity player, entity weapon, string mod )
{
	if ( !IsValid( weapon ) )
		return

	if ( !weapon.IsWeaponX() )
		return

	if( !IsValid( player ) )
		return

	if ( !PlayerHasPassive( player, ePassives.PAS_VANTAGE) )
		return

	SniperUlt_ToggleCantedSights( player )
}

void function SniperUlt_RemovedToggleWeaponMod( entity player, entity weapon, string mod )
{
	if ( !IsValid( weapon ) )
		return

	if ( !weapon.IsWeaponX() )
		return

	if( !IsValid( player ) )
		return

	if ( !PlayerHasPassive( player, ePassives.PAS_VANTAGE) )
		return

	SniperUlt_ToggleCantedSights( player )
}


