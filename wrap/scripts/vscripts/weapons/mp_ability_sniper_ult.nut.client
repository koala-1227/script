	if ( !IsValid( hitEnt ) )
		return

	entity projectileOwner = projectile.GetOwner()
	if ( !IsValid( projectileOwner ) )
		return























}

#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________TargetingLaser___________________________(){}
#endif
void function SniperUlt_TargetingLaserUpdateThread( entity weapon, entity player )
{
	if( !IsValid( weapon ) || !IsValid( player ) )
		return

	Signal( player, SNIPERULT_LASER_STOP )
	EndSignal( player, "OnDestroy", "OnDeath", SNIPERULT_LASER_STOP )

	if( !file.playersThatShouldShowSniperLaser.contains( player ) )
		file.playersThatShouldShowSniperLaser.append( player )

	OnThreadEnd(
		function() : ( player )
		{
			if( file.playersThatShouldShowSniperLaser.contains( player ) )
				file.playersThatShouldShowSniperLaser.fastremovebyvalue( player )
		}
	)

	wait tuning.laserDuration

	bool serverOrPredicted = IsServer() || ( InPrediction() && IsFirstTimePredicted() )
	if ( serverOrPredicted )
	{
		if ( IsValid( weapon ) )
			weapon.SetTargetingLaserEnabled( false )
	}
}

bool function SniperUlt_GetPlayerSniperUltLaserEnabled( entity player )
{
	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if( !IsValid( activeWeapon ) )
		return false

	return activeWeapon.GetTargetingLaserEnabled()
}

float function SniperUlt_GetPlayerSniperUltLaserEnabledTotalTime( )
{
	return tuning.laserDuration
}


float function SniperUlt_GetPlayerSniperUltLastShotTime( entity player )
{
	if ( player in file.lastShotTime )
		return file.lastShotTime[player]
	return -1.0
}



