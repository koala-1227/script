void function _____________MarkRui___________________________(){}
#endif

void function SniperUlt_MarkClientStart( entity ent, int statusEffect, bool actuallyChanged )
{
	if ( !actuallyChanged && GetLocalViewPlayer() == GetLocalClientPlayer() )
		return

	if ( ent != GetLocalViewPlayer() )
		return

	entity viewPlayer = GetLocalViewPlayer()

	int fxHandle
	EmitSoundOnEntity( viewPlayer, SNIPERULT_MARKED_SOUND_VICTIM )


#if ( DEV && SNIPERULT_DEBUG_SONAR )
	printt("SonarRound Start")
#endif
	thread SniperUlt_MarkClientThread( viewPlayer, fxHandle )
}



void function SniperUlt_MarkClientThread( entity player, int fxHandle )
{
	EndSignal( player, "OnDeath", SNIPERULT_MARK_STOP )

	OnThreadEnd(
		function() : ( fxHandle, player )
		{
			if ( !EffectDoesExist( fxHandle ) )
				return

			EffectStop( fxHandle, false, true )
		}
	)

	while ( true )
	{
		WaitFrame()
	}
}



void function SniperUlt_MarkClientStop( entity ent, int statusEffect, bool actuallyChanged )
{
	if ( !actuallyChanged && GetLocalViewPlayer() == GetLocalClientPlayer() )
		return

	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

	if( ent != player )
		return

#if ( DEV && SNIPERULT_DEBUG_SONAR )
	printt("SonarRound Stop")
#endif

	EmitSoundOnEntity( player, SNIPERULT_MARKED_END_SOUND_VICTIM )
	Signal( player, SNIPERULT_MARK_STOP )
}



void function SniperUlt_CantedHintThread( entity player, entity weapon)
{
	EndSignal( player, "OnDestroy", "OnDeath", "BleedOut_OnStartDying" )
	EndSignal( player, SNIPERULT_STOP_CANTED_HINT )
	OnThreadEnd(
		function() : (  )
		{
			HidePlayerHint( "#SNIPER_ULT_CANTED_SIGHTS_HINT" )
		}
	)

	const float HINT_DURATION 	= 4.5
	const float HINT_FADE_TIME 	= 0.15
	AddPlayerHint( HINT_DURATION, HINT_FADE_TIME, $"", "#SNIPER_ULT_CANTED_SIGHTS_HINT" )

	Wait( HINT_DURATION )
}

