struct
{
	float laserDuration							= 10.0
	float upgradeHighlightDuration 				= 3.0
	float markDuration 							= 10.0
	float upgradedMarkDuration					= 1.0
	float teamDamageScale						= 1.15
	float vantageDamageScale					= 2.5
} tuning

struct
{

		float timeLastUltHint = 0
		table<entity, float> lastShotTime


	array<entity> playersThatShouldShowSniperLaser
}file

const bool SNIPERULT_DEBUG_DRAW = false

void function SniperUlt_Init()
{
	RegisterTuningStruct( "tuning", "vantage_ult_" )

	
	PrecacheParticleSystem( FX_SNIPER_ULT_MARK )
	PrecacheParticleSystem( FX_SNIPER_ULT_IMPROVED_MARK )
	PrecacheParticleSystem( FX_SNIPER_ULT_MARK_WHIZ_BY )
	PrecacheParticleSystem( FX_SNUPER_ULT_MUZZLE_FLASH_1P )
	PrecacheParticleSystem( FX_SNUPER_ULT_MUZZLE_FLASH_3P )







	
	SetConVarBool( "rope_visibility_fx_enable", true )

	RegisterSignal( SNIPERULT_MARK_STOP )

	
	StatusEffect_RegisterEnabledCallback( eStatusEffect.sonar_round_embedded, SniperUlt_MarkClientStart )
	StatusEffect_RegisterDisabledCallback( eStatusEffect.sonar_round_embedded, SniperUlt_MarkClientStop )



	if( SniperUlt_IsCantedSightsEnabled() )
	{
		AddCallback_OnPlayerAddedToggleWeaponMod( SniperUlt_AddedToggleWeaponMod )
		AddCallback_OnPlayerRemovedToggleWeaponMod( SniperUlt_RemovedToggleWeaponMod )
	}

	RegisterSignal( SNIPERULT_STOP_CANTED_HINT )



	RegisterSignal( SNIPERULT_LASER_STOP )
}

