void function MpWeaponClusterBombLauncher_Init()
{
	PrecacheModel( CLUSTER_BOMB_MODEL )
	PrecacheWeapon( CLUSTER_BOMB_WEAPON )
	PrecacheParticleSystem( CLUSTER_BOMB_LAUNCHER_IMPACT_FX )
	PrecacheParticleSystem( CLUSTER_BOMB_LAUNCHER_LIGHT_FX )
	PrecacheParticleSystem( CLUSTER_BOMB_FIRST_EXPLOSION_FX )
	PrecacheParticleSystem( CLUSTER_BOMB_SECONDARY_EXPLOSION_FX )
	PrecacheParticleSystem( CLUSTER_BOMB_JUMPER_FOLLOW_FX )
	PrecacheParticleSystem( CLUSTER_BOMB_JUMPER_GROUND_FX )
	PrecacheImpactEffectTable( CLUSTER_BOMB_INITIAL_IMPACT_TABLE )
	PrecacheImpactEffectTable( CLUSTER_BOMB_FIRST_EXPLOSION_IMPACT_TABLE )
	PrecacheImpactEffectTable( CLUSTER_BOMB_SECONDARY_EXPLOSION_IMPACT_TABLE )

	Remote_RegisterClientFunction( "ServerToClient_ShowClusterBombJumpRadiusToOwner", "entity" )
	RegisterSignal( "ClusterBomb_EndJumpJets" )






	RegisterTuningStruct( "tuning", "fuse_tac_" )
}

void function OnWeaponOwnerChanged_weapon_cluster_bomb_launcher( entity weapon, WeaponOwnerChangedParams changeParams )
{





}

void function OnProjectileCollision_weapon_cluster_bomb_launcher( entity projectile, vector pos, vector normal, entity hitEnt, int hitbox, bool isCritical, bool isPassthrough )
{
	if ( !IsValid( hitEnt ) )
		return

	if ( IsValid( projectile.GetOwner() ) && hitEnt == projectile.GetOwner() )
		return

	if ( hitEnt.IsPlayer() && IsFriendlyTeam( hitEnt.GetTeam(), projectile.GetTeam() ) )
		return

	if ( hitEnt.IsPlayerVehicle() && IsFriendlyTeam( hitEnt.GetTeam(), projectile.GetTeam() ) )
		return







	DeployableCollisionParams collisionParams
	collisionParams.pos = pos
	collisionParams.normal = ( LengthSqr( normal ) > FLT_EPSILON) ? normal : UP_VECTOR
	collisionParams.hitEnt = hitEnt
	collisionParams.hitBox = hitbox
	collisionParams.isCritical = isCritical
	collisionParams.highDetailTrace = true
	collisionParams.ignoreHullSize = true

	if ( hitEnt.IsPlayer() && StatusEffect_GetTimeRemaining(hitEnt, eStatusEffect.death_totem_recall) > 0.0 )
	{
		projectile.SetVelocity( <0,0,0> )
		projectile.ClearParent()
		projectile.SetPhysics( MOVETYPE_FLYGRAVITY )
	}
	else
	{
		PlantStickyEntity( projectile, collisionParams, ZERO_VECTOR, false, ( hitEnt.IsPlayer() || hitEnt.IsNPC() ) ? true : false )
	}











}











































































































































































































































































































































































































































































































































vector ornull function ClusterBomb_GetPlayerLaunchVelocity( entity player, entity clusterBomb )
{
	if ( !IsValid( clusterBomb ) )
		return null

	if ( clusterBomb.GetOwner() != player )
		return null

	if ( !ClusterBomb_IsPlayerWithinJumpArea( player, clusterBomb ) )
		return null

	
	
	vector dir = Normalize( player.GetOrigin() + <0, 0, 40> - clusterBomb.GetOrigin() )
	vector vel = Normalize( player.GetVelocity() + <0, 0, 300> )
	vector pushVelocity = Normalize( dir + 2.0 * vel ) * tuning.jumpPushPower
	if ( LengthSqr( pushVelocity ) > 0.0 )
	{
		return pushVelocity
	}

	return null
}

bool function ClusterBomb_IsPlayerWithinJumpArea( entity player, entity clusterBomb )
{
	if ( clusterBomb.GetOrigin().z > player.GetOrigin().z + 40.0 )
		return false

	float dist = Distance( player.GetOrigin(), clusterBomb.GetOrigin() )
	if ( dist > 100 )
		return false

	return true
}

void function ClusterBomb_OnPlayerJump( entity player )
{
	foreach ( clusterBomb in file.activeClusterBombs )
	{
		vector ornull launchVelocity = ClusterBomb_GetPlayerLaunchVelocity( player, clusterBomb )
		if ( launchVelocity == null )
			continue

		expect vector( launchVelocity )
		player.PlayerLaunch( launchVelocity, false )

























		return
	}
}


void function ServerToClient_ShowClusterBombJumpRadiusToOwner( entity projectile )
{
	if ( IsValid( projectile ) )
		thread ManageJumpRadiusFX( projectile )
}

void function ManageJumpRadiusFX( entity clusterBomb )
{
	
	int ringFX
	
	
	

	entity bombOwner = clusterBomb.GetOwner()
	if ( !HasPlayerMovementEventCallback( bombOwner, ePlayerMovementEvents.JUMP, ClusterBomb_OnPlayerJump ) )
		AddPlayerMovementEventCallback( bombOwner, ePlayerMovementEvents.JUMP, ClusterBomb_OnPlayerJump )

	file.activeClusterBombs.append( clusterBomb )

	if ( file.activeClusterBombs.len() == 1 )
		thread CheckForNearbyJumpBombs( bombOwner )

	OnThreadEnd(
		function( string signalID, var owner ) : ( ringFX, bombOwner, clusterBomb )
		{
			file.activeClusterBombs.fastremovebyvalue( clusterBomb )

			if ( IsValid( bombOwner ) && HasPlayerMovementEventCallback( bombOwner, ePlayerMovementEvents.JUMP, ClusterBomb_OnPlayerJump ) && file.activeClusterBombs.len() < 1 )
			{
				RemovePlayerMovementEventCallback( bombOwner, ePlayerMovementEvents.JUMP, ClusterBomb_OnPlayerJump )
			}

			if( EffectDoesExist( ringFX ) )
			{
				EffectStop( ringFX, true, false )
			}
		}
	)

	while ( IsValid( clusterBomb ) )	
	{
		wait 0.1
	}
}

void function CheckForNearbyJumpBombs( entity bombOwner )
{
	EndSignal( bombOwner, "OnDestroy", "OnDeath", "BleedOut_OnStartDying" )

	bool showingHint = false
	while ( file.activeClusterBombs.len() > 0 )
	{
		int nearbyUsableBombs
		foreach ( activeClusterBomb in file.activeClusterBombs )
		{
			if ( !IsValid( activeClusterBomb ) || !IsValid( bombOwner ) )
				continue

			if ( ClusterBomb_IsPlayerWithinJumpArea( bombOwner, activeClusterBomb ) )
			{
				nearbyUsableBombs++
			}
		}

		if ( showingHint && nearbyUsableBombs == 0 )
		{
			HidePlayerHint( "#FUSE_CLUSTER_JUMP_HINT" )
			showingHint = false
		}
		else if ( !showingHint && nearbyUsableBombs > 0 )
		{
			AddPlayerHint( 4.5, 0.0, $"", "#FUSE_CLUSTER_JUMP_HINT" )
			showingHint = true
		}

		wait 0.05
	}
}

