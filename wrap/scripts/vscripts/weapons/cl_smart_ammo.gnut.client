{
	NONE = -1,
	SCAN_WARNING,









	SHADOW_FORM,

		ZIPLINE_SHIELD,



	_LOCKON_SECTION_START,

	SONAR_DETECTED,
	CRYPTO_SCAN,

		SURVEY_BEACON_SCAN,

	LOCKON_MIRAGE_DETECTED,

	_LOCKON_SECTION_END,



		SURVEY_BEACON_ENEMIES_SCAN,




	VOID_NEXUS,
	STUCK_EMP,

		STUCK_ARROW,



	
	_LEGEND_SECTION_START,

	CAMERA,
	MAPHACK,
	SONAR,

		MORTAR_RING,


		ARCO_ULT_SCAN,




	STUCK_SONAR,
	SEER_DETECTED,
	SPAWN_KILLING,
	DAMAGE_MULTIPLIER,
	MIRAGE_DETECTED,

		FREESPAWN_VICTIM_TEAMMATE,

	BLOODHOUND,


		SONAR_PULSE,


	_LEGEND_SECTION_END,





	SONAR_BLOCKED,
	PLACING_PHASE_TUNNEL,
	TETHERED,


	_DEVICE_SECTION_START,

	DEVICE_DETECTED_0,
	DEVICE_DETECTED_1,
	DEVICE_DETECTED_10_OR_LESS,
	DEVICE_DETECTED_10_PLUS

	_DEVICE_SECTION_END,


	HUNT_MODE,







	DEVICE_BLOCKED,









	REVEALED_BY_ASH,
	REVEALING_ENEMIES,






	TARGETED_BY_BALLISTIC,
	AUTOLOADER_BUFF,
	VOID_BREACHER,
