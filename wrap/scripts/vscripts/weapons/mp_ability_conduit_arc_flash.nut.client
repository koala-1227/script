struct
{
	
	float targetingConeDot = DOT_50DEGREE
	float minRange = 5 * METERS_TO_INCHES
	float maxRange = 50 * METERS_TO_INCHES

	

	float regenDuration = 8.1
	float regenShieldPerFrame = 2.0
	float regenSelfMultiplier = 0.75





	float damagedRegenShieldMult = 0.0
	float regenDamageDelay = 1.0
	float regenSeverity = 1.0
	float regenInterval = 0.2

	
	int tempShieldMaxAmount = 125
	float tempShieldDuration = 20.0
	float tempShieldSeverity = 0.5
	int tempShieldDecayRate = 2
	float tempShieldDecaySeverity = 0.1







	
	float tempShieldChargeFinishingSoundDuration = 4.0
	float tempShieldShieldWarningSoundDuration = 2.0

	
	float upgradeMaxRangeScalar = 1.2 
	float upgradeExtraChargeRegenScalar = 0.5
	float upgradeEnduringRegenShieldMult = 1.0
	int upgradeInstantShield = 25


	float upgradeInstantRegenDuration = 6.1




	




} tuning

void function MpAbilityConduitArcFlash_Init()
{
	RegisterTuningStruct( "tuning",  "conduit_arc_flash_")

	PrecacheParticleSystem( FX_TAC_MUZZLE_FLASH )
	PrecacheParticleSystem( FX_TAC_BEAM )
	PrecacheParticleSystem( FX_TEMPSHIELD_1P )
	PrecacheParticleSystem( FX_TEMPSHIELD_3P )
	PrecacheParticleSystem( FX_TEMPSHIELD_HIT_3P )
	PrecacheParticleSystem( DEBUG_SPHERE_SOFT_FX )
	PrecacheParticleSystem( DEBUG_SPHERE_ADD_EDGE_FX )


	PrecacheParticleSystem( FX_TEMPSHIELD_1P_UPG_INSTANT )
	PrecacheParticleSystem( FX_TEMPSHIELD_3P_UPG_ENDURING )


	RegisterSignal( "TargetingStop" )




	RegisterSignal( "RefreshTempshield" )

	RegisterNetworkedVariable( CONDUIT_ARC_FLASH_BEST_TARGET_NETVAR, SNDC_PLAYER_EXCLUSIVE, SNVT_ENTITY )
	RegisterNetworkedVariable( TEMPSHIELD_ACTIVE_NETVAR, SNDC_PLAYER_GLOBAL, SNVT_BOOL, false )





#if DEV
	Assert( eArcFlashState.COUNT == sArcFlashStateStrings.len(), "Must define a string for each state." )
#endif


		StatusEffect_RegisterEnabledCallback( eStatusEffect.shields_repairing, ArcFlash_StartShieldsRepairing )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.shields_repairing, ArcFlash_StopShieldsRepairing )

		StatusEffect_RegisterEnabledCallback( eStatusEffect.shields_repairing_fx, ArcFlash_StartShieldsRepairingFX )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.shields_repairing_fx, ArcFlash_StopShieldsRepairingFX )

		RegisterSignal( "ArcFlash_EndShieldsRepairing" )
		RegisterSignal( "Conduit_MoveToPodium" )
		RegisterSignal( "Stop_ConduitPassiveNonPlayerRui_Thread" )

		AddCallback_GameStateEnter( eGameState.Resolution, Conduit_OnGameState_Podium )

}

float function GetArcFlashMaxRange( entity player )
{
	float result = tuning.maxRange








	return result
}

float function GetArcFlashDuration( entity player, int state )
{
	float result = 1

	switch ( state )
	{
		case eArcFlashState.CHARGE:
			result = tuning.regenDuration

			if( PlayerHasPassive( player, ePassives.PAS_CONDUIT ) && PlayerHasPassive( player, ePassives.PAS_TAC_UPGRADE_TWO ) ) 
			{
				result = tuning.upgradeInstantRegenDuration
			}
			break






			break
		case eArcFlashState.ACTIVE:
			result = tuning.tempShieldDuration
			break
	}

	return result
}

int function GetArcFlashTempShieldMaxAmount( entity player )
{










	return tuning.tempShieldMaxAmount
}

bool function WasRecentlyDamaged( entity target, float startTime )
{
	float timeSinceStart = Time() - startTime
	float timeSinceDamage = Time() - target.GetLastTimeDamaged()

	return timeSinceDamage < timeSinceStart && timeSinceDamage < GetArcFlashRegenDamageDelay( target )
}

float function GetArcFlashRegenShieldPerFrame( entity target, float startTime, bool hasEnduringUpgrade )
{






	bool damaged = WasRecentlyDamaged(target, startTime)
	if( damaged )
	{
		return tuning.regenShieldPerFrame * GetDamagedRegenShieldMult( hasEnduringUpgrade )
	}


	return tuning.regenShieldPerFrame
}

float function GetArcFlashRegenDamageDelay( entity player )
{





	return tuning.regenDamageDelay
}


float function GetDamagedRegenShieldMult( bool hasEnduringUpgrade )
{
	float damageShieldMult = tuning.damagedRegenShieldMult
	if ( hasEnduringUpgrade )
	{
		damageShieldMult = tuning.upgradeEnduringRegenShieldMult
	}
	return damageShieldMult
}


