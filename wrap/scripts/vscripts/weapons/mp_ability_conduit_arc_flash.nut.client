}

void function OnWeaponOwnerChanged_Internal( entity weapon, WeaponOwnerChangedParams changeParams, string stopSignal )
{
	array<entity> allyList
	file.trackedAllys[ weapon.GetOwner() ] <- allyList
	if ( IsValid( changeParams.oldOwner ) )
	{
		 changeParams.oldOwner.Signal( stopSignal )
	}

	if ( IsValid( changeParams.newOwner ) && changeParams.newOwner.IsPlayer() )
	{
		




		thread TargetingHUD_Thread( changeParams.newOwner, stopSignal )

	}
}

void function OnWeaponOwnerChanged_ability_conduit_arc_flash( entity weapon, WeaponOwnerChangedParams changeParams )
{

	if ( weapon.GetOwner() == GetLocalClientPlayer() )

	{
		OnWeaponOwnerChanged_Internal( weapon, changeParams, "TargetingStop" )
	}
}





















