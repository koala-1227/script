void function Respawn_FromDeathbox_Init ()
{

	file.savedPlaylistName = GetCurrentPlaylistName()


	bool isEnabled = Respawn_FromDeathbox_Enabled()
	if( !isEnabled )
		return

	Tunings_Init()

	Networking_Init()

	PrecacheParticleSystem( FX_RESPAWNDEATHBOX_GROUNDMARKER )

	PrecacheParticleSystem( FX_RESPAWN_PULSATE )
	PrecacheParticleSystem( FX_RESPAWN_PULSATE_OLD )
	PrecacheParticleSystem( FX_RESPAWNINGPLAYER_INCOMING )
	PrecacheParticleSystem( FX_RESPAWNEDPLAYER )
	PrecacheParticleSystem( FX_RESPAWNEDPLAYER_BOX_TO_PLAYER_BEAM )
	PrecacheParticleSystem( FX_RESPAWNEDPLAYER_1PFX )

	PrecacheModel( MDL_RESPAWNPREVIEW_HOLO_STUB ) 












		AddCreateCallback( "player_decoy", Respawn_FromDeathbox_OnDeathboxHoloCreated )

	
	
}

void function Networking_Init()
{
	
	RegisterSignal( SIG_RESPAWN_ONDEATHBOX_DISABLED )
	RegisterSignal( SIG_ONDEATHBOXRESPAWNED )
	RegisterSignal( SIG_RESPAWNDEATHBOX_ACTIVE_VISUALS )
	RegisterSignal( SIG_HOLO_OFF )
	RegisterSignal( SIG_LOCKOUTTIME_WAITTORESET )

	
	Remote_RegisterClientFunction( FUNC_RESPAWNDEATHBOX_VISUALS, "entity" )
	Remote_RegisterClientFunction( FUNC_RESPAWNEDPRESENTATION )
	Remote_RegisterClientFunction( FUNC_LOCKOUTTIME_RESET_DRAWHINT, "entity" )
	Remote_RegisterClientFunction( FUNC_ONDEATH_DRAWHINT, "entity" )
	Remote_RegisterClientFunction( FUNC_RESPAWNEDPLAYER_1PFX )

	
	RegisterNetworkedVariable( NETVAR_RESPAWN_FROMDEATHBOX_ACTIVE, SNDC_GLOBAL, SNVT_BOOL, true ) 
	RegisterNetworkedVariable( NETVAR_INT_PLAYERDEATHCOUNT, SNDC_PLAYER_GLOBAL, SNVT_INT, 0 )
	RegisterNetworkedVariable( NETVAR_BOOL_PLAYER_WAS_DEATHBOXRESPAWNED, SNDC_PLAYER_GLOBAL, SNVT_BOOL, false )
	RegisterNetworkedVariable( NETVAR_RESPAWN_FROMDEATHBOX_LOCKOUT_ENDTIME, SNDC_PLAYER_GLOBAL, SNVT_TIME, 0.0 )


		RegisterNetVarIntChangeCallback( "respawnStatus", Respawn_FromDeathbox_OnRespawnStatusChanged )
		RegisterNetVarBoolChangeCallback( NETVAR_RESPAWN_FROMDEATHBOX_ACTIVE, CL_Respawn_FromDeathbox_Show_Deactivated )
		RegisterNetVarTimeChangeCallback( NETVAR_RESPAWN_FROMDEATHBOX_LOCKOUT_ENDTIME, CL_Respawn_FromDeathbox_Lockout_EndTime_Changed )

		Waypoints_RegisterCustomType( WAYPOINT_RESPAWNDEATHBOX_NAME, Waypt_CL_OnCreated )


}


