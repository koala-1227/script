void function Respawn_FromDeathbox_SV2CL_RespawnedPresentation()
{
	
	

	
	CL_RespawnedPresentation_CameraFOVLerp()
}


void function CL_RespawnedPresentation_CameraFOVLerp()
{
	entity player = GetLocalViewPlayer()
	float fov = player.GetFOV()
	float fovStart 	= fov + tunings.respawnedPresentation_FOVOffset_Start
	float fovEnd 	= fov + tunings.respawnedPresentation_FOVOffset_End
	float duration = tunings.respawnedPresentation_Duration_Incoming + tunings.respawnedPresentation_Duration_Spawn
	player.SetObserverModeStaticFOVLerp( fovStart, fovEnd, duration )
}

void function CL_RespawnedPresentation_CameraMove_Thread()
{
	

	entity player = GetLocalViewPlayer()
	EndSignal( player, "OnDeath", "OnDestroy" )

	wait 1.0

	EmitSoundOnEntity( player, "FiringRangeMu1_HighPoint_1P" )

	entity rotator = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", player.EyePosition(), <0,0,0> )

	OnThreadEnd(
		void function() : ( player, rotator )
		{
			player.ClearMenuCameraEntity()
			rotator.Destroy()
		}
	)

	rotator.NonPhysicsSetRotateModeLocal( true )

	const float HALF_ROTATE_TIME = 2.5
	const float EASE_IN_TIME = 1.0 
	const float EASE_OUT_TIME = 0.5
	const float START_STAGE_TIME = HALF_ROTATE_TIME + ( EASE_IN_TIME / 2 )


	rotator.NonPhysicsRotateTo( <0,180,0>, tunings.respawnedPresentation_Duration_Incoming, EASE_IN_TIME, EASE_OUT_TIME )
	entity mover = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", player.CameraPosition(), player.CameraAngles() )
	mover.SetParent( rotator )
	vector endPos = mover.GetLocalOrigin()
	mover.NonPhysicsSetMoveModeLocal(true)
	vector cameraForwardFlatNormalized = Normalize(FlattenVec(AnglesToForward(player.CameraAngles())))
	mover.NonPhysicsMoveTo( (cameraForwardFlatNormalized * -300) + <0, 0, 0>, tunings.respawnedPresentation_Duration_Incoming, EASE_IN_TIME, EASE_OUT_TIME )
	entity camera = CreateClientSidePointCamera( mover.GetOrigin(), mover.GetAngles(), player.GetFOV() )
	camera.SetParent( mover )
	player.SetMenuCameraEntity( camera )
	player.SetMenuCameraUseGameExposure()

	vector focusPoint = player.CameraPosition() + (AnglesToForward(player.CameraAngles()) * Distance( player.CameraPosition(), player.EyePosition() ) )
	entity cameraFocusPoint = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", focusPoint, <0,0,0> )
	cameraFocusPoint.NonPhysicsMoveTo( focusPoint + <0, 0, 150>, 3, 1, .5 )

	float startTime = Time()
	const float TOTAL_ROTATE_TIME = HALF_ROTATE_TIME + START_STAGE_TIME
	float endTime = startTime + TOTAL_ROTATE_TIME

	bool finshedStartStage = false
	float startStageEndTime = Time() + START_STAGE_TIME

	bool startedEndStage = false
	const float END_STAGE_TIME = 2
	float endStageStartTime = Time() + TOTAL_ROTATE_TIME - END_STAGE_TIME
	while ( Time() < endTime )
	{
		if ( !finshedStartStage && Time() >= startStageEndTime )
		{
			finshedStartStage = true
			rotator.NonPhysicsRotate( <0,0,1>, 30 )
		}

		if ( !startedEndStage && Time() >= endStageStartTime )
		{
			startedEndStage = true
			cameraFocusPoint.NonPhysicsMoveTo( focusPoint, END_STAGE_TIME, 1, .5 )
			mover.NonPhysicsMoveTo( endPos, END_STAGE_TIME, 1, .5 )
		}

		vector cameraToCameraFocus = Normalize(cameraFocusPoint.GetOrigin() - mover.GetOrigin())

		camera.SetAngles( VectorToAngles(cameraToCameraFocus) )
		WaitFrame()
	}
}

void function Respawn_FromDeathbox_OnDeathboxHoloCreated( entity holo )
{
	if ( !IsValid( holo ) )
		return

	if ( holo.GetScriptName() != RESPAWNDEATHBOX_HOLO_SCRIPTNAME )
		return

	if( !tunings.previewHolo_VisibleToAll )
	{
		
		entity player = GetLocalViewPlayer()
		entity owner = holo.GetOwner()
		if( player != owner )
			return
	}

	holo.Highlight_SetVisibilityType( HIGHLIGHT_VIS_ALWAYS )
	holo.Highlight_SetCurrentContext( HighlightContext_GetId( "deathbox_respawn_holograph" ) )
	holo.Highlight_SetFadeInTime( tunings.respawnedPresentation_Duration_Incoming )
	holo.Highlight_SetFadeOutTime( 0.5 )
	holo.Highlight_SetLifeTime( tunings.respawnedPresentation_Duration_Incoming )
	holo.Highlight_StartOn()
}

void function Respawn_FromDeathbox_SV2CL_LockoutTimerResetHint( entity lockoutOwner )
{
	if ( !IsValid( lockoutOwner ) )
		return

	if ( !tunings.hud_ShowMessage_LockoutTimeReset )
		return

	entity player = GetLocalViewPlayer()

	if ( player == lockoutOwner )
	{
		AddPlayerHint( 5.0, 1.0, $"", "#DEATHBOXRESPAWN_HINT_LOCKOUTTIME_RESET_SELF" )
		EmitSoundOnEntity( player, SFX_LOCKOUTTIME_RESET_SELF )
	}
	else
	{
		AddPlayerHint( 5.0, 1.0, $"", Localize( "#DEATHBOXRESPAWN_HINT_LOCKOUTTIME_RESET_TEAMMATE", lockoutOwner.GetPlayerName() ) )
		EmitSoundOnEntity( player, SFX_LOCKOUTTIME_RESET_TEAMMATE )
	}
}

void function Respawn_FromDeathbox_SV2CL_DeathboxRecoveryOnDeathHint( entity deathboxOwner )
{
	if ( !IsValid( deathboxOwner ) )
		return

	if ( !tunings.hud_ShowMessage_RecoverTeammateAtBox )
		return

	if ( !RespawnLockout_IsPlayerLockedOut( deathboxOwner ) )
	{
		AddPlayerHint( 5.0, 1.0, $"", Localize( "#DEATHBOXRESPAWN_HINT_RECOVER_TEAMMATE", deathboxOwner.GetPlayerName() ) )
	}
}

void function Respawn_FromDeathbox_SV2CL_Respawned1P_FX()
{
	entity playerToUse = GetLocalViewPlayer()

	entity cockpit = playerToUse.GetCockpit()
	if ( !cockpit )
		return

	int fxID = GetParticleSystemIndex( FX_RESPAWNEDPLAYER_1PFX )
	int fxHandle = StartParticleEffectOnEntity( cockpit, fxID, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )

	EffectSetIsWithCockpit( fxHandle, true )

	
	vector shieldColor = GetFXRarityColorForTier( 1 )
	EffectSetControlPointVector( fxHandle, 1, shieldColor )
}




