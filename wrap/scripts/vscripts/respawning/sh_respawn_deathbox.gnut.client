string function Respawn_FromDeathbox_Get_UsePrompts( entity player, entity deathBox )
{
	string result = ""

	if( Respawn_FromDeathbox_Enabled() && Respawn_FromDeathbox_Active() )
	{

		string formattedString = Respawn_FromDeathbox_UsePrompt ( player, deathBox )
		if (formattedString != "")
		{
			result = formattedString
		}
	}
	return result
}

string function Respawn_FromDeathbox_UsePrompt( entity player, entity deathBox )
{
	string result = ""

	entity deadPlayer = deathBox.GetOwner()
	entity localViewPlayer = GetLocalViewPlayer()

	if ( !IsValid ( deadPlayer ) )
		return result

	if ( IsAlive( deadPlayer ) )
		return result

	if ( !IsValid ( localViewPlayer ) )
		return result

	bool isFriendly = IsFriendlyTeam( localViewPlayer.GetTeam(), deadPlayer.GetTeam() )

	if ( isFriendly )
	{
		if( Deathbox_Latest_Get( deadPlayer ) != deathBox )
			return result

		if( HasTeammatesRespawningFromBeacon( player.GetTeam() ) )
			return Localize( "#HINT_RESPAWN_INPROGRESS" )

		bool inUseRange = Respawn_FromDeathbox_PlayerInUseRange( player, deathBox )
		if( !inUseRange )
			return result

		string deadPlayerName = deadPlayer.GetPlayerName()
		if( !DeathBoxRespawn_InProgress_Check( deathBox ) )
		{
			result = Localize( "#DEATHBOX_RESPAWN_PROMPT", deadPlayerName )
			if( tunings.respawnLockout_Enabled )
			{
				
				string lockoutPrompt = RespawnLockout_Prompt( deadPlayer )
				if( lockoutPrompt != "" )
				{
					result = lockoutPrompt
				}
			}
		}
	}

	return result
}



