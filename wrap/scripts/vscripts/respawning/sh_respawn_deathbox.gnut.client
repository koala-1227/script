void function CL_Respawn_FromDeathbox_Show_Deactivated( entity player, bool isActivated )
{
	
	
	
	
	
	

	clGlobal.levelEnt.Signal( SIG_RESPAWN_ONDEATHBOX_DISABLED )

#if DEV
		DevOut( FUNC_NAME() + "(): Called. isActivated == " + isActivated )
#endif

	Respawn_FromDeathbox_ShowRespawnsDisabledSplash()

	
	foreach( boxEHI in file.activeTeammateDeathBoxes_EHIs )
	{
		entity activeDeathbox = FromEHI( boxEHI )
		if( IsValid( activeDeathbox ) )
		{
			activeDeathbox.Signal( SIG_RESPAWNDEATHBOX_ACTIVE_VISUALS )
		}
	}
}

void function Respawn_FromDeathbox_ShowRespawnsDisabledSplash()
{
	if ( GetGameState() != eGameState.Playing )
		return

	const string 	MSG_TEXT 	= "#ANNOUNCE_TEXT_DEATHBOX_RESPAWN_DISABLED"
	const string	MSG_SUBTEXT = "#ANNOUNCE_TEXT_DEATHBOX_RESPAWN_DISABLED"
	const float 	MSG_DURATION = 4.0
	const string 	SFX_DEATHBOX_RESPAWN_DEACTIVATED = "UI_3Strikes_RespawningDisabled"

	string message = Localize( MSG_TEXT )
	AnnouncementData announcement = Announcement_Create( message )

	int style = ANNOUNCEMENT_STYLE_FINAL_RING_NO_RESPAWNS
	string subText = ""
	vector messageColor = SrgbToLinear( GetKeyColor( COLORID_DANGER_WARNING_RED ) / 255 )

	Announcement_SetUseColorOnSubtext( announcement, false )
	Announcement_SetFrameColor( announcement, messageColor )
	Announcement_SetTitleColor( announcement, <1.0, 1.0, 1.0> )
	Announcement_SetDuration( announcement, MSG_DURATION )
	Announcement_SetStyle( announcement, style )

	CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateDeprecatedStyle( announcement )
	mainBanner.priority = eHudNotificationQueuePriority.HIGH
	mainBanner.soundAliases = [ SFX_DEATHBOX_RESPAWN_DEACTIVATED ]
	
	CenterAnnouncements_QueueItem( mainBanner, ePersistenceContext.GLOBAL )
}





