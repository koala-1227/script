int function PlayerDeathCount_Get( entity player )
{
	if( !IsValid( player ) )
		return 0

	if( !player.IsPlayer() )
		return 0

	int result = player.GetPlayerNetInt( NETVAR_INT_PLAYERDEATHCOUNT )
	
	
	

	return result
}

float function RespawnLockout_Duration( entity playerToRespawn )
{
	if( !tunings.respawnLockout_Enabled )
		return 0.0

	float duration = 0.0
	int numDeaths = PlayerDeathCount_Get( playerToRespawn )
	if( numDeaths > 1 )
	{
		float possibleDuration = tunings.respawnLockout_Penalty_Base * pow( 2, numDeaths - 2 )
		duration = min ( possibleDuration, tunings.respawnLockout_Escalation_Period )
	}

	return duration
}

float function RespawnLockout_TimeLeft( entity playerToRespawn )
{
	if( !tunings.respawnLockout_Enabled )
		return 0

	float lockoutDuration = RespawnLockout_Duration( playerToRespawn )
	float timePassed = Time() - playerToRespawn.GetDeathTime()
	float timeLeft = lockoutDuration - timePassed

	return timeLeft
}

bool function RespawnLockout_IsPlayerLockedOut( entity playerToRespawn )
{
	if( !tunings.respawnLockout_Enabled )
		return false

	if( !IsValid( playerToRespawn ) )
		return true

	bool isLockedOut = RespawnLockout_TimeLeft( playerToRespawn ) > 0

	return isLockedOut
}






string function RespawnLockout_Prompt( entity playerToRespawn )
{
	

	if( !tunings.respawnLockout_Enabled )
		return ""

	if( !IsValid( playerToRespawn ) || !playerToRespawn.IsPlayer() )
		return ""

	float timeLeft = RespawnLockout_TimeLeft( playerToRespawn )
	if( timeLeft <= 0 )
		return ""

	float msecsleft = timeLeft - int( timeLeft )
	string timeStr = format( "%02d", timeLeft + 1 )

	string prompt = Localize( "#HINT_DEATHBOX_RESPAWN_PLAYER_LOCKED", playerToRespawn.GetPlayerName(), timeStr )

	return prompt
}


























