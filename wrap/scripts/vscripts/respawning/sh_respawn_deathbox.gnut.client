bool function Respawn_FromDeathbox_Enabled()
{

	
	string currentPlaylistName = GetCurrentPlaylistName()
	if ( currentPlaylistName != file.savedPlaylistName )
	{
		
		bool isEnabled = GetPlaylistVarBool( file.savedPlaylistName, "Respawn_FromDeathbox_Enabled", false )
		return isEnabled
	}

	bool isEnabled = GetCurrentPlaylistVarBool( "Respawn_FromDeathbox_Enabled", false )
	return isEnabled
}




bool function Respawn_FromDeathbox_Active()
{
	if( IsLobby() )
		return false

	if( GetGameState() != eGameState.Playing )
		return false

	if ( !Respawn_FromDeathbox_Enabled() )
		return false

	bool isActive = GetGlobalNetBool( NETVAR_RESPAWN_FROMDEATHBOX_ACTIVE )
	return isActive
}

void function Respawn_FromDeathbox_Execute_Thread( entity reviver, entity deathBox )
{
	if ( !IsValid ( deathBox ) )
		return

	vector deathboxLoc = deathBox.GetOrigin()
	vector deathboxCenter = deathBox.GetWorldSpaceCenter()
	entity playerToSpawn = deathBox.GetOwner()

	if ( !IsValid ( playerToSpawn ) )
		return

	if ( IsAlive( playerToSpawn ) )
		return

	playerToSpawn.EndSignal( "OnDestroy" )
	OnThreadEnd(
		function ():( reviver, playerToSpawn )
		{



		}
	)


































































































}




























































































































































































































































































void function Respawn_FromDeathbox_OnUse( entity player, entity deathBox )
{
	if( !Respawn_FromDeathbox_Enabled() )
		return

	if( !Respawn_FromDeathbox_Active() )
		return

	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	if( !IsValid( deathBox ) )
		return

	entity owner = deathBox.GetOwner()
	if( !IsValidPlayer( owner ) )
		return

	if ( IsAlive( owner ) )
		return

	bool isFriendly = IsFriendlyTeam( player.GetTeam(), owner.GetTeam() )
	if ( !isFriendly )
		return

	if( !Respawn_FromDeathbox_PlayerCanUseDeathBox( player ) )
		return

	if( !Respawn_FromDeathbox_PlayerInUseRange( player, deathBox ) )
		return

	if( DeathBoxRespawn_InProgress_Check( deathBox ) )
		return

	if( RespawnLockout_IsPlayerLockedOut( owner ) )
		return







		if( IsWatchingKillReplay() )
			return


	entity playerToRespawn = deathBox.GetOwner()
	if( Deathbox_Latest_Get( playerToRespawn ) != deathBox )
		return






	ExtendedUseSettings settings
	settings.duration = tunings.useHoldTime
	settings.successFunc = Respawn_FromDeathbox_ExtendedUseSuccess
	settings.failureFunc = Respawn_FromDeathbox_ExtendedUseFailure
	settings.useInputFlag = IN_USE_ALT
	settings.maxUseDist2 = tunings.useRadiusSqr

	settings.successSound = SFX_DEATHBOXRESPAWN_SUCCESS
	settings.movementDisable = true























		settings.loopSound = "survival_titan_linking_loop"
		settings.hint = Localize( "#DEATHBOX_RESPAWN_INPROGRESS", owner.GetPlayerName() )
		settings.ruiType = eExtendedUseRui.PROGRESS_BAR
		settings.icon = ICON_DEATHBOX_RESPAWN_NO_FRAME
		settings.isSupportClass = tunings.passiveBased_HealOverTime_Enabled && ( Perks_DoesPlayerHavePerk( player, ePerkIndex.REVIVE_EXPERT ) || Perks_DoesPlayerHavePerk( owner, ePerkIndex.REVIVE_EXPERT ) )
		settings.supportClassColor = SrgbToLinear( GetKeyColor( COLORID_HUD_PROGRESSBAR_COLOR_REVIVE ) / 255.0 )
		
		


	

	thread ExtendedUse( deathBox, player, settings, true )
}

void function Respawn_FromDeathbox_ExtendedUseSuccess( entity deathBox, entity player, ExtendedUseSettings settings )
{
	thread Respawn_FromDeathbox_Execute_Thread ( player, deathBox )
}

void function Respawn_FromDeathbox_ExtendedUseFailure( entity deathBox, entity player, ExtendedUseSettings settings )
{








}

bool function Respawn_FromDeathbox_PlayerCanUseDeathBox( entity player )
{
	if ( !IsValid( player ) )
		return false

	if ( player.p.isInExtendedUse )
		return false

	if( HasTeammatesRespawningFromBeacon( player.GetTeam() ) )
		return false

	return true
}

bool function Respawn_FromDeathbox_PlayerInUseRange( entity player, entity deathBox )
{
	if( !IsValid( player ) )
		return false

	if( !IsValid( deathBox ) )
		return false

	if( DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() ) > tunings.useRadiusSqr )
		return false

	return true
}






















































































































































































































































