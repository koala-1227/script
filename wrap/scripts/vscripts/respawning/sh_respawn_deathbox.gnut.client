entity function Waypt_ForDeathBox_Get( entity box )
{
	entity wp

	if( !IsValid( box ) )
		return wp

	EHI deathBoxEHI = ToEHI( box )
	if( deathBoxEHI in file.respawnDeathbox_Waypts )
	{
		wp = file.respawnDeathbox_Waypts[ deathBoxEHI ]
	}
	return wp
}

void function Respawn_FromDeathBox_Waypt_ForDeathBox_Remove( entity box )
{
	EHI deathBoxEHI = ToEHI( box )
	if( deathBoxEHI in file.respawnDeathbox_Waypts )
	{
		delete file.respawnDeathbox_Waypts[ deathBoxEHI ] 
	}
}


void function Waypt_CL_OnCreated( entity wp )
{
	if ( !IsValid( wp ) )
		return

	if ( wp.GetWaypointCustomType() != WAYPOINT_RESPAWNDEATHBOX_NAME )
		return

	entity deathBox = wp.GetWaypointEntity( WAYPT_RESPAWNDEATHBOX_ENT_IDX_DEATHBOX )

	EHI deathBoxEHI = ToEHI( deathBox )
	file.respawnDeathbox_Waypts[ deathBoxEHI ] <- wp
}


