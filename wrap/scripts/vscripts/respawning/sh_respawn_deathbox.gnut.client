void function Respawn_FromDeathbox_SV2CL_RespawnDeathbox_Visuals( entity deathbox )
{
	if( !tunings.markRespawnDeathbox )
		return

	thread CL_RespawnDeathbox_Visuals_Thread (deathbox)
}

void function CL_RespawnDeathbox_Visuals_Thread ( entity deathbox )
{
	wait 1.0

	if( !Respawn_FromDeathbox_Enabled() )
		return

	if( !Respawn_FromDeathbox_Active() )
		return

	if( !IsValid( deathbox ) )
		return

	entity owner = deathbox.GetOwner()

	if( !IsValid( owner ) )
		return

	owner.EndSignal( "OnDestroy" )
	owner.EndSignal( SIG_ONDEATHBOXRESPAWNED )
	deathbox.EndSignal( "OnDestroy" )
	deathbox.EndSignal( SIG_RESPAWNDEATHBOX_ACTIVE_VISUALS )

	EHI deathboxEHI = ToEHI( deathbox )
	if( !file.activeTeammateDeathBoxes_EHIs.contains( deathboxEHI ) )
	{
		file.activeTeammateDeathBoxes_EHIs.append( deathboxEHI )
	}

	const float SCALE_MINIMAP = 1.1
	const float SCALE_FULLMAP = 11

	vector loc = deathbox.GetOrigin()
	vector ang = < 0, 0, 0 >
	

	vector mapIconColor = GetPlayerInfoColor( owner ) / 255.0

	
	float fadeDistance = 20.0 * METERS_TO_INCHES

	var rui_Overhead = AddOverheadIcon( deathbox, ICON_DEATHBOX_RESPAWN, false, $"ui/overhead_icon_generic.rpak" )
	RuiSetFloat3 ( rui_Overhead, "pos", deathbox.GetOrigin() + < 0, 0, 32 > )
	RuiSetFloat2( rui_Overhead, "iconSize", < 70, 70, 0 > )
	RuiSetFloat( rui_Overhead, "distanceFade", fadeDistance )
	RuiSetBool( rui_Overhead, "adsFade", true )
	RuiSetBool( rui_Overhead, "pinToEdge", false )

	
	

	vector playerColor = GetPlayerInfoColor( owner )

	OnThreadEnd
	(
		function() : ( deathbox, deathboxEHI, rui_Overhead )
		{
			if( IsValid( deathbox ) )
			{
				
				
				if( file.activeTeammateDeathBoxes_EHIs.contains( deathboxEHI ) )
				{
					file.activeTeammateDeathBoxes_EHIs.fastremovebyvalue( deathboxEHI )
				}
			}

			RuiDestroyIfAlive( rui_Overhead )
			HidePlayerHint( "#RESPAWN_AT_BEACONS_HINT" )
		}
	)

	float radiusMin = 90
	float radiusMax = 55.0
	float radiusDelta = -0.25
	float radiusCurrent = radiusMax

	
	
	

	int team = owner.GetTeam()
	bool hasAliveTeammates = GetPlayerArrayOfTeam_Alive( team ).len() > 0
	bool wasLocked = false
	while( !IsAlive( owner ) && hasAliveTeammates )
	{
		if( tunings.respawnLockout_Enabled )
		{
			string lockoutPrompt = RespawnLockout_Prompt( owner )
			if( ( lockoutPrompt != "" ) )
			{
				
				RuiSetImage( rui_Overhead, "icon", ICON_DEATHBOX_RESPAWN_LOCKED )
				wasLocked = true
			}
			else if( ( lockoutPrompt == "" ) && wasLocked )
			{
				
				RuiSetImage( rui_Overhead, "icon", ICON_DEATHBOX_RESPAWN )
				wasLocked = false
			}
		}

		WaitFrame()
		hasAliveTeammates = GetPlayerArrayOfTeam_Alive( team ).len() > 0
	}
}



