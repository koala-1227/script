}



bool function FreeRespawns_CanLocalPlayerRespawn()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return false

	bool squadEliminated = player.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.SQUAD_ELIMINATED
	int squadLives = player.GetPlayerNetInt( NETVAR_FREERESPAWNS_SQUAD_LIVES )
	bool canRespawn = !squadEliminated && squadLives > -1

	return canRespawn
}



array< int > function Get_Squads_NotEliminated()
{
	array< int > results
	array< entity > allPlayers  = GetPlayerArray()

	foreach( player in allPlayers )
	{
		if( !IsValid( player ) )
			continue

		if( !player.IsPlayer() )
			continue

		if( GetRespawnStatus( player ) == eRespawnStatus.SQUAD_ELIMINATED )
			continue

		int playerTeam = player.GetTeam()
		if( !results.contains( playerTeam ) )
		{
			results.append( playerTeam )
		}
	}

	return results
}































































