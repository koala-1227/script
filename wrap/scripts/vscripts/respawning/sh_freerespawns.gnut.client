void function Freespawns_SV2CL_FreespawnsEnabled_Update( entity player, bool isOn )
{
	Freespawns_DisabledForPlayer_Set( GetLocalViewPlayer(), !isOn )
}

void function Freespawns_OnRespawnsEndTimeChanged( entity player, float endTime )
{
	thread Freespawns_RespawnsClosingWarning_Thread( player, endTime )
}

void function Freespawns_RespawnsClosingWarning_Thread( entity player, float endTime )
{
	if ( !IsValid( player ) )
		return

	player.Signal( NETVAR_FREERESPAWNS_RESPAWNS_CLOSING_THREAD_SIGNAL )
	player.EndSignal( NETVAR_FREERESPAWNS_RESPAWNS_CLOSING_THREAD_SIGNAL )
	player.EndSignal( "OnDestroy" )

	float timeTilRespawnsWarning = endTime - Time() - Freespawns_PLV_RespawnsClosingWarningSeconds()
	if ( timeTilRespawnsWarning < 0 )
		return

	wait timeTilRespawnsWarning

	array< string > voLines = [ "diag_ap_aiNotify_respawnDisableWarning_01_01", "diag_ap_aiNotify_respawnDisableWarning_01_02" ]
	EmitSoundOnEntity( player, voLines.getrandom() )
}





