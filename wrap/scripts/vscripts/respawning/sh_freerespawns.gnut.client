void function SetupMapRuiRespawnLocation( entity ent, var rui, bool isFullMap )
{
	RuiSetAsset( rui, "areaImage", $"rui/hud/common/radial_gradiant" )
	RuiSetImage( rui, "centerImage", $"" )
	RuiSetImage( rui, "clampedImage", $"" )
	RuiSetFloat( rui, "areaImageAlpha", 0.95 )

	string areaColorArgName = "objColor"
	if ( !isFullMap )
	{
		RuiSetBool( rui, "useOverrideColor", true )
		areaColorArgName = "overrideColor"
	}

	RuiSetColorAlpha( rui, areaColorArgName, SrgbToLinear( <57, 181, 74> / 255 ), 1 )

	RuiSetFloat( rui, "objectRadius", DropshipGroupSpawn_PLV_DiveRadius() / 16384)
}



void function Freespawns_SV2CL_RespawnStatus_Announce( entity subjectPlayer, int respawnObitType )
{
	const asset LIVES_ICON = $"rui/hud/gamestate/extra_life_icon"

	entity player = GetLocalViewPlayer()

	if( !IsValid( player ) )
		return

	if( !IsValid( subjectPlayer ) )
		return

	if( !subjectPlayer.IsPlayer() )
		return

	if ( GetGameState() != eGameState.Playing )
		return

	bool isSelf = player == subjectPlayer
	bool isAlly = player.GetTeam() == subjectPlayer.GetTeam()

	sAnnouncementFields aFields

	CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
	CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
	mainBanner.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT
	mainBanner.duration = 5.0 
	mainBanner.backgroundAlpha = 0.8
	mainBanner.scalar = 0.8


	CenterAnnouncementItem playerBanner = CenterAnnouncements_CreateGradientStyle()
	playerBanner.mainText = GetDisplayablePlayerName( subjectPlayer )
	playerBanner.paddingTop = 5.0
	playerBanner.scalar = 0.6
	playerBanner.mainTextIsUpper = false



		playerBanner.mainTextFontFace = DEFAULT_FONT


	switch( respawnObitType )
	{
		case eFreespawnObitType.IS_RESPAWNING:	
			if( isSelf )
			{
				
				Obituary_Print_Localized( Localize( "#FREESPAWNSV2_OBIT_YOURE_FREESPAWNING" ), COLOR_GREEN )

				
				if ( !FreeRespawns_Feature_IsInEffect() )
				{
					FreeRespawns_ShowRespawnsDisabledSplash( true )
				}
				else
				{
					if ( Freespawns_PLV_Show_RespawnStatus_OnTeammateKilled() )
					{
						array< entity > aliveTeammates = GetPlayerArrayOfTeam_Alive( player.GetTeam() )
						aliveTeammates.fastremovebyvalue( player )

						
						if ( aliveTeammates.len() >= GetTeamSize( player.GetTeam() ) - 1 )
							break

						mainBanner.mainText = Localize( aliveTeammates.len() > 0 ? "#FREESPAWNS_RESPAWN_TEAMMATES_STATUS" : "#FREESPAWNV2_LONE_SURVIVOR" )
						mainBanner.frameColor = GetKeyColor( COLORID_DANGER_WARNING_RED ) / 255.0
						mainBanner.leftIntensityTextureCount = 1
						mainBanner.rightIntensityTextureCount = 1

						playerBanner.mainText = Localize( aliveTeammates.len() > 0 ? "#FREESPAWNS_RESPAWN_TEAMMATES_STATUS_SUB" : "#FREESPAWNV2_LONE_SURVIVOR_SUB" )

						AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, playerBanner ] )
						builder.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT

						CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )
					}
				}
			}
			else
			{
				if ( !isAlly && Time() - file.enemyRespawningLastAnnounceTime < Freespawns_PLV_RespawningEnemy_WarnDebounceTime() )
					break;

				file.enemyRespawningLastAnnounceTime = isAlly ? file.enemyRespawningLastAnnounceTime : Time()
				if ( isAlly && ShowRespawnObitForAlly() )
				{
					string playerName = GetDisplayablePlayerName( subjectPlayer )
					vector playerColor = GetKeyColor( COLORID_MEMBER_COLOR0, subjectPlayer.GetTeamMemberIndex() )

					ObitRankBadgeInfo badgeInfo
					Obituary_Print_PlayerDeath( "", LIVES_ICON, "", $"", playerName, badgeInfo, <255, 255, 255>, playerColor, <255, 255, 255>, false, 0 )
					EmitSoundOnEntity( player, FREESPAWN_SOUND_1P_ALLYRESPAWNED )
				}

				if ( isAlly && ShowRespawnBannerForAlly() )
				{
					mainBanner.mainText = Localize( "#FREESPAWNSV2_OBIT_VICTIM_ISRESPAWNING_TOALLIES" )
					mainBanner.frameColor = GetKeyColor( COLORID_MEMBER_COLOR0, subjectPlayer.GetTeamMemberIndex() ) / 255.0
					mainBanner.soundAliases.append( FREESPAWN_SOUND_1P_ALLYRESPAWNED )
					mainBanner.mainIcon1 = LIVES_ICON
					mainBanner.imageContainerFrameColor = mainBanner.frameColor

					array< CenterAnnouncementItem > banners = [ mainBanner, playerBanner ]
					AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( banners )
					builder.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT
					CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )
				}

				if ( !isAlly && ShowRespawnObitForEnemy() )
				{
					string playerName = GetDisplayablePlayerName( subjectPlayer )
					vector playerColor = GetKeyColor( COLORID_DANGER_WARNING_YELLOW )

					ObitRankBadgeInfo badgeInfo
					Obituary_Print_PlayerDeath( "", LIVES_ICON, "", $"", playerName, badgeInfo, <255, 255, 255>, playerColor, <255, 255, 255>, false, 0 )
					EmitSoundOnEntity( player, FREESPAWN_SOUND_1P_ENEMYNEARBY )
				}

				if ( !isAlly && ( ShowRespawnBannerForEnemy() ) )
				{
					mainBanner.mainText = Localize( "#FREESPAWNSV2_OBIT_VICTIM_ISRESPAWNING_TOENEMIES" )
					mainBanner.frameColor = GetKeyColor( COLORID_DANGER_WARNING_YELLOW ) / 255.0
					mainBanner.soundAliases.append( FREESPAWN_SOUND_1P_ENEMYNEARBY )
					mainBanner.leftIntensityTextureCount = 1
					mainBanner.rightIntensityTextureCount = 1

					if ( MinimapAnnouncements_IsEnabled() )
					{
						MapAnnouncementItem mapAnnouncementItem
						mapAnnouncementItem.message = mainBanner.mainText
						mapAnnouncementItem.colorIn = < 245, 165, 35 > / 255.0
						mapAnnouncementItem.icon = $"rui/hud/small_announcements/icon_enemy_nearby"
						mapAnnouncementItem.iconShadow = $"rui/hud/small_announcements/icon_enemy_nearby_shadow"
						mapAnnouncementItem.priority = eHudNotificationQueuePriority.LOW
						mapAnnouncementItem.speakerDialogueLines = mainBanner.speakerDialogueLines

						MinimapAnnouncement_QueueItem( mapAnnouncementItem )
						return
					}

					AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner ] )
					builder.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT

					CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )
				}
			}
			break
		case eFreespawnObitType.TEAMMATE_KILLED:
			if ( Freespawns_PLV_Show_RespawnStatus_OnTeammateKilled() )
			{
				mainBanner.mainText = Localize( "#FREESPAWNV4_SQUAD_SURVIVOR" )
				mainBanner.frameColor = GetKeyColor( COLORID_DANGER_WARNING_RED ) / 255.0
				mainBanner.mainIcon1 = $"rui/rui_screens/obj_skull_splash"
				mainBanner.imageContainerFrameColor = mainBanner.frameColor
				mainBanner.leftIntensityTextureCount = 1
				mainBanner.rightIntensityTextureCount = 1

				AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, playerBanner ] )
				builder.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT

				CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )
			}
			break
		case eFreespawnObitType.SQUAD_SURVIVOR:
			mainBanner.mainText = Localize( "#FREESPAWNV2_LONE_SURVIVOR" )
			mainBanner.frameColor = GetKeyColor( COLORID_DANGER_WARNING_RED ) / 255.0
			mainBanner.mainIcon1 = $"rui/rui_screens/obj_tri_skull"
			mainBanner.soundAliases.append( SQUAD_SURVIVOR_SOUND_ANNOUNCE )
			mainBanner.imageContainerFrameColor = mainBanner.frameColor
			mainBanner.leftIntensityTextureCount = 3
			mainBanner.rightIntensityTextureCount = 3

			playerBanner.mainText = FreeRespawns_Feature_IsInEffect() ? Localize( "#FREESPAWNV2_LONE_SURVIVOR_SUB_RESPAWNSON" ) : Localize( "#FREESPAWNV2_LONE_SURVIVOR_SUB_RESPAWNSOFF" )

			AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, playerBanner ] )
			builder.priority = FREESPAWN_ANNOUNCEMENT_PRIORITY_DEFAULT

			builder.onPreIntro = bool function( HudNotificationQueueItem queueItem )
			{
				entity player = GetLocalViewPlayer()

				if ( !IsValid( player ) )
					return false

				array< entity > aliveAllies = GetPlayerArrayOfTeam_Alive( player.GetTeam() )
				int alliesStillStandingCount
				foreach( ally in aliveAllies )
				{
					if( !Bleedout_IsBleedingOut( ally ) )
					{
						alliesStillStandingCount++
					}
				}

				int livingAllyCountForMessaging = Freespawns_PLV_Show_RespawnStatus_CountDownedTeammatesAsLiving() ? aliveAllies.len() : alliesStillStandingCount

				
				return livingAllyCountForMessaging == 1
			}

			CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )
			break
		case eFreespawnObitType.ELIMINATED_A_SQUAD:
			
			Obituary_Print_Localized( Localize( isSelf ? "#FREESPAWNS_RESPAWN_OBIT_ELIMINATEDASQUAD_BYYOU" : "#FREESPAWNS_RESPAWN_OBIT_ELIMINATEDASQUAD", GetDisplayablePlayerName( subjectPlayer ) ), COLOR_GREEN, COLOR_WHITE, COLOR_WHITE, COLOR_WHITE, 0.0, false, OBIT_FLAG_SQUAD_WIPE )
			EmitSoundOnEntity( player, FREESPAWN_SOUND_1P_ELIMINATED_A_SQUAD )
			break
		default:
			break
	}
}


