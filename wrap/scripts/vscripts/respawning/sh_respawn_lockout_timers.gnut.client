void function LockoutTimers_Init()
{
	RegisterNetworking()
	RegisterSignals()
	RegisterCallbacks()

	LockoutTime_Minimums_Init()
	LockoutTime_DeathPenalties_Explicit_Init()

		KnockedRespawnStatusWidget_Init()
		RespawnTimeReductionWidget_Init()





}

void function RegisterNetworking()
{
	RegisterNetworkedVariable( LOCKOUT_TUNINGS_INTRO_ACTIVE, SNDC_GLOBAL, SNVT_BOOL  )
	RegisterNetworkedVariable( LOCKOUT_TUNINGS_HYPER_ACTIVE, SNDC_GLOBAL, SNVT_BOOL  )

	RegisterNetworkedVariable( NETVAR_PERSONAL_LOCKOUT_BASE_TIME_ADJUSTMENTS, SNDC_PLAYER_EXCLUSIVE, SNVT_TIME, 0.0 )
	RegisterNetworkedVariable( NETVAR_PERSONAL_LOCKOUT_START_TIME, SNDC_PLAYER_GLOBAL, SNVT_TIME, 0.0 )
	RegisterNetworkedVariable( NETVAR_PERSONAL_LOCKOUT_END_TIME, SNDC_PLAYER_GLOBAL, SNVT_TIME, 0.0 )

	Remote_RegisterClientFunction( string( LockoutTime_ServerToClient_OnAggroRewardReceived ), "entity", 		"int", 0, eFreespawns_AggroType.COUNT_, "int", 0, 100000 )
}

void function RegisterSignals()
{





		RegisterSignal( RESPAWN_COUNTDOWN_THREAD_START )

}

void function RegisterCallbacks()
{
















		RegisterNetVarTimeChangeCallback( NETVAR_PERSONAL_LOCKOUT_END_TIME, LockoutTime_OnPersonalLockoutEndTimeChanged )

}

void function LockoutTime_Minimums_Init()
{
	string lockoutTimes_String = Lockout_PLV_LockoutTimeMinimums_ByRound()
	array< string > lockoutTimes_StrArray = GetTrimmedSplitString( lockoutTimes_String, " " )
	foreach( string ltStr in lockoutTimes_StrArray )
	{
		file.lockoutTimeMinimumsByRound_Explicit.append( float( ltStr ) )
	}
}

void function LockoutTime_DeathPenalties_Explicit_Init()
{
	string lockout_DeathAdds_String = Lockout_PLV_DeathAdds_ByRound()
	array< string > lockout_DeathAdds_StrArray = GetTrimmedSplitString( lockout_DeathAdds_String, " " )
	foreach( string ltStr in lockout_DeathAdds_StrArray )
	{
		file.lockoutTimeDeathPenaltiesByRound_Explicit.append( float( ltStr ) )
	}
}








