float function LockoutTime_GetPersonalLockoutStartTime( entity player )
{
	return player.GetPlayerNetTime( NETVAR_PERSONAL_LOCKOUT_START_TIME )
}

float function LockoutTime_GetPersonalLockoutEndTime( entity player )
{
	return player.GetPlayerNetTime( NETVAR_PERSONAL_LOCKOUT_END_TIME )
}


float function LockoutTime_GetBaseLockoutDurationForCurrentRound( bool roundClosed = false )
{
	int round = SURVIVAL_GetCurrentDeathFieldStage()
#if DEV
		printt( FUNC_NAME() + "(): roundClosed == " + roundClosed )
		printt( FUNC_NAME() + "(): Round Number ( Before Adjustment ) == " + round )
#endif

	round = maxint( 0, round )
	round = roundClosed ? round + 1 : round

	float lockoutTime

	if( Lockout_IntroTunings_ActiveCheck() )
	{
		lockoutTime = Lockout_PLV_IntroTunings_LockoutTime()
	}
	else if( Lockout_HyperTunings_ActiveCheck() )
	{
		lockoutTime = Lockout_PLV_HyperTunings_LockoutTime()
	}
	else
	{
		lockoutTime = LockoutTime_GetMinimumBaseLockoutForRound_Explicit( round )
	}

#if DEV
		printt( FUNC_NAME() + "(): Lockout Time for Stage " + round + " ==  " + lockoutTime )
#endif

	return lockoutTime
}

float function LockoutTime_GetMinimumBaseLockoutForRound_Explicit( int roundParm )
{
	
	int lockOutTimes_Len = file.lockoutTimeMinimumsByRound_Explicit.len()

	int round = roundParm < 0 ? 0 : roundParm
	round = minint( round, lockOutTimes_Len - 1 )
	float lockoutTime =  file.lockoutTimeMinimumsByRound_Explicit[ round ]
#if DEV
		printt( FUNC_NAME() + "(): Round == " + round )
		printt( FUNC_NAME() + "(): Lockout Time == " + lockoutTime )
#endif

	return lockoutTime
}

float function LockoutTime_GetDeathPenaltyForRound( bool roundClosed = false )
{
	int round = SURVIVAL_GetCurrentDeathFieldStage()

	round = maxint( 0, round )
	round = roundClosed ? round + 1 : round

	float lockoutDeathPenalty

	if( Lockout_IntroTunings_ActiveCheck() )
	{
		lockoutDeathPenalty = Lockout_PLV_IntroTunings_DeathAdd()
	}
	else if( Lockout_HyperTunings_ActiveCheck() )
	{
		lockoutDeathPenalty = Lockout_PLV_HyperTunings_DeathAdd()
	}
	else
	{
		lockoutDeathPenalty = LockoutTime_GetDeathPenaltyForRound_Explicit( round )
	}

#if DEV
		printt( FUNC_NAME() + "(): Lockout Death Penalty for Round " + round + " ==  " + lockoutDeathPenalty )
#endif

	return lockoutDeathPenalty
}

float function LockoutTime_GetDeathPenaltyForRound_Explicit( int roundParm )
{
	
	int lockoutDeathAdds_Len = file.lockoutTimeDeathPenaltiesByRound_Explicit.len()

	int round = maxint( 0, roundParm )
	round = minint( round, lockoutDeathAdds_Len - 1 )
	float lockoutDeathPenalty =  file.lockoutTimeDeathPenaltiesByRound_Explicit[ round ]
#if DEV
		printt( FUNC_NAME() + "(): Round == " + round )
		printt( FUNC_NAME() + "(): Death Penalty for Round == " + lockoutDeathPenalty )
#endif

	return lockoutDeathPenalty
}

float function LockoutTime_GetBaseDurationAdjustments( entity player )
{
	return player.GetPlayerNetTime( NETVAR_PERSONAL_LOCKOUT_BASE_TIME_ADJUSTMENTS )
}

















































































































































































































void function AddCallback_OnGiveAggroReward( void functionref( entity actionPlayer, int aggroType, int count ) callback )
{
	Assert( !file.onGiveAggroReward_Callbacks.contains( callback ), "Already added " + string( callback ) + " with AddCallback_OnGiveAggroReward" )
	file.onGiveAggroReward_Callbacks.append( callback )
}

void function RemoveCallback_OnGiveAggroReward( void functionref( entity actionPlayer, int aggroType, int count ) callback )
{
	int index = file.onGiveAggroReward_Callbacks.find( callback )

	Assert( index != -1, "Requested RemoveCallback_OnGiveAggroReward " + string( callback ) + " to be removed not found! " )
	file.onGiveAggroReward_Callbacks.fastremove( index )
}




void function LockoutTime_OnPersonalLockoutEndTimeChanged( entity player, float newEndTime )
{
	if ( newEndTime < 0 )
		return

	printt( FUNC_NAME() + "(): " + player + " endTime: " + newEndTime )

	DeathScreen_UpdateRespawnTime()
	thread LockoutTime_OnPersonalLockoutEndTimeChanged_Thread( player )
}

void function LockoutTime_OnPersonalLockoutEndTimeChanged_Thread( entity player )
{
	Assert ( IsNewThread(), "Must be threaded off." )

	if ( !IsValid( player ) )
		return

	if ( !IsLocalClientPlayer( player ) )
		return

	player.Signal( RESPAWN_COUNTDOWN_THREAD_START )
	player.EndSignal( RESPAWN_COUNTDOWN_THREAD_START, "OnDestroy" )
	EndSignal( clGlobal.levelEnt, "OnDestroy", "LocalClientPlayerRespawned"  )

	player.EndSignal( "freespawns_gameover" )

	while ( IsValidPlayer( player ) )
	{
		
		float timeRemainingUntilRespawn = LockoutTime_GetPersonalLockoutEndTime( player ) - Time()
		bool shouldCountdownSfxBeActive = timeRemainingUntilRespawn <= LOCKOUT_COUNTDOWN_DURATION

		if ( shouldCountdownSfxBeActive )
		{
			
			
			EmitSoundOnEntity( player, "Survival_Freespawn_TokenCountdown_1P"  )
			wait 1.0
		}
		else if ( timeRemainingUntilRespawn > 0.0 )
		{
			
			WaitFrame()
		}
		else
		{
			
			EmitSoundOnEntity( player, "Survival_Freespawn_TokenUse_1P" )
		}
	}
}







































#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________AGGRO_REWARDS___________________________(){}
#endif


bool function AggroRewards_AreEnabled()
{
	bool freespawnsEnabled = true 

		freespawnsEnabled = FreeRespawns_Feature_IsInEffect()


	bool aggroRewardsEnabled = AggroRewards_PLV_Enabled()
	return freespawnsEnabled && aggroRewardsEnabled
}

float function AggroRewards_GetRewardByType( int aggroRewardType )
{
	if ( !AggroRewards_AreEnabled() )
		return 0

	float result
	switch( aggroRewardType )
	{
		case eFreespawns_AggroType.DOWNED_ENEMY:
			result = AggroRewards_PLV_DownedEnemy()
			break
		case eFreespawns_AggroType.KILLED_ENEMY:
			result = AggroRewards_PLV_KilledEnemy()
			break
		case eFreespawns_AggroType.EXECUTED_ENEMY:
			result = AggroRewards_PLV_ExecutedEnemy()
			break
		case eFreespawns_AggroType.PENALTY_ALLYDEATH:
			result = LockoutTimeSynced_PLV_AllyDeathPenalty()
			break
		case eFreespawns_AggroType.EVO:
			result = AggroRewards_PLV_EvoToSeconds()
			break
		default:
			result = 0
			break
	}

	if ( Lockout_HyperTunings_ActiveCheck() )
	{
		float rewardMod = Lockout_PLV_HyperTunings_AggroRewardMod()
		result = result * rewardMod
	}

	return result
}













































































































void function LockoutTime_ServerToClient_OnAggroRewardReceived( entity actionPlayer, int aggroType, int count )
{

#if DEV
			printt( FUNC_NAME() + "(): actionPlayer 	== " + actionPlayer )
			printt( FUNC_NAME() + "(): GetLocalViewPlayer()	 == " + GetLocalViewPlayer() )
			printt( FUNC_NAME() + "(): GetLocalClientPlayer()== " + GetLocalClientPlayer() )
			printt( FUNC_NAME() + "(): aggroType 	== " + aggroType )
#endif

		foreach ( func in file.onGiveAggroReward_Callbacks )
		{
			func( actionPlayer, aggroType, count )
		}



}






