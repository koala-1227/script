void function MatchModifiers_View_SetWeaponInspect( bool inspect )
{
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
		return

	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
		return

	RuiSetBoolIfExists( file.persistentHudRui, "inspecting", inspect )
}




void function MatchModifiers_View_ActiveMenuChanged( string currentMenu )
{
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
		return

	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
		return

	if ( currentMenu != "" )
		return

	 if ( clGlobal.isMenuOpen )
		 return

	if ( !IsAlive( GetLocalClientPlayer() ) )
		return

	thread MatchModifiers_View_UpdatePersistentHudPosition_Thread()
}



void function MatchModifiers_View_ActiveFakeMenuChanged( string currentFakeMenuName )
{
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
		return

	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
		return

	if ( currentFakeMenuName != "" )
		return

	if ( clGlobal.isMenuOpen )
		return

	if ( !IsAlive( GetLocalClientPlayer() ) )
		return

	thread MatchModifiers_View_UpdatePersistentHudPosition_Thread()
}



void function MatchModifiers_View_InitPersistentHud()
{
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
		return

	if ( file.persistentHudRui != null && RuiIsAlive( file.persistentHudRui ) )
		return

	file.persistentHudRui = CreatePermanentCockpitPostFXRui( $"ui/juiced_modifier_tracker.rpak", HUD_Z_BASE )
	RuiSetBoolIfExists( file.persistentHudRui, "visible", false )
	RuiSetBoolIfExists( file.persistentHudRui, "showDescription", true )
	RuiSetFloatIfExists( file.persistentHudRui, "durationFrac", 1.0 )
	RuiSetFloatIfExists( file.persistentHudRui, "progressFrac", 0.0 )
	RuiSetBoolIfExists( file.persistentHudRui, "rerolling", false )
	RuiSetAssetIfExists( file.persistentHudRui, "previousModifier", $"" )
	RuiSetAssetIfExists( file.persistentHudRui, "nextModifier", $"" )

	MatchModifiers_View_UpdatePersistentHudPosition()
}



void function MatchModifiers_View_StartPersistentHudReroll( bool rerollToCurrentRound = false )
{
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
	{
		return
	}

	MatchModifiers_View_InitPersistentHud()

	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
	{
		return
	}

	asset currentIcon = $"rui/events/unhinged/s29/icon_juiced_event_small"
	if ( file.persistentHudModifierIndex != -1 )
	{
		MatchModifierData currentData = MatchModifiers_GetDataFromIndex( file.persistentHudModifierIndex )
		currentIcon = currentData.image
	}

	RuiSetBoolIfExists( file.persistentHudRui, "rerolling", true )
	RuiSetAssetIfExists( file.persistentHudRui, "previousModifier", currentIcon )
	RuiSetGameTimeIfExists( file.persistentHudRui, "rerollStartTime", Time() )

	asset nextModifierIcon = $"rui/events/unhinged/s29/icon_juiced_event_small"
	if ( rerollToCurrentRound )
	{
		nextModifierIcon = currentIcon
		currentIcon = $"rui/events/unhinged/s29/icon_juiced_event_small"
	}
	else if ( MatchModifiers_View_HasScheduledTopLevelModifierOnNextStage() )
	{
		nextModifierIcon = MatchModifiers_GetDataFromIndex( MatchModifiers_View_GetNextStageScheduledModifierIndex() ).image
	}

	RuiSetAssetIfExists( file.persistentHudRui, "nextModifier", nextModifierIcon )
}



vector function MatchModifiers_View_UpdatePersistentHudPosition()
{
	vector minimapBottomRightPixels = Minimap_GetScreenPosByPin( 1.0, 1.0 )
	if ( MatchModifiers_View_ShouldShowPersistentHud() && file.persistentHudRui != null && RuiIsAlive( file.persistentHudRui ) )
	{
		
		
		entity localViewPlayer = GetLocalViewPlayer()
		if ( IsValid( localViewPlayer ) && !localViewPlayer.IsPhaseShifted() && !IsBitFlagSet( localViewPlayer.GetCinematicEventFlags(), CE_FLAG_TITAN_3P_CAM ) )
		{
			RuiSetFloat2IfExists( file.persistentHudRui, "offsetPx", < minimapBottomRightPixels.x + 3.0, minimapBottomRightPixels.y, 0.0 > )
		}
	}
	return minimapBottomRightPixels
}



bool function MatchModifiers_View_ShouldShowPersistentHud()
{
	if ( !IsFullyConnected() )
		return false

	if ( !MatchModifiers_Enabled() )
		return false

	if ( GetCurrentPlaylistVarBool( "ks_matchmodifiers_hud", false ) )
		return false

	if ( GetGameState() != eGameState.Playing )
		return false

	return true
}



void function MatchModifiers_View_UpdatePersistentHud( MatchModifierData data )
{
	
	if ( !MatchModifiers_View_ShouldShowPersistentHud() )
	{
		return
	}

	MatchModifiers_View_InitPersistentHud()

	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
	{
		return
	}

	MatchModifiers_View_SetPersistentHudVisualOverride( file.persistentHudModifierIndex, false, 0.0, false, 0.0 )

	file.persistentHudModifierIndex = data.index

	RuiSetBoolIfExists( file.persistentHudRui, "visible", true )
	RuiSetBoolIfExists( file.persistentHudRui, "showDescription", true )
	RuiSetBoolIfExists( file.persistentHudRui, "greyscale", data.index == -1 )
	RuiSetStringIfExists( file.persistentHudRui, "name", Localize( data.name ) )
	RuiSetStringIfExists( file.persistentHudRui, "description", Localize( data.description ) )
	RuiSetAssetIfExists( file.persistentHudRui, "icon", data.image )
	RuiSetGameTime( file.persistentHudRui, "modifierEnabledTime", Time() )

	MatchModifiers_View_UpdatePersistentHudPosition()
}

void function MatchModifiers_View_PersistentHudSetEnding( bool isEndingSoon = false)
{
	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
	{
		return
	}
	RuiSetBoolIfExists( file.persistentHudRui, "ending", isEndingSoon )
}

void function MatchModifiers_View_PersistentHudSetRerolling( bool isRerolling = false)
{
	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
	{
		return
	}
	RuiSetBoolIfExists( file.persistentHudRui, "rerolling", isRerolling )
}



void function MatchModifiers_View_SetPersistentHudVisualOverride( int modifierIndex, bool useBar, float barFrac, bool fillUseScanlines, float fillFrac )
{
	if ( file.persistentHudRui == null || !RuiIsAlive( file.persistentHudRui ) )
		return

	if ( file.persistentHudModifierIndex != modifierIndex )
		return

	RuiSetBoolIfExists( file.persistentHudRui, "useBar", useBar )
	RuiSetFloatIfExists( file.persistentHudRui, "barFrac", Clamp( barFrac, 0.0, 1.0 ) )
	RuiSetBoolIfExists( file.persistentHudRui, "fillUseScanlines", fillUseScanlines )
	RuiSetFloatIfExists( file.persistentHudRui, "fillFrac", Clamp( fillFrac, 0.0, 1.0 ) )
}



void function MatchModifiers_View_OnDeathFieldStartShrink( DeathFieldStageData deathFieldStageData )
{
	MatchModifiers_View_PredictModifierExpiry( true )
}



bool function MatchModifiers_View_ActiveTopLevelModifierRemovesOnNextStage()
{
	return MatchModifiers_View_GetActiveTopLevelModifierRemovalRound() == MatchModifiers_View_GetNextStage()
}



bool function MatchModifiers_View_ShouldTriggerPersistentHudTransitionOnNextStage()
{
	if ( MatchModifiers_View_ActiveTopLevelModifierRemovesOnNextStage() )
	{
		return true
	}

	if ( !MatchModifiers_View_HasActiveTopLevelModifier() && MatchModifiers_View_HasScheduledTopLevelModifierOnNextStage() )
	{
		return true
	}

	if ( ( MatchModifiers_View_GetCurrentStageScheduledModifierIndex() != MatchModifiers_View_GetNextStageScheduledModifierIndex() ) )
	{
		return MatchModifiers_View_GetNextStageScheduledModifierIndex() != MATCHMOD_ACTIVE_STATE_NONE
	}

	return false
}



void function MatchModifiers_View_PredictModifierExpiry( bool ringShrinking = false )
{
	if ( !IsFullyConnected() )
		return

	if ( GetCurrentPlaylistVarBool( "ks_matchmodifiers_predictexpiry", false ) )
		return

	const float expiryConstant = 7.5
	float now = Time()
	float circleCloseTime = GetGlobalNetTime( "circleCloseTime" )
	float circleClosesIn = circleCloseTime - now
	float delayAnnounceExpiry = Clamp( circleClosesIn - expiryConstant, 0.0, FLT_MAX )
	float delayAnnounceReroll = Clamp( circleClosesIn, 0.0, FLT_MAX )

	string verySoonLine = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.MATCH_MODIFIERS_ENDING_VERY_SOON )

	if ( !MatchModifiers_View_ShouldTriggerPersistentHudTransitionOnNextStage() )
	{
		return
	}

	Signal( clGlobal.signalDummy, SIG_MM_PREDICTION_END )

	if ( delayAnnounceExpiry >= expiryConstant )
	{
		thread MatchModifiers_View_PredictModifierExpiry_Thread( delayAnnounceExpiry, verySoonLine, delayAnnounceReroll )
	}

	if ( delayAnnounceReroll >= 0.5 )
	{
		thread MatchModifiers_View_PredictModifierReroll_Thread( delayAnnounceReroll )
	}

	if ( ringShrinking && delayAnnounceExpiry >= expiryConstant )
	{
		string soonLine = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.MATCH_MODIFIERS_ENDING_SOON )
		int aliasID = GetAnyAliasIdForName( soonLine )
		if ( aliasID >= 0 )
		{
			SCB_PlayDialogueOnEnvironmentSpeakers( aliasID, NUM_NEARBY_SPEAKERS_TO_PLAY_FROM, 0, -1, null, -1 )
		}
	}
}



void function MatchModifiers_View_PredictModifierExpiry_Thread( float delayAnnounceExpiry, string line, float delayAnnounceReroll )
{
	AssertIsNewThread()

	entity player = GetLocalClientPlayer()

	if ( !IsValidPlayer(player) )
		return

	EndSignal( clGlobal.signalDummy, SIG_MM_PREDICTION_END )
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	OnThreadEnd(
		function() : ()
		{
			MatchModifiers_View_PersistentHudSetEnding( false )
		}
	)

	wait delayAnnounceExpiry

	player = GetLocalClientPlayer()
	if ( !IsValidPlayer(player) || IsPlayerInPlane( player ) )
		return

	int aliasID = GetAnyAliasIdForName( line )
	if ( aliasID >= 0 )
	{
		SCB_PlayDialogueOnEnvironmentSpeakers( aliasID, NUM_NEARBY_SPEAKERS_TO_PLAY_FROM, 0, -1, null, -1 )
	}

	MatchModifiers_View_PersistentHudSetEnding( true )

	wait Clamp( ( delayAnnounceReroll - delayAnnounceExpiry ), 0.0, FLT_MAX )
	wait 4.25 
}



void function MatchModifiers_View_PredictModifierReroll_Thread( float delayAnnounceReroll, bool noAnnouncement = false, bool noVO = false, bool rerollToCurrentRound = false )
{
	AssertIsNewThread()

	entity player = GetLocalClientPlayer()

	if ( !IsValidPlayer(player) )
		return

	EndSignal( clGlobal.signalDummy, SIG_MM_PREDICTION_END )
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	OnThreadEnd(
		function() : ()
		{
			Signal( clGlobal.signalDummy, SIG_MM_V_EFFECTS_END )
			MatchModifiers_View_PersistentHudSetRerolling( false )
			MatchModifiers_View_PersistentHudSetEnding( false )
		}
	)

	wait delayAnnounceReroll

	player = GetLocalClientPlayer()

	if ( !IsValidPlayer(player) || IsPlayerInPlane( player ) )
		return

	EmitSoundOnEntity( player, MATCH_MODIFIERS_WIDGET_DEACTIVATE_WARNING_SFX )

	MatchModifiers_View_StartPersistentHudReroll( rerollToCurrentRound )

	if ( !noAnnouncement )
	{
		MatchModifiers_View_AnnounceImpendingModifierChange( noVO, rerollToCurrentRound )
	}

	wait 4.25 
}



void function MatchModifiers_View_Round0Announcement_Thread()
{
	AssertIsNewThread()

	entity player = GetLocalClientPlayer()

	if ( !IsValidPlayer(player) )
		return

	EndSignal( clGlobal.signalDummy, SIG_MM_PREDICTION_END )
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	Signal( clGlobal.signalDummy, SIG_MM_V_EFFECTS_END )
	MatchModifiers_View_PersistentHudSetRerolling( false )
	MatchModifiers_View_PersistentHudSetEnding( false )

	bool noAnnouncement = CenterAnnouncements_IsActivelyDisplaying()

	if ( file.viewAnnounceFilter != null && !file.viewAnnounceFilter() )
		return

	thread MatchModifiers_View_PredictModifierReroll_Thread( 0.0, noAnnouncement, true, true )

	if ( noAnnouncement )
		return

	wait 4.0

	MatchModifierData data = MatchModifiers_View_GetGetActiveTopLevelModifierOrDummy()
	MatchModifiers_View_AnnounceModifier( data )
}


