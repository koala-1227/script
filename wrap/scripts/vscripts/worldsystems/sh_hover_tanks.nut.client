void function Survival_HoverTanks_Init()
{
	if( !HoverTanks_Enabled() )
		return

	
	FlagInit( "IntroHovertanksSet", false )

#if DEV
		printt( FUNC_NAME() + " run." )
		file.devOut = GetCurrentPlaylistVarBool( "hovertanks_devout", file.devOut )
		file.devDraw = GetCurrentPlaylistVarBool( "hovertanks_devdraw", file.devDraw )
		file.devDraw_Duration = GetCurrentPlaylistVarFloat( "hovertanks_devdraw_duration", file.devDraw_Duration )
#endif

	Tunings_Init()

	file.numHoverTanksIntro = tunings.hovertanks_Count_Intro 




	float chance = tunings.hovertanks_chance_intro * 100
	if ( RandomInt(100) > chance )
	{
		file.numHoverTanksIntro = 0
	}




	file.numHoverTanksMid = tunings.hovertanks_Count_Mid 




	chance = tunings.hovertanks_chance_mid * 100
	if ( RandomInt(100) > chance )
	{
		file.numHoverTanksMid = 0
	}


























		if ( file.numHoverTanksIntro > 0 || file.numHoverTanksMid > 0 )
			SetMapFeatureItem( 500, "#HOVER_TANK", "#HOVER_TANK_DESC", $"rui/hud/gametype_icons/survival/sur_hovertank_minimap" )

		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.HOVERTANK, MINIMAP_OBJECT_RUI, MinimapPackage_HoverTank, FULLMAP_OBJECT_RUI, MinimapPackage_HoverTank )
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.HOVERTANK_DESTINATION, MINIMAP_OBJECT_RUI, MinimapPackage_HoverTankDestination, FULLMAP_OBJECT_RUI, MinimapPackage_HoverTankDestination )


























}

void function Tunings_Init()
{







































	
	tunings.hovertanks_chance_intro = GetCurrentPlaylistVarFloat( "hovertanks_chance_intro", tunings.hovertanks_chance_intro )
	tunings.hovertanks_chance_mid 	= GetCurrentPlaylistVarFloat( "hovertanks_chance_mid", 	 tunings.hovertanks_chance_mid )

	tunings.hovertanks_Count_Intro	= GetCurrentPlaylistVarInt( "hovertanks_count_intro", tunings.hovertanks_Count_Intro )
	tunings.hovertanks_Count_Mid	= GetCurrentPlaylistVarInt( "hovertanks_count_mid", tunings.hovertanks_Count_Mid )

	tunings.count_EndNodes_Intro 	= GetCurrentPlaylistVarInt( "hovertanks_count_endnodes_intro", 	 tunings.count_EndNodes_Intro )
	tunings.count_EndNodes_Mid 		= GetCurrentPlaylistVarInt( "hovertanks_count_endnodes_mid", 	 tunings.count_EndNodes_Mid )

	tunings.hovertanks_FlyInStyle = PlaylistVarInt_Resolve_VsLegacy( "hovertanks_FlyinStyle", "canyonlands_hovertank_flyin", tunings.hovertanks_FlyInStyle )

	
	tunings.exclude_LastRingEndNodes = GetCurrentPlaylistVarBool( "hovertanks_exclude_LastRingEndNodes", tunings.exclude_LastRingEndNodes )
	tunings.useDynamicLocations = PlaylistVarBool_Resolve_VsLegacy( "hovertanks_useDynamicLocations", "canyonlands_dynamic_hovertank_locations", tunings.useDynamicLocations )

	
	tunings.shipIcons_Enabled 		= GetCurrentPlaylistVarBool( "hovertanks_shipIcons_Enabled", tunings.shipIcons_Enabled )
	tunings.shipIcons_AlwaysVisible = GetCurrentPlaylistVarBool( "hovertanks_shipIcons_AlwaysVisible", tunings.shipIcons_AlwaysVisible )

	tunings.endPointIcons_Enabled = GetCurrentPlaylistVarBool( "hovertanks_endPointIcons_Enabled", tunings.endPointIcons_Enabled )
	tunings.endPointIcons_Persist = GetCurrentPlaylistVarBool( "hovertanks_endPointIcons_Persist", tunings.endPointIcons_Persist )

	
	tunings.midCircle_Index = PlaylistVarInt_Resolve_VsLegacy( "hovertanks_midCircle_Index", "canyonlands_hovertanks_circle_index", tunings.midCircle_Index )

	
	tunings.hide_UnusedPOIGeo = GetCurrentPlaylistVarBool( "hovertanks_hide_UnusedPoiGeo", tunings.hide_UnusedPOIGeo )

	
	tunings.calcSpeed_Max = GetCurrentPlaylistVarFloat( "hovertanks_calcspeed_max", tunings.calcSpeed_Max )

	
	tunings.emergencyZiplines_Enabled	= GetCurrentPlaylistVarBool( "hovertanks_emergencyziplines_enabled", tunings.emergencyZiplines_Enabled )
	tunings.alwaysUse_EmergencyZipline_Starts = GetCurrentPlaylistVarBool( "hovertanks_alwaysuse_emergencyzipline_starts", tunings.alwaysUse_EmergencyZipline_Starts )
	tunings.emergencyZiplines_MaxLength	= GetCurrentPlaylistVarFloat( "hovertanks_emergencyziplines_maxlength", tunings.emergencyZiplines_MaxLength )

	
	tunings.customLootSpawn_Enabled 		= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_enabled", tunings.customLootSpawn_Enabled )
	tunings.customLootSpawn_WeaponSets_Str 	= GetCurrentPlaylistVarString( "hovertanks_customlootspawn_weaponsets", tunings.customLootSpawn_WeaponSets_Str )
	tunings.customLootSpawn_WeaponSets 		= GetTrimmedSplitString( tunings.customLootSpawn_WeaponSets_Str, " " )
	tunings.customLootSpawn_AmmoStacks_ToSpawn = GetCurrentPlaylistVarInt( "hovertanks_customlootspawn_ammostacks_tospawn", tunings.customLootSpawn_AmmoStacks_ToSpawn )

	tunings.customLootSpawn_Regenerating_Enabled	= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_regenerating_enabled", tunings.customLootSpawn_Regenerating_Enabled )
	tunings.customLootSpawn_Regenerating_Delay		= GetCurrentPlaylistVarFloat( "hovertanks_customlootspawn_regenerating_delay", tunings.customLootSpawn_Regenerating_Delay )

	tunings.customLootSpawn_Arsenal_Enabled			= GetCurrentPlaylistVarBool( "hovertanks_customlootspawn_arsenal_enabled", tunings.customLootSpawn_Arsenal_Enabled )
	tunings.customLootSpawn_Arsenal_WeaponSets_Str 	= GetCurrentPlaylistVarString( "hovertanks_customlootspawn_weaponsets", tunings.customLootSpawn_Arsenal_WeaponSets_Str )
	tunings.customLootSpawn_Arsenal_WeaponSets 		= GetTrimmedSplitString( tunings.customLootSpawn_Arsenal_WeaponSets_Str, " " )

	







}

bool function PlaylistVarBool_Resolve_VsLegacy( string newString, string legacyStr, bool defaultValue )
{
	const int INT_UNDEF = -1
	int use_Legacy 	= GetCurrentPlaylistVarInt( legacyStr, INT_UNDEF )
	int use_New 	= GetCurrentPlaylistVarInt( newString, INT_UNDEF )
	if( use_New > INT_UNDEF )
	{
		return( use_New == 1 ? true : false )
	}
	else if( use_Legacy > INT_UNDEF )
	{
		return(  use_Legacy == 1 ? true : false )
	}

	return( defaultValue )
}

int function PlaylistVarInt_Resolve_VsLegacy( string newString, string legacyStr, int defaultValue )
{
	const int INT_INVALID = -999999
	int use_Legacy 	= GetCurrentPlaylistVarInt( legacyStr, 	INT_INVALID )
	int use_New 	= GetCurrentPlaylistVarInt( newString, 	INT_INVALID )
	if( use_New > INT_INVALID )
	{
		return( use_New )
	}
	else if( use_Legacy > INT_INVALID )
	{
		return(  use_Legacy )
	}

	return defaultValue
}

























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































