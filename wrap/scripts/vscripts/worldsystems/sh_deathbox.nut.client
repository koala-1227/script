void function _____________Use___________________________(){}
#endif

bool function DeathBox_CanUseFunction( entity player, entity ent, int useFlags )
{

		if ( IsValid( ent ) && Deathbox_ShouldFocus( ent ) )
			thread Deathbox_CreateRui( ent )


	if ( IsPVEMode() && (GetRespawnStyle() == eRespawnStyle.NONE) )
	{
		if ( IsValid( ent.GetOwner() ) && (player != ent.GetOwner()) )
			return false
	}

	if ( GetGameState() > eGameState.Playing )
		return false

	if ( !PlayerHandsAvailable( player ) )
		return false

	if ( !PlayerInValidState( player, false, false ) )
		return false

	if ( IsPlayerBusyOrAnimating( player ) && !( CanInterruptBannerPickupEarly( player ) || CanUseFastBannerPickup( player, ent ) ) )
		return false







		if ( player.IsPilotModeActive() )
			return false



		
		
		if( IsBitFlagSet( useFlags, RESPAWN_FROMDEATHBOX_INPUT ) && ( !Respawn_FromDeathbox_PlayerInUseRange( player, ent ) || HasTeammatesRespawningFromBeacon( player.GetTeam() ) ) )
			return false


	if ( ent.GetTeam() != TEAM_UNASSIGNED )
	{
		if ( ent.GetTeam() == player.GetTeam() )
			return true
	}

	return ent.GetLinkEntArray().len() > 0
}

bool function DeathBox_ShouldUseBlockReload( entity player, entity ent )
{
	
	if ( IsPlayingFirstPersonAnimation( player ) )
	{
		return true
	}
	return false
}

void function ExtendedTryOpenGroundList( entity ent, entity player, ExtendedUseSettings settings )
{
	OpenSurvivalGroundList( player, ent )
}



ExtendedUseSettings function Deathbox_GetExtendedUseSettings( entity ent, entity playerUser )
{
	ExtendedUseSettings settings
	settings.loopSound = "UI_Survival_PickupTicker"
	settings.successSound = "UI_Survival_DeathBoxOpen"
	settings.hint = "#PROMPT_OPEN"
	settings.successFunc = ExtendedTryOpenGroundList








	return settings
}


void function OnDeathBoxUse( entity box, entity player, int useInputFlags )
{


















		if( Respawn_FromDeathbox_Enabled()  )
		{
			if( IsBitFlagSet( useInputFlags, RESPAWN_FROMDEATHBOX_INPUT )  )
			{
				Respawn_FromDeathbox_OnUse ( player, box )
				return
			}
		}


	if ( IsBitFlagSet( useInputFlags, USE_INPUT_LONG ) )
	{
		
		if ( ShouldPickupDNAFromDeathBox( box, player ) && !HasInterruptableBannerPickup() )
			return

		if ( box.GetLinkEntArray().len() == 0 )
			return










			ExtendedUseSettings settings = Deathbox_GetExtendedUseSettings( box, player )


		settings.duration = 0.3
		settings.requireMatchingUseEnt = true

		thread ExtendedUse( box, player, settings )
	}
}


bool function Deathbox_ShouldFocus( entity deathbox )
{
	if ( deathbox == file.focusedDeathbox )
	{
		file.focusedDeathBoxHandled = true
	}

	return !file.focusedDeathBoxHandled
}



string function DeathBoxTextOverride( entity ent )
{
	if ( ent.e.isBusy )
		return " "








	entity localViewPlayer = GetLocalViewPlayer()
	if ( ShouldPickupDNAFromDeathBox( ent, localViewPlayer ) )
	{
		string localizedHint = ""
		if ( ent.GetCustomOwnerName() != "" )
			localizedHint = Localize( "#HINT_PICKUP_DNA_USE", ent.GetCustomOwnerName() )
		else
			localizedHint = Localize( "#HINT_PICKUP_DNA_USE", ent.GetOwner().GetPlayerName() )
























			if( Respawn_FromDeathbox_Enabled() )
			{
				localizedHint = localizedHint + "\n" + Respawn_FromDeathbox_Get_UsePrompts( localViewPlayer, ent )
			}


		return localizedHint
	}

	if ( ent.GetLinkEntArray().len() == 0 )
	{















		return " "
	}

	EHI ornull ehi = Deathbox_GetOwnerEHI( ent )
	if ( ehi == null )
		return ""
	expect EHI( ehi )
	if ( !EHIHasValidScriptStruct( ehi ) )
		return ""

	int team          = EHI_GetTeam( ehi )
	string playerName = GetDisplayablePlayerNameFromEHI( ehi )

	if ( ent.GetCustomOwnerName() != "" ) 
		playerName = ent.GetCustomOwnerName()

	string hint = "#DEATHBOX_HINT_NAME"

	bool isEnemyTeam = IsEnemyTeam( team, localViewPlayer.GetTeam() )
	if ( isEnemyTeam )
		hint = "#DEATHBOX_HINT_ENEMY"

	bool remoteInteracting = IsPlayerOutsideStandardDeathBoxUseDistanceButRemoteInteractAllowed( localViewPlayer, ent )
	if ( remoteInteracting )
	{
		hint = "#VOID_REACH_HINT_NAME"
		if ( isEnemyTeam )
			hint = "#VOID_REACH_HINT_ENEMY"
	}


	string localizedHint = Localize( hint, playerName )

















	if ( remoteInteracting && localViewPlayer.GetUseEntity() == ent )
	{
		CustomUsePrompt_Show( ent )
		CustomUsePrompt_SetSourcePos( ent.GetOrigin() + < 0, 0, 25 > )
		CustomUsePrompt_SetText( localizedHint )
		CustomUsePrompt_SetHintImage( $"" )
		int lootRarity = ent.GetNetInt( "maxLootTier" )
		CustomUsePrompt_SetLineColor( GetSurvialPropColorFromRarity( lootRarity ) )
		if ( PlayerIsInADS( localViewPlayer ) )
			CustomUsePrompt_ShowSourcePos( false )
		else
			CustomUsePrompt_ShowSourcePos( true )

		localizedHint = " "
	}
	else
	{
		CustomUsePrompt_Hide()
	}









		if( Respawn_FromDeathbox_Enabled() )
		{
			string deathboxRespawnPrompt = Respawn_FromDeathbox_Get_UsePrompts( localViewPlayer, ent )
			if( deathboxRespawnPrompt != "" )
			{
				localizedHint = localizedHint + "\n" + deathboxRespawnPrompt
			}
		}


	return localizedHint
}


