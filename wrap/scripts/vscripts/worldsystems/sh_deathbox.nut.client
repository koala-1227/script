bool function DeathBoxBannerAvailable( entity player, entity deathbox )
{
	if ( !IsValid( deathbox ) )
		return false


		if( deathbox.GetNetBool( DEATH_BOX_BANNER_EXPIRED_NETVAR ) && !Perk_CanPickUpExpiredBanners( player, deathbox ) )
			return false


	if ( deathbox.GetTeam() != TEAM_UNASSIGNED )
	{
		if ( deathbox.GetTeam() == player.GetTeam() && IsValid( deathbox.GetOwner() ) )
			return true
	}

	return false
}


bool function ShouldPickupDNAFromDeathBox( entity ent, entity player )
{

		if( ent.GetNetBool( DEATH_BOX_BANNER_EXPIRED_NETVAR ) && !Perk_CanPickUpExpiredBanners( player, ent ) )
			return false


	

	if( (!RemoteDeathboxInteractAllowGrabbingBanners() && !IsPlayerWithinStandardDeathBoxUseDistance( player, ent )) &&
			!PlayerHasPassive( player, ePassives.PAS_CRYPTO ))
		return false

	if ( ent.GetTeam() != TEAM_UNASSIGNED )
	{
		entity owner = ent.GetOwner()

		if( !IsValid( owner ) )
			return false

		int respawnStatus = owner.GetPlayerNetInt( "respawnStatus" )
		if ( ent.GetTeam() == player.GetTeam() && IsValid( owner ) && ( respawnStatus == eRespawnStatus.WAITING_FOR_PICKUP )  )
			return true
	}

	return false
}

bool function CanUseFastBannerPickup( entity player, entity ent )
{
	if ( !IsPlayingBannerPickupAnim( player ) )
		return false

	string classname = expect string( ent.GetNetworkedClassName() )
	if ( classname == "prop_death_box" )
		return HasInterruptableBannerPickup() || ShouldPickupDNAFromDeathBox( ent, player )
	else if ( classname == "prop_survival" )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )


			return data.ref == CRAFTED_BANNER_REF || data.ref == BLACK_MARKET_BANNER_REF



	}

	return false
}

bool function CanInterruptBannerPickupEarly( entity player )
{
	return HasInterruptableBannerPickup() && IsPlayingBannerPickupAnim( player )
}

bool function IsPlayingBannerPickupAnim( entity player )
{
	entity firstPersonProxy = player.GetPredictedFirstPersonProxy()
	if ( !IsValid( firstPersonProxy ) || firstPersonProxy.GetModelName() == $"" || firstPersonProxy.GetModelName() == $"?" )
		return false

	if ( !IsPlayingFirstPersonAnimation( player ) )
		return false

	string firstPersonAnim = firstPersonProxy.GetCurrentSequenceName()
	bool isPlayingPickupAnimation = ( firstPersonAnim.find( PICKING_UP_RESPAWN_BANNER_ANIM ) > -1 ) || ( firstPersonAnim.find( PICKING_UP_RESPAWN_BANNER_AND_MRB_ANIM ) > -1 )
	return isPlayingPickupAnimation
}


