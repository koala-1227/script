bool function IsDeathbox( entity ent )
{
	if ( !IsValid( ent ) )
		return false

	return ent.GetNetworkedClassName() == "prop_death_box"
}

array<entity> function GetAllDeathboxes()
{
	return file.allDeathBoxes
}

array<entity> function GetAllDeathBoxesOfTeam( int team )
{
	array<entity> teamDeathBoxes
	foreach ( entity deathbox in file.allDeathBoxes )
	{
		Assert( IsValid( deathbox ), "Invalid deathox in allDeathboxes list!" )

		entity boxOwner = deathbox.GetOwner()

		if( !IsValid( boxOwner ) )
			continue

		int boxTeam = boxOwner.GetTeam()
		if( boxTeam != team )
			continue

		teamDeathBoxes.append( deathbox )
	}

	return teamDeathBoxes
}




EHI ornull function Deathbox_GetOwnerEHI( entity box )
{
	EHI eHandle = box.GetNetInt( "ownerEHI" )

	if ( eHandle == -1 )
		return null

	return eHandle
}









entity function Deathbox_Latest_Get( entity player )
{
	entity result = player.GetPlayerNetEnt( "latestDeathbox" )
	return result
}



















array< entity > function Deathbox_GetLootByType( entity box, int desiredLootType )
{
	array< entity > items = Deathbox_GetLootEnts( box )
	array< entity > matchingItems

	foreach ( entity item in items )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( item.GetSurvivalInt() )
		if ( data.lootType == desiredLootType )
		{
			matchingItems.append( item )
		}
	}

	return matchingItems
}


entity function Deathbox_GetLootByType_Single( entity box, int desiredLootType )
{
	entity result

	array< entity > items = Deathbox_GetLootEnts( box )
	foreach( entity item in items )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( item.GetSurvivalInt() )
		if ( data.lootType == desiredLootType )
		{
			result = item
			break
		}
	}

	return result
}


entity function Deathbox_GetUsefulShields( entity player, entity box )
{
	entity result

	if( !IsValid( box ) )
		return result

	entity item = Deathbox_GetLootByType_Single( box, eLootType.ARMOR )

	if( !IsValid( item ) )
		return result

	int currentShields  = SURVIVAL_GetPlayerShieldHealthFromArmor( player )
	int lootShields     = GetPropSurvivalMainPropertyFromEnt( item )

	if( lootShields > currentShields )
	{
		result = item
	}

	return result
}


entity function Deathbox_GetDeathboxPlayerIsLookingAt( entity player, float degrees = 8.0, float maxDistSqr = 1000000.0 )
{
	array<entity> deathboxArray = GetAllDeathboxes()

	entity theEnt
	float largestDot = -1.0

	float minDot = deg_cos( degrees )
	float dot

	array<PlayerLookAtItem> finalLootEnts

	vector playerEyePos = player.EyePosition()

	foreach ( ent in deathboxArray )
	{
		if ( ent.GetScriptName() != DEATH_BOX_SCRIPTNAME )
			continue

		dot = DotProduct( Normalize( ent.GetWorldSpaceCenter() - playerEyePos ), player.GetViewVector() )
		if ( dot < minDot )
			continue

		float distanceSqr = DistanceSqr( ent.GetOrigin(), player.GetOrigin() )
		if ( distanceSqr > maxDistSqr )
			continue

		PlayerLookAtItem lootItem
		lootItem.ent = ent
		lootItem.playerViewDot = dot
		finalLootEnts.append( lootItem )

#if DEV
			
			
#endif
	}

	finalLootEnts.sort( PlayerLookSort )

	foreach ( item in finalLootEnts )
	{
		TraceResults result = TraceLineHighDetail( playerEyePos, item.ent.GetWorldSpaceCenter(), [player, item.ent], TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_PLAYER )
		if ( result.fraction == 1.0 )
		{
			theEnt = item.ent
			break
		}
	}

	return theEnt
}


bool function IsValidAndUsableDeathBoxEnt( entity deathBox )
{
	if ( !IsValid( deathBox ) )
		return false

	string ornull netClassName = deathBox.GetNetworkedClassName()
	if ( netClassName == "prop_death_box" || netClassName == "prop_loot_grabber" )
		return true

	return false
}

bool function IsPlayerCloseEnoughToDeathBoxToLoot( entity player, entity deathBox )
{
	if ( !IsValidAndUsableDeathBoxEnt( deathBox ) )
		return false

	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	if ( deathBox.GetNetworkedClassName() == "prop_death_box" && PlayerHasPassive( player, ePassives.PAS_ALTER ) && CanPlayerRemoteInteractWithDeathbox( player, deathBox ) )
	{
		if ( IsBitFlagSet(deathBox.GetUsableValue(), USABLE_FROM_EXTENDED_RANGE) )
		{
			maxSquareDist = GetRemoteDeathboxInteractSqrRangeForAlter( player )
		}
	}

	return distanceToDeathbox <= maxSquareDist
}

bool function IsPlayerWithinStandardDeathBoxUseDistance( entity player, entity deathBox )
{
	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	const float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	return distanceToDeathbox <= maxSquareDist
}

bool function IsPlayerOutsideStandardDeathBoxUseDistanceButRemoteInteractAllowed( entity player, entity deathBox )
{
	if ( !IsValidAndUsableDeathBoxEnt( deathBox ) )
		return false

	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	if ( distanceToDeathbox <= maxSquareDist )
		return false

	if ( deathBox.GetNetworkedClassName() == "prop_death_box" && PlayerHasPassive( player, ePassives.PAS_ALTER ) && CanPlayerRemoteInteractWithDeathbox( player, deathBox ) )
	{
		if ( IsBitFlagSet(deathBox.GetUsableValue(), USABLE_FROM_EXTENDED_RANGE) )
		{
			maxSquareDist = GetRemoteDeathboxInteractSqrRangeForAlter( player )
			return distanceToDeathbox <= maxSquareDist
		}
	}

	return false
}


array<entity> function Deathbox_GetLootEnts( entity deathBox, entity realmEntity = null )
{
	if ( deathBox.GetNetworkedClassName() == "prop_death_box" )
	{
		return deathBox.GetLinkEntArray()
	}
	else if ( deathBox.GetNetworkedClassName() == "prop_loot_grabber" )
	{







		vector deathBoxOrigin = deathBox.GetOrigin()
		float radius          = deathBox.GetLootGrabDist()
		entity realmEnt		  = realmEntity == null ? deathBox : realmEntity

		array<entity> lootEnts = GetSurvivalLootNearbyPos( deathBoxOrigin, radius, false, false, false, realmEnt )

		array<entity> nearbyDeathBoxes = GetEntitiesFromArrayNearPos( GetAllDeathboxes(), deathBoxOrigin, radius )

		foreach ( entity nearbyDeathBox in nearbyDeathBoxes )
			lootEnts.extend( Deathbox_GetLootEnts( nearbyDeathBox ) )
		return lootEnts
	}

	Assert( false, "Unhandled death box class: " + string(deathBox.GetNetworkedClassName()) )
	return []
}


struct PlaneVisibility
{
	float value
	vector connectPoint
}

vector function Deathbox_FindBestEdgeForVFX_WorldSpace( entity deathbox, entity player )
{
	vector endPoint = Deathbox_FindBestEdgeForVFX_LocalSpace( deathbox, player )
	endPoint = RotateVector( endPoint, deathbox.GetAngles() )
	endPoint += deathbox.GetOrigin()

	return endPoint
}

vector function Deathbox_FindBestEdgeForVFX_LocalSpace( entity deathbox, entity player )
{
	vector mins = deathbox.GetBoundingMins()
	vector maxs = deathbox.GetBoundingMaxs()
	vector boxToPlayer = player.EyePosition() - deathbox.GetOrigin()
	vector fwd = deathbox.GetForwardVector()
	vector rgt = deathbox.GetRightVector()
	vector up  = deathbox.GetUpVector()

	
	array<PlaneVisibility> planeArray

	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( fwd, boxToPlayer - maxs.x * fwd )
		testPlane.connectPoint = <maxs.x, 0, maxs.z * 0.5>
		planeArray.append( testPlane )
	}

	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( -fwd, boxToPlayer - mins.x * fwd )
		testPlane.connectPoint = <mins.x, 0, maxs.z * 0.5>
		planeArray.append( testPlane )
	}
	
	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( rgt, boxToPlayer - maxs.y * rgt )
		testPlane.connectPoint = <0, mins.y, maxs.z * 0.5>
		planeArray.append( testPlane )
	}

	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( -rgt, boxToPlayer - mins.y * rgt )
		testPlane.connectPoint = <0, maxs.y, maxs.z * 0.5>
		planeArray.append( testPlane )
	}

	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( up, boxToPlayer - maxs.z * up )
		testPlane.connectPoint = <0, 0, maxs.z>
		planeArray.append( testPlane )
	}

	{
		PlaneVisibility testPlane
		testPlane.value = DotProduct( -up, boxToPlayer )
		testPlane.connectPoint = <0, 0, mins.z>
		planeArray.append( testPlane )
	}

	planeArray.sort( int function( PlaneVisibility a, PlaneVisibility b ) : ()
	{
		if ( a.value > b.value )
			return -1
		else if( a.value < b.value )
			return 1

		return 0
	} )

	return planeArray[0].connectPoint
}


