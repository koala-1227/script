const string SOUND_BEAM_SWEETEN_TIER2 = "LootCeremony_MassPack_Tick_Deploy_BeamSweet_Epic"
const string SOUND_BEAM_SWEETEN_TIER3 = "LootCeremony_MassPack_Tick_Deploy_BeamSweet_Legendary"
