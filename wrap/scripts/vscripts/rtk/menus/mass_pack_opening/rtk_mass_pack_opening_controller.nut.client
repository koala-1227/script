const string SOUND_FIREWORK_SWEETEN_TIER2 = "LootCeremony_MassPack_Tick_FireworksSweet_Epic"
const string SOUND_FIREWORK_SWEETEN_TIER3 = "LootCeremony_MassPack_Tick_FireworksSweet_Legendary"
const string SOUND_FIREWORK_SWEETEN_TIER4 = "LootCeremony_MassPack_Tick_FireworksSweet_Heirloom"

