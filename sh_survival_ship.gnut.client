#if AUTO_PLAYER_DEV
void function Autoplayer_JumpmasterPutInPlane_Thread( EHI statusChangePlayerEHI )
{
	entity statusChangePlayer = FromEHI( statusChangePlayerEHI )
	for ( int i = 0; i < 50; i++ )
	{
		if ( DeathField_IsActive( statusChangePlayer.DeathFieldIndex() ) )
			break

		wait 0.1
		statusChangePlayer = FromEHI( statusChangePlayerEHI )
	}

	if ( IsValid( statusChangePlayer ) )
		AutoPlayer_JumpmasterPutInPlane( statusChangePlayer )
}
#endif


bool function AutoPlayer_GetDropShipDoorOpenFlag()
{
	if ( FlagExists( "PlaneDoorOpen" ) )
	{
		return Flag( "PlaneDoorOpen" )
	}

	return false
}

