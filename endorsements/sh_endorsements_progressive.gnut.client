{
	if ( !Endorsements_IsEndorsementProgressiveByID( endorsementID ) )
		return ""

	EndorsementProgressiveSetting endorsementSetting = file.endorsementIDToEndorsementProgressiveSetting[ endorsementID ]
	return endorsementSetting.progressiveLevelsDesc
}

