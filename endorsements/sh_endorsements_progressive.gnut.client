global function EndorsementProgressive_GetEndorsementProgressForClientPlayer
global function EndorsementProgressive_GetLevelForProgress
global function EndorsementProgressive_GetNextLevelMilestone
global function EndorsementProgressive_GetLevelGoalByIndex
global function Endorsements_GetTooltipDesc
global function Endorsements_GetProgressionType
global function Endorsements_GetStandardPower
