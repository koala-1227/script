var function Endorsements_Unitframes_TryGetUnitframeForPlayer( entity player )
{
	
	entity viewPlayer = GetLocalViewPlayer()
	if ( !IsValidPlayer( player ) || !IsValidPlayer( viewPlayer ) )
		return null

	int viewPlayerTeam = viewPlayer.GetTeam()
	bool isViewPlayer = player == viewPlayer
	bool isFriendlyPlayer = IsFriendlyTeam( player.GetTeam(), viewPlayerTeam )
	bool isLivingOrNotSpectating = IsAlive( player ) || !IsSpectating()

	if ( !isViewPlayer && !isFriendlyPlayer )
		return null

	var unitframeRui
	
	if ( isViewPlayer && isLivingOrNotSpectating )
	{
		unitframeRui = GetPilotRui()
	}
	else if ( PlayerHasUnitFrame( player ) )
	{
		unitframeRui = GetUnitFrame( player ).rui
	}

	if ( unitframeRui == null || !RuiIsAlive( unitframeRui ) )
		return null

	
	return unitframeRui
}

void function Endorsements_UpdateUnitframeRuiForPlayer( entity player )
{
	var unitframeRui = Endorsements_Unitframes_TryGetUnitframeForPlayer( player )
	if ( unitframeRui == null )
		return

	RuiSetBoolIfExists( unitframeRui, "endorsementsVisible", true )
	Endorsements_UpdateEndorsementSlotsForRui( unitframeRui, player )
}


void function Endorsements_UpdateEndorsementSlotsForRui( var rui, entity player )
{
	if ( rui == null || !IsValid( player ) )
		return

	array<int> activeEndorsements = Endorsements_GetPlayerEndorsementArray( player )
	int maxSlotsToShow = Endorsements_GetMaxEndorsementCount()
	int unclaimedTicketCount = maxSlotsToShow
	if ( Endorsements_GetDeliveryType() == eEndorsementDeliveryType.GROUNDED_CRAFTERS )
	{
		unclaimedTicketCount = Endorsements_Delivery_GetPlayerTicketCount( player )
	}


		bool isClockUpModeEnabled = ClockUp_Endorsements_IsEnabled()
		RuiSetBoolIfExists( rui, "hasClockUpEndorsement", isClockUpModeEnabled )
		RuiSetBoolIfExists( rui, "endorsementsFixedWidth", isClockUpModeEnabled ) 

		if ( isClockUpModeEnabled )
		{
			maxSlotsToShow = 1
		}


	
	for ( int idx = 0; idx < maxSlotsToShow; idx++ )
	{
		if ( activeEndorsements.len() > idx )
		{
			EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromID( activeEndorsements[idx] )
			RuiSetAssetIfExists( rui, "endorsementSlotIcon" + idx, endorsementDefinition.endorsementIcon )
			RuiSetBoolIfExists( rui, "endorsementSlotLocked" + idx, false )
			RuiSetBoolIfExists( rui, "endorsementSlotEmpty" + idx, false )












			bool isEndorsementProgressive = Endorsements_IsEndorsementProgressiveByType( endorsementDefinition.endorsementType ) && EndorsementProgressive_IsEnabled()
			RuiSetBoolIfExists( rui, "isProgressive" + idx, isEndorsementProgressive )
			if ( isEndorsementProgressive )
			{
				string netVarStr = "EndorsementProgressive_EndorsementProgress_" + idx
				int progress = player.GetPlayerNetInt( netVarStr )
				int level = EndorsementProgressive_GetLevelForProgress( endorsementDefinition.endorsementID, progress )
				int nextLevel = level + 1
				int indexLevel = nextLevel > ENDORSEMENT_PROGRESSIVE_LEVEL_MAX ? ENDORSEMENT_PROGRESSIVE_LEVEL_MAX : nextLevel
				int totalProgress = int( EndorsementProgressive_GetNextLevelMilestone( endorsementDefinition.endorsementID ) )
				float progressFrac = totalProgress > 0.0 ? float( progress ) / float( totalProgress ) : 0.0
				RuiSetFloatIfExists( rui, "endorsement" + idx + "NormProgress", progressFrac )
			}

		}
		else if ( activeEndorsements.len() + unclaimedTicketCount > idx )
		{
			RuiSetAssetIfExists( rui, "endorsementSlotIcon" + idx, $"" )
			RuiSetBoolIfExists( rui, "endorsementSlotLocked" + idx, false )
			RuiSetBoolIfExists( rui, "endorsementSlotEmpty" + idx, true )
			RuiSetFloatIfExists( rui, "endorsementProgressOverride" + idx, -1.0 )
		}
		else
		{
			RuiSetAssetIfExists( rui, "endorsementSlotIcon" + idx, $"" )
			RuiSetBoolIfExists( rui, "endorsementSlotLocked" + idx, true )
			RuiSetBoolIfExists( rui, "endorsementSlotEmpty" + idx, true )
			RuiSetFloatIfExists( rui, "endorsementProgressOverride" + idx, -1.0 )
		}
	}

	
	for ( int idx = maxSlotsToShow; idx < Endorsements_GetMaxEndorsementCount(); idx++ )
	{
		RuiSetAssetIfExists( rui, "endorsementSlotIcon" + idx, $"" )
		RuiSetBoolIfExists( rui, "endorsementSlotLocked" + idx, true )
		RuiSetBoolIfExists( rui, "endorsementSlotEmpty" + idx, true )
		RuiSetFloatIfExists( rui, "endorsementProgressOverride" + idx, -1.0 )
	}
}


void function Endorsements_AnimateUnitframeRuiForPlayer( entity player, int endorsementID, EndorsementDefinition endorsementDefinition )
{
	var unitframeRui = Endorsements_Unitframes_TryGetUnitframeForPlayer( player )
	if ( unitframeRui == null )
	{
		return
	}

	array<int> activeEndorsements = Endorsements_GetPlayerEndorsementArray( player )

	int endorsementIndex = activeEndorsements.find( endorsementID )
	if ( endorsementIndex < 0 || endorsementIndex >= Endorsements_GetMaxEndorsementCount() )
	{
		return
	}

	RuiSetGameTimeIfExists( unitframeRui, "endorsementSlotAnimStartTime" + endorsementIndex, ClientTime() )
	RuiSetGameTimeIfExists( unitframeRui, "endorsementSlotAnimEndTime" + endorsementIndex, ClientTime() + endorsementDefinition.duration )
	RuiSetFloatIfExists( unitframeRui, "endorsementSlotAnimOutroDuration" + endorsementIndex, ( endorsementDefinition.cooldown > 0.0 || endorsementDefinition.duration > 0.0 ) ? 0.0 : 3.50 )
	RuiSetGameTimeIfExists( unitframeRui, "endorsementSlotCDStartTime" + endorsementIndex, ClientTime() )
	RuiSetGameTimeIfExists( unitframeRui, "endorsementSlotCDEndTime" + endorsementIndex, ClientTime() + endorsementDefinition.cooldown )
	RuiSetGameTimeIfExists( unitframeRui, "endorsementProgressOverride" + endorsementIndex, -1.0 )
}

void function Endorsements_OverrideUnitframeRuiProgressForPlayer( entity player, int endorsementID, float overrideProgress = 0.0 )
{
	var unitframeRui = Endorsements_Unitframes_TryGetUnitframeForPlayer( player )
	if ( unitframeRui == null )
	{
		return
	}

	array<int> activeEndorsements = Endorsements_GetPlayerEndorsementArray( player )

	int endorsementIndex = activeEndorsements.find( endorsementID )

	if ( endorsementIndex < 0 || endorsementIndex >= Endorsements_GetMaxEndorsementCount() )
	{
		return
	}

	RuiSetFloatIfExists( unitframeRui, "endorsementProgressOverride" + endorsementIndex, overrideProgress )
}


void function Endorsements_PlayVFXForEndorsementGranted()
{
	entity player = GetLocalClientPlayer()
	int fxHandle = StartParticleEffectOnEntityWithPos( player, GetParticleSystemIndex( ENDORSEMENT_CRAFT_VFX_1P ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, player.EyePosition(), <0, 0, 0> )
	EffectSetIsWithCockpit( fxHandle, true )
	EffectSetControlPointVector( fxHandle, 5, UNHINGED_COLOR )
}


