global const string SIG_ENDORSEMENTS_NETVAR_UPDATE 													= "Endorsements_NetvarUpdated"

void function Endorsements_Init()
{
	if ( !Endorsements_IsActive() )
		return

	Assert( Endorsements_GetMaxEndorsementCount() <= 3, "Need to update endorsement netvars to support endorsement counts greater than 3" )


	Endorsements_LoadEndorsementDefinitions( ENDORSEMENTS_ASSET_ENDORSEMENT_DEFINITIONS )
	Endorsements_LoadEndorsementGroupDefinitions( ENDORSEMENTS_ASSET_ENDORSEMENT_GROUP_DEFINITIONS )
	Endorsements_LoadEndorsementSponsorDefinitions( ENDORSEMENTS_ASSET_ENDORSEMENT_SPONSOR_DEFINITIONS )

	Endorsements_RegisterCommonEndorsements()

	if ( Endorsements_GetDeliveryType() == eEndorsementDeliveryType.GROUNDED_CRAFTERS )
	{
		Endorsements_InitializeEndorsementTracks()
		Endorsements_Delivery_GroundedInit()
		Endorsements_Crafting_Init()
		AddCallback_ItemFlavorLoadoutSlotDidChange_AnyPlayer( Loadout_Character(), void function( EHI playerEHI, ItemFlavor character ) { Endorsements_SetupPerPlayerEndorsementDistribution( FromEHI( playerEHI ) ) } )


		Endorsements_Delivery_RoundBased_Init()

	}
















		EndorsementProgressive_Init()









	Remote_RegisterClientFunction( string( ServerToClient_Endorsements_DisplayEndorsementUsedPopup ), "entity", "int", ENDORSEMENT_INVALID, Endorsements_GetMaxEndorsementID(), "int", 0, INT_MAX, "float", -FLT_MAX, FLT_MAX, 32, "float", -FLT_MAX, FLT_MAX, 32 )

	RegisterNetworkedVariable( NETVAR_ENDORSEMENT_0, SNDC_PLAYER_GLOBAL, SNVT_INT, ENDORSEMENT_INVALID )
	RegisterNetworkedVariable( NETVAR_ENDORSEMENT_1, SNDC_PLAYER_GLOBAL, SNVT_INT, ENDORSEMENT_INVALID )
	RegisterNetworkedVariable( NETVAR_ENDORSEMENT_2, SNDC_PLAYER_GLOBAL, SNVT_INT, ENDORSEMENT_INVALID )


		RegisterNetVarIntChangeCallback( NETVAR_ENDORSEMENT_0, Endorsements_NetVarChanged_ActiveEndorsements )
		RegisterNetVarIntChangeCallback( NETVAR_ENDORSEMENT_1, Endorsements_NetVarChanged_ActiveEndorsements )
		RegisterNetVarIntChangeCallback( NETVAR_ENDORSEMENT_2, Endorsements_NetVarChanged_ActiveEndorsements )
		AddCallback_OnClientScriptInit( Endorsements_InitClientHUD )

		RegisterSignal( SIG_ENDORSEMENTS_NETVAR_UPDATE )

		PrecacheParticleSystem( ENDORSEMENT_CRAFT_VFX_1P )



}

bool function Endorsements_IsActive()
{
	return GetCurrentPlaylistVarBool( PVAR_ENDORSEMENTS_ACTIVE, DEFAULTS_ENDORSEMENTS_ACTIVE )
}

int function Endorsements_GetDeliveryType()
{
	return Endorsements_IsActive() ? eEndorsementDeliveryType[ GetCurrentPlaylistVarString( "endorsements_delivery_type", "grounded_crafters" ).toupper() ] : eEndorsementDeliveryType.__DISABLED
}

bool function Endorsements_IsTracksFixedOrderEnabled()
{
	return GetCurrentPlaylistVarBool( PVAR_ENDORSEMENTS_TRACKS_FIXED_ORDER_ENABLED, DEFAULTS_ENDORSEMENTS_TRACKS_FIXED_ORDER_ENABLED )
}

bool function Endorsements_FadePOINameEndorsementStationIconAtDifferentHeight()
{
	return GetCurrentPlaylistVarBool( PVAR_ENDORSEMENTS_FADE_POI_ICON_AT_DIFFERENT_HEIGHTS, DEFAULTS_ENDORSEMENTS_FADE_POI_ICON_AT_DIFFERENT_HEIGHTS )
}

float function Endorsements_AdditionalHeightForPOINameEndorsementStationIconFade()
{
	return GetCurrentPlaylistVarFloat( PVAR_ENDORSEMENTS_FADE_POI_ICON_ADDITIONAL_HEIGHT, DEFAULTS_ENDORSEMENTS_FADE_POI_ICON_ADDITIONAL_HEIGHT )
}

bool function Endorsements_AreEndorsementStationsEnabled()
{
	return GetCurrentPlaylistVarBool( PVAR_ENDORSEMENTS_STATIONS_ENABLED, DEFAULTS_ENDORSEMENTS_STATIONS_ENABLED ) && Endorsements_GetDeliveryType() == eEndorsementDeliveryType.GROUNDED_CRAFTERS
}

bool function Endorsements_DoesGrantEndorsementGiveEVO()
{
	return GetCurrentPlaylistVarBool( PVAR_ENDORSEMENTS_GRANTED_GIVE_EVO, DEFAULTS_ENDORSEMENTS_GRANTED_GIVE_EVO )
}

int function Endorsements_GetMaxEndorsementCount()
{

		if ( GetCurrentPlaylistVarBool( "clockup_endorsements_is_enabled", false ) )
			return CLOCKUP_ENDORSEMENTS_ENDORSEMENT_COUNT


	return GetCurrentPlaylistVarInt( PVAR_ENDORSEMENTS_MAX_ENDORSEMENT_COUNT, DEFAULTS_ENDORSEMENTS_MAX_ENDORSEMENT_COUNT )
}

asset function Endorsements_GetEndorsementStationIcon()
{
	return ENDORSEMENT_STATION_ICON
}

asset function Endorsements_GetEndorsementStationBackgroundIcon()
{
	return ENDORSEMENT_STATION_BG_ICON
}



int function Endorsements_GetMaxEndorsementsPerRound()
{
	return Endorsements_GetNormalEndorsementsPerRound()
}

int function Endorsements_GetNormalEndorsementsPerRound()
{
	return MAX_ENDORSEMENTS_PER_ROUND_BASE
}



bool function Endorsements_IsEndorsementProgressiveByType( int endorsementType )
{
	bool result = false
	switch( endorsementType )
	{
		case eEndorsementType.PROGRESSIVE_WEAPON_MOD:
		case eEndorsementType.PROGRESSIVE_PLAYER_MOD:
		case eEndorsementType.PROGRESSIVE_SCRIPTED:
		case eEndorsementType.PROGRESSIVE_STATUS_EFFECT:
			result = true
			break
		default:
			result = false
			break
	}

	return result
}




bool function Endorsements_IsEndorsementProgressiveByID( int endorsementID )
{
	EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromID( endorsementID )
	return Endorsements_IsEndorsementProgressiveByType( endorsementDefinition.endorsementType )
}








































































string function Endorsements_GetTracks()
{
	return strip( GetCurrentPlaylistVarString( PVAR_ENDORSEMENTS_TRACKS, "" ) )
}

void function Endorsements_LoadEndorsementDefinitions( asset dataTableAsset )
{
	var dataTable = GetDataTable( dataTableAsset )
	int rowCount = GetDataTableRowCount( dataTable )
	int col_featureFlag = GetDataTableColumnByName( dataTable, "featureFlag" )
	int col_isDisabled = GetDataTableColumnByName( dataTable, "isDisabled" )
	int col_endorsementRef = GetDataTableColumnByName( dataTable, "endorsementRef" )
	int col_endorsementType = GetDataTableColumnByName( dataTable, "endorsementType" )
	int col_endorsementGrantIdentifier = GetDataTableColumnByName( dataTable, "endorsementGrantIdentifier" )
	int col_endorsementDisplayName = GetDataTableColumnByName( dataTable, "endorsementDisplayName" )
	int col_endorsementDisplayDescription = GetDataTableColumnByName( dataTable, "endorsementDisplayDescription" )
	int col_endorsementIcon = GetDataTableColumnByName( dataTable, "endorsementIcon" )
	int col_notifSound_1p = GetDataTableColumnByName( dataTable, "notifSound_1p" )
	int col_excludedCharacters = GetDataTableColumnByName( dataTable, "excludedCharacters" )
	int col_excludedCharacterRoles = GetDataTableColumnByName( dataTable, "excludedCharacterRoles" )
	int col_hasEndorsementStationLockout = GetDataTableColumnByName( dataTable, "hasEndorsementStationLockout" )
	int col_boxIcon = GetDataTableColumnByName( dataTable, "boxIcon" )

	for ( int rowIdx = 0; rowIdx < rowCount; rowIdx++ )
	{
		EndorsementDefinition endorsementDefinition
		endorsementDefinition.endorsementID = rowIdx

		endorsementDefinition.endorsementRef = strip( GetDataTableString( dataTable, rowIdx, col_endorsementRef ) ).toupper()
		Assert( endorsementDefinition.endorsementRef != "", format( "%s - Malformed Endorsement Data Line[%d] - Endorsement Definition Requires an Endorsement Reference String", FUNC_NAME(), rowIdx ) )
		Assert( !(endorsementDefinition.endorsementRef in file.endorsementRefToDefinition), format( "%s - Data Error Line[%d] - Endorsement[%s] is defined more than once", FUNC_NAME(), rowIdx, endorsementDefinition.endorsementRef ) )

		bool isDisabled = GetDataTableBool( dataTable, rowIdx, col_isDisabled )
		bool isDisabledByPlaylist = !GetCurrentPlaylistVarBool( "endorsement_" + endorsementDefinition.endorsementRef + "_enable", DEFAULTS_ENDORSEMENTS_ENABLED_BY_PLAYLIST )
		if ( isDisabled || isDisabledByPlaylist )
			continue

		string endorsementTypeName = strip( GetDataTableString( dataTable, rowIdx, col_endorsementType) ).toupper()
		endorsementDefinition.endorsementType = eEndorsementType[ endorsementTypeName ]
		string endorsementGrantIdentifier = strip( GetDataTableString( dataTable, rowIdx, col_endorsementGrantIdentifier) ).toupper()
		switch( endorsementDefinition.endorsementType )
		{
			case eEndorsementType.PASSIVE:
			{
				
				Assert( endorsementGrantIdentifier in ePassives, format( "%s - Malformed Endorsement Data Line[%d] - Endorsement Definition of Type %s grants an INVALID[%s] Passive", FUNC_NAME(), rowIdx, endorsementTypeName, endorsementGrantIdentifier ) )
				endorsementDefinition.passiveID = ePassives[ endorsementGrantIdentifier ]
				break
			}
			case eEndorsementType.GADGET:
			{
				endorsementDefinition.gadgetRef = endorsementGrantIdentifier
				break
			}
			case eEndorsementType.DUMMY:
			{
				break
			}

				case eEndorsementType.PROGRESSIVE_WEAPON_MOD:
				{
					endorsementDefinition.modRef = endorsementGrantIdentifier
					break
				}
				case eEndorsementType.PROGRESSIVE_PLAYER_MOD:
				{
					endorsementDefinition.modRef = endorsementGrantIdentifier
					string playerModPassive = ( DEFAULTS_ENDORSEMENT_PASSIVE_BASE + endorsementDefinition.endorsementRef ).toupper()
					endorsementDefinition.passiveID = ePassives[ playerModPassive ] 
					break
				}
				case eEndorsementType.PROGRESSIVE_SCRIPTED:
				{
					
					Assert( endorsementGrantIdentifier in ePassives, format( "%s - Malformed Endorsement Data Line[%d] - Endorsement Definition of Type %s grants an INVALID[%s] Passive", FUNC_NAME(), rowIdx, endorsementTypeName, endorsementGrantIdentifier ) )
					endorsementDefinition.passiveID = ePassives[ endorsementGrantIdentifier ]
					break
				}
				case eEndorsementType.PROGRESSIVE_STATUS_EFFECT:
				{
					endorsementDefinition.modRef = ( endorsementGrantIdentifier ).tolower() 
					string statusEffectPassive = ( DEFAULTS_ENDORSEMENT_PASSIVE_BASE + endorsementDefinition.endorsementRef ).toupper()
					endorsementDefinition.passiveID = ePassives[ statusEffectPassive ] 
					break
				}

			default:
			{
				Assert( false, format( "%s - Malformed Endorsement Data Line[%d] - Endorsement Definition of Type %s is not supported", FUNC_NAME(), rowIdx, endorsementTypeName ) )
				break
			}
		}

		string endorsementDisplayNameOverride = strip( GetCurrentPlaylistVarString( "endorsement_" + endorsementDefinition.endorsementRef + "_display_name", DEFAULTS_ENDORSEMENTS_DISPLAY_NAME_OVERRIDE ) )
		endorsementDefinition.displayName = (endorsementDisplayNameOverride.len() == 0) ? strip( GetDataTableString( dataTable, rowIdx, col_endorsementDisplayName ) ) : endorsementDisplayNameOverride

		string endorsementDisplayDescriptionOverride = strip( GetCurrentPlaylistVarString( "endorsement_" + endorsementDefinition.endorsementRef + "_display_description", DEFAULTS_ENDORSEMENTS_DISPLAY_DESCRIPTION_OVERRIDE ) )
		endorsementDefinition.displayDescription = (endorsementDisplayDescriptionOverride.len() == 0) ? strip( GetDataTableString( dataTable, rowIdx, col_endorsementDisplayDescription ) ) : endorsementDisplayDescriptionOverride

		asset endorsementIconOverride = GetCurrentPlaylistVarAsset( "endorsement_" + endorsementDefinition.endorsementRef + "_icon", DEFAULTS_ENDORSEMENTS_ICON_OVERRIDE )
		endorsementDefinition.endorsementIcon = (endorsementIconOverride == $"") ? GetDataTableAsset( dataTable, rowIdx, col_endorsementIcon ) : endorsementIconOverride

		string endorsementNotifSoundOverride = strip( GetCurrentPlaylistVarString( "endorsement_" + endorsementDefinition.endorsementRef + "_notif_sound_1P", DEFAULTS_ENDORSEMENT_NOTIF_SOUND_1P_OVERRIDE ) )
		endorsementDefinition.notifSound_1p = (endorsementNotifSoundOverride.len() == 0) ? strip( GetDataTableString( dataTable, rowIdx, col_notifSound_1p ) ) : endorsementNotifSoundOverride

		string excludedCharactersOverride = strip( GetCurrentPlaylistVarString( "endorsement_" + endorsementDefinition.endorsementRef + "_excluded_characters", DEFAULTS_ENDORSEMENTS_EXCLUDED_CHARACTERS_OVERRIDE ) )
		string excludedCharacters = (excludedCharactersOverride == DEFAULTS_ENDORSEMENTS_EXCLUDED_CHARACTERS_OVERRIDE) ? strip( GetDataTableString( dataTable, rowIdx, col_excludedCharacters ) ) : excludedCharactersOverride
		array< string > excludedCharactersTokens = GetTrimmedSplitString( excludedCharacters, "," )
		foreach ( string excludedCharacterToken in excludedCharactersTokens )
		{
			string characterRefString = format( "character_%s", excludedCharacterToken.tolower() )
			Assert( IsValidItemFlavorCharacterRef( characterRefString ), format( "%s - Data Error Line[%d] - Endorsement[%s] excludes an invalid character[%s]", FUNC_NAME(), rowIdx, endorsementDefinition.endorsementRef, excludedCharacterToken ) )

			endorsementDefinition.excludedCharacterRefs.append( characterRefString )
		}

		string excludedCharacterRolesOverride = strip( GetCurrentPlaylistVarString( "endorsement_" + endorsementDefinition.endorsementRef + "excluded_character_roles", DEFAULTS_ENDORSEMENTS_EXCLUDED_CHARACTER_ROLES_OVERRIDE ) )
		string excludedCharacterRoles = (excludedCharacterRolesOverride == DEFAULTS_ENDORSEMENTS_EXCLUDED_CHARACTER_ROLES_OVERRIDE) ? strip( GetDataTableString( dataTable, rowIdx, col_excludedCharacterRoles ) ) : excludedCharacterRolesOverride
		array< string > excludedCharacterRolesTokens = GetTrimmedSplitString( excludedCharacterRoles, "," )
		foreach ( string excludedCharacterRolesToken in excludedCharacterRolesTokens )
		{
			Assert( excludedCharacterRolesToken in eCharacterClassRole, format( "%s - Data Error Line[%d] - Endorsement[%s] excludes an invalid CharacterRole[%s]", FUNC_NAME(), rowIdx, endorsementDefinition.endorsementRef, excludedCharacterRolesToken ) )
			endorsementDefinition.excludedCharacterRoles.append( eCharacterClassRole[excludedCharacterRolesToken] )
		}

		endorsementDefinition.hasEndorsementStationLockout = GetCurrentPlaylistVarBool( "endorsement_" + endorsementDefinition.endorsementRef + "has_endorsement_station_lockout", GetDataTableBool( dataTable, rowIdx, col_hasEndorsementStationLockout ) )

		file.endorsementRefToDefinition[endorsementDefinition.endorsementRef] <- endorsementDefinition
		file.endorsementIDToDefinition[endorsementDefinition.endorsementID] <- endorsementDefinition

		if ( endorsementDefinition.passiveID != ePassives.INVALID )
		{
			file.passiveIDToEndorsementDef[ endorsementDefinition.passiveID ] <- endorsementDefinition
		}

		asset boxIconOverride = GetCurrentPlaylistVarAsset( "endorsement_" + endorsementDefinition.boxIcon + "_icon", DEFAULTS_ENDORSEMENTS_ICON_OVERRIDE )
		endorsementDefinition.boxIcon = (boxIconOverride == $"") ? GetDataTableAsset( dataTable, rowIdx, col_boxIcon ) : boxIconOverride
	}

	file.maxEndorsementID = rowCount




}





































void function Endorsements_LoadEndorsementGroupDefinitions( asset dataTableAsset )
{
	var dataTable = GetDataTable( dataTableAsset )
	int rowCount = GetDataTableRowCount( dataTable )
	int col_featureFlag = GetDataTableColumnByName( dataTable, "featureFlag" )
	int col_isDisabled = GetDataTableColumnByName( dataTable, "isDisabled" )
	int col_endorsementGroupRef = GetDataTableColumnByName( dataTable, "endorsementGroupRef" )
	int col_reference = GetDataTableColumnByName( dataTable, "reference" )
	int col_selectionWeight = GetDataTableColumnByName( dataTable, "selectionWeight" )

	string currentEndorsementGroupRef = ""
	for ( int rowIdx = 0; rowIdx < rowCount; rowIdx++ )
	{
		bool isDisabled = GetDataTableBool( dataTable, rowIdx, col_isDisabled )
		string endorsementGroupRef = strip( GetDataTableString( dataTable, rowIdx, col_endorsementGroupRef ) ).toupper()
		string reference = strip( GetDataTableString( dataTable, rowIdx, col_reference ) ).toupper()

		if ( endorsementGroupRef.len() > 0 )
		{
			
			bool isGroupDisabledByPlaylist = !GetCurrentPlaylistVarBool( "endorsement_group_" + endorsementGroupRef + "_enable", DEFAULTS_ENDORSEMENTS_GROUP_ENABLED_BY_PLAYLIST )
			if ( isDisabled || isGroupDisabledByPlaylist )
				continue

			currentEndorsementGroupRef = endorsementGroupRef

			Assert( !(endorsementGroupRef in file.endorsementGroupRefToDefinition), format( "%s - DATA ERROR Line[%d] - Endorsement Group[%s] Defined More Than Once", FUNC_NAME(), rowIdx, endorsementGroupRef ) )
			EndorsementGroupDefinition endorsementGroupDefinition
			endorsementGroupDefinition.endorsementGroupRef = endorsementGroupRef
			file.endorsementGroupRefToDefinition[endorsementGroupDefinition.endorsementGroupRef] <- endorsementGroupDefinition

			continue
		}
		else if ( reference.len() == 0 )
		{
			
			currentEndorsementGroupRef = ""
			continue
		}
		else if ( currentEndorsementGroupRef.len() == 0 )
		{
			
			
			continue
		}

		Assert( reference != "", format( "%s - DATA ERROR Line[%d] - Endorsement Group Entry For Group[%s] Has Invalid Reference", FUNC_NAME(), rowIdx, currentEndorsementGroupRef ) )
		EndorsementGroupEntry newEndorsementGroupEntry
		if ( reference in file.endorsementRefToDefinition )
		{
			
			newEndorsementGroupEntry.endorsementRef = reference
		}
		else
		{
			
			newEndorsementGroupEntry.endorsementGroupRef = reference
		}

		bool isEntryInGroupDisabledByPlaylist = !GetCurrentPlaylistVarBool( "endorsement_group_" + currentEndorsementGroupRef + "_entry_" + reference + "_enable", DEFAULTS_ENDORSEMENTS_GROUP_ENTRY_ENABLED_BY_PLAYLIST )
		if ( isDisabled || isEntryInGroupDisabledByPlaylist )
			continue

		newEndorsementGroupEntry.weight = GetDataTableInt( dataTable, rowIdx, col_selectionWeight )
		Assert( newEndorsementGroupEntry.weight >= 0, format( "%s - DATA ERROR Line[%d] - Endorsement[%s] For Group[%s] Has Invalid Weight[%d]", FUNC_NAME(), rowIdx, newEndorsementGroupEntry.endorsementRef, currentEndorsementGroupRef, newEndorsementGroupEntry.weight ) )

		file.endorsementGroupRefToDefinition[currentEndorsementGroupRef].endorsementGroupEntries.append( newEndorsementGroupEntry )
	}

	
	foreach ( EndorsementGroupDefinition endorsementGroupDefinition in file.endorsementGroupRefToDefinition )
	{
		
		array< string > groupRefStack = [ endorsementGroupDefinition.endorsementGroupRef ]
		array< int > groupRefEntriesIndex = [ 0 ]

		
		
		while ( groupRefStack.len() > 0 )
		{
			string groupReference = groupRefStack.top()
			Assert( groupReference in file.endorsementGroupRefToDefinition, format( "%s - ERROR - THIS SHOULD NOT BE POSSIBLE - Group[%s] is not defined", FUNC_NAME(), groupReference ) )

			EndorsementGroupDefinition referencedEndorsementGroupDefinition = file.endorsementGroupRefToDefinition[groupReference]
			int endorsementGroupEntriesCount = referencedEndorsementGroupDefinition.endorsementGroupEntries.len()
			for ( int entryIndex = groupRefEntriesIndex.top(); entryIndex < endorsementGroupEntriesCount; entryIndex++ )
			{
				EndorsementGroupEntry endorsementGroupEntry = referencedEndorsementGroupDefinition.endorsementGroupEntries[entryIndex]

				
				if ( endorsementGroupEntry.endorsementRef.len() > 0 )
					continue

				if ( !(endorsementGroupEntry.endorsementGroupRef in file.endorsementGroupRefToDefinition) )
				{
					
					endorsementGroupEntry.weight = 0
					continue
				}

				Assert( !groupRefStack.contains( endorsementGroupEntry.endorsementGroupRef ), format( "%s - ERROR - CIRCULAR REFERENCE DETECTED FOR GROUP[%s]", FUNC_NAME(), endorsementGroupEntry.endorsementGroupRef ) )
				groupReference = endorsementGroupEntry.endorsementGroupRef
				groupRefEntriesIndex.pop()
				groupRefEntriesIndex.push( entryIndex + 1 )
				break
			}

			if ( groupReference != groupRefStack.top() )
			{
				
				groupRefStack.push( groupReference )
				groupRefEntriesIndex.push( 0 )
			}
			else
			{
				
				groupRefStack.pop()
				groupRefEntriesIndex.pop()
			}
		}
	}
}

void function Endorsements_LoadEndorsementSponsorDefinitions( asset dataTableAsset )
{
	var dataTable = GetDataTable( dataTableAsset )
	int rowCount = GetDataTableRowCount( dataTable )
	int col_endorsementSponsorRef = GetDataTableColumnByName( dataTable, "endorsementSponsorRef" )
	int col_displayName = GetDataTableColumnByName( dataTable, "displayName" )
	int col_displayDescription = GetDataTableColumnByName( dataTable, "displayDescription" )
	int col_color = GetDataTableColumnByName( dataTable, "color" )
	int col_icon = GetDataTableColumnByName( dataTable, "icon" )
	int col_hoverSound1p = GetDataTableColumnByName( dataTable, "hoverSound_1p" )
	int col_selectSound1p = GetDataTableColumnByName( dataTable, "selectSound_1p" )
	int col_selectLastSound1p = GetDataTableColumnByName( dataTable, "selectLastSound_1p" )

	int col_background = GetDataTableColumnByName( dataTable, "background" )
	int col_leadingChoice = GetDataTableColumnByName( dataTable, "leadingChoice" )


	for ( int rowIdx = 0; rowIdx < rowCount; rowIdx++ )
	{
		string endorsementSponsorRef = strip( GetDataTableString( dataTable, rowIdx, col_endorsementSponsorRef ) ).toupper()
		EndorsementSponsorDefinition endorsementSponsorDefinition
		int endorsementSponsor = Endorsements_GetSponsorEnumFromRef( endorsementSponsorRef )
		endorsementSponsorDefinition.endorsementSponsorEnum = endorsementSponsor

		string sponsorDisplayNameOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "_display_name", DEFAULTS_ENDORSEMENT_SPONSOR_DISPLAY_NAME_OVERRIDE ) )
		endorsementSponsorDefinition.displayName = (sponsorDisplayNameOverride.len() == 0) ? strip( GetDataTableString( dataTable, rowIdx, col_displayName ) ) : sponsorDisplayNameOverride

		string sponsorDisplayDescriptionOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "_display_description", DEFAULTS_ENDORSEMENT_SPONSOR_DISPLAY_DESCRIPTION_OVERRIDE ) )
		endorsementSponsorDefinition.displayDescription = (sponsorDisplayDescriptionOverride.len() == 0) ? strip( GetDataTableString( dataTable, rowIdx, col_displayDescription ) ) : sponsorDisplayDescriptionOverride

		string sponsorColorOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "color", DEFAULTS_ENDORSEMENT_SPONSOR_COLOR_OVERRIDE ) )
		if ( sponsorColorOverride.len() > 0 )
		{
			endorsementSponsorDefinition.color = StringToVector( sponsorColorOverride )
		}
		else
		{
			endorsementSponsorDefinition.color = GetDataTableVector( dataTable, rowIdx, col_color )
		}

		asset sponsorIconOverride = GetCurrentPlaylistVarAsset( "endorsement_sponsor" + endorsementSponsorRef + "_icon", DEFAULTS_ENDORSEMENT_SPONSOR_ICON_OVERRIDE )
		endorsementSponsorDefinition.icon = (sponsorIconOverride == $"") ? GetDataTableAsset( dataTable, rowIdx, col_icon ) : sponsorIconOverride

		
		string hoverSound1pOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "_hoverSound1p", DEFAULTS_ENDORSEMENT_SPONSOR_HOVER_SOUND_1P_OVERRIDE ) )
		endorsementSponsorDefinition.hoverSound_1p = ( hoverSound1pOverride.len() == 0 ) ? strip( GetDataTableString( dataTable, rowIdx, col_hoverSound1p ) ) : hoverSound1pOverride

		string selectSound1pOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "_selectSound1p", DEFAULTS_ENDORSEMENT_SPONSOR_SELECT_SOUND_1P_OVERRIDE ) )
		endorsementSponsorDefinition.selectSound_1p = ( selectSound1pOverride.len() == 0 ) ? strip( GetDataTableString( dataTable, rowIdx, col_selectSound1p ) ) : selectSound1pOverride

		string selectLastSound1pOverride = strip( GetCurrentPlaylistVarString( "endorsement_sponsor" + endorsementSponsorRef + "_selectLastSound1p", DEFAULTS_ENDORSEMENT_SPONSOR_SELECT_LAST_SOUND_1P_OVERRIDE ) )
		endorsementSponsorDefinition.selectLastSound_1p = ( selectLastSound1pOverride.len() == 0 ) ? strip( GetDataTableString( dataTable, rowIdx, col_selectLastSound1p ) ) : selectLastSound1pOverride


		asset backgroundOverride = GetCurrentPlaylistVarAsset( "endorsement_sponsor" + endorsementSponsorRef + "_background", $"" )
		endorsementSponsorDefinition.background = ( backgroundOverride == $"" ) ? GetDataTableAsset( dataTable, rowIdx, col_background ) : backgroundOverride

		bool leadingChoiceOverride = GetCurrentPlaylistVarBool( "endorsement_sponsor" + endorsementSponsorRef + "_leadingChoice", true )
		endorsementSponsorDefinition.leadingChoice = ( leadingChoiceOverride ) ? GetDataTableBool( dataTable, rowIdx, col_leadingChoice ) : leadingChoiceOverride


		file.endorsementSponsorToDefinition[endorsementSponsor] <- endorsementSponsorDefinition
	}
}

int function Endorsements_GetSponsorEnumFromRef( string ref )
{
	int sponsorType = eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID
	bool typeFound = false
	for( int i = 0; i < eEndorsementSponsor._COUNT; i++ )
	{
		string enumType = GetEnumString( "eEndorsementSponsor", i ).tolower()
		if ( enumType.tolower() == ref.tolower() )
		{
			sponsorType = i
			typeFound = true
			break
		}
	}

	Assert( typeFound, "Endorsement sponsor type '" + ref + "' is not a specified enumerator." )

	return sponsorType
}

void function Endorsements_InitializeEndorsementTracks()
{
	string endorsementTracksString = Endorsements_GetTracks()
	bool isTracksFixedOrderEnabled = Endorsements_IsTracksFixedOrderEnabled()

	if ( endorsementTracksString.len() == 0 )
	{
		Assert( !isTracksFixedOrderEnabled, format( "%s - ERROR - TracksFixedOrderEnabled is true but there are no tracks defined", FUNC_NAME() ) )
		return
	}

	foreach ( string endorsementTrackEntryString in GetTrimmedSplitString( endorsementTracksString, "|" ) )
	{
		
		array< string > endorsementTrackTokens = GetTrimmedSplitString( endorsementTrackEntryString, ":" )
		Assert( endorsementTrackTokens.len() >= 2, format( "%s - DATA ERROR - PlaylistVar[%s] Is Incorrectly Formatted, Every Track Entry Requires a Weight - Format = group_a,group_b,group_c:track1_weight:optional_sponsor|group_x,group_y,group_z:track2_weight:optional_sponsor", FUNC_NAME(), PVAR_ENDORSEMENTS_TRACKS ) )

		EndorsementTrackDefinition newEndorsementTrack
		
		
		
		
		if ( endorsementTrackTokens.len() > 2 )
		{
			string endorsementSponsorRef = endorsementTrackTokens[2]
			int endorsementSponsor = Endorsements_GetSponsorEnumFromRef( endorsementSponsorRef )
			if ( endorsementSponsor in file.endorsementSponsorToDefinition )
			{
				newEndorsementTrack.endorsementSponsorEnum = endorsementSponsor
			}
		}

		newEndorsementTrack.weight = int(endorsementTrackTokens[1])

		
		
		foreach ( int index, string endorsementGroupRef in GetTrimmedSplitString( endorsementTrackTokens[0], "," ) )
		{
			string endorsementGroupRefUpper = endorsementGroupRef.toupper()
			Assert( endorsementGroupRefUpper in file.endorsementGroupRefToDefinition, format( "%s - DATA ERROR - PlaylistVar[%s] References Endorsement Group[%s], Which Is Not Defined", FUNC_NAME(), PVAR_ENDORSEMENTS_TRACKS, endorsementGroupRefUpper ) )
			newEndorsementTrack.endorsementLevelToGroup.append( file.endorsementGroupRefToDefinition[endorsementGroupRefUpper] )
		}

		file.endorsementTracks.append( newEndorsementTrack )
	}

	Assert( !isTracksFixedOrderEnabled || (Endorsements_GetMaxEndorsementsPerRound() <= file.endorsementTracks.len()), format( "%s - ERROR - TracksFixedOrderEnabled is true but there are no sufficient tracks defined", FUNC_NAME() ) )
}

void function Endorsements_SetupPerPlayerEndorsementDistribution( entity player )
{
	if ( !IsValid( player ) )
		return

	string matchID






		{
			matchID = GetUniqueServerId()
		}

	matchID = lstrip( rstrip( matchID ) )
	int hash = StringHash( format("%s_%s", matchID, player.GetUserID() ) )
	var randomSeed = CreateRandomSeed( hash )
	EHI playerEHI = ToEHI( player )

	PerPlayerEndorsementCraftingData playerCraftingData
	table<int, table<int, array<int> > > availableUpgradesPerRound 
	for ( int i = 0; i < Endorsements_GetMaxEndorsementCount(); i++ )
	{
		availableUpgradesPerRound[ i ] <- {}
		playerCraftingData.roundToUpgradeID[ i ] <- []
	}

	int choiceIndex = 0
	array< EndorsementChoiceData > currentLevelChoices = []
	table< EndorsementOptionData, EndorsementTrackDefinition > endorsementOptionToEndorsementTrack
	for ( int roundIndex = 0; roundIndex < Endorsements_GetMaxEndorsementCount(); ++roundIndex )
	{
		array< EndorsementChoiceData > nextLevelChoices  = []
		if ( roundIndex == 0 )
		{
			
			
			table< EndorsementDefinition, EndorsementTrackDefinition > selectedStartingEndorsements = Endorsements_SelectEndorsementsFromTracks( randomSeed, Endorsements_GetNormalEndorsementsPerRound(), roundIndex, file.endorsementTracks, player, Endorsements_IsTracksFixedOrderEnabled() )
			Assert( selectedStartingEndorsements.len() == Endorsements_GetNormalEndorsementsPerRound(), format("%s - ERROR - Selected Endorsement Count [%d] != Endorsements Required [%d]", FUNC_NAME(), selectedStartingEndorsements.len(), Endorsements_GetMaxEndorsementsPerRound() ) )

			EndorsementChoiceData newEndorsementChoice
			newEndorsementChoice.choiceId = choiceIndex
			newEndorsementChoice.choiceString = ""
			choiceIndex++

			foreach ( EndorsementDefinition startingEndorsement, EndorsementTrackDefinition selectedEndorsementTrack in selectedStartingEndorsements )
			{
				newEndorsementChoice.endorsementExclusionList.append( startingEndorsement.endorsementRef )

				EndorsementOptionData newEndorsementOption
				newEndorsementOption.endorsementRef         = startingEndorsement.endorsementRef
				newEndorsementOption.endorsementSponsorEnum = selectedEndorsementTrack.endorsementSponsorEnum
				endorsementOptionToEndorsementTrack[newEndorsementOption] <- selectedEndorsementTrack

				newEndorsementChoice.endorsementOptions.append( newEndorsementOption )
			}

			nextLevelChoices.append( newEndorsementChoice )
			playerCraftingData.choiceStringToChoiceData[newEndorsementChoice.choiceString] <- newEndorsementChoice
		}
		else
		{
			foreach ( EndorsementChoiceData currentChoiceData in currentLevelChoices )
			{
				foreach ( EndorsementOptionData currentEndorsementOption in currentChoiceData.endorsementOptions )
				{
					EndorsementDefinition endorsementDefinition = file.endorsementRefToDefinition[currentEndorsementOption.endorsementRef]
					EndorsementTrackDefinition endorsementTrack = endorsementOptionToEndorsementTrack[currentEndorsementOption]

					
					EndorsementChoiceData newEndorsementChoice
					newEndorsementChoice.choiceId = choiceIndex
					newEndorsementChoice.choiceString = (currentChoiceData.choiceString.len() == 0) ? format( "%d", endorsementDefinition.endorsementID ) : format( "%s_%d", currentChoiceData.choiceString, endorsementDefinition.endorsementID )
					choiceIndex++

					
					newEndorsementChoice.endorsementExclusionList = currentChoiceData.endorsementExclusionList.slice( 0 )
					array< EndorsementDefinition > selectedEndorsements = Endorsements_SelectEndorsementsFromGroup( randomSeed, Endorsements_GetNormalEndorsementsPerRound(), newEndorsementChoice.endorsementExclusionList, endorsementTrack.endorsementLevelToGroup[roundIndex], player )
					Assert( selectedEndorsements.len() == Endorsements_GetNormalEndorsementsPerRound(), format("%s - ERROR - Selected Endorsement Count [%d] != Endorsements Required [%d]", FUNC_NAME(), selectedEndorsements.len(), Endorsements_GetMaxEndorsementsPerRound() ) )

					foreach ( EndorsementDefinition selectedEndorsement in selectedEndorsements )
					{
						EndorsementOptionData newEndorsementOption
						newEndorsementOption.endorsementRef         = selectedEndorsement.endorsementRef
						newEndorsementOption.endorsementSponsorEnum = endorsementTrack.endorsementSponsorEnum
						endorsementOptionToEndorsementTrack[newEndorsementOption] <- endorsementTrack

						newEndorsementChoice.endorsementOptions.append( newEndorsementOption )
					}

					nextLevelChoices.append( newEndorsementChoice )
					playerCraftingData.choiceStringToChoiceData[newEndorsementChoice.choiceString] <- newEndorsementChoice
				}
			}
		}

		currentLevelChoices = nextLevelChoices.slice( 0 )
	}

	file.perPlayerEndorsementCraftingData[ playerEHI ] <- playerCraftingData
}

array< EndorsementDefinition > function Endorsements_SelectEndorsementsFromGroup( var randomSeed, int desiredEndorsementCount, array< string > endorsementExclusionList, EndorsementGroupDefinition endorsementGroup, entity player )
{
	
	string characterRef = "INVALID"
	int characterRole = eCharacterClassRole.UNDECIDED
	if ( IsValid( player ) )
	{
		ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
		characterRef  = ItemFlavor_GetCharacterRef( character ).tolower()
		characterRole = CharacterClass_GetRole( character )
	}

	array< EndorsementDefinition > selectedEndorsements = []

	
	int totalGroupWeight = 0
	foreach ( EndorsementGroupEntry endorsementGroupEntry in endorsementGroup.endorsementGroupEntries )
	{
		string entryRef = (endorsementGroupEntry.endorsementRef.len() != 0) ? endorsementGroupEntry.endorsementRef : endorsementGroupEntry.endorsementGroupRef
		if ( endorsementExclusionList.contains( entryRef ) )
			continue

		if ( endorsementGroupEntry.weight <= 0 )
			continue

		if ( entryRef == endorsementGroupEntry.endorsementRef )
		{
			if ( !Endorsement_IsValidRef( entryRef ) )
			{
				endorsementExclusionList.append( entryRef )
				continue
			}

			EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromRef( entryRef )
			if ( endorsementDefinition.excludedCharacterRefs.contains( characterRef ) || endorsementDefinition.excludedCharacterRoles.contains( characterRole ) )
			{
				endorsementExclusionList.append( entryRef )
				continue
			}
		}

		totalGroupWeight += endorsementGroupEntry.weight
	}

	
	while ( (selectedEndorsements.len() < desiredEndorsementCount) && (0 < totalGroupWeight) )
	{
		int randomWeight = RandomIntSeeded( randomSeed, totalGroupWeight )
		foreach ( EndorsementGroupEntry endorsementGroupEntry in endorsementGroup.endorsementGroupEntries )
		{
			string entryRef = (endorsementGroupEntry.endorsementRef.len() != 0) ? endorsementGroupEntry.endorsementRef : endorsementGroupEntry.endorsementGroupRef
			if ( endorsementExclusionList.contains( entryRef ) )
				continue

			if ( endorsementGroupEntry.weight <= 0 )
				continue

			randomWeight -= endorsementGroupEntry.weight
			if ( 0 <= randomWeight )
				continue

			
			
			if ( endorsementGroupEntry.endorsementRef.len() != 0 )
			{
				
				selectedEndorsements.append( file.endorsementRefToDefinition[entryRef] )
			}
			else
			{
				
				
				int endorsementsNeeded = desiredEndorsementCount - selectedEndorsements.len()
				EndorsementGroupDefinition selectedEndorsementGroup = file.endorsementGroupRefToDefinition[entryRef]
				array< EndorsementDefinition > recursiveSelectedEndorsements = Endorsements_SelectEndorsementsFromGroup( randomSeed, endorsementsNeeded, endorsementExclusionList, selectedEndorsementGroup, player )
				selectedEndorsements.extend( recursiveSelectedEndorsements )
			}

			endorsementExclusionList.append( entryRef )
			totalGroupWeight -= endorsementGroupEntry.weight
			break
		}
	}

	return selectedEndorsements
}

table< EndorsementDefinition, EndorsementTrackDefinition > function Endorsements_SelectEndorsementsFromTracks( var randomSeed, int desiredEndorsementCount, int endorsementLevel, array< EndorsementTrackDefinition > endorsementTracks, entity player, bool useFixedOrder )
{
	table< EndorsementDefinition, EndorsementTrackDefinition > selectedEndorsementToEndorsementTrackDefinition

	if ( endorsementTracks.len() == 0 )
		return selectedEndorsementToEndorsementTrackDefinition

	if ( useFixedOrder )
	{
		
		
		array< string > endorsementExclusionList = []
		for ( int endorsementTrackIndex = 0; endorsementTrackIndex < desiredEndorsementCount; ++endorsementTrackIndex )
		{
			array< EndorsementDefinition > selectedEndorsements = Endorsements_SelectEndorsementsFromGroup( randomSeed, 1, endorsementExclusionList, endorsementTracks[endorsementTrackIndex].endorsementLevelToGroup[endorsementLevel], player )
			foreach ( EndorsementDefinition selectedEndorsement in selectedEndorsements )
			{
				selectedEndorsementToEndorsementTrackDefinition[selectedEndorsement] <- endorsementTracks[endorsementTrackIndex]
			}
		}
	}
	else if ( endorsementTracks.len() == 1 )
	{
		
		EndorsementGroupDefinition selectedEndorsementGroup = endorsementTracks[0].endorsementLevelToGroup[endorsementLevel]
		array< EndorsementDefinition > recursiveSelectedEndorsements = Endorsements_SelectEndorsementsFromGroup( randomSeed, desiredEndorsementCount, [], selectedEndorsementGroup, player )
		foreach ( EndorsementDefinition selectedEndorsement in recursiveSelectedEndorsements )
		{
			selectedEndorsementToEndorsementTrackDefinition[selectedEndorsement] <- endorsementTracks[0]
		}
	}
	else
	{
		
		array< string > endorsementExclusionList = []

		
		int totalTracksWeight = 0
		foreach ( EndorsementTrackDefinition currentEndorsementTrack in endorsementTracks )
		{
			if ( currentEndorsementTrack.weight <= 0 )
				continue

			totalTracksWeight += currentEndorsementTrack.weight
		}

		
		array< EndorsementTrackDefinition > selectedTracks = []
		while ( (selectedEndorsementToEndorsementTrackDefinition.len() < desiredEndorsementCount) && (0 < totalTracksWeight) )
		{
			int randomWeight = RandomIntSeeded( randomSeed, totalTracksWeight )
			foreach ( EndorsementTrackDefinition currentEndorsementTrack in endorsementTracks )
			{
				if ( selectedTracks.contains( currentEndorsementTrack ) )
					continue

				if ( currentEndorsementTrack.weight <= 0 )
					continue

				randomWeight -= currentEndorsementTrack.weight
				if ( 0 <= randomWeight )
					continue

				
				
				EndorsementGroupDefinition selectedEndorsementGroup = currentEndorsementTrack.endorsementLevelToGroup[endorsementLevel]
				array< EndorsementDefinition > recursiveSelectedEndorsements = Endorsements_SelectEndorsementsFromGroup( randomSeed, 1, endorsementExclusionList, selectedEndorsementGroup, player )
				foreach ( EndorsementDefinition selectedEndorsement in recursiveSelectedEndorsements )
				{
					selectedEndorsementToEndorsementTrackDefinition[selectedEndorsement] <- currentEndorsementTrack
				}

				selectedTracks.append( currentEndorsementTrack )
				totalTracksWeight -= currentEndorsementTrack.weight
				break
			}
		}
	}

	Assert( desiredEndorsementCount == selectedEndorsementToEndorsementTrackDefinition.len(), format( "%s - ERROR - There was an issue selecting the desired endorsement count [%d] from the tracks provided, verify your endorsement data", FUNC_NAME(), desiredEndorsementCount ) )
	return selectedEndorsementToEndorsementTrackDefinition
}

int function Endorsements_GetMaxEndorsementID()
{
	return file.maxEndorsementID
}

bool function Endorsement_IsValidRef( string endorsementRef )
{
	string endorsementRefUpper = strip( endorsementRef ).toupper()
	if ( endorsementRefUpper.len() == 0 )
		return false

	if ( !(endorsementRefUpper in file.endorsementRefToDefinition) )
		return false

	
	return true
}

EndorsementDefinition function Endorsements_GetEndorsementDefinitionFromRef( string endorsementRef )
{
	string endorsementRefUpper = endorsementRef.toupper()
	Assert( Endorsement_IsValidRef( endorsementRefUpper ), format( "%s - ERROR - EndorsementRef[%s] is not a valid Endorsement ref", FUNC_NAME(), endorsementRefUpper ) )

	return file.endorsementRefToDefinition[endorsementRefUpper]
}

EndorsementDefinition function Endorsements_GetEndorsementDefinitionFromID( int endorsementID )
{
	Assert( endorsementID in file.endorsementIDToDefinition, format("%s - ERROR - EndorsementID[%d] is not a valid Endorsement ID", FUNC_NAME(), endorsementID ) )

	return file.endorsementIDToDefinition[endorsementID]
}

EndorsementGroupDefinition function Endorsements_GetEndorsementGroupDefinitionFromRef( string endorsementGroupRef )
{
	string endorsementGroupRefUpper = endorsementGroupRef.toupper()
	Assert( endorsementGroupRefUpper in file.endorsementGroupRefToDefinition, format( "%s - ERROR - EndorsementGroupRef[%s] is not a valid Endorsement ref", FUNC_NAME(), endorsementGroupRefUpper ) )

	return file.endorsementGroupRefToDefinition[endorsementGroupRefUpper]
}

EndorsementSponsorDefinition function Endorsements_GetEndorsementSponsorDefinitionFromSponsor( int endorsementSponsor )
{
	Assert( endorsementSponsor in file.endorsementSponsorToDefinition, format( "%s - ERROR - EndorsementSponsorRef[%s] is not a valid Endorsement Sponsor Ref", FUNC_NAME(), endorsementSponsor ) )

	return file.endorsementSponsorToDefinition[endorsementSponsor]
}

bool function Endorsements_AreChoicesDifferentSponsors( EndorsementChoiceData choiceData )
{
	int sponsor = eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID
	foreach ( EndorsementOptionData optionData in choiceData.endorsementOptions )
	{
		if ( sponsor != eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID )
		{
			if ( sponsor != optionData.endorsementSponsorEnum )
			{
				return true
			}
		}
		else
		{
			sponsor = optionData.endorsementSponsorEnum
		}
	}

	return false
}

table<EHI, PerPlayerEndorsementCraftingData> function Endorsements_GetPerPlayerEndorsementData()
{
	return clone file.perPlayerEndorsementCraftingData
}

array<int> function Endorsements_GetPlayerEndorsementArray( entity player )
{
	array<int> endorsements
	int endorsement = player.GetPlayerNetInt( NETVAR_ENDORSEMENT_0 )
	if ( endorsement != ENDORSEMENT_INVALID )
	{
		endorsements.append( endorsement )
	}

	endorsement = player.GetPlayerNetInt( NETVAR_ENDORSEMENT_1 )
	if ( endorsement != ENDORSEMENT_INVALID )
	{
		endorsements.append( endorsement )
	}

	endorsement = player.GetPlayerNetInt( NETVAR_ENDORSEMENT_2 )
	if ( endorsement != ENDORSEMENT_INVALID )
	{
		endorsements.append( endorsement )
	}

	return endorsements
}

int function Endorsements_GetPlayerEndorsementSlot( entity player, int endorsementID )
{
	array< int > playerEndorsements = Endorsements_GetPlayerEndorsementArray( player )
	for ( int i = 0; i < playerEndorsements.len(); i++ )
	{
		if ( playerEndorsements[i] == endorsementID )
		{
			return i
		}
	}

	return ENDORSEMENT_SLOT_INVALID 
}

string function Endorsements_GetPlayerEndorsementChoiceString( entity player )
{
	if ( !IsValid( player ) )
		return ""

	string endorsementChoiceString = ""
	array< int > playerEndorsementArray = Endorsements_GetPlayerEndorsementArray( player )
	foreach ( int playerEndorsementID in playerEndorsementArray )
	{
		if ( playerEndorsementID == ENDORSEMENT_INVALID )
			break

		endorsementChoiceString = (endorsementChoiceString.len() == 0) ? format( "%d", playerEndorsementID ) : format( "%s_%d", endorsementChoiceString, playerEndorsementID )
	}

	return endorsementChoiceString
}

bool function Endorsements_PlayerHasEndorsement( entity player, int endorsement )
{
	return player.GetPlayerNetInt( NETVAR_ENDORSEMENT_0 ) == endorsement || player.GetPlayerNetInt( NETVAR_ENDORSEMENT_1 ) == endorsement || player.GetPlayerNetInt( NETVAR_ENDORSEMENT_2 ) == endorsement
}

bool function Endorsements_PlayerHasEndorsementByPassive( entity player, int passiveId )
{
	return passiveId in file.passiveIDToEndorsementDef && Endorsements_PlayerHasEndorsement( player, file.passiveIDToEndorsementDef[ passiveId ].endorsementID )
}

int function Endorsements_GetPlayerEndorsementCount( entity player )
{
	return ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_0 ) == ENDORSEMENT_INVALID ? 0 : 1 )
			+ ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_1 ) == ENDORSEMENT_INVALID ? 0 : 1 )
			+ ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_2 ) == ENDORSEMENT_INVALID ? 0 : 1 )
}

bool function Endorsements_IsPlayerLockedOutFromCrafter( entity player )
{
	bool isPlayerLockedOutFromCrafter = false
	if ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_0 ) != ENDORSEMENT_INVALID )
	{
		isPlayerLockedOutFromCrafter = isPlayerLockedOutFromCrafter || Endorsements_GetEndorsementDefinitionFromID( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_0 ) ).hasEndorsementStationLockout
	}
	if ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_1 ) != ENDORSEMENT_INVALID )
	{
		isPlayerLockedOutFromCrafter = isPlayerLockedOutFromCrafter || Endorsements_GetEndorsementDefinitionFromID( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_1 ) ).hasEndorsementStationLockout
	}
	if ( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_2 ) != ENDORSEMENT_INVALID )
	{
		isPlayerLockedOutFromCrafter = isPlayerLockedOutFromCrafter || Endorsements_GetEndorsementDefinitionFromID( player.GetPlayerNetInt( NETVAR_ENDORSEMENT_2 ) ).hasEndorsementStationLockout
	}

	return isPlayerLockedOutFromCrafter
}

bool function Endorsements_IsValidEndorsementForPurchase( entity player, int round, int endorsementID )
{
	if ( !IsValid( player ) || (endorsementID == ENDORSEMENT_INVALID ) )
		return false

	EHI playerEHI = ToEHI( player )
	if ( !(playerEHI in file.perPlayerEndorsementCraftingData) )
		return false

	EndorsementDefinition endorsementDefinitionToCheck = Endorsements_GetEndorsementDefinitionFromID( endorsementID )
	string endorsementChoiceString = Endorsements_GetPlayerEndorsementChoiceString( player )
	PerPlayerEndorsementCraftingData playerCraftingData = file.perPlayerEndorsementCraftingData[playerEHI]

	Assert( endorsementChoiceString in playerCraftingData.choiceStringToChoiceData, format( "%s - ERROR - INVALID Choice String[%s] for Player Choice Data", FUNC_NAME(), endorsementChoiceString ) )
	EndorsementChoiceData endorsementChoiceData = playerCraftingData.choiceStringToChoiceData[endorsementChoiceString]

	foreach ( EndorsementOptionData endorsementOption in endorsementChoiceData.endorsementOptions )
	{
		if ( endorsementOption.endorsementRef == endorsementDefinitionToCheck.endorsementRef )
			return true
	}

	return false
}




















































































































































































































































































































































































































































