	Assert( choiceData.endorsementOptions.len() > 0, format( "%s - Cannot get endorsement replicator background icon for player %s that has no available endorsement options.", FUNC_NAME(), ( IsValid( GetLocalViewPlayer() ) ? GetLocalViewPlayer().GetPlayerName() : "INVALID" ) ) )

	if ( Endorsements_AreChoicesDifferentSponsors( choiceData ) )
