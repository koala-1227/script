const float ENDORSEMENT_USED_MIN_TIME = 0.6
const float ENDORSEMENT_USED_TOTAL_TIME = 1.5

void function ServerToClient_Endorsements_DisplayEndorsementUsedPopup( entity player, int endorsementID, int conveyanceType, float overrideDuration, float overrideCooldown )
{

	Endorsements_DisplayEndorsementUsedPopup( player, endorsementID, conveyanceType, overrideDuration, overrideCooldown )



}


void function Endorsements_DisplayEndorsemenUsedPopupByPassiveID( entity player, int passiveID, int conveyanceType, float overrideDuration = 0.0, float overrideCooldown = 0.0 )
{
	if ( !( passiveID in file.passiveIDToEndorsementDef ) )
	{
		Assert( false, "Endorsements_DisplayEndorsementPassiveUsedPopup failed to map passiveID to endorsement def: " + passiveID )
		return
	}

	Endorsements_DisplayEndorsementUsedPopup( player, file.passiveIDToEndorsementDef[ passiveID ].endorsementID, conveyanceType, overrideDuration, overrideCooldown )
}


void function Endorsements_UpdateLocalPlayerEndorsementProgressByPassiveID( entity player, int passiveID, int conveyanceType, float overrideProgress = 0.0 )
{
	if ( !Endorsements_IsActive() )
		return

	if ( GetCurrentPlaylistVarBool( "ks_notifyplayerusedendorsement", false ) )
		return

	if ( player != GetLocalViewPlayer() )
	{
		Assert( false, "Endorsements_UpdateLocalPlayerEndorsementProgress called on non-local player" )
		return
	}

	if ( !IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.UNIT_FRAME ) )
		return

	if ( !( passiveID in file.passiveIDToEndorsementDef ) )
	{
		Assert( false, "Endorsements_UpdateLocalPlayerEndorsementProgress failed to map passiveID to endorsement def: " + passiveID )
		return
	}

	Endorsements_OverrideUnitframeRuiProgressForPlayer( player, file.passiveIDToEndorsementDef[ passiveID ].endorsementID, overrideProgress )
}

void function Endorsements_DisplayEndorsementUsedPopup( entity player, int endorsementID, int conveyanceType, float overrideDuration = 0.0 , float overrideCooldown = 0.0  )
{
	if ( !Endorsements_IsActive() )
		return

	if ( GetCurrentPlaylistVarBool( "ks_notifyplayerusedendorsement", false ) )
		return

	EndorsementDefinition endorsementDefinition = clone Endorsements_GetEndorsementDefinitionFromID( endorsementID )

	if ( overrideDuration > 0.0 )
		endorsementDefinition.duration = overrideDuration

	if ( overrideCooldown > 0.0 )
		endorsementDefinition.cooldown = overrideCooldown

	bool isLocalPlayer = player == GetLocalViewPlayer()

	if ( ( isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.UNIT_FRAME ) ) ||
		( !isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.UNIT_FRAME_TEAM ) ) )
		Endorsements_AnimateUnitframeRuiForPlayer( player, endorsementID, endorsementDefinition )

	if ( ( isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.TOAST ) ) ||
		( !isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.TOAST_TEAM ) ) )
		EndorsementAnnouncement_QueueItem( player, endorsementID, isLocalPlayer )

	if ( ( isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.ANNOUNCEMENT ) ) ||
		( !isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.ANNOUNCEMENT_TEAM ) ) )
	{
		AnnouncementData announcement = Announcement_Create( Localize( endorsementDefinition.displayName ) )
		Announcement_SetSubText( announcement, Localize( endorsementDefinition.displayDescription ) )
		Announcement_SetHideOnDeath( announcement, true )
		Announcement_SetDuration( announcement, 3.5 )
		Announcement_SetPurge( announcement, false )
		AnnouncementFromClass( GetLocalViewPlayer(), announcement )
	}

	if ( isLocalPlayer && IsBitFlagSet( conveyanceType, eEndorsementConveyanceFlags.WEAPON_STATUS ) )
	{
		thread function () : ( endorsementID, endorsementDefinition )
		{
			float timeSinceLast = Time() - file.endorsementUsedLastTime
			if ( timeSinceLast < ENDORSEMENT_USED_MIN_TIME )
			{
				EndSignal( clGlobal.signalDummy, "ViewPlayerChanged" )
				file.endorsementQueueItemsInFlight++
				OnThreadEnd( function() : () { file.endorsementQueueItemsInFlight-- } )

				wait ( ENDORSEMENT_USED_MIN_TIME - timeSinceLast ) * file.endorsementQueueItemsInFlight
			}

			if ( !GetCurrentPlaylistVarBool( "hud_hide_infopopup", false ) )
			{

				PopupData data
				data.popupType = ePopupType.PASSIVE
				data.popupSlot = eHopupPopupSlot.PASSIVE
				data.slotKey = "passive"
				data.holdTime = ENDORSEMENT_USED_TOTAL_TIME
				data.passiveTier = 1
				data.passiveAltTier = 2
				data.passiveDesc = Localize( "#ENDORSEMENT_TRIGGERED" )
				data.passiveMagIcon = $"rui/hud/gametype_icons/survival/endorsement_map_icon"
				data.passiveWeaponIcon = $""
				data.endorsementName = Localize( endorsementDefinition.displayName )
				data.endorsementIcon = endorsementDefinition.endorsementIcon
				data.passiveAmmoIcon = $""
				data.displayMagDetails = false

				HopupPopupQueue_ShowPopup( data )
			}

			if ( endorsementDefinition.notifSound_1p != "" )
			{
				EmitSoundOnEntity( GetLocalViewPlayer(), endorsementDefinition.notifSound_1p )
			}

			file.endorsementUsedLastTime = Time()
		}()
	}
}













































