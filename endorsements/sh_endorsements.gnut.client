RGBA function Endorsements_GetPrimaryReplicatorUIColorFromSponsorChoices( EndorsementChoiceData choiceData )
{
	Assert( choiceData.endorsementOptions.len() > 0, format( "%s - Cannot get endorsement replicator theme for player %s that has no available endorsement options.", FUNC_NAME(), ( IsValid( GetLocalViewPlayer() ) ? GetLocalViewPlayer().GetPlayerName() : "INVALID" ) ) )

	if ( Endorsements_AreChoicesDifferentSponsors( choiceData ) )
	{
		return RGBAToLinear( Endorsements_GetCraftingStationUISkin().themeColorForMultipleSponsors )
	}
	else
	{
		int sponsor = choiceData.endorsementOptions[0].endorsementSponsorEnum
		if ( sponsor != eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID )
		{
			EndorsementSponsorDefinition sponsorDefinition = Endorsements_GetEndorsementSponsorDefinitionFromSponsor( sponsor )
			return RGBAToLinear( VectorToRGBA( sponsorDefinition.color / 255.0 ) )
		}
	}

	return RGBAToLinear( Endorsements_GetCraftingStationUISkin().primaryThemeColor )
}

asset function Endorsements_GetCurrentTrackIconForReplicatorFromSponsorChoices( EndorsementChoiceData choiceData )
{
	Assert( choiceData.endorsementOptions.len() > 0, format( "%s - Cannot get endorsement replicator track icon for player %s that has no available endorsement options.", FUNC_NAME(), ( IsValid( GetLocalViewPlayer() ) ? GetLocalViewPlayer().GetPlayerName() : "INVALID" ) ) )

	if ( !Endorsements_AreChoicesDifferentSponsors( choiceData ) )
	{
		int sponsor = choiceData.endorsementOptions[0].endorsementSponsorEnum
		if ( sponsor != eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID )
		{
			EndorsementSponsorDefinition sponsorDefinition = Endorsements_GetEndorsementSponsorDefinitionFromSponsor( sponsor )
			return sponsorDefinition.icon
		}
	}

	return $""
}

string function Endorsements_GetHoverSoundForSponsor( int sponsor )
{
	const string DEFAULT_HOVER_SOUND = "Unhinged_WildcardStation_UI_Hover_1P"

	if ( sponsor == eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID )
		return DEFAULT_HOVER_SOUND

	EndorsementSponsorDefinition sponsorData = Endorsements_GetEndorsementSponsorDefinitionFromSponsor( sponsor )
	return sponsorData.hoverSound_1p.len() > 0 ? sponsorData.hoverSound_1p : DEFAULT_HOVER_SOUND
}

string function Endorsements_GetSelectionSoundForSponsor( int sponsor, bool isLast )
{
	const string DEFAULT_SELECT_SOUND = "Unhinged_WildcardStation_UI_Select_1P"
	const string DEFAULT_SELECT_LAST_SOUND = "Unhinged_WildcardStation_UI_Select_Last_1P"

	if ( sponsor == eEndorsementSponsor.ENDORSEMENT_SPONSOR_INVALID )
		return isLast ? DEFAULT_SELECT_LAST_SOUND : DEFAULT_SELECT_SOUND

	EndorsementSponsorDefinition sponsorData = Endorsements_GetEndorsementSponsorDefinitionFromSponsor( sponsor )

	if ( isLast )
	{
		return sponsorData.selectLastSound_1p.len() > 0 ? sponsorData.selectLastSound_1p : DEFAULT_SELECT_LAST_SOUND
	}
	else
	{
		return sponsorData.selectSound_1p.len() > 0 ? sponsorData.selectSound_1p : DEFAULT_SELECT_LAST_SOUND
	}

	unreachable
}


