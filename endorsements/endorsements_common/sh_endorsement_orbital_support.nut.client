const vector ORBITAL_SUPPORT_PROJECTILE_STARTING_OFFSET	= <0,0, 10000>

const float PLAYERORBITALDATA_MAX_CHARGE = 100.0
const float ORBITAL_SUPPORT_RECHARGE_MODIFIER = 20


const string SCRIPT_NAME_ORBITAL_SUPPORT_WAYPOINT = "orbital_support_waypoint"
const string SCRIPT_NAME_ORBITAL_SUPPORT_WEAPON = "mp_weapon_orbital_support_weapon"


const string SIG_ORBITAL_SUPPORT_DESTROY_RUI 						= "HopupOrbitalSupportDestroyRui"
const string SIG_ORBITAL_SUPPORT_DEACTIVATE 						= "HopupOrbitalSupportDeactivate"
const string SIG_ORBITAL_SUPPORT_TAG_LOST 							= "HopupOrbitalSupportLost"
const string SIG_ORBITAL_SUPPORT_DESTROY_ORBITAL_SUPPORT_STATUS_RUI = "HopupOrbitalSupportDestroyMissileStatusRui"


const asset FX_BOMBARDMENT_MARKER = $"P_ar_artillery_marker"
const asset FX_DEFENSIVE_BOMBARDMENT_SCAN = $"P_artillery_marker_scan"
const asset FX_ORBITAL_SUPPORT_BOMB = $"P_artillery_bomb_wc"


const string SFX_ORBITAL_SUPPORT_FAIL_LOCK_1P = "Unhinged_Wildcard_HeavyarmsSalvo_UI_FailedLock_1p"
const string SFX_ORBITAL_SUPPORT_HALF_LOCK_1P = "Unhinged_Wildcard_HeavyarmsSalvo_UI_PartialLock_1p"
const string SFX_ORBITAL_SUPPORT_FULL_LOCK_1P = "Unhinged_Wildcard_HeavyarmsSalvo_UI_FullLock_1p"
const string SFX_ORBITAL_SUPPORT_FIRE_1P = "weapon_r97_mythic_rocket_fire_1p"
const string SFX_ORBITAL_SUPPORT_FIRE_3P = "weapon_r97_mythic_rocket_fire_3p"
const string SFX_ORBITAL_SUPPORT_LOCKON_1P = "Unhinged_Wildcard_HeavyarmsSalvo_LockOn_3p_vs_1p"
const string SFX_ORBITAL_SUPPORT_READY = "Unhinged_Wildcard_HeavyarmsSalvo_UI_Ready"


const asset RUI_ORBITAL_SUPPORT = $"ui/endorsement_tone_tracker_hopup.rpak"
const asset RUI_ORBITAL_SUPPORT_STATUS = $"ui/missile_status_hud.rpak"

const vector RUI_BEAMSTICK_HUD_COLOR = <19, 82, 240> / 255.0

struct TagVictimData
{
	entity waypoint
	float timeSinceLastHit
}

struct TagData
{
	table< entity, TagVictimData > targets
	bool tagReady
}

struct FiredOrbitals
{
	entity orbitalTarget
	array<entity> orbitalsFiredAtTarget
}

struct PlayerOrbitalData
{
	float curChargeVal
	float maxChargeVal
	bool orbitalReady
	int targetsLocked
	bool orbitalFiring
}

struct
{
	float explosionRadius = 75
	float strikeDelay = 0.5
	float strikeRadius = 125
	float impulse = 0
	float damage = 25
	float delayBetweenShots = 0.2
	float cooldown = 10.0
	int hitsPerTag 			= 100
	int numberOfStrikes 	= 3
	float hitExpireTimeSec 	= 10.0

	int shotgunFillAmount = 34
	int sniperFillAmount = 60
	int marksmanFillAmount = 40
	int lmgFillAmount = 28
	int assaultFillAmount = 22
	int smgFillAmount = 20
	int pistolFillAmount = 18
	int maxFillAmount = 100
	bool disableLockonOnBleedout = false
} tuning

struct
{




	table<entity, PlayerOrbitalData> playerOrbitalData


		array<entity> lockedPlayers
		bool activelyFiring


} file

void function Endorsement_OrbitalSupport_Init()
{
	RegisterTuningStruct( "tuning", "endorsement_orbital_strike_" )
	Endorsement_OrbitalSupport_Networking()






		AddCallback_OnPassiveChanged( ePassives.PAS_ENDORSEMENT_ORBITAL_SUPPORT, Endorsement_OrbitalSupport_OnPassiveChanged )


	PrecacheParticleSystem( FX_BOMBARDMENT_MARKER )
	PrecacheParticleSystem( FX_DEFENSIVE_BOMBARDMENT_SCAN )
	PrecacheParticleSystem( FX_ORBITAL_SUPPORT_BOMB )
	PrecacheWeapon( SCRIPT_NAME_ORBITAL_SUPPORT_WEAPON )
}

asset function Endorsement_OrbitalSupport_GetIcon()
{
	EndorsementDefinition endorsementDefinition = Endorsements_GetEndorsementDefinitionFromRef( "orbitalsupport" )
	return endorsementDefinition.endorsementIcon
}

void function Endorsement_OrbitalSupport_Networking()
{






		AddCreateCallback( PLAYER_WAYPOINT_CLASSNAME, OnWaypointCreated )

		RegisterSignal( SIG_ORBITAL_SUPPORT_DESTROY_RUI )
		RegisterSignal( SIG_ORBITAL_SUPPORT_DESTROY_ORBITAL_SUPPORT_STATUS_RUI )


	Remote_RegisterClientFunction( "ServerToClient_ResetOrbitalStikeTimer" )
	Remote_RegisterClientFunction( "ServerToClient_UpdateOrbitalCharge", "float", 0.0, PLAYERORBITALDATA_MAX_CHARGE, 32  )
	Remote_RegisterClientFunction( "ServerToClient_UpdateOrbitalIsFiring", "bool" )
	Remote_RegisterClientFunction( "ServerToClient_UpdateOrbitalIsFiring_Target", "bool" )
}


#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________CallbackHandling___________________(){}
#endif

void function Endorsement_OrbitalSupport_OnPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	if ( !IsValidPlayer( player ) )
		return

	if ( nowHas )
	{








		if ( !(player in file.playerOrbitalData) )
		{
			PlayerOrbitalData pod
			pod.curChargeVal = PLAYERORBITALDATA_MAX_CHARGE * 0.9 
			pod.maxChargeVal = PLAYERORBITALDATA_MAX_CHARGE
			pod.orbitalReady = false
			file.playerOrbitalData[player] <- pod
		}






			thread OrbitalSupport_StatusRui_Thread( player )

	}
	else
	{









			player.Signal( SIG_ORBITAL_SUPPORT_DESTROY_RUI )
			player.Signal( SIG_ORBITAL_SUPPORT_DESTROY_ORBITAL_SUPPORT_STATUS_RUI )

	}
}






































