bool function OrbitalSupportReady( entity player )
{
	if ( !(player in file.playerOrbitalData) )
		return false

	PlayerOrbitalData playerOD = file.playerOrbitalData[player]
	playerOD.orbitalReady = playerOD.curChargeVal >= playerOD.maxChargeVal

	return playerOD.orbitalReady
}

int function GetHitsOnTarget( entity waypoint )
{
	return int(waypoint.GetWaypointFloat( 0 ))
}

int function GetTargetsLocked( entity player )
{
	return file.playerOrbitalData[player].targetsLocked
}

bool function HasTargets( entity player )
{
	bool hasTargets = true 

	return hasTargets
}


bool function OrbitalSupport_EnemyHasTag()
{
	return file.lockedPlayers.len() > 0
}










void function OrbitalSupport_StatusRui_Thread( entity player )
{
	AssertIsNewThread()

	if ( !IsValid( player ) || !IsLocalViewPlayer( player ) )
		return

	player.Signal( SIG_ORBITAL_SUPPORT_DESTROY_ORBITAL_SUPPORT_STATUS_RUI )
	player.EndSignal( "OnDeath", "OnDestroy" )
	player.EndSignal( SIG_ORBITAL_SUPPORT_DESTROY_ORBITAL_SUPPORT_STATUS_RUI )

	var rui = CreateCockpitPostFXRui( RUI_ORBITAL_SUPPORT_STATUS )

	OnThreadEnd(
		function() : ( rui )
		{
			RuiDestroyIfAlive( rui )
		}
	)

	PlayerOrbitalData playerOD = file.playerOrbitalData[player]
	RuiSetAsset( rui, "missileIcon", Endorsement_OrbitalSupport_GetIcon() )

	bool playSound = false
	while ( player.HasPassive( ePassives.PAS_ENDORSEMENT_ORBITAL_SUPPORT ))
	{
		if ( !OrbitalSupportReady( player ) )
		{
			bool isFiring = file.playerOrbitalData[player].orbitalFiring
			vector color = isFiring ? COLOR_RED : COLOR_BLACK
			float alpha = isFiring ? 0.95 : max( 0.25, playerOD.curChargeVal / PLAYERORBITALDATA_MAX_CHARGE )

			RuiSetColorAlpha( rui, "missileIconColor", COLOR_GRAY / 255.0, alpha)
			RuiSetColorAlpha( rui, "backgroundColor", color / 255.0, alpha )

			RuiSetGameTime( rui, "missileReadyTime", RUI_BADGAMETIME )
			playSound = false
		}
		else 
		{
			RuiSetColorAlpha( rui, "missileIconColor", COLOR_WHITE / 255.0, 0.95 )
			RuiSetColorAlpha( rui, "backgroundColor", UNHINGED_COLOR / 255.0, 0.95 )

			if ( !playSound )
			{
				EmitSoundOnEntity( player, SFX_ORBITAL_SUPPORT_READY )
				playSound = true
			}
		}

		WaitFrame()
	}
}


