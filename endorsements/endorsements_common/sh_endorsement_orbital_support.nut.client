float function GetLastTimeOnTarget( entity waypoint )
{
	return waypoint.GetWaypointGametime( 0 )
}


void function OnWaypointCreated( entity wp )
{
	int wpType = wp.GetWaypointType()

	if ( wpType == eWaypoint.ORBITAL_SUPPORT_TRACKER )
	{
		thread OrbitalSupport_UpdateWaypoint_Thread( wp )
	}
}



void function ServerToClient_ResetOrbitalStikeTimer()
{
	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) )
		return

	if ( !( player in file.playerOrbitalData ) )
		return

	file.playerOrbitalData[player].curChargeVal = 0
}



void function ServerToClient_UpdateOrbitalCharge( float value )
{
	entity player = GetLocalViewPlayer()
	file.playerOrbitalData[player].curChargeVal = value
}



void function ServerToClient_UpdateOrbitalIsFiring( bool value )
{
	entity player = GetLocalViewPlayer()
	file.playerOrbitalData[player].orbitalFiring = value
}



void function ServerToClient_UpdateOrbitalIsFiring_Target( bool value )
{
	file.activelyFiring = value
}



bool function IsOrbtialFiring()
{
	return file.activelyFiring
}



void function OrbitalSupport_UpdateWaypoint_Thread( entity wp )
{
	wp.SetDoDestroyCallback( true )
	wp.EndSignal( "OnDeath" )
	wp.EndSignal( "OnDestroy" )

	entity owner  = wp.GetOwner()
	entity target = wp.GetParent()

	bool isOwner = GetLocalViewPlayer() == owner

	if ( isOwner )
	{
		
		var rui = CreateCockpitRui( RUI_ORBITAL_SUPPORT, 1 )
		RuiTrackFloat3( rui, "worldPos", wp, RUI_TRACK_ABSORIGIN_FOLLOW )
		RuiTrackFloat( rui, "curTone", wp, RUI_TRACK_WAYPOINT_FLOAT, 0 )
		RuiTrackFloat( rui, "maxTone", wp, RUI_TRACK_WAYPOINT_FLOAT, 1 )
		RuiSetColorAlphaIfExists( rui, "fillColor", UNHINGED_COLOR / 255.0, 1.0 )

		OnThreadEnd(
			function() : ( rui )
			{
				
				
				RuiSetBool( rui, "dieWhenPossible", true )
			}
		)

		while( true )
		{
			bool hasTag          = GetHitsOnTarget( wp ) >= tuning.hitsPerTag
			bool show            = isOwner
			bool playerCanSeePos = PlayerCanSeePos( GetLocalViewPlayer(), wp.GetOrigin(), true, 90 )
			entity targetHoverVeh = HoverVehicle_GetVehicleOccupiedByPlayer( target )
			bool targetInVehicle = IsValid( targetHoverVeh )
			if ( targetInVehicle )
			{
				playerCanSeePos = PlayerCanSee( GetLocalViewPlayer(), targetHoverVeh, true, 90, true )
			}
			show = show && ( hasTag || playerCanSeePos )
			RuiSetBool( rui, "isVisible", show )

			if ( hasTag )
			{
				float startTime   = GetLastTimeOnTarget( wp )
				float lockonScale = 1 - ((Time() - startTime) / tuning.hitExpireTimeSec )
				RuiSetFloat( rui, "lockonScale", 1 ) 
			}
			WaitFrame()
		}

		WaitForever()
	}
	else if ( GetLocalViewPlayer() == target )
	{
		file.lockedPlayers.append( owner )

		OnThreadEnd(
			function() : ( owner )
			{
				file.lockedPlayers.fastremovebyvalue( owner )
			}
		)
		WaitForever()
	}
}
































































































