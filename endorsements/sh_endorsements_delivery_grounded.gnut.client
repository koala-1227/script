	RuiSetImage( rui, "defaultIcon", ENDORSEMENT_CRAFTER_MINIMAP_ICON )
	RuiSetImage( rui, "clampedDefaultIcon", $"" )
	RuiSetBool( rui, "useTeamColor", false )
}

entity function Endorsements_Delivery_FullmapPing_GetUnderAim( vector worldPos, float worldRange )
{
	float closestDistSqr = FLT_MAX
	float worldRangeSqr = worldRange * worldRange
	entity closestEnt = null

	if ( MapPing_Modify_DistanceCheck_Enabled() )
	{
		float modifier = MapPing_DistanceCheck_GetModifier()

		if ( worldRange >= MapPing_DistanceCheck_GetDistanceRange() )
		{
			modifier *= 0.5
		}

		worldRangeSqr = ( worldRange * modifier ) * ( worldRange * modifier )
	}

	foreach ( EndorsementCrafterClientEntity crafter in file.craftersForHighlightTracking.clonevalues() )
	{
		vector objOrigin = crafter.crafter.GetOrigin()

		float distSqr = Distance2DSqr( objOrigin, worldPos )
		if ( distSqr < worldRangeSqr && distSqr < closestDistSqr )
		{
			closestDistSqr = distSqr
			closestEnt     = crafter.crafter
		}
	}

	if ( !IsValid( closestEnt ) )
	{
		return null
	}

	return closestEnt
}

bool function Endorsements_Delivery_FullmapPing_PingUnderAim( entity airdrop )
{
	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsPingAllowedForPlayer( player ) )
		return false

	if ( !IsPingEnabledForPlayer( player ) )
		return false

	if ( IsValid( airdrop ) )
	{
		Remote_ServerCallFunction( string( ClientToServer_Endorsements_Delivery_FullmapPing_PingCrafterFromMap ), airdrop )
	}

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )

	return true
}

void function Endorsements_Delivery_UpdateCrafterLights( EndorsementCrafterClientEntity crafter )
{
	
	bool enable = IsValid( GetLocalViewPlayer() ) && Endorsements_Delivery_GetPlayerTicketCount( GetLocalViewPlayer() ) != 0 && !crafter.forceDisabled

	
	if ( !enable )
	{
		crafter.crafter.Highlight_OverrideParam( 1, <MAX_WORLD_COORD, MAX_WORLD_COORD, MAX_WORLD_COORD> )
		crafter.crafter.SetClientSkinOverride( crafter.crafter.GetSkinIndexByName( "off" ) )
		EffectStop( crafter.beamFX, true, true )
		crafter.beamFX = -1
		EffectStop( crafter.hologramFX, true, true )
		crafter.hologramFX = -1
	}
	else
	{
		crafter.crafter.Highlight_ClearOverrideParam( 1 )
		crafter.crafter.SetClientSkinOverride( crafter.crafter.GetSkinIndexByName( "on" ) )
		if ( crafter.beamFX == -1 )
		{
			crafter.beamFX = StartParticleEffectInWorldWithHandle( GetParticleSystemIndex( ENDORSEMENT_CRAFTER_INCOMING_BEAM_FX ), crafter.crafter.GetOrigin(), crafter.crafter.GetAngles() + <0, 180, 0> )
			EffectSetControlPointVector( crafter.beamFX, 4, UNHINGED_COLOR )
			crafter.hologramFX = StartParticleEffectInWorldWithHandle( GetParticleSystemIndex( ENDORSEMENT_CRAFTER_HOLOGRAM_FX ), crafter.crafter.GetOrigin(), crafter.crafter.GetAngles() )
		}
	}
}

void function Endorsements_NetVarChanged_PlayerTicketCount( entity player, int newVal )
{
	
	entity viewPlayer = GetLocalViewPlayer()
	if ( !IsValidPlayer( player ) || !IsValidPlayer( viewPlayer ) )
		return

	int viewPlayerTeam = viewPlayer.GetTeam()
	bool isViewPlayer = player == viewPlayer
	bool isFriendlyPlayer = IsFriendlyTeam( player.GetTeam(), viewPlayerTeam )

	if ( !isViewPlayer && !isFriendlyPlayer )
		return

	Endorsements_UpdateUnitframeRuiForPlayer( player )
	Endorsements_Crafting_UpdateTicketCount( newVal )

	if ( isViewPlayer )
	{
		foreach ( EndorsementCrafterClientEntity crafter in file.craftersForHighlightTracking.clonevalues() )
		{
			Endorsements_Delivery_UpdateCrafterLights( crafter )
		}
	}
}

void function Endorsements_Delivery_ForceDisableFX( entity crafterEnt, string arg )
{
	EndorsementCrafterClientEntity crafter = file.craftersForHighlightTracking[ crafterEnt ]
	crafter.forceDisabled = true
	Endorsements_Delivery_UpdateCrafterLights( crafter )
}

void function Endorsements_Delivery_EndForceDisableFX( entity crafterEnt, string arg )
{
	EndorsementCrafterClientEntity crafter = file.craftersForHighlightTracking[ crafterEnt ]
	crafter.forceDisabled = false
	Endorsements_Delivery_UpdateCrafterLights( crafter )
}

void function Endorsements_Delivery_PingClosestCrafter()
{
	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsAlive( player ) )
		return

	if ( !IsPingEnabledForPlayer( player ) )
		return

	float closestDistInRing = FLT_MAX
	entity closestEntInRing = null
	float closestDist = FLT_MAX
	entity closestEnt = null
	foreach ( EndorsementCrafterClientEntity crafterEnt in file.craftersForHighlightTracking )
	{
		float dist = Distance2DSqr( player.GetOrigin(), crafterEnt.crafter.GetOrigin() )
		if ( dist < closestDist )
		{
			closestDist = dist
			closestEnt = crafterEnt.crafter
		}

		if ( dist < closestDistInRing && Cl_SURVIVAL_PosInsideRing( crafterEnt.crafter.GetOrigin() ) )
		{
			closestDistInRing = dist
			closestEntInRing = crafterEnt.crafter
		}
	}

	entity actualEnt
	if ( IsValid( closestEntInRing ) )
	{
		actualEnt = closestEntInRing
	}
	else
	{
		actualEnt = closestEnt
	}

	if ( IsValid( actualEnt ) )
	{
		Remote_ServerCallFunction( string( ClientToServer_Endorsements_Delivery_FullmapPing_PingCrafterFromMap ), actualEnt )
	}
}

void function Endorsements_Delivery_OnMapLegendCreated( var mapLegend )
{
	if ( mapLegend != null && Endorsements_AreEndorsementStationsEnabled() )
	{
		RuiSetString( mapLegend, "hintMidLeftText", "#ENDORSEMENTS_FULLMAP_PING_NEAREST_CRAFTER" )
	}
}


void function ServerToClient_Endorsements_Delivery_ReceivedTicket()
{

		if ( !GetCurrentPlaylistVarBool( "endorsements_delivery_received_ticket_announcement", true ) )
		{

			Endorsements_Delivery_RoundBased_SlotUnlocked( GetLocalViewPlayer() )


			return
		}

		
		CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
		mainBanner.mainText = Localize( "#ENDORSEMENTS_DELIVERY_ANNOUNCE_GOT_TICKET" )
		mainBanner.mainIcon1 = ENDORSEMENT_MAP_ICON
		CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
		mainBanner.imageContainerFrameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.frameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.leftIntensityTextureCount = 2
		mainBanner.rightIntensityTextureCount = 2

		
		AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner ] )
		builder.soundAliases = [ ENDORSEMENT_ANNOUNCEMENT_SOUND_ALIAS ]


		if ( Endorsements_Delivery_RoundBased_EnabledForMode() )
		{
			builder.onIntro = Endorsements_Delivery_RoundBased_AnnounceIntro_ShowPingNag
		}
		else

		{
			builder.onIntro = Endorsements_AnnounceIntro_ShowPingNag
		}

		builder.priority = eHudNotificationQueuePriority.MEDIUM

		builder.onPreIntro = bool function( HudNotificationQueueItem queueItem )
		{
			entity player = GetLocalViewPlayer()

			if ( !IsValid( player ) )
				return false

			return Endorsements_Delivery_GetPlayerTicketCount( player ) > 0
		}

		entity player = GetLocalClientPlayer()
		int ticketCount = Endorsements_Delivery_GetPlayerTicketCount( player )
		int endorsementCount = Endorsements_GetPlayerEndorsementCount( player )

		int commentaryBucket = Endorsements_AreEndorsementStationsEnabled() ? eSurvivalCommentaryBucket.ENDORSEMENTS_ACTIVATED : eSurvivalCommentaryBucket.ENDORSEMENTS_UNLOCKED
		if ( ticketCount + endorsementCount == Endorsements_GetMaxEndorsementCount() )
		{
			commentaryBucket = Endorsements_AreEndorsementStationsEnabled() ? eSurvivalCommentaryBucket.FINAL_ENDORSEMENTS_ACTIVATED : eSurvivalCommentaryBucket.FINAL_ENDORSEMENTS_UNLOCKED
		}
		builder.speakerDialogueLines.append( PickCommentaryLineFromBucket( commentaryBucket ) )

		CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.GLOBAL )



}

void function ServerToClient_Endorsements_Delivery_MidMatchCraftersIncoming()
{

		
		CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
		mainBanner.mainText = Localize( "#ENDORSEMENTS_DELIVERY_ANNOUNCE_MIDMATCH_CRAFTER_INCOMING" )
		mainBanner.mainIcon1 = ENDORSEMENT_MAP_ICON
		CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
		mainBanner.imageContainerFrameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.frameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.textureColor = ( UNHINGED_COLOR / 255 )
		mainBanner.leftIntensityTextureCount = 2
		mainBanner.rightIntensityTextureCount = 2

		
		CenterAnnouncementItem subBanner = CenterAnnouncements_CreateGradientStyle()
		subBanner.mainText = Localize( "#ENDORSEMENTS_VIEW_INVENTORY_PROMPT" )
		subBanner.mainTextIsUpper = false
		subBanner.scalar = 0.5
		subBanner.paddingTop = 10
		subBanner.leftEndPadding = 200
		subBanner.rightEndPadding = 200

		
		AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, subBanner ] )
		builder.soundAliases = [ ENDORSEMENT_ANNOUNCEMENT_SOUND_ALIAS ]
		builder.speakerDialogueLines.append( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.ENDORSEMENT_REPLICATOR_DROPPING ) )

		if ( MinimapAnnouncements_IsEnabled() && GetCurrentPlaylistVarBool( "secondary_announcement_location_midmatchcrafters", true ) )
		{
			MapAnnouncementItem mapAnnouncementItem
			mapAnnouncementItem.message = Localize( "#ENDORSEMENTS_DELIVERY_ANNOUNCE_MIDMATCH_CRAFTER_INCOMING" )
			mapAnnouncementItem.colorIn = < 255, 255, 255 > / 255.0
			mapAnnouncementItem.icon = $"rui/hud/small_announcements/icon_loot_reset"
			mapAnnouncementItem.iconShadow = $"rui/hud/small_announcements/icon_loot_reset_shadow"
			mapAnnouncementItem.priority = eHudNotificationQueuePriority.LOW
			mapAnnouncementItem.speakerDialogueLines = builder.speakerDialogueLines

			MinimapAnnouncement_QueueItem( mapAnnouncementItem )
		}
		else
		{
			CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.GLOBAL )
		}



}

void function ServerToClient_Endorsements_Delivery_MidMatchCraftersDropped()
{

		
		if ( Endorsements_GetPlayerEndorsementCount( GetLocalClientPlayer() ) >= Endorsements_GetMaxEndorsementCount() )
			return

		
		CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
		mainBanner.mainText = Localize( "#ENDORSEMENTS_DELIVERY_ANNOUNCE_MIDMATCH_CRAFTER_DROPPED_NAG" )
		mainBanner.mainIcon1 = ENDORSEMENT_MAP_ICON
		CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
		mainBanner.imageContainerFrameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.frameColor = ( UNHINGED_COLOR / 255 )
		mainBanner.leftIntensityTextureCount = 2
		mainBanner.rightIntensityTextureCount = 2

		
		AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner ] )
		builder.soundAliases = [ ENDORSEMENT_ANNOUNCEMENT_SOUND_ALIAS ]
		builder.onIntro = Endorsements_AnnounceIntro_ShowPingNag
		CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.GLOBAL )



}


void function Endorsements_AnnounceIntro_ShowPingNag( HudNotificationQueueItem queueItem )
{
	if ( Endorsements_AreEndorsementStationsEnabled() )
	{
		thread EndorsementCrafterNag_Thread()
	}
}

void function EndorsementCrafterNag_Thread()
{
	const float NAG_ANIM_LENGTH = 280/60
	const float NAG_ANIM_LINGER = 8.0
	const float NAG_AUTOHIDE_DELAY = 30.0

	AssertIsNewThread()

	Signal( clGlobal.signalDummy, ENDORSEMENT_CRAFTER_CLEAR_PING_NAG ) 
	EndSignal( clGlobal.signalDummy, ENDORSEMENT_CRAFTER_CLEAR_PING_NAG )

	file.endorsementsPingNagIsVisible = true

	var rui = CreateCockpitPostFXRui( $"ui/endorsement_ping_nag.rpak", HUD_Z_BASE )
	RuiSetFloat( rui, "animStartTime", Time() )

	OnThreadEnd( function() : ( rui )
	{
		RuiSetFloat( rui, "destroyAnimStartTime", Time() ) 
		file.endorsementsPingNagIsVisible = false
	})

	wait NAG_AUTOHIDE_DELAY
}

bool function Endorsements_IsPingNagVisible()
{
	return file.endorsementsPingNagIsVisible
}

void function Endorsements_PingClosestCrafterAndHidePingNag()
{
	Endorsements_Delivery_PingClosestCrafter()
	Signal( clGlobal.signalDummy, ENDORSEMENT_CRAFTER_CLEAR_PING_NAG )
}

void function Endorsements_HidePingNagWithoutPinging()
{
	Signal( clGlobal.signalDummy, ENDORSEMENT_CRAFTER_CLEAR_PING_NAG )
}

