void function Endorsements_Delivery_PlayCinematicCrafterDropin()
{






	
	foreach ( entity crafterEnt, EndorsementCrafterClientEntity crafter in file.craftersForHighlightTracking )
	{
		crafter.forceDisabled = true
		Endorsements_Delivery_UpdateCrafterLights( crafter )
	}

}

int function Endorsements_Delivery_GetPlayerTicketCount( entity player )
{
	if ( Endorsements_GetDeliveryType() != eEndorsementDeliveryType.GROUNDED_CRAFTERS )
	{
		Warning( "Endorsements_Delivery_GetPlayerTicketCount called on playlist not using grounded crafters delivery method" )
		return Endorsements_GetMaxEndorsementCount()
	}

	if ( Endorsements_IsPlayerLockedOutFromCrafter( player ) )
		return 0

	return player.GetPlayerNetInt( NETVAR_PLAYER_TICKETS )
}

bool function Endorsements_Delivery_PlayerCanUseCrafter( entity player, entity crafter )
{





	return Endorsements_Delivery_GetPlayerTicketCount( player ) != 0
			&& !IsValid( player.GetParent() ) 
			&& SURVIVAL_PlayerCanUse_AnimatedInteraction( player, crafter ) 
}

string function Endorsements_Delivery_GetPlayerCantUseCrafterReason( entity player, entity crafter )
{
	Assert( !Endorsements_Delivery_PlayerCanUseCrafter( player, crafter ) )

	if ( Endorsements_Delivery_GetPlayerTicketCount( player ) == 0 )
	{
		return "#ENDORSEMENTS_DELIVERY_CRAFTER_NO_TICKETS"
	}

	return ""
}

void function Endorsements_Delivery_InitCrafterUsability( entity crafter )
{






	SetCallback_ShouldUseBlockReloadCallback( crafter, SimpleShouldNotBlockReloadCallback )
	AddCallback_OnUseEntity_ClientServer( crafter, void function( entity crafter, entity player, int useInputFlags ) {
		if ( !IsBitFlagSet( useInputFlags, USE_INPUT_LONG ) )
			return

		if ( !Endorsements_Delivery_PlayerCanUseCrafter( player, crafter ) )
		{
			return
		}

		ExtendedUseSettings settings
		settings.duration = 0.3

			settings.loopSound = "UI_Survival_PickupTicker"
			settings.hint = "#PROMPT_OPEN"








		thread ExtendedUse( crafter, player, settings )
	} )

		AddEntityCallback_GetUseEntOverrideText( crafter, string function( entity crafter )
		{
			entity player = GetLocalViewPlayer()

			if ( !SURVIVAL_PlayerCanUse_AnimatedInteraction( player, crafter ) )
			{
				CustomUsePrompt_Hide()
				return ""
			}

			if ( PlayerIsInADS( player ) )
			{
				CustomUsePrompt_ShowSourcePos( false )
			}
			else
			{
				CustomUsePrompt_ShowSourcePos( true )
			}

			CustomUsePrompt_Show( crafter )
			CustomUsePrompt_SetSourcePos( crafter.GetOrigin() + < 0, 0, 62 > )

			CustomUsePrompt_SetLineColor( SrgbToLinear( UNHINGED_COLOR / 255.0 ) )

			if ( !Endorsements_Delivery_PlayerCanUseCrafter( player, crafter ) )
			{
				CustomUsePrompt_SetText( Localize( Endorsements_Delivery_GetPlayerCantUseCrafterReason( player, crafter ) ) )
			}
			else
			{
				bool hasMultipleTickets = Endorsements_Delivery_GetPlayerTicketCount( player ) > 1
				CustomUsePrompt_SetText( Localize( hasMultipleTickets ? "#ENDORSEMENTS_DELIVERY_CRAFTER_USE_PLURAL" : "#ENDORSEMENTS_DELIVERY_CRAFTER_USE" ) )
			}

			return ""
		})

}


void function Endorsements_Delivery_OnCrafterCreated( entity crafter )
{
	SetMapFeatureItem( 1011, Localize( "#ENDORSEMENTS_MAP_LEGEND" ), Localize( "#ENDORSEMENTS_MAP_LEGEND_DESC" ), ENDORSEMENT_CRAFTER_MINIMAP_ICON )

	int zoneID = crafter.GetTargetName().tointeger()
	if ( zoneID <= 0 )
		return

	if ( !(zoneID in file.zoneIDToCrafters) )
	{
		file.zoneIDToCrafters[zoneID] <- []
	}

	file.zoneIDToCrafters[zoneID].append( crafter )
}



array< entity > function Endorsements_Delivery_GetCraftersInZone( int zoneID )
{
	if ( !(zoneID in file.zoneIDToCrafters) )
		return []

	return clone file.zoneIDToCrafters[zoneID]
}


void function Endorsements_Delivery_SetCrafterModel( asset crafterModel )
{
	PrecacheModel( crafterModel )
	file.crafterModel = crafterModel
}

void function ClientToServer_Endorsements_Delivery_FullmapPing_PingCrafterFromMap( entity player, entity crafter )
{



	Assert( false, "Called on wrong VM" )

}


void function Endorsements_Delivery_TrackCrafterForHighlight( entity crafter )
{
	if ( crafter.GetScriptName() != ENDORSEMENT_CRAFTER_SCRIPTNAME )
		return

	EndorsementCrafterClientEntity crafterStruct
	crafterStruct.crafter = crafter

	file.craftersForHighlightTracking[ crafter ] <- crafterStruct

	Endorsements_Delivery_UpdateCrafterLights( crafterStruct )
}

void function Endorsements_Delivery_UntrackCrafterForHighlight( entity crafter )
{
	if ( crafter in file.craftersForHighlightTracking )
	{
		EndorsementCrafterClientEntity crafterStruct = file.craftersForHighlightTracking[ crafter ]
		if ( crafterStruct.beamFX != -1 )
		{
			EffectStop( crafterStruct.beamFX, true, true )
		}
		if ( crafterStruct.hologramFX != -1 )
		{
			EffectStop( crafterStruct.hologramFX, true, true )
		}

		delete file.craftersForHighlightTracking[ crafter ]
	}
}

const asset ENDORSEMENT_CRAFTER_MINIMAP_ICON = $"rui/hud/gametype_icons/survival/endorsement_map_icon"

