} file

void function Endorsements_Delivery_GroundedInit()
{
	
	PrecacheParticleSystem( $"P_lootpod_trail_smoke_linger_cheap" )
	PrecacheParticleSystem( $"P_lootpod_trail_fire_cheap" )

	PrecacheParticleSystem( ENDORSEMENT_CRAFTER_INCOMING_MARKER_FX )
	PrecacheParticleSystem( ENDORSEMENT_CRAFTER_INCOMING_BEAM_FX )
	PrecacheParticleSystem( ENDORSEMENT_CRAFTER_HOLOGRAM_FX )

	PrecacheScriptString( ENDORSEMENT_CRAFTER_SCRIPTNAME )

	RegisterNetworkedVariable( NETVAR_PLAYER_TICKETS, SNDC_PLAYER_GLOBAL, SNVT_INT, 1 )

		RegisterNetVarIntChangeCallback( NETVAR_PLAYER_TICKETS, Endorsements_NetVarChanged_PlayerTicketCount )

	Remote_RegisterClientFunction( string( ServerToClient_Endorsements_Delivery_ReceivedTicket ) )
	Remote_RegisterClientFunction( string( ServerToClient_Endorsements_Delivery_MidMatchCraftersIncoming ) )
	Remote_RegisterClientFunction( string( ServerToClient_Endorsements_Delivery_MidMatchCraftersDropped ) )

	Remote_RegisterServerFunction( string( ClientToServer_Endorsements_Delivery_FullmapPing_PingCrafterFromMap ), "typed_entity", "prop_script" )

	AddCallback_GameStateEnter( eGameState.Playing, Endorsements_Delivery_PlayCinematicCrafterDropin )

	Endorsements_Delivery_InitTuning()









		RegisterSignal( ENDORSEMENT_CRAFTER_CLEAR_PING_NAG )
		AddScriptNameCreateCallback( ENDORSEMENT_CRAFTER_SCRIPTNAME, Endorsements_Delivery_OnCrafterCreated )
		AddScriptNameCreateCallback( ENDORSEMENT_CRAFTER_SCRIPTNAME, Endorsements_Delivery_InitCrafterUsability )
		AddCreateCallback( "prop_script", Endorsements_Delivery_TrackCrafterForHighlight )
		AddDestroyCallback( "prop_script", Endorsements_Delivery_UntrackCrafterForHighlight )
		RegisterScriptAnimWindowCallbacks( "DisableEndorsementCrafterFX", Endorsements_Delivery_ForceDisableFX, Endorsements_Delivery_EndForceDisableFX )
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.ENDORSEMENT_CRAFTER, MINIMAP_OBJECT_RUI, MinimapPackage_EndorsementCrafter, PERK_FULL_MINIMAP_OBJECT, FullmapPackage_EndorsementCrafter )
		AddCallback_OnFindFullMapAimEntity( Endorsements_Delivery_FullmapPing_GetUnderAim, Endorsements_Delivery_FullmapPing_PingUnderAim )
		Fullmap_AddCallback_OnMapLegendCreated( Endorsements_Delivery_OnMapLegendCreated )


	if ( file.crafterModel == $"" )
	{
		Endorsements_Delivery_SetCrafterModel( ENDORSEMENT_CRAFTER_MODEL )
	}
}

