void function _____________ENDORSEMENT_STATION_UI_SKIN___________________________(){}
#endif


void function Endorsements_ApplyCraftingStationUISkin()
{
	if ( file.craftingMenuRUI == null || !RuiIsAlive( file.craftingMenuRUI ) )
		return

	EndorsementCrafterUISkin crafterSkin = Endorsements_GetCraftingStationUISkin()

	
	RGBA primaryThemeColor 				= RGBAToLinear( crafterSkin.primaryThemeColor )
	RGBA backgroundColor 				= RGBAToLinear( crafterSkin.backgroundColor )
	RGBA backgroundTextureColor 		= RGBAToLinear( crafterSkin.backgroundTextureColor )
	RGBA decal1Color 					= RGBAToLinear( crafterSkin.decal1Color )
	RGBA decal2Color 					= RGBAToLinear( crafterSkin.decal2Color )
	RGBA decal3Color 					= RGBAToLinear( crafterSkin.decal3Color )
	RGBA itemBackgroundTextureColor 	= RGBAToLinear( crafterSkin.itemBackgroundTextureColor )
	RGBA itemFrameColor 				= RGBAToLinear( crafterSkin.itemFrameColor )


	RuiSetRGBA( file.craftingMenuRUI, "primaryColor",primaryThemeColor )
	RuiSetRGBA( file.craftingMenuRUI, "backgroundColor", backgroundColor )

	RuiSetAsset( file.craftingMenuRUI, "backgroundTexture", crafterSkin.backgroundTexture )
	RuiSetFloat( file.craftingMenuRUI, "backgroundTextureTileCount", crafterSkin.backgroundTextureTileCount )
	RuiSetRGBA( file.craftingMenuRUI, "backgroundTextureColor", backgroundTextureColor )

	RuiSetBool( file.craftingMenuRUI, "scanlinesEnabled", crafterSkin.scanlinesEnabled )

	if ( crafterSkin.decal1 != $"" )
	{
		RuiSetAsset( file.craftingMenuRUI, "decal1", crafterSkin.decal1 )
		RuiSetFloat2( file.craftingMenuRUI, "decal1Size", crafterSkin.decal1Size )
		RuiSetFloat2( file.craftingMenuRUI, "decal1SelfPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal1Pin.selfPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal1SiblingPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal1Pin.siblingPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal1PinOffset", crafterSkin.decal1Pin.pinOffset )
		RuiSetRGBA( file.craftingMenuRUI, "decal1Color", decal1Color )
	}

	if ( crafterSkin.decal2 != $"" )
	{
		RuiSetAsset( file.craftingMenuRUI, "decal2", crafterSkin.decal2 )
		RuiSetFloat2( file.craftingMenuRUI, "decal2Size", crafterSkin.decal2Size )
		RuiSetFloat2( file.craftingMenuRUI, "decal2SelfPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal2Pin.selfPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal2SiblingPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal2Pin.siblingPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal2PinOffset", crafterSkin.decal2Pin.pinOffset )
		RuiSetRGBA( file.craftingMenuRUI, "decal2Color", decal2Color )
	}

	if ( crafterSkin.decal3 != $"" )
	{
		RuiSetAsset( file.craftingMenuRUI, "decal3", crafterSkin.decal3 )
		RuiSetFloat2( file.craftingMenuRUI, "decal3Size", crafterSkin.decal3Size )
		RuiSetFloat2( file.craftingMenuRUI, "decal3SelfPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal3Pin.selfPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal3SiblingPinCorner", Hud_GetPinCoordinatesForCorner( crafterSkin.decal3Pin.siblingPinCorner ) )
		RuiSetFloat2( file.craftingMenuRUI, "decal3PinOffset", crafterSkin.decal3Pin.pinOffset )
		RuiSetRGBA( file.craftingMenuRUI, "decal3Color", decal3Color )
	}

	RuiSetAsset( file.craftingMenuRUI, "itemBackgroundTexture", crafterSkin.itemBackgroundTexture )
	RuiSetRGBA( file.craftingMenuRUI, "itemBackgroundTextureColor", itemBackgroundTextureColor )
	RuiSetAsset( file.craftingMenuRUI, "itemBackgroundMask", crafterSkin.itemBackgroundMask )

	RuiSetAsset( file.craftingMenuRUI, "itemFrameImage", crafterSkin.itemFrameImage )
	RuiSetRGBA( file.craftingMenuRUI, "itemFrameColor", itemFrameColor )


		if ( GamemodeVariant_UH_ClockUp_IsClockUpEnabled() )
		{
			RuiSetString( file.craftingMenuRUI, "stationTitle", "#ENDORSEMENT_CLOCKUP_STATION_TITLE" )
			RuiSetString( file.craftingMenuRUI, "stationSubtitle", "#ENDORSEMENT_CLOCKUP_STATION_SUBTITLE" )
		}

}


#if DEV
void function DEV_SetEndorsementCrafterUISkin( int skinIndex )
{
	if ( skinIndex <= 0 )
	{
		Endorsements_SetDefaultCraftingStationUISkin()
	}

	else if ( skinIndex == 1 )
	{
		Beamstick_SetupEndorsementCrafterUISkin()
	}

}
#endif


void function ServerToClient_Endorsements_Skydive_Announcement()
{

	string preSkydivePrompt = "#ENDORSEMENTS_PRE_SKYDIVE_PROMPT" 







	
	CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
	mainBanner.mainText = Localize( preSkydivePrompt )
	mainBanner.mainIcon1 = $"rui/hud/gametype_icons/survival/endorsement_map_icon"
	CenterAnnouncements_ImageContainer_SetNotchedStyle( mainBanner )
	mainBanner.imageContainerFrameColor = ( UNHINGED_COLOR / 255 )
	mainBanner.frameColor = ( UNHINGED_COLOR / 255 )
	mainBanner.textureColor = ( UNHINGED_COLOR / 255 )
	mainBanner.leftIntensityTextureCount = 2
	mainBanner.rightIntensityTextureCount = 2
	mainBanner.backgroundAlpha = 0.6

	
	CenterAnnouncementItem subBanner = CenterAnnouncements_CreateGradientStyle()
	subBanner.mainText = Localize( "#ENDORSEMENTS_VIEW_INVENTORY_PROMPT" )
	subBanner.mainTextIsUpper = false
	subBanner.scalar = 0.5
	subBanner.paddingTop = 10
	subBanner.leftEndPadding = 200
	subBanner.rightEndPadding = 200
	subBanner.backgroundAlpha = 0.6

	
	AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, subBanner ] )
	builder.soundAliases.clear()
	builder.soundAliases.append( ENDORSEMENT_ANNOUNCEMENT_SOUND_ALIAS )
	CenterAnnouncements_QueueBuilder( builder, ePersistenceContext.PLAYER )

}
