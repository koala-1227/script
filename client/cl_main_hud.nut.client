void function CinematicEventUpdateDoF( entity player )
{
	if ( player != GetLocalClientPlayer() )
		return

	if ( ShouldHaveFarDoF( player ) )
	{
		
		if ( !file.trackingDoF )
			thread TrackDoF( player )
	}
	else
	{
		player.Signal( "ClearDoF" )
		
	}
}


void function TrackDoF( entity player )
{
	file.trackingDoF = true
	player.EndSignal( "OnDeath" )
	player.EndSignal( "ClearDoF" )

	OnThreadEnd(
		function() : ()
		{
			file.trackingDoF = false
			DoF_LerpNearDepthToDefault( 1.0 )
			DoF_LerpFarDepthToDefault( 1.0 )
		}
	)

	float tick = 0.25

	while ( true )
	{
		float playerDist    = Distance( player.CameraPosition(), player.GetOrigin() )
		float distToCamNear = playerDist
		float distToCamFar  = distToCamNear




			entity target = null


		if ( !IsValid( target ) && player.GetObserverMode() == OBS_MODE_CHASE )
		{
			target = player.GetObserverTarget()
		}

		if ( !IsValid( target ) && player.ContextAction_IsMeleeExecution() )
		{
			if( player.ContextAction_IsMeleeExecutionAttacker() )
			{
				target = player
			}
			else
			{
				entity targetParent = player.GetParent()
				if ( IsValid( targetParent ) )
					target = targetParent
			}
		}

		if ( IsValid( target ) && ( target != player || player.ContextAction_IsMeleeExecution() ) )
		{
			float targetDist = Distance( player.CameraPosition(), target.EyePosition() )
			distToCamFar  = max( playerDist, targetDist )
			distToCamNear = min( playerDist, targetDist )
		}

		float farDepthScalerA = 1
		float farDepthScalerB = 3

		if ( IsValid( target ) )
		{
			farDepthScalerA = 2
			farDepthScalerB = 10
		}

		float nearDepthStart = 0
		float nearDepthEnd   = clamp( min( 50, distToCamNear - 100 ), 0, 50 )
		DoF_LerpNearDepth( nearDepthStart, nearDepthEnd, tick )
		float farDepthStart = distToCamFar + distToCamFar * farDepthScalerA
		float farDepthEnd   = distToCamFar + distToCamFar * farDepthScalerB
		DoF_LerpFarDepth( farDepthStart, farDepthEnd, tick )

		wait tick
	}
}


bool function ShouldHaveFarDoF( entity player )
{
	int ceFlags = player.GetCinematicEventFlags()

	if ( IsBitFlagSet( ceFlags, CE_FLAG_EMBARK ) )
		return true

	if ( IsBitFlagSet( ceFlags, CE_FLAG_EXECUTION ) )
		return true

	return false
}



bool function ShouldScriptHideHudInKillreplay()
{
	return GetCurrentPlaylistVarBool( "killreplay_hide_hud", false )
}

bool function ShouldHideHudForDeadPlayer( entity player )
{
	if ( IsAlive( player ) )
		return false

	entity localPlayer = GetLocalClientPlayer()
	if ( localPlayer.GetTeam() == TEAM_SPECTATOR )
		return false

	if ( !localPlayer.IsObserver() )
		return true

	entity obsTarget = localPlayer.GetObserverTarget()
	if ( obsTarget == localPlayer )
		return true

	if ( IsWatchingKillReplay() )
	{
		if ( ShouldScriptHideHudInKillreplay() )
			return false
	}
	else
	{
		if ( obsTarget == null && !IsObserverModeValidWithoutObserverTarget( localPlayer ) )
			return true
	}

	
	return false
}


bool function ShouldMainHudBeVisible( entity player )
{
	int ceFlags = player.GetCinematicEventFlags()

	if ( IsWatchingKillReplay() && ShouldScriptHideHudInKillreplay() )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_EMBARK ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_DISEMBARK ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_INTRO ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_CLASSIC_MP_SPAWNING ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_HIDE_MAIN_HUD ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_HIDE_MAIN_HUD_INSTANT ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_EOG_STAT_DISPLAY ) )
		return false

	if ( IsBitFlagSet( ceFlags, CE_FLAG_TITAN_3P_CAM ) && !IsSpectating() )
		return false

	if ( clGlobal.isSoloDialogMenuOpen )
		return false

	entity viewEntity = GetViewEntity()
	if ( IsValid( viewEntity ) && viewEntity.IsNPC() )
		return false

	if ( ShouldHideHudForDeadPlayer( player ) )
		return false

	if ( IsViewingSquadSummary() || IsViewingDeathRecap() )
		return false

	if ( Scoreboard_IsVisible() )
		return false

	int gameState = GetGameState()
	switch( gameState )
	{
		case eGameState.WaitingForCustomStart:
		case eGameState.WaitingForPlayers:
			break






		case eGameState.PickLoadout:
			return false

		case eGameState.Prematch:
			if ( !GetCurrentPlaylistVarBool( "show_hud_in_prematch", false ) )
				return false
			else
				break

		case eGameState.Playing:
		case eGameState.SuddenDeath:
		case eGameState.SwitchingSides:
		case eGameState.Epilogue:
			break

		case eGameState.WinnerDetermined:
		case eGameState.Resolution:
		case eGameState.Postmatch:
			return IsWatchingKillReplay() && IsReplayRoundWinning() && !ShouldScriptHideHudInKillreplay()
			return false
	}

#if DEV
		if ( IsModelViewerActive() )
			return false
#if !HEADLESS_PROG
		if ( OutsourceViewer_IsActive() )
			return false
#endif
#endif

	return true
}


HudVisibilityStatus function GetHudStatus( entity player )
{
	bool showMainHud      = ShouldMainHudBeVisible( player )
	bool showPermanentHud = ShouldPermanentHudBeVisible( player )

	HudVisibilityStatus hudStatus
	hudStatus.mainHud       = showMainHud
	hudStatus.targetInfoHud = showPermanentHud
	hudStatus.permanentHud  = showPermanentHud

	return hudStatus
}


void function DEV_DebugHudStatusThread()
{
	RegisterSignal( "DEV_DebugHudStatusThread" )
	Signal( clGlobal.signalDummy, "DEV_DebugHudStatusThread" )
	EndSignal( clGlobal.signalDummy, "DEV_DebugHudStatusThread" )

	while ( true )
	{
		HudVisibilityStatus hudStatus = GetHudStatus( GetLocalViewPlayer() )

		DebugDrawScreenText( 0.90, 0.5, format( "mainHud: %s", hudStatus.mainHud ? "ON" : "OFF" ) )
		DebugDrawScreenText( 0.90, 0.512, format( "permanentHud: %s", hudStatus.permanentHud ? "ON" : "OFF" ) )

		WaitFrame()
	}
}

#if DEV
bool function DEV_GetPermanentHudVisibility()
{
	return !file.devHidePermanentHud
}

void function DEV_ShowPermanentHud()
{
	entity player = GetLocalViewPlayer()
	if ( IsValidPlayer( player ) )
	{
		file.devHidePermanentHud = false
		UpdateMainHudVisibility( player )
	}
}

void function DEV_HidePermanentHud()
{
	entity player = GetLocalViewPlayer()
	if ( IsValidPlayer( player ) )
	{
		file.devHidePermanentHud = true
		UpdateMainHudVisibility( player )
	}
}
#endif


bool function ShouldPermanentHudBeVisible( entity player )
{
	if ( IsViewingSquadSummary() || IsViewingDeathRecap() )
		return false

	if ( IsWatchingKillReplay() && ShouldScriptHideHudInKillreplay() )
		return false

	
	int gameState = GetGameState()
	switch( gameState )
	{
		case eGameState.WaitingForCustomStart:
		case eGameState.WaitingForPlayers:
			break






		case eGameState.PickLoadout:
			return false

		case eGameState.Prematch:
			if ( !GetCurrentPlaylistVarBool( "show_hud_in_prematch", false ) )
				return false
			else
				break

		case eGameState.Playing:
		case eGameState.SuddenDeath:
		case eGameState.SwitchingSides:
		case eGameState.Epilogue:
			break

		case eGameState.WinnerDetermined:
		case eGameState.Resolution:
		case eGameState.Postmatch:
			return IsWatchingKillReplay() && IsReplayRoundWinning() && !ShouldScriptHideHudInKillreplay()
	}

	if ( Scoreboard_IsVisible() )
		return false

	{
		int ceFlags = player.GetCinematicEventFlags()

		
		if ( IsBitFlagSet( ceFlags, CE_FLAG_TITAN_3P_CAM ) && !IsSpectating() )
			return false

		if ( IsBitFlagSet( ceFlags, CE_FLAG_HIDE_PERMANENT_HUD ) )
			return false
	}

	bool inGameModeThatHidesPermanentHUD = !GameMode_IsActive( eGameModes.CONTROL )





	if ( inGameModeThatHidesPermanentHUD && ShouldHideHudForDeadPlayer( player ) )
		return false

#if DEV
		if ( IsModelViewerActive() )
			return false
#if !HEADLESS_PROG
		if ( OutsourceViewer_IsActive() )
			return false
#endif
		if ( file.devHidePermanentHud )
			return false
#endif

	return true
}


bool function IsObserverModeValidWithoutObserverTarget( entity player )
{
	switch( player.GetObserverMode() )
	{
		case OBS_MODE_STATIC:
		case OBS_MODE_STATIC_LOCKED:
			return true
	}

	return false
}


void function InitChatHUD()
{
	UpdateChatHUDVisibility()

	if ( IsLobby() )
		return

	UISize screenSize   = GetScreenSize()
	float resMultiplier = screenSize.height / 1080.0
	int width           = 630
	int height          = 200

	var chat = HudElement( "IngameTextChat" )
	Hud_SetSize( chat, width * resMultiplier, height * resMultiplier )

	file.hasInitChatHud = true

	
	if ( Hud_GetY( chat ) != file.chatVerticalOffset )
		SetChatHUDPosition( file.chatVerticalOffset )
}


void function UpdateChatHUDVisibility()
{
	var chat = HudElement( "IngameTextChat" )

	Hud_SetAboveBlur( chat, true )

	if ( IsLobby() || clGlobal.isMenuOpen )
		Hud_Hide( chat )
	else
		Hud_Show( chat )

	var hint = HudElement( "AccessibilityHint" )

	int gamestate = GetGameState()

	if ( IsLobby() || clGlobal.isMenuOpen || !IsAccessibilityChatHintEnabled() || GetPlayerArrayOfTeam( GetLocalClientPlayer().GetTeam() ).len() < 2 || VoiceIsRestricted() || gamestate == eGameState.PickLoadout )
		Hud_Hide( hint )
	else
		Hud_Show( hint )
}

void function SetChatHUDPosition( int yPosition )
{
	if ( IsLobby() || clGlobal.isMenuOpen )
		return

	file.chatVerticalOffset = yPosition
    UpdateChatHUDPosition()
}


bool function IsWatchingReplay()
{
	if ( IsWatchingKillReplay() )
		return true

	if ( IsWatchingSpecReplay() )
		return true

	return false
}


void function HideAllHudExceptMinimap()
{
	file.onlyShowOption = eHudOnlyShowOption.HUD_ONLY_SHOW_MINIMAP

	SetOnlyShowOption_Internal( true, false, false, false )
}

void function HideAllHudExceptKillfeed()
{
	file.onlyShowOption = eHudOnlyShowOption.HUD_ONLY_SHOW_KILLFEED

	SetOnlyShowOption_Internal( false, true, false, false )
}

void function UnhideAllHud()
{
	file.onlyShowOption = eHudOnlyShowOption.HUD_ONLY_SHOW_DISABLED

	SetOnlyShowOption_Internal( true, true, true, true )
}

void function SetOnlyShowOption_Internal( bool showMinimap, bool showObituary, bool showPermanentHuds, bool showConsumableProgress )
{
	HUD_TogglePermanentHudsVisibility( showPermanentHuds )

	Obituary_SetEnabled( showObituary )
	if ( !showObituary )
	{
		Obituary_ClearObituary()
	}

	if ( showMinimap && file.minimapHiddenByOnlyShowOption )
	{
		Minimap_ForceEnableDraw()
	}
	else if ( !showMinimap && !file.minimapHiddenByOnlyShowOption )
	{
		Minimap_ForceDisableDraw()
	}

	if ( !showConsumableProgress )
	{
		Consumable_DisableDraw()
	}
	else
	{
		Consumable_EnableDraw()
	}
	file.minimapHiddenByOnlyShowOption = !showMinimap
}

