void function ServerCallback_SetTacticalHudVis( bool toggle )
{
	
	if ( !IsEventFinale() )
		return

	RuiSetBool( GetTacticalRui(), "isVisible", toggle )
}

void function ServerCallback_SetUltimateHudVis( bool toggle )
{
	
	if ( !IsEventFinale() )
		return

	RuiSetBool( GetUltimateRui(), "isVisible", toggle )
}

void function ServerCallback_SetDpadMenuVis( int flags )
{
	
	if ( !IsEventFinale() )
		return

	RuiSetBool( GetDpadMenuRui(), "isVisible", (flags != 0) ) 
	RuiSetBool( GetDpadMenuRui(), "healthUIEnabled", IsBitFlagSet(flags,1) ) 
	RuiSetBool( GetDpadMenuRui(), "ordinanceUIEnabled", IsBitFlagSet(flags, 2) ) 
	RuiSetBool( GetDpadMenuRui(), "gadgetUIEnabled", IsBitFlagSet(flags, 4) ) 
}


void function SetHudOverrides( HudOverrideSettings ornull settings )
{
	if ( settings == null )
	{
		HudOverrideSettings defaultSettings
		settings = defaultSettings
	}

	expect HudOverrideSettings( settings )

	
	var pilotRui = GetPilotRui()
	if ( pilotRui != null )
	{
		bool pilotVis = ResolveVisibility( settings.pilotVisible, settings.isVisible )
		RuiSetBool( pilotRui, "isVisible", pilotVis  )
	}

	
	bool unitFramesVis = ResolveVisibility( settings.unitFramesVisible, settings.isVisible )
	foreach ( unitFrame in GetTeamUnitFrames() )
	{
		if ( unitFrame.rui != null )
		{
			RuiSetBool( unitFrame.rui, "isVisible", unitFramesVis )
		}
	}

	
	var weaponRui = GetWeaponRui()
	if ( weaponRui != null )
	{
		bool weaponVis = ResolveVisibility( settings.weaponVisible, settings.isVisible ) && settings.weapon
		RuiSetBool( weaponRui, "isVisible", weaponVis )
	}

	
	var dpadMenuRui = GetDpadMenuRui()
	if ( dpadMenuRui != null )
	{
		bool dpadVis = ResolveVisibility( settings.dpadMenuVisible, settings.isVisible )
		RuiSetBool( dpadMenuRui, "ordinanceUIEnabled", settings.dpadMenu )
		RuiSetBool( dpadMenuRui, "showButtonHints", settings.showButtonHints )
		RuiSetFloat( dpadMenuRui, "ordnanceAlphaOverride", settings.ordnanceAlphaOverride )
		RuiSetFloat( dpadMenuRui, "gadgetAlphaOverride", settings.gadgetAlphaOverride )
		RuiSetFloat( dpadMenuRui, "gadgetHintAlpha", settings.gadgetHintAlpha )
		RuiSetFloat( dpadMenuRui, "healthUIAlphaOverride", settings.healthUIAlphaOverride )
		RuiSetBool( dpadMenuRui, "isVisible", dpadVis )
	}

	
	var customGadgetRui = GetCustomGadgetRui()
	if ( customGadgetRui != null )
	{
		bool gadgetVis = ResolveVisibility( settings.customGadgetVisible, settings.isVisible ) && settings.dpadMenu
		RuiSetBoolIfExists( customGadgetRui, "isVisible", gadgetVis )
		RuiSetFloatIfExists( customGadgetRui, "gadgetAlphaOverride", settings.gadgetAlphaOverride )
		RuiSetFloatIfExists( customGadgetRui, "gadgetHintAlpha", settings.gadgetHintAlpha )
	}

	
	var tacticalRui = GetTacticalRui()
	if ( tacticalRui != null )
	{
		bool tacVis = ResolveVisibility( settings.tacticalVisible, settings.isVisible )
		RuiSetFloat( tacticalRui, "tacticalAlphaOverride", settings.alphaOverride )
		RuiSetBool( tacticalRui, "isVisible", tacVis )
	}

	
	var ultimateRui = GetUltimateRui()
	if ( ultimateRui != null )
	{
		bool ultVis = ResolveVisibility( settings.ultimateVisible, settings.isVisible )
		RuiSetFloat( ultimateRui, "ultimateAlphaOverride", settings.alphaOverride )
		RuiSetBool( ultimateRui, "isVisible", ultVis )
	}

	
	var slingPassiveRui = GetSlingPassiveRui()
	if ( slingPassiveRui != null )
	{
		bool slingVis = ResolveVisibility( settings.slingPassiveVisible, settings.isVisible ) && settings.slingPassive
		RuiSetBool( slingPassiveRui, "isVisible", slingVis )
	}

	
	var cryptoTacRui = GetCryptoAnimatedTacticalRui()
	if ( cryptoTacRui != null )
	{
		bool cryptoVis = ResolveVisibility( settings.cryptoTacVisible, settings.isVisible )
		RuiSetFloat( cryptoTacRui, "alphaOverride", settings.alphaOverride )
		RuiSetBool( cryptoTacRui, "shouldCollapse", settings.shouldCollapseTac )
		RuiSetBool( cryptoTacRui, "showButtonHints", settings.showButtonHints )
		RuiSetBool( cryptoTacRui, "isVisible", cryptoVis )
	}

	
	var vantageTacRui = GetVantageTacticalRui()
	if ( vantageTacRui != null )
	{
		bool vantageVis = ResolveVisibility( settings.vantageTacVisible, settings.isVisible )
		RuiSetFloat( vantageTacRui, "alphaOverride", settings.alphaOverride )
		RuiSetBool( vantageTacRui, "shouldCollapse", settings.shouldCollapseTac )
		RuiSetBool( vantageTacRui, "showButtonHints", settings.showButtonHints )
		RuiSetBool( vantageTacRui, "isVisible", vantageVis )
	}

	
	var octaneTacRui = GetOctaneStimSurgeTacticalRui()
	if ( octaneTacRui != null )
	{
		bool octaneVis = ResolveVisibility( settings.octaneTacVisible, settings.isVisible )
		RuiSetFloat( octaneTacRui, "alphaOverride", settings.alphaOverride )
		RuiSetBool( octaneTacRui, "shouldCollapse", settings.shouldCollapseTac )
		RuiSetBool( octaneTacRui, "showButtonHints", settings.showButtonHints )
		RuiSetBool( octaneTacRui, "isVisible", octaneVis )
	}


	
	if ( EvoWeapons_IsEnabled() )
	{
		var evoWeaponXpMeter = EvoWeapons_GetHudEvoWeaponXPMeter()
		if ( evoWeaponXpMeter != null )
		{
			bool canShowEvoWeaponXpMeter = EvoWeapons_CanShowEvoWeaponXPMeter()
			bool evoVis = ResolveVisibility( settings.evoWeaponXpMeterVisible, settings.isVisible )
			RuiSetFloat( evoWeaponXpMeter, "alphaMultiplier", settings.evoWeaponXpMeterAlphaOverride )
			RuiSetBoolIfExists( evoWeaponXpMeter, "shouldDisplayExpUI", evoVis && canShowEvoWeaponXpMeter )
		}
	}


	
	var compassRui = GetCompassRui()
	if ( compassRui != null )
	{
		bool compassVis = ResolveVisibility( settings.compassVisible, settings.isVisible )
		RuiSetBool( compassRui, "isVisible", compassVis )
	}

	
	bool minimapVis = ResolveVisibility( settings.minimapVisible, settings.isVisible )

	var minimapFrameRui = GetMinimapFrameRui()
	if ( minimapFrameRui != null )
	{
		RuiSetBool( minimapFrameRui, "isVisible", minimapVis )
	}

	var minimapYouRui = GetMinimapYouRui()
	if ( minimapYouRui != null )
	{
		RuiSetBool( minimapYouRui, "isVisible", minimapVis )
	}

	var minimapCoordsRui = GetMinimapCoordsRui()
	if ( minimapCoordsRui != null )
	{
		RuiSetBool( minimapCoordsRui, "isVisible", minimapVis )
	}

	var minimapBaseRui = GetMinimapBaseRui()
	if ( minimapBaseRui != null )
	{
		RuiSetBool( minimapBaseRui, "isVisible", minimapVis )
	}

	var netGraphRui = CLGameState_GetNetGraphRui()
	bool netgraphVis = ResolveVisibility( settings.netgrpahVisible, settings.isVisible )
	if (netGraphRui != null)
	{
		RuiSetBool( netGraphRui , "isVisible", netgraphVis )
	}

	
	HudTheming_Reapply()
}

bool function ResolveVisibility( bool ornull override, bool defaultValue )
{
	if ( override != null )
		return expect bool( override )
	return defaultValue
}

void function UpdateChatHUDPosition()
{
	if ( !file.hasInitChatHud )
		return

    int yPosition = file.chatVerticalOffset

#if SUPPORTS_COMPACT_UI
        if ( IsUsingCompactUILayout() )
            yPosition = file.chatVerticalOffsetCompactUi
#endif

    var chat = HudElement( "IngameTextChat" )
    float yScale = float( GetScreenSize().height ) / 1080.0
    Hud_SetY( chat, yPosition * yScale )
}

#if SUPPORTS_COMPACT_UI
void function SetChatHUDPositionCompactUi( int yPosition )
{
	if ( IsLobby() || clGlobal.isMenuOpen )
		return

	file.chatVerticalOffsetCompactUi = yPosition
    UpdateChatHUDPosition()
}
#endif
