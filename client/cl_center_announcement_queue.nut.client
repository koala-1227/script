		["rightIconSize"] 		= HudNotificationQueue_CreateRuiArg( "rightIconSize", announcement.rightIconSize, eRuiArgType.FLOAT2 ),


		
		["announcementHeight"] 	= HudNotificationQueue_CreateRuiArg( "announcementHeight", announcement.announcementHeight ),
		["leftEndPadding"] 		= HudNotificationQueue_CreateRuiArg( "leftEndPadding", announcement.leftEndPadding ),
		["rightEndPadding"] 	= HudNotificationQueue_CreateRuiArg( "rightEndPadding", announcement.rightEndPadding ),
		["horizontalImagePadding"] = HudNotificationQueue_CreateRuiArg( "horizontalImagePadding", announcement.horizontalImagePadding ),
		["contentVerticalPaddingTop"] = HudNotificationQueue_CreateRuiArg( "contentVerticalPaddingTop", announcement.contentVerticalPaddingTop ),
		["contentVerticalPaddingBottom"] = HudNotificationQueue_CreateRuiArg( "contentVerticalPaddingBottom", announcement.contentVerticalPaddingBottom ),


		
		["leftEndMask"] 		= HudNotificationQueue_CreateRuiArg( "leftEndMask", announcement.leftEndMask ),
		["leftEndMaskSize"] 	= HudNotificationQueue_CreateRuiArg( "leftEndMaskSize", announcement.leftEndMaskSize, eRuiArgType.FLOAT2 ),
		["leftEndMaskFlip"] 	= HudNotificationQueue_CreateRuiArg( "leftEndMaskFlip", announcement.leftEndMaskFlip ),

