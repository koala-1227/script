global struct AnnouncementBuilder
{
	
	string 		id = ""

	int persistenceContext = ePersistenceContext.INVALID

	asset		ruiAsset = $""
	vector		ruiSize = <0, 0, 0>	

	vector		offset = <0, 0, 0>		

	float 		duration = DEFAULT_ANNOUNCEMENT_DURATION
	float		outroDuration = DEFAULT_ANNOUNCEMENT_OUTRO_DURATION
	array< string >	soundAliases = [ SFX_CENTER_ANNOUNCEMENT_STANDARD ]
	array< string > speakerDialogueLines = []

	float		stuckInQueueTimeOutDuration = 30.0

	
	bool functionref( HudNotificationQueueItem ) onPreIntro
	var functionref( HudNotificationQueueItem ) onCreateVisualOverride
	void functionref( HudNotificationQueueItem ) onIntro
	bool functionref( HudNotificationQueueItem ) onPreOutro
	void functionref( HudNotificationQueueItem ) onDestroyVisualOverride
	void functionref( HudNotificationQueueItem ) onComplete
	void functionref( bool, HudNotificationQueueItem, HudNotificationQueueItem ornull ) onUpdateOverride

	





	array< CenterAnnouncementItem > announcementItems

	
	int 		uiDrawStage	= eUIDrawStage.POSTEFFECTS
	int 		priority = eHudNotificationQueuePriority.LOW
	bool		drawOverScreenFade = false
	bool		allowIndirectUpdates = false
}

struct {
	int queueId = -1
} file

void function CLCenterAnnouncements_Init()
{
	file.queueId = HudNotificationQueue_CreateAndRegisterQueue( CENTER_ANNOUNCEMENT_QUEUE_KEY )

	HudNotificationQueueConfiguration configSettings = HudNotificationQueue_GetConfigure( file.queueId )
	configSettings.maxVisibleItems = 1
	configSettings.itemAnchorPin = <0.5, 0.0, 0>
	configSettings.screenSpacePin = <0.5, 0.0, 0.0>
	configSettings.startPosition = DEFAULT_ANNOUNCEMENT_SCREEN_POS
	configSettings.itemPositioningEnabled = false
	configSettings.backlogPreservationStyle = eHudNotificationQueueBacklogPreservationStyle.PRIORITY
	configSettings.backlogMaxCountWhenBlocked = 3

	
	
	configSettings.allowDuplicates = true

	HudNotificationQueue_Configure( file.queueId, configSettings )

	AddCallback_MenuStateChanged( CenterAnnouncements_ActiveMenuChanged )
	AddCallback_FakeMenuStateChanged( CenterAnnouncements_ActiveFakeMenuChanged )

	
	DONOTUSE_HudNotificationQueue_AllowClearItemsOnQueue( file.queueId )
}














AnnouncementBuilder function CenterAnnouncements_CreateBuilder()
{
	AnnouncementBuilder builder
	builder.ruiAsset = $"ui/modular_announcement.rpak"
	builder.ruiSize = <0, 0, 0>	
	return builder
}

AnnouncementBuilder function CenterAnnouncements_CreateBuilderFromAnnouncementItems( array< CenterAnnouncementItem > announcementItems )
{
	AnnouncementBuilder builder = CenterAnnouncements_CreateBuilder()
	builder.announcementItems = announcementItems
	return builder
}


HudNotificationQueueItem function CenterAnnouncements_QueueItem( CenterAnnouncementItem announcement, int persistenceContext )
{
	HudNotificationQueueItem queueItem

	
	if ( announcement.bannerRuiAsset == $"" && !announcement.isDeprecatedStyle )
	{
		queueItem.isValid = false
		return queueItem
	}

	queueItem.ruiAsset = announcement.bannerRuiAsset
	queueItem.size = announcement.ruiSize == <0, 0, 0> ? CenterAnnouncements_AutoCalculateRuiSizeWithImageContainer( announcement ) : announcement.ruiSize
	queueItem.duration = announcement.duration
	queueItem.outroDuration = announcement.outroDuration
	queueItem.soundAliases = announcement.soundAliases
	queueItem.speakerDialogueLines = announcement.speakerDialogueLines
	queueItem.priority = announcement.priority
	queueItem.uiDrawStage = announcement.uiDrawStage
	queueItem.stuckInQueueTimeOutDuration = announcement.stuckInQueueTimeOutDuration
	queueItem.drawOverScreenFade = announcement.drawOverScreenFade
	queueItem.allowIndirectUpdates = announcement.allowIndirectUpdates

	queueItem.ruiArgs = CenterAnnouncements_GenerateRuiArgsTableFromAnnouncementItem( announcement )

	queueItem.onPreIntro.append( CenterAnnouncements_OnPreIntro )

	if ( announcement.onPreIntro != null )
	{
		queueItem.onPreIntro.append( announcement.onPreIntro )
	}

	if ( announcement.onCreateVisualOverride != null )
	{
		queueItem.onCreateVisualOverride = announcement.onCreateVisualOverride
	}

	if ( announcement.onIntro != null )
	{
		queueItem.onIntro = announcement.onIntro
	}

	if ( announcement.onPreOutro != null )
	{
		queueItem.onPreOutro = announcement.onPreOutro
	}

	if ( announcement.onDestroyVisualOverride != null )
	{
		queueItem.onDestroyVisualOverride = announcement.onDestroyVisualOverride
	}

	if ( announcement.onComplete != null )
	{
		queueItem.onComplete = announcement.onComplete
	}

	if ( announcement.onUpdateOverride != null )
	{
		queueItem.onUpdateOverride = announcement.onUpdateOverride
	}

	if ( announcement.isDeprecatedStyle )
	{
		queueItem.deprecatedAnnouncementData = announcement.deprecatedAnnouncementData
	}

	queueItem.onComplete = CenterAnnouncements_OnComplete

	HudNotificationQueue_QueueItem( file.queueId, queueItem, persistenceContext )
	return queueItem
}

HudNotificationQueueItem function CenterAnnouncements_QueueBuilder( AnnouncementBuilder announcementBuilder, int persistenceContext )
{
	HudNotificationQueueItem queueItem

	if ( announcementBuilder.announcementItems.len() == 0 )
	{
		queueItem.isValid = false
		return queueItem
	}

	queueItem.key = announcementBuilder.id
	queueItem.size = CenterAnnouncements_AutoCalculateBuilderRuiSize( announcementBuilder )
	queueItem.ruiAsset = announcementBuilder.ruiAsset
	queueItem.offset = announcementBuilder.offset
	queueItem.duration = announcementBuilder.duration
	queueItem.outroDuration = announcementBuilder.outroDuration
	queueItem.soundAliases = announcementBuilder.soundAliases
	queueItem.speakerDialogueLines = announcementBuilder.speakerDialogueLines
	queueItem.priority = announcementBuilder.priority
	queueItem.uiDrawStage = announcementBuilder.uiDrawStage
	queueItem.stuckInQueueTimeOutDuration = announcementBuilder.stuckInQueueTimeOutDuration
	queueItem.drawOverScreenFade = announcementBuilder.drawOverScreenFade
	queueItem.allowIndirectUpdates = announcementBuilder.allowIndirectUpdates

	queueItem.ruiArgs = {}

	int childCount = 0
	foreach ( CenterAnnouncementItem announcement in announcementBuilder.announcementItems )
	{
		if ( announcement.bannerRuiAsset == $"" )
			continue

		
		queueItem.ruiArgs[ "paddingTop" + childCount ] <- HudNotificationQueue_CreateRuiArg( "paddingTop" + childCount, announcement.paddingTop )
		queueItem.ruiArgs[ "paddingBottom" + childCount ] <- HudNotificationQueue_CreateRuiArg( "paddingBottom" + childCount, announcement.paddingBottom )

		vector announcementChildSize = announcement.ruiSize == <0, 0, 0> ? CenterAnnouncements_AutoCalculateRuiSizeWithImageContainer( announcement ) : announcement.ruiSize * announcement.scalar
		queueItem.ruiArgs[ "ruiSize" + childCount ] <- HudNotificationQueue_CreateRuiArg( "ruiSize" + childCount, announcementChildSize, eRuiArgType.FLOAT2 )

		
		queueItem.nestedRuiAssets.append( announcement.bannerRuiAsset )
		queueItem.nestedRuiArgs.append( CenterAnnouncements_GenerateRuiArgsTableFromAnnouncementItem( announcement ) )

		childCount++
	}

	queueItem.onPreIntro.append( CenterAnnouncements_OnPreIntro )

	if ( announcementBuilder.onPreIntro != null )
	{
		queueItem.onPreIntro.append( announcementBuilder.onPreIntro )
	}

	if ( announcementBuilder.onCreateVisualOverride != null )
	{
		queueItem.onCreateVisualOverride = announcementBuilder.onCreateVisualOverride
	}

	if ( announcementBuilder.onIntro != null )
	{
		queueItem.onIntro = announcementBuilder.onIntro
	}

	if ( announcementBuilder.onPreOutro != null )
	{
		queueItem.onPreOutro = announcementBuilder.onPreOutro
	}

	if ( announcementBuilder.onDestroyVisualOverride != null )
	{
		queueItem.onDestroyVisualOverride = announcementBuilder.onDestroyVisualOverride
	}

	if ( announcementBuilder.onComplete != null )
	{
		queueItem.onComplete = announcementBuilder.onComplete
	}

	if ( announcementBuilder.onUpdateOverride != null )
	{
		queueItem.onUpdateOverride = announcementBuilder.onUpdateOverride
	}

	queueItem.onComplete = CenterAnnouncements_OnComplete

	HudNotificationQueue_QueueItem( file.queueId, queueItem, persistenceContext )
	return queueItem
}

bool function CenterAnnouncements_HasAnyMainImages( CenterAnnouncementItem announcementItem )
{
	return ( announcementItem.mainIcon1 != $"" || announcementItem.mainIcon2 != $"" || announcementItem.mainIcon3 != $"" )
}

vector function CenterAnnouncements_AutoCalculateRuiSizeWithImageContainer( CenterAnnouncementItem announcementItem )
{
	float imageContainerHeight = CenterAnnouncements_HasAnyMainImages( announcementItem ) ? announcementItem.imageContainerHeight : 0.0
	return < DEFAULT_SCREEN_SIZE.x, ( announcementItem.announcementHeight + imageContainerHeight + announcementItem.spaceBetweenContainerAndBody ) * announcementItem.scalar, 0>
}

vector function CenterAnnouncements_AutoCalculateBuilderRuiSize( AnnouncementBuilder announcementBuilder )
{
	if ( announcementBuilder.announcementItems.len() == 0 )
		return DEFAULT_SCREEN_SIZE

	
	float combinedAnnouncementHeights = 0.0
	foreach ( CenterAnnouncementItem announcementItem in announcementBuilder.announcementItems )
	{
		vector announcementSize = announcementItem.ruiSize == <0, 0, 0> ? CenterAnnouncements_AutoCalculateRuiSizeWithImageContainer( announcementItem ) : announcementItem.ruiSize

		combinedAnnouncementHeights += announcementSize.y
		combinedAnnouncementHeights += announcementItem.paddingTop * announcementItem.scalar
		combinedAnnouncementHeights += announcementItem.paddingBottom * announcementItem.scalar
	}

	return <DEFAULT_SCREEN_SIZE.x, combinedAnnouncementHeights, 0>
}

table< string, HudNotificationQueueRuiArg > function CenterAnnouncements_GenerateRuiArgsTableFromAnnouncementItem( CenterAnnouncementItem announcement )
