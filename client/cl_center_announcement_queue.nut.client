void function DEV_CenterAnnouncements_TestAnnouncements( int count, int persistenceContext = ePersistenceContext.PLAYER )
{
	
	AnnouncementData announcement1 = Announcement_Create( "Deprecated Announcement 1" )
	announcement1.duration = 4.0
	announcement1.announcementStyle = ANNOUNCEMENT_STYLE_QUICK
	AnnouncementFromClass( GetLocalClientPlayer(), announcement1 )

	
	AnnouncementData announcement2 = Announcement_Create( "Deprecated Announcement 2" )
	announcement2.duration = 4.0
	announcement2.announcementStyle = ANNOUNCEMENT_STYLE_SWEEP
	AnnouncementFromClass( GetLocalClientPlayer(), announcement2 )

	
	for ( int i = 0; i < count; i++ )
	{
		int oneLine = RandomIntRange( 0, 2 )
		int priority = RandomIntRange( 0, 150 )

		if ( oneLine == 0 )
		{
			CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
			mainBanner.mainText = "Announcement " + i
			mainBanner.subText = "Priority " + priority
			mainBanner.leftIntensityTextureCount = 2
			mainBanner.rightIntensityTextureCount = 2
			mainBanner.frameColor = <1, 0, 0>
			mainBanner.textureColor = <1, 0, 0>
			mainBanner.priority = priority
			mainBanner.mainIcon1 = $"rui/ordnance_icons/grenade_frag"
			mainBanner.scalar = RandomFloatRange( 0.75, 1.5 )
			mainBanner.soundAliases.append( "ui_mapping_item_1p" )

			CenterAnnouncements_QueueItem( mainBanner, persistenceContext )
		}
		else
		{
			CenterAnnouncementItem mainBanner = CenterAnnouncements_CreateNotchedStyle()
			mainBanner.mainText = "Announcement " + i
			mainBanner.leftIntensityTextureCount = 2
			mainBanner.rightIntensityTextureCount = 2
			mainBanner.frameColor = <1, 0, 0>
			mainBanner.textureColor = <1, 0, 0>
			mainBanner.paddingBottom = 5.0
			mainBanner.mainIcon1 = $"rui/ordnance_icons/grenade_frag"
			mainBanner.mainIcon2 = $"rui/ordnance_icons/grenade_frag"
			mainBanner.mainIcon3 = $"rui/ordnance_icons/grenade_frag"
			mainBanner.scalar = RandomFloatRange( 0.75, 1.5 )

			CenterAnnouncementItem subBanner = CenterAnnouncements_CreateGradientStyle()
			subBanner.mainText = "Priority " + priority
			subBanner.contentPivot = <0.5, 0.0, 0.0>
			subBanner.scalar = 0.7
			subBanner.paddingTop = 5.0

			AnnouncementBuilder builder = CenterAnnouncements_CreateBuilderFromAnnouncementItems( [ mainBanner, subBanner ] )
			builder.priority = priority
			builder.soundAliases.append( "ui_mapping_item_1p" )

			CenterAnnouncements_QueueBuilder( builder, persistenceContext )
		}
	}

	
	AnnouncementData announcement
	announcement = Announcement_Create( "" )
	Announcement_SetSubText( announcement, GetAnnouncementSubtextString(1) )
	Announcement_SetHeaderText( announcement, "#SURVIVAL_CIRCLE_WARNING" )
	Announcement_SetDisplayEndTime( announcement, ClientTime() + 25 )
	Announcement_SetStyle( announcement, ANNOUNCEMENT_STYLE_CIRCLE_WARNING )
	Announcement_SetSoundAlias( announcement, "survival_circle_close_alarm_01" )
	Announcement_SetTitleColor( announcement, COLOR_WHITE )
	Announcement_SetFrameColor( announcement, SrgbToLinear( <1.0, 0.16, 0.1176> ) )
	Announcement_SetPurge( announcement, true )
	Announcement_SetPriority( announcement, 200 ) 
	Announcement_SetDuration( announcement, 7 )

	CenterAnnouncementItem deprecatedStyle = CenterAnnouncements_CreateDeprecatedStyle( announcement )
	deprecatedStyle.priority = eHudNotificationQueuePriority.HIGH
	CenterAnnouncements_QueueItem( deprecatedStyle, ePersistenceContext.PLAYER )
}
