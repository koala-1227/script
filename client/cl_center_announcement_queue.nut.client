CenterAnnouncementItem function CenterAnnouncements_CreateDeprecatedStyle( AnnouncementData deprecatedAnnouncement )
{
	CenterAnnouncementItem banner
	banner.ruiSize = DEFAULT_SCREEN_SIZE
	banner.deprecatedAnnouncementData = deprecatedAnnouncement
	banner.isDeprecatedStyle = true
	banner.duration = deprecatedAnnouncement.duration

	banner.onCreateVisualOverride = ( var function ( HudNotificationQueueItem queueItem )
	{
		return AnnouncementMessage_CreateStyleRUI( GetLocalClientPlayer(), queueItem.deprecatedAnnouncementData )
	})

	banner.onDestroyVisualOverride = ( void function ( HudNotificationQueueItem queueItem )
	{
		HudNotificationQueue_OnDestroyVisual_Base( queueItem )
	})

	return banner
}



void function CenterAnnouncements_ImageContainer_SetEmptyStyle( CenterAnnouncementItem announcement )
{
	announcement.spaceBetweenContainerAndBody = DEFAULT_SPACE_BETWEEN_IMAGE_CONTAINER_AND_BODY
	announcement.imageContainerHeight = DEFAULT_IMAGE_CONTAINER_HEIGHT
	announcement.imageContainerSpacing = DEFAULT_IMAGE_CONTAINER_SPACING

	announcement.imageContainerLeftPadding = DEFAULT_IMAGE_CONTAINER_CONTENT_TO_OUTER_EDGE_PADDING
	announcement.imageContainerRightPadding = DEFAULT_IMAGE_CONTAINER_CONTENT_TO_OUTER_EDGE_PADDING
	announcement.imageContainerVerticalPadding = DEFAULT_IMAGE_CONTAINER_VERTICAL_PADDING

	announcement.leftImageContainerMask = $""
	announcement.leftImageContainerMaskFlip = false

	announcement.rightImageContainerMask = $""
	announcement.rightImageContainerMaskFlip = true

	announcement.centerImageContainerMask = $""

	announcement.leftImageContainerFrame = $""
	announcement.leftImageContainerFrameFlip = false

	announcement.rightImageContainerFrame = $""
	announcement.rightImageContainerFrameFlip = true

	announcement.centerImageContainerFrame = $""

	announcement.imageContainerFrameColor = <1, 1, 1>
	announcement.imageContainerMaskColor = <0, 0, 0>
}

void function CenterAnnouncements_ImageContainer_SetNotchedStyle( CenterAnnouncementItem announcement )
{
	announcement.spaceBetweenContainerAndBody = -8.0
	announcement.imageContainerHeight = DEFAULT_IMAGE_CONTAINER_HEIGHT
	announcement.imageContainerSpacing = DEFAULT_IMAGE_CONTAINER_SPACING

	announcement.imageContainerLeftPadding = DEFAULT_IMAGE_CONTAINER_CONTENT_TO_OUTER_EDGE_PADDING
	announcement.imageContainerRightPadding = DEFAULT_IMAGE_CONTAINER_CONTENT_TO_OUTER_EDGE_PADDING
	announcement.imageContainerVerticalPadding = DEFAULT_IMAGE_CONTAINER_VERTICAL_PADDING

	announcement.leftImageContainerMask = $"rui/hud/splash/notched_frame_end_thin_mask"
	announcement.leftImageContainerMaskFlip = false

	announcement.rightImageContainerMask = $"rui/hud/splash/notched_frame_end_thin_mask"
	announcement.rightImageContainerMaskFlip = true

	announcement.centerImageContainerMask = $"rui/hud/splash/notched_frame_center_thin_mask"

	announcement.leftImageContainerFrame = $"rui/hud/splash/notched_frame_end_thin"
	announcement.leftImageContainerFrameFlip = false

	announcement.rightImageContainerFrame = $"rui/hud/splash/notched_frame_end_thin"
	announcement.rightImageContainerFrameFlip = true

	announcement.centerImageContainerFrame = $"rui/hud/splash/notched_frame_center_thin"

	announcement.imageContainerFrameColor = <1, 1, 1>
	announcement.imageContainerMaskColor = <0, 0, 0>

	announcement.useNotchedImageContainer = true
	announcement.useSingleImageContainer  = false
}

void function CenterAnnouncements_ImageContainer_SetSingleFrameStyle( CenterAnnouncementItem announcement )
{
	announcement.spaceBetweenContainerAndBody 			= -45.0
	announcement.imageContainerVerticalPadding 			= 35.0
	announcement.imageContainerHeight 					= SINGLE_FRAME_STYLE_IMAGE_CONTAINER_HEIGHT

	announcement.leftImageContainerMask 				= $""
	announcement.rightImageContainerMask 				= $""
	announcement.centerImageContainerMask 				= $""
	announcement.leftImageContainerFrame 				= $""
	announcement.rightImageContainerFrame 				= $""
	announcement.centerImageContainerFrame 				= $""

	announcement.centerImageContainerSingleFrame     	= $"rui/hud/splash/splash_reticle"
	announcement.centerImageContainerSingleFrameSize 	= <0, 0, 0>	
	announcement.imageContainerFrameColor               = <1, 1, 1>
	announcement.useNotchedImageContainer               = false
	announcement.useSingleImageContainer                = true
}













bool function CenterAnnouncements_OnPreIntro( HudNotificationQueueItem queueItem )
{
	
	Announcements_RequestPause()

	
	while ( Announcements_CurrentlyDisplaying() )
	{
		WaitFrame()
	}

	clGlobal.isAnnouncementActive = true
	clGlobal.centerAnnouncementsActivelyDisplaying = true
	SetAnnouncementIsActive()

	return true
}

void function CenterAnnouncements_OnComplete( HudNotificationQueueItem queueItem )
{
	int visibleCount = HudNotificationQueue_GetVisibleQueueItemCount( file.queueId )
	if ( visibleCount == 0 )
	{
		clGlobal.isAnnouncementActive = false
		clGlobal.centerAnnouncementsActivelyDisplaying = false
		ClearAnnouncementIsActive()
	}

	
	int queueLength = HudNotificationQueue_GetQueueItemCount( file.queueId )
	if ( queueLength == 0 )
	{
		Announcements_Unpause()
	}
}

void function CenterAnnouncements_ActiveMenuChanged( string currentMenu )
{
	
	if ( !IsAlive( GetLocalClientPlayer() ) )
		return

	if ( currentMenu != "" )
	{
		HudNotificationQueue_AddQueueBlocker( file.queueId, CenterAnnouncements_QueueBlocker_PauseInMenu )
	}
}


void function CenterAnnouncements_ActiveFakeMenuChanged( string currentFakeMenuName )
{
	
	if ( !IsAlive( GetLocalClientPlayer() ) )
		return

	if ( currentFakeMenuName != "" )
	{
		HudNotificationQueue_AddQueueBlocker( file.queueId, CenterAnnouncements_QueueBlocker_PauseInMenu )
	}
}

bool function CenterAnnouncements_QueueBlocker_PauseInMenu()
{
	entity localPlayer = GetLocalClientPlayer()

	
	if ( IsValidPlayer( localPlayer ) && !IsAlive( localPlayer ) )
		return true

	float MENU_CLOSE_GRACE_PERIOD_SEC = 1.0
	if ( clGlobal.isMenuOpen || clGlobal.isFakeMenuOpen )
	{
		return false	
	}
	else if ( clGlobal.lastMenuToggleTime > 0 || clGlobal.lastFakeMenuToggleTime > 0 )
	{
		if ( clGlobal.lastMenuToggleTime > 0 )
		{
			float timeSinceMenuToggle = Time() - clGlobal.lastMenuToggleTime
			if ( timeSinceMenuToggle <= MENU_CLOSE_GRACE_PERIOD_SEC )
				return false
		}

		if ( clGlobal.lastFakeMenuToggleTime > 0 )
		{
			float timeSinceFakeMenuToggle = Time() - clGlobal.lastFakeMenuToggleTime
			if ( timeSinceFakeMenuToggle <= MENU_CLOSE_GRACE_PERIOD_SEC )
				return false
		}

		return true
	}

	return true
}



