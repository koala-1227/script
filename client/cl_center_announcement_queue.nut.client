void function CenterAnnouncements_GenerateImageSizesIfNotProvided( CenterAnnouncementItem announcement )
{
	

	
	announcement.leftIconSize 				= ( announcement.leftIconSize != <0, 0, 0> ) ? announcement.leftIconSize : ( announcement.leftIcon != $"" ? GetImageSize( announcement.leftIcon ) : <0, 0, 0> )
	announcement.rightIconSize 				= ( announcement.rightIconSize != <0, 0, 0> ) ? announcement.rightIconSize : ( announcement.rightIcon != $"" ? GetImageSize( announcement.rightIcon ) : <0, 0, 0> )

	
	announcement.mainIcon1Size 				= ( announcement.mainIcon1Size != <0, 0, 0> ) ? announcement.mainIcon1Size : ( announcement.mainIcon1 != $"" ? GetImageSize( announcement.mainIcon1 ) : <0, 0, 0> )
	announcement.mainIcon2Size 				= ( announcement.mainIcon2Size != <0, 0, 0> ) ? announcement.mainIcon2Size : ( announcement.mainIcon2 != $"" ? GetImageSize( announcement.mainIcon2 ) : <0, 0, 0> )
	announcement.mainIcon3Size 				= ( announcement.mainIcon3Size != <0, 0, 0> ) ? announcement.mainIcon3Size : ( announcement.mainIcon3 != $"" ? GetImageSize( announcement.mainIcon3 ) : <0, 0, 0> )

	
	announcement.leftEndMaskSize 			= ( announcement.leftEndMaskSize != <0, 0, 0> ) ? announcement.leftEndMaskSize : ( announcement.leftEndMask != $"" ? GetImageSize( announcement.leftEndMask ) : <0, 0, 0> )
	announcement.rightEndMaskSize 			= ( announcement.rightEndMaskSize != <0, 0, 0> ) ? announcement.rightEndMaskSize : ( announcement.rightEndMask != $"" ? GetImageSize( announcement.rightEndMask ) : <0, 0, 0> )
	announcement.leftEndFrameSize 			= ( announcement.leftEndFrameSize != <0, 0, 0> ) ? announcement.leftEndFrameSize : ( announcement.leftEndFrame != $"" ? GetImageSize( announcement.leftEndFrame ) : <0, 0, 0> )
	announcement.rightEndFrameSize 			= ( announcement.rightEndFrameSize != <0, 0, 0> ) ? announcement.rightEndFrameSize : ( announcement.rightEndFrame != $"" ? GetImageSize( announcement.rightEndFrame ) : <0, 0, 0> )

	announcement.leftCenterMaskSize 		= ( announcement.leftCenterMaskSize != <0, 0, 0> ) ? announcement.leftCenterMaskSize : ( announcement.leftCenterMask != $"" ? GetImageSize( announcement.leftCenterMask ) : <0, 0, 0> )
	announcement.rightCenterMaskSize 		= ( announcement.rightCenterMaskSize != <0, 0, 0> ) ? announcement.rightCenterMaskSize : ( announcement.rightCenterMask != $"" ? GetImageSize( announcement.rightCenterMask ) : <0, 0, 0> )

	announcement.leftCenterFrameSize 		= ( announcement.leftCenterFrameSize != <0, 0, 0> ) ? announcement.leftCenterFrameSize : ( announcement.leftCenterFrame != $"" ? GetImageSize( announcement.leftCenterFrame ) : <0, 0, 0> )
	announcement.rightCenterFrameSize 		= ( announcement.rightCenterFrameSize != <0, 0, 0> ) ? announcement.rightCenterFrameSize : ( announcement.rightCenterFrame != $"" ? GetImageSize( announcement.rightCenterFrame ) : <0, 0, 0> )

	announcement.leftTextureSize 			= ( announcement.leftTextureSize != <0, 0, 0> ) ? announcement.leftTextureSize : ( announcement.leftTexture != $"" ? GetImageSize( announcement.leftTexture ) : <0, 0, 0> )
	announcement.rightTextureSize 			= ( announcement.rightTextureSize != <0, 0, 0> ) ? announcement.rightTextureSize : ( announcement.rightTexture != $"" ? GetImageSize( announcement.rightTexture ) : <0, 0, 0> )
	announcement.leftIntensityTextureSize 	= ( announcement.leftIntensityTextureSize != <0, 0, 0> ) ? announcement.leftIntensityTextureSize : ( announcement.leftIntensityTexture != $"" ? GetImageSize( announcement.leftIntensityTexture ) : <0, 0, 0> )
	announcement.rightIntensityTextureSize 	= ( announcement.rightIntensityTextureSize != <0, 0, 0> ) ? announcement.rightIntensityTextureSize : ( announcement.rightIntensityTexture != $"" ? GetImageSize( announcement.rightIntensityTexture ) : <0, 0, 0> )

	announcement.leftImageContainerMaskSize 	= ( announcement.leftImageContainerMaskSize != <0, 0, 0> ) ? announcement.leftImageContainerMaskSize : ( announcement.leftImageContainerMask != $"" ? GetImageSize( announcement.leftImageContainerMask ) : <0, 0, 0> )
	announcement.rightImageContainerMaskSize 	= ( announcement.rightImageContainerMaskSize != <0, 0, 0> ) ? announcement.rightImageContainerMaskSize : ( announcement.rightImageContainerMask != $"" ? GetImageSize( announcement.rightImageContainerMask ) : <0, 0, 0> )
	announcement.centerImageContainerMaskSize 	= ( announcement.centerImageContainerMaskSize != <0, 0, 0> ) ? announcement.centerImageContainerMaskSize : ( announcement.centerImageContainerMask != $"" ? GetImageSize( announcement.centerImageContainerMask ) : <0, 0, 0> )
	announcement.leftImageContainerFrameSize 	= ( announcement.leftImageContainerFrameSize != <0, 0, 0> ) ? announcement.leftImageContainerFrameSize : ( announcement.leftImageContainerFrame != $"" ? GetImageSize( announcement.leftImageContainerFrame ) : <0, 0, 0> )
	announcement.rightImageContainerFrameSize 	= ( announcement.rightImageContainerFrameSize != <0, 0, 0> ) ? announcement.rightImageContainerFrameSize : ( announcement.rightImageContainerFrame != $"" ? GetImageSize( announcement.rightImageContainerFrame ) : <0, 0, 0> )
	announcement.centerImageContainerFrameSize 	= ( announcement.centerImageContainerFrameSize != <0, 0, 0> ) ? announcement.centerImageContainerFrameSize : ( announcement.centerImageContainerFrame != $"" ? GetImageSize( announcement.centerImageContainerFrame ) : <0, 0, 0> )

