		["mainTextFontFace"]	= HudNotificationQueue_CreateRuiArg( "mainTextFontFace", announcement.mainTextFontFace ),
		["mainTextMinWidth"]	= HudNotificationQueue_CreateRuiArg( "mainTextMinWidth", announcement.mainTextMinWidth ),

		["subText"] 			= HudNotificationQueue_CreateRuiArg( "subText", announcement.subText ),
		["subTextColor"] 		= HudNotificationQueue_CreateRuiArg( "subTextColor", announcement.subTextColor, eRuiArgType.COLOR ),
		["subTextIsUpper"] 		= HudNotificationQueue_CreateRuiArg( "subTextIsUpper", announcement.subTextIsUpper ),
		["subTextFontFace"]		= HudNotificationQueue_CreateRuiArg( "subTextFontFace", announcement.subTextFontFace ),

		["frameColor"] 			= HudNotificationQueue_CreateRuiArg( "frameColor", announcement.frameColor, eRuiArgType.COLOR ),
		["backgroundColor"] 	= HudNotificationQueue_CreateRuiArg( "backgroundColor", announcement.backgroundColor, eRuiArgType.COLOR ),
		["backgroundAlpha"] 	= HudNotificationQueue_CreateRuiArg( "backgroundAlpha", announcement.backgroundAlpha ),
		["textureColor"] 		= HudNotificationQueue_CreateRuiArg( "textureColor", announcement.textureColor, eRuiArgType.COLOR ),
		["textureAlpha"] 		= HudNotificationQueue_CreateRuiArg( "textureAlpha", announcement.textureAlpha ),

		["leftIcon"] 			= HudNotificationQueue_CreateRuiArg( "leftIcon", announcement.leftIcon ),
		["leftIconColor"] 		= HudNotificationQueue_CreateRuiArg( "leftIconColor", announcement.leftIconColor, eRuiArgType.COLOR ),
		["leftIconSize"] 		= HudNotificationQueue_CreateRuiArg( "leftIconSize", announcement.leftIconSize, eRuiArgType.FLOAT2 ),

