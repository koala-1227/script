CenterAnnouncementItem function CenterAnnouncements_CreateEmptyStyle()
{
	CenterAnnouncementItem banner
	banner.bannerRuiAsset = $"ui/generic_center_announcement.rpak"
	CenterAnnouncements_ImageContainer_SetEmptyStyle( banner )
	return banner
}

