	CenterAnnouncements_GenerateImageSizesIfNotProvided( announcement )

	table< string, HudNotificationQueueRuiArg > ruiArgs = {
		["scalar"] 				= HudNotificationQueue_CreateRuiArg( "scalar", announcement.scalar ),
		["contentPivot"] 		= HudNotificationQueue_CreateRuiArg( "contentPivot", announcement.contentPivot, eRuiArgType.FLOAT2 ),

		["superText"] 			= HudNotificationQueue_CreateRuiArg( "superText", announcement.superText ),
		["superTextColor"] 		= HudNotificationQueue_CreateRuiArg( "superTextColor", announcement.superTextColor, eRuiArgType.COLOR ),
