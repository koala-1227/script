void function HudNotificationQueue_Init()
{
	HudNotificationQueue_RegisterSignals()
	AddCallback_OnGameStateChanged( HudNotificationQueue_OnGameStateChanged )
	AddCallback_OnViewPlayerChanged( HudNotificationQueue_OnViewPlayerChanged )
	AddOnDeathCallback( "player", HudNotificationQueue_OnPlayerKilled )
}

void function HudNotificationQueue_RegisterSignals()
{
	RegisterSignal( "HudNotificationQueue_QueueBlockerStarted" )
	RegisterSignal( "HudNotificationQueue_QueueBlockersReleased" )
	RegisterSignal( "HudNotificationQueue_Dispatcher_ItemSlotReleased" )		
	RegisterSignal( "ItemPositioning_UpdatePositions" )							
	RegisterSignal( "ItemPositioning_OnBeginUpdatePositions" )					
	RegisterSignal( "ItemPositioning_ForceEndPositionThread" )					

	
	RegisterSignal( "Internal_HudNotificationQueue_ClearItem" )
}














