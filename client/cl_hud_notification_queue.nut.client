{
	HudNotificationQueueRuiArg arg
	arg.argName = argName
	arg.argValue = argValue
	arg.addlArgValues = addlArgValues
	arg.argType = argType
	return arg
}


void function HudNotificationQueue_SetRuiArgs( var rui, table< string, HudNotificationQueueRuiArg > ruiArgsTable )
