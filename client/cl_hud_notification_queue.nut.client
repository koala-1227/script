void function _____________QUEUE_SETUP___________________________(){}
#endif

int function HudNotificationQueue_CreateAndRegisterQueue( string notificationQueueKey )
{
	Assert( !(notificationQueueKey in file.hudNotificationQueueKeyToIdMap), format( "Tried to register a new HUD Notification Queue with a duplicate key of %s", notificationQueueKey ) )

	HudNotificationQueue queue
	queue.key = notificationQueueKey
	queue.id = HudNotificationQueue_GetNewUniqueQueueId()

	Assert( !(queue.id in file.hudNotificationQueues), format( "Tried to register a new HUD Notification Queue with a duplicate ID of %s", queue.id ) )

	file.hudNotificationQueueKeyToIdMap[ queue.key ] <- queue.id
	file.hudNotificationQueues[ queue.id ] <- queue

	HudNotificationQueue_InitializeQueue( queue )

	return queue.id
}

void function HudNotificationQueue_InitializeQueue( HudNotificationQueue queue )
{
	QueueDispatcher_Init( queue )
	ItemPositioning_Init( queue )
}

int function HudNotificationQueue_GetNewUniqueQueueId()
{
	return ++file.uniqueQueueId
}


HudNotificationQueue function HudNotificationQueue_GetQueueById( int queueId )
{
	Assert( queueId in file.hudNotificationQueues, format( "Unable to find a queue with the id %s", queueId ) )
	return file.hudNotificationQueues[ queueId ]
}

int function HudNotificationQueue_GetQueueIdByKey( string queueKey )
{
	Assert( queueKey in file.hudNotificationQueueKeyToIdMap, format( "Unable to find a queue with the key %s", queueKey ) )
	return file.hudNotificationQueueKeyToIdMap[ queueKey ]
}













