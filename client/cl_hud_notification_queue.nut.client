void function HudNotificationQueue_OnCreateRuiShell_Base( HudNotificationQueueItem queueItem )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueItem.queueId )

	
	HudNotificationQueue_CreateRui( queueItem, $"ui/hud_notification_queue_item.rpak", null )

	Assert( queueItem.ruiShell != null, "Something went wrong during the creation of the RUI Shell for a HUD Notification Queue Item and the shell returned null." )

	
	RuiSetFloat2IfExists( queueItem.ruiShell, "ruiSize", queueItem.size )
	RuiSetFloat2IfExists( queueItem.ruiShell, "screenSpacePin", queue.itemPositioning.screenSpacePin )
	RuiSetFloat2IfExists( queueItem.ruiShell, "itemAnchorPin", queue.itemPositioning.itemAnchorPin )
	RuiSetFloat2IfExists( queueItem.ruiShell, "startPosition", PixelsToScreenFrac( ScalePixelsForScreenSize( queue.itemPositioning.startPosition ) ) )
	RuiSetFloat2IfExists( queueItem.ruiShell, "offset", PixelsToScreenFrac( ScalePixelsForScreenSize( queueItem.offset ) ) )
}

void function HudNotificationQueue_OnCreateVisual_Base( HudNotificationQueueItem queueItem )
{
	Assert( queueItem.ruiAsset != $"" , "HUD Notification Queue item cannot create a null RUI Asset. Please provide a 'ruiAsset' for the queue item to use." )

	HudNotificationQueue_CreateRui( queueItem, queueItem.ruiAsset, queueItem.ruiShell )
	VisibleItemInterface_SetRuiArgs( queueItem.ruiInstance, queueItem.ruiArgs )

	if ( queueItem.nestedRuiAssets.len () > 0 )
	{
		int childCount = 0
		foreach ( asset nestedRuiAsset in queueItem.nestedRuiAssets )
		{
			var rui = HudNotificationQueue_CreateRui( queueItem, nestedRuiAsset, queueItem.ruiInstance, childCount )

			if ( queueItem.nestedRuiArgs.len() > childCount )
			{
				VisibleItemInterface_SetRuiArgs( rui, queueItem.nestedRuiArgs[childCount]  )
			}

			childCount++
		}
	}

	if ( queueItem.onCreateVisual != null )
	{
		queueItem.onCreateVisual( queueItem )
	}
}

void function HudNotificationQueue_OnIntro_Base( HudNotificationQueueItem queueItem )
{
	if ( RuiIsAlive( queueItem.ruiInstance ) )
	{
		RuiSetGameTimeIfExists( queueItem.ruiInstance, "startTime", ClientTime() )
	}

	if ( queueItem.nestedRuiInstances.len() > 0 )
	{
		foreach ( var nestedRui in queueItem.nestedRuiInstances )
		{
			if ( RuiIsAlive( nestedRui ) )
			{
				RuiSetGameTimeIfExists( nestedRui, "startTime", ClientTime() )
			}
		}
	}

	if ( queueItem.onIntro != null )
	{
		queueItem.onIntro( queueItem )
	}
}

void function HudNotificationQueue_OnOutro_Base( HudNotificationQueueItem queueItem )
{
	if ( RuiIsAlive( queueItem.ruiInstance ) )
	{
		RuiSetGameTimeIfExists( queueItem.ruiInstance, "outroTime", ClientTime() )
	}


	if ( queueItem.nestedRuiInstances.len() > 0 )
	{
		foreach ( var nestedRui in queueItem.nestedRuiInstances )
		{
			if ( RuiIsAlive( nestedRui ) )
			{
				RuiSetGameTimeIfExists( nestedRui, "outroTime", ClientTime() )
			}
		}
	}

	if ( queueItem.onOutro != null )
	{
		queueItem.onOutro( queueItem )
	}
}

void function HudNotificationQueue_OnDestroyVisual_Base( HudNotificationQueueItem queueItem )
{
	if ( queueItem.ruiShell != null )
	{
		RuiDestroyIfAlive( queueItem.ruiShell )
	}
	else if ( queueItem.ruiInstance != null ) 
	{
		RuiDestroyIfAlive( queueItem.ruiInstance )
	}
	
}

void function HudNotificationQueue_OnUpdate_Base( bool isItemVisible, HudNotificationQueueItem oldItem, HudNotificationQueueItem ornull newItem )
{
	if ( newItem != null )
	{
		expect HudNotificationQueueItem( newItem )

		
		oldItem.ruiArgs = newItem.ruiArgs
		oldItem.miscArgs = newItem.miscArgs
		oldItem.duration = newItem.duration
	}

	if ( isItemVisible )
	{
		if ( oldItem.ruiInstance != null && RuiIsAlive( oldItem.ruiInstance ) )
		{
			VisibleItemInterface_SetRuiArgs( oldItem.ruiInstance, oldItem.ruiArgs )
			RuiSetGameTimeIfExists( oldItem.ruiInstance, "updateTime", ClientTime() )
		}

		if ( oldItem.nestedRuiInstances.len() > 0 )
		{
			int childCount = 0
			foreach ( var nestedRui in oldItem.nestedRuiInstances )
			{
				if ( RuiIsAlive( nestedRui ) )
				{
					RuiSetGameTimeIfExists( nestedRui, "updateTime", ClientTime() )

					if ( oldItem.nestedRuiArgs.len() > childCount )
					{
						VisibleItemInterface_SetRuiArgs( nestedRui, oldItem.nestedRuiArgs[childCount]  )
					}
				}

				childCount++
			}
		}

		HudNotificationQueue queue = HudNotificationQueue_GetQueueById( oldItem.queueId )
		if ( queue.receiver.itemUpdatesRefreshDuration )
		{
			oldItem.timeToStartOutro = Time() + oldItem.duration
		}
	}

	if ( oldItem.onUpdate != null )
	{
		oldItem.onUpdate( isItemVisible, oldItem )
	}
}


var function HudNotificationQueue_CreateRui( HudNotificationQueueItem queueItem, asset ruiAsset, var parentRui, int ruiChildIndex = -1 )
{
	var rui

	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueItem.queueId )

	bool isNestedChild = ruiChildIndex >= 0

	
	if ( parentRui != null && RuiIsAlive( parentRui ) )
	{
		if ( isNestedChild )
		{
			rui = RuiCreateNested( parentRui, "ruiHandle" + ruiChildIndex, ruiAsset )
			queueItem.nestedRuiInstances.append( rui )
			return rui
		}
		else
		{
			rui = RuiCreateNested( parentRui, "ruiHandle", ruiAsset )
			queueItem.ruiInstance = rui
			return rui
		}

		return rui
	}

	switch ( queueItem.uiDrawStage )
	{
		case eUIDrawStage.POSTEFFECTS:
			if ( parentRui == null )
			{
				rui = CreateFullscreenRui( ruiAsset, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey )
				queueItem.ruiShell = rui
			}
			else
			{
				rui = CreateFullscreenRui( ruiAsset, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey )
				queueItem.ruiInstance = rui
			}
			break

		case eUIDrawStage.HUD:
			if ( parentRui == null )
			{
				rui = CreatePermanentCockpitRui( ruiAsset, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey )
				queueItem.ruiShell = rui
			}
			else
			{
				rui = CreatePermanentCockpitRui( ruiAsset, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey )
				queueItem.ruiInstance = rui
			}
			break

		case eUIDrawStage.COCKPIT:
			
			Assert( false, "RUI_DRAW_COCKPIT stage is not supported by the HUD Notification Queue system. Please use a different stage, or implement support for it." )
			break

		case eUIDrawStage.VIEW_MODEL:
		case eUIDrawStage.WORLD:
			Warning( "VIEW_MODEL and WORLD stages have not been tested in the HUD Notification Queue. Be extra sure to test if you intend on using this stage." )

			vector angles = VectorToAngles( AnglesToForward( queueItem.sceneAngles ) * -1 )
			var topo = CreateRUITopology_Worldspace( queueItem.scenePosition, angles, queueItem.size.x, queueItem.size.y )

			if ( parentRui == null )
			{
				rui = RuiCreate( ruiAsset, topo, queueItem.uiDrawStage, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey  )
				queueItem.ruiShell = rui
			}
			else
			{
				rui = RuiCreate( ruiAsset, topo, queueItem.uiDrawStage, queueItem.drawOverScreenFade ? RUI_SORT_SCREENFADE + 1 : queue.visibleItemInterface.sortKey  )
				queueItem.ruiInstance = rui
			}
			break

		default:
			Assert( false, format( "HUD Notification Queue system received an unrecognized UI Draw Stage of %s.", queueItem.uiDrawStage ) )
			break
	}

	return rui
}













#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________ITEM_POSITIONING___________________________(){}
#endif

void function ItemPositioning_Init( HudNotificationQueue queue )
{
	
	thread ItemPositioning_Think( queue )
}

void function ItemPositioning_Think( HudNotificationQueue queue )
{
	while ( true )
	{
		WaitSignal( queue.signalDummy, "ItemPositioning_UpdatePositions" )
		thread ItemPositioning_BeginNewPositionUpdateOperation( queue )
	}
}


void function ItemPositioning_BeginNewPositionUpdateOperation( HudNotificationQueue queue )
{
	
	Signal( queue.signalDummy, "ItemPositioning_OnBeginUpdatePositions" )
	EndSignal( queue.signalDummy, "ItemPositioning_OnBeginUpdatePositions" )

	
	if ( queue.visibleItems.len() == 0 )
		return

	vector scaledItemPadding = ScalePixelsForScreenSize( < queue.itemPositioning.padding, queue.itemPositioning.padding, 0.0 > ) 

	
	vector totalItemPosition = <0, 0, 0>
	for ( int idx = 0; idx < queue.visibleItems.len(); idx++ )
	{
		HudNotificationQueueItem queueItem = queue.visibleItems[idx]

		vector targetPosition = totalItemPosition
		vector scaledItemSize = ScalePixelsForScreenSize( queueItem.size )

		
		switch ( queue.itemPositioning.stackDirection )
		{
			case eHudNotificationQueueStackDirection.TOP_TO_BOTTOM:
				totalItemPosition += < 0, scaledItemSize.y + scaledItemPadding.y, 0 >
				break

			case eHudNotificationQueueStackDirection.BOTTOM_TO_TOP:
				totalItemPosition -= < 0, scaledItemSize.y + scaledItemPadding.y, 0 >
				break

			case eHudNotificationQueueStackDirection.LEFT_TO_RIGHT:
				totalItemPosition += < scaledItemSize.x + scaledItemPadding.x, 0, 0 >
				break

			case eHudNotificationQueueStackDirection.RIGHT_TO_LEFT:
				totalItemPosition -= < scaledItemSize.x + scaledItemPadding.x, 0, 0 >
				break
		}

		
		if ( queueItem in queue.itemPositioning.itemPositionData )
		{
			
			HudNotificationQueue_ItemPositionEntry positionEntry = queue.itemPositioning.itemPositionData[queueItem]
			positionEntry.index = idx 
			positionEntry.startPosition = positionEntry.currentPosition
			positionEntry.endPosition = PixelsToScreenFrac( targetPosition )
		}
		else
		{
			HudNotificationQueue_ItemPositionEntry positionEntry
			positionEntry.index = idx
			positionEntry.startPosition = <0, 0, 0>
			positionEntry.endPosition = PixelsToScreenFrac( targetPosition )

			queue.itemPositioning.itemPositionData[queueItem] <- positionEntry
		}
	}

	queue.itemPositioning.moveStartTime = ClientTime()
	thread ItemPositioning_Positioning_Thread( queue )
}

void function ItemPositioning_Positioning_Thread( HudNotificationQueue queue )
{
	EndSignal( queue.signalDummy, "ItemPositioning_OnBeginUpdatePositions" )
	EndSignal( queue.signalDummy, "ItemPositioning_ForceEndPositionThread" )

	OnThreadEnd(
		function() : ( queue )
		{
			queue.itemPositioning.moveStartTime = -1
		}
	)

	float frac = 0.0
	while ( frac < 1.0 )
	{
		float elapsedTime = ClientTime() - queue.itemPositioning.moveStartTime

		
		if ( queue.itemPositioning.moveDuration > 0 )
		{
			frac = elapsedTime / queue.itemPositioning.moveDuration
		}
		else
		{
			frac = 1.0
		}

		foreach ( item, positionData in queue.itemPositioning.itemPositionData )
		{
			vector position = LerpVector( positionData.startPosition, positionData.endPosition, frac )
			positionData.currentPosition = position

			if ( item.ruiShell != null && RuiIsAlive( item.ruiShell ) )
			{
				RuiSetFloat2IfExists( item.ruiShell, "position", position )
			}
			else if ( item.ruiInstance != null && RuiIsAlive( item.ruiInstance ) )	
			{
				RuiSetFloat2IfExists( item.ruiInstance, "position", position )
			}
		}

		WaitFrame()
	}

	queue.itemPositioning.moveStartTime = -1
}

void function ItemPositioning_RemoveItem( HudNotificationQueueItem queueItem )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueItem.queueId )

	if ( queueItem in queue.itemPositioning.itemPositionData )
	{
		delete queue.itemPositioning.itemPositionData[queueItem]
	}

	if ( queue.itemPositioning.itemPositionData.len() == 0 )
	{
		Signal( queue.signalDummy, "ItemPositioning_ForceEndPositionThread" )
	}
}













void function HudNotificationQueue_OnGameStateChanged( int newGameState )
{
	if ( newGameState >= eGameState.WinnerDetermined )
	{
		foreach ( id, queue in file.hudNotificationQueues )
		{
			if ( queue.allowClearItems )
			{
				DONOTUSE_HudNotificationQueue_ClearItems( queue, ePersistenceContext.GLOBAL, true )
			}
		}
	}
}

void function HudNotificationQueue_OnViewPlayerChanged( entity player )
{
	foreach ( id, queue in file.hudNotificationQueues )
	{
		if ( queue.allowClearItems )
		{
			DONOTUSE_HudNotificationQueue_ClearItems( queue, ePersistenceContext.PLAYER, true )
		}
	}
}

void function HudNotificationQueue_OnPlayerKilled( entity player )
{
	entity localPlayer = GetLocalViewPlayer()
	if ( localPlayer != player || !IsValid( localPlayer ) )
		return

	file.localPlayerKilledTime = ClientTime()

	foreach ( id, queue in file.hudNotificationQueues )
	{
		if ( queue.pauseOnLocalPlayerDeath )
		{
			HudNotificationQueue_AddQueueBlocker( id, HudNotificationQueue_QueueBlocker_PauseIfJustKilled )
		}

		if ( queue.allowClearItems )
		{
			DONOTUSE_HudNotificationQueue_ClearItems( queue, ePersistenceContext.PLAYER, true )
		}
	}
}

bool function HudNotificationQueue_QueueBlocker_PauseIfJustKilled()
{
	const float JUST_KILLED_QUEUE_BLOCKER_DURATION = 5.0

	if ( file.localPlayerKilledTime <= 0 )
		return true

	float timeSinceLocalPlayerKilled = ClientTime() - file.localPlayerKilledTime
	if ( timeSinceLocalPlayerKilled >= JUST_KILLED_QUEUE_BLOCKER_DURATION )
	{
		file.localPlayerKilledTime = 0
		return true
	}

	return false
}

void function DONOTUSE_HudNotificationQueue_AllowClearItemsOnQueue( int queueId )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueId )
	queue.allowClearItems = true
}

void function DONOTUSE_HudNotificationQueue_ClearItems( HudNotificationQueue queue, int persistenceContextThreshold, bool killCurrent )
{
	








	Assert( queue.allowClearItems, "Attempted to clear a HUD Notification Queue that is not approved for clearing." )
	Assert( persistenceContextThreshold > ePersistenceContext.INVALID, "Cannot clear a HUD Notification Queue with an invalid persistence context level." )

	array< HudNotificationQueueItem > queuedItems = clone queue.queuedItems
	foreach ( queueItem in queuedItems )
	{
		if ( queueItem.persistenceContext <= persistenceContextThreshold )
		{
			
			queue.queuedItems.removebyvalue( queueItem )
		}
	}

	if ( killCurrent )
	{
		array< HudNotificationQueueItem > preVisibleItems = clone queue.preVisibleItems
		foreach ( queueItem in preVisibleItems )
		{
			if ( queueItem.persistenceContext <= persistenceContextThreshold )
			{
				
				queue.preVisibleItems.removebyvalue( queueItem )
			}
		}

		foreach ( queueItem in queue.visibleItems )
		{
			if ( queueItem.persistenceContext <= persistenceContextThreshold )
			{
				Signal( queueItem.signalDummy, "Internal_HudNotificationQueue_ClearItem" )
			}
		}
	}
}␀