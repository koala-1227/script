HudNotificationQueueConfiguration function HudNotificationQueue_GetConfigure( int queueId )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueId )
	HudNotificationQueueConfiguration configuration

	
	configuration.allowDirectUpdates = queue.receiver.allowDirectUpdates
	configuration.allowIndirectUpdates = queue.receiver.allowIndirectUpdates
	configuration.allowDuplicates = queue.receiver.allowDuplicates
	configuration.itemUpdatesRefreshDuration = queue.receiver.itemUpdatesRefreshDuration
	configuration.backlogMaxCount = queue.receiver.backlogMaxCount
	configuration.backlogMaxCountWhenBlocked = queue.receiver.backlogMaxCountWhenBlocked
	configuration.backlogPreservationStyle = queue.receiver.backlogPreservationStyle

	
	configuration.maxVisibleItems = queue.dispatcher.maxVisibleItems
	configuration.maxTotalSize.width = queue.dispatcher.maxTotalSize.width
	configuration.maxTotalSize.height = queue.dispatcher.maxTotalSize.height
	configuration.pauseOnLocalPlayerDeath = queue.pauseOnLocalPlayerDeath

	
	configuration.sortKey = queue.visibleItemInterface.sortKey

	
	configuration.itemPositioningEnabled = queue.itemPositioning.enabled
	configuration.stackDirection = queue.itemPositioning.stackDirection
	configuration.moveDuration = queue.itemPositioning.moveDuration
	configuration.padding = queue.itemPositioning.padding
	configuration.screenSpacePin = queue.itemPositioning.screenSpacePin
	configuration.itemAnchorPin = queue.itemPositioning.itemAnchorPin
	configuration.startPosition = queue.itemPositioning.startPosition

	return configuration
}

void function HudNotificationQueue_Configure( int queueId, HudNotificationQueueConfiguration configuration )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueId )

	
	queue.receiver.allowDirectUpdates = configuration.allowDirectUpdates
	queue.receiver.allowIndirectUpdates = configuration.allowIndirectUpdates
	queue.receiver.allowDuplicates = configuration.allowDuplicates
	queue.receiver.itemUpdatesRefreshDuration = configuration.itemUpdatesRefreshDuration
	queue.receiver.backlogMaxCount = configuration.backlogMaxCount
	queue.receiver.backlogMaxCountWhenBlocked = configuration.backlogMaxCountWhenBlocked
	queue.receiver.backlogPreservationStyle = configuration.backlogPreservationStyle

	
#if DEV
		if ( configuration.maxVisibleItems == 0 )
		{
			Warning( format( "The max number of visible items for queue %s was set to 0. If you're trying to hide a queue, you should use QueueBlockers to temporarily suspend processing of the queue.", queue.key ) )
		}
#endif
	queue.dispatcher.maxVisibleItems = configuration.maxVisibleItems
	queue.dispatcher.maxTotalSize.width = configuration.maxTotalSize.width
	queue.dispatcher.maxTotalSize.height = configuration.maxTotalSize.height
	queue.pauseOnLocalPlayerDeath = configuration.pauseOnLocalPlayerDeath

	
	queue.visibleItemInterface.sortKey = configuration.sortKey

	
	bool hasItemPositioningBecomeDisabled = false
	bool hasAnyPositioningSettingChanged = false

	if ( queue.itemPositioning.enabled && !configuration.itemPositioningEnabled )
	{
		hasItemPositioningBecomeDisabled = true
	}
	queue.itemPositioning.enabled = configuration.itemPositioningEnabled

	if ( queue.itemPositioning.stackDirection != configuration.stackDirection )
	{
		queue.itemPositioning.stackDirection = configuration.stackDirection
		hasAnyPositioningSettingChanged = true
	}

	if ( queue.itemPositioning.moveDuration != configuration.moveDuration )
	{
		queue.itemPositioning.moveDuration = configuration.moveDuration
		hasAnyPositioningSettingChanged = true
	}

	if ( queue.itemPositioning.padding != configuration.padding )
	{
		queue.itemPositioning.padding = configuration.padding
		hasAnyPositioningSettingChanged = true
	}

	
	queue.itemPositioning.itemAnchorPin = configuration.itemAnchorPin
	queue.itemPositioning.screenSpacePin = configuration.screenSpacePin
	queue.itemPositioning.startPosition = configuration.startPosition

	if ( hasItemPositioningBecomeDisabled )
	{
		
		Signal( queue.signalDummy, "ItemPositioning_ForceEndPositionThread" )

		
		queue.itemPositioning.itemPositionData.clear()
	}
	else if ( queue.itemPositioning.enabled && hasAnyPositioningSettingChanged ) 
	{
		Signal( queue.signalDummy, "ItemPositioning_UpdatePositions" )
	}
}

HudNotificationQueueItem function HudNotificationQueue_CreateEmptyItem()
{
	HudNotificationQueueItem item
	return item
}

void function HudNotificationQueue_QueueItem( int queueId, HudNotificationQueueItem incomingQueueItem, int persistenceContext )
{
	
	Assert( persistenceContext > ePersistenceContext.INVALID, "Cannot queue an item with an invalid persistence context." )

	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueId )
	incomingQueueItem.queueId = queueId		
	incomingQueueItem.persistenceContext = persistenceContext
	QueueReceiver_EvaluateIncomingItem( queue, incomingQueueItem )
}

void function HudNotificationQueue_UpdateItem( HudNotificationQueueItem updatedItem )
{
	
	PassByReferenceBool isVisibleRef = { value = false }
	HudNotificationQueueItem ornull existingQueueItem = QueueReceiver_FindExistingItemOrNullAndCheckIfVisible( updatedItem, isVisibleRef )
	VisibleItemInterface_UpdateQueueItem( isVisibleRef.value, updatedItem )
}

