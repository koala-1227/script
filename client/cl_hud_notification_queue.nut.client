#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________RECEIVER_COMPONENT___________________________(){}
#endif

void function QueueReceiver_EvaluateIncomingItem( HudNotificationQueue queue, HudNotificationQueueItem incomingQueueItem )
{
	PassByReferenceBool isExistingItemVisible = { value = false }
	HudNotificationQueueItem ornull existingQueueItem = QueueReceiver_FindExistingItemOrNullAndCheckIfVisible( incomingQueueItem, isExistingItemVisible )

	if ( existingQueueItem != null )
	{
		expect HudNotificationQueueItem( existingQueueItem )

		
		bool allowUpdate = queue.receiver.allowIndirectUpdates || existingQueueItem.allowIndirectUpdates
		if ( allowUpdate )
		{
			VisibleItemInterface_UpdateQueueItem( isExistingItemVisible.value, existingQueueItem, incomingQueueItem )
		}
		else if ( queue.receiver.allowDuplicates )
		{
			QueueReceiver_AddItem( queue, incomingQueueItem )
		}
		else
		{
			Warning( format( "Found duplicate QueueItem with key %s, but updates and duplicates aren't allowed on queue %s.", incomingQueueItem.key, queue.key ) )
		}
	}
	else
	{
		QueueReceiver_AddItem( queue, incomingQueueItem )
	}
}

void function QueueReceiver_AddItem( HudNotificationQueue queue, HudNotificationQueueItem queueItem )
{
	if ( queue.queuedItems.len() > 0 )
	{
		
		for ( int idx = queue.queuedItems.len() - 1; idx >= 0; idx-- )
		{
			HudNotificationQueueItem itemToCheck = queue.queuedItems[idx]

			
			if ( itemToCheck.priority >= queueItem.priority )
			{
				queueItem.enteredQueueTime = ClientTime()
				queue.queuedItems.insert( idx + 1, queueItem )

				QueueReceiver_ResolveBacklog( queue )
				QueueBlockers_ResolveBacklogOfBlockedItems( queue )
				break
			}
			else if ( idx == 0 ) 
			{
				queueItem.enteredQueueTime = ClientTime()
				queue.queuedItems.insert( idx, queueItem )

				QueueReceiver_ResolveBacklog( queue )
				QueueBlockers_ResolveBacklogOfBlockedItems( queue )
				break
			}
		}
	}
	else
	{
		
		queueItem.enteredQueueTime = ClientTime()
		queue.queuedItems.insert( 0, queueItem )

		QueueReceiver_ResolveBacklog( queue )
		QueueBlockers_ResolveBacklogOfBlockedItems( queue )

		QueueDispatcher_ProcessQueue( queue )
	}
}

HudNotificationQueueItem ornull function QueueReceiver_FindExistingItemOrNullAndCheckIfVisible( HudNotificationQueueItem queueItem, PassByReferenceBool isVisibleRefToUpdate )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueItem.queueId )

	
	if ( queueItem.key != "" )
	{
		
		foreach ( visibleItem in queue.visibleItems )
		{
			if ( visibleItem.key == queueItem.key )
			{
				isVisibleRefToUpdate.value = true
				return visibleItem
			}
		}

		
		foreach ( preVisibleItem in queue.preVisibleItems )
		{
			if ( preVisibleItem.key == queueItem.key )
			{
				isVisibleRefToUpdate.value = false
				return preVisibleItem
			}
		}

		
		foreach ( queuedItem in queue.queuedItems )
		{
			if ( queuedItem.key == queueItem.key )
			{
				isVisibleRefToUpdate.value = false
				return queuedItem
			}
		}
	}

	return null
}














#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________DISPATCHER_COMPONENT___________________________(){}
#endif

void function QueueDispatcher_Init( HudNotificationQueue queue )
{
	if ( !queue.dispatcher.hasInitialized )
	{
		thread QueueDispatcher_MonitorForSlotRelease( queue )
	}
}

void function QueueDispatcher_ProcessQueue( HudNotificationQueue queue )
{
	
	if ( queue.dispatcher.isActivelyProcessing )
		return

	if ( queue.queuedItems.len() == 0 )
		return

	QueueDispatcher_RemoveTimedOutItems( queue )

	
	if ( queue.queuedItems.len() == 0 )
		return

	
	if ( queue.dispatcher.queueBlockers.len() > 0 )
		return

	queue.dispatcher.isActivelyProcessing = true

	thread QueueDispatcher_ProcessingWorker_Thread( queue )
}

void function QueueDispatcher_RemoveTimedOutItems( HudNotificationQueue queue )
{
	foreach ( HudNotificationQueueItem item in queue.queuedItems )
	{
		if ( item.stuckInQueueTimeOutDuration > 0 )
		{
			float timeSinceEnteredQueue = ClientTime() - item.enteredQueueTime
			if ( timeSinceEnteredQueue >= item.stuckInQueueTimeOutDuration )
			{
				queue.queuedItems.removebyvalue( item ) 
			}
		}
	}

	
	foreach ( HudNotificationQueueItem item in queue.preVisibleItems )
	{
		if ( item.stuckInQueueTimeOutDuration > 0 )
		{
			float timeSinceEnteredQueue = ClientTime() - item.enteredQueueTime
			if ( timeSinceEnteredQueue >= item.stuckInQueueTimeOutDuration )
			{
				queue.preVisibleItems.removebyvalue( item ) 
			}
		}
	}
}

void function QueueDispatcher_MonitorForSlotRelease( HudNotificationQueue queue )
{
	
	if ( queue.dispatcher.hasInitialized )
		return

	
	while ( true )
	{
		WaitSignal( queue.signalDummy, "HudNotificationQueue_Dispatcher_ItemSlotReleased", "HudNotificationQueue_QueueBlockersReleased" )
		QueueDispatcher_ProcessQueue( queue )
	}
}

void function QueueDispatcher_ProcessingWorker_Thread( HudNotificationQueue queue )
{
	EndSignal( queue.signalDummy, "HudNotificationQueue_QueueBlockerStarted" ) 

	OnThreadEnd(
		function() : ( queue )
		{
			QueueDispatcher_ProcessingComplete( queue )
		}
	)

	queue.dispatcher.isActivelyProcessing = true

	
	WaitFrame()

	bool canAddItems = true
	while ( canAddItems )
	{
		
		int visibleAndSoonToBeVisibleItemCount = queue.visibleItems.len() + queue.preVisibleItems.len()
		bool areVisibleSlotsAvailable = visibleAndSoonToBeVisibleItemCount < queue.dispatcher.maxVisibleItems

		
		bool shouldCheckMaxCount = queue.dispatcher.maxVisibleItems >= 0
		bool withinCountLimit = shouldCheckMaxCount ? areVisibleSlotsAvailable : true

		
		bool shouldCheckSizeLimit = queue.dispatcher.maxTotalSize.width > 0 || queue.dispatcher.maxTotalSize.height > 0
		bool withinSizeLimit = shouldCheckSizeLimit ? true : true 

		canAddItems = withinCountLimit && withinSizeLimit && queue.queuedItems.len() > 0

		if ( canAddItems )
		{
			HudNotificationQueueItem queueItem = queue.queuedItems[0]

			queue.queuedItems.remove( 0 ) 

			
			thread VisibleItemInterface_Thread( queue, queueItem )
		}
		else	
		{
			if ( !withinCountLimit )
				printt( format( "HNQ_D - Unable to add  more items (max item count of %s).", string( queue.dispatcher.maxVisibleItems ) ) )

			if ( !withinSizeLimit )
				printt( format( "HNQ_D - Unable to add more items (max total screenspace size of <%s, %s>).", string( queue.dispatcher.maxTotalSize.width ), string( queue.dispatcher.maxTotalSize.height ) ) )
		}

		
		if ( queue.queuedItems.len() == 0 )
		{
			canAddItems = false
		}
	}
}

void function QueueDispatcher_ProcessingComplete( HudNotificationQueue queue )
{
	queue.dispatcher.isActivelyProcessing = false
}













#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________QUEUE_BLOCKERS_COMPONENT___________________________(){}
#endif

void function HudNotificationQueue_AddQueueBlocker( int queueId, QueueBlockerFunc queueBlocker )
{
	HudNotificationQueue queue = HudNotificationQueue_GetQueueById( queueId )

	
	if ( queue.dispatcher.queueBlockers.contains( queueBlocker ) )
		return

	queue.dispatcher.queueBlockers.append( queueBlocker )

	if ( !queue.dispatcher.isQueueBlockerRunning )
	{
		queue.dispatcher.isQueueBlockerRunning = true

		
		
		QueueBlockers_ResolveBacklogOfBlockedItems( queue )

		thread QueueBlockers_ProcessBlockers_Thread( queue )
	}
}

void function QueueBlockers_ProcessBlockers_Thread( HudNotificationQueue queue )
{
	AssertIsNewThread()

	Signal( queue.signalDummy, "HudNotificationQueue_QueueBlockerStarted" )
	EndSignal( queue.signalDummy, "HudNotificationQueue_QueueBlockerStarted" )

	OnThreadEnd(
		function() : ( queue )
		{
			queue.dispatcher.isQueueBlockerRunning = false
			Signal( queue.signalDummy, "HudNotificationQueue_QueueBlockersReleased" )
		}
	)

	while ( queue.dispatcher.queueBlockers.len() > 0 )
	{
		foreach ( QueueBlockerFunc func in queue.dispatcher.queueBlockers )
		{
			if ( func() )
			{
				queue.dispatcher.queueBlockers.fastremovebyvalue( func )
			}
		}

		Assert( queue.dispatcher.queueBlockerEvaluationFrequency > 0, "Can't set a wait interval of 0 for notification queue blockers.")
		wait max( queue.dispatcher.queueBlockerEvaluationFrequency, 0.016 ) 
	}
}

void function QueueBlockers_ResolveBacklogOfBlockedItems( HudNotificationQueue queue )
{
	
	if ( !queue.dispatcher.isQueueBlockerRunning )
		return

	
	if ( queue.receiver.backlogMaxCountWhenBlocked < 0 )
		return

	
	QueueDispatcher_RemoveTimedOutItems( queue )

	
	array< HudNotificationQueueItem > sortedItems = QueueBlockers_SortBacklogForPreservationStyle( queue.queuedItems, queue.receiver.backlogPreservationStyle )

	foreach ( idx, HudNotificationQueueItem item in sortedItems )
	{
		
		if ( idx < queue.receiver.backlogMaxCountWhenBlocked )
			continue

		
		queue.queuedItems.removebyvalue( item )
	}
}


void function QueueReceiver_ResolveBacklog( HudNotificationQueue queue )
{
	if ( queue.receiver.backlogMaxCount < 0 )
		return

	if ( queue.queuedItems.len() <= queue.receiver.backlogMaxCount )
		return

	array< HudNotificationQueueItem > sortedItems = QueueBlockers_SortBacklogForPreservationStyle( queue.queuedItems, queue.receiver.backlogPreservationStyle )

	foreach ( idx, HudNotificationQueueItem item in sortedItems )
	{
		if ( idx < queue.receiver.backlogMaxCount )
			continue

		queue.queuedItems.removebyvalue( item )
	}
}

array< HudNotificationQueueItem > function QueueBlockers_SortBacklogForPreservationStyle( array< HudNotificationQueueItem > originalItems, int backlogPreservationStyle )
{
	array< HudNotificationQueueItem > clonedItems = clone originalItems

	clonedItems.sort( int function( HudNotificationQueueItem a, HudNotificationQueueItem b ) : ( backlogPreservationStyle ) {
		switch ( backlogPreservationStyle )
		{
			
			case eHudNotificationQueueBacklogPreservationStyle.FIRST_IN:

				if ( a.enteredQueueTime < b.enteredQueueTime )
					return -1
				else if ( a.enteredQueueTime > b.enteredQueueTime )
					return 1

				return 0

				break

				
			case eHudNotificationQueueBacklogPreservationStyle.LAST_IN:

				if ( a.enteredQueueTime > b.enteredQueueTime )
					return -1
				else if ( a.enteredQueueTime < b.enteredQueueTime )
					return 1

				return 0

				break

				
			case eHudNotificationQueueBacklogPreservationStyle.PRIORITY:

				if ( a.priority > b.priority )
					return -1
				else if ( a.priority < b.priority )
					return 1

				return 0

				break
		}

		return 0
	} )

	return clonedItems
}













#if INTELLIJ_OUTLINE_SECTION_MARKER
void function _____________VISIBLE_ITEM_INTERFACE_COMPONENT___________________________(){}
#endif

void function VisibleItemInterface_Thread( HudNotificationQueue queue, HudNotificationQueueItem queueItem )
{
	EndSignal( queueItem.signalDummy, "Internal_HudNotificationQueue_ClearItem" )

	OnThreadEnd(
		function() : ( queue, queueItem )
		{
			
			if ( queueItem.onDestroyVisualOverride != null )
			{
				queueItem.onDestroyVisualOverride( queueItem )
			}
			else
			{
				HudNotificationQueue_OnDestroyVisual_Base( queueItem )
			}

			queueItem.ruiInstance = null
			queueItem.ruiShell = null

			
			queue.visibleItems.removebyvalue( queueItem )	
			ItemPositioning_RemoveItem( queueItem )	

			
			if ( queueItem.onComplete != null )
			{
				queueItem.onComplete( queueItem )
			}

			
			Signal( queue.signalDummy, "HudNotificationQueue_Dispatcher_ItemSlotReleased" )
		}
	)

#if DEV
		
		if ( queueItem.onCreateVisualOverride != null && queueItem.onDestroyVisualOverride == null )
		{
			Assert( false, "Hud Notification Queue Item imlpements onCreateVisualOverride, but does not implement onDestroyVisualOverride. To prevent potential RUI leaks, custom visual creation must be accompanied by custom clean up." )
		}
#endif

	
	queue.preVisibleItems.append( queueItem )

	
	bool canProceedPastPreIntro = true
	if ( queueItem.onPreIntro.len() > 0)
	{
		foreach ( bool functionref( HudNotificationQueueItem ) preIntroFunc in queueItem.onPreIntro )
		{
			if ( !preIntroFunc( queueItem ) )
			{
				canProceedPastPreIntro = false
				break
			}
		}
	}

	if ( !canProceedPastPreIntro )
	{
		queue.preVisibleItems.fastremovebyvalue( queueItem )
		Signal( queue.signalDummy, "HudNotificationQueue_Dispatcher_ItemSlotReleased" )
		return
	}

	
	queue.preVisibleItems.removebyvalue( queueItem )
	queue.visibleItems.insert( 0, queueItem )


	
	if ( queueItem.onCreateVisualOverride != null )
	{
		queueItem.ruiInstance = queueItem.onCreateVisualOverride( queueItem )
	}
	else
	{
		HudNotificationQueue_OnCreateRuiShell_Base( queueItem ) 
		HudNotificationQueue_OnCreateVisual_Base( queueItem )
	}

	if ( queueItem.soundAliases.len() > 0 )
	{
		entity player = GetLocalViewPlayer()

		foreach ( string soundAlias in queueItem.soundAliases )
		{
			if ( soundAlias.len() != 0 )
			{
				EmitSoundOnEntity( player, soundAlias )
			}
		}
	}

	if ( queueItem.speakerDialogueLines.len() > 0 )
	{
		foreach ( string soundAlias in queueItem.speakerDialogueLines )
		{
			if ( soundAlias.len() != 0 )
			{
				int aliasID = GetAnyAliasIdForName( soundAlias )
				if ( aliasID >= 0 )
				{
					SCB_PlayDialogueOnEnvironmentSpeakers( aliasID, NUM_NEARBY_SPEAKERS_TO_PLAY_FROM, 0, -1, null, -1 )
				}
				else
				{
					Warning( "Dialogue line " + soundAlias + " is not registered" )
				}
			}
		}
	}

	
	if ( queue.itemPositioning.enabled )
	{
		Signal( queue.signalDummy, "ItemPositioning_UpdatePositions" )
	}

	
	if ( queueItem.onIntroOverride != null )
	{
		queueItem.onIntroOverride( queueItem )
	}
	else
	{
		HudNotificationQueue_OnIntro_Base( queueItem )
	}

	
	queueItem.timeToStartOutro = Time() + queueItem.duration
	while ( Time() < queueItem.timeToStartOutro )
	{
		WaitFrame()
	}

	if ( queueItem.onPreOutro != null )
	{
		
		bool canProceedPastPreOutro = queueItem.onPreOutro( queueItem )

		
		while ( !canProceedPastPreOutro )
		{
			canProceedPastPreOutro = queueItem.onPreOutro( queueItem )
			WaitFrame()
		}
	}

	
	if ( queueItem.onOutroOverride != null )
	{
		queueItem.onOutroOverride( queueItem )
	}
	else
	{
		HudNotificationQueue_OnOutro_Base( queueItem )
	}

	
	wait queueItem.outroDuration

	
}

void function VisibleItemInterface_SetRuiArgs( var rui, table< string, HudNotificationQueueRuiArg > ruiArgsTable )
{
	if ( !RuiIsAlive( rui ) )
		return

	foreach ( argName, ruiArg in ruiArgsTable )
	{
		
		var argValue = ruiArg.argValue

		
		if ( ruiArg.argType < 0 )
		{
			switch ( type( argValue ) )
			{
				case "string":
					ruiArg.argType = eRuiArgType.STRING
					break

				case "float":
					ruiArg.argType = eRuiArgType.FLOAT
					break

				case "int":
					ruiArg.argType = eRuiArgType.INT
					break

				case "bool":
					ruiArg.argType = eRuiArgType.BOOL
					break

				case "vector":
					ruiArg.argType = eRuiArgType.VECTOR
					break

				case "asset":
					ruiArg.argType = eRuiArgType.ASSET
					break

				default:
					Assert( false, format( "Couldn't infer RUI arg type: %s. You may need to explicitly define the argument type with HudNotificationQueueRuiArg.argType.", type( argValue ) ) )
			}
		}

		switch ( ruiArg.argType )
		{
			case eRuiArgType.STRING:
				expect string( argValue )
				RuiSetStringIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.FLOAT:
				expect float( argValue )
				RuiSetFloatIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.INT:
				expect int( argValue )
				RuiSetIntIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.BOOL:
				expect bool( argValue )
				RuiSetBoolIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.FLOAT2:
				expect vector( argValue )
				RuiSetFloat2IfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.VECTOR:
				expect vector( argValue )
				RuiSetFloat3IfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.COLOR:
				expect vector( argValue )

				float alpha = 1.0

				
				array<var> addlArgValues = ruiArg.addlArgValues
				if ( addlArgValues.len() > 0 )
				{
					var addlArgValue = addlArgValues[0]
					if ( addlArgValue != null && type( addlArgValue ) == "float" )
					{
						expect float( addlArgValue )
						alpha = addlArgValue
					}
				}

				RuiSetColorAlphaIfExists( rui, ruiArg.argName, SrgbToLinear( argValue ), alpha )
				break

			case eRuiArgType.ASSET:
				expect asset( argValue )
				RuiSetAssetIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.IMAGE:
				expect asset( argValue )
				RuiSetImageIfExists( rui, ruiArg.argName, argValue )
				break

			case eRuiArgType.WALLTIME:
			case eRuiArgType.GAMETIME:
				expect float( argValue )
				RuiSetGameTimeIfExists( rui, ruiArg.argName, argValue )
				break

			default:
				Assert( false, format( "Couldn't infer RUI arg type: %s. You may need to explicitly define the argument type with HudNotificationQueueRuiArg.argType.", type( argValue ) ) )
		}

	}
}

void function VisibleItemInterface_UpdateQueueItem( bool isItemVisible, HudNotificationQueueItem oldItem, HudNotificationQueueItem ornull newItem = null )
{
	if ( oldItem.onUpdateOverride != null )
	{
		oldItem.onUpdateOverride( isItemVisible, oldItem, newItem )
	}
	else
	{
		HudNotificationQueue_OnUpdate_Base( isItemVisible, oldItem, newItem )
	}
}














