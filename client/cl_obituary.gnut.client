void function OnSpectatorTagModeChanged( entity player, int newMode )
{
	if ( GetCurrentPlaylistVarBool( NAMETAG_RANGE_OBITUARY_PRINTS, true ) )
	{
		switch ( newMode )
		{
			case OBS_PLAYERTAG_RANGE_NONE:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_NONE" ) )
				break

			case OBS_PLAYERTAG_RANGE_TEAM:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_TEAM" ) )
				break

			case OBS_PLAYERTAG_RANGE_SMALL:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_SMALL" ) )
				break

			case OBS_PLAYERTAG_RANGE_MEDIUM:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_MEDIUM" ) )
				break

			case OBS_PLAYERTAG_RANGE_LARGE:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_LARGE" ) )
				break

			case OBS_PLAYERTAG_RANGE_INFINITE:
				Obituary_Print_Localized( Localize( "#NOTIFY_PLAYERTAG_RANGE_INFINITE" ) )
				break
		}
	}
}



#if DEV
void function DEV_Debug_ObitTagItemType( HudNotificationQueueItem item, string obitType )
{
	item.miscArgs["debugObitType"] <- obitType

	if ( obitType == "ShieldBreak" )        file.debugTypeShieldBreak[0]++
	else if ( obitType == "PlayerDeath" )    file.debugTypePlayerDeath[0]++
	else if ( obitType == "SquadWipe" )      file.debugTypeSquadWipe[0]++
	else if ( obitType == "SquadLanded" )    file.debugTypeSquadLanded[0]++
	else if ( obitType == "KillLeader" )     file.debugTypeKillLeader[0]++
	else                                     file.debugTypeOtherLocalized[0]++
}

void function DEV_Debug_ObitTrackItemDisplayed( HudNotificationQueueItem item )
{
	if ( !( "debugObitType" in item.miscArgs ) )
		return

	string obitType = expect string( item.miscArgs["debugObitType"] )
	if ( obitType == "ShieldBreak" )        file.debugTypeShieldBreak[1]++
	else if ( obitType == "PlayerDeath" )    file.debugTypePlayerDeath[1]++
	else if ( obitType == "SquadWipe" )      file.debugTypeSquadWipe[1]++
	else if ( obitType == "SquadLanded" )    file.debugTypeSquadLanded[1]++
	else if ( obitType == "KillLeader" )     file.debugTypeKillLeader[1]++
	else                                     file.debugTypeOtherLocalized[1]++
}

string function DEV_Debug_ObitClassifyLocalized( string localizedPrint, int obitFlags )
{
	if ( (obitFlags & OBIT_FLAG_SQUAD_WIPE) != 0 )
		return "SquadWipe"
	else if ( (obitFlags & OBIT_FLAG_ENEMY_NEARBY) != 0 )
		return "SquadLanded"
	else if ( (obitFlags & OBIT_FLAG_KILL_LEADER) != 0 )
		return "KillLeader"
	else if ( localizedPrint.find( "Shield Broken" ) >= 0 || localizedPrint.find( "SHIELD" ) >= 0 )
		return "ShieldBreak"

	return "OtherLocalized"
}

void function DEV_Debug_ObitQueueDisplayDebug()
{
	int visibleCount = HudNotificationQueue_GetVisibleItems( file.hnqQueueId ).len()

	printt( "[Obit Que Display Debug:] ========================================" )
	printt( "[Obit Que Display Debug:] OBITUARY QUEUE DEBUG SUMMARY" )
	printt( "[Obit Que Display Debug:] ========================================" )
	printt( "[Obit Que Display Debug:] Max visible (playlist):  " + file.maxObitEntries )
	printt( "[Obit Que Display Debug:] Currently visible:       " + visibleCount )
	printt( "[Obit Que Display Debug:] Obituary duration:       " + file.obituaryDuration )
	printt( "[Obit Que Display Debug:] Obituaries enabled:      " + file.obituariesEnabled )
	printt( "[Obit Que Display Debug:] Modal visible (blocked): " + modalVisible )
	printt( "[Obit Que Display Debug:] ----------------------------------------" )
	int pendingInBacklog = file.debugObitDisplayed - file.debugObitCompleted
	if ( pendingInBacklog < 0 )
		pendingInBacklog = 0
	int actualDropped = file.debugObitRequested - file.debugObitDisplayed - pendingInBacklog
	if ( actualDropped < 0 )
		actualDropped = 0

	printt( "[Obit Que Display Debug:] Total requested:          " + file.debugObitRequested )
	printt( "[Obit Que Display Debug:] Total displayed:          " + file.debugObitDisplayed )
	printt( "[Obit Que Display Debug:] Total completed:          " + file.debugObitCompleted )
	printt( "[Obit Que Display Debug:] Pending in backlog:       " + pendingInBacklog )
	printt( "[Obit Que Display Debug:] Actual dropped (by HNQ):  " + actualDropped )
	printt( "[Obit Que Display Debug:] ----------------------------------------" )

	if ( file.debugObitRequested > 0 )
	{
		float dropRate = float( actualDropped ) / float( file.debugObitRequested ) * 100.0
		printt( "[Obit Que Display Debug:] Drop rate: " + dropRate + "%" )
	}

	printt( "[Obit Que Display Debug:] ----------------------------------------" )
	printt( "[Obit Que Display Debug:] Visible items detail:" )
	array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )
	foreach ( index, queueItem in visibleItems )
	{
		int itemOffset = ( "obituaryOffset" in queueItem.miscArgs ) ? expect int( queueItem.miscArgs["obituaryOffset"] ) : -1
		printt( "[Obit Que Display Debug:]   [" + index + "] Priority: " + queueItem.priority + " | Offset: " + itemOffset + " | Key: " + queueItem.key + " | Asset: " + string( queueItem.ruiAsset ) )
	}
	printt( "[Obit Que Display Debug:] ========================================" )
}

void function DEV_Debug_ObitQueueDisplayHUD()
{
	file.debugHUDActive = !file.debugHUDActive
	if ( !file.debugHUDActive )
		return

	thread DEV_Debug_ObitQueueDisplayHUD_Think()
}

void function DEV_Debug_ObitQueueDisplayHUD_Think()
{
	float startX     = 0.01
	float startY     = 0.30
	float lineHeight = 0.024
	float fontSize   = 20.0
	vector white     = COLOR_WHITE
	vector green     = COLOR_GREEN
	vector yellow    = COLOR_YELLOW
	vector red       = COLOR_RED
	vector blue      = COLOR_CYAN

	while ( file.debugHUDActive )
	{
		int visibleCount = HudNotificationQueue_GetVisibleItems( file.hnqQueueId ).len()
		int requested = file.debugObitRequested
		int displayed = file.debugObitDisplayed
		int completed = file.debugObitCompleted
		int pending = displayed - completed
		if ( pending < 0 )
			pending = 0
		int dropped = requested - displayed - pending
		if ( dropped < 0 )
			dropped = 0
		float dropRate = requested > 0 ? float( dropped ) / float( requested ) * 100.0 : 0.0

		float y = startY

		
		DebugDrawScreenTextFull( startX, y, "=== OBIT QUEUE DEBUG HUD ===", blue, fontSize, -1.0 )
		y += lineHeight

		
		DebugDrawScreenTextFull( startX, y, format( "Visible: %d/%d | Pending: %d | Duration: %.1fs", visibleCount, file.maxObitEntries, file.obitsPendingDispatch, file.obituaryDuration ), white, fontSize, -1.0 )
		y += lineHeight

		
		vector dropColor = dropRate > 40 ? red : ( dropRate > 20 ? yellow : green )
		DebugDrawScreenTextFull( startX, y, format( "Req: %d | Disp: %d | Drop: %d (%.1f%%)", requested, displayed, dropped, dropRate ), dropColor, fontSize, -1.0 )
		y += lineHeight * 1.5

		
		DebugDrawScreenTextFull( startX, y, format( "%-18s %5s %5s %5s", "TYPE", "REQ", "DISP", "DROP" ), blue, fontSize, -1.0 )
		y += lineHeight

		
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Player Death", file.debugTypePlayerDeath, fontSize, white )
		y += lineHeight
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Shield Break", file.debugTypeShieldBreak, fontSize, white )
		y += lineHeight
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Squad Wipe", file.debugTypeSquadWipe, fontSize, white )
		y += lineHeight
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Squad Landed", file.debugTypeSquadLanded, fontSize, white )
		y += lineHeight
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Kill Leader", file.debugTypeKillLeader, fontSize, white )
		y += lineHeight
		DEV_Debug_ObitHUD_DrawTypeRow( startX, y, "Other", file.debugTypeOtherLocalized, fontSize, white )
		y += lineHeight * 1.5

		
		string stateStr = ""
		if ( !file.obituariesEnabled ) stateStr += " [DISABLED]"
		if ( modalVisible ) stateStr += " [MODAL]"
		if ( stateStr == "" ) stateStr = " [ACTIVE]"
		DebugDrawScreenTextFull( startX, y, "State:" + stateStr, green, fontSize, -1.0 )

		WaitFrame()
	}
}

void function DEV_Debug_ObitHUD_DrawTypeRow( float x, float y, string label, array<int> counts, float fontSize, vector color )
{
	int req = counts[0]
	int disp = counts[1]
	int drop = req - disp
	if ( drop < 0 )
		drop = 0

	vector rowColor = color
	if ( req > 0 && drop > 0 )
		rowColor = <1, 0.7, 0.4> 

	DebugDrawScreenTextFull( x, y, format( "%-18s %5d %5d %5d", label, req, disp, drop ), rowColor, fontSize, -1.0 )
}






void function DEV_Debug_ObitBurstTest( int count = 30, float staggerOverride = -1.0 )
{
	if ( staggerOverride > 0.0 )
	{
		file.obituaryStaggerStep = staggerOverride
		file.obituaryDynamicDurationEnabled = true
	}

	ObitRankBadgeInfo emptyBadge

	for ( int i = 0; i < count; i++ )
	{
		int roll = RandomIntRange( 0, 7 )

		switch ( roll )
		{
			case 0:
				Obituary_Print_PlayerDeath( "TestPlayer", $"", "Melee", $"", "Bot" + i, emptyBadge )
				break
			case 1:
				Obituary_Print_Localized( "Enemy Shield Broken  -  Bot" + i )
				break
			case 2:
				Obituary_Print_Localized( "You Eliminated An Enemy Squad", <255, 244, 79>, COLOR_OBITUARY_DEFAULT, COLOR_OBITUARY_DEFAULT, COLOR_OBITUARY_DEFAULT, 0, false, OBIT_FLAG_SQUAD_WIPE )
				break
			case 3:
				Obituary_Print_Localized( "Bot" + i + " - Squad landed nearby!", <255, 255, 255>, <255, 255, 255>, <255, 255, 255>, <255, 255, 255>, 0.0, false, OBIT_FLAG_ENEMY_NEARBY )
				break
			case 4:
				Obituary_Print_Localized( "TestPlayer is the new Kill Leader with " + (i + 5) + " kills.", <255, 255, 255>, <255, 255, 255>, <255, 255, 255>, <255, 255, 255>, 0.0, false, OBIT_FLAG_KILL_LEADER )
				break
			case 5:
				Obituary_Print_Training_Ping( "Training: Move to the marked location" )
				break
			case 6:
				Obituary_Print_Localized( "Bot" + i + " has entered the game" )
				break
		}
	}
}

#endif
