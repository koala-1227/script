void function Obituary_HNQ_SetItemOffset( HudNotificationQueueItem item, int newOffset )
{
	if ( item.ruiInstance == null || !RuiIsAlive( item.ruiInstance ) )
		return

	int currentOffset = ( "obituaryOffset" in item.miscArgs ) ? expect int( item.miscArgs["obituaryOffset"] ) : -1

	if ( currentOffset != newOffset )
	{
		item.miscArgs["obituaryOffset"] <- newOffset
		RuiSetInt( item.ruiInstance, "offset", newOffset )
		RuiSetInt( item.ruiInstance, "horizontalOffset", file.horizontalOffset )
		RuiSetInt( item.ruiInstance, "verticalOffset", file.verticalOffset )
		RuiSetGameTime( item.ruiInstance, "updateTime", Time() )
	}
}

void function TriggerObituaryInvisible()
{
	modalVisible = true
	Obituary_SetVerticalOffset(MODAL_OFFSET)

	
	Obituary_ClearObituaryMessagesExceptPing()

	
	
	if ( file.obituaryDynamicDurationEnabled )
	{
		HudNotificationQueue_AddQueueBlocker( file.hnqQueueId, Obituary_HNQ_QueueBlocker_ModalVisible )
	}
}

void function Obituary_ClearObituaryMessagesExceptPing()
{
	if ( !file.obituaryDynamicDurationEnabled )
	{
		array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )
		foreach ( item in visibleItems )
		{
			if ( item.ruiAsset != $"ui/obituary_crawl_localized_tutorial.rpak" )
				Signal( item.signalDummy, "Internal_HudNotificationQueue_ClearItem" )
		}
	}
}

void function TriggerResetOffset()
{
	Obituary_SetVerticalOffset(STANDARD_OFFSET)
	modalVisible = false
}



