void function Obituary_HNQ_Print_Training_Ping( string localizedPrint, vector altColor1, vector altColor2, vector altColor3, bool bCheckForDuplicateEntry, int obitFlags = 0 )
{
	
	if ( !file.obituaryDynamicDurationEnabled && bCheckForDuplicateEntry )
	{
		array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )
		foreach ( existingItem in visibleItems )
		{
			if ( "duplicateCheckString" in existingItem.miscArgs && expect string( existingItem.miscArgs["duplicateCheckString"] ) == localizedPrint )
				return
		}
	}

#if DEV
		file.debugObitRequested++
#endif

	
	if ( !file.obituaryDynamicDurationEnabled && modalVisible )
	{
		Obituary_SetVerticalOffset( MODAL_OFFSET )
	}

	string itemKey = bCheckForDuplicateEntry ? localizedPrint : ""

	HudNotificationQueueItem item = HudNotificationQueue_CreateEmptyItem()
	item.key = itemKey
	item.priority = OBITUARY_PRIORITY_TRAINING_PING
	item.duration = file.obituaryDuration
	item.outroDuration = 0.0
	item.ruiAsset = $"ui/obituary_crawl_localized_tutorial.rpak"

	item.onCreateVisualOverride = Obituary_HNQ_OnCreateVisualOverride
	item.onDestroyVisualOverride = Obituary_HNQ_OnDestroyVisualOverride

	item.onIntro = Obituary_HNQ_OnVisibleListChanged_CallBack
	item.onComplete = Obituary_HNQ_OnVisibleListChanged_CallBack

	
	item.ruiArgs["obitString"] <- HudNotificationQueue_CreateRuiArg( "obitString", localizedPrint )
	item.ruiArgs["string1Color"] <- HudNotificationQueue_CreateRuiArg( "string1Color", SrgbToLinear( altColor1 / 255.0 ) )
	item.ruiArgs["string2Color"] <- HudNotificationQueue_CreateRuiArg( "string2Color", SrgbToLinear( altColor2 / 255.0 ) )
	item.ruiArgs["string3Color"] <- HudNotificationQueue_CreateRuiArg( "string3Color", SrgbToLinear( altColor3 / 255.0 ) )
	item.ruiArgs["showObitsDuringSpectate"] <- HudNotificationQueue_CreateRuiArg( "showObitsDuringSpectate", GetCurrentPlaylistVarBool( "show_obits_during_spectate", true ) )
	item.ruiArgs["isVisible"] <- HudNotificationQueue_CreateRuiArg( "isVisible", !ObituaryHudIsDisabled() )

	
	if ( bCheckForDuplicateEntry )
		item.miscArgs["duplicateCheckString"] <- localizedPrint

	Obituary_HNQ_EvictOldestIfFull()
	item.miscArgs["requestTime"] <- Time()
	HudNotificationQueue_QueueItem( file.hnqQueueId, item, ePersistenceContext.GLOBAL )
	file.lastObitQueueTime = Time()
	file.obitsPendingDispatch++
}

void function Obituary_HNQ_OnVisibleListChanged_CallBack( HudNotificationQueueItem item )
{
	Obituary_HNQ_UpdateAllVisiblePositions()
}

void function Obituary_HNQ_UpdateAllVisiblePositions()
{
	if ( file.hnqQueueId < 0 )
		return

	array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )

	
	int baseOffset = file.indexOffest
	if ( IsPVEMode() )
	{
		baseOffset += 1
	}
	if ( GetConVarInt( "net_netGraph2" ) == 1 )
	{
		baseOffset += 2
	}


		if ( GameMode_IsActive( eGameModes.CONTROL ) )
		{
			Obituary_HNQ_UpdateAllVisiblePositions_ControlMode( visibleItems, baseOffset )
			return
		}


	
	foreach ( index, queueItem in visibleItems )
	{
		Obituary_HNQ_SetItemOffset( queueItem, baseOffset + index )
	}
}

void function Obituary_Print_PlayerDeath( string attackerString, asset weaponIcon, string weaponDisplayName, asset modifierIcon, string victimString, ObitRankBadgeInfo badgeInfo, vector attackerColor = <255,255,255>, vector victimColor = <255,255,255>, vector weaponColor = <255,255,255>, bool tempIsMainWeapon = false, int obitFlags = 0 )
{
	if ( !file.obituariesEnabled )
		return

	if ( GetCurrentPlaylistVarBool( "obituary_filters_enabled", true ) && file.obituaryFilter > 0 && ( file.obituaryFilter & obitFlags ) == 0 )
		return

	if ( !file.obituaryDynamicDurationEnabled && modalVisible )
		return

	Obituary_HNQ_Print_PlayerDeath( attackerString, weaponIcon, weaponDisplayName, modifierIcon, victimString, badgeInfo, attackerColor, victimColor, weaponColor, tempIsMainWeapon )
}

