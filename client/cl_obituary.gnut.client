const string OBITUARY_HNQ_QUEUE_KEY = "obituary_queue"










const int OBITUARY_PRIORITY_CONTROL_OBJECTIVE = eHudNotificationQueuePriority.CRITICAL
const int OBITUARY_PRIORITY_TRAINING_PING = eHudNotificationQueuePriority.CRITICAL
const int OBITUARY_PRIORITY_ENEMY_NEARBY = eHudNotificationQueuePriority.HIGH
const int OBITUARY_PRIORITY_SQUAD_WIPE = eHudNotificationQueuePriority.MEDIUM
const int OBITUARY_PRIORITY_PLAYER_DEATH = eHudNotificationQueuePriority.MEDIUM
const int OBITUARY_PRIORITY_LOCALIZED = eHudNotificationQueuePriority.MEDIUM

