void function ClObituary_Init()
{
	AddOnSpectatorTagModeChangedCallback( OnSpectatorTagModeChanged )
	file.maxObitEntries = GetCurrentPlaylistVarInt("max_obit_entries", MAX_OBITUARY_ENTRIES)
	file.obituaryDuration = GetCurrentPlaylistVarFloat("obituary_duration", OBITUARY_DURATION)
	file.obituaryStaggerStep = GetCurrentPlaylistVarFloat("obituary_stagger_step", file.obituaryStaggerStep)
	file.obituaryDynamicDurationEnabled = GetCurrentPlaylistVarBool("obituary_dynamic_duration_enabled", true)

	Obituary_HNQ_RegisterQueue()
}




void function Obituary_HNQ_RegisterQueue()
{
	file.hnqQueueId = HudNotificationQueue_CreateAndRegisterQueue( OBITUARY_HNQ_QUEUE_KEY )

	HudNotificationQueueConfiguration config = HudNotificationQueue_GetConfigure( file.hnqQueueId )

	
	config.allowDirectUpdates = true
	config.allowIndirectUpdates = false
	config.allowDuplicates = true

	
	config.maxVisibleItems = file.maxObitEntries  

	
	
	
	if ( file.obituaryDynamicDurationEnabled )
	{
		config.backlogMaxCount = -1
	}
	else
	{
		config.backlogMaxCount = file.maxObitEntries
		config.backlogPreservationStyle = eHudNotificationQueueBacklogPreservationStyle.LAST_IN
	}
	config.backlogMaxCountWhenBlocked = 40

	
	config.itemPositioningEnabled = false

	
	config.pauseOnLocalPlayerDeath = false

	HudNotificationQueue_Configure( file.hnqQueueId, config )
}


bool function Obituary_HNQ_QueueBlocker_ModalVisible()
{
	return !modalVisible
}


bool function Obituary_HNQ_QueueBlocker_ObituariesEnabled()
{
	return file.obituariesEnabled
}




void function Obituary_HNQ_EvictOldestIfFull()
{
	array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )

	
	
	int pendingCount = file.obituaryDynamicDurationEnabled ? file.obitsPendingDispatch : 0
	int totalCount = visibleItems.len() + pendingCount
	if ( totalCount < file.maxObitEntries )
		return

	if ( visibleItems.len() == 0 )
		return

	if ( file.obituaryDynamicDurationEnabled )
	{
		
		Signal( visibleItems[ visibleItems.len() - 1 ].signalDummy, "Internal_HudNotificationQueue_ClearItem" )
	}
	else
	{
		
		int slotsNeeded = (totalCount + 1) - file.maxObitEntries
		int toEvict = slotsNeeded < visibleItems.len() ? slotsNeeded : visibleItems.len()

		for ( int i = 0; i < toEvict; i++ )
		{
			int idx = visibleItems.len() - 1 - i
			if ( idx >= 0 )
				Signal( visibleItems[idx].signalDummy, "Internal_HudNotificationQueue_ClearItem" )
		}
	}
}





var function Obituary_HNQ_OnCreateVisualOverride( HudNotificationQueueItem item )
{
	
	if ( file.obitsPendingDispatch > 0 )
		file.obitsPendingDispatch--

	float now = Time()
	float requestTime = ( "requestTime" in item.miscArgs ) ? expect float( item.miscArgs["requestTime"] ) : now
	float adjustedDuration = file.obituaryDuration

	
	
	
	bool isImmuneToCascade = ( "objectiveWaypoint" in item.miscArgs )
	if ( file.obituaryDynamicDurationEnabled && !isImmuneToCascade )
	{
		float age = now - requestTime
		bool hasBacklogPressure = age > 0.1 || file.obitsPendingDispatch > 0

		if ( hasBacklogPressure )
		{
			int visibleCount = HudNotificationQueue_GetVisibleItems( file.hnqQueueId ).len()
			int position = visibleCount - 1
			if ( position < 0 )
				position = 0

			float step = file.obituaryStaggerStep
			float staggerOffset = position * step
			adjustedDuration = step + staggerOffset

			if ( file.holdUntilDurationOnBacklogClear )
			{
				item.onPreOutro = Obituary_HNQ_OnPreOutro_HoldOnCatchUp
			}
		}
	}

#if DEV
		file.debugObitDisplayed++
		DEV_Debug_ObitTrackItemDisplayed( item )
#endif

	var rui = CreatePermanentCockpitPostFXRui( item.ruiAsset, HUD_Z_BASE )

	if ( ObituaryHudIsDisabled() )
		RuiSetBool( rui, "isVisible", false )

	RuiSetGameTime( rui, "startTime", now )
	RuiSetGameTime( rui, "updateTime", now )

	RuiSetFloat( rui, "duration", adjustedDuration )

	
	item.duration = adjustedDuration
	item.timeToStartOutro = now + adjustedDuration

	RuiSetInt( rui, "offset", 0 )
	RuiSetInt( rui, "horizontalOffset", file.horizontalOffset )
	RuiSetInt( rui, "verticalOffset", file.verticalOffset )

	
	item.miscArgs["obituaryOffset"] <- -1
	item.miscArgs["dispatchTime"] <- now

	HudNotificationQueue_SetRuiArgs( rui, item.ruiArgs )

	return rui
}

void function Obituary_HNQ_OnDestroyVisualOverride( HudNotificationQueueItem item )
{
	
	
	
	int visibleCount = HudNotificationQueue_GetVisibleItems( file.hnqQueueId ).len()
	bool burstIsOver = ( Time() - file.lastObitQueueTime ) > 0.1

	if ( visibleCount < file.maxObitEntries && file.obitsPendingDispatch > 0 && burstIsOver )
		file.obitsPendingDispatch = 0

#if DEV
		file.debugObitCompleted++
#endif

	
	if ( item.ruiInstance != null )
	{
		RuiDestroyIfAlive( item.ruiInstance )
		item.ruiInstance = null
	}
}


bool function Obituary_HNQ_OnPreOutro_HoldOnCatchUp( HudNotificationQueueItem item )
{
	float dispatchTime = ( "dispatchTime" in item.miscArgs ) ? expect float( item.miscArgs["dispatchTime"] ) : 0.0
	if ( (Time() - dispatchTime) >= file.obituaryDuration )
		return true

	int backlogCount = HudNotificationQueue_GetQueueItemCount( file.hnqQueueId )
	if ( backlogCount > 0 )
		return true

	
	int visibleCount = HudNotificationQueue_GetVisibleItems( file.hnqQueueId ).len()
	if ( visibleCount < file.maxObitEntries )
		return false

	
	if ( !( "holdExtended" in item.miscArgs ) )
	{
		item.miscArgs["holdExtended"] <- true
		if ( item.ruiInstance != null && RuiIsAlive( item.ruiInstance ) )
		{
			float remainingTime = file.obituaryDuration - (Time() - dispatchTime)
			RuiSetFloat( item.ruiInstance, "duration", remainingTime )
			RuiSetGameTime( item.ruiInstance, "startTime", Time() - OBITUARY_INTRO_ANIMATION_DURATION )
			RuiSetGameTime( item.ruiInstance, "updateTime", Time() )
		}
	}

	return false
}

