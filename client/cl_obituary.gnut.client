}

ObitEntityInfo function Obituary_GetEntityInfo( entity ent, int damageSourceId, bool isAttacker )
{
	ObitEntityInfo info

	if ( !IsValid( ent ) )
	{
		string name = GetAttackerDisplayNamesDamageSourceId( damageSourceId )
		info.displayColor = GetKeyColor( COLORID_ENEMY ) 
		info.displayName = name

		return info
	}

	AttackerDisplayNameStruct names = GetAttackerDisplayNamesFromClassname( ent, isAttacker )
	info.displayName = names.attackerName
	info.petDisplayName = names.attackerPetName

	entity localViewPlayer = GetLocalViewPlayer()
	entity localClientPlayer = GetLocalClientPlayer()
	int entTeam = ent.GetTeam()
	int localViewPlayerTeam = localViewPlayer.GetTeam()

	if ( ent.IsNPC() )
	{
		info.displayColor = <255, 255, 255>
	}
	else
	{
		if ( GetCurrentPlaylistVarBool( "show_team_color_obituary", false) && ent.IsPlayer() )
		{
			info.displayColor = GetPlayerInfoColor( ent )

				if ( GetCurrentPlaylistVarBool( "show_team_color_obituary_enemies_red", false) && !IsFriendlyTeam( localViewPlayerTeam, entTeam ) )
				{
					info.displayColor = TEAM_COLOR_ENEMY
				}
		}
		else
		{
			info.displayColor = localViewPlayerTeam == entTeam ? GetPlayerInfoColor( ent ) : <255, 255, 255>
		}
	}

	
	if ( AllianceProximity_IsUsingAlliances() )
	{
		if ( !AllianceProximity_IsTeamInAnAlliance( entTeam ) ) 
		{
			info.displayColor = <255, 255, 255>
		}
		else if ( GamemodeUtility_IsPlayerOnTeamObserver( localClientPlayer )  ) 
		{
			info.displayColor = Teams_GetTeamColor( entTeam ) * 255
		}
		else if ( localViewPlayerTeam != entTeam && IsFriendlyTeam( localViewPlayerTeam, entTeam ) ) 
		{
			info.displayColor = TEAM_COLOR_FRIENDLY
		}

		






	}

	return info
}


void function Obituary( entity attacker, string attackerClass, entity victim, int scriptDamageType, int damageSourceId, int obitFlags, bool victimIsOwnedTitan = false, bool forceDisplay = false )
{
	if ( GetConVarInt( "hud_setting_showObituary" ) == 0 )
		return

	bool isHeadShot = (obitFlags & OBIT_FLAG_HEADSHOT) > 0
	bool isDownShot = (obitFlags & OBIT_FLAG_DOWNED) > 0

	if ( !forceDisplay )
	{
		if ( victim.IsPlayer() )
		{
			
			if ( OBITUARY_ENABLED_PLAYERS == 0 )
				return
		}
		else if ( victim.IsTitan() )
		{
			
			if ( OBITUARY_ENABLED_NPC_TITANS == 0 )
				return
		}
		else
		{
			
			if ( OBITUARY_ENABLED_NPC == 0 )
				return
		}
	}

	if ( damageSourceId == eDamageSourceId.round_end )
		return

	
	
	

	bool isRelatedAttacker = (victim.GetTeam() == GetLocalClientPlayer().GetTeam())
	ObitEntityInfo attackerInfo = Obituary_GetEntityInfo( attacker, damageSourceId, isRelatedAttacker )
	ObitEntityInfo victimInfo = Obituary_GetEntityInfo( victim, damageSourceId, false )
	bool isDeathSuicide = IsSuicide( attacker, victim, damageSourceId )

	
	if ( isDeathSuicide && victim.IsNPC() )
		return

	string sourceDisplayName = ""

	bool isMainWeapon = false
	string damageRef = GetRefFromDamageSourceID( damageSourceId )
	if ( SURVIVAL_Loot_IsRefValid( damageRef ) )
	{
		LootData lootData = SURVIVAL_Loot_GetLootDataByRef( damageRef )
		isMainWeapon = lootData.lootType == eLootType.MAINWEAPON
	}
	else if ( GetIsAdditionalMainWeapon( damageSourceId ) )
	{
		isMainWeapon = true
	}

	sourceDisplayName = GetObitFromDamageSourceID( damageSourceId )
#if DEV
		printt( FUNC_NAME() + "(): ----- Kill Weapon Info:" )
		printt( FUNC_NAME() + "(): damageSourceID == " + damageSourceId  )
		printt( FUNC_NAME() + "(): sourceDisplayName == " + sourceDisplayName  )
#endif


	int damageSourceId_ToUse = damageSourceId

	
	if( IsValid( attacker ) && !attacker.IsPlayer() && GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		if( !PLV_FiringRange_DummieObits_On() )
			return

		string ornull attackerClassName = attacker.GetNetworkedClassName()
		if( attackerClassName != null )
		{
			expect string( attackerClassName )
			bool isDummie = attackerClassName.find( "dummie" ) >= 0
			if( isDummie )
			{
				attackerInfo.displayName = Localize( "#FRDUMMIE" )
				attackerInfo.displayColor = COLOR_RED

				
				if( sourceDisplayName.find( "lstar" ) >= 0 )
				{
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_lstar
				}
				else if( sourceDisplayName.find( "THERMITE" ) >= 0 )
				{
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_thermite_grenade
				}
				else if( sourceDisplayName.find( "shotgun" ) >= 0 )
				{
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_energy_shotgun
				}
				else if( sourceDisplayName.find( "melee" ) >= 0 )
				{
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_melee_survival
				}
				else if( sourceDisplayName.find( "hemlock" ) >= 0 )
				{
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_hemlok
				}
				else
				{
#if DEV
						printt( FUNC_NAME() + "(): Damage Source Unknown:" + sourceDisplayName  )
#endif
					damageSourceId_ToUse = eDamageSourceId.mp_weapon_hemlok
					
				}
				
				sourceDisplayName = GetObitFromDamageSourceID( damageSourceId_ToUse )
				isMainWeapon = true
			}
		}
	}

	
	
	

	bool printDebugInfo = false
	string debugSourceDisplayName = sourceDisplayName

	if ( sourceDisplayName == "" )
	{
		debugSourceDisplayName = GetObitFromDamageSourceID( eDamageSourceId.damagedef_unknownBugIt )
		printDebugInfo = true
	}

	if ( attackerInfo.displayName == "" )
	{
		printDebugInfo = true
	}

	if ( victimInfo.displayName == "" )
	{
		printDebugInfo = true
	}

	if ( printDebugInfo )
	{
		printt( "------------------------------------------" )
		printt( " FULL OBITUARY INFO COULD NOT BE RESOLVED " )
		printt( "    attacker:", attacker )
		if ( IsValid( attacker ) )
		{
			printt( "    attacker classname:", attacker.GetNetworkedClassName() )
			entity attackerOwner = attacker.GetOwner()
			printt( "    attackerOwner:", attackerOwner )
			if ( IsValid( attackerOwner ) )
				printt( "    attackerOwner classname:", attackerOwner.GetNetworkedClassName() )
		}
		printt( "    victim:", victim )
		if ( IsValid( victim ) )
		{
			printt( "    victim classname:", victim.GetNetworkedClassName() )
			entity victimOwner = victim.GetOwner()
			printt( "    victimOwner:", victimOwner )
			if ( IsValid( victimOwner ) )
				printt( "    victimOwner classname:", victimOwner.GetNetworkedClassName() )
		}
		printt( "    scriptDamageType:", scriptDamageType )
		printt( "    damageSourceId_ToUse:", damageSourceId_ToUse )
		printt( "    sourceDisplayName:", debugSourceDisplayName )
		printt( "------------------------------------------" )
	}

	
	
	

	if ( isDeathSuicide )
	{
		attackerInfo.displayName = ""
		attackerInfo.displayColor = victimInfo.displayColor
	}

	asset weaponIcon = GetObitImageFromDamageSourceID( damageSourceId_ToUse )
	
	

	string attackerString
	string weaponString
	string victimString

	if ( attackerInfo.petDisplayName != "" )
	{
		attackerString = Localize( "#OBIT_PLAYER_CONTROLLED_AI_STRING", attackerInfo.displayName, Localize( attackerInfo.petDisplayName ) )
	}
	else
	{
		attackerString = Localize( "#OBIT_PLAYER_STRING", attackerInfo.displayName )
	}

	if ( victimInfo.petDisplayName != "" )
	{
		victimString = Localize( "#OBIT_PLAYER_CONTROLLED_AI_STRING", victimInfo.displayName, Localize( victimInfo.petDisplayName ) )
	}
	else
	{
		victimString = Localize( "#OBIT_PLAYER_STRING", victimInfo.displayName )
	}

	string localizedObit = Localize( "#OBIT_ENT_WEAPON_ENT", attackerString, Localize( sourceDisplayName ), victimString )

	float backgroundAlpha = (attacker == GetLocalClientPlayer() || victim == GetLocalClientPlayer()) ? 0.5 : 0.0

	bool shouldShowForVictim = (IsValid( victim ) && victim.IsPlayer() && ShouldShowObituaryLineForPlayer( victim ) )
	bool shouldShowForAttacker = (IsValid( attacker ) && attacker.IsPlayer() && ShouldShowObituaryLineForPlayer( attacker ) )
	if ( !shouldShowForVictim && !shouldShowForAttacker )
		return

	asset modifierIcon = $""
	if ( isDownShot )
		modifierIcon = $"rui/hud/obituary/obituary_downed"
	else if ( isHeadShot )
		modifierIcon = $"rui/hud/obituary/obituary_headshot"

	ObitRankBadgeInfo badgeInfo
	if (GetCurrentPlaylistVarBool( "ranked_survival_showEmblemOnKill_enabled", true ))
	{
		if ( ShouldShowRankBadges (attacker, isDownShot) )
		{
			badgeInfo.shouldShowRank = true

			
			EHIScriptStruct attackerEHIScriptStruct =  GetEHIScriptStruct(ToEHI( attacker ))
			int attackerLadderPos   = attackerEHIScriptStruct.rankedLadderPosition
			int attackerLadderScore = attackerEHIScriptStruct.rankScore

			EHIScriptStruct victimEHIScriptStruct =  GetEHIScriptStruct(ToEHI( victim ))
			int victimLadderPos   = victimEHIScriptStruct.rankedLadderPosition
			int victimLadderScore = victimEHIScriptStruct.rankScore

			badgeInfo.attackerRankBadge = GetCurrentRankedDivisionFromScoreAndLadderPosition (attackerLadderScore , attackerLadderPos ).tier.icon
			badgeInfo.victimRankBadge   = GetCurrentRankedDivisionFromScoreAndLadderPosition (victimLadderScore, victimLadderPos ).tier.icon
		}
	}

	vector weaponColor = GetObitWeaponColorFromDamageSourceID( damageSourceId_ToUse )

	if ( weaponIcon == $"" )
	{
		Obituary_Print_PlayerDeath( attackerString, weaponIcon, Localize( sourceDisplayName ), modifierIcon, victimString, badgeInfo, attackerInfo.displayColor, victimInfo.displayColor, weaponColor, false, obitFlags )
	}
	else
	{
		Obituary_Print_PlayerDeath( attackerString, weaponIcon, "", modifierIcon, victimString, badgeInfo, attackerInfo.displayColor, victimInfo.displayColor, weaponColor, isMainWeapon, obitFlags )
	}
}

bool function ShouldShowRankBadges ( entity attacker, bool isDownShot )
{
	if ( Ranked_ShouldShowRankedBadge() == false )
	{
		return false
	}

	if (isDownShot)
	{
		return false
	}


	if (GameMode_IsActive( eGameModes.ARENAS ))
	{
		return false
	}


	if ( !IsValid( attacker )  )
	{
		return false
	}

	if ( !IsValid( GetLocalClientPlayer() ) )
	{
		return false
	}

	if ( !attacker.IsPlayer())
	{
		return false
	}

	if ( attacker.GetTeam() != GetLocalClientPlayer().GetTeam())
	{
		return false
	}

	return GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED )
}

bool function ShouldShowObituaryLineForPlayer( entity player )
{
	if ( !IsValid( player ) )
		return false
	if ( !IsValid( GetLocalClientPlayer() ) )
		return false
	if ( IsWatchingKillReplay() ) 
		return false

	int playerTeam = player.GetTeam()
	int localTeam = GetLocalClientPlayer().GetTeam()
	bool onlyTeammates = GetCurrentPlaylistVarBool( "obituary_only_teammates", false )
	if ( onlyTeammates )
	{
		if ( IsEnemyTeam( playerTeam, localTeam ) )
			return false
	}

	return true
}


void function Obituary_Print_Localized( string localizedPrint, vector altColor1 = <255,255,255>, vector altColor2 = <255,255,255>, vector altColor3 = <255,255,255>, vector backgroundColor = <255,255,255>, float backgroundAlpha = 0.0, bool bCheckForDuplicateEntry = false, int obitFlags = 0 )
{
	if ( !file.obituariesEnabled )
		return

	if ( GetCurrentPlaylistVarBool( "obituary_filters_enabled", true ) && file.obituaryFilter > 0 && ( file.obituaryFilter & obitFlags ) == 0 )
		return

	if ( !file.obituaryDynamicDurationEnabled && modalVisible )
		return

	Obituary_HNQ_Print_Localized( localizedPrint, altColor1, altColor2, altColor3, bCheckForDuplicateEntry, obitFlags )
}




void function Obituary_HNQ_Print_Localized( string localizedPrint, vector altColor1, vector altColor2, vector altColor3, bool bCheckForDuplicateEntry, int obitFlags = 0 )
{
	
	if ( !file.obituaryDynamicDurationEnabled && bCheckForDuplicateEntry )
	{
		array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )
		foreach ( existingItem in visibleItems )
		{
			if ( "duplicateCheckString" in existingItem.miscArgs && expect string( existingItem.miscArgs["duplicateCheckString"] ) == localizedPrint )
				return
		}
	}

#if DEV
		file.debugObitRequested++
#endif

	string itemKey = bCheckForDuplicateEntry ? localizedPrint : ""

	HudNotificationQueueItem item = HudNotificationQueue_CreateEmptyItem()
	item.key = itemKey
	
	if ( !file.obituaryDynamicDurationEnabled )
		item.priority = OBITUARY_PRIORITY_LOCALIZED
	else if ( (obitFlags & OBIT_FLAG_ENEMY_NEARBY) != 0 )
		item.priority = OBITUARY_PRIORITY_ENEMY_NEARBY
	else
		item.priority = OBITUARY_PRIORITY_LOCALIZED 
	item.duration = file.obituaryDuration
	item.outroDuration = 0.0
	item.ruiAsset = $"ui/obituary_crawl_localized.rpak"

	item.onCreateVisualOverride = Obituary_HNQ_OnCreateVisualOverride
	item.onDestroyVisualOverride = Obituary_HNQ_OnDestroyVisualOverride

	item.onIntro = Obituary_HNQ_OnVisibleListChanged_CallBack
	item.onComplete = Obituary_HNQ_OnVisibleListChanged_CallBack

	
	item.ruiArgs["obitString"] <- HudNotificationQueue_CreateRuiArg( "obitString", localizedPrint )
	item.ruiArgs["string1Color"] <- HudNotificationQueue_CreateRuiArg( "string1Color", SrgbToLinear( altColor1 / 255.0 ) )
	item.ruiArgs["string2Color"] <- HudNotificationQueue_CreateRuiArg( "string2Color", SrgbToLinear( altColor2 / 255.0 ) )
	item.ruiArgs["string3Color"] <- HudNotificationQueue_CreateRuiArg( "string3Color", SrgbToLinear( altColor3 / 255.0 ) )
	item.ruiArgs["showObitsDuringSpectate"] <- HudNotificationQueue_CreateRuiArg( "showObitsDuringSpectate", GetCurrentPlaylistVarBool( "show_obits_during_spectate", true ) )
	item.ruiArgs["isVisible"] <- HudNotificationQueue_CreateRuiArg( "isVisible", !ObituaryHudIsDisabled() )

#if DEV
		DEV_Debug_ObitTagItemType( item, DEV_Debug_ObitClassifyLocalized( localizedPrint, obitFlags ) )
#endif

	
	if ( bCheckForDuplicateEntry )
		item.miscArgs["duplicateCheckString"] <- localizedPrint

	Obituary_HNQ_EvictOldestIfFull()
	item.miscArgs["requestTime"] <- Time()
	HudNotificationQueue_QueueItem( file.hnqQueueId, item, ePersistenceContext.PLAYER )
	file.lastObitQueueTime = Time()
	file.obitsPendingDispatch++
}

