HudNotificationQueueItem function Obituary_HNQ_CreateControlObjectivePingItem( entity subjectEnt, entity objectiveWaypoint, string localizedPrint, vector altColor1, vector altColor2, vector altColor3 )
{
	HudNotificationQueueItem item = HudNotificationQueue_CreateEmptyItem()
	item.key = "control_objective_" + string( objectiveWaypoint.GetEntIndex() )
	item.priority = OBITUARY_PRIORITY_CONTROL_OBJECTIVE
	item.duration = file.obituaryDuration
	item.outroDuration = 0.0
	item.ruiAsset = $"ui/obituary_crawl_localized.rpak"

	item.onCreateVisualOverride = Obituary_HNQ_OnCreateVisualOverride
	item.onDestroyVisualOverride = Obituary_HNQ_OnDestroyVisualOverride

	item.onIntro = Obituary_HNQ_OnVisibleListChanged_CallBack

	
	item.ruiArgs["obitString"] <- HudNotificationQueue_CreateRuiArg( "obitString", localizedPrint )
	item.ruiArgs["string1Color"] <- HudNotificationQueue_CreateRuiArg( "string1Color", SrgbToLinear( altColor1 / 255.0 ) )
	item.ruiArgs["string2Color"] <- HudNotificationQueue_CreateRuiArg( "string2Color", SrgbToLinear( altColor2 / 255.0 ) )
	item.ruiArgs["string3Color"] <- HudNotificationQueue_CreateRuiArg( "string3Color", SrgbToLinear( altColor3 / 255.0 ) )
	item.ruiArgs["showObitsDuringSpectate"] <- HudNotificationQueue_CreateRuiArg( "showObitsDuringSpectate", GetCurrentPlaylistVarBool( "show_obits_during_spectate", true ) )
	item.ruiArgs["isVisible"] <- HudNotificationQueue_CreateRuiArg( "isVisible", !ObituaryHudIsDisabled() )

	
	entity localPlayer = GetLocalViewPlayer()
	if ( IsValid( localPlayer ) && subjectEnt.GetTeam() != localPlayer.GetTeam() )
	{
		if ( IsFriendlyTeam( subjectEnt.GetTeam(), localPlayer.GetTeam() ) )
		{
			item.ruiArgs["defaultTextColor"] <- HudNotificationQueue_CreateRuiArg( "defaultTextColor", SrgbToLinear( TEAM_COLOR_FRIENDLY / 255.0 ) )
		}
	}

	
	item.miscArgs["objectiveWaypoint"] <- objectiveWaypoint
	item.miscArgs["subjectEnt"] <- subjectEnt
	item.miscArgs["team"] <- subjectEnt.GetTeam()

	return item
}




void function Obituary_HNQ_OnControlObjectivePingUpdateOverride( bool isItemVisible, HudNotificationQueueItem existingItem, HudNotificationQueueItem ornull incomingItem )
{
	
	
	file.obitsPendingDispatch = maxint( 0, file.obitsPendingDispatch - 1 )

	if ( incomingItem == null )
		return

	expect HudNotificationQueueItem( incomingItem )

	
	existingItem.ruiArgs = incomingItem.ruiArgs
	existingItem.miscArgs = incomingItem.miscArgs
	existingItem.duration = incomingItem.duration

	
	if ( isItemVisible )
	{
		existingItem.timeToStartOutro = Time() + existingItem.duration

		
		if ( existingItem.ruiInstance != null && RuiIsAlive( existingItem.ruiInstance ) )
		{
			HudNotificationQueue_SetRuiArgs( existingItem.ruiInstance, existingItem.ruiArgs )
			RuiSetGameTime( existingItem.ruiInstance, "startTime", Time() )
			RuiSetGameTime( existingItem.ruiInstance, "updateTime", Time() )
		}
	}

	
	Obituary_HNQ_UpdateAllVisiblePositions()
}




void function Obituary_HNQ_OnControlObjectivePingComplete_Native( HudNotificationQueueItem item )
{
	Obituary_HNQ_UpdateAllVisiblePositions()
}



int function Obituary_HNQ_GetPingCountForItem( HudNotificationQueueItem item )
{
	if ( !( "objectiveWaypoint" in item.miscArgs ) || !( "team" in item.miscArgs ) )
		return 0

	entity objectiveWaypoint = expect entity( item.miscArgs["objectiveWaypoint"] )
	int team = expect int( item.miscArgs["team"] )

	if ( !IsValid( objectiveWaypoint ) )
		return 0

	return CaptureObjectivePing_GetPingCountForObjectiveForTeamOrAlliance( objectiveWaypoint, AllianceProximity_GetAllianceFromTeam( team ) )
}



void function Obituary_HNQ_UpdateAllVisiblePositions_ControlMode( array<HudNotificationQueueItem> visibleItems, int baseOffset )
{
	
	array<HudNotificationQueueItem> objectivePings = []
	array<HudNotificationQueueItem> otherObits = []

	foreach ( item in visibleItems )
	{
		if ( "objectiveWaypoint" in item.miscArgs )
		{
			objectivePings.append( item )
		}
		else
		{
			otherObits.append( item )
		}
	}

	
	if ( objectivePings.len() > 1 )
	{
		objectivePings.sort( int function( HudNotificationQueueItem a, HudNotificationQueueItem b )
		{
			int aPingCount = Obituary_HNQ_GetPingCountForItem( a )
			int bPingCount = Obituary_HNQ_GetPingCountForItem( b )

			if ( aPingCount > bPingCount )
				return -1
			if ( aPingCount < bPingCount )
				return 1
			return 0
		} )
	}

	
	int currentOffset = baseOffset

	foreach ( item in objectivePings )
	{
		Obituary_HNQ_SetItemOffset( item, currentOffset )
		currentOffset++
	}

	foreach ( item in otherObits )
	{
		Obituary_HNQ_SetItemOffset( item, currentOffset )
		currentOffset++
	}
}
























































void function Obituary_ClearObituary()
{
	array<HudNotificationQueueItem> visibleItems = HudNotificationQueue_GetVisibleItems( file.hnqQueueId )
	foreach ( item in visibleItems )
