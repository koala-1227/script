bool function GRX_CheckCanAccessUserInfo()
{
	bool isLobby = IsLobby()
	bool valid = isLobby || ( GetConVarBool( "mtx_userInfo_assertOnMatchAccess" ) == false )





		valid = valid || ( !isLobby && GetConVarBool( "mtx_userInfo_sendInMatch" ) && GetConVarBool( GRX_MATCH_DEDIS_HAVE_USER_INFO ) )
		Assert( valid, "Tried to check GRX User Info while connected a match dedi that is neither expected to have it nor to send it. Set `+mtx_userInfo_assertOnMatchAccess 0` on Server to bypass this assert." )


	return valid
}



bool function GRX_IsInventoryReady( entity player = null )
{
	if ( !GRX_CheckCanAccessUserInfo() )
		return false






	return GetPlayerGRXScriptState( player ).isInventoryReady
}




























bool function GRX_HasInventoryEverBeenReady( entity player = null )
{
	if ( !IsLobby() && !GetConVarBool( GRX_MATCH_DEDIS_HAVE_USER_INFO ) )
		return false




		if ( player == null )
			player = GetLocalClientPlayer()





	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( player )
	return scriptState.hasInventoryEverBeenClean
}




int function GRX_GetPlayerEdition( entity player = null )
{



		if ( player == null )
			player = GetLocalClientPlayer()





	return GetPlayerGRXScriptState( player ).marketplaceEdition
}



int function GRX_GetNumberOfOwnedItemsByPlayer( array<ItemFlavor> items, entity player = null )
{
	if ( !GetPlayerGRXScriptState( player ).isInventoryReady )
		return 0
	int count = 0
	foreach( item in items )
	{
		if ( GRX_IsItemOwnedByPlayer( item, player ) )
		{
			count++
		}
	}
	return count
}

bool function GRX_IsItemOwnedByPlayer( ItemFlavor flav, entity player = null )
{
	Assert( GetPlayerGRXScriptState( player ).isInventoryReady, "Called GRX_IsItemOwnedByPlayer while the player's inventory was not ready" )

	return IsItemOwnedByPlayerInternal( flav, player )
}

bool function GRX_IsItemOwnedByPlayer_AllowOutOfDateData( ItemFlavor flav, entity player = null )
{
	
	
	
	
	
	

	return IsItemOwnedByPlayerInternal( flav, player )
}

bool function IsItemOwnedByPlayerInternal( ItemFlavor flav, entity player = null )
{
	int type = ItemFlavor_GetType( flav )

#if DEV
		
		if ( type == eItemType.character )
		{
			var stackInfos = getstackinfos( 3 ) 
			if ( stackInfos != null )
			{
				expect table(stackInfos)
				string funcName = expect string(stackInfos.func)
				const array< string > FUNCS_THAT_CAN_CHECK_CHARACTER_OWNERSHIP_DIRECTLY = [
					"Loadout_GetCharacterUnlockedStateForPlayer" 
					"PurchaseDialog", 
					"GRXOffer_IsFullyClaimed", 
					"Loadout_IsCharacterOwnedByPlayerIgnoringUnlockSources", 
					"GRXOffer_GetOwnedItemsCount", 
				]

				if ( !FUNCS_THAT_CAN_CHECK_CHARACTER_OWNERSHIP_DIRECTLY.contains( funcName ) )
				{
					GRX_Warning( "%s is checking ownership of character %s directly rather than using an approved wrapper function", funcName, string(ItemFlavor_GetAsset( flav )) )
					
					
					
				}
			}
		}
#endif




		if ( player == null )
			player = GetLocalClientPlayer()





	if ( ItemFlavor_GetPlaylistAvailability( flav ) == eItemFlavorPlaylistAvailability.FORCE_UNLOCK_FOR_SPECIAL_EVENT )
		return true

	int grxMode = ItemFlavor_GetGRXMode( flav )

	if ( grxMode == eItemFlavorGRXMode.OWNERSHIP_TARGET )
	{
		ItemFlavor ornull ownershipTargetOverride = ItemFlavor_GetGRXOwnershipTarget( flav )
		if ( ownershipTargetOverride != null )
			return IsItemOwnedByPlayerInternal( expect ItemFlavor(ownershipTargetOverride), player )

		GRX_Warning( "Item flavor %s is set to use GRX ownership of another item but it isn't a valid item: %s", string(ItemFlavor_GetAsset( flav )), string(GetGlobalSettingsAsset( ItemFlavor_GetAsset( flav ), "ownershipTarget" )) )
		return false
	}

	if ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET || grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE )
	{
		array< ItemFlavor > ownershipTargetList = ItemFlavor_GetGRXMultipleOwnershipRequirementsList( flav )
		if ( ownershipTargetList.len() == 0 )
		{
			GRX_Warning( "Item flavor %s is set to use GRX ownership of a set of items, but the set was empty: %s", string( ItemFlavor_GetAsset( flav ) ) )
			return false
		}

		foreach ( ItemFlavor ownershipFlav in ownershipTargetList )
		{
			bool isOwned = IsItemOwnedByPlayerInternal( ownershipFlav, player )
			if ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET && !isOwned )
			{
				return false
			}
			else if ( grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE && isOwned )
			{
				return true
			}
		}

		return ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET ) 
	}

	
	
	
	

	
	

		bool isLobby = IsLobby()













		
		
		
		if ( grxMode == eItemFlavorGRXMode.REGULAR && isLobby && GetConVarBool( "mtx_allow_pending_grants_for_item_ownership" ) )
		{
			for ( int index = 0; index < QUEUED_REWARDS_MAX_COUNT; index++ )
			{
				SettingsAssetGUID rewardGUID = player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", index ) )
				if ( rewardGUID == 0 || !IsValidItemFlavorGUID( rewardGUID ) )
				{
					continue
				}

				if ( flav.guid == rewardGUID )
				{
					GRX_Info( "reporting queued GRX reward as owned instead of relying on GRX_Inventory call or persistence cache --- this should be temporary and should resolve on next successful GRX refresh" )
					return true
				}
			}
		}


	
	if ( ItemFlavor_HasUnlockFunc( flav ) && grxMode == GRX_ITEMFLAVORMODE_NONE )
		return ItemFlavor_PassesUnlockFunc( flav, player )

	if ( grxMode == GRX_ITEMFLAVORMODE_NONE )
		return true

	Assert( grxMode == GRX_ITEMFLAVORMODE_REGULAR, format( "Tried to call GRX_IsItemOwnedByPlayer on a non-regular GRX item: %s", string(ItemFlavor_GetAsset( flav )) ) )

	bool has
	if ( !GRX_HasInventoryEverBeenReady( player ) )
	{
		has = true 
	}
	else
	{
		if ( !ItemFlavor_IsMarketplaceExclusive( flav, player ) && ItemFlavor_HasExclusiveFunc( flav ) )
		{
			return ItemFlavor_PassesExclusiveFunc( flav, player )
		}





				Assert( player == GetLocalClientPlayer() )



			has = GRX_HasItem( flav.grxIndex )

	}

	if ( IsEverythingUnlocked() )
		return true

	return has
}



int function GetItemOwnershipStateForPlayer( ItemFlavor flav, entity player = null )
{
	
	
	int type = ItemFlavor_GetType( flav )




		if ( player == null )
			player = GetLocalClientPlayer()





	if ( ItemFlavor_GetPlaylistAvailability( flav ) == eItemFlavorPlaylistAvailability.FORCE_UNLOCK_FOR_SPECIAL_EVENT )
		return eItemFlavorGRXOwnershipReason.OWNED_SPECIAL_EVENT

	int grxMode = ItemFlavor_GetGRXMode( flav )

	if ( grxMode == eItemFlavorGRXMode.OWNERSHIP_TARGET )
	{
		ItemFlavor ornull ownershipTargetOverride = ItemFlavor_GetGRXOwnershipTarget( flav )
		if ( ownershipTargetOverride != null )
		{
			int ownershipState = IsItemOwnedByPlayerInternal( expect ItemFlavor(ownershipTargetOverride), player ) ? eItemFlavorGRXOwnershipReason.OWNED_DEPENDENCY : eItemFlavorGRXOwnershipReason.UNOWNED_DEPENDENCY
			return ownershipState
		}

		GRX_Warning( "Item flavor %s is set to use GRX ownership of another item but it isn't a valid item: %s", string(ItemFlavor_GetAsset( flav )), string(GetGlobalSettingsAsset( ItemFlavor_GetAsset( flav ), "ownershipTarget" )) )
		return eItemFlavorGRXOwnershipReason.UNOWNED_DEPENDENCY
	}

	if ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET || grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE )
	{
		array< ItemFlavor > ownershipTargetList = ItemFlavor_GetGRXMultipleOwnershipRequirementsList( flav )
		if ( ownershipTargetList.len() == 0 )
		{
			GRX_Warning( "Item flavor %s is set to use GRX ownership of a set of items, but the set was empty: %s", string( ItemFlavor_GetAsset( flav ) ) )
			return eItemFlavorGRXOwnershipReason.UNOWNED_DEPENDENCY
		}

		foreach ( ItemFlavor ownershipFlav in ownershipTargetList )
		{
			bool isOwned = IsItemOwnedByPlayerInternal( ownershipFlav, player )
			if ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET && !isOwned )
			{
				return eItemFlavorGRXOwnershipReason.UNOWNED_DEPENDENCY
			}
			else if ( grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE && isOwned )
			{
				return eItemFlavorGRXOwnershipReason.OWNED_DEPENDENCY
			}
		}

		int ownershipState = ( grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET ) ? eItemFlavorGRXOwnershipReason.OWNED_DEPENDENCY : eItemFlavorGRXOwnershipReason.UNOWNED_DEPENDENCY 
		return ownershipState
	}

	
	
	
	

	
	

		bool isLobby = IsLobby()













		
		
		
		if ( grxMode == eItemFlavorGRXMode.REGULAR && isLobby && GetConVarBool( "mtx_allow_pending_grants_for_item_ownership" ) )
		{
			for ( int index = 0; index < QUEUED_REWARDS_MAX_COUNT; index++ )
			{
				SettingsAssetGUID rewardGUID = player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", index ) )
				if ( rewardGUID == 0 || !IsValidItemFlavorGUID( rewardGUID ) )
				{
					continue
				}

				if ( flav.guid == rewardGUID )
				{
					GRX_Info( "reporting queued GRX reward as owned instead of relying on GRX_Inventory call or persistence cache --- this should be temporary and should resolve on next successful GRX refresh" )
					return eItemFlavorGRXOwnershipReason.OWNED_QUEUED_REWARD
				}
			}
		}


	
	if ( ItemFlavor_HasUnlockFunc( flav ) && grxMode == GRX_ITEMFLAVORMODE_NONE )
	{
		int ownershipState = ItemFlavor_PassesUnlockFunc( flav, player ) ? eItemFlavorGRXOwnershipReason.OWNED_UNLOCK_FUNC : eItemFlavorGRXOwnershipReason.UNOWNED_UNLOCK_FUNC
		return ownershipState
	}

	if ( grxMode == GRX_ITEMFLAVORMODE_NONE )
		return eItemFlavorGRXOwnershipReason.OWNED_NON_GRX

	Assert( grxMode == GRX_ITEMFLAVORMODE_REGULAR, format( "Tried to call %s on a non-regular GRX item: %s", FUNC_NAME(), string(ItemFlavor_GetAsset( flav )) ) )

	bool has
	if ( !GRX_HasInventoryEverBeenReady( player ) )
	{
		return eItemFlavorGRXOwnershipReason.OWNED_INVENTORY_NEVER_READY
	}
	else
	{
		if ( !ItemFlavor_IsMarketplaceExclusive( flav, player ) && ItemFlavor_HasExclusiveFunc( flav ) )
		{
			int ownershipState = ItemFlavor_PassesExclusiveFunc( flav, player ) ? eItemFlavorGRXOwnershipReason.OWNED_EXCLUSIVE_FUNC : eItemFlavorGRXOwnershipReason.UNOWNED_EXCLUSIVE_FUNC
			return ownershipState
		}





				Assert( player == GetLocalClientPlayer() )



			has = GRX_HasItem( flav.grxIndex )

	}

	if ( IsEverythingUnlocked() )
		return eItemFlavorGRXOwnershipReason.OWNED_EVERYTHING_UNLOCKED

	int ownershipState = has ? eItemFlavorGRXOwnershipReason.OWNED_GRX : eItemFlavorGRXOwnershipReason.UNOWNED_GRX
	return ownershipState
}









































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































