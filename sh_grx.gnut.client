bool function GRX_IsItemFlavInPackResultContainer( ItemFlavor flav, int targetContainerType )
{
	int containerType = GRX_GetMostRecentPackOpeningContainerType()
	if ( containerType != targetContainerType )
	{
		return false
	}

	array<ItemFlavor> containerItems = GRX_GetMostRecentPackOpeningContainerResults()
	foreach ( ItemFlavor containerFlav in containerItems )
	{
		if ( flav.guid == containerFlav.guid )
		{
			return true
		}
	}

	return false
}
















































































































































































































































































































































































































int function GRX_GetQuantityOverrideForStackableItemFlavor( ItemFlavor itemFlavor )
{
	int quantity = 1
	if ( ItemFlavor_GetType( itemFlavor ) == eItemType.account_currency_bundle )
	{
		quantity = GRXCurrencyBundle_GetValue( itemFlavor )
	}
	else if ( ItemFlavor_GetType( itemFlavor ) == eItemType.voucher )
	{
		int stars = Voucher_GetEffectBattlepassStars( itemFlavor )
		quantity = stars > 0 ? stars : 1
	}
	return quantity
}



int function GRX_GetRarityOverrideFromQuantity( ItemFlavor item, int currentRarity, int quantity )
{
	bool isCrafting = ( item == GRX_CURRENCIES[GRX_CURRENCY_CRAFTING] )
	bool isLegendTokens = ( item == GRX_CURRENCIES[GRX_CURRENCY_CREDITS] )
	bool isStars = ( ItemFlavor_GetType( item ) == eItemType.voucher && Voucher_GetEffectBattlepassStars( item ) > 0 )
	if ( !isCrafting && !isStars && !isLegendTokens )
		return currentRarity

	int rarity = eRarityTier.COMMON
	table<int, int> tableToIterate
	if ( isCrafting )
		tableToIterate = clone CRAFTING_MATERIAL_MAX_QUANTITY_TO_RARITY_MAP
	else if ( isLegendTokens)
		tableToIterate = clone LEGEND_TOKENS_MAX_QUANTITY_TO_RARITY_MAP
	else if ( isStars )
		tableToIterate = clone BP_STARS_QUANTITY_TO_RARITY_MAP
	else
		Assert( false, "Tried to get override rarity for item not in Rarity:Quantity table." )

	foreach ( int maxQuantity, int associatedRarity in tableToIterate )
	{
		rarity = associatedRarity
		if ( maxQuantity >= quantity )
			break
	}

	return rarity
}






















