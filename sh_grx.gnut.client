void function UIToClient_GRXInventoryCleanStateChange( bool isClean, int marketplaceEdition, bool isOfferResticted )
{
	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )
	scriptState.isInventoryReady = isClean
	scriptState.marketplaceEdition = marketplaceEdition
	scriptState.isOfferRestricted = isOfferResticted
	if ( isClean )
	{
		scriptState.hasInventoryEverBeenClean = true

		
		ItemFlavor ornull activeBattlePass = GetActiveBattlePass()
		if ( activeBattlePass == null )
			return

		expect ItemFlavor( activeBattlePass )

		ItemFlavor xpBoostFlav = BattlePass_GetXPBoostFlav( activeBattlePass )
		SetConVarInt( "client_boostcount", GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( xpBoostFlav ) ) )
	}
}














































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































bool function IsValidCurrencyForPackOpening( ItemFlavor currency )
{
	if ( currency.guid == GRX_CURRENCIES[GRX_CURRENCY_CRAFTING].guid
	|| currency.guid == GRX_CURRENCIES[GRX_CURRENCY_HEIRLOOM].guid
	|| currency.guid == GRX_CURRENCIES[GRX_CURRENCY_EXOTIC].guid )
	{
		return true
	}

	return false
}



void function ClientCodeCallback_GRXPacksOpened( int batchCounter, int numBatchesOfItemsToSend, array<int> balanceDiffs, array<int> newItems, int containerType, array<int> containerItems, int packError )
{
	GRX_Info(
		"batchCounter=%d , numBatchesOfItemsToSend=%d , balanceDiffs=%s , newItems=%s , packError=%d",
		batchCounter,
		numBatchesOfItemsToSend,
		format( "[%s]", balanceDiffs.join( "," ) ),
		format( "[%s]", newItems.join( "," ) ),
		packError
	)

	ItemFlavorBag bag

	
	if ( batchCounter == 0 )
	{
		
		fileLevel.mostRecentPackOpeningResultsOrNull = null
		fileLevel.mostRecentPackOpeningContainerType = -1
		fileLevel.mostRecentPackOpeningContainerResults.clear()

		for ( int currencyIndex = 0; currencyIndex < GRX_CURRENCY_COUNT; currencyIndex++ )
		{
			ItemFlavor currency = GRX_CURRENCIES[currencyIndex]

			if ( !IsValidCurrencyForPackOpening( currency ) )
			{
				continue
			}

			int diff            = balanceDiffs[currencyIndex]
			if ( diff != 0 )
			{
				bag.flavors.append( currency )
				bag.quantities.append( diff )
			}
		}

		if ( packError != GRX_INVENTORYERROR_NONE )
		{
			bag.associatedError = packError
			GRX_Info( "packError: %d", packError )
		}
	}
	else 
	{
		Assert( fileLevel.mostRecentPackOpeningResultsOrNull != null, "fileLevel.mostRecentPackOpeningResultsOrNull should not be null" )
		bag = expect ItemFlavorBag( fileLevel.mostRecentPackOpeningResultsOrNull )
	}

	foreach ( int itemGRXIndex in newItems )
	{
		ItemFlavor flav = GetItemFlavorByGRXIndex( itemGRXIndex )

		bag.flavors.append( flav )
		bag.quantities.append( 1 )
	}

	fileLevel.mostRecentPackOpeningContainerType = containerType

	foreach ( int itemGRXIndex in containerItems )
	{
		ItemFlavor flav = GetItemFlavorByGRXIndex( itemGRXIndex )
		fileLevel.mostRecentPackOpeningContainerResults.append( flav )
	}

	
	if ( batchCounter == ( numBatchesOfItemsToSend - 1 ) )
	{
		foreach ( int flavIndex, ItemFlavor flav in bag.flavors )
		{
			GRX_Info( "flav: %s, name: %s, qty: %d",
				DEV_DescItemFlavor( flav ),
				Localize( ItemFlavor_GetLongName( flav ) ),
				bag.quantities[flavIndex]
			)

			Newness_MarkItemAsNewAndInformServer( flav )
		}

#if DEV
			int menuHeirloomOverrideGUID = DEV_GetMenuHeirloomOverrideGUID()

			if ( menuHeirloomOverrideGUID >= 0 )
			{
				ItemFlavor item = GetItemFlavorByGUID( menuHeirloomOverrideGUID )
				bag.flavors.append( item )
				bag.flavors.append( item )
				bag.flavors.append( item )
				bag.quantities.append( 1 )
				bag.quantities.append( 1 )
				bag.quantities.append( 1 )
				bag.associatedError = GRX_INVENTORYERROR_NONE
			}
			else if ( DEV_GRX_ForcePackResults_resultsOrNull != null )
			{
				GRX_Info( "PACK RESULTS FORCED!!" )
				bag = expect ItemFlavorBag(DEV_GRX_ForcePackResults_resultsOrNull)
			}
#endif

		if ( newItems.len() > 0 )
		{
			RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Start", bag.associatedError, fileLevel.mostRecentPackOpeningContainerType )

			foreach ( int flavIdx, ItemFlavor flav in bag.flavors )
			{
				RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Entry", ItemFlavor_GetGUID( flav ), bag.quantities[flavIdx], false )
			}

			foreach ( ItemFlavor flav in fileLevel.mostRecentPackOpeningContainerResults )
			{
				RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Entry", ItemFlavor_GetGUID( flav ), 1, true )
			}

			RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Finish" )
		}
	}

	fileLevel.mostRecentPackOpeningResultsOrNull = bag
}



int function ClientCodeCallback_GRXGetBattlepassSeasonAndSplitNumber()
{
	int battlePassSeasonAndSplit = 0
	ItemFlavor ornull currentPassFlav = GetActiveBattlePassV2()
	if ( currentPassFlav != null )
	{
		int activeSeasonNumber = GetActiveSeasonNumber()
		expect ItemFlavor( currentPassFlav )
		int currentSplit = BattlePassV2_GetCurrentSplit( currentPassFlav )

		
		
		battlePassSeasonAndSplit = ( activeSeasonNumber * 10 ) + currentSplit
	}
	return battlePassSeasonAndSplit
}






























































































































































































































































































































































































































































































void function AssertCurrencyBundleValuesAreValid( ItemFlavor bundle )
{
	
	

	int playlistValue = GetCurrentPlaylistVarInt( "grx_" + ItemFlavor_GetGRXAlias( bundle ) + "_count", -1 )
	int bakeryValue = GetGlobalSettingsInt( ItemFlavor_GetAsset( bundle ), "currencyCount" )
	string playlistKey = "grx_" + ItemFlavor_GetGRXAlias( bundle ) + "_count"

	if ( GRXCurrencyBundle_GetValue( bundle ) <= 0 )
	{
		Assert( false, format( "Invalid currency bundle count setup, please check Bakery & playlist setup for %s - playlist %d, bakery %d", ItemFlavor_GetGRXAlias( bundle ), playlistValue, bakeryValue ) )
	}

	if ( playlistValue != -1 )
	{
		if ( playlistValue == bakeryValue )
			GRX_Warning( "%s: Playlist key %s is set but equals the bakery value (%d) -- remove the playlist entry\n", FUNC_NAME(), playlistKey, bakeryValue )

#if DEBUG_GRX_CURRENCY_BUNDLE_SETUP
			GRX_Debug( "%s: Playlist value %s is overriding the bakery value, using %d", FUNC_NAME(), playlistKey, playlistValue )
#endif
	}
}

void function OnItemTypeAccountPackFlavRegistered( ItemFlavor flav )
{
	
	if ( GetGlobalSettingsBool( ItemFlavor_GetAsset( flav ), "hasStickers" ) )
	{
		if ( GRXPack_GetStickerCompletionRewardSequence( flav ) != "" )
		{
			fileLevel.stickerPacksWithRewards.append( flav )
		}
	}

	
	if ( GRXPack_IsAnyRetroPack( flav ) )
	{
		array<ItemFlavor> rewards = GRXPack_GetCompletionRewards( flav, eLootPoolBrowserSortOrder.RARITY_ASCENDING )

		if ( rewards.len() == 0 )
		{
			GRX_Trace( "Skipping retro pack %s, no completion rewards found", ItemFlavor_GetAssetString( flav ))
		}
		else if( GRXPack_GetCompletionRewardSequenceString( flav ) == "" )
		{
			GRX_Info( "Skipping retro pack %s, no completion reward sequence found", ItemFlavor_GetAssetString( flav ))
		}
		else
		{
			fileLevel.retroPacksWithRewards.append( flav )
		}
	}

	
#if DEV
		if ( GRXPack_GetIsLootPoolBrowsable( flav ) )
		{
			if ( !GRXPack_ValidateLootPoolBrowserConfig( flav ) )
			{
				Warning( "Loot browser configuration for pack: %s was invalid", ItemFlavor_GetAssetString( flav ) )
			}
		}
#endif
}

array<ItemFlavor> function GRX_GetStickerPacksWithRewards()
{
	return fileLevel.stickerPacksWithRewards
}

array<ItemFlavor> function GRX_GetRetroPacksWithRewards()
{
	return fileLevel.retroPacksWithRewards
}









































































































bool function GRX_IsOfferRestricted( entity player = null )
{

	if ( player == null )
		player = GetLocalClientPlayer()





	if ( !IsLobby() && !GetConVarBool( GRX_MATCH_DEDIS_HAVE_USER_INFO ) )
		return expect bool( player.GetPersistentVar( OFFER_RESTRICTED_CACHE_PVAR ) )





		Assert( player == GetLocalClientPlayer() )
		PlayerGRXScriptState grxState = GetPlayerGRXScriptState( player )





	return grxState.isOfferRestricted
}
































































bool function GRX_IsItemCoveredByOfferRestrictions( ItemFlavor flav )
{
	if ( ItemFlavor_GetType( flav ) == eItemType.account_pack )
	{
		
		if ( ItemFlavor_GetQuality( flav, eRarityTier.NONE ) == eRarityTier.MYTHIC )
			return false

		return true
	}

	return false
}



























































































































































































bool function ItemFlavorIsStackable( ItemFlavor itemFlav )
{
	return ItemFlavor_GetGRXMode( itemFlav ) == eItemFlavorGRXMode.PACK ||
	ItemFlavor_GetGRXMode( itemFlav ) == eItemFlavorGRXMode.CONSUMABLE ||
	ItemFlavor_GetGRXMode( itemFlav ) == eItemFlavorGRXMode.CURRENCY
}












































































































































































































































































GRXLootPoolProgress function GRX_GetLootPoolProgress( entity player, ItemFlavor pack )
{
	Assert( ItemFlavor_GetType( pack ) == eItemType.account_pack )

	array< ItemFlavor > contents = GRXPack_GetPackContents( pack )
	GRXLootPoolProgress progress
	progress.owned = 0
	progress.total = contents.len()

	
	bool isBackfillType = ItemFlavor_GetAccountPackType( pack ) == eAccountPackType.RETRO_BACKFILL_PACK
	if ( isBackfillType )
	{
		string progressRewardSeq = GRXPack_GetPackOpenProgressRewardSequenceString( pack )

		




			
			if ( progressRewardSeq == "rewardseq_retro_s11e01_progress" )
			{
				progress.owned = player.GetPersistentVarAsInt( progressRewardSeq )
			}


		return progress
	}

	
	foreach ( ItemFlavor item in contents )
	{
		if ( GRX_IsItemOwnedByPlayer( item, player ) )
		{
			progress.owned += 1
		}
	}

	return progress
}



bool function GRX_IsValidGRXOwnershipMode( int grxMode )
{
	return grxMode == eItemFlavorGRXMode.OWNERSHIP_TARGET || grxMode == eItemFlavorGRXMode.ONE_OF_MULTIPLE	|| grxMode == eItemFlavorGRXMode.MULTIPLE_OWNERSHIP_TARGET
