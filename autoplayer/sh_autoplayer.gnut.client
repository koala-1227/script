array< vector > function AutoPlayer_GetMapDropLocations( string mapName )
{
	array< vector > dropLocations
	bool validMap = false
	string mapPrefix

	foreach ( string prefix in botDropLocationMapNames )
	{
		int len = prefix.len()
		if ( mapName.len() < prefix.len() )
		{
			continue
		}

		string slicedName = mapName.slice( 0, len )

		if ( slicedName == prefix )
		{
			validMap = true
			mapPrefix = slicedName
			break
		}
	}

	if ( validMap )
	{
		var dataTable = GetDataTable( mapPrefixToDropLocation[ mapPrefix ] )
		int landingLocationCol = GetDataTableColumnByName( dataTable, "landingLocation" )
		for ( int row = 0; row < GetDataTableRowCount( dataTable ); row++ )
		{
			vector loc = GetDataTableVector( dataTable, row, landingLocationCol )
			dropLocations.append( loc )
		}
	}

	return dropLocations
}


