void function AutoPlayer_LootItemFromDeathbox( entity player, entity item, entity deathBox )
{
	
	LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( item.GetSurvivalInt() )

		if ( lootData.ref == BLACK_MARKET_BANNER_REF )
		{
			return
		}


		if ( lootData.lootType == eLootType.COLLECTABLE_NESSIE )
		{
			return
		}








		if ( lootData.lootType == eLootType.EVO_CACHE )
		{
			return
		}


		if ( lootData.lootType == eLootType.AMMO && lootData.ref == ARROWS_AMMO )
		{
			return
		}


	RunClientCallback_PickupSurvivalItemFromBox( player, item, 0, deathBox )
}

